                    _h.flags.left2 = _s.t;
                    Profile_ResetForTest();
                    _h.c = Scenario_ChoiceNew();
                }
            } else if (_s.t == _h.flags.left2 + 40) {
                Scenario_Tap("interact");
            }
            if (variable_struct_exists(_h.flags, "left2") && _s.t > _h.flags.left2 + 40) {
