                break;
            }
            if (variable_struct_exists(_rg.r, "set") && !variable_struct_exists(_rg.r, "sent") && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && !_bc.battle_over && _ready_tap) {
                if (_bc.ui_cmd.cursor != 4) {
