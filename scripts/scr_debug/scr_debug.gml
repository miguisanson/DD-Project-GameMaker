            }
            if (_bc != noone && !variable_struct_exists(_rg.r, "set") && _s.t > 10 && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && is_struct(_bc.ui_cmd)) {
                _rg.r.set = true;
