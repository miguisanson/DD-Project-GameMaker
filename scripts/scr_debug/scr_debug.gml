                Scenario_Check("regr_r007_floor5_has_the_mini_boss_at_its_post", _mb243 != noone && _mb243.x == 224 && _mb243.y == 32);
                if (_mb243 == noone || _tg243 == noone) { Scenario_NoticeEnd(); break; }
