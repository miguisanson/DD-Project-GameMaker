                show_debug_message("[TEST] r007 hold: frames=" + string(_held244) + " ms=" + string(current_time - _rg.ms0));
                if (room != rm_floor5 || !instance_exists(_rg.mb)) { Scenario_NoticeEnd(); break; }
                Scenario_Next(_s, 245);
            }
            break;
        case 245:   // a free tile 5 tiles from the boss with a free tile 4 tiles from it next to it: stand there (no fight), then walk the one step with the real key
            if (!variable_struct_exists(_rg, "w")) {
                var _pl245 = instance_find(obj_player, 0);
                var _g245 = Scenario_ReachGrid(_pl245);
                var _t245 = GRID_TILE_SIZE;
                var _dx245 = [0, 0, -1, 1];
                var _dy245 = [-1, 1, 0, 0];
                var _act245 = ["move_up", "move_down", "move_left", "move_right"];
                var _pick245 = undefined;
                for (var _ty = 0; _ty < _g245.gh && is_undefined(_pick245); _ty++) {
                    for (var _tx = 0; _tx < _g245.gw && is_undefined(_pick245); _tx++) {
                        if (!_g245.reach[_ty * _g245.gw + _tx]) continue;
                        if (max(abs(_tx * _t245 - _rg.mx), abs(_ty * _t245 - _rg.my)) != 5 * _t245) continue;
                        for (var _k = 0; _k < 4; _k++) {
                            var _nx = _tx + _dx245[_k];
                            var _ny = _ty + _dy245[_k];
                            if (_nx < 0 || _ny < 0 || _nx >= _g245.gw || _ny >= _g245.gh) continue;
                            if (!_g245.reach[_ny * _g245.gw + _nx]) continue;
                            if (max(abs(_nx * _t245 - _rg.mx), abs(_ny * _t245 - _rg.my)) != 4 * _t245) continue;
                            _pick245 = { cx: _tx, cy: _ty, act: _act245[_k] };
                            break;
                        }
                    }
                }
                Scenario_Check("regr_r007_a_tile_5_tiles_out_with_a_step_to_4_tiles_exists", !is_undefined(_pick245));
                if (is_undefined(_pick245)) { Scenario_NoticeEnd(); break; }
                _rg.w = { ph: 0, t0: _s.t, pick: _pick245, t1: 0 };
                Scenario_PlacePlayer(_pick245.cx, _pick245.cy);
                break;
            }
            if (_rg.w.ph == 0 && _s.t == _rg.w.t0 + 120) {
                var _pl245b = instance_find(obj_player, 0);
                var _d245 = max(abs(_pl245b.x - _rg.mb.x), abs(_pl245b.y - _rg.mb.y));
                Scenario_Check("regr_r007_no_fight_at_5_tiles", room == rm_floor5 && !Transition_IsActive() && _d245 == 5 * GRID_TILE_SIZE, "room=" + room_get_name(room) + " dist=" + string(_d245));
                _s.boost = { hp: 9999, mp: 99 };   // the battle copy of the player is sturdy: the fight is only the way to the win
                Scenario_Hold(_rg.w.pick.act, 15);   // 15 held frames = exactly one 16 px tile
                _rg.w.ph = 1;
                _rg.w.t1 = _s.t;
            } else if (_rg.w.ph == 1) {
                if (room == rm_battle || (Transition_IsActive() && _gs.transition_fx.type == TRANSITION_TYPE_ENCOUNTER)) {
                    var _pl245c = instance_find(obj_player, 0);
                    var _d245c = (instance_exists(_pl245c) && instance_exists(_rg.mb)) ? max(abs(_pl245c.x - _rg.mb.x), abs(_pl245c.y - _rg.mb.y)) : -1;
                    Scenario_Check("regr_r007_the_fight_starts_within_4_tiles", _d245c >= 48 && _d245c <= 4 * GRID_TILE_SIZE, "dist=" + string(_d245c));
                    Scenario_Next(_s, 246);
                } else if (_s.t > _rg.w.t1 + 120) {
                    Scenario_Check("regr_r007_the_fight_starts_within_4_tiles", false, "no fight 120 frames after the step to 4 tiles; room=" + room_get_name(room));
                    Scenario_NoticeEnd();
                }
            }
            break;
        case 246:   // the fight: the mini boss, 1 HP left when the menu is up, ATTACK through the menu; back in rm_floor5
            if (_bc != noone) {
                if (!variable_struct_exists(_rg, "bt")) {
                    _rg.bt = true;
                    Scenario_Check("regr_r007_the_battle_is_the_mini_boss", _gs.battle.enemy_id == ENEMY_MINI_BOSS, "enemy=" + string(_gs.battle.enemy_id));
                }
                if (_s.t > 10 && !_bc.battle_over && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && _ready_tap) {
                    if (!variable_struct_exists(_rg, "e1")) { _rg.e1 = true; _bc.e.hp = 1; }
                    Scenario_Tap((_bc.menu_index != 0) ? "menu_up" : "confirm");
                }
            }
            if (variable_struct_exists(_rg, "bt") && room == rm_floor5 && Scenario_FloorReady(rm_floor5)) Scenario_Next(_s, 247);
            if (_s.t > 3000) { Scenario_Check("regr_r007_the_fight_is_won", false, "room=" + room_get_name(room) + " state=" + string(_bc != noone ? _bc.battle_state : -1) + " bt=" + string(variable_struct_exists(_rg, "bt"))); Scenario_NoticeEnd(); }
            break;
        case 247:   // after the win: the mini boss is gone; leave the room
            if (_s.t == 40) {
                Scenario_Check("regr_r007_back_in_floor5_after_the_win", room == rm_floor5);
                Scenario_Check("regr_r007_the_win_removes_the_mini_boss", !instance_exists(obj_mini_boss));
                Scenario_Check("regr_r007_the_win_is_remembered_for_the_run", _gs.boss_defeated.mini_boss);
                Scenario_ClearUi();
                room_goto(rm_floor4);
                Scenario_Next(_s, 248);
            }
            break;
        case 248:   // come back from rm_floor4: still gone; then a new run
            if (!variable_struct_exists(_rg, "hop_t") && _s.t > 30 && Scenario_FloorReady(rm_floor4)) {
                _rg.hop_t = _s.t;
                room_goto(rm_floor5);
            }
            if (variable_struct_exists(_rg, "hop_t") && _s.t > _rg.hop_t + 40 && Scenario_FloorReady(rm_floor5)) {
                Scenario_Check("regr_r007_the_mini_boss_stays_removed_after_leaving_and_coming_back", !instance_exists(obj_mini_boss));
                Dialogue_CloseNow();
                Scenario_ClearUi();
                _gs.in_main_menu = false;
                Run_StartNew(false, 7008);
                Scenario_Next(_s, 249);
            }
            if (_s.t > 900) { Scenario_Check("regr_r007_leaves_and_comes_back", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 249:   // the new run: rm_floor5 has its mini boss again
            if (_s.t > 5 && room == rm_floor1 && Scenario_FloorReady(rm_floor1) && !variable_struct_exists(_rg, "goto5")) {
                _rg.goto5 = _s.t;
                room_goto(rm_floor5);
            }
            if (variable_struct_exists(_rg, "goto5") && _s.t > _rg.goto5 + 40 && Scenario_FloorReady(rm_floor5)) {
                var _mb249 = instance_exists(obj_mini_boss) ? instance_find(obj_mini_boss, 0) : noone;
                Scenario_Check("regr_r007_a_new_run_brings_the_mini_boss_back", _mb249 != noone && !_mb249.defeated && !_gs.boss_defeated.mini_boss);
                Scenario_Next(_s, 250);   // bug hunt 2 (250..268) goes on from here; its last step goes on with H10 (550..559)
            }
            if (_s.t > 900) { Scenario_Check("regr_r007_new_run_reaches_rm_floor5", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- Bug hunt 2 (D122, D33, D63, D64, D66), steps 250..269. They go on from the new game of the mini boss steps (249); the last one calls Scenario_NoticeEnd.
// 250..252: a chasing dire wolf 3 tiles away stands still while the pause (focus loss), the Tab menu or a tutorial pop-up is open, and goes on when it closes.
// 253..263: seed A in rm_floor4: each enemy's home survives leaving and coming back, a battle return and Continue; the exit tile the player stands on after
//           a battle or Continue ignores them until they step off it.
// 264..268: an auto-resolved enemy, an autosave and Continue: the two others keep their types, places and elites. ----
function Scenario_Hunt2DirAction(_dir) {
    switch (_dir) {
        case UP: return "move_up";
        case DOWN: return "move_down";
        case LEFT: return "move_left";
        case RIGHT: return "move_right";
    }
    return "move_up";
}

// An exit of the room with a gate direction (the player must walk INTO it); noone when there is none.
function Scenario_Hunt2Exit() {
    var _e = noone;
    with (obj_room_transition) {
        if (_e == noone && transition_id != "" && require_dir != -1) _e = id;
    }
    return _e;
}

// A new run of the seed from another room (restarting the room the player is in would not spawn him again). True once rm_floor1 is up with the player.
function Scenario_Hunt2Begin(_s, _h, _seed) {
    if (!variable_struct_exists(_h, "bph")) _h.bph = 0;
    switch (_h.bph) {
        case 0:
            if (Transition_IsActive()) return false;
            Dialogue_CloseNow();
            Scenario_ClearUi();
            room_goto(rm_floor2);
            _h.bph = 1;
            _h.bt = _s.t;
            return false;
        case 1:
            if (_s.t > _h.bt + 30 && Scenario_FloorReady(rm_floor2)) {
                Run_StartNew(false, _seed);
                _h.bph = 2;
                _h.bt = _s.t;
            }
            return false;
        case 2:
            if (_s.t > _h.bt + 5 && Scenario_FloorReady(rm_floor1)) {
                _h.bph = 0;
                return true;
            }
            return false;
    }
    return false;
}

function Scenario_StepSmokeHunt2(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "h2")) _s.h2 = { v: 0, ph: 0, need_run: true, tries: 0 };
    var _h = _s.h2;
    var _T = GRID_TILE_SIZE;
    var _names = ["pause", "tab_menu", "tutorial_popup"];
    var _nm = _names[min(_h.v, 2)];
    switch (_s.step) {
        case 250:   // stage: a dire wolf 3 tiles from the player in rm_floor1's open corridor (part v of 3)
            if (_h.need_run) {
                if (!Scenario_Hunt2Begin(_s, _h, 7101)) {
                    if (_s.t > 1500) { Scenario_Check("hunt2_a_new_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
                    break;
                }
                _h.need_run = false;
                _s.t = 0;
            }
            if (!Scenario_FloorReady(rm_floor1)) {
                if (_s.t > 600) { _h.need_run = true; _s.t = 0; }
                break;
            }
            if (_s.t > 5) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                global.tutorial_off = true;
                with (obj_enemy) instance_destroy();
                _h.w = instance_create_layer(16 * _T, 9 * _T, "Instances", obj_dire_wolf);
                Scenario_PlaceEnemy(_h.w, 16, 9);
                Scenario_FaceEnemy(_h.w, RIGHT);   // D179: toward the player, who stands to its right
                Scenario_PlacePlayer(19, 9);
                _h.ph = 0;
                Scenario_Next(_s, 251);
            }
            break;
        case 251:   // the wolf runs at the player; then the screen opens (pause by Focus_Step(false), Tab menu by the real key, a tutorial pop-up)
            if (!instance_exists(_h.w) || room != rm_floor1) {
                Scenario_Check("hunt2_" + _nm + "_the_wolf_is_in_the_room", false, "room=" + room_get_name(room));
                Scenario_RestoreFocus();
                _h.need_run = true;
                _h.v++;
                Scenario_Next(_s, (_h.v < 3) ? 250 : 253);
                break;
            }
            var _w = _h.w;
            if (_h.ph == 0) {
                if (variable_instance_exists(_w, "ai_mode") && _w.ai_mode == "chase" && _w.moving && _gs.ui.mode == UI_NONE) {
                    if (_h.v == 0) Focus_Step(false);
                    else if (_h.v == 1) Scenario_Tap("menu");
                    else {
                        Scenario_TutorialForget();
                        global.tutorial_off = false;
                        Scenario_Check("hunt2_the_tutorial_popup_opens", Tutorial_Trigger("cards"));
                    }
                    _h.ph = 1;
                    _h.t1 = _s.t;
                } else if (_s.t > 150) {
                    Scenario_Check("hunt2_" + _nm + "_the_wolf_chases_the_player", false, "ai_mode=" + (variable_instance_exists(_w, "ai_mode") ? string(_w.ai_mode) : "none") + " moving=" + string(_w.moving));
                    Scenario_RestoreFocus();
                    with (obj_enemy) instance_destroy();
                    _h.v++;
                    Scenario_Next(_s, (_h.v < 3) ? 250 : 253);
                }
            } else {
                var _open = (_h.v == 0) ? Menu_IsOpen() : ((_h.v == 1) ? (_gs.ui.mode == UI_MENU) : Tutorial_IsOpen());
                if (_open && _s.t >= _h.t1 + 3) {
                    Scenario_Check("hunt2_" + _nm + "_is_open_while_the_wolf_chases", true);
                    _h.x0 = _w.x;
                    _h.y0 = _w.y;
                    _h.d0 = point_distance(_w.x, _w.y, instance_find(obj_player, 0).x, instance_find(obj_player, 0).y);
                    _h.drift = 0;
                    _h.f0 = _s.f;
                    _h.ph = 0;
                    Scenario_Next(_s, 252);
                } else if (_s.t > _h.t1 + 60) {
                    Scenario_Check("hunt2_" + _nm + "_is_open_while_the_wolf_chases", false, "mode=" + string(_gs.ui.mode));
                    Scenario_RestoreFocus();
                    with (obj_enemy) instance_destroy();
                    _h.v++;
                    Scenario_Next(_s, (_h.v < 3) ? 250 : 253);
                }
            }
            break;
        case 252:   // 120 frames behind the screen: the wolf does not move and no fight starts; closed: it goes on
            var _w2 = _h.w;
            if (_h.ph == 0) {
                var _gone = !instance_exists(_w2) || room != rm_floor1;
                if (!_gone) _h.drift = max(_h.drift, abs(_w2.x - _h.x0) + abs(_w2.y - _h.y0));
                var _started = _gone || Transition_IsActive();
                if (_h.drift > 0 || _started || (_s.f - _h.f0) >= 120) {
                    Scenario_Check("hunt2_" + _nm + "_the_enemy_stands_still_behind_it_for_120_frames", _h.drift == 0 && !_started, "drift=" + string(_h.drift) + " frames=" + string(_s.f - _h.f0) + " from " + string(_h.d0) + " px away");
                    Scenario_Check("hunt2_" + _nm + "_no_fight_starts_behind_it", !_started && room == rm_floor1, "room=" + room_get_name(room) + " transition=" + string(Transition_IsActive()));
                    if (_h.drift > 0 || _started) {   // the red case: no need to wait for the fight
                        with (obj_enemy) instance_destroy();
                        if (room != rm_floor1 || Transition_IsActive()) _h.need_run = true;
                        if (_h.v == 0) { Focus_Step(true); if (Menu_IsOpen()) Menu_Close(true); }
                        if (_h.v == 2) { Tutorial_Dismiss(); global.tutorial_off = true; }
                        if (_h.v == 1 && _gs.ui.mode == UI_MENU) Scenario_Tap("menu");
                        _h.v++;
                        _h.ph = 0;
                        Scenario_Next(_s, (_h.v < 3) ? 250 : 253);
                        break;
                    }
                    if (_h.v == 0) { Focus_Step(true); Menu_Close(true); }
                    else if (_h.v == 1) Scenario_Tap("menu");
                    else { Tutorial_Dismiss(); global.tutorial_off = true; }
                    _h.ph = 1;
                    _h.t2 = _s.t;
                }
            } else {
                var _moved = instance_exists(_w2) && (abs(_w2.x - _h.x0) + abs(_w2.y - _h.y0)) > 0;
                var _fight = (room != rm_floor1) || Transition_IsActive();
                if (_moved || _fight || _s.t > _h.t2 + 200) {
                    Scenario_Check("hunt2_" + _nm + "_closed_the_enemy_goes_on_hunting", _moved || _fight, "frames=" + string(_s.t - _h.t2));
                    with (obj_enemy) instance_destroy();
                    if (room != rm_floor1 || Transition_IsActive()) _h.need_run = true;
                    _h.v++;
                    _h.ph = 0;
                    Scenario_Next(_s, (_h.v < 3) ? 250 : 253);
                }
            }
            break;
        // ---------------------------------------------------------------- homes and the exit tile (rm_floor4, seed A)
        case 253:
            if (Scenario_Hunt2Begin(_s, _h, 7102 + _h.tries)) {
                global.tutorial_off = true;
                room_goto(rm_floor4);
                Scenario_Next(_s, 254);
            } else if (_s.t > 1500) { Scenario_Check("hunt2_seed_a_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 254:   // the first visit: the shuffle deals the enemies; their homes are the dealt spots; leave (the exit snapshot) and come back
            if (_s.t > 5 && Scenario_FloorReady(rm_floor4)) {
                Scenario_Check("hunt2_floor4_has_its_three_enemies", instance_number(obj_enemy) == 3, "n=" + string(instance_number(obj_enemy)));
                var _off = false;   // the check is only worth anything when the deal put an enemy somewhere else than its authored spot (the seeds are tried in order)
                with (obj_enemy) { if (home_x != xstart || home_y != ystart) _off = true; }
                if (!_off && _h.tries < 12) { _h.tries++; Scenario_Next(_s, 253); break; }
                Scenario_Check("hunt2_the_deal_moved_an_enemy_off_its_authored_spot", _off, "tries=" + string(_h.tries));
                _h.sigA = Scenario_EcoLayoutSig();
                RoomState_OnRoomExit();
                room_goto(rm_floor3);
                Scenario_Next(_s, 255);
            }
            if (_s.t > 600) { Scenario_Check("hunt2_reaches_rm_floor4", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 255:
            if (_s.t > 20 && Scenario_FloorReady(rm_floor3)) {
                room_goto(rm_floor4);
                Scenario_Next(_s, 256);
            }
            if (_s.t > 600) { Scenario_Check("hunt2_reaches_rm_floor3", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 256:   // back: homes as before; then the player stands on an exit tile and meets an enemy: the battle is entered and fled from
            if (_s.t > 5 && Scenario_FloorReady(rm_floor4)) {
                _h.sigA1 = Scenario_EcoLayoutSig();
                Scenario_Check("hunt2_leaving_and_coming_back_keeps_each_enemys_home", _h.sigA1 == _h.sigA, _h.sigA + " vs " + _h.sigA1);
                var _ex = Scenario_Hunt2Exit();
                Scenario_Check("hunt2_floor4_has_an_exit_with_a_gate_direction", _ex != noone);
                if (_ex == noone || instance_number(obj_enemy) < 1) { Scenario_NoticeEnd(); break; }
                _h.ex_cx = round(_ex.bbox_left / _T);
                _h.ex_cy = round(_ex.bbox_top / _T);
                _h.ex_act = Scenario_Hunt2DirAction(_ex.require_dir);
                var _plb = Scenario_PlacePlayer(_h.ex_cx, _h.ex_cy);
                Scenario_Check("hunt2_the_encounter_is_saved_for_the_battle", EnemyPersist_BeginEncounter(instance_find(obj_enemy, 0), _plb));   // saves the room's enemies, as a touch does
                room_goto(rm_battle);
                _h.res = false;
                Scenario_Next(_s, 257);
            }
            if (_s.t > 600) { Scenario_Check("hunt2_returns_to_rm_floor4", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 257:   // the battle is fled from (the same calls as Battle_EndRun)
            if (room == rm_battle && _s.t > 20 && instance_exists(obj_battle_controller) && !Transition_IsActive()) {
                if (!_h.res) {
                    _h.res = true;
                    EnemyPersist_ResolveBattle(false);
                    GameState_SetJustReturned(true);
                }
                if (Transition_RequestRoomFade(_gs.battle.return_room)) Scenario_Next(_s, 258);
            }
            if (_s.t > 600) { Scenario_Check("hunt2_reaches_the_battle", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 258:   // back on the exit tile: the homes are as before; the exit ignores the player; a press INTO the exit does not leave the room
            if (_s.t > 3 && Scenario_FloorReady(rm_floor4)) {   // the enemies do not hunt in the fade-in: look and clear them at the first frame
                _h.sigB = Scenario_EcoLayoutSig();
                Scenario_Check("hunt2_a_battle_return_keeps_each_enemys_home", _h.sigB == _h.sigA, _h.sigA + " vs " + _h.sigB);
                var _plc = instance_find(obj_player, 0);
                var _exb = instance_position(_plc.x + _T / 2, _plc.y + _T / 2, obj_room_transition);
                Scenario_Check("hunt2_the_battle_return_puts_the_player_back_on_the_exit_tile", _exb != noone, "x=" + string(_plc.x) + " y=" + string(_plc.y));
                Scenario_Check("hunt2_the_exit_under_the_returning_player_is_ignored_until_he_steps_off", _plc.exit_ignore != noone && _plc.exit_ignore == _exb);
                with (obj_enemy) instance_destroy();
                Scenario_Hold(_h.ex_act, 40);
                Scenario_Next(_s, 259);
            }
            if (_s.t > 600) { Scenario_Check("hunt2_battle_return_reaches_rm_floor4", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 259:
            if (room != rm_floor4) with (obj_enemy) instance_destroy();   // the exit of the red case leads into a room full of hunters
            if (_s.t == 45) {
                var _left = (room != rm_floor4 || Transition_IsActive());
                Scenario_Check("hunt2_a_press_into_the_exit_after_a_battle_return_does_not_leave_the_room", !_left, "room=" + room_get_name(room) + " transition=" + string(Transition_IsActive()));
                if (_left) {   // the red case: back to rm_floor4 for what follows
                    Transition_Finish();
                    with (obj_enemy) instance_destroy();
                }
                Scenario_Next(_s, 260);
            }
            break;
        case 260:   // the player on the exit tile again, the run saved, and Continue (it also loads into the room the player is in)
            if (Transition_IsActive()) break;
            if (!Scenario_FloorReady(rm_floor4)) {
                if (!variable_struct_exists(_h, "back")) { _h.back = true; room_goto(rm_floor4); }
                if (_s.t > 900) { Scenario_Check("hunt2_back_in_rm_floor4_for_the_save", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
                break;
            }
            Scenario_ClearUi();
            with (obj_enemy) instance_destroy();
            Scenario_PlacePlayer(_h.ex_cx, _h.ex_cy);
            if (!Scenario_CanSaveSlot()) {
                show_debug_message("[TEST] SKIP hunt2 continue (LOCALAPPDATA is not the gate scratch folder)");
                Scenario_Next(_s, 264);
                break;
            }
            Scenario_Check("hunt2_the_run_is_saved_with_the_player_on_the_exit_tile", RunSave_WriteTo());
            Scenario_Check("hunt2_continue_starts", Run_Continue().ok);
            Scenario_Next(_s, 262);
            break;
        case 262:   // Continue: the homes as before; the player on the exit tile, which ignores him; a press INTO the exit does not leave the room
            if (_s.t > 3 && Scenario_FloorReady(rm_floor4) && !(variable_struct_exists(_gs, "load_spawn_pending") && _gs.load_spawn_pending)) {
                _h.sigC = Scenario_EcoLayoutSig();
                Scenario_Check("hunt2_continue_keeps_each_enemys_home", _h.sigC == _h.sigA, _h.sigA + " vs " + _h.sigC);
                var _pld = instance_find(obj_player, 0);
                var _exc = instance_position(_pld.x + _T / 2, _pld.y + _T / 2, obj_room_transition);
                Scenario_Check("hunt2_continue_puts_the_player_back_on_the_exit_tile", _exc != noone, "x=" + string(_pld.x) + " y=" + string(_pld.y));
                Scenario_Check("hunt2_the_exit_under_the_continued_player_is_ignored_until_he_steps_off", _pld.exit_ignore != noone && _pld.exit_ignore == _exc);
                with (obj_enemy) instance_destroy();
                Scenario_Hold(_h.ex_act, 40);
                Scenario_Next(_s, 263);
            }
            if (_s.t > 900) { Scenario_Check("hunt2_continue_reaches_rm_floor4", false, "room=" + room_get_name(room) + " transition=" + string(Transition_IsActive()) + " load_spawn_pending=" + string(variable_struct_exists(_gs, "load_spawn_pending") ? _gs.load_spawn_pending : -1) + " enemy=" + string(variable_struct_exists(_gs, "battle") ? _gs.battle.enemy_id : -1)); Scenario_NoticeEnd(); }
            break;
        case 263:
            if (_s.t == 45) {
                Scenario_Check("hunt2_a_press_into_the_exit_after_continue_does_not_leave_the_room", room == rm_floor4 && !Transition_IsActive(), "room=" + room_get_name(room) + " transition=" + string(Transition_IsActive()));
                Scenario_Next(_s, 264);
            }
            break;
        // ---------------------------------------------------------------- an auto-resolved enemy and Continue (rm_floor4, seed B)
        case 264:
            if (Scenario_Hunt2Begin(_s, _h, 7103)) {
                room_goto(rm_floor4);
                Scenario_Next(_s, 265);
            } else if (_s.t > 1500) { Scenario_Check("hunt2_seed_b_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 265:   // one of the three enemies is overpowered (the real auto-resolve path, with the player at the level cap)
            if (_s.t > 5 && Scenario_FloorReady(rm_floor4)) {
                Scenario_Check("hunt2_floor4_has_its_three_enemies_for_seed_b", instance_number(obj_enemy) == 3, "n=" + string(instance_number(obj_enemy)));
                var _pick = noone;
                with (obj_enemy) { if (_pick == noone && elite_mod == "") _pick = id; }
                if (_pick == noone) { Scenario_Check("hunt2_floor4_has_an_enemy_that_is_not_an_elite", false); Scenario_NoticeEnd(); break; }
                if (!Enemy_CanAutoResolve(EnemyDB_Get(_pick.enemy_id), LEVEL_CAP, _pick.enemy_level)) {   // a type that is always fought: the one that goes is a slime
                    _pick.enemy_id = ENEMY_SLIME;
                    _pick.enemy_level = 1;
                    Enemy_ReapplyConfig(_pick);
                }
                _gs.player_ch.level = LEVEL_CAP;
                Scenario_Check("hunt2_the_auto_resolve_starts", Enemy_AutoResolveEncounter(_pick, instance_find(obj_player, 0)));
                Scenario_Next(_s, 266);
            }
            if (_s.t > 600) { Scenario_Check("hunt2_seed_b_reaches_rm_floor4", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 266:   // the fight is over at the black flash; the layout of the two left, then an autosave and a room away
            if (_s.t > 10 && !Transition_IsActive() && !is_struct(_gs.auto_resolve_pending) && room == rm_floor4) {
                Scenario_Check("hunt2_the_auto_resolved_enemy_is_gone", instance_number(obj_enemy) == 2, "n=" + string(instance_number(obj_enemy)));
                _h.sigR = Scenario_EcoLayoutSig();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP hunt2 auto-resolve continue (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_NoticeEnd();
                    break;
                }
                Scenario_Check("hunt2_the_run_is_saved_after_the_auto_resolve", RunSave_WriteTo());
                Scenario_Check("hunt2_continue_after_the_auto_resolve_starts", Run_Continue().ok);
                Scenario_Next(_s, 268);
            }
            if (_s.t > 900) { Scenario_Check("hunt2_the_auto_resolve_ends", false, "room=" + room_get_name(room) + " pending=" + string(is_struct(_gs.auto_resolve_pending))); Scenario_NoticeEnd(); }
            break;
        case 268:   // Continue: the same two enemies (types, homes, elites); the third stays gone
            if (_s.t > 3 && Scenario_FloorReady(rm_floor4) && !(variable_struct_exists(_gs, "load_spawn_pending") && _gs.load_spawn_pending)) {
                var _sigD = Scenario_EcoLayoutSig();
                Scenario_Check("hunt2_the_auto_resolved_enemy_stays_gone_after_continue", instance_number(obj_enemy) == 2, "n=" + string(instance_number(obj_enemy)));
                Scenario_Check("hunt2_continue_after_an_auto_resolve_keeps_the_layout_of_the_room", _sigD == _h.sigR, _h.sigR + " vs " + _sigD);
                Scenario_Next(_s, 320);   // G4 (D127, 320..339) first; it goes on to the title steps (270..275), which end the run
            }
            if (_s.t > 900) { Scenario_Check("hunt2_continue_reaches_rm_floor4_again", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
    }
}

// ============================================================================
// G8 (D136): the Rumble setting (smoke steps 360-379, the end of the chain). A new run in rm_floor1; the pause key, Settings, five Downs to the Rumble
// row (real keys), Right flips it in the pending copy only; Apply saves it; the file and the live settings say Off; a reload from the file keeps Off;
// the Settings screen shows it; flipped back On the same way. With the setting Off, or the keyboard as the last device, an event starts no rumble.
// No pad is attached to the gate PC: the motors themselves (gamepad_set_vibration) are not reached here.
// ============================================================================
function Scenario_RumbleRowIndex(_sp, _id) {
    var _r = -1;
    for (var _i = 0; _i < array_length(_sp.menu.items); _i++) if (_sp.menu.items[_i].id == _id) _r = _i;
    return _r;
}

function Scenario_StepSmokeRumble(_s) {
    var _gs = GameState_Get();
    SettingsPopup_Ensure();
    var _sp = _gs.ui.settings_popup;
    switch (_s.step) {
        case 360:   // the title's New Game (the last Title step) is running: the intro cutscene, held through like D48's skip
            if (_s.t > 1 && room == rm_cutscene && instance_exists(obj_start_controller) && obj_start_controller.cutscene_started && !Transition_IsActive() && _gs.ui.mode == UI_DIALOGUE) {
                Scenario_Hold("confirm", 150);
                Scenario_Next(_s, 361);
            }
            if (_s.t > 900) { Scenario_Check("g8_new_game_reaches_the_intro", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 361:   // through the rm_floor1 intro dialogue; then the menu with the real Esc key
            if (_s.t > 1200) { Scenario_Check("g8_new_game_reaches_rm_floor1", false, "room=" + room_get_name(room) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            if (room == rm_floor1 && !Transition_IsActive()) {
                if (_gs.ui.mode == UI_DIALOGUE) {
                    if ((_s.f - _s.last_tap) >= 8) Scenario_Tap("confirm");
                } else if (_s.t > 60 && array_length(_gs.ui.lines) <= 0 && variable_struct_exists(_gs, "pending_floor1_intro_dialogue") && !_gs.pending_floor1_intro_dialogue && Scenario_FloorReady(rm_floor1)) {
                    Dialogue_CloseNow();
                    Scenario_ClearUi();
                    global.tutorial_off = true;
                    with (obj_enemy) instance_destroy();
                    with (obj_dialogue_trigger) instance_destroy();
                    Scenario_Check("g8_rumble_defaults_to_on", GameSettings_Ensure().rumble == 1);
                    Scenario_Check("g8_the_rumble_state_is_idle", Rumble_Get().left == 0 && Rumble_Get().right == 0 && Rumble_Get().ms == 0);
                    Ui_MemSet(Ui_MemGlobal(), "tab_menu_active", 0);
                    Scenario_Tap("pause");
                    Scenario_Next(_s, 362);
                }
            }
            break;
        case 362:   // Esc -> the menu on Status -> Q Q -> the Settings tab
            if (_s.t == 12) {
                Scenario_Check("g8_the_menu_is_open", Menu_IsOpen());
                Scenario_Tap("tab_prev");
            }
            if (_s.t == 19) Scenario_Tap("tab_prev");
            if (_s.t == 26) {
                Scenario_Check("g8_the_menu_is_on_the_settings_tab", is_struct(TabMenu_Get()) && TabMenu_Get().tab == 5, "tab=" + string(is_struct(TabMenu_Get()) ? TabMenu_Get().tab : -1));
            }
            if (_s.t == 45) {
                Scenario_Check("g8_settings_is_open", SettingsPopup_IsOpen("tab"));
                Scenario_Next(_s, 363);
            }
            if (_s.t > 200) { Scenario_Check("g8_settings_opens_from_the_menu", false, "mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 363:   // five Downs: vol_ui -> vol_sfx -> vol_bgm -> text_speed -> shake -> rumble; Right flips it at once
            if (_s.t == 1) Ui_MenuFixCursor(_sp.menu, 0);   // the cursor is remembered from an earlier visit (the title's Settings)
            if (_s.t == 8 || _s.t == 15 || _s.t == 22 || _s.t == 29 || _s.t == 36) Scenario_Tap("menu_down");
            if (_s.t == 48) {
                Scenario_Check("g8_the_cursor_is_on_the_rumble_row", _sp.menu.items[_sp.menu.cursor].id == "rumble", "row=" + string(_sp.menu.items[_sp.menu.cursor].id));
                Scenario_Check("g8_the_rumble_row_says_on", _sp.menu.items[_sp.menu.cursor].value == Loc_T("settings.value.on", "On"));
                Scenario_Tap("menu_right");
            }
            if (_s.t == 58) {
                var _ri = Scenario_RumbleRowIndex(_sp, "rumble");
                Scenario_Check("g8_right_flips_rumble_at_once", _ri >= 0 && GameSettings_Ensure().rumble == 0 && !Settings_RumbleOn());
                Scenario_Check("g8_the_row_now_says_off", _ri >= 0 && _sp.menu.items[_ri].value == Loc_T("settings.value.off", "Off"));
                Scenario_Next(_s, 364);
            }
            break;
        case 364:   // the live settings and the file say Off (saved at once); a reload from the file keeps it
            if (_s.t == 15) {
                var _disk = Save_ReadSettingsConfig();
                Scenario_Check("g8_the_change_makes_rumble_off_live", GameSettings_Ensure().rumble == 0 && !Settings_RumbleOn());
                Scenario_Check("g8_the_change_writes_it_to_the_settings_file", is_struct(_disk) && _disk.rumble == 0);
                _gs.settings = _disk;   // what the next start does: the settings come back from the file
                Scenario_Check("g8_a_reload_from_the_file_keeps_rumble_off", GameSettings_Ensure().rumble == 0);
                Scenario_Check("g8_with_rumble_off_an_event_starts_nothing", !Rumble_Dispatch("death") && Rumble_Get().ms == 0 && Rumble_Get().left == 0);
                global.input.last_device = "keyboard";
                GameSettings_Ensure().rumble = 1;
                Scenario_Check("g8_with_the_keyboard_as_last_device_an_event_starts_nothing", !Rumble_Dispatch("death") && Rumble_Get().ms == 0 && Rumble_Get().left == 0);
                GameSettings_Ensure().rumble = 0;
                Scenario_Tap("cancel");   // Back at the root of Settings closes the menu (everything is saved already)
                Scenario_Next(_s, 365);
            }
            break;
        case 365:   // open the menu again (it opens on Settings, the tab used last): the row shows Off; flip it back On the same way
            if (_s.t == 30) {
                Scenario_Check("g8_back_closes_the_menu", !SettingsPopup_IsOpen("tab") && !Menu_IsOpen());
                Scenario_Tap("pause");
            }
            if (_s.t == 55) {
                Scenario_Check("g8_settings_opens_again", SettingsPopup_IsOpen("tab"));
                var _r2 = Scenario_RumbleRowIndex(_sp, "rumble");
                Scenario_Check("g8_the_screen_shows_rumble_off_after_the_reload", _r2 >= 0 && _sp.menu.items[_r2].value == Loc_T("settings.value.off", "Off"));
                Ui_MenuFixCursor(_sp.menu, _r2);
                Scenario_Tap("menu_right");
            }
            if (_s.t == 65) {
                Scenario_Check("g8_right_flips_it_back_on", GameSettings_Ensure().rumble == 1);
                var _disk2 = Save_ReadSettingsConfig();
                Scenario_Check("g8_the_change_saves_rumble_on_again", GameSettings_Ensure().rumble == 1 && is_struct(_disk2) && _disk2.rumble == 1);
                Scenario_Tap("cancel");
            }
            if (_s.t == 105) {
                Scenario_Check("g8_the_menu_is_closed_again", !SettingsPopup_IsOpen("tab") && !Menu_IsOpen());
                Scenario_Next(_s, 340);   // G5 (D130, 340..359): the echo after the class pick; the chain ends there
            }
            break;
    }
}

// ============================================================================
// G4 (D127): the first class chest of a run cannot be skipped (smoke steps 320-339, after bug hunt 2). A new run in rm_floor1, the class not chosen:
// walking into the exit (real held key) does not leave the room, plays the two lines (each confirmed) and ends with the player one tile back inside
// the room; the same again; then the class chest is opened by the interact key and a class picked through the screen, and the exit leaves the room.
// ============================================================================
function Scenario_StepSmokeClassGuard(_s) {
    var _gs = GameState_Get();
    var _T = GRID_TILE_SIZE;
    if (!variable_struct_exists(_s, "cg")) _s.cg = { attempt: 1, c0: 0, maxidx: -1, q: [], qset: false, quiet: 0, closed_t: -1 };
    var _cg = _s.cg;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _talk = (_gs.ui.mode == UI_DIALOGUE || array_length(_gs.ui.lines) > 0);
    switch (_s.step) {
        case 320:   // a new run (from another room: restarting the room the player is in would not spawn him again); the player one tile from the exit
            if (!variable_struct_exists(_cg, "begun")) {
                if (!Scenario_Hunt2Begin(_s, _cg, 7301)) {
                    if (_s.t > 1500) { Scenario_Check("g4_a_new_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
                    break;
                }
                _cg.begun = true;
                _s.t = 0;
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1)) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                global.tutorial_off = true;
                Profile_Get().echo_pool = [];   // D130: an earlier death's echo would open its pick after the class is chosen here; that is checked in 340+
                with (obj_enemy) instance_destroy();
                with (obj_dialogue_trigger) instance_destroy();
                Scenario_Check("g4_a_new_run_has_not_chosen_a_class", !_gs.player_ch.class_chosen && _gs.player_ch.class_id == CLASS_NOBODY);
                _pl = Scenario_PlacePlayer(17, 3);   // the exit of rm_floor1 is the tile (18, 3), entered moving right
                _pl.face = RIGHT;
                _cg.c0 = Scenario_ExitCount();
                Scenario_Hold("move_right", 60);
                Scenario_Next(_s, 321);
            }
            break;
        case 321:   // the held key walks into the exit: the room stays, the lines open
            if (room != rm_floor1 || Transition_IsActive()) {
                Scenario_Release();
                Scenario_Check("g4_try" + string(_cg.attempt) + "_the_exit_does_not_fire_before_the_class_chest", false, "room=" + room_get_name(room));
                Scenario_NoticeEnd();
                break;
            }
            if (_gs.ui.mode == UI_DIALOGUE) {
                Scenario_Release();
                var _raw = _gs.ui.lines_raw;
                Scenario_Check("g4_try" + string(_cg.attempt) + "_the_room_does_not_change", room == rm_floor1 && Scenario_ExitCount() == _cg.c0 && !Transition_IsActive());
                Scenario_Check("g4_try" + string(_cg.attempt) + "_two_lines_open", array_length(_raw) == 2, "lines=" + string(array_length(_raw)));
                Scenario_Check("g4_try" + string(_cg.attempt) + "_line_1", array_length(_raw) > 0 && string(_raw[0]) == "Wait. There was a chest back there.");
                Scenario_Check("g4_try" + string(_cg.attempt) + "_line_2", array_length(_raw) > 1 && string(_raw[1]) == "...Something in it might keep me alive.");
                _cg.maxidx = 0;
                _cg.closed_t = -1;
                Scenario_Next(_s, 322);
            } else if (_s.t > 120) {
                Scenario_Release();
                Scenario_Check("g4_try" + string(_cg.attempt) + "_the_lines_open_at_the_exit", false, "x=" + ((_pl != noone) ? string(_pl.x) : "?") + " room=" + room_get_name(room));
                Scenario_NoticeEnd();
            }
            break;
        case 322:   // each line confirmed; then the player steps back one tile (away from the exit) and stands still
            if (_gs.ui.mode == UI_DIALOGUE) {
                _cg.maxidx = max(_cg.maxidx, _gs.ui.index);
                if ((_s.f - _s.last_tap) >= 12) Scenario_Tap("confirm");
            }
            if (!_talk && !UI_IsBlocking() && _cg.closed_t < 0) _cg.closed_t = _s.t;
            if (_cg.closed_t >= 0 && _s.t - _cg.closed_t > 60 && _pl != noone && Player_IsSettled(_pl)) {
                Scenario_Check("g4_try" + string(_cg.attempt) + "_two_boxes_were_shown", _cg.maxidx == 1, "last box index=" + string(_cg.maxidx));
                Scenario_Check("g4_try" + string(_cg.attempt) + "_still_in_rm_floor1_and_no_exit_fired", room == rm_floor1 && Scenario_ExitCount() == _cg.c0 && !Transition_IsActive());
                Scenario_Check("g4_try" + string(_cg.attempt) + "_the_player_stepped_back_one_tile_on_the_grid", _pl.x == 16 * _T && _pl.y == 3 * _T, "at " + string(_pl.x) + "," + string(_pl.y));
                if (_cg.attempt == 1) {
                    _cg.attempt = 2;   // again, from here: two tiles of walking (a turn first), the same refusal
                    Scenario_Hold("move_right", 70);
                    Scenario_Next(_s, 321);
                } else {
                    Scenario_Next(_s, 323);
                }
            }
            if (_s.t > 900) { Scenario_Check("g4_try" + string(_cg.attempt) + "_the_lines_end_and_the_player_settles", false, "ui=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 323:   // the class chest (rm_floor1's own, tile (6, 5)) opened with the interact key; the class screen: Knight, "are you sure": Yes
            if (_s.t == 1) {
                Scenario_ClearUi();
                _pl = Scenario_PlacePlayer(5, 5);
                _pl.face = RIGHT;
            }
            if (_s.t == 20) Scenario_Tap("interact");
            Scenario_CardsTapQueue(_s, _cg);
            if (_talk && (_s.f - _s.last_tap) >= 12) Scenario_Tap("confirm");
            if (_s.t > 30 && CardsUi_Kind() == "class" && !_cg.qset) {
                _cg.qset = true;
                _cg.q = ["confirm", "menu_up", "confirm"];
            }
            if (_gs.player_ch.class_chosen && !_talk && !Transition_IsActive() && !CardsUi_IsOpen() && !UI_IsBlocking()) _cg.quiet++;
            else _cg.quiet = 0;
            if (_cg.quiet > 40) {
                Scenario_Check("g4_the_class_chest_gives_a_class", _gs.player_ch.class_chosen && _gs.player_ch.class_id == CLASS_KNIGHT, "class=" + string(_gs.player_ch.class_id));
                Scenario_Next(_s, 324);
            }
            if (_s.t > 1500) { Scenario_Check("g4_the_class_is_picked_at_the_chest", false, "kind=" + CardsUi_Kind() + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 324:   // the class chosen: the exit works as before
            if (_s.t == 1) {
                Scenario_ClearUi();
                with (obj_enemy) instance_destroy();
                _pl = Scenario_PlacePlayer(17, 3);
                _pl.face = RIGHT;
                _cg.c0 = Scenario_ExitCount();
                Scenario_Hold("move_right", 40);
            }
            if (room == rm_floor2 || _s.t > 400) {
                Scenario_Check("g4_with_a_class_the_exit_leaves_rm_floor1", room == rm_floor2 && Scenario_ExitCount() - _cg.c0 == 1, "room=" + room_get_name(room) + " exits=" + string(Scenario_ExitCount() - _cg.c0));
                Scenario_Next(_s, 270);   // G2 (D128): the launch splash, the menu and the Continue card (270..275); the last one ends the run
            }
            break;
    }
}

// ============================================================================
// G5 (D130, reworked for D144): the echo is offered right after the class pick (smoke steps 340-359). A Knight with a Knight skill and an item dies;
// the death flow (line, summary) shows no echo pick and the next run wakes as the Nobody; the skill is remembered in the profile (skill memory, D148; it survives a
// reload of the profile from disk) and no item pool is kept; the class chest is opened and Knight picked; the echo pick then shows only that discovered Knight skill
// (never an item); taking it puts the skill in the deck. A class with no discovered skill (an old item pool in the profile is ignored) opens no pick at all.
// Writes the real profile.sav / run.sav: only inside the gate (Scenario_CanSaveSlot).
// ============================================================================
function Scenario_StepSmokeEcho(_s) {
    var _gs = GameState_Get();
    var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    if (!variable_struct_exists(_s, "eo")) _s.eo = { q: [], chest: noone, ever_echo: false, summary_t: -1, qset: false, quiet: 0 };
    var _eo = _s.eo;
    var _ch = _gs.player_ch;
    Scenario_CardsTapQueue(_s, _eo);
    if (RunFlow_Active() && global.run_flow.phase == "echo") _eo.ever_echo = true;   // (the phase no longer exists; this stays false)
    if (CardsUi_Kind() == "echo" && _s.step < 344) _eo.ever_echo = true;
    switch (_s.step) {
        case 340:   // a clean profile and a new run: the first run has no echo to offer
            if (_s.t == 1) {
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP echo after the class (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_NoticeEnd();
                    break;
                }
                if (Transition_IsActive()) { _s.t = 0; break; }
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Profile_ResetForTest();
                RunSave_Delete();
                _gs.in_main_menu = false;
                Run_StartNew(false, 7401);
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1)) {
                var _pf0 = Profile_Get();
                Scenario_Check("g5_the_first_run_has_no_echo_pending", variable_struct_exists(_pf0, "echo_pool") && array_length(_pf0.echo_pool) == 0);
                Scenario_Check("g5_the_first_run_is_owed_no_echo", Cards_NextOwed(_gs.player_ch) == "" && array_length(_gs.player_ch.echo_offer) == 0);
                _gs.pending_wake_line = false;
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_Next(_s, 341);
            }
            if (_s.t > 900) { Scenario_Check("g5_a_new_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 341:   // a Knight with the Knight skill Hilt Bash and one MP potion (nothing else) dies
            if (_s.t == 1) {
                var _k = Card_ClassCharacter(_gs.player_ch, CLASS_KNIGHT);
                _k.skills = [SKILL_HILT_BASH];
                _k.inventory = Inv_Add([], 11, 1);
                _k.equip = {};
                GameState_SetSelectedClass(CLASS_KNIGHT);
                GameState_SetPlayer(_k);
                Player_OnDeath(_gs.player_ch);
            }
            if (_s.t > 3) Scenario_TapCutscene(_s);
            if (_s.t > 3 && _sc != noone && _sc.state == "run_flow") {
                var _pf1 = Profile_Get();
                Scenario_Check("g5_death_keeps_the_knight_skill_for_later", Profile_SkillKnown(_pf1, SKILL_HILT_BASH), "known=" + json_stringify(_pf1.skills_known));   // D144: in the skill memory (was: in echo_pool)
                Scenario_Check("g5_death_keeps_no_item_for_later", array_length(_pf1.echo_pool) == 0, "pool=" + json_stringify(_pf1.echo_pool));   // D144 (was g5_death_keeps_the_item_for_later: item 11 in echo_pool)
                Scenario_Check("g5_the_death_flow_starts_with_the_death_line", global.run_flow.phase == "death", "phase=" + string(global.run_flow.phase));
                Scenario_Next(_s, 342);
            }
            if (_s.t > 1200) { Scenario_Check("g5_death_reaches_the_death_flow", false, "room=" + room_get_name(room) + " state=" + (_sc != noone ? string(_sc.state) : "none")); Scenario_NoticeEnd(); }
            break;
        case 342:   // line -> summary -> (one confirm) -> the next run: no echo pick anywhere in between
            if (RunFlow_Active() && global.run_flow.phase == "summary" && _eo.summary_t < 0) _eo.summary_t = _s.t;
            if (_eo.summary_t >= 0 && _s.t == _eo.summary_t + 25) Scenario_Tap("confirm");
            if (_eo.summary_t >= 0 && _s.t > _eo.summary_t + 30 && Scenario_FloorReady(rm_floor1)) {
                var _pf2 = Profile_Get();
                Scenario_Check("g5_the_summary_goes_straight_to_the_next_run_no_echo_pick", !_eo.ever_echo && !CardsUi_IsOpen());
                Scenario_Check("g5_the_next_run_wakes_as_the_nobody", _gs.player_ch.class_id == CLASS_NOBODY && !_gs.player_ch.class_chosen && Run_IsActive());
                Scenario_Check("g5_the_next_run_has_no_echo_yet", array_length(_gs.player_ch.skills) == 0 && Scenario_ItemCount(_gs.player_ch, 11) == Scenario_ItemCount(CharacterCreate_Player(CLASS_NOBODY), 11) && _gs.run.echo_used.kind == "", "echo_used=" + json_stringify(_gs.run.echo_used));
                Scenario_Check("g5_the_skill_memory_waits_in_the_profile", Profile_SkillKnown(_pf2, SKILL_HILT_BASH) && array_length(_pf2.echo_pool) == 0);   // D144 (was g5_the_pool_waits_in_the_profile)
                Scenario_Check("g5_nothing_is_owed_before_the_class_chest", Cards_NextOwed(_gs.player_ch) == "");
                _gs.pending_wake_line = false;
                Dialogue_CloseNow();
                Scenario_ClearUi();
                global.profile = undefined;   // a quit between the death and the class pick: the profile is read from disk again
                var _pf2b = Profile_Get();
                Scenario_Check("g5_the_skill_memory_survives_a_quit_before_the_class_pick", Profile_SkillKnown(_pf2b, SKILL_HILT_BASH) && array_length(_pf2b.echo_pool) == 0, "known=" + json_stringify(_pf2b.skills_known));   // D144 (was g5_the_pool_survives_a_quit_before_the_class_pick)
                Scenario_Next(_s, 343);
            }
            if (_s.t > 1500) { Scenario_Check("g5_the_death_flow_reaches_the_next_run", false, "room=" + room_get_name(room) + " phase=" + (variable_global_exists("run_flow") ? string(global.run_flow.phase) : "none")); Scenario_NoticeEnd(); }
            break;
        case 343:   // the class chest: Knight ("are you sure": Yes)
            if (_s.t == 1) {
                Scenario_ClearUi();
                Scenario_CardsChest(_eo, obj_chest_class_select, "g5_chest_class");
            }
            if (_s.t == 20) Scenario_Tap("interact");
            Scenario_CardsTalk(_s);
            if (_s.t > 30 && CardsUi_Kind() == "class" && !_eo.qset) {
                _eo.qset = true;
                _eo.q = ["confirm", "menu_up", "confirm"];   // the Knight is first; confirm; No -> Yes; confirm (D144: a Knight, because the skill the run found is a Knight skill)
                Scenario_Next(_s, 344);
            }
            if (_s.t > 900) { Scenario_Check("g5_the_class_chest_opens_the_class_screen", false, "kind=" + CardsUi_Kind() + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 344:   // the class is applied behind the flash, its chest line read; then the echo pick opens by itself
            Scenario_CardsTalk(_s);
            if (CardsUi_Kind() == "echo" && InputLock_Settled(global.cards_ui.lock, 4 * TRANSITION_FRAME_MS)) {
                var _m = Ui_StackTop(global.cards_ui.stk);
                Scenario_Check("g5_the_class_is_a_knight", _ch.class_id == CLASS_KNIGHT && _ch.class_chosen, "class=" + string(_ch.class_id));   // D144 (was g5_the_class_is_a_mage)
                Scenario_Check("g5_the_echo_pick_opens_after_the_class_pick", _gs.ui.mode == UI_CARDS && _m.id == "run_echo", "id=" + string(_m.id));
                Scenario_Check("g5_the_echo_pick_shows_only_the_known_skill", array_length(_m.items) == 1 && array_length(_ch.echo_offer) == 1 && _ch.echo_offer[0].kind == "skill" && _ch.echo_offer[0].id == SKILL_HILT_BASH, "offer=" + json_stringify(_ch.echo_offer));   // D144 (was g5_the_echo_pick_shows_only_the_item)
                Scenario_Check("g5_the_skill_is_not_in_the_deck_before_the_answer", array_length(_ch.skills) == 0);   // D144 (was g5_the_pool_still_waits_until_the_answer)
                _eo.items_before = Scenario_ItemCount(_ch, 11);
                _eo.q = ["confirm", "menu_up", "confirm"];   // the pick, the pop-up opens on No: up to Yes, confirm
                Scenario_Next(_s, 345);
            }
            if (_s.t > 1500) { Scenario_Check("g5_the_echo_pick_opens_after_the_class", false, "kind=" + CardsUi_Kind() + " class=" + string(_ch.class_id) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 345:   // taken: the skill is in the deck, nothing is owed any more
            if (array_length(_eo.q) == 2 && !variable_struct_exists(_eo, "asked") && (_s.f - _s.last_tap) >= 6) {
                _eo.asked = true;
                Scenario_Check("confirm_the_echo_asks_before_it_is_taken", Confirm_IsOpen() && Confirm_Menu().cursor == 1 && CardsUi_Kind() == "echo", "open=" + string(Confirm_IsOpen()));
                Scenario_Check("confirm_the_echo_is_not_taken_before_yes", array_length(_ch.skills) == 0 && array_length(_ch.echo_offer) == 1 && Scenario_ItemCount(_ch, 11) == _eo.items_before, "skills=" + json_stringify(_ch.skills));   // D144 (was: item count unchanged and the pool still 2)
            }
            if (array_length(_eo.q) == 0 && !CardsUi_IsOpen() && _s.t > 20) {
                var _pf3 = Profile_Get();
                Scenario_Check("g5_the_echo_skill_is_in_the_deck", array_length(_ch.skills) == 1 && _ch.skills[0] == SKILL_HILT_BASH, "skills=" + json_stringify(_ch.skills));   // D144 (was g5_the_echo_item_is_in_the_inventory)
                Scenario_Check("g5_no_item_came_with_it", Scenario_ItemCount(_ch, 11) == _eo.items_before, "before=" + string(_eo.items_before) + " now=" + string(Scenario_ItemCount(_ch, 11)));   // D144 (was g5_the_knight_skill_was_not_given: the deck had no skill)
                Scenario_Check("g5_the_pool_is_empty_after_the_pick", array_length(_pf3.echo_pool) == 0);
                Scenario_Check("g5_the_pick_is_remembered_on_the_run", _gs.run.echo_used.kind == "skill" && _gs.run.echo_used.id == SKILL_HILT_BASH, json_stringify(_gs.run.echo_used));   // D144 (was: item 11)
                Scenario_Check("g5_nothing_is_owed_after_the_pick", Cards_NextOwed(_ch) == "" && array_length(_ch.echo_offer) == 0);
                Scenario_Next(_s, 346);
            }
            if (_s.t > 600) { Scenario_Check("g5_the_echo_pick_answers", false, "open=" + string(CardsUi_IsOpen()) + " q=" + string(array_length(_eo.q))); Scenario_NoticeEnd(); }
            break;
        case 346:   // a class with no discovered skill (and an old item pool in the profile, which is ignored): the class is picked, no pick opens and nothing is said
            if (_s.t == 1) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _pf4 = Profile_Get();
                _pf4.echo_pool = [{ kind: "item", id: 11 }];   // D144: an older profile's item pool; it must never be offered (the only skill known is a Knight skill, the class is Mage)
                Profile_Flush();
                ClassSelect_ApplyClass(CLASS_MAGE);
                _eo.ever_echo = false;
            }
            if (_s.t > 1 && (_gs.ui.mode == UI_DIALOGUE || array_length(_gs.ui.lines) > 0) && (_s.f - _s.last_tap) >= 12) Scenario_Tap("confirm");   // the class chest's own line
            if (CardsUi_IsOpen()) _eo.ever_echo = true;
            if (_s.t > 90 && !CardsUi_IsOpen() && _gs.ui.mode == UI_NONE) {
                Scenario_Check("g5_a_pool_nothing_fits_opens_no_pick", !_eo.ever_echo && Cards_NextOwed(_gs.player_ch) == "" && array_length(_gs.player_ch.echo_offer) == 0);
                Scenario_Check("g5_and_the_pool_is_cleared_quietly", array_length(Profile_Get().echo_pool) == 0);
                Scenario_Next(_s, 410);   // g7 (D134, D135, 410..415) goes on, then G6 (380..399), then G9 (440..459); the last step ends the chain (Scenario_NoticeEnd removes the files and the profile)
            }
            if (_s.t > 600) { Scenario_Check("g5_the_class_pick_without_a_fitting_echo_ends", false, "kind=" + CardsUi_Kind() + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- R1b pictures 200..203: the battle command menu with the RUN chance (a Slime, after a failed try, a boss) and the pause menu opened in a battle,
// at windowed scale 3 and 5. ----
function Scenario_FairUiScenes() {
    return ["run", "run_after_fail", "run_boss", "pause"];
}

function Scenario_StepShotsFairUi(_s) {
    var _scenes = Scenario_FairUiScenes();
    var _scales = [3, 5];
    switch (_s.step) {
        case 200:   // scene _s.di at scale index _s.si: enter the battle
            if (_s.t == 1) {
                Scenario_NewKnight();
                Scenario_SetWindowScale(_scales[_s.si]);
                Scenario_GotoBattle("shots_fairui_" + string(_s.di) + "_" + string(_s.si), (_s.di == 2) ? ENEMY_MINI_BOSS : ENEMY_SLIME);
            }
            if (_s.t >= 25) Scenario_Next(_s, 201);
            break;
        case 201:   // the player's menu, with the cursor on RUN
            var _inb = (room == rm_battle && instance_exists(obj_battle_controller));
            Scenario_Check("shots_fairui_in_battle_" + _scenes[_s.di], _inb, "room=" + room_get_name(room));
            if (!_inb) { Scenario_Finish(); return; }
            var _bc = instance_find(obj_battle_controller, 0);
            _bc.wait_timer = COMBAT_HOLD_FOREVER_MS;
            _bc.pops = [];
            _bc.combat_log = [];
            if (_s.di == 1) _bc.run_fails = 1;
            _bc.tl_who = TL_PLAYER;
            _bc.turn = TURN_PLAYER;
            _bc.enemy_action_pending = false;
            _bc.battle_state = BSTATE_MENU;
            Scenario_Next(_s, 202);
            break;
        case 202:
            if (_s.t == 6) {
                var _bc2 = instance_find(obj_battle_controller, 0);
                if (_s.di == 3) {
                    Focus_Step(false);   // the real call the UI controller makes when the window loses focus
                    Scenario_Check("shots_fairui_the_menu_opens_in_the_battle", Menu_IsOpen() && room == rm_battle);
                } else {
                    _bc2.ui_cmd.cursor = 4;
                    _bc2.menu_index = 4;
                    var _mt = Ui_Metrics();
                    var _r = _bc2.ui_cmd.items[4];
                    var _tag = _scenes[_s.di] + "_" + string(_scales[_s.si]);
                    Scenario_Check("shots_fairui_run_value_" + _tag, _r.value == ((_s.di == 2) ? Loc_T("battle.action.run_no", "No") : string(Battle_RunPct(_bc2.p, _bc2.e, _bc2.run_fails)) + "%"), "value=" + _r.value);
                    Scenario_Check("shots_fairui_label_and_value_fit_" + _tag, UI_TextWidth(_r.label) + UI_TextWidth(_r.value) + 16 * _mt.p <= _bc2.ui_cmd.rect.w || _bc2.ui_cmd.rect.w == 0, "w=" + string(_bc2.ui_cmd.rect.w));
                }
            }
            if (_s.t >= 30) {
                var _bc3 = instance_find(obj_battle_controller, 0);
                if (_s.di != 3) Scenario_BattleUiOverlaps(_bc3, "fairui_" + _scenes[_s.di] + "_" + string(_scales[_s.si]));
                _s.shot = "shot_fairui_" + _scenes[_s.di] + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 203);
            }
            break;
        case 203:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                if (Menu_IsOpen()) { Focus_Step(true); Menu_Close(true); }
                Scenario_ClearUi();
                _s.si++;
                if (_s.si >= array_length(_scales)) { _s.si = 0; _s.di++; }
                if (_s.di >= array_length(_scenes)) {
                    _s.si = 0;
                    _s.di = 0;
                    Scenario_Next(_s, 230);   // F3a pictures (230..232), then the D91 / DISP-10 / D48 pictures and the skill animations
                } else {
                    Scenario_Next(_s, 200);
                }
            }
            break;
    }
}

// ---- F3a pictures 230..232: the notice pop-up over the title: the old-save text at windowed scale 3 (480 x 432) and 5 (800 x 720), the short
// damaged-run text at scale 3, and the old-save text in Korean at scale 3. The real draw of the real pop-up on the real title. ----
function Scenario_NoticeScenes() {
    return ["legacy", "corrupt", "korean"];
}

function Scenario_NoticeScales(_di) {
    return (_di == 0) ? [3, 5] : [3];
}

function Scenario_NoticeText(_di) {
    return (_di == 1) ? Run_ContinueFailText("corrupt") : Save_LegacyNotice();
}

function Scenario_StepShotsNotice(_s) {
    var _scenes = Scenario_NoticeScenes();
    var _scales = Scenario_NoticeScales(_s.di);
    var _c = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _tag = _scenes[_s.di] + "_" + string(_scales[_s.si]);
    switch (_s.step) {
        case 230:   // the title at this scale
            if (_s.t == 1) {
                Scenario_ClearUi();
                Notice_Interrupt();
                Loc_SetLanguage((_s.di == 2) ? "ko" : "en");
                Scenario_SetWindowScale(_scales[_s.si]);
                GameState_Get().in_main_menu = true;
                if (room != rm_start) room_goto(rm_start);
            }
            if (room == rm_start && _s.t >= 40) {
                with (obj_start_controller) { if (state == "boot_logo") state = "main"; }
                if (_c != noone && _c.state == "main" && !Transition_IsActive()) Scenario_Next(_s, 231);
            }
            if (_s.t > 400) { Scenario_Check("shots_notice_reaches_the_title_" + _tag, false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 231:   // open it; let it fade in; check the box; take the picture
            if (_s.t == 1) {
                Notice_Interrupt();
                Notice_Open(Scenario_NoticeText(_s.di));
            }
            if (_s.t >= 30) {
                var _mt = Ui_Metrics();
                var _b = Notice_Box(Notice_Text());
                Scenario_Check("shots_notice_is_open_" + _tag, Notice_IsOpen() && !Notice_Closing() && Notice_Text() == Scenario_NoticeText(_s.di));
                Scenario_Check("shots_notice_is_fully_faded_in_" + _tag, Notice_Alpha(current_time) == 1);
                Scenario_Check("shots_notice_box_is_inside_the_gui_" + _tag, _b.x >= 0 && _b.y >= 0 && _b.x + _b.w <= _mt.gw && _b.y + _b.h <= _mt.gh);
                _s.shot = "shot_notice_" + _scenes[_s.di] + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 232);
            }
            break;
        case 232:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Notice_Interrupt();
                _s.si++;
                if (_s.si >= array_length(_scales)) { _s.si = 0; _s.di++; }
                if (_s.di >= array_length(_scenes)) {
                    Loc_SetLanguage("en");
                    _s.si = 0;
                    _s.di = 0;
                    Scenario_Next(_s, 290);   // G2 title pictures (290..292), then the D91 / DISP-10 / D48 pictures (50) and the skill animations
                } else {
                    Scenario_Next(_s, 230);
                }
            }
            break;
    }
}

// ---- G2 (D128) pictures 290..292: the press-any-key splash, the menu with no run, the menu with the Continue card, and the Korean menu with the card,
// at windowed scale 3 (480 x 432) and 5 (800 x 720). Each is the real draw of the real title; the card and the menu are asserted on their rectangles.
// Files shot_title_<scene>_<w>x<h>.png. The scenes with a card write the real run.sav (the gate's scratch folder only). ----
function Scenario_TitleScenes() {
    return ["splash", "menu", "continue", "korean"];
}

function Scenario_TitleRunFile() {
    Test_RawWrite(RunSave_Path(), json_stringify({ run_version: RUN_SAVE_VERSION, seed: 4242, gold: 137, floor: 4, rng: {}, started_at: 0, statData: { selected_class: CLASS_ARCHER } }));
}

function Scenario_StepShotsTitle(_s) {
    var _scenes = Scenario_TitleScenes();
    var _scales = [3, 5];
    var _sc = _scenes[_s.di];
    var _tag = _sc + "_" + string(_scales[_s.si]);
    var _c = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _gs = GameState_Get();
    switch (_s.step) {
        case 290:   // set the scene: language, window scale, the run file, then a fresh title (the splash scene replays the logo)
            if (_s.t == 1) {
                if ((_sc == "continue" || _sc == "korean") && !Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP title card shot " + _tag + " (LOCALAPPDATA is not the gate scratch folder)");
                    _s.shot = "";
                    Scenario_Next(_s, 292);
                    break;
                }
                Scenario_ClearUi();
                Notice_Interrupt();
                Loc_SetLanguage("en");   // the room restart below reads the saved language again: Korean is set once the title is up (below)
                Scenario_SetWindowScale(_scales[_s.si]);
                RunSave_Delete();
                if (_sc == "continue" || _sc == "korean") Scenario_TitleRunFile();
                _gs.in_main_menu = true;
                _gs.startup_logo_seen = (_sc != "splash");   // the splash is only after the logo of a fresh launch
                room_goto(rm_start);
            }
            if (_s.t >= 40 && room == rm_start && _c != noone && !Transition_IsActive()) {
                if (_sc == "korean") {
                    Loc_SetLanguage("ko");
                    _c.title_refresh = true;   // the labels and the card are made again in Korean
                }
                Scenario_Next(_s, 291);
            }
            if (_s.t > 900) { Scenario_Check("shots_title_reaches_the_title_" + _tag, false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 291:   // wait until the scene is settled, assert the layout, take the picture
            var _ready = false;
            var _mt = Ui_Metrics();
            if (_c != noone) {
                if (_sc == "splash") {   // faded in and well inside a blink-on window (the picture is the frame drawn just before this step)
                    var _el = current_time - _c.title_t0;
                    _ready = (_c.state == "splash" && _el >= 1300 && (_el mod TITLE_BLINK_MS) >= 100 && (_el mod TITLE_BLINK_MS) <= TITLE_BLINK_ON_MS - 100);
                }
                else _ready = (_c.state == "main" && is_struct(_c.title_stk) && Ui_MenuAlpha(_c.title_stk.menus[0], current_time) >= 1);
            }
            if (_ready) {
                if (_sc == "splash") {
                    var _pr = _c.title_prompt_rect;
                    Scenario_Check("shots_title_build_id_clear_of_the_prompt_" + _tag, !Test_RectsOverlap(Build_IdRect(), _pr), json_stringify(Build_IdRect()) + " vs " + json_stringify(_pr));
                    Scenario_Check("shots_title_prompt_is_inside_the_gui_" + _tag, _pr.w > 0 && _pr.x >= 0 && _pr.y >= 0 && _pr.x + _pr.w <= _mt.gw && _pr.y + _pr.h <= _mt.gh, json_stringify(_pr));
                } else {
                    var _mr = _c.title_stk.menus[0].rect;
                    Scenario_Check("shots_title_menu_is_inside_the_gui_" + _tag, _mr.x >= 0 && _mr.y >= 0 && _mr.x + _mr.w <= _mt.gw && _mr.y + _mr.h <= _mt.gh, json_stringify(_mr));
                    var _br = Build_IdRect();   // G10 (D129): the build id stands in the lower right corner; no panel may reach it, at any size or language
                    Scenario_Check("shots_title_build_id_clear_of_the_menu_" + _tag, !Test_RectsOverlap(_br, _mr), json_stringify(_br) + " vs " + json_stringify(_mr));
                    if (_sc == "korean") Scenario_Check("shots_title_labels_are_korean_" + _tag, Loc_GetLanguage() == "ko" && _c.title_stk.menus[0].items[0].label != "New Game" && _c.title_stk.menus[0].items[0].label != "New game", "label=" + string(_c.title_stk.menus[0].items[0].label));
                    if (_sc == "menu") {
                        Scenario_Check("shots_title_no_card_without_a_run_" + _tag, _c.title_card.kind == "none");
                    } else {
                        var _cr = _c.title_card_rect;
                        Scenario_Check("shots_title_card_is_shown_" + _tag, _c.title_card.kind == "run" && _cr.w > 0);
                        Scenario_Check("shots_title_card_is_inside_the_gui_" + _tag, _cr.x >= 0 && _cr.y >= 0 && _cr.x + _cr.w <= _mt.gw && _cr.y + _cr.h <= _mt.gh, json_stringify(_cr));
                        Scenario_Check("shots_title_card_does_not_overlap_the_menu_" + _tag, _cr.x + _cr.w <= _mr.x || _mr.x + _mr.w <= _cr.x || _cr.y + _cr.h <= _mr.y || _mr.y + _mr.h <= _cr.y, json_stringify(_cr) + " vs " + json_stringify(_mr));
                        Scenario_Check("shots_title_build_id_clear_of_the_card_" + _tag, !Test_RectsOverlap(_br, _cr), json_stringify(_br) + " vs " + json_stringify(_cr));
                        Scenario_Check("shots_title_cursor_is_on_continue_" + _tag, _c.title_stk.menus[0].cursor == 1);
                    }
                }
                _s.shot = "shot_title_" + _sc + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 292);
            }
            if (_s.t > 600) { Scenario_Check("shots_title_scene_is_ready_" + _tag, false, "state=" + ((_c != noone) ? string(_c.state) : "none")); Scenario_Finish(); }
            break;
        case 292:
            if (_s.t >= 3) {
                if (_s.shot != "") Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                _s.si++;
                if (_s.si >= array_length(_scales)) { _s.si = 0; _s.di++; }
                if (_s.di >= array_length(_scenes)) {
                    Loc_SetLanguage("en");
                    RunSave_Delete();
                    _gs.startup_logo_seen = true;
                    _s.si = 0;
                    _s.di = 0;
                    Scenario_Next(_s, 50);   // D91 / DISP-10 / D48 pictures, then the skill animations
                } else {
                    Scenario_Next(_s, 290);
                }
            }
            break;
    }
}

// ---- pictures 210..213: every tab, the gear comparison, the Codex pages and the settings tab at windowed scale 3 (480 x 432)
// and 5 (800 x 720); the Korean gear tab once. Each is the real draw of the real menu on a real room; the layout is asserted on the rectangles. ----
function Scenario_TabScenes() {
    return ["status", "skills", "items", "gear", "gear_compare", "codex", "bestiary", "notes", "history", "unlocks", "settings", "korean"];
}

function Scenario_TabScales(_di) {
    return (_di == 11) ? [3] : [3, 5];
}

function Scenario_TabCursorOn(_id) {
    var _m = TabMenu_TopMenu();
    var _i = Scenario_TabRow(_m, _id);
    if (_i >= 0) Ui_MenuFixCursor(_m, _i);
    return _i;
}

function Scenario_StepShotsTabMenu(_s) {
    var _scenes = Scenario_TabScenes();
    var _gs = GameState_Get();
    switch (_s.step) {
        case 210:   // enter a room at this scale (the two floors take turns: entering the room we are in would not spawn the player again)
            if (_s.t == 1) {
                if (!variable_struct_exists(_s, "d1b_n")) { _s.d1b_n = 0; _s.d1b_prof = Scenario_TabProfile(); }
                Scenario_TabFixture();
                Loc_SetLanguage("en");
                Scenario_SetWindowScale(Scenario_TabScales(_s.di)[_s.si]);
                _s.d1b_n++;
                room_goto((_s.d1b_n mod 2 == 0) ? rm_floor2 : rm_floor3);
            }
            if (_s.t >= 30 && Scenario_FloorReady((_s.d1b_n mod 2 == 0) ? rm_floor2 : rm_floor3)) Scenario_Next(_s, 211);
            if (_s.t > 600) { Scenario_Check("shots_tabmenu_enters_the_room", false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 211:   // set the scene up
            with (obj_enemy) instance_destroy();
            Scenario_ClearUi();
            switch (_scenes[_s.di]) {
                case "status": Menu_Open(0); Ui_MenuFixCursor(TabMenu_TopMenu(), 1); break;
                case "skills": Menu_Open(1); Ui_MenuFixCursor(TabMenu_TopMenu(), 2); break;
                case "items": Menu_Open(2); Scenario_TabCursorOn("item_11"); break;
                case "gear": Menu_Open(3); Ui_MenuFixCursor(TabMenu_TopMenu(), 1); break;
                case "gear_compare": Menu_Open(3); Scenario_TabCursorOn("gear_22"); break;
                case "codex": Menu_Open(4); break;
                case "bestiary": Menu_Open(4); TabCodex_Open("bestiary"); break;
                case "notes": Menu_Open(4); TabCodex_Open("notes"); break;
                case "history": Menu_Open(4); TabCodex_Open("history"); break;
                case "unlocks": Menu_Open(4); TabCodex_Open("unlocks"); break;
                case "settings": Menu_Open(5); Ui_MenuFixCursor(TabMenu_TopMenu(), 3); break;
                case "korean":
                    Loc_SetLanguage("ko");
                    Menu_Open(3);
                    Scenario_TabCursorOn("gear_22");
                    break;
            }
            Scenario_Next(_s, 212);
            break;
        case 212:   // let the panels slide in, check the layout, take the picture
            if (_s.t >= 24) {
                var _tag = _scenes[_s.di] + "_" + string(Scenario_TabScales(_s.di)[_s.si]);
                Scenario_Check("shots_tabmenu_open_" + _tag, _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()), "mode=" + string(_gs.ui.mode));
                Scenario_TabLayoutChecks(_tag);
                _s.shot = "shot_tabmenu_" + _scenes[_s.di] + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 213);
            }
            break;
        case 213:
            if (_s.t >= 3) {
                var _scales = Scenario_TabScales(_s.di);
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                if (is_struct(TabMenu_Get())) Menu_Close(true);
                Scenario_ClearUi();
                _s.si++;
                if (_s.si >= array_length(_scales)) { _s.si = 0; _s.di++; }
                if (_s.di >= array_length(_scenes)) {
                    Loc_SetLanguage("en");
                    global.profile = _s.d1b_prof;
                    variable_struct_remove(_gs, "run");   // the pictures after these are of a game with no run going
                    _s.si = 0;
                    _s.di = 0;
                    Scenario_Next(_s, 200);   // R1b pictures (200..203), then the D91 / DISP-10 / D48 pictures and the skill animations
                } else {
                    Scenario_Next(_s, 210);
                }
            }
            break;
    }
}

// ---- bot v=11: a real fight puts the enemy in the Codex; the Tab menu on the way back shows it (D88) ----
function Scenario_StepBotD1b(_s) {
    var _bc = (room == rm_battle && instance_exists(obj_battle_controller)) ? instance_find(obj_battle_controller, 0) : noone;
    var _gs = GameState_Get();
    var _m = TabMenu_TopMenu();
    switch (_s.step) {
        case 0:   // a levelled Knight and an empty Codex, then a Slime
            if (_s.t == 10) {
                Profile_ResetForTest();
                global.ui_mem = Ui_MemNew();
                var _g = Scenario_NewKnight();
                variable_struct_remove(_g, "run");   // no run going: no card or stat screen opens over the menu after the level-ups
                GameState_SetPlayer(Player_AddExp(_g.player_ch, 200));
                Scenario_Check("bot_d1b_the_codex_starts_empty", Codex_BestiaryCount(Profile_Get()) == 0);
                _s.vstart = _s.f;
                Scenario_GotoBattle("bot_d1b", ENEMY_SLIME);
                Scenario_Next(_s, 1);
            }
            break;
        case 1:
            if (_bc == noone) {
                if (_s.t > 60) { Scenario_Check("bot_d1b_in_battle", false, "room=" + room_get_name(room)); Scenario_Finish(); }
                break;
            }
            if (_s.t == 5) Scenario_Check("bot_d1b_the_fight_started_the_entry", Codex_BestiaryCount(Profile_Get()) == 1);
            if (_bc.battle_over) { Scenario_Next(_s, 2); break; }
            if (_s.f - _s.vstart > 4000) { Scenario_Check("bot_d1b_fight_ends", false, "state=" + string(_bc.battle_state)); Scenario_Next(_s, 2); break; }
            Scenario_BotPlainAttack(_s, _bc);
            break;
        case 2:   // back in the floor (a reaction dialogue may be up: close it), open the menu with the real key
            if (_s.t == 200) Scenario_Check("bot_d1b_back_in_the_floor", room == rm_floor1, "room=" + room_get_name(room));
            if (_s.t >= 200 && !variable_struct_exists(_s, "d1b_t0")) {
                if (_gs.ui.mode == UI_DIALOGUE) Dialogue_CloseNow();
                else if (_gs.ui.mode == UI_NONE && Scenario_FloorReady(rm_floor1) && Player_IsSettled(_gs.player_inst)) {
                    Scenario_Tap("menu");
                    _s.d1b_t0 = _s.t;
                }
            }
            if (!variable_struct_exists(_s, "d1b_t0")) break;
            var _k0 = _s.d1b_t0;
            if (_s.t == _k0 + 12) {
                Scenario_Check("bot_d1b_the_menu_opens_on_status", _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()) && TabMenu_Get().tab == 0, "mode=" + string(_gs.ui.mode));
                Scenario_Check("bot_d1b_status_shows_the_stats_after_the_fight", is_struct(_m) && _m.items[0].value == string(Stat_Get(_gs.player_ch, STAT_ATK)));
                Scenario_Tap("tab_next");
            }
            if (_s.t == _k0 + 19) Scenario_Tap("tab_next");
            if (_s.t == _k0 + 26) Scenario_Tap("tab_next");
            if (_s.t == _k0 + 33) Scenario_Tap("tab_next");
            if (_s.t == _k0 + 40) {
                Scenario_Check("bot_d1b_four_E_reach_the_codex", is_struct(TabMenu_Get()) && TabMenu_Get().tab == 4);
                Scenario_Check("bot_d1b_the_codex_counts_the_slime", is_struct(_m) && _m.items[0].value == "1/10", is_struct(_m) ? _m.items[0].value : "no menu");
                Scenario_Tap("confirm");
            }
            if (_s.t == _k0 + 50) {
                Scenario_Check("bot_d1b_the_bestiary_names_the_slime", is_struct(_m) && _m.id == "codex_bestiary" && _m.items[0].label == EnemyDB_Get(ENEMY_SLIME).name, is_struct(_m) ? _m.id : "none");
                Scenario_Check("bot_d1b_one_meeting_counted", is_struct(_m) && Test_RowValue(_m.items[0].lines, Loc_T("tab.lbl.met", "Met")) == "1");
                Scenario_Tap("menu");
            }
            if (_s.t == _k0 + 75) {
                Scenario_Check("bot_d1b_the_menu_key_closes_it_from_any_depth", _gs.ui.mode == UI_NONE && !is_struct(TabMenu_Get()), "mode=" + string(_gs.ui.mode));
                _s.v = 5;   // on to movement and AI
                Scenario_Next(_s, 0);
            }
            break;
    }
}

// ============================================================================
// g3 (D138, D139): battle feel pictures, 480 x 432 (display scale 3). Steps 300-302: six scenes, run in turn (arm, wait for the moment, shoot).
// The moments are parked by a very long hit freeze (hitstop_ms), which stops the feel clock, so the picture is the same every run:
//   0 death_burst     the dire wolf 300 ms into its death pop (180 ms into the burst)
//   1 sparks_perfect  a Perfect hit, 70 ms after the freeze: sparks at the impact, the view pushed in 3 px, the enemy squashed
//   2 zoom_break      a BREAK, at the peak of the ~5% zoom punch (4 px a side)
//   3 lowhp_edge      20% HP, the edge pulse at its faint peak
//   4 hp_lag          the HP bar just dropped from full to 45%: the real bar short, the lighter trail still draining (after the HUD's own hurt flash)
//   5 hurt_edge       a big hit (55% of max HP): the dark edge flash and the HP panel jolted up
// ============================================================================
function Scenario_StepShotsFeel(_s) {
    if (!variable_struct_exists(_s, "fe")) _s.fe = 0;
    var _names = ["death_burst", "sparks_perfect", "zoom_break", "lowhp_edge", "hp_lag", "hurt_edge"];
    if (_s.fe >= array_length(_names)) {
        Scenario_Next(_s, 430);   // g7 (D134, D135): the speed-up and damage preview pictures (430..433), then G6 (400..409), then G9 (460..466) end the run
        return;
    }
    var _tag = _names[_s.fe];
    var _bc = instance_exists(obj_battle_controller) ? instance_find(obj_battle_controller, 0) : noone;
    switch (_s.step) {
        case 300:   // enter the battle and arm the scene
            if (_s.t == 1) {
                Scenario_NewKnight();
                Scenario_SetWindowScale(3);
                Scenario_GotoBattle("shots_feel_" + _tag, (_s.fe == 0) ? ENEMY_DIREWOLF : ENEMY_SLIME);
            }
            if (_s.t >= 30) {
                var _inb = (room == rm_battle && _bc != noone);
                Scenario_Check("shots_feel_in_battle_" + _tag, _inb, "room=" + room_get_name(room));
                if (!_inb) { Scenario_Finish(); return; }
                _bc.wait_timer = COMBAT_HOLD_FOREVER_MS;   // park the intro message: the fight does not move on by itself
                _bc.e.max_hp = 300;
                _bc.e.hp = 300;
                _bc.enemy_hp_shown = 300;
                switch (_s.fe) {
                    case 0:
                        _bc.e.hp = 0;
                        Scenario_Check("shots_feel_death_pop_starts", Battle_DeathPopBegin(_bc, _bc.e, "The enemy has been slain.") && _bc.death_pop.active);
                        break;
                    case 1:
                        Battle_PlayerAttackResolveTimed(_bc, Qte_Result(QTE_PERFECT));
                        _bc.wait_timer = COMBAT_HOLD_FOREVER_MS;
                        Scenario_Check("shots_feel_perfect_hit_freezes_80_ms", _bc.hitstop_ms > 0 && _bc.hitstop_ms <= Feel_FreezeMs(QTE_PERFECT, true, false), "hitstop=" + string(_bc.hitstop_ms));
                        break;
                    case 2:
                        _bc.e.stagger = max(0, _bc.e.stagger_max - 1);   // one more point of stagger is a BREAK
                        Battle_PlayerAttackResolveTimed(_bc, Qte_Result(QTE_GOOD));
                        _bc.wait_timer = COMBAT_HOLD_FOREVER_MS;
                        Scenario_Check("shots_feel_break_freezes_120_ms_and_zooms", _bc.e.broken && _bc.feel_break && _bc.hitstop_ms > 0, "broken=" + string(_bc.e.broken) + " hitstop=" + string(_bc.hitstop_ms));
                        break;
                    case 3:
                        _bc.p.hp = max(1, floor(_bc.p.max_hp * 0.2));
                        _bc.hud.hp_shown = _bc.p.hp;
                        _bc.hud.lag_hp = _bc.p.hp;
                        _bc.hud.lag_from = _bc.p.hp;
                        break;
                    case 4:
                        _bc.hud.hp_shown = _bc.p.max_hp;
                        _bc.hud.lag_hp = _bc.p.max_hp;
                        _bc.hud.lag_from = _bc.p.max_hp;
                        _bc.p.hp = max(1, floor(_bc.p.max_hp * 0.45));
                        _s.fe_t0 = -1;
                        break;
                    case 5:
                        _bc.hud.hp_shown = _bc.p.max_hp;
                        _bc.hud.lag_hp = _bc.p.max_hp;
                        _bc.hud.lag_from = _bc.p.max_hp;
                        _bc.p.hp = max(1, floor(_bc.p.max_hp * 0.45));
                        Battle_PlayerHurtFeel(_bc, _bc.p.max_hp - _bc.p.hp, _bc.p.max_hp, false);   // 55% of max HP in one hit: a big hit
                        Scenario_Check("shots_feel_big_hit_flashes_the_edge", _bc.feel_edge_start == _bc.feel_ms && _bc.feel_pjolt_big);
                        break;
                }
                Scenario_Next(_s, 301);
            }
            break;
        case 301:   // wait for the moment, park it
            if (_bc == noone) { Scenario_Check("shots_feel_battle_still_there_" + _tag, false); Scenario_Finish(); return; }
            var _ready = false;
            switch (_s.fe) {
                case 0: _ready = is_struct(_bc.death_pop) && _bc.death_pop.t_ms >= 300 && _bc.death_pop.t_ms < 500; break;
                case 1: _ready = is_struct(_bc.sparks) && (_bc.feel_ms - _bc.sparks.start) >= 70; break;
                case 2: _ready = (_bc.feel_inset >= 4); break;
                case 3: _ready = (_bc.lowhp_ms >= 1190); break;
                case 4:
                    if (_s.fe_t0 < 0 && _bc.hud.lag_hp == _bc.p.hp && _bc.hud.hp_shown > _bc.p.hp) _s.fe_t0 = current_time;
                    _ready = (_s.fe_t0 >= 0 && (current_time - _s.fe_t0) >= 160);   // after the HUD's own hurt flash (133 ms), which lights the whole bar
                    break;
                case 5: _ready = (_bc.feel_ms - _bc.feel_edge_start) >= 40; break;
            }
            if (_ready) {
                if (_s.fe == 1 || _s.fe == 2 || _s.fe == 3 || _s.fe == 5) {   // freeze the feel clock so the picture is steady
                    _bc.hitstop_ms = 999999;
                    _bc.feel_contact = false;
                }
                show_debug_message("[BOT] shots_feel " + _tag + " t=" + string(_s.t) + " feel_ms=" + string(_bc.feel_ms) + " inset=" + string(_bc.feel_inset) + " lowhp_ms=" + string(_bc.lowhp_ms)
                    + " death_t=" + string(is_struct(_bc.death_pop) ? _bc.death_pop.t_ms : -1) + " crit=" + string(_bc.last_crit) + " hp_shown=" + string(_bc.hud.hp_shown) + " hp=" + string(_bc.p.hp));
                Scenario_Next(_s, 302);
            } else if (_s.t > 600) {
                Scenario_Check("shots_feel_moment_reached_" + _tag, false, "feel_ms=" + string(_bc.feel_ms) + " inset=" + string(_bc.feel_inset) + " lowhp_ms=" + string(_bc.lowhp_ms));
                Scenario_Finish();
            }
            break;
        case 302:   // two frames to draw it, then the picture
            if (_s.t == 2) {
                _s.shot = "shot_feel_" + _tag + ".png";
                Scenario_ShotLayout(_s.shot);
            }
            if (_s.t >= 5) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Display_ClearZoom();   // the parked push-in must not carry into the next scene
                _s.fe++;
                Scenario_Next(_s, 300);
            }
            break;
    }
}

// ============================================================================
// g7 (D134 battle speed-up, D135 damage preview). Smoke steps 410-419, shots 430-433.
// Smoke (a Knight with the Wooden Sword against a Slime that uses its plain attack):
//   410  a fresh battle (mode 0: no key; mode 1: the second battle, run held through real input)
//   411  the cursor on ATTACK shows the plate (Damage 4 / Perfect 5), on SKILL it is gone, the skill list's Hilt Bash shows 7 / 9, Muscle Up no number
//   413  the enemy's turn timed from its first frame to the player's menu: mode 0 is the baseline, mode 1 (run held) must take about half
//   414  the sliding bar with run held: its clock keeps real time (qte_ms moves as fast as current_time) and the time scale is 1
//   415  the preview equals the damage the real resolve paths deal (attack and Hilt Bash, OK and Perfect); then the run ends
// =====================================================================
function Scenario_StepSmokeSpeed(_s) {
    var _bc = instance_exists(obj_battle_controller) ? instance_find(obj_battle_controller, 0) : noone;
    if (!variable_struct_exists(_s, "g7")) _s.g7 = { mode: 0, base_f: -1, base_ms: -1, phase: 0, f0: 0, ct0: 0, scale_max: 1, qphase: 0, q0: 0, c0: 0 };
    var _g = _s.g7;
    var _ready = (_s.f - _s.last_tap) >= 8;
    switch (_s.step) {
        case 410:   // a fresh battle against a Slime; wait for the player's menu
            if (_s.t == 1) {
                Scenario_Release();
                Transition_Finish();
                Scenario_ClearUi();
                Scenario_NewKnight();
                Scenario_GotoBattle("smoke_g7_" + string(_g.mode), ENEMY_SLIME);
            }
            if (_s.t > 20 && room == rm_battle && _bc != noone && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && is_struct(_bc.ui_cmd)) {
                _bc.e.skills = [];   // the plain attack: no defence bar in the timed turn
                _bc.p.skills = [SKILL_HILT_BASH, SKILL_MUSCLE_UP];
                _bc.p.equip.weapon = 1;
                _bc.player_weapon = ItemDB_Get(1);
                _bc.p.hp = _bc.p.max_hp;
                _bc.p.mp = _bc.p.max_mp;
                _g.phase = 0;
                _g.qphase = 0;
                Scenario_Next(_s, (_g.mode == 0) ? 411 : 413);
            }
            if (_s.t > 900) { Scenario_Check("g7_the_battle_reaches_the_player_menu", false, "room=" + room_get_name(room) + " state=" + string((_bc != noone) ? _bc.battle_state : -1)); Scenario_NoticeEnd(); }
            break;
        case 411:   // the preview plate beside the command menu and the skill list's lines, through real keys
            switch (_s.t) {
                case 14:
                    var _pv = Battle_AttackPreview(_bc.p, _bc.e, Battle_PlayerWeapon(_bc));
                    Scenario_Check("g7_the_cursor_starts_on_attack", _bc.menu_index == 0, "i=" + string(_bc.menu_index));
                    Scenario_Check("g7_the_preview_plate_is_drawn_on_attack", is_struct(_bc.hud.rects.preview) && _bc.hud.rects.preview.w > 0);
                    Scenario_Check("g7_the_plate_numbers_are_4_and_5_for_the_wooden_sword_vs_a_slime", _pv.ok == 4 && _pv.perfect == 5, "ok=" + string(_pv.ok) + " perfect=" + string(_pv.perfect));
                    var _want = Battle_PreviewPlateLines(_pv);
                    // R-085: preview_text is what was DRAWN (the wrapped, fitted lines), so a cut ("Dam..") or a stacked plate differs from the full text of the fit helper
                    Scenario_Check("g7_the_plate_says_damage_and_perfect_from_the_preview", array_length(_bc.hud.preview_text) == 2 && _bc.hud.preview_text[0] == _want[0] && _bc.hud.preview_text[1] == _want[1] && _bc.hud[$ "preview_stacked"] == false, json_stringify(_bc.hud.preview_text));
                    if (is_struct(_bc.hud.rects.preview)) {
                        var _pr = _bc.hud.rects.preview;
                        var _hr = _bc.hud.rects;
                        Scenario_Check("g7_the_plate_clears_the_command_menu", !Test_RectsOverlap(_pr, _hr.cmd));
                        Scenario_Check("g7_the_plate_clears_the_player_panel", !Test_RectsOverlap(_pr, _hr.zones.player));
                        Scenario_Check("g7_the_plate_clears_the_turn_strip", !Test_RectsOverlap(_pr, _hr.timeline));
                        Scenario_Check("g7_the_plate_is_on_screen", _pr.x >= 0 && _pr.y >= 0 && _pr.x + _pr.w <= Display_GuiW() && _pr.y + _pr.h <= Display_GuiH());
                    }
                    Scenario_Check("g7_no_x2_marker_while_run_is_not_held", !is_struct(_bc.hud.rects.speed));
                    Scenario_Tap("menu_down");
                    break;
                case 24:
                    Scenario_Check("g7_the_plate_is_gone_with_the_cursor_on_skill", _bc.menu_index == 1 && !is_struct(_bc.hud.rects.preview), "i=" + string(_bc.menu_index));
                    Scenario_Tap("confirm");
                    break;
                case 34:
                    Scenario_Check("g7_the_skill_list_is_open", _bc.battle_state == BSTATE_SKILL_MENU && array_length(_bc.ui_skill.items) == 2, "state=" + string(_bc.battle_state));
                    Scenario_Check("g7_hilt_bash_shows_damage_7", Test_RowValue(_bc.ui_skill.items[0].lines, Loc_T("battle.det.damage", "Damage")) == "7", Test_RowValue(_bc.ui_skill.items[0].lines, Loc_T("battle.det.damage", "Damage")));
                    Scenario_Check("g7_hilt_bash_shows_perfect_9", Test_RowValue(_bc.ui_skill.items[0].lines, Loc_T("battle.det.perfect", "Perfect")) == "9");
                    Scenario_Check("g7_muscle_up_shows_no_damage_number", Test_RowValue(_bc.ui_skill.items[1].lines, Loc_T("battle.det.damage", "Damage")) == "");
                    Scenario_Tap("cancel");
                    break;
                case 44:
                    Scenario_Check("g7_back_to_the_command_menu", _bc.battle_state == BSTATE_MENU && _bc.menu_index == 1);
                    Scenario_Tap("menu_up");
                    break;
                case 54:
                    Scenario_Check("g7_the_plate_is_back_on_attack", _bc.menu_index == 0 && is_struct(_bc.hud.rects.preview));
                    Scenario_Next(_s, 413);
                    break;
            }
            break;
        case 413:   // the enemy's turn timed, from its first frame to the player's menu (mode 0: no key; mode 1: run held)
            if (_s.t == 1 && _g.mode == 1) Scenario_Hold("run", 900);
            if (_bc == noone) break;
            switch (_g.phase) {
                case 0:   // cast Guard (the fourth row) until it is the enemy's turn
                    if (_bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && _ready) {
                        if (_bc.menu_index != 3) Scenario_Tap((_bc.menu_index < 3) ? "menu_down" : "menu_up");
                        else { Scenario_Tap("confirm"); _g.phase = 1; }
                    }
                    break;
                case 1:
                    if (_bc.turn == TURN_ENEMY && _bc.battle_state == BSTATE_ENEMY_ACT) {
                        _g.f0 = _s.f;
                        _g.ct0 = current_time;
                        _g.scale_max = 1;
                        _g.phase = 2;
                    } else if (_bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && _ready) {
                        _g.phase = 0;   // the player acts again before the enemy: Guard once more
                    }
                    break;
                case 2:
                    _g.scale_max = max(_g.scale_max, Battle_TimeScale(_bc));
                    if (_bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER) {
                        var _fr = _s.f - _g.f0;
                        var _ms = current_time - _g.ct0;
                        var _tag = (_g.mode == 0) ? "baseline" : "held";
                        show_debug_message("[BOT] g7 enemy turn " + _tag + " frames=" + string(_fr) + " ms=" + string(_ms) + " scale_max=" + string(_g.scale_max) + " enemy_skill=" + string(_bc.enemy_last_skill_id));
                        if (_g.mode == 0) {
                            _g.base_f = _fr;
                            _g.base_ms = _ms;
                            Scenario_Check("g7_the_baseline_enemy_turn_is_a_normal_one", _fr >= 12 && _bc.enemy_last_skill_id == -1 && _g.scale_max == 1, "frames=" + string(_fr) + " scale=" + string(_g.scale_max));
                            _g.mode = 1;
                            Scenario_Next(_s, 410);
                        } else {
                            Scenario_Check("g7_run_held_through_real_input_gives_a_time_scale_of_2", _g.scale_max == 2, "scale=" + string(_g.scale_max));
                            // Hunt 5a: the ratio is measured in game FRAMES, not wall-clock ms. A frame the PC stalls on still adds one frame and at most
                            // PRESENTATION_MAX_STEP_US of game time, but its whole length to the ms count (368 ms held against a 333 ms baseline when gates ran at once).
                            // The ms are only logged above.
                            Scenario_Check("g7_the_enemy_turn_with_run_held_takes_about_half_the_frames", _g.base_f > 0 && _fr <= _g.base_f * 0.7 && _fr >= _g.base_f * 0.3, "held=" + string(_fr) + " baseline=" + string(_g.base_f) + " (ms held=" + string(_ms) + " baseline=" + string(_g.base_ms) + ")");
                            Scenario_Next(_s, 414);
                        }
                    }
                    if (_s.t > 900) { Scenario_Check("g7_the_enemy_turn_ends", false, "phase=" + string(_g.phase) + " state=" + string(_bc.battle_state) + " turn=" + string(_bc.turn)); Scenario_NoticeEnd(); }
                    break;
            }
            break;
        case 414:   // the sliding bar with run held: real time
            if (_bc == noone) break;
            if (_g.qphase == 0) {
                if (_s.t == 1) Scenario_Hold("run", 400);
                if (_bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && _ready) {
                    if (_bc.menu_index != 0) Scenario_Tap("menu_up");
                    else { Scenario_Tap("confirm"); _g.qphase = 1; }
                }
            } else if (_g.qphase == 1) {
                if (_bc.battle_state == BSTATE_ATTACK_TIMING && _bc.qte_active && _bc.qte_ms >= -150) {
                    Scenario_Hold("run", 200);
                    _g.q0 = _bc.qte_ms;
                    _g.c0 = current_time;
                    _g.f0 = _s.f;
                    _g.qphase = 2;
                }
            } else if (_s.f - _g.f0 >= 30) {
                var _dq = _bc.qte_ms - _g.q0;
                var _dc = current_time - _g.c0;
                show_debug_message("[BOT] g7 bar with run held: dq=" + string(_dq) + " dc=" + string(_dc) + " scale=" + string(Battle_TimeScale(_bc)));
                Scenario_Check("g7_run_is_held_during_the_bar", Input_Held("run"));
                Scenario_Check("g7_the_time_scale_is_1_during_the_bar", Battle_TimeScale(_bc) == 1 && _bc.battle_state == BSTATE_ATTACK_TIMING);
                Scenario_Check("g7_the_bar_clock_runs_at_real_speed_with_run_held", _dc > 200 && _dq >= _dc * 0.8 && _dq <= _dc * 1.25, "bar=" + string(_dq) + " real=" + string(_dc));
                Scenario_Release();
                Scenario_Next(_s, 415);
            }
            if (_s.t > 900) { Scenario_Check("g7_the_bar_starts", false, "state=" + string(_bc.battle_state)); Scenario_NoticeEnd(); }
            break;
        case 415:   // the preview equals the damage the real resolve paths deal; every call in this one frame, so nothing else moves in between
            if (_bc == noone) { Scenario_Check("g7_the_battle_is_still_there", false); Scenario_NoticeEnd(); break; }
            var _p = _bc.p;
            var _pvA = Battle_AttackPreview(_p, _bc.e, Battle_PlayerWeapon(_bc));
            var _pvS = Battle_SkillPreview(_p, _bc.e, SKILL_HILT_BASH);
            var _grades = [QTE_OK, QTE_PERFECT];
            for (var _gi = 0; _gi < 2; _gi++) {
                var _want_a = (_gi == 0) ? _pvA.ok : _pvA.perfect;
                var _want_s = (_gi == 0) ? _pvS.ok : _pvS.perfect;
                _bc.e.hp = _bc.e.max_hp;
                _bc.e.stagger = 0;
                _bc.e.broken = false;
                _bc.hitstop_ms = 0;
                Battle_PlayerAttackResolveTimed(_bc, Qte_Result(_grades[_gi]));
                Scenario_Check("g7_the_attack_at_" + _grades[_gi] + "_deals_the_preview", !_bc.last_crit && _bc.last_dmg == _want_a, "dealt=" + string(_bc.last_dmg) + " preview=" + string(_want_a));
                _bc.e.hp = _bc.e.max_hp;
                _bc.e.stagger = 0;
                _bc.e.broken = false;
                _bc.hitstop_ms = 0;
                _p.mp = _p.max_mp;
                Battle_PlayerSkill(_bc, SKILL_HILT_BASH, Qte_Result(_grades[_gi]));
                Scenario_Check("g7_hilt_bash_at_" + _grades[_gi] + "_deals_the_preview", !_bc.last_crit && _bc.last_dmg == _want_s, "dealt=" + string(_bc.last_dmg) + " preview=" + string(_want_s));
            }
            Scenario_Next(_s, 380);   // G6 (D138, 380..399) goes on; its last step ends the smoke chain
            break;
    }
}

// Shots 430-433 (480 x 432): 0 the command menu with the plate (Damage 4 / Perfect 5), 1 the skill list with Hilt Bash's Damage / Perfect lines, 2 the x2 marker (run held).
function Scenario_SpeedShotScenes() {
    return ["attack", "skill", "x2"];
}

function Scenario_StepShotsSpeed(_s) {
    var _names = Scenario_SpeedShotScenes();
    if (!variable_struct_exists(_s, "g7i")) _s.g7i = 0;
    if (_s.g7i >= array_length(_names)) {
        Scenario_Next(_s, 400);   // G6 (D138, map part) pictures (400..409) finish the run
        return;
    }
    var _tag = _names[_s.g7i];
    var _bc = instance_exists(obj_battle_controller) ? instance_find(obj_battle_controller, 0) : noone;
    switch (_s.step) {
        case 430:   // enter the battle at scale 3
            if (_s.t == 1) {
                Scenario_Release();
                Scenario_NewKnight();
                Scenario_SetWindowScale(3);
                Scenario_GotoBattle("shots_g7_" + _tag, ENEMY_SLIME);
            }
            if (_s.t >= 30) Scenario_Next(_s, 431);
            break;
        case 431:   // the player's menu, parked
            var _inb = (room == rm_battle && _bc != noone);
            Scenario_Check("shots_g7_in_battle_" + _tag, _inb, "room=" + room_get_name(room));
            if (!_inb) { Scenario_Finish(); return; }
            _bc.wait_timer = COMBAT_HOLD_FOREVER_MS;
            _bc.e.skills = [];
            _bc.p.skills = [SKILL_HILT_BASH, SKILL_MUSCLE_UP, SKILL_WOUND];
            _bc.p.equip.weapon = 1;
            _bc.player_weapon = ItemDB_Get(1);
            _bc.pops = [];
            _bc.combat_log = [];
            _bc.tl_who = TL_PLAYER;
            _bc.turn = TURN_PLAYER;
            _bc.enemy_action_pending = false;
            _bc.battle_state = BSTATE_MENU;
            Scenario_Next(_s, 432);
            break;
        case 432:
            if (_s.t == 6) {
                if (_s.g7i == 1) Battle_OpenList(_bc, BSTATE_SKILL_MENU);
                if (_s.g7i == 2) Scenario_Hold("run", 60);
            }
            if (_s.t == 30) {
                switch (_s.g7i) {
                    case 0:
                        Scenario_Check("shots_g7_the_plate_is_drawn_on_attack", is_struct(_bc.hud.rects.preview) && array_length(_bc.hud.preview_text) == 2, json_stringify(_bc.hud.preview_text));
                        break;
                    case 1:
                        Scenario_Check("shots_g7_the_skill_list_has_the_damage_lines", _bc.battle_state == BSTATE_SKILL_MENU && Test_RowValue(_bc.ui_skill.items[0].lines, Loc_T("battle.det.damage", "Damage")) != "");
                        Scenario_BattleUiOverlaps(_bc, "g7_skill_list");
                        break;
                    case 2:
                        Scenario_Check("shots_g7_the_x2_marker_is_drawn", is_struct(_bc.hud.rects.speed) && Battle_TimeScale(_bc) == 2);
                        if (is_struct(_bc.hud.rects.speed)) Scenario_Check("shots_g7_the_x2_marker_clears_the_turn_strip", !Test_RectsOverlap(_bc.hud.rects.speed, _bc.hud.rects.timeline));
                        break;
                }
                _s.shot = "shot_g7_" + _tag + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 433);
            }
            break;
        case 433:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_Release();
                _s.g7i++;
                Scenario_Next(_s, 430);
            }
            break;
    }
}

// G6 (D138, map part): chest burst, the item that rises out, the gold counter, the step squash, the level-up sparkle.
// Smoke steps 380-399 (a new run, rm_floor3's lv2 chest opened with the interact key; the gold counter; a step with Screen shake on and off; a level-up),
// pictures 400-409 (the clock of the effects is frozen at an exact age so the pictures do not depend on frame times: MapFx_Now / global.mapfx_clock).
// ============================================================================

// Finds rm_floor3's lv2 chest, a seed whose chest is not empty, and stands the player next to it facing it. _mj gets chest, want, before, placed.
function Scenario_MapJuiceStage(_mj) {
    var _gs = GameState_Get();
    with (obj_enemy) instance_destroy();
    var _chest = instance_exists(obj_chest_lv2) ? instance_find(obj_chest_lv2, 0) : noone;
    _mj.chest = _chest;
    _mj.placed = false;
    _mj.want = [];
    _mj.before = [];
    if (_chest == noone) return false;
    RoomState_EnsurePersistId(_chest);
    var _want = [];
    var _seed = 9100;
    while (_seed < 9300) {
        _want = Shuffle_ChestLoot(_seed, "rm_floor3", _chest.persist_id, _chest.container_level, _chest.loot_table_key, _gs.player_ch);
        if (array_length(_want) > 0) break;
        _seed++;
    }
    _gs.run.seed = _seed;
    _mj.want = _want;
    for (var _w = 0; _w < array_length(_want); _w++) array_push(_mj.before, Scenario_ItemCount(_gs.player_ch, _want[_w].item_id));
    var _pl = instance_find(obj_player, 0);
    var _dirs = [[-1, 0, RIGHT], [1, 0, LEFT], [0, 1, UP], [0, -1, DOWN]];
    for (var _d = 0; _d < 4 && !_mj.placed; _d++) {
        var _tx = _chest.x + _dirs[_d][0] * 16;
        var _ty = _chest.y + _dirs[_d][1] * 16;
        if (!Player_TileBlocked(_pl, _tx, _ty)) {
            _pl.x = _tx; _pl.y = _ty; _pl.moving = false; _pl.move_timer = 0; _pl.face = _dirs[_d][2];
            _mj.placed = true;
        }
    }
    return _mj.placed && array_length(_want) > 0;
}

// A direction the player can walk one tile in: { act, face, dx, dy }, or undefined.
// The mean brightness (0..255) of a box of the world picture, read from the game's own picture (the application surface) at the world position (_wx, _wy), _w x _h pixels.
function Scenario_AppBoxLuminance(_wx, _wy, _w, _h) {
    var _cam = view_camera[0];
    var _x0 = round(_wx) - floor(camera_get_view_x(_cam));
    var _y0 = round(_wy) - floor(camera_get_view_y(_cam));
    var _sw = surface_get_width(application_surface);
    var _sh = surface_get_height(application_surface);
    var _buf = buffer_create(_sw * _sh * 4, buffer_fixed, 1);
    buffer_get_surface(_buf, application_surface, 0);
    var _sum = 0;
    var _n = 0;
    for (var _y = max(0, _y0); _y < min(_sh, _y0 + _h); _y++) {
        for (var _x = max(0, _x0); _x < min(_sw, _x0 + _w); _x++) {
            var _o = (_y * _sw + _x) * 4;
            _sum += (buffer_peek(_buf, _o, buffer_u8) + buffer_peek(_buf, _o + 1, buffer_u8) + buffer_peek(_buf, _o + 2, buffer_u8)) / 3;
            _n++;
        }
    }
    buffer_delete(_buf);
    return (_n > 0) ? _sum / _n : -1;
}

function Scenario_MapJuiceFreeDir(_pl) {
    var _opts = [
        { act: "move_left", face: LEFT, dx: -1, dy: 0 }, { act: "move_right", face: RIGHT, dx: 1, dy: 0 },
        { act: "move_up", face: UP, dx: 0, dy: -1 }, { act: "move_down", face: DOWN, dx: 0, dy: 1 }
    ];
    for (var _i = 0; _i < 4; _i++) {
        if (!Player_TileBlocked(_pl, _pl.x + _opts[_i].dx * 16, _pl.y + _opts[_i].dy * 16)) return _opts[_i];
    }
    return undefined;
}

function Scenario_StepSmokeMapJuice(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "mj")) _s.mj = { };
    var _mj = _s.mj;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    switch (_s.step) {
        case 380:   // a new run, then rm_floor3 (the chest step of the economy smoke does the same)
            if (!variable_struct_exists(_mj, "left_title")) {   // the step before pressed New Game at the title: let it leave the title and land
                if (_s.t < 30 || room == rm_start || Transition_IsActive()) {
                    if (_s.t > 1500) { Scenario_Check("mapjuice_the_title_is_left", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
                    break;
                }
                _mj.left_title = true;
                _s.t = 0;
            }
            if (!variable_struct_exists(_mj, "begun")) {
                if (!Scenario_Hunt2Begin(_s, _mj, 7401)) {
                    if (_s.t > 1500) { Scenario_Check("mapjuice_a_new_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
                    break;
                }
                _mj.begun = true;
                _s.t = 0;
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1)) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                global.tutorial_off = true;
                _gs.persist = {};
                _gs.persist_applied = {};
                MapFx_Clear();
                room_goto(rm_floor3);
                Scenario_Next(_s, 381);
            }
            break;
        case 381:   // stand next to the chest, open it with the interact key: the burst and the rising item start, the reward comes once
            if (_s.t > 40 && Scenario_FloorReady(rm_floor3) && !variable_struct_exists(_mj, "staged")) {
                _mj.staged = true;
                var _staged_ok = Scenario_MapJuiceStage(_mj);
                Scenario_Check("mapjuice_a_chest_with_loot_is_staged", _staged_ok, "chest=" + string(_mj.chest) + " placed=" + string(_mj.placed) + " loot=" + string(array_length(_mj.want)));
                MapFx_Clear();
                _mj.t1 = _s.t;
            }
            if (variable_struct_exists(_mj, "staged") && !variable_struct_exists(_mj, "tapped") && _s.t >= _mj.t1 + 25) {
                _mj.tapped = true;
                Scenario_Tap("interact");
            }
            if (variable_struct_exists(_mj, "tapped") && !variable_struct_exists(_mj, "open_ms") && instance_exists(_mj.chest) && _mj.chest.swapped) {
                _mj.open_ms = current_time;
                Scenario_Check("mapjuice_opening_the_chest_starts_the_burst", MapFx_Count("burst") == 1, "burst=" + string(MapFx_Count("burst")));
                Scenario_Check("mapjuice_opening_the_chest_makes_the_item_rise", MapFx_Count("rise") == 1, "rise=" + string(MapFx_Count("rise")));
            }
            if (variable_struct_exists(_mj, "open_ms") && !variable_struct_exists(_mj, "chime_checked") && current_time - _mj.open_ms > 250) {
                _mj.chime_checked = true;
                var _chimed = false;
                var _fxl = MapFx_List();
                for (var _fi = 0; _fi < array_length(_fxl); _fi++) if (_fxl[_fi].kind == "rise" && _fxl[_fi].chime) _chimed = true;
                Scenario_Check("mapjuice_the_rising_item_has_played_its_chime", _chimed);
                Scenario_Check("mapjuice_the_chime_does_not_become_the_last_sound", global.sfx_last_key != "ui_confirm", "last=" + string(global.sfx_last_key));
            }
            if (variable_struct_exists(_mj, "open_ms")) Scenario_CardsTalk(_s);
            if (variable_struct_exists(_mj, "open_ms") && _gs.ui.mode == UI_NONE && array_length(_gs.ui.lines) == 0 && current_time - _mj.open_ms > 900) {
                Scenario_Check("mapjuice_the_burst_and_the_item_are_over", MapFx_Count("") == 0, "left=" + string(MapFx_Count("")));
                var _same = true;
                for (var _w2 = 0; _w2 < array_length(_mj.want); _w2++) {
                    var _gotn = Scenario_ItemCount(_gs.player_ch, _mj.want[_w2].item_id);
                    var _it = ItemDB_Get(_mj.want[_w2].item_id);
                    var _unique = (_it.type == ITEM_WEAPON || _it.type == ITEM_ARMOR || _it.type == ITEM_ACCESSORY);
                    if (_unique ? (_gotn < 1) : (_gotn != _mj.before[_w2] + _mj.want[_w2].qty)) _same = false;
                }
                Scenario_Check("mapjuice_the_reward_is_granted_exactly_once", _same && _mj.chest.swapped, json_stringify(_mj.want));
                Scenario_Next(_s, 382);
            }
            if (_s.t > 900) { Scenario_Check("mapjuice_the_chest_flow_ends", false, "tapped=" + string(variable_struct_exists(_mj, "tapped")) + " open=" + string(variable_struct_exists(_mj, "open_ms")) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 382:   // gold: the real value changes at once, the HUD number counts up to it in 400 ms
            if (_s.t == 1) {
                Scenario_ClearUi();
                _mj.g0 = _gs.run.gold;
            }
            if (_s.t == 6) {
                var _gd = Feel_GoldState();
                Scenario_Check("mapjuice_the_gold_display_starts_at_the_real_gold", _gd.shown == _mj.g0 && _gd.to == _mj.g0, "shown=" + string(_gd.shown) + " to=" + string(_gd.to) + " gold=" + string(_mj.g0));
                _gs.run.gold += 60;
                _mj.g1 = _gs.run.gold;
                _mj.gold_ms = current_time;
                Scenario_Check("mapjuice_the_real_gold_changes_at_once", Gold_Get() == _mj.g0 + 60);
            }
            if (_s.t == 9) {
                var _gd2 = Feel_GoldState();
                Scenario_Check("mapjuice_the_display_is_counting_up", _gd2.to == _mj.g1 && _gd2.shown >= _mj.g0 && _gd2.shown < _mj.g1, "shown=" + string(_gd2.shown) + " to=" + string(_gd2.to));
            }
            if (_s.t > 9 && current_time - _mj.gold_ms > 500) {
                var _gd3 = Feel_GoldState();
                Scenario_Check("mapjuice_the_display_reaches_the_real_gold", _gd3.shown == _mj.g1 && Gold_Get() == _mj.g1, "shown=" + string(_gd3.shown) + " gold=" + string(Gold_Get()));
                Scenario_Next(_s, 383);
            }
            if (_s.t > 300) { Scenario_Check("mapjuice_the_gold_display_ends", false, "t=" + string(_s.t)); Scenario_NoticeEnd(); }
            break;
        case 383:   // one step with Screen shake on: the squash is drawn and ends within ~120 ms, the position stays on the grid
            if (_s.t == 1) {
                Scenario_ClearUi();
                GameSettings_Ensure().screen_shake = 1;
                _mj.dir = Scenario_MapJuiceFreeDir(_pl);
                Scenario_Check("mapjuice_the_player_has_a_free_tile_to_step_to", is_struct(_mj.dir));
                if (!is_struct(_mj.dir)) { Scenario_NoticeEnd(); break; }
                _pl.face = _mj.dir.face;
                _mj.x0 = _pl.x;
                _mj.y0 = _pl.y;
                _mj.sq_first = -1;
                _mj.sq_last = -1;
                _mj.hidden = true;
                _mj.on_grid = true;
                _mj.hold_f = _s.f;
                Scenario_Hold(_mj.dir.act, 10);
            }
            if (_s.t > 1 && is_struct(_mj.dir)) {
                if (_pl.squash_on) {
                    if (_mj.sq_first < 0) _mj.sq_first = MapFx_Now();
                    _mj.sq_last = MapFx_Now();
                    if (_pl.visible) _mj.hidden = false;   // the squashed sprite is drawn by the world layer script: the plain one must be off
                }
                if (_pl.x != round(_pl.x) || _pl.y != round(_pl.y)) _mj.on_grid = false;
            }
            if (_s.t > 40 && Player_IsSettled(_pl)) {
                Scenario_Check("mapjuice_a_step_with_shake_on_squashes_the_player", _mj.sq_first >= 0);
                Scenario_Check("mapjuice_the_squash_hides_the_plain_sprite_while_it_is_drawn", _mj.hidden);
                Scenario_Check("mapjuice_the_squash_is_over_within_150_ms", _mj.sq_last - _mj.sq_first <= 150, "ms=" + string(_mj.sq_last - _mj.sq_first));
                Scenario_Check("mapjuice_the_player_is_on_the_next_tile", _pl.x == _mj.x0 + _mj.dir.dx * 16 && _pl.y == _mj.y0 + _mj.dir.dy * 16, "at " + string(_pl.x) + "," + string(_pl.y));
                Scenario_Check("mapjuice_the_position_is_whole_pixels_all_through_the_step", _mj.on_grid);
                Scenario_Check("mapjuice_the_plain_sprite_is_back_after_the_squash", _pl.visible && !_pl.squash_on);
                Scenario_Next(_s, 384);
            }
            if (_s.t > 300) { Scenario_Release(); Scenario_Check("mapjuice_the_step_ends", false); Scenario_NoticeEnd(); }
            break;
        case 384:   // the same step back with Screen shake off: no squash at all (D49)
            if (_s.t == 1) {
                GameSettings_Ensure().screen_shake = 0;
                _pl.face = (_mj.dir.face == LEFT) ? RIGHT : ((_mj.dir.face == RIGHT) ? LEFT : ((_mj.dir.face == UP) ? DOWN : UP));
                _mj.back = (_mj.dir.act == "move_left") ? "move_right" : ((_mj.dir.act == "move_right") ? "move_left" : ((_mj.dir.act == "move_up") ? "move_down" : "move_up"));
                _mj.sq_seen_off = false;
                _mj.vis_off = true;
                Scenario_Hold(_mj.back, 10);
            }
            if (_s.t > 1) {
                if (_pl.squash_on) _mj.sq_seen_off = true;
                if (!_pl.visible) _mj.vis_off = false;
            }
            if (_s.t > 40 && Player_IsSettled(_pl)) {
                Scenario_Check("mapjuice_the_step_back_happened", _pl.x == _mj.x0 && _pl.y == _mj.y0, "at " + string(_pl.x) + "," + string(_pl.y));
                Scenario_Check("mapjuice_no_squash_with_shake_off", !_mj.sq_seen_off);
                Scenario_Check("mapjuice_the_plain_sprite_stays_on_with_shake_off", _mj.vis_off);
                GameSettings_Ensure().screen_shake = 1;
                Scenario_Next(_s, 385);
            }
            if (_s.t > 300) { Scenario_Release(); GameSettings_Ensure().screen_shake = 1; Scenario_Check("mapjuice_the_step_back_ends", false); Scenario_NoticeEnd(); }
            break;
        case 385:   // a level-up on the map: the ring of sparkles starts and ends
            if (_s.t == 1) {
                Scenario_ClearUi();
                MapFx_Clear();
                _mj.lv0 = _gs.player_ch.level;
                var _chl = Player_AddExp(_gs.player_ch, max(1, _gs.player_ch.exp_next));
                GameState_SetPlayer(_chl);
                if (instance_exists(obj_player)) obj_player.character = _gs.player_ch;
                Scenario_Check("mapjuice_the_character_gained_a_level", _gs.player_ch.level == _mj.lv0 + 1, "level=" + string(_gs.player_ch.level));
                _mj.spark_ms = -1;
            }
            if (_s.t > 1 && _mj.spark_ms < 0 && MapFx_Count("sparkle") > 0) {
                _mj.spark_ms = current_time;
                Scenario_Check("mapjuice_a_level_up_starts_one_sparkle_ring", MapFx_Count("sparkle") == 1, "n=" + string(MapFx_Count("sparkle")));
            }
            if (_mj.spark_ms >= 0 && current_time - _mj.spark_ms > 700) {
                Scenario_Check("mapjuice_the_sparkle_ring_is_over", MapFx_Count("sparkle") == 0);
                _gs.player_ch.card_picks = 0;
                _gs.player_ch.stat_points = 0;
                CardsUi_Close();
                Scenario_Next(_s, 440);   // G9 (D137, 440..459) goes on; its last step ends the smoke chain
            }
            if (_s.t > 300) { Scenario_Check("mapjuice_a_level_up_starts_the_sparkle", false, "n=" + string(MapFx_Count("sparkle"))); Scenario_NoticeEnd(); }
            break;
    }
}

// ============================================================================
// G9 (D137): run stats (smoke steps 440-459, goes on to H3 at 500; shots 460-469, the end of the pictures chain).
// Smoke: a new run; a dire wolf chases the player into a real battle that is fought with the attack bar and the defence bar (Perfect presses) until it is won;
// back on the floor the run counts 1 fight won, damage dealt and taken and Perfect grades, and its time has advanced; the pause menu stops the time; Abandon run
// through the real pause menu -> the summary shows the same numbers, the history entry carries them, the Codex run history shows them; Continue keeps the time.
// The last smoke step ends the chain (Scenario_NoticeEnd removes the files and the profile the steps made). Writes profile.sav / run.sav: only inside the gate.
// ============================================================================
function Scenario_RsDrive(_s, _bc) {
    var _ready = (_s.f - _s.last_tap) >= 4;
    switch (_bc.battle_state) {
        case BSTATE_MENU:
            if (_bc.turn == TURN_PLAYER && _ready) Scenario_Tap((_bc.menu_index != 0) ? "menu_up" : "confirm");   // ATTACK
            break;
        case BSTATE_ATTACK_TIMING:   // a press on the zone centre (to within a frame and a half): a Perfect
            if (_ready && _bc.qte_active && (Qte_ZoneCentreMs(_bc.qte_params) - _bc.qte_ms) <= Qte_StepMs(delta_time) * 1.5) Scenario_Tap("confirm");
            break;
        case BSTATE_ENEMY_DEFENCE:
            Scenario_BotDefend(_s, _bc);
            break;
    }
}

function Scenario_RsAll0(_st) {
    return _st.qte_total == 0 && _st.qte_perfect == 0 && _st.crits == 0 && _st.dmg_dealt == 0 && _st.dmg_taken == 0 && _st.fights_won == 0;
}

function Scenario_StepSmokeRunStats(_s) {
    var _gs = GameState_Get();
    var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _T = GRID_TILE_SIZE;
    if (!variable_struct_exists(_s, "rs")) _s.rs = { w: noone, seen: false, sum_t: -1, quiet: 0 };
    var _rs = _s.rs;
    var _bc = (room == rm_battle && instance_exists(obj_battle_controller)) ? instance_find(obj_battle_controller, 0) : noone;
    var _fw = Loc_T("stat.fights_won", "Battles Won");
    var _dd = Loc_T("stat.dmg_dealt", "Damage Dealt");
    var _dt = Loc_T("stat.dmg_taken", "Damage Taken");
    var _pf = Loc_T("stat.perfect", "Perfect Rate");
    var _tm = Loc_T("stat.time", "Run Time");
    switch (_s.step) {
        case 440:   // a clean profile and a new run
            if (_s.t == 1) {
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP run stats (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_NoticeEnd();
                    break;
                }
                if (Transition_IsActive()) { _s.t = 0; break; }
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Profile_ResetForTest();
                RunSave_Delete();
                _gs.in_main_menu = false;
                Run_StartNew(false, 9137);
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1)) {
                Scenario_Check("g9_a_new_run_starts_with_no_counts", Scenario_RsAll0(_gs.run.stats), json_stringify(_gs.run.stats));
                _gs.pending_wake_line = false;
                Dialogue_CloseNow();
                Scenario_ClearUi();
                global.tutorial_off = true;
                with (obj_enemy) instance_destroy();
                _rs.w = instance_create_layer(16 * _T, 9 * _T, "Instances", obj_dire_wolf);   // the same stage as bug hunt 2: it sees the player 3 tiles away and runs at him
                Scenario_PlaceEnemy(_rs.w, 16, 9);
                Scenario_FaceEnemy(_rs.w, RIGHT);   // D179: toward the player, who stands to its right
                Scenario_PlacePlayer(19, 9);
                _rs.ms0 = _gs.run.stats.play_ms;
                _s.boost = { hp: 99, mp: 11 };   // the fight is played to its end whatever the wolf does
                Scenario_Next(_s, 441);
            }
            if (_s.t > 900) { Scenario_Check("g9_a_new_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 441:   // the wolf catches the player: a real battle
            if (_bc != noone) {
                Scenario_Check("g9_run_time_advances_while_playing", _gs.run.stats.play_ms > _rs.ms0, "from " + string(_rs.ms0) + " to " + string(_gs.run.stats.play_ms));
                _rs.fight_f0 = _s.f;
                Scenario_Next(_s, 442);
            }
            if (_s.t > 900) { Scenario_Check("g9_the_wolf_catches_the_player", false, "room=" + room_get_name(room) + " wolf=" + string(instance_exists(_rs.w))); Scenario_NoticeEnd(); }
            break;
        case 442:   // the fight, played with Perfect presses on the attack bar and the defence bar; back on the floor the run has counted it
            if (_bc != noone) {
                _rs.seen = true;
                if (!_bc.battle_over) Scenario_RsDrive(_s, _bc);
            }
            if (_rs.seen && _bc == noone && Scenario_FloorReady(rm_floor1) && _s.t > 30) {
                var _st = _gs.run.stats;
                show_debug_message("[BOT] g9_stats_after_the_fight " + json_stringify(_st));
                Scenario_Check("g9_one_fight_won", _st.fights_won == 1, "fights_won=" + string(_st.fights_won));
                Scenario_Check("g9_damage_dealt_is_counted", _st.dmg_dealt > 0, "dmg_dealt=" + string(_st.dmg_dealt));
                Scenario_Check("g9_damage_taken_is_counted", _st.dmg_taken > 0, "dmg_taken=" + string(_st.dmg_taken));
                Scenario_Check("g9_graded_qtes_are_counted_with_some_Perfect", _st.qte_total >= 2 && _st.qte_perfect >= 1 && _st.qte_perfect <= _st.qte_total, "perfect " + string(_st.qte_perfect) + " of " + string(_st.qte_total));
                Scenario_Check("g9_the_Perfect_rate_reads_as_a_percent", string_pos("%", RunStats_PerfectText(_st)) > 1, RunStats_PerfectText(_st));
                _rs.snap = variable_clone(_st);
                _rs.quiet = 0;
                Scenario_Next(_s, 443);
            }
            if (_s.f - _rs.fight_f0 > 8000) { Scenario_Check("g9_the_fight_ends", false, "state=" + string(_bc != noone ? _bc.battle_state : -1) + " room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 443:   // the level-up screens the fight owes (a free stat point, a card) are answered with confirm; then it is quiet
            if (CardsUi_IsOpen() || _gs.ui.mode == UI_DIALOGUE || array_length(_gs.ui.lines) > 0) {
                _rs.quiet = 0;
                if ((_s.f - _s.last_tap) >= 12) Scenario_Tap("confirm");
            } else if (_gs.ui.mode == UI_NONE && Cards_NextOwed(_gs.player_ch) == "" && !Transition_IsActive()) {
                _rs.quiet++;
            } else {
                _rs.quiet = 0;
            }
            if (_rs.quiet > 30) Scenario_Next(_s, 444);
            if (_s.t > 1500) { Scenario_Check("g9_the_level_up_screens_are_answered", false, "mode=" + string(_gs.ui.mode) + " cards=" + string(CardsUi_IsOpen()) + " owed=" + Cards_NextOwed(_gs.player_ch)); Scenario_NoticeEnd(); }
            break;
        case 444:   // H1 (D140): the menu stops the time; Abandon run through the System tab (down once, confirm, Yes in the pop-up, confirm)
            if (_s.t == 1) {
                Scenario_ClearUi();
                Menu_Open(6);
            }
            if (_s.t == 10) _rs.pa = _gs.run.stats.play_ms;
            if (_s.t == 50) Scenario_Check("g9_run_time_stops_under_the_menu", Menu_IsOpen() && _gs.run.stats.play_ms == _rs.pa, "paused at " + string(_rs.pa) + ", 40 frames later " + string(_gs.run.stats.play_ms));
            if (_s.t == 80) Scenario_Tap("menu_down");   // Help, Abandon run
            if (_s.t == 125) {
                Scenario_Check("g9_the_menu_cursor_is_on_abandon", is_struct(TabMenu_TopMenu()) && TabMenu_TopMenu().items[TabMenu_TopMenu().cursor].id == "abandon", "cursor=" + string(is_struct(TabMenu_TopMenu()) ? TabMenu_TopMenu().cursor : -1));
                Scenario_Tap("confirm");
            }
            if (_s.t == 137) {   // H2 (D156): the first confirm opens the Yes / No pop-up (cursor on No); up to Yes, then confirm
                Scenario_Check("g9_abandon_asks_in_the_shared_popup", Confirm_IsOpen() && Confirm_Menu().cursor == 1, "open=" + string(Confirm_IsOpen()));
                Scenario_Tap("menu_up");
            }
            if (_s.t == 149) Scenario_Tap("confirm");
            if (_s.t > 160) Scenario_TapCutscene(_s);
            if (_s.t > 160 && _sc != noone && _sc.state == "run_flow" && variable_global_exists("run_flow") && is_struct(global.run_flow)) Scenario_Next(_s, 445);
            if (_s.t > 1500) { Scenario_Check("g9_abandon_reaches_the_death_flow", false, "room=" + room_get_name(room) + " state=" + (_sc != noone ? string(_sc.state) : "none") + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 445:   // the death line passes; the summary shows the numbers of the fight
            Scenario_TapCutscene(_s);
            if (_rs.sum_t < 0 && global.run_flow.phase == "summary") _rs.sum_t = _s.t;
            if (_rs.sum_t >= 0 && _s.t == _rs.sum_t + 30) {
                var _e = global.run_flow.entry;
                var _rows = RunFlow_SummaryRows(_e);
                Scenario_Check("g9_the_summary_is_up", global.run_flow.phase == "summary");
                Scenario_Check("g9_the_summary_shows_fights_won_1", Test_RowValue(_rows, _fw) == "1", "got " + Test_RowValue(_rows, _fw));
                Scenario_Check("g9_the_summary_shows_the_damage_dealt", Test_RowValue(_rows, _dd) == string(_rs.snap.dmg_dealt) && _rs.snap.dmg_dealt > 0, "got " + Test_RowValue(_rows, _dd) + " want " + string(_rs.snap.dmg_dealt));
                Scenario_Check("g9_the_summary_shows_the_damage_taken", Test_RowValue(_rows, _dt) == string(_rs.snap.dmg_taken), "got " + Test_RowValue(_rows, _dt) + " want " + string(_rs.snap.dmg_taken));
                Scenario_Check("g9_the_summary_shows_the_perfect_rate", Test_RowValue(_rows, _pf) == RunStats_PerfectText(_rs.snap), "got " + Test_RowValue(_rows, _pf) + " want " + RunStats_PerfectText(_rs.snap));
                Scenario_Check("g9_the_summary_shows_a_run_time", Test_RowValue(_rows, _tm) != "-" && Test_RowValue(_rows, _tm) == RunStats_TimeText(_e.stats.play_ms) && _e.stats.play_ms > 0, "got " + Test_RowValue(_rows, _tm));
                Scenario_Check("g9_the_time_under_the_pause_menu_was_not_counted", _e.stats.play_ms == _rs.pa, "entry " + string(_e.stats.play_ms) + " pause " + string(_rs.pa));
                var _hist = Profile_Get().history;
                Scenario_Check("g9_the_history_entry_carries_the_stats", array_length(_hist) == 1 && variable_struct_exists(_hist[0], "stats") && _hist[0].stats.fights_won == 1 && _hist[0].stats.dmg_dealt == _rs.snap.dmg_dealt, json_stringify(_hist));
                _rs.entry_ms = _e.stats.play_ms;
            }
            if (_rs.sum_t >= 0 && _s.t == _rs.sum_t + 70) {
                Scenario_Check("g9_run_time_stops_when_the_run_is_over", !Run_IsActive() && _gs.run.stats.play_ms == _rs.entry_ms, "run " + string(_gs.run.stats.play_ms) + " entry " + string(_rs.entry_ms));
                Scenario_Tap("confirm");   // on to the next run
            }
            if (_rs.sum_t >= 0 && _s.t > _rs.sum_t + 75 && Scenario_FloorReady(rm_floor1) && Run_IsActive()) {
                _gs.pending_wake_line = false;
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_Check("g9_the_next_run_starts_its_stats_again", Scenario_RsAll0(_gs.run.stats), json_stringify(_gs.run.stats));
                Menu_Open(4);
                TabCodex_Open("history");
                Scenario_Next(_s, 446);
            }
            if (_s.t > 2400) { Scenario_Check("g9_the_summary_and_the_next_run", false, "phase=" + string(global.run_flow.phase) + " room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 446:   // the Codex run history shows the same numbers
            if (_s.t >= 24) {
                var _m = TabMenu_TopMenu();
                Scenario_Check("g9_the_codex_runs_page_is_open", is_struct(_m) && _m.id == "codex_history" && array_length(_m.items) >= 1, is_struct(_m) ? _m.id : "none");
                if (is_struct(_m) && array_length(_m.items) >= 1) {
                    var _ln = _m.items[0].lines;
                    Scenario_Check("g9_the_codex_runs_page_shows_fights_won_1", Test_RowValue(_ln, _fw) == "1", "got " + Test_RowValue(_ln, _fw));
                    Scenario_Check("g9_the_codex_runs_page_shows_the_damage", Test_RowValue(_ln, _dd) == string(_rs.snap.dmg_dealt) && Test_RowValue(_ln, _dt) == string(_rs.snap.dmg_taken), "dealt " + Test_RowValue(_ln, _dd) + " taken " + Test_RowValue(_ln, _dt));
                    Scenario_Check("g9_the_codex_runs_page_shows_the_perfect_rate_and_the_time", Test_RowValue(_ln, _pf) == RunStats_PerfectText(_rs.snap) && Test_RowValue(_ln, _tm) == RunStats_TimeText(_rs.entry_ms), "perfect " + Test_RowValue(_ln, _pf) + " time " + Test_RowValue(_ln, _tm));
                }
                Menu_Close(true);
                Scenario_ClearUi();
                Scenario_Next(_s, 447);
            }
            break;
        case 447:   // Continue keeps the run time
            if (_s.t == 1) {
                _rs.c0 = _gs.run.stats.play_ms;
                Scenario_Check("g9_the_new_run_has_some_time_before_it_is_saved", _rs.c0 > 0, "play_ms=" + string(_rs.c0));
                Scenario_Check("g9_the_run_is_saved", RunSave_WriteTo());
                Scenario_Check("g9_continue_starts", Run_Continue().ok);
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1) && !(variable_struct_exists(_gs, "load_spawn_pending") && _gs.load_spawn_pending)) {
                Scenario_Check("g9_continue_keeps_the_run_time_and_it_goes_on", _gs.run.stats.play_ms >= _rs.c0 && _gs.run.stats.play_ms < _rs.c0 + 8000, "saved " + string(_rs.c0) + " now " + string(_gs.run.stats.play_ms));
                Scenario_Next(_s, 500);   // H3 (D142, 500..519) goes on; its last step calls Scenario_NoticeEnd (the end of the chain: removes the files and the profile the steps made)
            }
            if (_s.t > 900) { Scenario_Check("g9_continue_reaches_the_floor", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- G6 pictures 400-409 (scale 3 = 480 x 432): the chest burst with the item just out, the item higher and fading, the gold counter part way, the level-up
// sparkle, the player in the middle of a squash. The effect clock is frozen at an exact age for each picture. ----
function Scenario_StepShotsMapJuice(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "mjs")) _s.mjs = { };
    var _mj = _s.mjs;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    switch (_s.step) {
        case 400:   // a run with some gold, rm_floor3, the player next to the lv2 chest
            if (_s.t == 1) {
                var _g0 = Scenario_NewKnight(CLASS_KNIGHT);
                _g0.run = Run_Create(2469);
                _g0.run.gold = 87;
                Scenario_SetWindowScale(3);
                MapFx_Clear();
                global.mapfx_clock = -1;
                room_goto(rm_floor3);
            }
            if (_s.t > 40 && Scenario_FloorReady(rm_floor3) && !variable_struct_exists(_mj, "staged")) {   // the fade from the battle room is over
                _mj.staged = true;
                Scenario_ClearUi();
                var _staged_ok = Scenario_MapJuiceStage(_mj);
                Scenario_Check("shots_mapjuice_the_chest_is_staged", _staged_ok);
                MapFx_Clear();
                _mj.t1 = _s.t;
            }
            if (variable_struct_exists(_mj, "staged") && !variable_struct_exists(_mj, "tapped") && _s.t >= _mj.t1 + 25) {
                _mj.tapped = true;
                Scenario_Tap("interact");
            }
            if (variable_struct_exists(_mj, "tapped") && MapFx_Count("burst") > 0) {
                _mj.t0 = MapFx_Start("burst");
                global.mapfx_clock = _mj.t0 + 170;   // the burst 170 ms old (spread out, still opaque enough), the item a few pixels up
                Scenario_Next(_s, 401);
            }
            if (_s.t > 900) { Scenario_Check("shots_mapjuice_the_chest_opens", false); Scenario_Finish(); }
            break;
        case 401:
            if (_s.t == 3) {
                _s.shot = "shot_mapjuice_burst.png";
                Scenario_ShotLayout(_s.shot);
            }
            if (_s.t >= 6) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                global.mapfx_clock = _mj.t0 + 330;   // the burst is over, the item has almost risen and is fading
                Scenario_Next(_s, 402);
            }
            break;
        case 402:
            if (_s.t == 3) {
                _s.shot = "shot_mapjuice_rise.png";
                Scenario_ShotLayout(_s.shot);
            }
            if (_s.t >= 6) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                global.mapfx_clock = -1;
                MapFx_Clear();
                Scenario_Next(_s, 403);
            }
            break;
        case 403:   // the dialogue of the chest is over; the gold goes up, the counter is 200 ms into its count
            if (_s.t == 1) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
            }
            if (_s.t == 15) {
                _gs.run.gold += 60;
                _mj.gold_t0 = current_time;
            }
            if (_s.t == 20) {
                var _gd = Feel_GoldState();
                _mj.gold_start = _gd.start;
                global.mapfx_clock = _gd.start + 200;
            }
            if (_s.t == 24) {
                _s.shot = "shot_mapjuice_gold.png";
                var _gd2 = Feel_GoldState();
                Scenario_Check("shots_mapjuice_the_gold_number_is_part_way", _gd2.shown > 87 && _gd2.shown < 147, "shown=" + string(_gd2.shown));
                Scenario_ShotLayout(_s.shot);
            }
            if (_s.t >= 27) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                global.mapfx_clock = -1;
                Scenario_Next(_s, 404);
            }
            break;
        case 404:   // a level-up: the sparkle ring 200 ms in
            if (_s.t == 1) {
                MapFx_Clear();
                var _chl = Player_AddExp(_gs.player_ch, max(1, _gs.player_ch.exp_next));
                _chl.card_picks = 0;   // the level's screens (stat point, card pick) would open over the picture
                _chl.stat_points = 0;
                GameState_SetPlayer(_chl);
                if (instance_exists(obj_player)) obj_player.character = _gs.player_ch;
            }
            if (_s.t > 1 && MapFx_Count("sparkle") > 0 && !variable_struct_exists(_mj, "sp0")) {
                _mj.sp0 = MapFx_Start("sparkle");
                global.mapfx_clock = _mj.sp0 + 200;
                _mj.sp_t = _s.t;
            }
            if (variable_struct_exists(_mj, "sp0") && _s.t == _mj.sp_t + 3) {
                _s.shot = "shot_mapjuice_levelup.png";
                Scenario_ShotLayout(_s.shot);
            }
            if (variable_struct_exists(_mj, "sp0") && _s.t >= _mj.sp_t + 6) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                global.mapfx_clock = -1;
                MapFx_Clear();
                _gs.player_ch.card_picks = 0;
                _gs.player_ch.stat_points = 0;
                CardsUi_Close();
                Scenario_Next(_s, 405);
            }
            if (_s.t > 300) { Scenario_Check("shots_mapjuice_the_sparkle_starts", false); Scenario_Finish(); }
            break;
        case 405:   // a step: the picture is taken 10 ms into its squash
            if (_s.t == 1) {
                Scenario_ClearUi();
                _mj.dir = Scenario_MapJuiceFreeDir(_pl);
                if (!is_struct(_mj.dir)) { Scenario_Check("shots_mapjuice_the_player_has_a_free_tile", false); Scenario_Finish(); break; }
                _pl.face = _mj.dir.face;
                Scenario_Hold(_mj.dir.act, 10);
            }
            if (_s.t > 1 && is_struct(_mj.dir) && _pl.squash_on && !variable_struct_exists(_mj, "sq_t")) {
                _mj.sq_t = _s.t;
                global.mapfx_clock = _pl.squash_start + 10;
            }
            if (variable_struct_exists(_mj, "sq_t") && _s.t == _mj.sq_t + 3) {
                _s.shot = "shot_mapjuice_squash.png";
                Scenario_Check("shots_mapjuice_the_player_is_mid_step_and_squashed", _pl.moving && _pl.squash_on && !_pl.visible);
                Scenario_ShotLayout(_s.shot);
            }
            if (variable_struct_exists(_mj, "sq_t") && _s.t >= _mj.sq_t + 6) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                global.mapfx_clock = -1;
                Scenario_Release();
                Scenario_Next(_s, 406);   // hunt7map: the same squash is under the room's darkness
            }
            if (_s.t > 200) { Scenario_Release(); Scenario_Check("shots_mapjuice_the_step_squashes", false); Scenario_Finish(); }
            break;
        case 406:   // hunt7map: in a very dark room with no light source, the player squashed is as dark as the player plain, on the same tile and in the same frame
            if (_s.t < 4 || !Player_IsSettled(_pl)) {
                if (_s.t > 200) { Scenario_Check("shots_hunt7map_the_player_settles", false); Scenario_Finish(); }
                break;
            }
            if (!variable_struct_exists(_mj, "p7")) {
                Light_RoomSources();
                _mj.p7 = { dark: global.light_dark, srcs: global.light_srcs, f: _s.f, now: MapFx_Now() };
                global.light_dark = 0.85;   // so dark that a lit pixel cannot be mistaken for a dark one
                global.light_srcs = [];     // no fire or sun spot lightens the tile
                global.mapfx_clock = _mj.p7.now;
                global.light_clock = _mj.p7.now;
                _pl.squash_start = _mj.p7.now - 1000;   // plain: the squash is long over
            }
            var _p7 = _mj.p7;
            if (_s.f == _p7.f + 4) {
                _p7.lum_plain = Scenario_AppBoxLuminance(_pl.x, _pl.y, 16, 16);
                Scenario_Check("shots_hunt7map_the_plain_player_is_drawn_for_the_control", _pl.visible && !_pl.squash_on);
                _pl.squash_start = _p7.now - 10;   // squashed: 10 ms into it
            }
            if (_s.f == _p7.f + 8) {
                _p7.lum_sq = Scenario_AppBoxLuminance(_pl.x, _pl.y, 16, 16);
                Scenario_Check("shots_hunt7map_the_squashed_player_is_drawn", _pl.squash_on && !_pl.visible);
                Scenario_Check("shots_hunt7map_the_squashed_player_is_as_dark_as_the_plain_one", _p7.lum_sq <= _p7.lum_plain * 1.10 + 2, "plain=" + string(_p7.lum_plain) + " squashed=" + string(_p7.lum_sq));
                global.light_dark = _p7.dark;
                global.light_srcs = _p7.srcs;
                global.mapfx_clock = -1;
                global.light_clock = -1;
                _pl.squash_start = -100000;
                Scenario_Next(_s, 460);   // G9 (D137, pictures 460..466) goes on; its last step ends the run
            }
            if (_s.t > 300) { Scenario_Check("shots_hunt7map_the_probe_ends", false); Scenario_Finish(); }
            break;
    }
}

// ---- pictures 460..469 (480 x 432, display scale 3): the run summary with the stats (English, Korean), the Codex run history with a run that has stats and
// one from before D137 (shown as "-"). ----
function Scenario_ShotRunStats(_s, _name) {
    _s.shot = "shot_runstats_" + _name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
    Scenario_ShotLayout(_s.shot);
}

function Scenario_StepShotsRunStats(_s) {
    var _gs = GameState_Get();
    var _flow = (variable_global_exists("run_flow") && is_struct(global.run_flow)) ? global.run_flow : undefined;
    var _scn = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    switch (_s.step) {
        case 460:   // a run whose stats are set, and a death by a spider (an older run without stats is in the history)
            if (_s.t == 1) {
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP run stats shots (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_Finish();
                    break;
                }
                Scenario_ClearUi();
                Profile_ResetForTest();
                RunSave_Delete();
                Scenario_SetWindowScale(3);
                Loc_SetLanguage("en");
                global.tutorial_off = true;
                _gs.in_main_menu = false;
                Run_StartNew(false, 9138);
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1) && _s.t > 40) {
                Scenario_ClearUi();
                Profile_RecordRun(Profile_Get(), { seed: 40111, class_id: CLASS_KNIGHT, level: 4, floor: 3, room: "rm_floor3", result: "died", cause: "Spider", kills: 7, gold: 52, at: 0 });
                GameState_SetBattleEnemy("g9_shot", ENEMY_SPIDER, 1);
                var _chd = _gs.player_ch;
                _chd.level = 5;
                GameState_SetPlayer(_chd);
                _gs.run.kills = 6;
                _gs.run.stats = { qte_total: 23, qte_perfect: 14, crits: 3, dmg_dealt: 186, dmg_taken: 94, fights_won: 6, play_ms: 1334000 };   // 61%, 22:14
                Player_OnDeath(_gs.player_ch);
                Scenario_Next(_s, 461);
            }
            if (_s.t > 600) { Scenario_Check("shots_runstats_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 461:   // the death line has begun: jump to the summary (the death line itself is a smoke check)
            if (is_struct(_flow) && _scn != noone && _scn.state == "run_flow" && _flow.phase == "death" && _flow.t >= 10) {
                _flow.phase = "summary";
                _flow.t = 0;
                Scenario_Next(_s, 462);
            }
            if (_s.t > 900) { Scenario_Check("shots_runstats_reaches_the_death_flow", false, "state=" + (_scn != noone ? string(_scn.state) : "none")); Scenario_NoticeEnd(); }
            break;
        case 462:   // the summary with the stats
            if (_s.t == 30) {
                var _rows = RunFlow_SummaryRows(_flow.entry);
                Scenario_Check("shots_runstats_summary_perfect_rate", Test_RowValue(_rows, Loc_T("stat.perfect", "Perfect Rate")) == "61%");
                Scenario_Check("shots_runstats_summary_run_time", Test_RowValue(_rows, Loc_T("stat.time", "Run Time")) == "22:14");
                Scenario_ShotRunStats(_s, "summary");
            }
            if (_s.t == 34) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Loc_SetLanguage("ko");
            }
            if (_s.t == 64) Scenario_ShotRunStats(_s, "summary_ko");
            if (_s.t == 68) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Loc_SetLanguage("en");
                Scenario_SetWindowScale(5);   // 800 x 720: the eleven rows do not fit one under the other, the summary goes to two columns
            }
            if (_s.t == 110) Scenario_ShotRunStats(_s, "summary");
            if (_s.t == 114) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_SetWindowScale(3);
                Scenario_Next(_s, 463);
            }
            break;
        case 463:   // confirm -> the next run; the Codex run history (newest first: the run with stats)
            if (_s.t == 20) Scenario_Tap("confirm");
            if (_s.t > 40 && Scenario_FloorReady(rm_floor1) && Run_IsActive()) {
                _gs.pending_wake_line = false;
                Dialogue_CloseNow();
                Scenario_ClearUi();
                with (obj_enemy) instance_destroy();
                Menu_Open(4);
                TabCodex_Open("history");
                Scenario_Next(_s, 464);
            }
            if (_s.t > 900) { Scenario_Check("shots_runstats_the_next_run_starts", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 464:   // the run with stats under the cursor
            if (_s.t >= 24) {
                Scenario_Check("shots_runstats_codex_runs_open", _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()) && TabMenu_TopMenu().id == "codex_history", "mode=" + string(_gs.ui.mode));
                Scenario_TabLayoutChecks("runstats_codex_3");
                Scenario_ShotRunStats(_s, "codex_runs");
                Scenario_Next(_s, 465);
            }
            break;
        case 465:   // the older run (from before D137, no stats) under the cursor
            if (_s.t == 4) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Ui_MenuFixCursor(TabMenu_TopMenu(), 1);
            }
            if (_s.t >= 24) {
                Scenario_TabLayoutChecks("runstats_codex_old_3");
                Scenario_ShotRunStats(_s, "codex_runs_old");
                Scenario_Next(_s, 466);
            }
            break;
        case 466:
            if (_s.t >= 4) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                if (is_struct(TabMenu_Get())) Menu_Close(true);
                Scenario_ClearUi();
                Scenario_Next(_s, 540);   // H4 (D143, pictures 540..549) goes on; its last step ends the run and removes the files and the profile the steps made
            }
            break;
    }
}

// ============================================================================
// H3 (D142, amends D64), smoke steps 500..519. On room arrival the player still stands on the exit tile; pressing TOWARD that exit (the way you walk out
// through it) leaves at once, any other direction walks normally. Real exits of rm_floor3 / rm_floor4, the game's own input state.
//   500: rm_floor3, the player on its exit to floor 4: UP walks out of it.   501: rm_floor4, arrived on the exit back: the first input is toward it (DOWN).
//   502: the room changes at once.   503: rm_floor3 again, on the exit: the first input is a side direction.   504: the player walks, the room stays; the last step ends the run.
// ============================================================================
// A direction the player can walk one tile in, other than the exit's own: { act, dx, dy }, or undefined.
function Scenario_H3SideDir(_pl, _exit_dir) {
    var _opts = [
        { dir: LEFT, act: "move_left", dx: -1, dy: 0 }, { dir: RIGHT, act: "move_right", dx: 1, dy: 0 },
        { dir: UP, act: "move_up", dx: 0, dy: -1 }, { dir: DOWN, act: "move_down", dx: 0, dy: 1 }
    ];
    for (var _i = 0; _i < 4; _i++) {
        if (_opts[_i].dir == _exit_dir) continue;
        if (!Player_TileBlocked(_pl, _pl.x + _opts[_i].dx * GRID_TILE_SIZE, _pl.y + _opts[_i].dy * GRID_TILE_SIZE)) return _opts[_i];
    }
    return undefined;
}

function Scenario_StepSmokeH3(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "h3")) _s.h3 = { };
    var _h = _s.h3;
    var _T = GRID_TILE_SIZE;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    switch (_s.step) {
        case 500:   // rm_floor3, the player placed on its exit to floor 4 (no enemies), UP walks out of it
            if (!variable_struct_exists(_h, "went") && room != rm_floor3) {   // the step before (G9, D137) ends in rm_floor1 with a continued run
                _h.went = true;
                Dialogue_CloseNow();
                Scenario_ClearUi();
                room_goto(rm_floor3);
                break;
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _ex = noone;
                with (obj_room_transition) { if (transition_id == "floor3_to_floor4") _ex = id; }
                Scenario_Check("h3_rm_floor3_has_its_exit_to_floor_4", _ex != noone);
                if (_ex == noone) { Scenario_NoticeEnd(); break; }
                Scenario_PlacePlayer(round(_ex.bbox_left / _T), round(_ex.bbox_top / _T));
                Scenario_Hold(Scenario_Hunt2DirAction(_ex.require_dir), 4);   // a press that ends before the next room is up
                Scenario_Next(_s, 501);
            }
            if (_s.t > 300) { Scenario_Check("h3_rm_floor3_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 501:   // arrived in rm_floor4 on the exit back to floor 3: it ignores the player until a step, but the first input is toward it
            if (_s.t > 5 && Scenario_FloorReady(rm_floor4) && Player_IsSettled(_pl)) {
                Scenario_Release();
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _ex2 = instance_position(_pl.x + _T / 2, _pl.y + _T / 2, obj_room_transition);
                Scenario_Check("h3_the_arrival_puts_the_player_on_an_exit_tile", _ex2 != noone, "x=" + string(_pl.x) + " y=" + string(_pl.y));
                if (_ex2 == noone) { Scenario_NoticeEnd(); break; }
                Scenario_Check("h3_it_is_the_exit_back_to_floor_3", _ex2.transition_id == "floor4_to_floor3", "id=" + string(_ex2.transition_id));
                Scenario_Check("h3_the_arrival_exit_ignores_the_player_until_a_press_or_a_step", _pl.exit_ignore == _ex2);
                _h.f0 = _s.f;
                Scenario_Hold(Scenario_Hunt2DirAction(_ex2.require_dir), 6);   // the first input: toward the exit
                Scenario_Next(_s, 502);
            }
            if (_s.t > 600) { Scenario_Check("h3_the_player_arrives_in_rm_floor4", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 502:   // the room changes at once (the fade starts within a few frames of the press), and rm_floor3 is the room that comes
            if (!variable_struct_exists(_h, "left_f") && (Transition_IsActive() || room != rm_floor4)) {
                _h.left_f = _s.f - _h.f0;
                Scenario_Release();
                Scenario_Check("h3_a_press_toward_the_arrival_exit_leaves_at_once", _h.left_f <= 12, "frames=" + string(_h.left_f));
            }
            if (variable_struct_exists(_h, "left_f") && _s.t > 5 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                Scenario_Release();
                Scenario_Check("h3_it_leads_back_to_rm_floor_3", room == rm_floor3);
                Scenario_Next(_s, 503);
            }
            if (_s.t > 600) { Scenario_Release(); Scenario_Check("h3_the_press_toward_the_exit_changes_the_room", false, "room=" + room_get_name(room) + " left=" + string(variable_struct_exists(_h, "left_f"))); Scenario_NoticeEnd(); }
            break;
        case 503:   // arrived in rm_floor3 on the exit to floor 4 again: the first input is a side direction
            if (_s.t > 5 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _ex3 = instance_position(_pl.x + _T / 2, _pl.y + _T / 2, obj_room_transition);
                Scenario_Check("h3_the_second_arrival_is_on_an_exit_tile_too", _ex3 != noone, "x=" + string(_pl.x) + " y=" + string(_pl.y));
                if (_ex3 == noone) { Scenario_NoticeEnd(); break; }
                Scenario_Check("h3_the_exit_ignores_the_player_on_the_second_arrival", _pl.exit_ignore == _ex3);
                var _side = Scenario_H3SideDir(_pl, _ex3.require_dir);
                Scenario_Check("h3_a_side_direction_is_free_to_walk", is_struct(_side));
                if (!is_struct(_side)) { Scenario_NoticeEnd(); break; }
                _h.x0 = _pl.x;
                _h.y0 = _pl.y;
                _h.dx = _side.dx * _T;
                _h.dy = _side.dy * _T;
                Scenario_Hold(_side.act, 30);
                Scenario_Next(_s, 504);
            }
            if (_s.t > 600) { Scenario_Check("h3_the_player_arrives_in_rm_floor3_again", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 504:   // the side press walks one tile; the room does not change; the exit is armed again once the player is off it
            if (_s.t >= 40 && Player_IsSettled(_pl)) {
                Scenario_Release();
                Scenario_Check("h3_a_side_press_does_not_leave_the_room", room == rm_floor3 && !Transition_IsActive(), "room=" + room_get_name(room));
                var _along = (_pl.x - _h.x0) * sign(_h.dx) + (_pl.y - _h.y0) * sign(_h.dy);   // how far it went the way it was pressed (the key is held a little longer than one step)
                var _across = abs((_pl.x - _h.x0) * sign(_h.dy)) + abs((_pl.y - _h.y0) * sign(_h.dx));
                Scenario_Check("h3_the_player_walked_sideways_at_least_a_tile", _along >= _T && _across == 0, "at " + string(_pl.x) + "," + string(_pl.y) + " from " + string(_h.x0) + "," + string(_h.y0));
                Scenario_Check("h3_off_the_exit_it_is_armed_again", _pl.exit_ignore == noone);
                Scenario_Next(_s, 520);   // H4 (D143, 520..539) goes on; its last step ends the smoke chain
            }
            if (_s.t > 300) { Scenario_Release(); Scenario_Check("h3_the_side_step_ends", false); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- H4 (D143, amends D76), steps 520..529: the level-up screen with real keys. A Knight of the run levels up: the screen shows "Knight growth: ATK +1, DEF +1",
// offers six rows (the four stats, Max HP +3, Max MP +2), a point on Max HP raises max and current HP by 3, then the next level-up's point goes to Max MP.
// The last step ends the smoke chain (Scenario_NoticeEnd). ----
function Scenario_StepSmokeLevelUp(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "lu")) _s.lu = { q: [] };
    var _lu = _s.lu;
    var _ch = _gs.player_ch;
    Scenario_CardsTapQueue(_s, _lu);
    switch (_s.step) {
        case 520:   // a fresh Knight in the run, hurt a little, one level-up away
            if (_s.t == 1) {
                CardsUi_Close();
                Scenario_ClearUi();
                var _k = CharacterCreate_Player(CLASS_KNIGHT);
                _k.hp = _k.max_hp - 4;
                _lu.hp0 = _k.hp;
                _lu.atk0 = _k.stats.atk;
                _lu.def0 = _k.stats.def;
                _lu.mp0 = _k.mp;
                GameState_SetPlayer(_k);
                if (instance_exists(obj_player)) obj_player.character = _gs.player_ch;
                Scenario_Check("levelup_a_run_is_going_and_the_player_places_the_point", Run_IsActive() && !Level_AutoPlaceEnabled());
                GameState_SetPlayer(Player_AddExp(_gs.player_ch, _gs.player_ch.exp_next));
                if (instance_exists(obj_player)) obj_player.character = _gs.player_ch;
                Scenario_Check("levelup_the_knight_reached_level_2_owing_one_point", _gs.player_ch.level == 2 && _gs.player_ch.stat_points == 1, "level=" + string(_gs.player_ch.level) + " points=" + string(_gs.player_ch.stat_points));
            }
            if (_s.t > 5 && CardsUi_Kind() == "stat") {
                var _ms = Ui_StackTop(global.cards_ui.stk);
                Scenario_Check("levelup_the_free_point_screen_opens_first", _ms.id == "cards_stat");
                Scenario_Check("levelup_the_screen_offers_six_rows", array_length(_ms.items) == 6, "n=" + string(array_length(_ms.items)));
                Scenario_Check("levelup_the_screen_shows_the_knight_growth", _ms.layout.note == "Knight growth: ATK +1, DEF +1", "note=" + string(_ms.layout.note));
                Scenario_Check("levelup_the_rows_end_with_max_hp_and_max_mp", array_length(_ms.items) == 6 && _ms.items[4].label == "Max HP +3" && _ms.items[5].label == "Max MP +2");
                Scenario_Check("levelup_the_cursor_starts_on_the_class_stat", _ms.cursor == STAT_DEF, "cursor=" + string(_ms.cursor));
                _lu.q = ["menu_down", "menu_down", "menu_down", "confirm"];   // DEF -> SPD -> MAG -> Max HP, place the point
                Scenario_Next(_s, 521);
            }
            if (_s.t > 900) { Scenario_Check("levelup_the_free_point_screen_opens", false, "kind=" + CardsUi_Kind()); Scenario_NoticeEnd(); }
            break;
        case 521:   // the point is on Max HP; the card pick comes next and is skipped
            if (_s.t > 30 && array_length(_lu.q) == 0 && CardsUi_Kind() == "cards" && !variable_struct_exists(_lu, "p1")) {
                _lu.p1 = true;
                var _hd = _ch.class_cfg.hd;
                Scenario_Check("levelup_max_hp_went_up_by_3", _ch.max_hp == Resource_MaxHp(_hd, 2) + 3, "max_hp=" + string(_ch.max_hp));
                Scenario_Check("levelup_current_hp_went_up_by_the_level_and_by_3", _ch.hp == _lu.hp0 + (Resource_MaxHp(_hd, 2) - Resource_MaxHp(_hd, 1)) + 3, "hp=" + string(_ch.hp) + " was " + string(_lu.hp0));
                Scenario_Check("levelup_the_point_is_spent_once", _ch.stat_points == 0);
                Scenario_Check("levelup_only_the_class_growth_reached_the_stats", _ch.stats.atk == _lu.atk0 + 1 && _ch.stats.def == _lu.def0 + 1, "atk=" + string(_ch.stats.atk) + " def=" + string(_ch.stats.def));
                Scenario_CardsHarmless();
                _lu.q = ["confirm"];   // R3: no Skip any more; the first card (a harmless one) answers the pick
            }
            if (variable_struct_exists(_lu, "p1") && array_length(_lu.q) == 0 && _s.t > 150 && !CardsUi_IsOpen()) {
                Scenario_Check("levelup_nothing_is_owed_after_the_pick", Cards_NextOwed(_ch) == "");
                _lu.mp1 = _ch.mp;
                GameState_SetPlayer(Player_AddExp(_gs.player_ch, _gs.player_ch.exp_next));   // level 3: the next point goes to Max MP
                if (instance_exists(obj_player)) obj_player.character = _gs.player_ch;
                Scenario_Next(_s, 522);
            }
            if (_s.t > 900) { Scenario_Check("levelup_the_point_and_the_pick_are_answered", false, "kind=" + CardsUi_Kind() + " q=" + string(array_length(_lu.q))); Scenario_NoticeEnd(); }
            break;
        case 522:   // level 3: the screen again; Max MP
            if (_s.t > 5 && CardsUi_Kind() == "stat") {
                var _m2 = Ui_StackTop(global.cards_ui.stk);
                Scenario_Check("levelup_level_3_shows_the_growth_line_again", _m2.layout.note == "Knight growth: ATK +1, DEF +1", "note=" + string(_m2.layout.note));
                Scenario_Check("levelup_level_3_title_names_the_level", string_pos("3", _m2.layout.title) > 0, "title=" + string(_m2.layout.title));
                _lu.q = ["menu_down", "menu_down", "menu_down", "menu_down", "confirm"];   // DEF -> ... -> Max MP
                Scenario_Next(_s, 523);
            }
            if (_s.t > 900) { Scenario_Check("levelup_level_3_opens_the_free_point_screen", false, "kind=" + CardsUi_Kind()); Scenario_NoticeEnd(); }
            break;
        case 523:
            if (_s.t > 30 && array_length(_lu.q) == 0 && CardsUi_Kind() == "cards" && !variable_struct_exists(_lu, "p2")) {
                _lu.p2 = true;
                var _hd3 = _ch.class_cfg.hd;
                Scenario_Check("levelup_max_mp_went_up_by_2", _ch.max_mp == Resource_MaxMp(_ch.class_cfg.mp_gain, 3, _ch.stats.mag) + 2, "max_mp=" + string(_ch.max_mp));
                Scenario_Check("levelup_current_mp_went_up_with_the_level_and_by_2", _ch.mp == min(_ch.max_mp, _lu.mp1 + (Resource_MaxMp(_ch.class_cfg.mp_gain, 3, _ch.stats.mag) - Resource_MaxMp(_ch.class_cfg.mp_gain, 2, _ch.stats.mag)) + 2), "mp=" + string(_ch.mp));
                Scenario_Check("levelup_the_earlier_max_hp_bonus_is_kept", _ch.max_hp == Resource_MaxHp(_hd3, 3) + 3, "max_hp=" + string(_ch.max_hp));
                Scenario_Check("levelup_the_second_point_is_spent_once", _ch.stat_points == 0);
                Scenario_CardsHarmless();
                _lu.q = ["confirm"];   // R3: no Skip any more; the first card (a harmless one) answers the pick
            }
            if (variable_struct_exists(_lu, "p2") && array_length(_lu.q) == 0 && _s.t > 150 && !CardsUi_IsOpen()) {
                Scenario_Check("levelup_nothing_is_owed_at_the_end", Cards_NextOwed(_ch) == "");
                Scenario_Next(_s, 470);   // H1 (D140, D141, 470..489) goes on; its last step ends the chain
            }
            if (_s.t > 900) { Scenario_Check("levelup_the_second_point_and_pick_are_answered", false, "kind=" + CardsUi_Kind() + " q=" + string(array_length(_lu.q))); Scenario_NoticeEnd(); }
            break;
    }
}

// ============================================================================
// H1 (D140, D141): one menu. Smoke steps 470-489 (the chain goes on with H2's steps 650-669).
//   470  a fresh run in rm_floor1, nothing else on screen
//   471  on the map: Esc opens the tab menu, Esc closes it, Tab opens the same menu, Tab closes it, Q from the first tab is System
//   472  the player steps onto a real enemy: a real fight starts (the encounter takes the snapshot)
//   473  in the fight: Esc at the root command menu opens the menu and Esc closes it; in the item list Esc is Back (no menu), Tab opens the menu there
//   474  in the fight: System tab -> Quit to title (the fight is left at once)
//   475  the title: Continue puts the run back just before the fight (HP, MP, potions, the enemy alive) with a battle cooldown, so no fight starts at once
// ============================================================================
function Scenario_StepSmokeOneMenu(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "om")) _s.om = { };
    var _o = _s.om;
    var _T = GRID_TILE_SIZE;
    var _bc = (room == rm_battle && instance_exists(obj_battle_controller)) ? instance_find(obj_battle_controller, 0) : noone;
    var _u = TabMenu_Get();
    switch (_s.step) {
        case 470:   // a new run, then rm_floor1 with nothing in the way
            if (!variable_struct_exists(_o, "begun")) {
                if (!Scenario_Hunt2Begin(_s, _o, 7501)) {
                    if (_s.t > 1500) { Scenario_Check("onemenu_a_new_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
                    break;
                }
                _o.begun = true;
                _s.t = 0;
                break;
            }
            if (!Scenario_FloorReady(rm_floor1)) {
                if (_s.t > 600) { Scenario_Check("onemenu_rm_floor1_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
                break;
            }
            if (_s.t > 5) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                global.tutorial_off = true;
                with (obj_dialogue_trigger) instance_destroy();
                Scenario_Next(_s, 471);
            }
            break;
        case 471:   // Esc and Tab are the same menu
            if (_s.t == 1) {
                Scenario_ClearUi();
                Ui_MemSet(Ui_MemGlobal(), "tab_menu_active", 0);   // the menu opens on Status
                Ui_MemSet(Ui_MemGlobal(), "tab_system", 0);   // the System list remembers its cursor: G9 (440..447) left it on Abandon run, this step starts from Help
            }
            if (_s.t == 8) Scenario_Tap("esc");
            if (_s.t == 20) {
                _u = TabMenu_Get();
                Scenario_Check("onemenu_esc_on_the_map_opens_the_tab_menu", _gs.ui.mode == UI_MENU && is_struct(_u), "mode=" + string(_gs.ui.mode));
                Scenario_Check("onemenu_it_has_seven_tabs", array_length(TabMenu_Labels()) == 7 && is_struct(_u) && array_length(_u.pages) == 7);
                Scenario_Tap("esc");   // Esc at the root of a tab is Back: it closes
            }
            if (_s.t == 40) {
                Scenario_Check("onemenu_esc_closes_it_again", _gs.ui.mode == UI_NONE && !is_struct(TabMenu_Get()), "mode=" + string(_gs.ui.mode));
                Scenario_Tap("menu");
            }
            if (_s.t == 52) {
                _u = TabMenu_Get();
                Scenario_Check("onemenu_tab_on_the_map_opens_the_same_menu", _gs.ui.mode == UI_MENU && is_struct(_u) && _u.tab == 0 && array_length(_u.pages) == 7, "mode=" + string(_gs.ui.mode));
                Scenario_Tap("menu");
            }
            if (_s.t == 72) {
                Scenario_Check("onemenu_tab_closes_it", _gs.ui.mode == UI_NONE && !is_struct(TabMenu_Get()), "mode=" + string(_gs.ui.mode));
                Scenario_Tap("esc");
            }
            if (_s.t == 84) Scenario_Tap("tab_prev");   // Q from the first tab wraps to the last
            if (_s.t == 96) {
                _u = TabMenu_Get();
                var _tm = TabMenu_TopMenu();
                Scenario_Check("onemenu_Q_from_status_wraps_to_system", is_struct(_u) && _u.tab == 6 && TabMenu_Ids()[_u.tab] == "system", "tab=" + string(is_struct(_u) ? _u.tab : -1));
                Scenario_Check("onemenu_system_has_help_abandon_and_quit", is_struct(_tm) && array_length(_tm.items) == 3 && _tm.items[0].id == "help" && _tm.items[1].id == "abandon" && _tm.items[2].id == "quit");
                Scenario_Tap("esc");
            }
            if (_s.t == 120) {
                Scenario_Check("onemenu_the_menu_is_closed_again", _gs.ui.mode == UI_NONE && !is_struct(TabMenu_Get()));
                Ui_MemSet(Ui_MemGlobal(), "tab_menu_active", 0);   // the next opening is on Status
                Scenario_Next(_s, 472);
            }
            break;
        case 472:   // an enemy of the room, the player on top of it: a real fight
            if (_s.t == 1) {
                Scenario_ClearUi();
                var _en = instance_find(obj_enemy, 0);
                if (!instance_exists(_en)) { Scenario_Check("onemenu_the_room_has_an_enemy", false); Scenario_NoticeEnd(); break; }
                with (obj_enemy) { if (id != _en) instance_destroy(); }
                var _ch = _gs.player_ch;
                _ch.hp = max(1, _ch.max_hp - 3);
                _ch.mp = max(0, _ch.max_mp - 1);
                _ch.inventory = Inv_Add(_ch.inventory, 11, 2);
                GameState_SetPlayer(_ch);
                if (instance_exists(obj_player) && variable_instance_exists(obj_player, "character")) obj_player.character = _gs.player_ch;
                _o.hp0 = _gs.player_ch.hp;
                _o.mp0 = _gs.player_ch.mp;
                _o.pot0 = Inv_Count(_gs.player_ch.inventory, 11);
                _o.gold0 = Run_Get().gold;
                Scenario_PlaceEnemy(_en, round(_en.x / _T), round(_en.y / _T));
                Scenario_PlacePlayer(round(_en.x / _T), round(_en.y / _T));
                _o.fight_t = _s.t;
            }
            if (room == rm_battle && !Transition_IsActive()) {
                _o.pid = _gs.battle.enemy_persist_id;
                Scenario_Check("onemenu_the_fight_started_from_the_map", _o.pid != "", "pid=" + string(_o.pid));
                Scenario_Next(_s, 473);
            }
            if (_s.t > 900) { Scenario_Check("onemenu_an_enemy_starts_a_fight", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 473:   // the fight: Esc at the command menu, Esc inside the item list, Tab inside the list
            if (_bc == noone && variable_struct_exists(_o, "k0")) { Scenario_Check("onemenu_the_battle_is_still_there", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); break; }
            if (_bc == noone || !(_bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && is_struct(_bc.ui_cmd))) {
                if (!variable_struct_exists(_o, "k0")) {
                    if (_s.t > 900) { Scenario_Check("onemenu_the_battle_reaches_the_player_menu", false, "state=" + string((_bc != noone) ? _bc.battle_state : -1)); Scenario_NoticeEnd(); }
                    _o.k_wait = _s.t;
                    break;
                }
            }
            if (!variable_struct_exists(_o, "k0")) {
                if (_s.t < _o.k_wait + 20) break;   // let the command panel settle
                _o.k0 = _s.t;
                Scenario_Check("onemenu_the_encounter_took_the_snapshot", EnemyPersist_HasSnapshot());
            }
            var _k = _s.t - _o.k0;
            if (_k == 0) Scenario_Tap("esc");
            if (_k == 12) {
                Scenario_Check("onemenu_esc_at_the_battle_command_menu_opens_the_menu", _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()) && _bc.battle_state == BSTATE_MENU, "mode=" + string(_gs.ui.mode) + " state=" + string(_bc.battle_state));
                Scenario_Tap("esc");
            }
            if (_k == 30) {
                Scenario_Check("onemenu_esc_closes_it_back_to_the_battle", _gs.ui.mode == UI_NONE && !is_struct(TabMenu_Get()) && _bc.battle_state == BSTATE_MENU, "mode=" + string(_gs.ui.mode));
                Scenario_Tap("menu_down");
            }
            if (_k == 42) Scenario_Tap("menu_down");
            if (_k == 54) {
                Scenario_Check("onemenu_the_battle_cursor_is_on_item", _bc.menu_index == 2, "i=" + string(_bc.menu_index));
                Scenario_Tap("confirm");
            }
            if (_k == 70) {
                Scenario_Check("onemenu_the_item_list_is_open", _bc.battle_state == BSTATE_ITEM_MENU, "state=" + string(_bc.battle_state));
                Scenario_Tap("esc");
            }
            if (_k == 84) {
                Scenario_Check("onemenu_esc_in_a_battle_list_is_back_not_the_menu", _bc.battle_state == BSTATE_MENU && _gs.ui.mode == UI_NONE && !is_struct(TabMenu_Get()), "state=" + string(_bc.battle_state) + " mode=" + string(_gs.ui.mode));
                Scenario_Tap("confirm");
            }
            if (_k == 100) {
                Scenario_Check("onemenu_the_item_list_opens_again", _bc.battle_state == BSTATE_ITEM_MENU, "state=" + string(_bc.battle_state));
                Scenario_Tap("menu");
            }
            if (_k == 112) {
                Scenario_Check("onemenu_tab_opens_the_menu_inside_a_battle_list", _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()) && _bc.battle_state == BSTATE_ITEM_MENU, "mode=" + string(_gs.ui.mode));
                Scenario_Tap("menu");
            }
            if (_k == 130) {
                Scenario_Check("onemenu_tab_closes_it_and_the_list_is_still_there", _gs.ui.mode == UI_NONE && _bc.battle_state == BSTATE_ITEM_MENU, "mode=" + string(_gs.ui.mode) + " state=" + string(_bc.battle_state));
                Scenario_Tap("esc");
            }
            if (_k == 145) {
                Scenario_Check("onemenu_back_to_the_command_menu", _bc.battle_state == BSTATE_MENU && _gs.ui.mode == UI_NONE);
                Scenario_Next(_s, 474);
            }
            break;
        case 474:   // System > Quit to title, in the fight
            if (_s.t == 1) Scenario_Tap("esc");
            if (_s.t == 14) {
                _u = TabMenu_Get();
                Scenario_Check("onemenu_the_menu_is_open_in_the_fight", _gs.ui.mode == UI_MENU && is_struct(_u));
                Scenario_Tap("tab_prev");
            }
            if (_s.t == 28) {
                _u = TabMenu_Get();
                var _tm2 = TabMenu_TopMenu();
                Scenario_Check("onemenu_Q_reaches_system_in_the_fight", is_struct(_u) && _u.tab == 6, "tab=" + string(is_struct(_u) ? _u.tab : -1));
                Scenario_Check("onemenu_abandon_and_quit_are_on_in_the_fight", is_struct(_tm2) && array_length(_tm2.items) == 3 && _tm2.items[1].enabled && _tm2.items[2].enabled);
                _bc.p.hp = 1;   // the fight goes on in the meantime: none of it may come back
                _bc.p.mp = 0;
                Scenario_Tap("menu_down");
            }
            if (_s.t == 40) Scenario_Tap("menu_down");
            if (_s.t == 52) {
                var _tm3 = TabMenu_TopMenu();
                Scenario_Check("onemenu_the_cursor_is_on_quit", is_struct(_tm3) && _tm3.cursor == 2 && _tm3.items[2].id == "quit", "cursor=" + string(is_struct(_tm3) ? _tm3.cursor : -1));
                Scenario_Tap("confirm");
            }
            if (_s.t == 64) {   // D156: the first press only asks, in the fight too
                Scenario_Check("confirm_quit_in_the_fight_asks_first", Confirm_IsOpen() && Confirm_Menu().cursor == 1 && room == rm_battle && Confirm_Question() == "Quit to title? Continue puts you back just before this battle.", "open=" + string(Confirm_IsOpen()) + " room=" + room_get_name(room));
                Scenario_Check("confirm_quit_in_the_fight_has_not_left_yet", is_struct(TabMenu_Get()) && TabMenu_Get().pending == "" && !_gs.in_main_menu);
                Scenario_Tap("menu_up");   // No -> Yes
            }
            if (_s.t == 76) {
                Scenario_Check("confirm_quit_in_the_fight_popup_is_on_yes", Confirm_IsOpen() && Confirm_Menu().cursor == 0 && room == rm_battle);
                Scenario_Tap("confirm");
            }
            if (_s.t > 80 && room == rm_start && !Transition_IsActive()) {
                Scenario_Check("onemenu_quit_in_the_fight_goes_to_the_title", _gs.in_main_menu && !is_struct(TabMenu_Get()) && _gs.ui.mode == UI_NONE);
                Scenario_Check("onemenu_the_run_save_is_there", RunSave_HasSave());
                Scenario_Next(_s, 475);
            }
            if (_s.t > 600) { Scenario_Check("onemenu_quit_in_the_fight_reaches_the_title", false, "room=" + room_get_name(room) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 475:   // Continue: back just before the fight
            var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
            if (room == rm_start && _sc != noone && !Transition_IsActive() && !variable_struct_exists(_o, "cont")) {
                if (_sc.state != "main") { _sc.state = "main"; break; }
                if (is_struct(_sc.title_stk) && _s.t > 20) {
                    Scenario_Check("onemenu_the_title_cursor_is_on_continue", Ui_StackTop(_sc.title_stk).cursor == 1, "cursor=" + string(Ui_StackTop(_sc.title_stk).cursor));
                    Scenario_Tap("confirm");
                    _o.cont = _s.t;
                }
            }
            if (variable_struct_exists(_o, "cont") && !variable_struct_exists(_o, "arrived") && Scenario_FloorReady(rm_floor1) && !_gs.load_spawn_pending) {
                _o.arrived = _s.t;
            }
            if (variable_struct_exists(_o, "arrived") && _s.t == _o.arrived + 6) {
                var _pl = instance_find(obj_player, 0);
                Scenario_Check("onemenu_continue_restores_the_hp_from_before_the_fight", _gs.player_ch.hp == _o.hp0, "hp=" + string(_gs.player_ch.hp) + " want " + string(_o.hp0));
                Scenario_Check("onemenu_continue_restores_the_mp_from_before_the_fight", _gs.player_ch.mp == _o.mp0, "mp=" + string(_gs.player_ch.mp) + " want " + string(_o.mp0));
                Scenario_Check("onemenu_continue_restores_the_potions", Inv_Count(_gs.player_ch.inventory, 11) == _o.pot0, "potions=" + string(Inv_Count(_gs.player_ch.inventory, 11)) + " want " + string(_o.pot0));
                Scenario_Check("onemenu_continue_restores_the_gold", Run_Get().gold == _o.gold0);
                _o.found = false;
                with (obj_enemy) { if (variable_instance_exists(id, "persist_id") && persist_id == _o.pid) _o.found = true; }
                var _d = RoomState_Get(rm_floor1, _o.pid);
                Scenario_Check("onemenu_the_enemy_is_back_on_the_map", _o.found && !(is_struct(_d) && variable_struct_exists(_d, "removed") && _d.removed), "found=" + string(_o.found));
                Scenario_Check("onemenu_the_player_has_a_battle_cooldown", instance_exists(_pl) && _pl.battle_cooldown > 0, "cooldown=" + string(instance_exists(_pl) ? _pl.battle_cooldown : -1));
            }
            if (variable_struct_exists(_o, "arrived") && _s.t == _o.arrived + 30) {
                Scenario_Check("onemenu_no_fight_starts_at_once_after_continue", room == rm_floor1 && !Transition_IsActive(), "room=" + room_get_name(room) + " fx=" + json_stringify(_gs.transition_fx) + " cooldown=" + string(instance_exists(obj_player) ? instance_find(obj_player, 0).battle_cooldown : -1));
                Scenario_Next(_s, 550);   // H10 (D152, 550..559) goes on; its last step ends the smoke chain
            }
            if (_s.t > 1500) { Scenario_Check("onemenu_continue_reaches_rm_floor1", false, "room=" + room_get_name(room) + " cont=" + string(variable_struct_exists(_o, "cont"))); Scenario_NoticeEnd(); }
            break;
    }
}

// D152: New Game opens the seed pick. The scenarios that only want a run take its first row (Random seed) with a real confirm, once the pick is open and has
// accepted keys (UI_INPUT_LOCK_MS). Returns true on the frame it taps.
function Scenario_SeedPickRandom(_s) {
    var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    if (_sc == noone || room != rm_start || !is_struct(_sc.title_stk) || is_struct(_sc.title_exit)) return false;
    var _top = Ui_StackTop(_sc.title_stk);
    if (!is_struct(_top) || _top.id != "seed_choice" || is_struct(Title_SeedEntryOf(_sc))) return false;
    if (current_time - _top.lock_ms < UI_INPUT_LOCK_MS + 40 || (_s.f - _s.last_tap) < 8) return false;
    Scenario_Tap("confirm");
    return true;
}

// ============================================================================
// H10 (D152): seed input through the real title (smoke steps 550-559, the end of the chain). A clean profile that has seen the intro (New Game starts a run
// at once), the title, New Game opens the seed pick (Random seed first and highlighted), Enter seed opens the entry, Confirm on an empty entry is refused
// with a line saying why, 1 2 3 4 5 are typed with the digit keys, up adds a digit and Backspace takes it away, left / right move, Confirm starts the run:
// its seed is 12345. The run is ended like any run (history, counters). A second New Game with the default Random seed starts a run with a seed of its own.
// ============================================================================
function Scenario_StepSmokeSeed(_s) {
    var _gs = GameState_Get();
    var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _top = (_sc != noone && is_struct(_sc.title_stk)) ? Ui_StackTop(_sc.title_stk) : undefined;
    if (!variable_struct_exists(_s, "sd")) _s.sd = {};
    var _d = _s.sd;
    if (room == rm_start && _sc != noone && _sc.state == "boot_logo") _sc.state = "main";   // the logo is not what is checked here
    var _title_ready = (room == rm_start && _sc != noone && _sc.state == "main" && is_struct(_top) && !Transition_IsActive() && !Notice_IsOpen());
    var _ent = (_sc != noone) ? Title_SeedEntryOf(_sc) : undefined;
    switch (_s.step) {
        case 550:   // a clean profile that has seen the intro, then the title
            if (_s.t == 1) {
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP seed smoke (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_NoticeEnd();
                    break;
                }
                Dialogue_CloseNow();
                Scenario_ClearUi();
                RunSave_Delete();
                Profile_ResetForTest();
                Story_Mark(Story_CutsceneKey("intro"));
                _d.runs0 = Profile_Get().runs_started;
                Scenario_NoticeToTitle();
            }
            if (_s.t > 20 && _title_ready) Scenario_Next(_s, 551);
            if (_s.t > 900) { Scenario_Check("seed_smoke_reaches_the_title", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 551:   // New Game (no run is saved: one press) opens the seed pick
            if (_s.t == 1) {
                Scenario_Check("seed_smoke_the_cursor_starts_on_new_game", _top.cursor == 0 && _top.items[0].id == "new", "cursor=" + string(_top.cursor));
                Scenario_Tap("confirm");
            }
            if (_s.t > 8 && is_struct(_top) && _top.id == "seed_choice") {
                Scenario_Check("seed_smoke_new_game_opens_the_seed_pick", Ui_StackDepth(_sc.title_stk) == 2 && !is_struct(_sc.title_exit));
                Scenario_Check("seed_smoke_random_seed_is_the_first_row", _top.items[0].id == "random" && _top.items[0].label == Loc_T("seed.choice.random", "Random Seed"), "label=" + string(_top.items[0].label));
                Scenario_Check("seed_smoke_random_seed_is_highlighted", _top.cursor == 0, "cursor=" + string(_top.cursor));
                Scenario_Check("seed_smoke_enter_seed_is_the_second_row", _top.items[1].id == "enter" && _top.items[1].label == Loc_T("seed.choice.enter", "Enter Seed"));
                Scenario_Tap("menu_down");
                Scenario_Next(_s, 552);
            }
            if (_s.t > 300) { Scenario_Check("seed_smoke_new_game_opens_the_seed_pick", false, "room=" + room_get_name(room) + " exit=" + string(is_struct(_sc.title_exit))); Scenario_NoticeEnd(); }
            break;
        case 552:   // Down to Enter seed, Confirm: the entry screen opens, empty
            if (_s.t == 10) {
                Scenario_Check("seed_smoke_down_moves_to_enter_seed", _top.id == "seed_choice" && _top.cursor == 1, "cursor=" + string(_top.cursor));
                Scenario_Tap("confirm");
            }
            if (_s.t > 14 && is_struct(_ent)) {
                Scenario_Check("seed_smoke_enter_seed_opens_the_entry", true);
                Scenario_Check("seed_smoke_the_entry_starts_empty", SeedEntry_Text(_ent) == "" && !SeedEntry_CanConfirm(_ent));
                Scenario_Next(_s, 553);
            }
            if (_s.t > 300) { Scenario_Check("seed_smoke_enter_seed_opens_the_entry", false, "cursor=" + string(is_struct(_top) ? _top.cursor : -1)); Scenario_NoticeEnd(); }
            break;
        case 553:   // Confirm on the empty entry is refused; then 1 2 3 4 5 with the digit keys, up / Backspace / left / right, Confirm
            switch (_s.t) {
                case 12: Scenario_Tap("confirm"); break;
                case 18:
                    Scenario_Check("seed_smoke_an_empty_entry_is_refused", is_struct(_ent) && !is_struct(_sc.title_exit) && _sc.title_seed_msg, "msg=" + string(_sc.title_seed_msg));
                    break;
                case 22: Scenario_Tap("seed_d1"); break;
                case 26: Scenario_Tap("seed_d2"); break;
                case 30: Scenario_Tap("seed_d3"); break;
                case 34: Scenario_Tap("seed_d4"); break;
                case 38: Scenario_Tap("seed_d5"); break;
                case 44:
                    Scenario_Check("seed_smoke_the_digit_keys_type_12345", is_struct(_ent) && SeedEntry_Text(_ent) == "12345" && _ent.cur == 5, "text=" + (is_struct(_ent) ? SeedEntry_Text(_ent) : "none"));
                    Scenario_Check("seed_smoke_typing_clears_the_refusal_line", !_sc.title_seed_msg);
                    Scenario_Tap("menu_up");
                    break;
                case 50:
                    Scenario_Check("seed_smoke_up_adds_a_digit_on_the_blank_slot", is_struct(_ent) && SeedEntry_Text(_ent) == "123451", "text=" + (is_struct(_ent) ? SeedEntry_Text(_ent) : "none"));
                    Scenario_Tap("seed_back");
                    break;
                case 56:
                    Scenario_Check("seed_smoke_backspace_takes_it_away", is_struct(_ent) && SeedEntry_Text(_ent) == "12345" && _ent.cur == 5, "text=" + (is_struct(_ent) ? SeedEntry_Text(_ent) : "none"));
                    Scenario_Tap("menu_left");
                    break;
                case 62:
                    Scenario_Check("seed_smoke_left_moves_the_cursor", is_struct(_ent) && _ent.cur == 4, "cur=" + (is_struct(_ent) ? string(_ent.cur) : "none"));
                    Scenario_Tap("menu_right");
                    break;
                case 68:
                    Scenario_Check("seed_smoke_right_moves_it_back", is_struct(_ent) && _ent.cur == 5 && SeedEntry_CanConfirm(_ent), "cur=" + (is_struct(_ent) ? string(_ent.cur) : "none"));
                    Scenario_Tap("confirm");
                    break;
                case 74:
                    Scenario_Check("seed_smoke_confirm_starts_the_run_on_the_typed_seed", !is_struct(_ent) && (global.run_next_seed == 12345 || (Run_IsActive() && Run_Get().seed == 12345)));
                    Scenario_Next(_s, 554);
                    break;
            }
            break;
        case 554:   // the run is up: its seed is 12345, counted as a started run; it ends like any run
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1) && Run_IsActive()) {
                Scenario_Check("seed_smoke_the_run_has_the_typed_seed", Run_Get().seed == 12345, "seed=" + string(Run_Get().seed));
                Scenario_Check("seed_smoke_the_typed_seed_is_used_once", is_undefined(global.run_next_seed));
                Scenario_Check("seed_smoke_the_run_counts_as_started", Profile_Get().runs_started == _d.runs0 + 1, "runs_started=" + string(Profile_Get().runs_started));
                Scenario_Check("seed_smoke_the_status_line_says_the_seed", Seed_Label(Run_Get().seed) == "Seed: 12345");
                var _deaths0 = Profile_Get().deaths;
                Run_Finish("died", "seed smoke");
                var _hist = Profile_Get().history;
                Scenario_Check("seed_smoke_the_run_lands_in_the_history", array_length(_hist) >= 1 && _hist[array_length(_hist) - 1].seed == 12345);
                Scenario_Check("seed_smoke_a_seeded_death_counts", Profile_Get().deaths == _deaths0 + 1);
                Scenario_Check("seed_smoke_the_summary_shows_the_seed", Test_RowValue(RunFlow_SummaryRows(global.run_last), Loc_T("tab.lbl.seed", "Seed")) == "12345");
                Scenario_NoticeToTitle();
                Scenario_Next(_s, 555);
            }
            if (_s.t > 1500) { Scenario_Check("seed_smoke_the_seeded_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 555:   // the second path: New Game, and the pick's default row (Random seed) is taken
            if (_s.t > 20 && _title_ready) {
                Scenario_Tap("confirm");
                Scenario_Next(_s, 556);
            }
            if (_s.t > 900) { Scenario_Check("seed_smoke_reaches_the_title_again", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 556:
            if (_s.t > 8 && is_struct(_top) && _top.id == "seed_choice") {
                Scenario_Check("seed_smoke_random_seed_is_highlighted_again_after_using_enter_seed", _top.cursor == 0, "cursor=" + string(_top.cursor));
                if (current_time - _top.lock_ms >= UI_INPUT_LOCK_MS + 40) {
                    Scenario_Tap("confirm");
                    Scenario_Next(_s, 557);
                }
            }
            if (_s.t > 300) { Scenario_Check("seed_smoke_the_pick_opens_again", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 557:   // Random seed starts a run with a seed of its own
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1) && Run_IsActive()) {
                Scenario_Check("seed_smoke_random_seed_starts_a_run", Seed_IsValid(Run_Get().seed), "seed=" + string(Run_Get().seed));
                Scenario_Check("seed_smoke_random_seed_is_not_the_typed_one", Run_Get().seed != 12345);
                Scenario_Check("seed_smoke_the_pick_is_used_up", is_undefined(global.run_next_seed));
                Scenario_Check("seed_smoke_the_second_run_counts_too", Profile_Get().runs_started == _d.runs0 + 2, "runs_started=" + string(Profile_Get().runs_started));
                Scenario_Next(_s, 580);   // H11 (D153, 580..609) goes on; its last step ends the smoke chain
            }
            if (_s.t > 1500) { Scenario_Check("seed_smoke_the_random_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- H4 (D143) pictures 540-549: the free-point screen with the class growth line. shot_ui_levelup_stat_480x432.png (cursor on the class stat),
// shot_ui_levelup_stat_800x720.png (cursor on Max HP, so its help line is on screen), shot_ui_levelup_stat_ko_480x432.png (Korean, cursor on Max MP). ----
function Scenario_StepShotsLevelUp(_s) {
    var _gs = GameState_Get();
    switch (_s.step) {
        case 540:   // a Knight of a run, level 2, owing the point: the screen is opened by hand so no map or timing is involved
            if (_s.t == 1) {
                CardsUi_Close();
                Scenario_ClearUi();
                var _k = CharacterCreate_Player(CLASS_KNIGHT);
                _k.hp = _k.max_hp - 4;
                GameState_SetPlayer(_k);
                if (!Run_IsActive()) _gs.run = Run_Create(2469);
                GameState_SetPlayer(Player_AddExp(_gs.player_ch, _gs.player_ch.exp_next));
                _gs.player_ch.card_picks = 0;
                Scenario_SetWindowScale(3);
                Loc_SetLanguage("en");
            }
            if (_s.t == 30) {
                CardsUi_Open("stat");
                Scenario_Check("shots_levelup_the_free_point_screen_is_open", CardsUi_Kind() == "stat");
            }
            if (_s.t == 70) {
                var _ms = Ui_StackTop(global.cards_ui.stk);
                Scenario_Check("shots_levelup_the_growth_line_is_on_the_screen", _ms.layout.note == "Knight growth: ATK +1, DEF +1");
                Scenario_ShotUi(_s, "levelup_stat");
                Scenario_Next(_s, 541);
            }
            break;
        case 541:   // 800 x 720, the cursor on Max HP
            if (_s.t == 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_SetWindowScale(5);
                Ui_MenuFixCursor(Ui_StackTop(global.cards_ui.stk), 4);
            }
            if (_s.t == 60) {
                Scenario_Check("shots_levelup_the_cursor_is_on_max_hp", Ui_StackTop(global.cards_ui.stk).cursor == 4);
                Scenario_ShotUi(_s, "levelup_stat");
                Scenario_Next(_s, 542);
            }
            break;
        case 542:   // Korean at 480 x 432, the cursor on Max MP
            if (_s.t == 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_SetWindowScale(3);
                Loc_SetLanguage("ko");
                CardsUi_Close();
                CardsUi_Open("stat");
            }
            if (_s.t == 50) {
                Ui_MenuFixCursor(Ui_StackTop(global.cards_ui.stk), 5);
            }
            if (_s.t == 90) {
                Scenario_Check("shots_levelup_the_korean_screen_is_open", CardsUi_Kind() == "stat" && Ui_StackTop(global.cards_ui.stk).layout.note != "Knight growth: ATK +1, DEF +1");
                Scenario_ShotUi(_s, "levelup_stat_ko");
                Scenario_Next(_s, 543);
            }
            break;
        case 543:
            if (_s.t == 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Loc_SetLanguage("en");
                _gs.player_ch.stat_points = 0;
                _gs.player_ch.card_picks = 0;
                CardsUi_Close();
                Scenario_Next(_s, 490);   // H1 (D140, pictures 490..493) goes on; its last step ends the run (Scenario_Finish)
            }
            break;
    }
}

// ============================================================================
// H2 (D156): the one Yes / No pop-up, through real keys. Smoke steps 650-669 (the end of the chain: the last step calls Scenario_NoticeEnd).
//   650  System tab > Abandon run on the map: the first confirm only asks (cursor on No); confirming No closes it and the run goes on
//   651  System tab > Quit to title: asks; Esc is No; asks again; Up to Yes + confirm leaves for the title
//   652  the title with the run saved: New Game asks; No keeps the title and the save; Back too; then Continue
//   653  System tab > Abandon run again: No, then Yes: the run is abandoned (counts as a death), the death scene and the summary follow
// ============================================================================
function Scenario_StepSmokeConfirm(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "cf")) _s.cf = {};
    var _h = _s.cf;
    var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _u = TabMenu_Get();
    var _qa = "Abandon this run? It counts as a death, but you keep the echo.";
    var _qq = "Quit to title? The run is saved and Continue picks it up again.";
    var _qn = "Start a new game? The saved run will be abandoned.";
    switch (_s.step) {
        case 649:   // setup (merge order): the step before (H11, D153) ends in rm_floor3; the run goes on in rm_floor1, where the System tab asks about it
            if (_s.t == 1) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                room_goto(rm_floor1);
            }
            if (_s.t > 20 && Scenario_FloorReady(rm_floor1) && instance_exists(obj_player) && Player_IsSettled(instance_find(obj_player, 0))) Scenario_Next(_s, 650);
            if (_s.t > 600) { Scenario_Check("confirm_rm_floor1_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 650:   // Abandon run: the first confirm asks, No leaves the run alone
            if (_s.t == 1) {
                Scenario_ClearUi();
                _h.deaths0 = Profile_Get().deaths;
                _h.seed0 = Run_IsActive() ? _gs.run.seed : -1;
                Ui_MemSet(Ui_MemGlobal(), "tab_menu_active", 6);   // the menu opens on System
                Scenario_Tap("menu");
            }
            if (_s.t == 16) {
                Scenario_Check("confirm_the_menu_opens_on_system", _gs.ui.mode == UI_MENU && is_struct(_u) && TabMenu_Ids()[_u.tab] == "system", "mode=" + string(_gs.ui.mode));
                Scenario_Check("confirm_a_run_is_going", Run_IsActive());
                Ui_MenuFixCursor(TabMenu_TopMenu(), 0);   // the list remembers where it was left: start from Help
                Scenario_Tap("menu_down");
            }
            if (_s.t == 30) {
                var _tm = TabMenu_TopMenu();
                Scenario_Check("confirm_the_cursor_is_on_abandon", is_struct(_tm) && _tm.items[_tm.cursor].id == "abandon", "cursor=" + string(is_struct(_tm) ? _tm.cursor : -1));
                Scenario_Tap("confirm");
            }
            if (_s.t == 44) {
                Scenario_Check("confirm_abandon_opens_the_popup", Confirm_IsOpen(), "open=" + string(Confirm_IsOpen()));
                Scenario_Check("confirm_abandon_question", Confirm_IsOpen() && Confirm_Question() == _qa, Confirm_IsOpen() ? Confirm_Question() : "none");
                Scenario_Check("confirm_abandon_popup_starts_on_no", Confirm_IsOpen() && Confirm_Menu().cursor == 1);
                Scenario_Check("confirm_the_first_confirm_has_not_abandoned", Run_IsActive() && is_struct(_u) && _u.pending == "" && _u.closed_ms < 0 && _gs.ui.mode == UI_MENU);
                Scenario_Tap("confirm");   // No
            }
            if (_s.t == 58) {
                Scenario_Check("confirm_no_closes_the_popup", !Confirm_IsOpen());
                Scenario_Check("confirm_no_leaves_the_run_and_the_menu", Run_IsActive() && _gs.run.seed == _h.seed0 && is_struct(_u) && _u.pending == "" && _u.closed_ms < 0 && _gs.ui.mode == UI_MENU && Profile_Get().deaths == _h.deaths0, "deaths=" + string(Profile_Get().deaths));
                Scenario_Next(_s, 651);
            }
            break;
        case 651:   // Quit to title on the map: asks, Esc is No, asks again, Yes leaves
            if (_s.t == 1) Scenario_Tap("menu_down");
            if (_s.t == 14) {
                var _tm2 = TabMenu_TopMenu();
                Scenario_Check("confirm_the_cursor_is_on_quit", is_struct(_tm2) && _tm2.items[_tm2.cursor].id == "quit", "cursor=" + string(is_struct(_tm2) ? _tm2.cursor : -1));
                Scenario_Tap("confirm");
            }
            if (_s.t == 28) {
                Scenario_Check("confirm_quit_asks_first", Confirm_IsOpen() && Confirm_Question() == _qq && Confirm_Menu().cursor == 1 && room == rm_floor1, Confirm_IsOpen() ? Confirm_Question() : "none");
                Scenario_Check("confirm_quit_has_not_left", is_struct(_u) && _u.pending == "" && !_gs.in_main_menu);
                Scenario_Tap("esc");   // Esc is No
            }
            if (_s.t == 42) {
                Scenario_Check("confirm_esc_closes_the_popup_as_no", !Confirm_IsOpen() && is_struct(_u) && _u.pending == "" && _u.closed_ms < 0 && room == rm_floor1 && !_gs.in_main_menu && _gs.ui.mode == UI_MENU);
                Scenario_Tap("confirm");
            }
            if (_s.t == 56) {
                Scenario_Check("confirm_quit_asks_again", Confirm_IsOpen() && Confirm_Menu().cursor == 1);
                Scenario_Tap("menu_up");   // No -> Yes
            }
            if (_s.t == 70) {
                Scenario_Check("confirm_quit_popup_is_on_yes", Confirm_IsOpen() && Confirm_Menu().cursor == 0 && room == rm_floor1 && is_struct(_u) && _u.pending == "");
                Scenario_Tap("confirm");   // Yes
            }
            if (_s.t > 74 && room == rm_start && !Transition_IsActive()) {
                Scenario_Check("confirm_quit_yes_goes_to_the_title", _gs.in_main_menu && !is_struct(TabMenu_Get()) && !Confirm_IsOpen());
                Scenario_Check("confirm_quit_keeps_the_run_save", RunSave_HasSave());
                Scenario_Next(_s, 652);
            }
            if (_s.t > 600) { Scenario_Check("confirm_quit_reaches_the_title", false, "room=" + room_get_name(room) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 652:   // the title with the run saved: New Game asks; No and Back keep the title; Continue goes on
            if (room == rm_start && _sc != noone && !Transition_IsActive() && !variable_struct_exists(_h, "tt")) {
                if (_sc.state != "main") { _sc.state = "main"; break; }
                if (is_struct(_sc.title_stk) && _s.t > 20) {
                    _h.tt = _s.t;
                    Scenario_Check("confirm_the_title_cursor_is_on_continue", Ui_StackTop(_sc.title_stk).cursor == 1, "cursor=" + string(Ui_StackTop(_sc.title_stk).cursor));
                    Scenario_Tap("menu_up");
                }
            }
            if (!variable_struct_exists(_h, "tt")) {
                if (_s.t > 900) { Scenario_Check("confirm_the_title_is_reached", false, "room=" + room_get_name(room) + " state=" + ((_sc != noone) ? string(_sc.state) : "none")); Scenario_NoticeEnd(); }
                break;
            }
            var _k = _s.t - _h.tt;
            var _tm0 = (_sc != noone && is_struct(_sc.title_stk)) ? _sc.title_stk.menus[0] : undefined;
            if (_k == 14) {
                Scenario_Check("confirm_up_from_continue_is_new_game", is_struct(_tm0) && _tm0.cursor == 0 && _tm0.items[0].id == "new", "cursor=" + (is_struct(_tm0) ? string(_tm0.cursor) : "none"));
                Scenario_Tap("confirm");
            }
            if (_k == 28) {
                Scenario_Check("confirm_new_game_over_a_saved_run_asks", Confirm_IsOpen() && Confirm_Question() == _qn && Confirm_Menu().cursor == 1, Confirm_IsOpen() ? Confirm_Question() : "none");
                Scenario_Check("confirm_new_game_has_not_started", room == rm_start && !is_struct(_sc.title_exit) && RunSave_HasSave());
                Scenario_Tap("confirm");   // No
            }
            if (_k == 42) {
                Scenario_Check("confirm_no_stays_on_the_title", !Confirm_IsOpen() && room == rm_start && _sc.state == "main" && !is_struct(_sc.title_exit) && RunSave_HasSave() && !Transition_IsActive());
                Scenario_Tap("confirm");
            }
            if (_k == 56) {
                Scenario_Check("confirm_new_game_asks_again", Confirm_IsOpen() && Confirm_Menu().cursor == 1);
                Scenario_Tap("cancel");   // Back is No
            }
            if (_k == 70) {
                Scenario_Check("confirm_back_stays_on_the_title", !Confirm_IsOpen() && room == rm_start && _sc.state == "main" && !is_struct(_sc.title_exit) && RunSave_HasSave());
                Scenario_Tap("menu_down");
            }
            if (_k == 84) {
                Scenario_Check("confirm_down_is_continue_again", is_struct(_tm0) && _tm0.cursor == 1 && _tm0.items[1].id == "load");
                Scenario_Tap("confirm");
                _h.cont = _s.t;
            }
            if (variable_struct_exists(_h, "cont") && _s.t > _h.cont + 10 && Scenario_FloorReady(rm_floor1) && !_gs.load_spawn_pending) {
                Scenario_Check("confirm_continue_brings_the_run_back", Run_IsActive() && _gs.run.seed == _h.seed0, "seed=" + (Run_IsActive() ? string(_gs.run.seed) : "no run"));
                Scenario_Next(_s, 653);
            }
            if (_s.t > _h.tt + 900) { Scenario_Check("confirm_continue_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 653:   // Abandon run: No, then Yes; the run is abandoned and counts as a death
            if (_s.t == 30) {
                Scenario_ClearUi();
                Scenario_Tap("menu");
            }
            if (_s.t == 44) {
                Scenario_Check("confirm_the_menu_opens_again_on_system", _gs.ui.mode == UI_MENU && is_struct(_u) && TabMenu_Ids()[_u.tab] == "system", "mode=" + string(_gs.ui.mode));
                Ui_MenuFixCursor(TabMenu_TopMenu(), 0);
                Scenario_Tap("menu_down");
            }
            if (_s.t == 58) Scenario_Tap("confirm");
            if (_s.t == 72) {
                Scenario_Check("confirm_abandon_asks_again", Confirm_IsOpen() && Confirm_Question() == _qa && Confirm_Menu().cursor == 1 && Run_IsActive());
                Scenario_Tap("confirm");   // No
            }
            if (_s.t == 86) {
                Scenario_Check("confirm_no_still_in_the_run", !Confirm_IsOpen() && Run_IsActive() && Profile_Get().deaths == _h.deaths0 && is_struct(_u) && _u.pending == "");
                Scenario_Tap("confirm");
            }
            if (_s.t == 100) {
                Scenario_Check("confirm_abandon_asks_a_third_time", Confirm_IsOpen() && Confirm_Menu().cursor == 1);
                Scenario_Tap("menu_up");   // No -> Yes
            }
            if (_s.t == 114) {
                Scenario_Check("confirm_abandon_popup_is_on_yes", Confirm_IsOpen() && Confirm_Menu().cursor == 0 && Run_IsActive());
                Scenario_Tap("confirm");   // Yes
            }
            if (_s.t > 118) Scenario_TapCutscene(_s);
            if (_s.t > 118 && _sc != noone && _sc.state == "run_flow") {
                var _pf = Profile_Get();
                Scenario_Check("confirm_yes_abandons_and_counts_as_a_death", _pf.deaths == _h.deaths0 + 1, "deaths=" + string(_pf.deaths) + " was " + string(_h.deaths0));
                Scenario_Check("confirm_history_says_abandoned", array_length(_pf.history) >= 1 && _pf.history[array_length(_pf.history) - 1].result == "abandoned");
                Scenario_Check("confirm_abandon_deletes_the_run_save", !RunSave_HasSave() && !Run_IsActive());
                Scenario_Check("confirm_the_popup_is_gone_after_yes", !Confirm_IsOpen());
                Scenario_NoticeToTitle();   // the run is over: back to a clean title, then H6 (D146, 620..639) goes on; its last step ends the smoke chain
                Scenario_Next(_s, 620);
            }
            if (_s.t > 1500) { Scenario_Check("confirm_abandon_reaches_the_run_summary", false, "room=" + room_get_name(room) + " state=" + ((_sc != noone) ? string(_sc.state) : "none") + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
    }
}

// ============================================================================
// H5 (D144, D148): the class screen and the echo of discovered skills, through real keys (smoke steps 750-769, the end of the chain). Writes the real
// profile.sav / run.sav: only inside the gate (Scenario_CanSaveSlot).
//   750-752  a fresh profile: the class screen reads ??? for every skill, Knight is picked, the echo screen never opens and the run goes on
//   753-757  a profile that knows two Knight skills and one Mage skill: the class screen names them; Knight picked; the echo offers exactly the two Knight
//            skills (no Mage skill, no item); the first is taken and is in the deck. The last step ends the run.
// ============================================================================
function Scenario_ClassMemNames(_row) {
    var _out = [];
    for (var _i = 0; _i < array_length(_row.skills); _i++) array_push(_out, _row.skills[_i].label);
    return _out;
}

function Scenario_ClassMemCount(_names, _what) {
    var _n = 0;
    for (var _i = 0; _i < array_length(_names); _i++) { if (_names[_i] == _what) _n++; }
    return _n;
}

function Scenario_StepSmokeClassMem(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "cm")) _s.cm = { q: [], chest: noone, ever_echo: false, take: -1 };
    var _cm = _s.cm;
    var _ch = _gs.player_ch;
    var _second = (_s.step >= 753);
    var _tag = _second ? "known" : "fresh";
    Scenario_CardsTapQueue(_s, _cm);
    if (CardsUi_Kind() == "echo") _cm.ever_echo = true;
    switch (_s.step) {
        case 750:   // a clean profile and a new run
        case 753:   // a profile that knows two Knight skills and one Mage skill, and a new run
            if (_s.t == 1) {
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP skill memory class screen (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_NoticeEnd();
                    break;
                }
                if (Transition_IsActive()) { _s.t = 0; break; }
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Profile_ResetForTest();
                if (_second) {
                    Skill_Discover(SKILL_WOUND);
                    Skill_Discover(SKILL_HILT_BASH);
                    Skill_Discover(SKILL_FIREBALL);
                }
                RunSave_Delete();
                _gs.in_main_menu = false;
                Run_StartNew(false, _second ? 7502 : 7501);
                _cm.ever_echo = false;
                _cm.q = [];
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1)) {
                _gs.pending_wake_line = false;
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_Check("classmem_a_new_run_is_owed_nothing_" + _tag, Cards_NextOwed(_gs.player_ch) == "" && array_length(_gs.player_ch.echo_offer) == 0);
                if (_second) Scenario_Check("classmem_the_profile_remembers_three_skills", array_length(variable_struct_get_names(Profile_Get().skills_known)) == 3 && Profile_SkillKnown(Profile_Get(), SKILL_HILT_BASH));
                else Scenario_Check("classmem_a_fresh_profile_remembers_no_skill", array_length(variable_struct_get_names(Profile_Get().skills_known)) == 0);
                Scenario_Next(_s, _s.step + 1);
            }
            if (_s.t > 900) { Scenario_Check("classmem_a_new_run_reaches_rm_floor1_" + _tag, false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 751:   // the class chest: the class screen opens (fresh: every skill reads ???; known: the discovered ones show by name)
        case 754:
            if (_s.t == 1) {
                Scenario_ClearUi();
                Scenario_CardsChest(_cm, obj_chest_class_select, "h5_chest_class_" + _tag);
            }
            if (_s.t == 20) Scenario_Tap("interact");
            Scenario_CardsTalk(_s);
            if (_s.t > 30 && CardsUi_Kind() == "class" && InputLock_Settled(global.cards_ui.lock, 4 * TRANSITION_FRAME_MS)) {
                var _m = Ui_StackTop(global.cards_ui.stk);
                var _kn = Scenario_ClassMemNames(_m.items[0]);
                var _ar = Scenario_ClassMemNames(_m.items[1]);
                var _mg = Scenario_ClassMemNames(_m.items[2]);
                Scenario_Check("classmem_the_class_screen_is_up_" + _tag, _gs.ui.mode == UI_CARDS && _m.id == "cards_class" && _m.cursor == 0);
                Scenario_Check("classmem_every_class_row_has_a_sprite_" + _tag, sprite_exists(_m.items[0].pic.spr) && sprite_exists(_m.items[1].pic.spr) && sprite_exists(_m.items[2].pic.spr) && sprite_exists(_m.items[3].pic.spr));
                Scenario_Check("classmem_nobody_is_greyed_" + _tag, _m.items[3].locked && _m.items[3].dim);
                if (!_second) {
                    Scenario_Check("classmem_a_fresh_profile_shows_only_question_marks", Scenario_ClassMemCount(_kn, "???") == 5 && Scenario_ClassMemCount(_ar, "???") == 5 && Scenario_ClassMemCount(_mg, "???") == 5, "knight=" + json_stringify(_kn));
                } else {
                    Scenario_Check("classmem_the_known_knight_skills_show_by_name", array_contains(_kn, SkillDB_GetBase(SKILL_WOUND).name) && array_contains(_kn, SkillDB_GetBase(SKILL_HILT_BASH).name) && !array_contains(_kn, SkillDB_GetBase(SKILL_FIREBALL).name), "knight=" + json_stringify(_kn));
                    Scenario_Check("classmem_the_other_knight_skills_stay_question_marks", array_length(_kn) == 5 && Scenario_ClassMemCount(_kn, "???") == 3);
                    Scenario_Check("classmem_the_mage_shows_its_known_skill", array_contains(_mg, SkillDB_GetBase(SKILL_FIREBALL).name) && Scenario_ClassMemCount(_mg, "???") == 4, "mage=" + json_stringify(_mg));
                    Scenario_Check("classmem_the_archer_shows_only_the_shared_wound", array_contains(_ar, SkillDB_GetBase(SKILL_WOUND).name) && Scenario_ClassMemCount(_ar, "???") == 4, "archer=" + json_stringify(_ar));
                }
                _cm.q = ["confirm", "menu_up", "confirm"];   // the Knight is first; confirm; the pop-up opens on No: up to Yes; confirm
                Scenario_Next(_s, _s.step + 1);
            }
            if (_s.t > 900) { Scenario_Check("classmem_the_class_chest_opens_the_class_screen_" + _tag, false, "kind=" + CardsUi_Kind() + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 752:   // fresh: Knight asked about, Yes: the class is applied behind the flash, its chest line read; the echo never opens
        case 755:   // known: the same, and the echo screen opens by itself
            if (array_length(_cm.q) == 2 && !variable_struct_exists(_cm, "asked_" + _tag) && (_s.f - _s.last_tap) >= 6) {
                variable_struct_set(_cm, "asked_" + _tag, true);
                Scenario_Check("classmem_the_knight_is_asked_about_" + _tag, Confirm_IsOpen() && Confirm_Menu().cursor == 1 && CardsUi_Kind() == "class");
            }
            var _talk = Scenario_CardsTalk(_s);
            if (!_second) {
                if (_ch.class_id == CLASS_KNIGHT && _ch.class_chosen && !_talk && !Transition_IsActive() && !CardsUi_IsOpen() && _gs.ui.mode == UI_NONE && _s.t > 90) {
                    Scenario_Check("classmem_the_class_is_a_knight", _ch.class_id == CLASS_KNIGHT && _gs.selected_class == CLASS_KNIGHT);
                    Scenario_Check("classmem_a_class_without_discovered_skills_opens_no_echo", !_cm.ever_echo && Cards_NextOwed(_ch) == "" && array_length(_ch.echo_offer) == 0);
                    Scenario_Check("classmem_the_run_goes_on", Run_IsActive() && room == rm_floor1 && array_length(_ch.skills) == 0);
                    Scenario_Next(_s, 753);
                }
            } else if (CardsUi_Kind() == "echo" && InputLock_Settled(global.cards_ui.lock, 4 * TRANSITION_FRAME_MS)) {
                var _em = Ui_StackTop(global.cards_ui.stk);
                var _ids = [];
                for (var _i = 0; _i < array_length(_ch.echo_offer); _i++) array_push(_ids, (_ch.echo_offer[_i].kind == "skill") ? _ch.echo_offer[_i].id : -99);
                Scenario_Check("classmem_the_class_is_a_knight_again", _ch.class_id == CLASS_KNIGHT && _ch.class_chosen);
                Scenario_Check("classmem_the_echo_screen_opens_after_the_class_pick", _gs.ui.mode == UI_CARDS && _em.id == "run_echo");
                Scenario_Check("classmem_the_echo_offers_exactly_the_two_known_knight_skills", array_length(_em.items) == 2 && array_length(_ids) == 2 && array_contains(_ids, SKILL_WOUND) && array_contains(_ids, SKILL_HILT_BASH), "offer=" + json_stringify(_ch.echo_offer));
                Scenario_Check("classmem_the_echo_offers_no_mage_skill_and_no_item", !array_contains(_ids, SKILL_FIREBALL) && !array_contains(_ids, -99));
                _cm.take = _ch.echo_offer[0].id;
                _cm.q = ["confirm", "menu_up", "confirm"];   // the first row; the pop-up opens on No: up to Yes; confirm
                Scenario_Next(_s, 756);
            }
            if (_s.t > 1500) { Scenario_Check("classmem_the_class_pick_goes_on_" + _tag, false, "class=" + string(_ch.class_id) + " kind=" + CardsUi_Kind() + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 756:   // the pick asks; Yes: the skill is in the deck and nothing is owed any more
            if (array_length(_cm.q) == 2 && !variable_struct_exists(_cm, "asked2") && (_s.f - _s.last_tap) >= 6) {
                _cm.asked2 = true;
                Scenario_Check("classmem_the_echo_pick_asks_first", Confirm_IsOpen() && Confirm_Menu().cursor == 1 && CardsUi_Kind() == "echo");
                Scenario_Check("classmem_the_skill_is_not_in_the_deck_before_yes", array_length(_ch.skills) == 0);
            }
            if (array_length(_cm.q) == 0 && !CardsUi_IsOpen() && _s.t > 20) {
                Scenario_Check("classmem_the_echo_skill_is_in_the_deck", array_length(_ch.skills) == 1 && _ch.skills[0] == _cm.take, "skills=" + json_stringify(_ch.skills) + " take=" + string(_cm.take));
                Scenario_Check("classmem_the_other_offer_is_gone_and_nothing_is_owed", array_length(_ch.echo_offer) == 0 && Cards_NextOwed(_ch) == "");
                Scenario_Check("classmem_the_run_remembers_the_echo", _gs.run.echo_used.kind == "skill" && _gs.run.echo_used.id == _cm.take);
                Scenario_Check("classmem_taking_it_leaves_the_memory_as_it_was", array_length(variable_struct_get_names(Profile_Get().skills_known)) == 3);
                Scenario_Check("classmem_no_item_pool_was_made", array_length(Profile_Get().echo_pool) == 0);
                Scenario_Next(_s, 757);
            }
            if (_s.t > 600) { Scenario_Check("classmem_the_echo_pick_answers", false, "open=" + string(CardsUi_IsOpen()) + " q=" + string(array_length(_cm.q))); Scenario_NoticeEnd(); }
            break;
        case 757:   // the end of the run: the profile on disk holds the memory
            if (_s.t == 2) {
                var _disk = Profile_Load(Profile_Path());
                Scenario_Check("classmem_the_profile_file_holds_the_memory", _disk.status == "ok" && _disk.profile.profile_version == 2 && Profile_SkillKnown(_disk.profile, SKILL_WOUND) && Profile_SkillKnown(_disk.profile, SKILL_HILT_BASH) && Profile_SkillKnown(_disk.profile, SKILL_FIREBALL));
                Scenario_Next(_s, 890);   // goes on with H12a (890..909), then H13a (790..), the end of the chain
            }
            break;
    }
}

// ---- H1 (D140) pictures 490..493: the System tab, the Settings tab and the "Keep this?" prompt at windowed scale 3 (480 x 432) and 5 (800 x 720).
// Each is the real draw of the real menu on a real room; the layout is asserted on the rectangles. The chain goes on with H2's pictures 670..673. ----
function Scenario_OneMenuShotScenes() {
    return ["system", "settings", "keep"];
}

function Scenario_StepShotsOneMenu(_s) {
    var _scenes = Scenario_OneMenuShotScenes();
    var _scales = [3, 5];
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "om")) _s.om = { n: 0, di: 0, si: 0 };
    var _o = _s.om;
    switch (_s.step) {
        case 490:   // enter a room at this scale (the two floors take turns: entering the room we are in would not spawn the player again)
            if (_s.t == 1) {
                Scenario_TabFixture();
                Loc_SetLanguage("en");
                Scenario_SetWindowScale(_scales[_o.si]);
                _o.n++;
                room_goto((_o.n mod 2 == 1) ? rm_floor2 : rm_floor3);
            }
            if (_s.t >= 30 && Scenario_FloorReady((_o.n mod 2 == 1) ? rm_floor2 : rm_floor3)) Scenario_Next(_s, 491);
            if (_s.t > 600) { Scenario_Check("shots_onemenu_enters_the_room", false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 491:   // set the scene up
            with (obj_enemy) instance_destroy();
            Scenario_ClearUi();
            switch (_scenes[_o.di]) {
                case "system":
                    Menu_Open(6);
                    Ui_MenuFixCursor(TabMenu_TopMenu(), 2);   // Quit to title, with its help sentence
                    break;
                case "settings":
                    Menu_Open(5);
                    Ui_MenuFixCursor(TabMenu_TopMenu(), 7);   // the Window row
                    break;
                case "keep":
                    Menu_Open(5);
                    Ui_MenuFixCursor(TabMenu_TopMenu(), 7);
                    var _ks = GameSettings_Copy(GameSettings_Ensure());
                    _ks.window_mode = WINDOW_MODE_WINDOWED;
                    _ks.display_scale = _scales[_o.si];   // the setting says the scale the window is at, so the change does not resize it
                    _gs.settings = _ks;
                    Settings_Change("window", 1, 5);   // Borderless asks "Keep this?" (a test run keeps its own window as it is)
                    SettingsPopup_Refresh();
                    break;
            }
            Scenario_Next(_s, 492);
            break;
        case 492:   // let the panels slide in, check the layout, take the picture
            if (_s.t >= 24) {
                var _tag = _scenes[_o.di] + "_" + string(_scales[_o.si]);
                Scenario_Check("shots_onemenu_open_" + _tag, _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()), "mode=" + string(_gs.ui.mode));
                Scenario_Check("shots_onemenu_has_seven_tabs_" + _tag, array_length(TabMenu_Labels()) == 7 && global.ui_tabs_rects[6].x + global.ui_tabs_rects[6].w <= Display_GuiW());
                Scenario_TabLayoutChecks(_tag);
                if (_scenes[_o.di] == "keep") {
                    var _kr = variable_global_exists("keep_this_rect") ? global.keep_this_rect : { x: -1, y: -1, w: 0, h: 0 };
                    Scenario_Check("shots_onemenu_the_prompt_is_up_" + _tag, KeepThis_Active());
                    Scenario_Check("shots_onemenu_the_prompt_is_on_screen_" + _tag, _kr.w > 0 && _kr.x >= 0 && _kr.y >= 0 && _kr.x + _kr.w <= Display_GuiW() && _kr.y + _kr.h <= Display_GuiH(), json_stringify(_kr));
                }
                _s.shot = "shot_onemenu_" + _scenes[_o.di] + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 493);
            }
            break;
        case 493:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                if (KeepThis_Active()) KeepThis_Revert();
                if (is_struct(TabMenu_Get())) Menu_Close(true);
                Scenario_ClearUi();
                _o.si++;
                if (_o.si >= array_length(_scales)) { _o.si = 0; _o.di++; }
                if (_o.di >= array_length(_scenes)) {
                    _o.si = 0;
                    _o.di = 0;
                    _s.si = 0;
                    _s.di = 0;
                    Scenario_Next(_s, 570);   // H10 (D152): the seed pick and entry pictures (570..579) finish the run
                } else {
                    Scenario_Next(_s, 490);
                }
            }
            break;
    }
}

// ---- H10 (D152) pictures 570..572: the seed pick and the entry screen at windowed scale 3 (480 x 432) and 5 (800 x 720), and the entry in Korean at scale 3.
// Each is the real draw of the real title screen; the layout is asserted on the rectangles. Files shot_seed_<scene>_<w>x<h>.png. Ends the shots run. ----
function Scenario_SeedScenes() {
    return ["choice", "entry", "entry_ko"];
}

function Scenario_SeedScales(_di) {
    return (_di == 2) ? [3] : [3, 5];
}

function Scenario_StepShotsSeed(_s) {
    var _scenes = Scenario_SeedScenes();
    var _scales = Scenario_SeedScales(_s.di);
    var _sc = _scenes[_s.di];
    var _tag = _sc + "_" + string(_scales[_s.si]);
    var _c = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _gs = GameState_Get();
    switch (_s.step) {
        case 570:   // the title at this scale, then the pick (or the entry with 1 2 3 4 5 typed) opened over it
            if (_s.t == 1) {
                Scenario_ClearUi();
                Notice_Interrupt();
                Loc_SetLanguage("en");
                Scenario_SetWindowScale(_scales[_s.si]);
                RunSave_Delete();
                _gs.in_main_menu = true;
                _gs.startup_logo_seen = true;
                room_goto(rm_start);
            }
            if (_s.t >= 40 && room == rm_start && _c != noone && !Transition_IsActive() && _c.state == "main" && is_struct(_c.title_stk)) {
                if (_sc == "entry_ko") Loc_SetLanguage("ko");
                Title_SeedChoiceOpen(_c);
                if (_sc != "choice") {
                    Title_SeedChoiceConfirm(Ui_StackTop(_c.title_stk), 1);
                    for (var _k = 1; _k <= 5; _k++) SeedEntry_Type(_c.title_seed, _k);
                }
                Scenario_Next(_s, 571);
            }
            if (_s.t > 900) { Scenario_Check("shots_seed_reaches_the_title_" + _tag, false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 571:   // wait until the panel is in, assert the layout, take the picture
            var _mt = Ui_Metrics();
            var _p = _mt.p;
            var _ready = (_sc == "choice") ? (Ui_MenuAlpha(Ui_StackTop(_c.title_stk), current_time) >= 1) : (is_struct(Title_SeedEntryOf(_c)) && Ui_AnimT(_c.title_seed_t, current_time) >= 1 && variable_instance_exists(_c, "title_seed_rects"));
            if (_ready) {
                if (_sc == "choice") {
                    var _top = Ui_StackTop(_c.title_stk);
                    var _r = _top.rect;
                    Scenario_Check("shots_seed_pick_is_inside_the_gui_" + _tag, _r.w > 0 && _r.x >= 0 && _r.y >= 0 && _r.x + _r.w <= _mt.gw && _r.y + _r.h <= _mt.gh, json_stringify(_r));
                    Scenario_Check("shots_seed_pick_has_random_first_and_lit_" + _tag, _top.id == "seed_choice" && _top.cursor == 0 && _top.items[0].id == "random");
                    Scenario_Check("shots_seed_pick_hides_the_continue_card_" + _tag, Ui_StackDepth(_c.title_stk) == 2);
                } else {
                    var _rc = _c.title_seed_rects;
                    var _pn = _rc.panel;
                    Scenario_Check("shots_seed_entry_is_inside_the_gui_" + _tag, _pn.x >= 0 && _pn.y >= 0 && _pn.x + _pn.w <= _mt.gw && _pn.y + _pn.h <= _mt.gh, json_stringify(_pn));
                    var _cells_ok = (array_length(_rc.cells) == SEED_DIGITS_MAX);
                    for (var _i = 0; _i < array_length(_rc.cells); _i++) {
                        var _ce = _rc.cells[_i];
                        if (_ce.x < _pn.x + 2 * _p || _ce.x + _ce.w > _pn.x + _pn.w - 2 * _p || _ce.y < _pn.y || _ce.y + _ce.h > _pn.y + _pn.h) _cells_ok = false;
                        if (_i > 0 && _rc.cells[_i - 1].x + _rc.cells[_i - 1].w > _ce.x) _cells_ok = false;
                    }
                    Scenario_Check("shots_seed_entry_cells_fit_the_panel_in_one_row_" + _tag, _cells_ok, json_stringify(_rc.cells[0]));
                    Scenario_Check("shots_seed_entry_hint_fits_the_panel_" + _tag, _rc.hint_y + _rc.hint_h <= _pn.y + _pn.h - 3 * _p, "hint " + string(_rc.hint_y) + "+" + string(_rc.hint_h) + " panel " + json_stringify(_pn));
                    Scenario_Check("shots_seed_entry_shows_12345_" + _tag, SeedEntry_Text(_c.title_seed) == "12345" && _c.title_seed.cur == 5);
                }
                _s.shot = "shot_seed_" + _sc + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 572);
            }
            if (_s.t > 600) { Scenario_Check("shots_seed_scene_is_ready_" + _tag, false, "state=" + ((_c != noone) ? string(_c.state) : "none")); Scenario_Finish(); }
            break;
        case 572:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                _s.si++;
                if (_s.si >= array_length(_scales)) { _s.si = 0; _s.di++; }
                if (_s.di >= array_length(_scenes)) {
                    Loc_SetLanguage("en");
                    RunSave_Delete();
                    Scenario_Next(_s, 610);   // H11 (D153, pictures 610..614) finish the run
                } else {
                    Scenario_Next(_s, 570);
                }
            }
            break;
    }
}

// ---- H2 (D156) pictures 670..673: the shared Yes / No pop-up over the System tab (Abandon run), over the title (New Game with a run saved) and in Korean
// over the System tab, at windowed scale 3 (480 x 432) and 5 (800 x 720). Each is the real draw of the real screen; the pop-up is asserted on its rectangles
// (on screen, centred, the two rows inside it, the cursor on No). Files shot_confirm_<scene>_<w>x<h>.png. The title scene writes the real run.sav
// (the gate's scratch folder only). The last picture of the chain goes on with H5's 770..773. ----
function Scenario_ConfirmShotScenes() {
    return ["system", "title", "korean"];
}

function Scenario_StepShotsConfirm(_s) {
    var _scenes = Scenario_ConfirmShotScenes();
    var _scales = [3, 5];
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "cfm")) _s.cfm = { di: 0, si: 0, n: 0 };
    var _o = _s.cfm;
    var _sc = _scenes[_o.di];
    var _tag = _sc + "_" + string(_scales[_o.si]);
    var _c = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    switch (_s.step) {
        case 670:   // the room and the window scale of this picture
            if (_s.t == 1) {
                if (_sc == "title" && !Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP confirm title shot " + _tag + " (LOCALAPPDATA is not the gate scratch folder)");
                    _s.shot = "";
                    Scenario_Next(_s, 673);
                    break;
                }
                Scenario_ClearUi();
                Confirm_Close();
                Loc_SetLanguage("en");
                Scenario_SetWindowScale(_scales[_o.si]);
                if (_sc == "title") {
                    RunSave_Delete();
                    Scenario_TitleRunFile();
                    _gs.in_main_menu = true;
                    _gs.startup_logo_seen = true;
                    room_goto(rm_start);
                } else {
                    Scenario_TabFixture();
                    _o.n++;
                    room_goto((room == rm_floor3) ? rm_floor2 : rm_floor3);
                }
            }
            if (_s.t >= 40 && _sc == "title" && room == rm_start && _c != noone && _c.state == "main" && is_struct(_c.title_stk) && !Transition_IsActive() && Ui_MenuAlpha(_c.title_stk.menus[0], current_time) >= 1) Scenario_Next(_s, 671);
            if (_s.t >= 30 && _sc != "title" && (room == rm_floor2 || room == rm_floor3) && Scenario_FloorReady(room)) Scenario_Next(_s, 671);
            if (_s.t > 900) { Scenario_Check("shots_confirm_reaches_the_room_" + _tag, false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 671:   // open the pop-up the way the game does
            if (_sc == "title") {
                var _tm = _c.title_stk.menus[0];
                Ui_MenuFixCursor(_tm, 0);
                Title_OnConfirm(_tm, 0);
            } else {
                with (obj_enemy) instance_destroy();
                Scenario_ClearUi();
                if (_sc == "korean") Loc_SetLanguage("ko");
                Menu_Open(6);
                Ui_MenuFixCursor(TabMenu_TopMenu(), 1);   // Abandon run
                TabMenu_OnConfirm(TabMenu_TopMenu(), 1);
            }
            Scenario_Next(_s, 672);
            break;
        case 672:   // let it slide in, check the layout, take the picture
            if (_s.t >= 24) {
                var _mt = Ui_Metrics();
                var _r = variable_global_exists("confirm_rect") ? global.confirm_rect : { x: -1, y: -1, w: 0, h: 0 };
                Scenario_Check("shots_confirm_is_open_" + _tag, Confirm_IsOpen());
                Scenario_Check("shots_confirm_cursor_is_on_no_" + _tag, Confirm_IsOpen() && Confirm_Menu().cursor == 1);
                Scenario_Check("shots_confirm_is_on_screen_" + _tag, _r.w > 0 && _r.x >= 0 && _r.y >= 0 && _r.x + _r.w <= _mt.gw && _r.y + _r.h <= _mt.gh, json_stringify(_r));
                Scenario_Check("shots_confirm_is_centred_" + _tag, abs((_r.x + _r.w / 2) - _mt.gw / 2) <= _mt.p && abs((_r.y + _r.h / 2) - _mt.gh / 2) <= 2 * _mt.p, json_stringify(_r));
                var _rows_ok = Confirm_IsOpen() && array_length(Confirm_Menu().rects) == 2;
                if (_rows_ok) {
                    for (var _i = 0; _i < 2; _i++) {
                        var _rr = Confirm_Menu().rects[_i];
                        _rows_ok = _rows_ok && _rr.w > 0 && _rr.x >= _r.x && _rr.y >= _r.y && _rr.x + _rr.w <= _r.x + _r.w && _rr.y + _rr.h <= _r.y + _r.h;
                    }
                }
                Scenario_Check("shots_confirm_rows_are_inside_the_box_" + _tag, _rows_ok);
                if (_sc != "title") Scenario_Check("shots_confirm_the_menu_stays_open_behind_" + _tag, _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()));
                if (_sc == "korean") Scenario_Check("shots_confirm_question_is_korean_" + _tag, Loc_GetLanguage() == "ko" && Confirm_Question() != "Abandon this run? It counts as a death, but you keep the echo.", Confirm_Question());
                _s.shot = "shot_confirm_" + _sc + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 673);
            }
            break;
        case 673:
            if (_s.t >= 3) {
                if (_s.shot != "") Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Confirm_Close();
                if (is_struct(TabMenu_Get())) Menu_Close(true);
                Scenario_ClearUi();
                _o.si++;
                if (_o.si >= array_length(_scales)) { _o.si = 0; _o.di++; }
                if (_o.di >= array_length(_scenes)) {
                    Loc_SetLanguage("en");
                    RunSave_Delete();
                    _s.cs_i = 0;
                    Scenario_Next(_s, 640);   // H6 (D146, D156, pictures 640..644) finish the run
                } else {
                    Scenario_Next(_s, 670);
                }
            }
            break;
    }
}

// ============================================================================
// H11 (D153, D158), smoke steps 580..609 (rm_floor3, the game's own input state; the enemies are stood still on purpose, the checks are about what they notice).
//   580-583: a slime (sight cut to 1 tile, so only its ears count) at (12,6): RUNNING 5 tiles away does not move it, WALKING 4 tiles away does not, RUNNING within 4 does.
//   584-585: the player is gone: it walks to the cell it heard him last, searches 4 tiles down the way he ran, raises ONE "?", walks home.
//   586-588: a dire wolf 2 tiles from the hiding cell (3,4): the player stands still there, no "!" and no battle; one step off the cell and the wolf spots him.
//   589-592: a spider put next to the exit chased to: the player leaves and comes back, the spider is 4 tiles from the exit, nobody within 3 tiles of the arrival tile.
// ============================================================================
function Scenario_H11Enemy(_obj, _cx, _cy, _sight, _face = -1) {
    var _e = instance_create_layer(_cx * GRID_TILE_SIZE, _cy * GRID_TILE_SIZE, "Instances", _obj);
    EnemyAI_Init(_e);
    Scenario_PlaceEnemy(_e, _cx, _cy);
    if (_sight >= 0) _e.prof.sight = _sight;
    _e.idle_timer = 100000;   // it stays where it is until it has a reason to move
    _e.turn_timer = 100000;   // D179: and keeps the way it faces (a cone has a front); _face -1 leaves the facing it was given
    if (_face >= 0) _e.look_dir = _face;
    return _e;
}

function Scenario_H11Cell(_inst) {
    return { cx: Nav_CellOf(_inst.x + GRID_TILE_SIZE / 2), cy: Nav_CellOf(_inst.y + GRID_TILE_SIZE / 2) };
}

function Scenario_StepSmokeH11(_s) {
    if (!variable_struct_exists(_s, "h11")) _s.h11 = { };
    var _h = _s.h11;
    var _T = GRID_TILE_SIZE;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _e = (variable_struct_exists(_h, "e") && instance_exists(_h.e)) ? _h.e : noone;
    switch (_s.step) {
        case 580:   // the slime at (12,6); the player at (7,7), RUNNING up the column 5 tiles away (rm_floor3 has a note at (6,6))
            if (!variable_struct_exists(_h, "went") && room != rm_floor3) {   // the step before (H10, D152) ends in rm_floor1 with a run on a random seed
                _h.went = true;
                Dialogue_CloseNow();
                Scenario_ClearUi();
                room_goto(rm_floor3);
                break;
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                _h.e = Scenario_H11Enemy(obj_slime, 12, 6, 1);
                Scenario_PlacePlayer(7, 7);
                _h.y0 = _pl.y;
                _h.ran = false;
                Scenario_Hold("move_up", 40);
                Scenario_Hold("run", 40);
                Scenario_Next(_s, 581);
            }
            if (_s.t > 300) { Scenario_Check("h11_rm_floor3_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 581:   // judged after the run; then WALKING at 4 tiles
            if (_pl.moving && _pl.step_speed > _pl.walk_speed) _h.ran = true;
            if (_e != noone && _e.ai_mode != "idle" && !variable_struct_exists(_h, "a1_bad")) _h.a1_bad = _e.ai_mode;
            if (_s.t >= 48) {
                Scenario_Release();
                Scenario_Check("h11_the_player_ran_at_least_two_tiles", _h.ran && _pl.y <= _h.y0 - 2 * _T, "y=" + string(_pl.y) + " from " + string(_h.y0));
                Scenario_Check("h11_running_5_tiles_away_is_not_heard", !variable_struct_exists(_h, "a1_bad"), "mode=" + (variable_struct_exists(_h, "a1_bad") ? _h.a1_bad : ""));
                Scenario_PlacePlayer(8, 6);   // 4 tiles from (12,6), in line
                _h.y0 = _pl.y;
                Scenario_Hold("move_down", 40);
                Scenario_Next(_s, 582);
            }
            break;
        case 582:   // WALKING 4 tiles away: silent
            if (_e != noone && _e.ai_mode != "idle" && !variable_struct_exists(_h, "a2_bad")) _h.a2_bad = _e.ai_mode;
            if (_s.t >= 48) {
                Scenario_Release();
                Scenario_Check("h11_the_player_walked_at_least_a_tile", _pl.y >= _h.y0 + _T, "y=" + string(_pl.y) + " from " + string(_h.y0));
                Scenario_Check("h11_walking_4_tiles_away_is_not_heard", !variable_struct_exists(_h, "a2_bad"), "mode=" + (variable_struct_exists(_h, "a2_bad") ? _h.a2_bad : ""));
                Scenario_PlacePlayer(8, 5);   // (8,6) is 4 tiles from (12,6): the first run step crosses into the hearing circle
                Scenario_Hold("move_down", 60);
                Scenario_Hold("run", 60);
                _h.heard = false;
                Scenario_Next(_s, 583);
            }
            break;
        case 583:   // RUNNING within 4 tiles, out of its sight: it reacts, without a "!"
            if (_e != noone && _e.ai_mode == "chase" && !_h.heard) {
                _h.heard = true;
                _h.pop_at_hear = _e.alert_pop;
                _h.heard_t = _s.t;
            }
            if (_h.heard && _s.t >= _h.heard_t + 2) {
                Scenario_Check("h11_running_within_4_tiles_out_of_sight_is_heard", true);
                Scenario_Check("h11_a_heard_player_is_no_sighting_no_exclamation_mark", _h.pop_at_hear == 0, "alert_pop=" + string(_h.pop_at_hear));
                // the player is gone: far away, out of sight and hearing
                Scenario_Release();
                var _c = Scenario_H11Cell(_e);
                _h.ls_cx = _e.last_seen_cx;
                _h.ls_cy = _e.last_seen_cy;
                _h.max_cy = _c.cy;
                _h.min_cy = _c.cy;
                _h.saw_return = false;
                _h.t_b = _s.f;
                Scenario_PlacePlayer(3, 4);
                Scenario_Next(_s, 584);
            }
            if (_s.t > 90) { Scenario_Check("h11_running_within_4_tiles_out_of_sight_is_heard", false, "mode=" + ((_e != noone) ? _e.ai_mode : "gone")); Scenario_Release(); Scenario_NoticeEnd(); }
            break;
        case 584:   // last heard cell -> searches down the column (the way he ran) -> ONE "?" -> home
            if (_e == noone) { Scenario_Check("h11_the_searcher_is_alive", false); Scenario_NoticeEnd(); break; }
            var _cb = Scenario_H11Cell(_e);
            _h.max_cy = max(_h.max_cy, _cb.cy);
            if (_e.ai_mode == "return") _h.saw_return = true;
            if (_e.q_pops > 1) _h.many = true;
            if (_h.saw_return && _e.ai_mode == "idle") {
                var _want_cy = min(_h.ls_cy + AI_FLEE_SEARCH_TILES, 9);   // rm_floor3: column 8 is free down to row 9, row 10 is wall
                Scenario_Check("h11_the_search_went_down_the_way_he_ran", _h.max_cy == _want_cy, "max_cy=" + string(_h.max_cy) + " want=" + string(_want_cy) + " last_heard=" + string(_h.ls_cx) + "," + string(_h.ls_cy));
                Scenario_Check("h11_it_gave_up_with_exactly_one_question_mark", _e.q_pops == 1 && !variable_struct_exists(_h, "many"), "q_pops=" + string(_e.q_pops));
                Scenario_Check("h11_then_it_walked_home", _cb.cx == 12 && _cb.cy == 6 && !_e.moving, "at " + string(_cb.cx) + "," + string(_cb.cy));
                Scenario_Next(_s, 585);
            }
            if (_s.f - _h.t_b > 2400) { Scenario_Check("h11_the_search_ends_at_home_in_2400_frames", false, "mode=" + _e.ai_mode + " q=" + string(_e.q_pops) + " max_cy=" + string(_h.max_cy)); Scenario_NoticeEnd(); }
            break;
        case 585:   // the hiding cell (3,4): the player stands still on it, then a dire wolf appears 2 tiles away with a clear line
            with (obj_enemy) instance_destroy();
            Scenario_PlacePlayer(3, 4);
            _pl.face = DOWN;
            _h.e = noone;
            Scenario_Next(_s, 586);
            break;
        case 586:
            if (_s.t == HIDE_SETTLE_FRAMES + 10) {
                Scenario_Check("h11_standing_still_on_the_hiding_cell_hides_the_player", Player_IsHidden(_pl));
                Scenario_Check("h11_the_hidden_player_is_drawn_see_through", abs(_pl.image_alpha - HIDE_PLAYER_ALPHA) < 0.01, "alpha=" + string(_pl.image_alpha));
                _h.e = Scenario_H11Enemy(obj_dire_wolf, 3, 6, -1, UP);   // sight 4 (D179), as in the game; 2 tiles below, clear line over (3,5), facing him
                _h.t_c = _s.f;
                _h.spotted = false;
                Scenario_Next(_s, 587);
            }
            break;
        case 587:   // 150 frames: the wolf must not notice, no battle starts
            if (_e != noone && (_e.ai_mode != "idle" || _e.alert_pop > 0)) _h.spotted = true;
            if (_s.f - _h.t_c >= 150) {
                Scenario_Check("h11_a_wolf_2_tiles_away_does_not_see_the_hidden_player", !_h.spotted, "mode=" + ((_e != noone) ? _e.ai_mode : "gone"));
                Scenario_Check("h11_no_battle_started", room == rm_floor3 && !Transition_IsActive());
                Scenario_Check("h11_the_player_is_still_hidden_and_in_place", Player_IsHidden(_pl) && _pl.x == 3 * _T && _pl.y == 4 * _T);
                Scenario_Hold("move_left", 30);   // one step off the cell (2,4): not hidden any more, 2.2 tiles from the wolf
                _h.t_c = _s.f;
                Scenario_Next(_s, 588);
            }
            break;
        case 588:   // the control: the same wolf, the same distance, but the player is moving: it spots him
            if (_e != noone && (_e.ai_mode == "chase") && !variable_struct_exists(_h, "spot_f")) _h.spot_f = _s.f - _h.t_c;
            if (variable_struct_exists(_h, "spot_f") || _s.f - _h.t_c > 120) {
                Scenario_Release();
                Scenario_Check("h11_one_step_off_the_hiding_cell_the_same_wolf_spots_the_player", variable_struct_exists(_h, "spot_f"), "mode=" + ((_e != noone) ? _e.ai_mode : "gone"));
                if (instance_exists(obj_enemy)) with (obj_enemy) instance_destroy();
                Scenario_Next(_s, 589);
            }
            break;
        case 589:   // a fresh rm_floor3 (its own enemies): via another room, the controller only restores a room on a room change
            if (_s.t == 1) {
                Scenario_ClearUi();
                room_goto(rm_floor2);
            }
            if (_s.t > 20 && room == rm_floor2) {
                room_goto(rm_floor3);
                Scenario_Next(_s, 590);
            }
            break;
        case 590:   // a spider next to the exit to floor 4; the player on that exit leaves
            if (_s.t > 20 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _sp = instance_exists(obj_spider) ? instance_find(obj_spider, 0) : noone;
                Scenario_Check("h11_rm_floor3_has_its_spider", _sp != noone);
                if (_sp == noone) { Scenario_NoticeEnd(); break; }
                with (obj_enemy) { if (id != _sp) instance_destroy(); }
                EnemyAI_Init(_sp);
                _sp.prof.sight = 0;   // it only has to stand there: it chased the player to the exit
                Scenario_PlaceEnemy(_sp, 13, 8);
                _h.sp_pid = _sp.persist_id;
                var _ex = noone;
                with (obj_room_transition) { if (transition_id == "floor3_to_floor4") _ex = id; }
                Scenario_Check("h11_the_exit_to_floor_4_is_there", _ex != noone);
                if (_ex == noone) { Scenario_NoticeEnd(); break; }
                _h.ex_cx = round(_ex.bbox_left / _T);
                _h.ex_cy = round(_ex.bbox_top / _T);
                Scenario_PlacePlayer(_h.ex_cx, _h.ex_cy);
                Scenario_Hold(Scenario_Hunt2DirAction(_ex.require_dir), 4);
                Scenario_Next(_s, 591);
            }
            if (_s.t > 600) { Scenario_Check("h11_a_fresh_rm_floor3_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 591:   // in rm_floor4, on the exit back: leave again
            if (_s.t > 5 && Scenario_FloorReady(rm_floor4) && Player_IsSettled(_pl)) {
                Scenario_Release();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _ex2 = instance_position(_pl.x + _T / 2, _pl.y + _T / 2, obj_room_transition);
                Scenario_Check("h11_arrived_in_rm_floor4_on_an_exit", _ex2 != noone);
                if (_ex2 == noone) { Scenario_NoticeEnd(); break; }
                Scenario_Hold(Scenario_Hunt2DirAction(_ex2.require_dir), 6);
                Scenario_Next(_s, 592);
            }
            if (_s.t > 600) { Scenario_Check("h11_the_player_arrives_in_rm_floor4", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 592:   // back in rm_floor3: the spider was saved next to the exit, it is put back
            if (_s.t > 20 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                Scenario_Release();
                var _sp2 = noone;
                with (obj_enemy) { if (persist_id == _h.sp_pid) _sp2 = id; }
                Scenario_Check("h11_the_spider_is_back_in_the_room", _sp2 != noone);
                if (_sp2 == noone) { Scenario_NoticeEnd(); break; }
                var _cs = Scenario_H11Cell(_sp2);
                var _pc = Scenario_H11Cell(_pl);
                Scenario_Check("h11_the_player_arrived_on_the_exit_it_left_by", _pc.cx == _h.ex_cx && _pc.cy == _h.ex_cy, "player at " + string(_pc.cx) + "," + string(_pc.cy));
                Scenario_Check("h11_the_spider_that_waited_at_the_exit_is_4_tiles_from_it", point_distance(_cs.cx, _cs.cy, _h.ex_cx, _h.ex_cy) >= AI_EXIT_RELOCATE_TILES, "spider at " + string(_cs.cx) + "," + string(_cs.cy));
                var _near = 0;
                with (obj_enemy) { if (point_distance(Nav_CellOf(x + 8), Nav_CellOf(y + 8), _pc.cx, _pc.cy) < AI_ARRIVAL_CLEAR_TILES) _near++; }
                Scenario_Check("h11_nobody_within_3_tiles_of_the_arrival_tile", _near == 0, "near=" + string(_near));
                Scenario_Next(_s, 649);   // H2 (D156, 649..669) goes on; its last step ends the smoke chain
            }
            if (_s.t > 600) { Scenario_Release(); Scenario_Check("h11_the_player_is_back_in_rm_floor3", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
    }
}

// ============================================================================
// H11 (D153) pictures 610-619 (rm_floor3 at scale 3, 480 x 432): 610/611 the "?" over an enemy that gave up its search (the real search, stood at its last
// seen cell), 612 the player hidden on the cell (3,4) with a slime 2 tiles away that does not see him, 613 the same spot one step off the cell: seen, "!" up.
// ============================================================================
function Scenario_StepShotsH11(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "h11s")) _s.h11s = { };
    var _h = _s.h11s;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _e = (variable_struct_exists(_h, "e") && instance_exists(_h.e)) ? _h.e : noone;
    switch (_s.step) {
        case 610:   // rm_floor3, the player at (6,6), a slime at (9,6) that has just lost him and searches
            if (_s.t == 1) {
                Scenario_Release();
                Scenario_NewKnight(CLASS_KNIGHT);
                Scenario_SetWindowScale(3);
                room_goto(rm_floor2);   // via another room: the controller only spawns the player on a room change
            }
            if (_s.t == 30 && room == rm_floor2) room_goto(rm_floor3);
            if (_s.t > 70 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_PlacePlayer(6, 6);
                _h.e = Scenario_H11Enemy(obj_slime, 9, 6, 0);   // sight 0: it only stands there and searches
                _h.e.ai_mode = "search";
                _h.e.srch = Search_Create(9, 6, -1, 10);
                Scenario_Next(_s, 611);
            }
            if (_s.t > 600) { Scenario_Check("shots_h11_rm_floor3_is_ready", false, "room=" + room_get_name(room) + " player=" + string(_pl != noone)); Scenario_Finish(); }
            break;
        case 611:   // the "?" is up and has settled: the picture
            if (_e != noone && _e.q_pops >= 1 && (AI_QUESTION_FRAMES - _e.question_pop) >= 16) {
                Scenario_Check("shots_h11_the_question_mark_is_up_once", _e.q_pops == 1 && _e.question_pop > 12, "pops=" + string(_e.q_pops) + " left=" + string(_e.question_pop));
                _s.shot = "shot_h11_question.png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 612);
            }
            if (_s.t > 400) { Scenario_Check("shots_h11_the_search_gives_up", false, "mode=" + ((_e != noone) ? _e.ai_mode : "gone")); Scenario_Finish(); }
            break;
        case 612:   // the hiding cell (3,4), a slime 2 tiles below with a clear line
            if (_s.t == 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                with (obj_enemy) instance_destroy();
                Scenario_PlacePlayer(3, 4);
                _h.e = Scenario_H11Enemy(obj_slime, 3, 6, -1, UP);   // D179: it faces him
            }
            if (_s.t == HIDE_SETTLE_FRAMES + 20) {
                Scenario_Check("shots_h11_the_player_is_hidden_and_unseen", Player_IsHidden(_pl) && _h.e.ai_mode == "idle" && _h.e.alert_pop == 0);
                _s.shot = "shot_h11_hidden.png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 613);
            }
            break;
        case 613:   // one cell to the side: no longer on the hiding cell, the slime spots him
            if (_s.t == 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_PlacePlayer(2, 4);
            }
            if (_s.t > 3 && _e != noone && _e.alert_pop > 0 && !variable_struct_exists(_h, "seen_t")) _h.seen_t = _s.t;
            if (variable_struct_exists(_h, "seen_t") && _s.t >= _h.seen_t + 3) {
                Scenario_Check("shots_h11_off_the_cell_the_player_is_seen", !Player_IsHidden(_pl) && abs(_pl.image_alpha - 1) < 0.01);
                _s.shot = "shot_h11_visible.png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 614);
            }
            if (_s.t > 120) { Scenario_Check("shots_h11_the_slime_spots_the_player_off_the_cell", false); Scenario_Finish(); }
            break;
        case 614:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                with (obj_enemy) instance_destroy();
                Scenario_Next(_s, 670);   // H2 (D156, pictures 670..673) finish the run
            }
            break;
    }
}


// ---- H6 (D146, D156): cutscene text in the shared dialogue box and hold-to-skip, through real input (smoke steps 620-639, the end of the chain; pictures 640-649) ----
// A tap of confirm finishes the typewriter line, a second tap advances exactly one line, and neither shows the prompt. Holding confirm: no prompt before 1 s, the prompt fully shown with the bar
// half full at 1.5 s, and the intro ends at 2 s (not before 1.9 s, within 2.2 s); the run then starts. Writes the profile and the run: only inside the gate (NoticeEnd removes them).
function Scenario_StepSmokeCutSkip(_s) {
    var _gs = GameState_Get();
    var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    if (!variable_struct_exists(_s, "cs")) _s.cs = { amax: 0, idx0: 0, idx1: 0, idx2: 0, f0: 0, early: false, mid: false };
    var _cs = _s.cs;
    var _running = (room == rm_cutscene && _sc != noone && _sc.cutscene_started && !Transition_IsActive() && _gs.ui.mode == UI_DIALOGUE);
    if (variable_global_exists("skip")) _cs.amax = max(_cs.amax, Skip_HintAlpha(global.skip.st));
    switch (_s.step) {
        case 620:   // a new game's intro cutscene
            if (_s.t == 1) {
                if (Transition_IsActive()) { _s.t = 0; break; }
                Scenario_ClearUi();
                if (instance_exists(obj_dialogue_trigger)) with (obj_dialogue_trigger) instance_destroy();
                Scenario_NewKnight();
                Transition_RequestCutsceneById("intro");
            }
            if (_s.t > 40 && _running) {
                var _lay = Dialogue_TextLayout("");
                Scenario_Check("cutskip_the_cutscene_text_is_in_the_normal_dialogue_box", !Dialogue_IsCutsceneTextOnly() && !_gs.ui.dialogue_box_half && !_lay.cutscene_text_only, "text_only=" + string(Dialogue_IsCutsceneTextOnly()) + " half=" + string(_gs.ui.dialogue_box_half));
                Scenario_Next(_s, 621);
            }
            if (_s.t > 600) { Scenario_Check("cutskip_intro_cutscene_running", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 621:   // a tap while the line is being typed finishes the line and does not advance
            if (_s.t == 1) {
                if (_gs.ui.dialogue_state != UI_DIALOGUE_STATE_REVEALING) { Scenario_Next(_s, 622); break; }   // the line was already complete
                _cs.idx0 = _gs.ui.index;
                Scenario_Tap("confirm");
            }
            if (_s.t == 4) {
                Scenario_Check("cutskip_a_tap_finishes_the_typewriter_and_stays_on_the_line", _gs.ui.index == _cs.idx0 && _gs.ui.dialogue_state != UI_DIALOGUE_STATE_REVEALING, "index=" + string(_gs.ui.index) + " was " + string(_cs.idx0));
                Scenario_Next(_s, 622);
            }
            break;
        case 622:   // the line is complete: one tap
            if (_gs.ui.dialogue_state == UI_DIALOGUE_STATE_READY && _running) {
                _cs.idx1 = _gs.ui.index;
                Scenario_Tap("confirm");
                Scenario_Next(_s, 623);
            }
            if (_s.t > 300) { Scenario_Check("cutskip_the_line_becomes_ready", false, "state=" + string(_gs.ui.dialogue_state)); Scenario_NoticeEnd(); }
            break;
        case 623:   // exactly one line on, no prompt, no skip
            if (_s.t == 4) {
                Scenario_Check("cutskip_a_tap_advances_exactly_one_line", _gs.ui.index == _cs.idx1 + 1, "index=" + string(_gs.ui.index) + " from " + string(_cs.idx1));
                Scenario_Check("cutskip_a_tap_never_shows_the_prompt", _cs.amax == 0, "alpha=" + string(_cs.amax));
                Scenario_Check("cutskip_a_tap_does_not_skip", room == rm_cutscene && _sc != noone && !_sc.cutscene_skip && !Transition_IsActive(), "room=" + room_get_name(room));
                Scenario_Next(_s, 624);
            }
            break;
        case 624:   // hold confirm
            if (_s.t == 1) {
                Scenario_Hold("confirm", 300);
                _cs.f0 = _s.f;
                _cs.amax = 0;
                _cs.idx2 = _gs.ui.index;
                _cs.last_hm = 0;
            }
            if (_s.t > 1 && variable_global_exists("skip")) {
                var _hm = global.skip.st.held_ms;
                if (_hm > 0) _cs.last_hm = _hm;   // the game's own hold clock (ms): the skip is judged on it, not on frames (a busy PC runs under 60 fps)
                if (_hm > 0 && _hm < SKIP_HINT_MS - 20 && Skip_HintAlpha(global.skip.st) > 0) _cs.early = true;
                if (!_cs.mid && _hm >= 1500) {
                    _cs.mid = true;
                    var _fr = Skip_Fraction(_hm);
                    Scenario_Check("cutskip_before_1_s_there_is_no_prompt", !_cs.early);
                    Scenario_Check("cutskip_at_1_5_s_the_prompt_is_shown_and_the_bar_half_full", Skip_HintAlpha(global.skip.st) >= 1 && abs(_fr - 0.5) < 0.06, "alpha=" + string(Skip_HintAlpha(global.skip.st)) + " fraction=" + string(_fr));
                    Scenario_Check("cutskip_holding_does_not_advance_lines", _gs.ui.index == _cs.idx2, "index=" + string(_gs.ui.index) + " was " + string(_cs.idx2));
                }
            }
            if (_s.t > 1 && Transition_IsActive() && _gs.transition_fx.type == TRANSITION_TYPE_CUTSCENE && _gs.transition_fx.target_room == rm_floor1) {
                var _d = _s.f - _cs.f0;
                var _lhm = variable_struct_exists(_cs, "last_hm") ? _cs.last_hm : 0;
                Scenario_Check("cutskip_a_2_s_hold_ends_the_intro_not_before_1_9_s", _lhm >= 1900, "held_ms=" + string(_lhm) + " frames=" + string(_d));
                Scenario_Check("cutskip_a_2_s_hold_ends_the_intro_within_2_2_s", _d <= round(2200 / TRANSITION_FRAME_MS), "frames=" + string(_d));
                Scenario_Release();
                Scenario_Next(_s, 625);
            }
            if (_s.t > 500) { Scenario_Check("cutskip_a_2_s_hold_ends_the_intro", false, "room=" + room_get_name(room)); Scenario_Release(); Scenario_NoticeEnd(); }
            break;
        case 625:   // the run starts
            if (room == rm_floor1 && !Transition_IsActive() && instance_exists(obj_player) && Run_IsActive()) {
                Scenario_Check("cutskip_the_run_starts_after_the_skip", true);
                Scenario_Check("cutskip_the_prompt_is_gone_after_the_skip", Skip_HintAlpha(global.skip.st) == 0, "alpha=" + string(Skip_HintAlpha(global.skip.st)));
                Scenario_Next(_s, 710);   // goes on with H14 (710..729), the end of the chain
            }
            if (_s.t > 900) { Scenario_Check("cutskip_the_run_starts_after_the_skip", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
    }
}

// Pictures 640-649 (480 x 432 = scale 3, then 800 x 720 = scale 5): an intro cutscene line in the shared dialogue box, and the "Hold to skip" prompt with the bar half full (confirm held 1.5 s).
function Scenario_ShotCutSkip(_s, _name) {
    _s.shot = "shot_cutskip_" + _name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
    Scenario_ShotLayout(_s.shot);
}

function Scenario_StepShotsCutSkip(_s) {
    var _gs = GameState_Get();
    var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _scales = [3, 5];
    switch (_s.step) {
        case 640:   // the intro cutscene at this size; the first line typed out
            if (_s.t == 1) {
                Scenario_SetWindowScale(_scales[_s.cs_i]);
                Loc_SetLanguage("en");
                Scenario_ClearUi();
                Skip_Reset();
                Scenario_NewKnight();
                Transition_RequestCutsceneById("intro");
            }
            if (_s.t > 60 && room == rm_cutscene && _sc != noone && _sc.cutscene_started && !Transition_IsActive() && _gs.ui.mode == UI_DIALOGUE && _gs.ui.dialogue_state == UI_DIALOGUE_STATE_READY) {
                Scenario_Check("shots_cutskip_the_line_is_in_the_normal_dialogue_box", !Dialogue_IsCutsceneTextOnly() && !_gs.ui.dialogue_box_half);
                Scenario_Check("shots_cutskip_no_prompt_on_the_line", Skip_HintAlpha(global.skip.st) == 0);
                Scenario_ShotCutSkip(_s, "line");
                Scenario_Next(_s, 641);
            }
            if (_s.t > 700) { Scenario_Check("shots_cutskip_intro_line_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 641:   // hold confirm
            if (_s.t >= 4) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_Hold("confirm", 300);
                Scenario_Next(_s, 642);
            }
            break;
        case 642:   // 1.5 s into the hold: the prompt is fully shown and the bar is half full
            if (global.skip.st.held_ms >= 1500) {
                Scenario_Check("shots_cutskip_the_prompt_is_half_filled", Skip_HintAlpha(global.skip.st) >= 1 && abs(Skip_Fraction(global.skip.st.held_ms) - 0.5) < 0.06, "held_ms=" + string(global.skip.st.held_ms));
                Scenario_ShotCutSkip(_s, "prompt");
                Scenario_Release();
                Scenario_Next(_s, 643);
            }
            if (_s.t > 400) { Scenario_Check("shots_cutskip_the_hold_reaches_1_5_s", false, "held_ms=" + string(global.skip.st.held_ms)); Scenario_Release(); Scenario_NoticeEnd(); }
            break;
        case 643:
            if (_s.t >= 4) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Skip_Reset();
                Dialogue_CloseNow();
                Cutscene_ClearUiState();
                _s.cs_i++;
                if (_s.cs_i >= array_length(_scales)) {
                    Scenario_SetWindowScale(3);
                    Scenario_Next(_s, 730);   // goes on with H14 (730..749), the end of the pictures
                } else {
                    room_goto(rm_floor1);
                    Scenario_Next(_s, 644);
                }
            }
            break;
        case 644:   // out of the cutscene; back to the start of the pictures at the next size
            if (room == rm_floor1 && !Transition_IsActive() && _s.t > 30) Scenario_Next(_s, 640);
            if (_s.t > 600) { Scenario_Check("shots_cutskip_back_to_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
    }
}

// ============================================================================
// H14 (D157, D159), smoke steps 710..729 (the game's own input state; rm_floor3, then rm_floor6 for the cost):
//   710-712: a slime at (12,6) with sight 4, a pillar (a wall) at (10,6). The player stands at (9,6) straight behind it, inside the radius: 40 frames, no sighting; the
//            light set says the same. One real step up to (9,5), inside the cone: the slime spots him.
//   713:     the room's lights (the fire stand of rm_floor3) are listed, lit, and the lighting pass has been running every frame.
//   714-716: rm_floor6 (two torches, two fire stands), the player in the middle of the lights and every enemy of the room plus extra slimes standing blind inside the view:
//            the lighting pass is timed for 130 frames, average under 1 ms.
//   717:     the dotted sight outline (D63) is gone: its ring cache was never built in the whole run.
//   D160 (amends D157): enemy sight is invisible. The pass draws no light for an enemy (cones == 0) while the fires still light (lights >= 2).
// ============================================================================
function Scenario_H14Free(_cx, _cy) {
    return !Nav_CellBlocked(Nav_Get().grid, _cx, _cy);
}

function Scenario_StepSmokeH14(_s) {
    if (!variable_struct_exists(_s, "h14")) _s.h14 = { };
    var _h = _s.h14;
    var _T = GRID_TILE_SIZE;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _e = (variable_struct_exists(_h, "e") && instance_exists(_h.e)) ? _h.e : noone;
    switch (_s.step) {
        case 710:   // the slime at (12,6), the pillar at (10,6), the player at (9,6) behind it
            if (asset_get_index("Vis_Cone") == -1 || asset_get_index("Light_Stats") == -1) { Scenario_Check("h14_the_lighting_code_exists", false); Scenario_NoticeEnd(); break; }
            if (_s.t == 1) {   // one-time setup (the chain arrives from H6 in rm_floor1): a fresh knight, rm_floor3 via another room (the controller only spawns the player on a room change)
                Scenario_Release();
                Scenario_ClearUi();
                Scenario_NewKnight(CLASS_KNIGHT);
                room_goto(rm_floor2);
            }
            if (_s.t == 30 && room == rm_floor2) room_goto(rm_floor3);
            if (_s.t > 70 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_Release();
                Scenario_Check("h14_the_stage_cells_of_rm_floor3_are_free", Scenario_H14Free(12, 6) && Scenario_H14Free(10, 6) && Scenario_H14Free(9, 6) && Scenario_H14Free(9, 5));
                _h.pillar = Scenario_Block(obj_wall, 10, 6);
                _h.e = Scenario_H11Enemy(obj_slime, 12, 6, 4, LEFT);   // D179: it faces the pillar and the player behind it
                Scenario_PlacePlayer(9, 6);
                _pl.face = UP;   // already facing the way it will walk: a tap on a new direction only turns (D69)
                _h.bad = false;
                Scenario_Next(_s, 711);
            }
            if (_s.t > 600) { Scenario_Check("h14_rm_floor3_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 711:   // behind the pillar, inside the radius: not seen, and not lit
            if (_e == noone) { Scenario_Check("h14_the_slime_is_alive", false); Scenario_NoticeEnd(); break; }
            if (_e.ai_mode != "idle" || _e.alert_pop > 0) _h.bad = true;
            if (_s.t == 5) {
                var _g = Nav_Get().grid;
                var _cone = Vis_Cone(_g, 12, 6, 4, false);
                Scenario_Check("h14_the_pillar_blocks_sight_in_the_room_grid", Nav_SightBlocked(_g, 10, 6));
                Scenario_Check("h14_the_cell_behind_the_pillar_is_dark", !Vis_Has(_cone, 9, 6) && !Vis_Has(_cone, 8, 6));
                Scenario_Check("h14_the_pillar_and_the_cells_in_front_are_lit", Vis_Has(_cone, 10, 6) && Vis_Has(_cone, 11, 6) && Vis_Has(_cone, 9, 5) && Vis_Has(_cone, 9, 7));
                Scenario_Check("h14_the_player_is_inside_the_radius_behind_the_pillar", point_distance(12, 6, Nav_CellOf(_pl.x + _T / 2), Nav_CellOf(_pl.y + _T / 2)) <= 4);
            }
            if (_s.t >= 50) {
                Scenario_Check("h14_behind_the_pillar_inside_the_radius_the_player_is_not_seen", !_h.bad, "mode=" + _e.ai_mode);
                Scenario_Hold("move_up", 4);   // one real step to (9,5)
                Scenario_Next(_s, 712);
            }
            break;
        case 712:   // one step out into the cone: seen
            if (_e == noone) { Scenario_Check("h14_the_slime_is_alive_after_the_step", false); Scenario_NoticeEnd(); break; }
            if (_e.ai_mode == "chase" && !variable_struct_exists(_h, "spot_t")) {
                _h.spot_t = _s.t;
                _h.spot_cx = Nav_CellOf(_pl.x + _T / 2);
                _h.spot_cy = Nav_CellOf(_pl.y + _T / 2);
            }
            if (variable_struct_exists(_h, "spot_t") || _s.t > 90) {
                Scenario_Release();
                Scenario_Check("h14_stepping_out_of_the_shadow_into_the_cone_is_seen", variable_struct_exists(_h, "spot_t"), "mode=" + _e.ai_mode);
                Scenario_Check("h14_it_saw_him_in_the_lit_cell_above", variable_struct_exists(_h, "spot_t") && _h.spot_cx == 9 && _h.spot_cy == 5, "cell " + (variable_struct_exists(_h, "spot_t") ? string(_h.spot_cx) + "," + string(_h.spot_cy) : "none"));
                Scenario_Check("h14_the_exclamation_mark_is_up", _e.alert_pop > 0);
                if (instance_exists(_h.pillar)) with (_h.pillar) instance_destroy();
                with (obj_enemy) instance_destroy();
                Scenario_Next(_s, 713);
            }
            break;
        case 713:   // the room's light sources and the pass
            var _src = Light_Sources(room_get_name(room));
            Scenario_Check("h14_rm_floor3_lists_its_fire_stand_at_8_3", array_length(_src) == 1 && _src[0].cx == 8 && _src[0].cy == 3, "n=" + string(array_length(_src)));
            Scenario_Check("h14_that_fire_stand_is_lit", array_length(_src) == 1 && Light_IsLit(_src[0]));
            Scenario_Check("h14_the_lighting_pass_ran_every_frame_of_the_room", Light_PerfFrames() >= 100, "frames=" + string(Light_PerfFrames()));
            Scenario_ClearUi();
            room_goto(rm_floor2);
            Scenario_Next(_s, 714);
            break;
        case 714:
            if (_s.t > 20 && room == rm_floor2) {
                room_goto(rm_floor6);
                Scenario_Next(_s, 715);
            }
            if (_s.t > 300) { Scenario_Check("h14_rm_floor2_is_reached", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 715:   // rm_floor6: the player at (13,4) between the torch (12,2) and the fire stand (16,5); every enemy blind and still, 4 extra slimes in the view
            if (_s.t > 20 && Scenario_FloorReady(rm_floor6) && Player_IsSettled(_pl)) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_Release();
                Scenario_PlacePlayer(13, 4);
                with (obj_enemy) {   // the room's own enemies are dealt by the run seed: one standing next to (13,4) would start a fight in the middle of the measurement (seen: a battle at frame 63)
                    if (point_distance(x, y, 13 * GRID_TILE_SIZE, 4 * GRID_TILE_SIZE) < 3 * GRID_TILE_SIZE) instance_destroy();
                }
                var _extra = [[10, 5], [9, 6], [15, 6], [14, 7]];
                for (var _k = 0; _k < array_length(_extra); _k++) {
                    if (Scenario_H14Free(_extra[_k][0], _extra[_k][1])) Scenario_H11Enemy(obj_slime, _extra[_k][0], _extra[_k][1], -1);
                }
                with (obj_enemy) {
                    EnemyAI_Init(id);
                    spot_cooldown = 99999;   // blind: it only stands there, and its light is drawn all the same
                    idle_timer = 100000;
                }
                _h.n_enemies = instance_number(obj_enemy);
                Scenario_Check("h14_rm_floor6_has_lights_and_enemies_for_the_cost_run", array_length(Light_Sources("rm_floor6")) == 4 && _h.n_enemies >= 6, "enemies=" + string(_h.n_enemies));
                Light_PerfReset();
                Scenario_Next(_s, 716);
            }
            if (_s.t > 600) { Scenario_Check("h14_rm_floor6_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 716:   // 130 frames of the pass
            if (_s.t >= 130) {
                var _avg = Light_PerfAvgMs();
                var _st = Light_Stats();
                show_debug_message("[LIGHT-PERF] room=rm_floor6 enemies=" + string(_h.n_enemies) + " cones_drawn=" + string(_st.cones) + " lights_drawn=" + string(_st.lights)
                    + " frames=" + string(Light_PerfFrames()) + " avg_ms=" + string_format(_avg, 1, 4) + " max_ms=" + string_format(Light_PerfMaxMs(), 1, 4));
                Scenario_Check("h14_the_cost_run_stayed_in_rm_floor6_without_a_fight", room == rm_floor6 && !Transition_IsActive(), "room=" + room_get_name(room));
                Scenario_Check("h14_the_pass_ran_130_frames", Light_PerfFrames() >= 120, "frames=" + string(Light_PerfFrames()));
                Scenario_Check("d160_no_enemy_lights_its_sight_and_the_fires_still_light", _st.cones == 0 && _st.lights >= 2, "cones=" + string(_st.cones) + " lights=" + string(_st.lights));
                Scenario_Check("h14_the_lighting_pass_costs_under_1_ms_per_frame", _avg < 1.0, "avg_ms=" + string(_avg));
                Scenario_Next(_s, 717);
            }
            break;
        case 717:
            Scenario_Check("h14_the_dotted_sight_outline_is_not_drawn_any_more", !variable_global_exists("nav_ring_builds") || global.nav_ring_builds == 0, "ring builds=" + string(variable_global_exists("nav_ring_builds") ? global.nav_ring_builds : 0));
            with (obj_enemy) instance_destroy();
            Scenario_Next(_s, 680);   // goes on with H7 (680..699), the end of the chain
            break;
    }
}

// ============================================================================
// H14 (D157, D159) pictures 730-749, five scenes, each at scale 3 (480 x 432) and scale 5 (800 x 720), shot_h14_<scene>_<w>x<h>.png:
//   forest   rm_floor2: a dire wolf's light on the open floor, the player outside it
//   cave     rm_floor7: the torches along the rock wall and a spider's light
//   torches  rm_floor6: the two torches (no enemy): the light pools alone
//   shadow   rm_floor3: a dire wolf with the player behind the wall under the barrels at (4,3), (4,4): in the dark, not seen
//   hidden   rm_floor3: the player hidden on the hiding cell (3,4), a wolf 2 tiles away: the cell stays in shadow
// ============================================================================
function Scenario_H14Scene(_i) {
    switch (_i) {
        case 0: return { name: "forest", rm: rm_floor2, pcx: 3, pcy: 5, foes: [[obj_dire_wolf, 9, 5]], wait: 40 };
        case 1: return { name: "cave", rm: rm_floor7, pcx: 3, pcy: 4, foes: [[obj_spider, 8, 5]], wait: 40 };
        case 2: return { name: "torches", rm: rm_floor6, pcx: 8, pcy: 4, foes: [], wait: 40 };
        case 3: return { name: "shadow", rm: rm_floor3, pcx: 2, pcy: 4, foes: [[obj_dire_wolf, 6, 4, LEFT]], wait: 40 };   // D179: sight 4 and a cone: it stands 4 tiles from him, facing the wall
        case 4: return { name: "hidden", rm: rm_floor3, pcx: 3, pcy: 4, foes: [[obj_dire_wolf, 3, 6]], wait: HIDE_SETTLE_FRAMES + 30 };
    }
    return undefined;
}

function Scenario_StepShotsH14(_s) {
    if (!variable_struct_exists(_s, "h14s")) _s.h14s = { i: 0, e: [] };
    var _h = _s.h14s;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _sc = Scenario_H14Scene(_h.i);
    switch (_s.step) {
        case 730:   // build the scene _h.i
            if (_sc == undefined) { Scenario_Finish(); break; }
            if (asset_get_index("Vis_Cone") == -1 || asset_get_index("Light_PocketCell") == -1) { Scenario_Check("shots_h14_the_lighting_code_exists", false); Scenario_Finish(); break; }
            if (_s.t == 1) {
                Scenario_Release();
                global.light_clock = 1500;   // the fires' flicker is frozen at one step, so a picture can be taken again
                Scenario_NewKnight(CLASS_KNIGHT);
                Scenario_SetWindowScale(3);
                _h.via = (_sc.rm == rm_floor2) ? rm_floor3 : rm_floor2;
                room_goto(_h.via);   // via another room: the controller only spawns the player on a room change
            }
            if (_s.t == 30 && room == _h.via) room_goto(_sc.rm);
            if (_s.t > 70 && Scenario_FloorReady(_sc.rm) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_PlacePlayer(_sc.pcx, _sc.pcy);
                _h.e = [];
                for (var _k = 0; _k < array_length(_sc.foes); _k++) {
                    array_push(_h.e, Scenario_H11Enemy(_sc.foes[_k][0], _sc.foes[_k][1], _sc.foes[_k][2], -1, (array_length(_sc.foes[_k]) > 3) ? _sc.foes[_k][3] : -1));
                }
                Scenario_Next(_s, 731);
            }
            if (_s.t > 600) { Scenario_Check("shots_h14_" + _sc.name + "_room_is_ready", false, "room=" + room_get_name(room) + " player=" + string(_pl != noone)); Scenario_Finish(); }
            break;
        case 731:   // scale 3, wait, shoot
            if (_s.t == 1) Scenario_SetWindowScale(3);
            if (_s.t >= _sc.wait) {
                Scenario_H14Judge(_h, _sc, _pl);
                _s.shot = "shot_h14_" + _sc.name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 732);
            }
            break;
        case 732:   // scale 5
            if (_s.t == 3) Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
            if (_s.t == 4) Scenario_SetWindowScale(5);
            if (_s.t >= 40) {
                _s.shot = "shot_h14_" + _sc.name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 733);
            }
            break;
        case 733:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                _h.i++;
                if (Scenario_H14Scene(_h.i) == undefined) {
                    with (obj_enemy) instance_destroy();
                    Scenario_Next(_s, 830);   // goes on with D164 (830..839) and then H7 (700..709), the end of the pictures
                } else {
                    Scenario_Next(_s, 730);
                }
            }
            break;
    }
}

// What each picture is about, checked at the moment of the shot: nobody has seen the player.
function Scenario_H14Judge(_h, _sc, _pl) {
    var _T = GRID_TILE_SIZE;
    var _quiet = true;
    for (var _k = 0; _k < array_length(_h.e); _k++) {
        if (!instance_exists(_h.e[_k])) { _quiet = false; continue; }
        if (_h.e[_k].ai_mode != "idle" || _h.e[_k].alert_pop > 0) _quiet = false;
    }
    Scenario_Check("shots_h14_" + _sc.name + "_nobody_has_seen_the_player", _quiet);
    var _gs = GameState_Get();
    Scenario_Check("shots_h14_" + _sc.name + "_no_dialogue_is_open", _gs.ui.mode == UI_NONE && array_length(_gs.ui.lines) == 0);
    var _pcx = Nav_CellOf(_pl.x + _T / 2);
    var _pcy = Nav_CellOf(_pl.y + _T / 2);
    if (_sc.name == "shadow" || _sc.name == "hidden") {
        var _g = Nav_Get().grid;
        var _ec = Scenario_H11Cell(_h.e[0]);
        var _cone = Vis_Cone(_g, _ec.cx, _ec.cy, _h.e[0].prof.sight, _h.e[0].prof.see_through, _h.e[0].look_dir);
        if (_sc.name == "shadow") Scenario_Check("shots_h14_shadow_the_player_stands_in_the_dark_inside_the_radius", !Vis_Has(_cone, _pcx, _pcy) && point_distance(_ec.cx, _ec.cy, _pcx, _pcy) <= _h.e[0].prof.sight);
        else Scenario_Check("shots_h14_hidden_the_player_is_hidden_and_the_cell_is_a_dark_pocket", Player_IsHidden(_pl) && Light_PocketCell(_ec.cx, _ec.cy, _pcx, _pcy));
    }
}

// ============================================================================
// H7 (D147): lore notes you pick up. Smoke steps 680-699 (the end of the chain: the last step calls Scenario_NoticeEnd).
//   680  rm_floor1's note is forgotten (as in a profile that never found it), the room is left and entered again
//   681  the note stands on its tile and blocks nothing (the player's rule and the enemies' grid)
//   682  the player walks onto it with a real key: a notice, a rise on the map, the note gone, found in the profile and in the profile file, no dialogue
//   683  leaving and entering the room does not bring it back; a note not found yet (rm_floor3) is there
//   684  a new run does not bring it back either
//   685  the menu with the real keys: Codex -> Notes -> the found note opens a reader with its text -> Back; a ??? row opens nothing
//   686  a long text scrolls with the real keys and Back closes it; the menu closes
// ============================================================================
function Scenario_NoteTileFree(_pl, _d) {
    var _t = GRID_TILE_SIZE;
    var _blocked_player = Player_TileBlocked(_pl, _d.tx * _t, _d.ty * _t);
    var _g = Nav_Get().grid;
    var _blocked_nav = Nav_CellBlocked(_g, _d.tx, _d.ty);
    return { player: !_blocked_player, nav: !_blocked_nav };
}

function Scenario_StepSmokeNotes(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "nn")) _s.nn = { };
    var _n = _s.nn;
    var _T = GRID_TILE_SIZE;
    var _d1 = Note_Find("map_page");
    var _u = TabMenu_Get();
    var _m = TabMenu_TopMenu();
    switch (_s.step) {
        case 680:   // forget the note, leave the room and come back through the real room change
            if (_s.t == 1 && room != rm_floor1) {   // one-time setup (the chain arrives from H14 in rm_floor6): back to rm_floor1 by a real room change
                Scenario_Release();
                Scenario_ClearUi();
                room_goto(rm_floor1);
            }
            if (_s.t == 40) {
                if (!Scenario_FloorReady(rm_floor1)) { Scenario_Check("notes_the_chain_starts_in_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); break; }
                Dialogue_CloseNow();
                Scenario_ClearUi();
                global.tutorial_off = true;
                variable_struct_remove(Profile_Get().unlocks, Note_UnlockKey("map_page"));
                variable_struct_remove(Profile_Get().unlocks, Note_UnlockKey("wall_breath"));
                room_goto(rm_floor2);
            }
            if (_s.t > 20 && Scenario_FloorReady(rm_floor2)) {
                room_goto(rm_floor1);
                Scenario_Next(_s, 681);
            }
            if (_s.t > 600) { Scenario_Check("notes_reaches_rm_floor2", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 681:   // the note stands there and blocks nothing
            if (_s.t > 30 && Scenario_FloorReady(rm_floor1)) {
                with (obj_enemy) instance_destroy();
                Scenario_ClearUi();
                Scenario_Check("notes_floor1_shows_its_note", Notes_LiveCount("rm_floor1") == 1 && Notes_LiveAtTile("rm_floor1", _d1.tx, _d1.ty) == "map_page", "live=" + string(Notes_LiveCount("rm_floor1")));
                Scenario_Check("notes_it_is_not_found_yet", !Note_IsCollected(Profile_Get(), "map_page"));
                var _pl = Scenario_PlacePlayer(_d1.tx + 1, _d1.ty);
                _pl.face = LEFT;
                var _free = Scenario_NoteTileFree(_pl, _d1);
                Scenario_Check("notes_the_player_may_walk_onto_the_tile", _free.player);
                Scenario_Check("notes_enemies_see_the_tile_as_free", _free.nav);
                _n.mp = MapFx_Count("rise");
                Scenario_Next(_s, 682);
            }
            if (_s.t > 600) { Scenario_Check("notes_floor1_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 682:   // one real step onto it
            if (_s.t == 10) Scenario_Hold("move_left", 10);
            if (_s.t > 12 && Notes_LiveCount("rm_floor1") == 0 && !variable_struct_exists(_n, "got")) {
                _n.got = _s.t;
                Scenario_Release();
            }
            if (variable_struct_exists(_n, "got") && _s.t == _n.got + 4) {
                var _pl2 = instance_find(obj_player, 0);
                Scenario_Check("notes_the_player_stands_on_the_tile", _pl2.x == _d1.tx * _T && _pl2.y == _d1.ty * _T, "at " + string(_pl2.x) + "," + string(_pl2.y));
                Scenario_Check("notes_it_is_gone_from_the_map", Notes_LiveCount("rm_floor1") == 0);
                Scenario_Check("notes_it_is_found_in_the_profile", Note_IsCollected(Profile_Get(), "map_page"));
                Scenario_Check("notes_a_notice_names_it", Banner_Active() && global.banner.text == "Note found: " + _d1.title, "banner=" + (variable_global_exists("banner") ? string(global.banner.text) : "none"));
                Scenario_Check("notes_a_note_rises_off_the_tile", MapFx_Count("rise") > _n.mp);
                Scenario_Check("notes_no_dialogue_opens", _gs.ui.mode == UI_NONE && array_length(_gs.ui.lines) == 0, "mode=" + string(_gs.ui.mode));
                Scenario_Check("notes_the_profile_file_has_it", Note_IsCollected(Profile_Load(Profile_Path()).profile, "map_page"));
                Scenario_Next(_s, 683);
            }
            if (_s.t > 120 && !variable_struct_exists(_n, "got")) { Scenario_Release(); Scenario_Check("notes_walking_onto_it_picks_it_up", false, "live=" + string(Notes_LiveCount("rm_floor1"))); Scenario_NoticeEnd(); }
            break;
        case 683:   // it stays gone in this run; one not found yet is there
            if (_s.t == 1) room_goto(rm_floor2);
            if (_s.t > 20 && room == rm_floor2 && Scenario_FloorReady(rm_floor2) && !variable_struct_exists(_n, "back")) {
                _n.back = true;
                room_goto(rm_floor1);
            }
            if (variable_struct_exists(_n, "back") && !variable_struct_exists(_n, "again") && _s.t > 50 && Scenario_FloorReady(rm_floor1)) {
                _n.again = true;
                Scenario_Check("notes_entering_the_room_again_does_not_bring_it_back", Notes_LiveCount("rm_floor1") == 0 && Notes_LiveAtTile("rm_floor1", _d1.tx, _d1.ty) == "");
                room_goto(rm_floor3);
            }
            if (variable_struct_exists(_n, "again") && _s.t > 60 && Scenario_FloorReady(rm_floor3)) {
                var _w = Note_Find("wall_breath");
                Scenario_Check("notes_a_note_not_found_yet_is_there", Notes_LiveCount("rm_floor3") == 1 && Notes_LiveAtTile("rm_floor3", _w.tx, _w.ty) == "wall_breath", "live=" + string(Notes_LiveCount("rm_floor3")));
                Scenario_Next(_s, 684);
            }
            if (_s.t > 900) { Scenario_Check("notes_room_changes_work", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 684:   // a new run: the profile still remembers
            if (_s.t == 1) {
                Scenario_ClearUi();
                _gs.in_main_menu = false;
                Run_StartNew(false, 6847);
            }
            if (_s.t > 30 && Scenario_FloorReady(rm_floor1)) {
                Scenario_Check("notes_a_new_run_does_not_bring_it_back", Notes_LiveCount("rm_floor1") == 0, "live=" + string(Notes_LiveCount("rm_floor1")));
                Scenario_Check("notes_the_profile_still_has_it", Note_IsCollected(Profile_Get(), "map_page"));
                with (obj_enemy) instance_destroy();
                Scenario_ClearUi();
                Ui_MemSet(Ui_MemGlobal(), "tab_menu_active", 0);
                Ui_MemSet(Ui_MemGlobal(), "tab_codex", 0);     // the menus remember their cursors: start both Codex lists on their first row
                Ui_MemSet(Ui_MemGlobal(), "codex_notes", 0);
                Scenario_Next(_s, 685);
            }
            if (_s.t > 900) { Scenario_Check("notes_a_new_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 685:   // Tab, E x4 (Codex), Notes, the found note
            switch (_s.t) {
                case 5: Scenario_Tap("menu"); break;
                case 20:
                    _u = TabMenu_Get();
                    Scenario_Check("notes_the_menu_opens_on_status", _gs.ui.mode == UI_MENU && is_struct(_u) && _u.tab == 0, "mode=" + string(_gs.ui.mode));
                    Scenario_Tap("tab_next");
                    break;
                case 28: Scenario_Tap("tab_next"); break;
                case 36: Scenario_Tap("tab_next"); break;
                case 44: Scenario_Tap("tab_next"); break;
                case 54:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_four_E_reach_the_codex", is_struct(TabMenu_Get()) && TabMenu_Get().tab == 4 && _m.id == "tab_codex", "tab=" + string(is_struct(TabMenu_Get()) ? TabMenu_Get().tab : -1));
                    Scenario_Check("notes_the_codex_row_counts_the_notes", _m.items[1].id == "notes" && _m.items[1].value == "1/8", _m.items[1].value);
                    Scenario_Check("notes_the_codex_starts_on_its_first_row", _m.cursor == 0, "cursor=" + string(_m.cursor));
                    Scenario_Tap("menu_down");
                    break;
                case 62: Scenario_Tap("confirm"); break;
                case 72:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_confirm_opens_the_notes_page", _m.id == "codex_notes" && TabMenu_Depth() == 2, "id=" + _m.id);
                    Scenario_Check("notes_the_page_says_found_1_of_8", _m.layout.title == "Notes Found 1/8", _m.layout.title);
                    Scenario_Check("notes_the_found_note_is_listed_by_title", _m.items[0].label == _d1.title);
                    Scenario_Check("notes_the_others_are_question_marks", _m.items[1].label == "???" && _m.items[7].label == "???");
                    Scenario_Tap("menu_down");
                    break;
                case 80: Scenario_Tap("confirm"); break;   // a ??? row opens nothing
                case 90:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_a_question_mark_row_opens_nothing", _m.id == "codex_notes" && TabMenu_Depth() == 2, "id=" + _m.id);
                    Scenario_Tap("menu_up");
                    break;
                case 98: Scenario_Tap("confirm"); break;
                case 110:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_the_found_note_opens_a_reader", _m.id == "codex_note_read" && TabMenu_Depth() == 3 && _m.data.reader, "id=" + _m.id);
                    Scenario_Check("notes_the_reader_has_the_title", _m.layout.title == _d1.title);
                    Scenario_Check("notes_the_reader_has_the_full_text", string_pos(_d1.lines[0], _m.data.text) > 0 && string_pos(_d1.lines[1], _m.data.text) > 0 && string_pos(_d1.lines[2], _m.data.text) > 0);
                    Scenario_Check("notes_the_footer_offers_back", string_pos("[k:back]", TabMenu_Hint()) > 0, TabMenu_Hint());
                    Scenario_Tap("cancel");
                    break;
                case 124:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_back_closes_the_reader", _m.id == "codex_notes" && TabMenu_Depth() == 2 && _m.cursor == 0, "id=" + _m.id);
                    Scenario_Next(_s, 686);
                    break;
            }
            break;
        case 686:   // a long text scrolls; Back closes it; the menu closes
            switch (_s.t) {
                case 1:
                    var _fake = { id: "smoke_long", title: "A long letter", room: "rm_floor1", tx: 0, ty: 0, min_deaths: 0, lines: [] };
                    for (var _k = 0; _k < 40; _k++) array_push(_fake.lines, "Line " + string(_k) + " of a very long letter.");
                    TabNote_OpenReader(_fake);
                    break;
                case 20:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_the_long_text_reader_is_open", _m.id == "codex_note_read" && TabMenu_Depth() == 3, "id=" + _m.id);
                    Scenario_Check("notes_it_starts_at_the_top", _m.data.scroll == 0);
                    Scenario_Tap("menu_down");
                    break;
                case 28: Scenario_Tap("menu_down"); break;
                case 36:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_down_scrolls_the_long_text", _m.data.scroll == 2, "scroll=" + string(_m.data.scroll));
                    Scenario_Check("notes_a_long_text_has_more_to_scroll", _m.data.scroll < NoteReader_MaxScroll(array_length(_m.data.wrapped), _m.data.visible), "n=" + string(array_length(_m.data.wrapped)) + " vis=" + string(_m.data.visible));
                    Scenario_Tap("menu_up");
                    break;
                case 44:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_up_scrolls_back", _m.data.scroll == 1, "scroll=" + string(_m.data.scroll));
                    Scenario_Tap("cancel");
                    break;
                case 58:
                    _m = TabMenu_TopMenu();
                    Scenario_Check("notes_back_closes_the_long_reader", _m.id == "codex_notes" && TabMenu_Depth() == 2, "id=" + _m.id);
                    Scenario_Tap("cancel");
                    break;
                case 70: Scenario_Tap("cancel"); break;
                case 90:
                    Scenario_Check("notes_back_back_back_closes_the_menu", _gs.ui.mode == UI_NONE && !is_struct(TabMenu_Get()), "mode=" + string(_gs.ui.mode));
                    Scenario_Next(_s, 800);   // hunt 5a (800..803) goes on from here; then D164 (820..)
                    break;
            }
            break;
    }
}

// ============================================================================
// D164 (amends D159): lighter rooms, daylight rooms with sun spots, extra torches placed in code. Smoke steps 820-829 (the end of the chain after H7:
// the last step calls Scenario_NoticeEnd), pictures 830-839 (go on with H7's pictures, 700).
//   820  rm_floor2 (daylight): its darkness is the daylight value, its source list holds a sun spot, the pass draws it
//   821  rm_floor3 (two extra torches): the room holds exactly its extra torches, each on its cell and lit; the pass draws lights
//   822  leave to rm_floor2
//   823  back to rm_floor3: still exactly the same torches (a room start does not stack a second set), the placement called again adds none
//   824  the end of the chain
// ============================================================================
function Scenario_D164TorchCount(_name) {
    var _list = Light_ExtraTorches(_name);
    var _t = GRID_TILE_SIZE;
    var _on_cells = 0;
    for (var _i = 0; _i < array_length(_list); _i++) {
        if (instance_position(_list[_i].cx * _t + _t / 2, _list[_i].cy * _t + _t / 2, obj_torch) != noone) _on_cells++;
    }
    return { want: array_length(_list), on_cells: _on_cells, total: instance_number(obj_torch) };
}

function Scenario_StepSmokeD164(_s) {
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    switch (_s.step) {
        case 820:   // rm_floor2: daylight
            if (asset_get_index("Light_RoomDark") == -1 || asset_get_index("Light_ExtraTorches") == -1) { Scenario_Check("d164_the_lighting_code_exists", false); Scenario_NoticeEnd(); break; }
            if (_s.t == 1) {
                Scenario_Release();
                Scenario_ClearUi();
                Dialogue_CloseNow();
                Scenario_NewKnight(CLASS_KNIGHT);
                if (room == rm_floor2) room_goto(rm_floor3);   // the controller only spawns the player on a room change
                else room_goto(rm_floor2);
            }
            if (_s.t == 30 && room == rm_floor3) room_goto(rm_floor2);
            if (_s.t > 30 && Scenario_FloorReady(rm_floor2) && Player_IsSettled(_pl)) {
                var _src = Light_RoomSources();
                var _suns = 0;
                for (var _i = 0; _i < array_length(_src); _i++) if (_src[_i].sun) _suns++;
                Scenario_Check("d164_rm_floor2_is_a_daylight_room", Light_RoomDark("rm_floor2") <= 0.15 && Light_RoomDarkNow() == Light_RoomDark("rm_floor2"), "now=" + string(Light_RoomDarkNow()));
                Scenario_Check("d164_rm_floor2_has_a_sun_spot_in_the_live_source_list", _suns >= 1, "suns=" + string(_suns));
                Scenario_Check("d164_rm_floor2_gets_no_extra_torch", instance_number(obj_torch) == 0, "torches=" + string(instance_number(obj_torch)));
                Light_PerfReset();
                Scenario_Next(_s, 821);
            }
            if (_s.t > 600) { Scenario_Check("d164_rm_floor2_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 821:   // the pass runs in rm_floor2 for a while, then rm_floor3
            if (_s.t == 40) {
                Scenario_Check("d164_the_pass_draws_the_sun_spots_of_rm_floor2", Light_Stats().lights >= 1, "lights=" + string(Light_Stats().lights));
                room_goto(rm_floor3);
            }
            if (_s.t > 70 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                var _c = Scenario_D164TorchCount("rm_floor3");
                Scenario_Check("d164_rm_floor3_has_exactly_its_extra_torches", _c.want >= 2 && _c.total == _c.want, "want=" + string(_c.want) + " total=" + string(_c.total));
                Scenario_Check("d164_each_extra_torch_stands_on_its_cell", _c.on_cells == _c.want, "on cells=" + string(_c.on_cells));
                var _src = Light_RoomSources();
                var _lit = 0;
                for (var _i = 0; _i < array_length(_src); _i++) if (_src[_i].obj == obj_torch && Light_IsLit(_src[_i])) _lit++;
                Scenario_Check("d164_every_extra_torch_is_lit", _lit == _c.want, "lit=" + string(_lit));
                Scenario_Check("d164_rm_floor3_is_the_plain_darkness", Light_RoomDarkNow() == LIGHT_DARK_ALPHA, "now=" + string(Light_RoomDarkNow()));
                _s.d164 = { total: _c.total };
                Scenario_Next(_s, 822);
            }
            if (_s.t > 600) { Scenario_Check("d164_rm_floor3_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 822:   // leave
            if (_s.t == 1) room_goto(rm_floor2);
            if (_s.t > 20 && Scenario_FloorReady(rm_floor2)) Scenario_Next(_s, 823);
            if (_s.t > 600) { Scenario_Check("d164_back_in_rm_floor2", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 823:   // come back: not twice
            if (_s.t == 1) room_goto(rm_floor3);
            if (_s.t > 40 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                var _c = Scenario_D164TorchCount("rm_floor3");
                Scenario_Check("d164_coming_back_does_not_stack_the_torches", _c.total == _s.d164.total && _c.total == _c.want, "total=" + string(_c.total) + " first=" + string(_s.d164.total));
                var _made = Light_PlaceExtraTorches();
                Scenario_Check("d164_placing_again_adds_nothing", _made == 0 && instance_number(obj_torch) == _c.total, "made=" + string(_made) + " total=" + string(instance_number(obj_torch)));
                Scenario_Check("d164_the_torches_still_light_the_room", array_length(Light_RoomSources()) >= 1 + _c.want);
                Scenario_Next(_s, 824);
            }
            if (_s.t > 600) { Scenario_Check("d164_rm_floor3_is_ready_again", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 824:
            Scenario_Next(_s, 850);   // goes on with H5 (750..769), then H13a (790..), the end of the chain
            break;
    }
}

// D164 pictures 830-839: three scenes, each at scale 3 (480 x 432) and scale 5 (800 x 720), shot_d164_<scene>_<w>x<h>.png:
//   daylight  rm_floor2: the open forest clearing, lit as day
//   torches   rm_floor3: the two extra wall torches beside the fire stand
//   shine     rm_floor9: the sun spot where the trees grew over the room
function Scenario_D164Scene(_i) {
    switch (_i) {
        case 0: return { name: "daylight", rm: rm_floor2, pcx: 4, pcy: 5, wait: 40 };
        case 1: return { name: "torches", rm: rm_floor3, pcx: 8, pcy: 5, wait: 40 };
        case 2: return { name: "shine", rm: rm_floor9, pcx: 12, pcy: 4, wait: 40 };
    }
    return undefined;
}

function Scenario_StepShotsD164(_s) {
    if (!variable_struct_exists(_s, "d164s")) _s.d164s = { i: 0 };
    var _h = _s.d164s;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _sc = Scenario_D164Scene(_h.i);
    switch (_s.step) {
        case 830:   // build the scene _h.i
            if (_sc == undefined) { Scenario_Next(_s, 700); break; }
            if (asset_get_index("Light_RoomDark") == -1) { Scenario_Check("shots_d164_the_lighting_code_exists", false); Scenario_Finish(); break; }
            if (_s.t == 1) {
                Scenario_Release();
                global.light_clock = 1500;   // the fires' flicker is frozen at one step, so a picture can be taken again
                Scenario_NewKnight(CLASS_KNIGHT);
                Scenario_SetWindowScale(3);
                _h.via = (room != rm_floor2 && _sc.rm != rm_floor2) ? rm_floor2 : ((room != rm_floor3 && _sc.rm != rm_floor3) ? rm_floor3 : rm_floor4);   // a room that is neither this one nor the target
                room_goto(_h.via);   // via another room: the controller only spawns the player on a room change
            }
            if (_s.t == 30 && room == _h.via) room_goto(_sc.rm);
            if (_s.t > 70 && Scenario_FloorReady(_sc.rm) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_PlacePlayer(_sc.pcx, _sc.pcy);
                Scenario_Next(_s, 831);
            }
            if (_s.t > 600) { Scenario_Check("shots_d164_" + _sc.name + "_room_is_ready", false, "room=" + room_get_name(room) + " player=" + string(_pl != noone)); Scenario_Finish(); }
            break;
        case 831:   // scale 3, wait, shoot
            if (_s.t == 1) Scenario_SetWindowScale(3);
            if (_s.t >= _sc.wait) {
                var _gs = GameState_Get();
                Scenario_Check("shots_d164_" + _sc.name + "_no_dialogue_is_open", _gs.ui.mode == UI_NONE && array_length(_gs.ui.lines) == 0);
                Scenario_Check("shots_d164_" + _sc.name + "_the_darkness_is_the_room_value", Light_RoomDarkNow() == Light_RoomDark(room_get_name(_sc.rm)), "now=" + string(Light_RoomDarkNow()));
                _s.shot = "shot_d164_" + _sc.name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 832);
            }
            break;
        case 832:   // scale 5
            if (_s.t == 3) Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
            if (_s.t == 4) Scenario_SetWindowScale(5);
            if (_s.t >= 40) {
                _s.shot = "shot_d164_" + _sc.name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 833);
            }
            break;
        case 833:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                _h.i++;
                if (Scenario_D164Scene(_h.i) == undefined) Scenario_Next(_s, 700);   // goes on with H7 (700..709), the end of the pictures
                else Scenario_Next(_s, 830);
            }
            break;
    }
}

// ---- H7 (D147) pictures 700..704: the Codex Notes page, a found note in the reader and a long text in the reader (scrolled, with its bar) at windowed
// scale 3 (480 x 432) and 5 (800 x 720). The last pictures of the run: they end it. ----
function Scenario_NotesShotScenes() {
    return ["list", "reader", "long", "ask"];
}

function Scenario_StepShotsNotes(_s) {
    var _scenes = Scenario_NotesShotScenes();
    var _scales = [3, 5];
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "nt7")) _s.nt7 = { n: 0, di: 0, si: 0, prof: undefined };
    var _o = _s.nt7;
    switch (_s.step) {
        case 700:   // enter a room at this scale (the two floors take turns: entering the room we are in would not spawn the player again)
            if (_s.t == 1) {
                if (!is_struct(_o.prof)) _o.prof = Scenario_TabProfile();   // two notes found (map_page, wall_breath); the real profile is put back at the end
                Scenario_TabFixture();
                Loc_SetLanguage("en");
                Scenario_SetWindowScale(_scales[_o.si]);
                _o.n++;
                room_goto((_o.n mod 2 == 1) ? rm_floor2 : rm_floor3);
            }
            if (_s.t >= 30 && Scenario_FloorReady((_o.n mod 2 == 1) ? rm_floor2 : rm_floor3)) Scenario_Next(_s, 701);
            if (_s.t > 600) { Scenario_Check("shots_notes_enters_the_room", false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 701:   // set the scene up
            with (obj_enemy) instance_destroy();
            Scenario_ClearUi();
            Menu_Open(4);
            TabCodex_Open("notes");
            switch (_scenes[_o.di]) {
                case "list":
                    Ui_MenuFixCursor(TabMenu_TopMenu(), 1);   // the Wall scratches
                    break;
                case "reader":
                    TabNote_OpenReader(Note_Find("wall_breath"));
                    break;
                case "long":
                    var _fake = { id: "shot_long", title: "A long letter", room: "rm_floor1", tx: 0, ty: 0, min_deaths: 0, lines: [] };
                    for (var _k = 0; _k < 14; _k++) array_push(_fake.lines, "Day " + string(_k + 1) + ". The tunnel is quiet and the walls keep their secrets, and I keep walking all the same.");
                    TabNote_OpenReader(_fake);
                    break;
                case "ask":   // D147 + D154: the survey page's question under its text, the replies awake (the questions are switched on for this picture only)
                    global.choice_off = false;
                    TabNote_OpenReader(Note_Find("map_page"));
                    break;
            }
            Scenario_Next(_s, 702);
            break;
        case 702:   // let the panels slide in, check the layout, take the picture
            if (_s.t >= 30) {
                var _tag = _scenes[_o.di] + "_" + string(_scales[_o.si]);
                var _m = TabMenu_TopMenu();
                Scenario_Check("shots_notes_open_" + _tag, _gs.ui.mode == UI_MENU && is_struct(_m), "mode=" + string(_gs.ui.mode));
                if (_scenes[_o.di] == "list") {
                    Scenario_Check("shots_notes_list_is_the_notes_page_" + _tag, is_struct(_m) && _m.id == "codex_notes" && _m.layout.title == "Notes Found 2/8", is_struct(_m) ? _m.layout.title : "");
                    Scenario_TabLayoutChecks(_tag);
                } else {
                    var _r = is_struct(_m) ? _m.rect : { x: -1, y: -1, w: 0, h: 0 };
                    Scenario_Check("shots_notes_reader_is_up_" + _tag, TabNote_IsReader(_m));
                    Scenario_Check("shots_notes_reader_is_on_screen_" + _tag, _r.w > 0 && _r.x >= 0 && _r.y >= 0 && _r.x + _r.w <= Display_GuiW() && _r.y + _r.h <= Display_GuiH(), json_stringify(_r));
                    var _n = array_length(_m.data.wrapped);
                    if (_scenes[_o.di] == "reader") {
                        Scenario_Check("shots_notes_the_whole_note_fits_" + _tag, _n > 0 && _n <= _m.data.visible, "lines=" + string(_n) + " visible=" + string(_m.data.visible));
                    } else if (_scenes[_o.di] == "ask") {
                        Scenario_Check("shots_notes_ask_the_question_is_open_" + _tag, _m.data.ask && array_length(_m.data.labels) == 2);
                        _m.data.scroll = 1000000;   // read to the end (the draw keeps it inside the text); two frames later the replies are awake
                    } else {
                        Scenario_Check("shots_notes_the_long_text_needs_scrolling_" + _tag, _n > _m.data.visible, "lines=" + string(_n) + " visible=" + string(_m.data.visible));
                        Scenario_Check("shots_notes_the_footer_offers_scrolling_" + _tag, string_pos("[k:up][k:down]", TabMenu_Hint()) > 0, TabMenu_Hint());
                        _m.data.scroll = 3;   // a picture of the text part-way down
                    }
                }
                if (_scenes[_o.di] != "long" && _scenes[_o.di] != "ask") {
                    _s.shot = "shot_notes_" + _scenes[_o.di] + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                    Scenario_ShotLayout(_s.shot);
                    Scenario_Next(_s, 703);
                } else {
                    Scenario_Next(_s, 704);   // two frames later so the scrolled text is what is drawn
                }
            }
            break;
        case 704:
            if (_s.t >= 2) {
                if (_scenes[_o.di] == "ask") {
                    var _ma = TabMenu_TopMenu();
                    var _tga = "ask_" + string(_scales[_o.si]);
                    var _ra = _ma.rect;
                    var _rra = _ma.data.reply_rects;
                    Scenario_Check("shots_notes_ask_the_replies_are_awake_" + _tga, NoteReader_Armed(_ma) && array_length(_rra) == 2);
                    Scenario_Check("shots_notes_ask_the_replies_sit_inside_the_panel_" + _tga, array_length(_rra) == 2 && _rra[0].x >= _ra.x && _rra[0].x + _rra[0].w <= _ra.x + _ra.w && _rra[0].y > _ra.y && _rra[1].y + _rra[1].h <= _ra.y + _ra.h && _rra[1].y >= _rra[0].y + _rra[0].h, json_stringify(_rra) + " " + json_stringify(_ra));
                    Scenario_Check("shots_notes_ask_the_footer_offers_select_" + _tga, string_pos("[k:confirm]", TabMenu_Hint()) > 0, TabMenu_Hint());
                }
                _s.shot = "shot_notes_" + _scenes[_o.di] + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 703);
            }
            break;
        case 703:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                global.choice_off = true;   // the "ask" picture switched the questions on
                if (is_struct(TabMenu_Get())) Menu_Close(true);
                Scenario_ClearUi();
                _o.si++;
                if (_o.si >= array_length(_scales)) { _o.si = 0; _o.di++; }
                if (_o.di >= array_length(_scenes)) {
                    global.profile = _o.prof;
                    Scenario_Next(_s, 770);   // goes on with H5 (770..773), the end of the pictures
                } else {
                    Scenario_Next(_s, 700);
                }
            }
            break;
    }
}

// ---- H5 (D144, D148) pictures 770..773: the class screen with some skills still ??? and the idle sprite preview, the same with the locked Nobody under the
// cursor, and the echo screen (the two discovered Knight skills), at windowed scale 3 (480 x 432) and 5 (800 x 720). Each is the real draw of the real screen
// on a real room; the panels are asserted on their rectangles (on screen, side by side, the text of every row fits its panel). Files shot_classmem_<scene>_<w>x<h>.png.
// The profile is a throwaway one in memory (nothing is written). The last picture of the run: it ends the run. ----
function Scenario_ClassMemShotScenes() {
    return ["class", "locked", "echo"];
}

function Scenario_StepShotsClassMem(_s) {
    var _scenes = Scenario_ClassMemShotScenes();
    var _scales = [3, 5];
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "cmz")) _s.cmz = { di: 0, si: 0, room: rm_floor2 };
    var _o = _s.cmz;
    var _sc = _scenes[_o.di];
    var _tag = _sc + "_" + string(_scales[_o.si]);
    switch (_s.step) {
        case 770:   // the room and the window scale of this picture (two floors take turns), a Knight, a profile that knows two Knight skills and one Mage skill
            if (_s.t == 1) {
                Scenario_ClearUi();
                CardsUi_Close();
                Loc_SetLanguage("en");
                Scenario_SetWindowScale(_scales[_o.si]);
                Scenario_TabFixture();
                global.profile = Profile_Default();
                global.profile_status = "missing";
                Profile_SkillLearn(global.profile, SKILL_WOUND);
                Profile_SkillLearn(global.profile, SKILL_HILT_BASH);
                Profile_SkillLearn(global.profile, SKILL_FIREBALL);
                _o.room = (room == rm_floor3) ? rm_floor2 : rm_floor3;   // entering the room we are in would not spawn the player again
                room_goto(_o.room);
            }
            if (_s.t >= 30 && Scenario_FloorReady(_o.room)) Scenario_Next(_s, 771);
            if (_s.t > 900) { Scenario_Check("shots_classmem_reaches_the_room_" + _tag, false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 771:   // open the screen the way the game does
            with (obj_enemy) instance_destroy();
            Scenario_ClearUi();
            if (_sc == "echo") {
                var _k = Card_ClassCharacter(_gs.player_ch, CLASS_KNIGHT);
                _k.skills = [];
                _k.card_picks = 0;
                _k.echo_offer = Run_EchoSkillOptions(Profile_Get(), CLASS_KNIGHT, 4242);
                GameState_SetPlayer(_k);
                CardsUi_Open("echo");
            } else {
                var _c = Card_ClassCharacter(_gs.player_ch, CLASS_NOBODY);
                _c.class_chosen = false;
                _c.class_pick = true;
                _c.card_picks = 0;
                GameState_SetPlayer(_c);
                CardsUi_Open("class");
                if (_sc == "locked") Ui_MenuFixCursor(Ui_StackTop(global.cards_ui.stk), 3);
            }
            Scenario_Next(_s, 772);
            break;
        case 772:   // let it slide in, check the layout, take the picture
            if (_s.t >= 24) {
                var _gw = Display_GuiW();
                var _gh = Display_GuiH();
                var _m = CardsUi_IsOpen() ? Ui_StackTop(global.cards_ui.stk) : undefined;
                Scenario_Check("shots_classmem_is_open_" + _tag, is_struct(_m) && _gs.ui.mode == UI_CARDS && _m.id == ((_sc == "echo") ? "run_echo" : "cards_class"));
                if (is_struct(_m)) {
                    var _r = _m.rect;
                    var _d = _m.det_rect;
                    Scenario_Check("shots_classmem_list_on_screen_" + _tag, _r.w > 0 && _r.x >= 0 && _r.y >= 0 && _r.x + _r.w <= _gw && _r.y + _r.h <= _gh, json_stringify(_r));
                    if (_sc == "echo") {
                        Scenario_Check("shots_classmem_echo_offers_two_" + _tag, array_length(_m.items) == 2);
                        Scenario_Check("shots_classmem_echo_details_on_screen_" + _tag, _d.w > 0 && _d.x >= 0 && _d.y >= 0 && _d.x + _d.w <= _gw && _d.y + _d.h <= _gh, json_stringify(_d));
                    } else {
                        Scenario_Check("shots_classmem_details_on_screen_" + _tag, _d.w > 0 && _d.x >= 0 && _d.y >= 0 && _d.x + _d.w <= _gw && _d.y + _d.h <= _gh, json_stringify(_d));
                        Scenario_Check("shots_classmem_list_and_details_do_not_overlap_" + _tag, !Test_RectsOverlap(_r, _d));
                        Scenario_Check("shots_classmem_cursor_is_on_the_asked_row_" + _tag, _m.cursor == ((_sc == "locked") ? 3 : 0), "cursor=" + string(_m.cursor));
                        var _fit = true;
                        var _need_max = 0;
                        for (var _i = 0; _i < array_length(_m.items); _i++) {
                            var _it = _m.items[_i];
                            var _need = Ui_DetailsHeight(_d.w, _it.help, _it.lines, _m.layout.details_cols, 0, _m.layout.det_art ? _it : undefined);
                            _need_max = max(_need_max, _need);
                            if (_need > _d.h) _fit = false;
                        }
                        Scenario_Check("shots_classmem_every_row_fits_its_panel_" + _tag, _fit, "needs " + string(_need_max) + " has " + string(_d.h));
                        var _mt = Ui_Metrics();
                        var _name_need = UI_TextWidth(_m.items[3].label) + 4 * _mt.p + UI_TextWidth(_m.items[3].value) + 13 * _mt.p;   // Nobody and its Locked mark, in full, inside the list's frame
                        Scenario_Check("shots_classmem_the_list_shows_the_names_in_full_" + _tag, _r.w >= _name_need, "needs " + string(_name_need) + " has " + string(_r.w));
                        Scenario_Check("shots_classmem_the_sprite_preview_is_drawn_" + _tag, Ui_ArtKind(_m.items[_m.cursor]) == "pic");
                    }
                }
                _s.shot = "shot_classmem_" + _sc + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 773);
            }
            break;
        case 773:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                CardsUi_Close();
                Scenario_ClearUi();
                _o.si++;
                if (_o.si >= array_length(_scales)) { _o.si = 0; _o.di++; }
                if (_o.di >= array_length(_scenes)) {
                    global.profile = undefined;   // the next Profile_Get reads the real (scratch) file again
                    RunSave_Delete();
                    Scenario_Next(_s, 870);   // goes on with H8a (870..889), then H13a (800..), the end of the pictures
                } else {
                    Scenario_Next(_s, 770);
                }
            }
            break;
    }
}

// ---- H13a (D156): the elite outline follows the sprite; the death scene shows the old GAME_OVER picture (smoke steps 790-799, the end of the chain; pictures 800-809) ----
// An elite on the map of floor 2 draws its outline every frame for 40 frames (Elite_FxDrawCount counts the elites the world pass drew, so a missing or failing draw shows); a death then shows its
// picture (RunFlow_DeathPicDraws counts the frames the picture was drawn) and reaches the summary. Writes the profile and the run: only inside the gate (NoticeEnd removes them).
function Scenario_StepSmokeEliteDeath(_s) {
    var _gs = GameState_Get();
    var _scn = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _flow = (variable_global_exists("run_flow") && is_struct(global.run_flow)) ? global.run_flow : undefined;
    if (!variable_struct_exists(_s, "ed")) _s.ed = { elite: noone, draws0: 0, pics0: 0, seen: false };
    var _ed = _s.ed;
    switch (_s.step) {
        case 790:   // floor 2, one enemy made an elite and frozen
            if (_s.t == 1) {
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP elite and death smoke (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_NoticeEnd();
                    break;
                }
                Dialogue_CloseNow();
                Scenario_ClearUi();
                room_goto(rm_floor2);
            }
            if (_s.t > 40 && Scenario_FloorReady(rm_floor2)) {
                var _first = noone;
                with (obj_enemy) { cine_lock_count = 1; if (_first == noone && !defeated) _first = id; }
                Scenario_Check("elitedeath_floor2_has_an_enemy", instance_exists(_first));
                if (!instance_exists(_first)) { Scenario_NoticeEnd(); break; }
                _first.elite_mod = "brutal";
                _ed.elite = _first.id;
                _ed.draws0 = Elite_FxDrawCount();
                Scenario_Next(_s, 791);
            }
            if (_s.t > 600) { Scenario_Check("elitedeath_floor2_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 791:   // 40 frames later: the outline was drawn each frame, then the player dies
            if (_s.t == 40) {
                var _n = Elite_FxDrawCount() - _ed.draws0;
                Scenario_Check("elitedeath_the_elite_outline_is_drawn_every_frame", _n >= 38 && _n <= 44, "draws=" + string(_n));
                Scenario_Check("elitedeath_the_elite_still_stands", instance_exists(_ed.elite) && !_ed.elite.defeated);
                Dialogue_CloseNow();
                Scenario_ClearUi();
                GameState_SetBattleEnemy("h13_smoke", ENEMY_SLIME, 1);
                Player_OnDeath(_gs.player_ch);
                Scenario_Next(_s, 792);
            }
            break;
        case 792:   // the death scene: the picture is there while the line shows, then the summary
            if (is_struct(_flow) && _scn != noone && _scn.state == "run_flow" && _flow.phase == "death" && !_ed.seen) {
                _ed.seen = true;
                _ed.pics0 = RunFlow_DeathPicDraws();
                Scenario_Check("elitedeath_the_death_picture_is_the_sprite_GAME_OVER", RunFlow_DeathImageName() == "GAME_OVER" && sprite_exists(RunFlow_DeathImage()));
            }
            if (_ed.seen && is_struct(_flow) && _flow.phase == "summary") {
                var _d = RunFlow_DeathPicDraws() - _ed.pics0;
                Scenario_Check("elitedeath_the_picture_is_drawn_through_the_death_line", _d >= 100, "frames=" + string(_d));
                Scenario_Check("elitedeath_the_death_reaches_the_summary", true);
                // hunt6run: a run file of a newer build is on disk when the player confirms the summary (New Game's Run_StartNew); it must stay
                Save_WriteFileAtomic(RunSave_Path(), Hunt6Run_NewerRunText());
                Scenario_Next(_s, 840);   // goes on with the kept run file (840), the end of the chain
            }
            if (_s.t > 900) { Scenario_Check("elitedeath_the_death_reaches_the_summary", false, "phase=" + (is_struct(_flow) ? string(_flow.phase) : "none") + " seen=" + string(_ed.seen)); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- hunt6run (smoke steps 840-849; goes on to review 6, 960, then hunt6ui, 950) ----
function Hunt6Run_NewerRunText() {
    return json_stringify({ run_version: RUN_SAVE_VERSION + 50, seed: 1, marker: "keep me" });
}

// The summary after a death is up and a run.sav of a newer build sits in the save folder. Confirm: the next run starts (Run_StartNew, as New Game does), the newer file is moved aside
// (review 6, finding 1: it used to stay at run.sav, and the new run's first autosave, a frame after the room change, wrote over it). Checked AFTER that first autosave: run.sav is the new run
// and the kept file still holds the newer run's text.
function Scenario_StepSmokeHunt6Run(_s) {
    var _flow = (variable_global_exists("run_flow") && is_struct(global.run_flow)) ? global.run_flow : undefined;
    switch (_s.step) {
        case 840:
            if (_s.t == 1) Scenario_Check("hunt6run_the_newer_run_file_is_there_before_the_new_run", RunSave_ExistsAt(RunSave_Path()) && RunSave_LoadFrom().status == "newer");
            if (_s.t == 30) Scenario_Tap("confirm");
            if (_s.t > 30 && Scenario_FloorReady(rm_floor1) && Run_IsActive() && RunSave_LoadFrom().status == "ok") {   // the new run has made its first autosave
                var _kept = RunSave_KeptFiles();
                Scenario_Check("hunt6run_the_first_autosave_wrote_the_new_run_to_run_sav", RunSave_LoadFrom().status == "ok");
                Scenario_Check("hunt6run_a_new_run_keeps_a_newer_version_run_file", array_length(_kept) == 1 && Save_ReadTextFile(array_length(_kept) > 0 ? _kept[0] : "") == Hunt6Run_NewerRunText(), "kept=" + string(array_length(_kept)));
                Scenario_Next(_s, 960);   // goes on with review 6
            }
            if (_s.t > 900) { Scenario_Check("hunt6run_the_new_run_started_and_saved", false, "room=" + room_get_name(room) + " active=" + string(Run_IsActive()) + " save=" + RunSave_LoadFrom().status + " phase=" + (is_struct(_flow) ? string(_flow.phase) : "none")); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- Review 6 (smoke steps 960-969, the end of the chain) ----
// 960/961: a fight from the map is won. While the "slain" message shows (the fight is decided, the map is not back) the snapshot of the moment before it is still held, so Quit or close
// there saves the run (finding 3: it was already cleared). Once the map is back and its room-entry autosave has run, the snapshot is gone.
function Scenario_StepSmokeReview6(_s) {
    var _bc = (room == rm_battle && instance_exists(obj_battle_controller)) ? instance_find(obj_battle_controller, 0) : noone;
    if (!variable_struct_exists(_s, "r6")) _s.r6 = {};
    var _h = _s.r6;
    var _ready_tap = ((_s.f - _s.last_tap) >= 4);
    switch (_s.step) {
        case 960:   // a snapshot as BeginEncounter takes it, then a fight that is won
            if (_s.t == 1) {
                Scenario_Release();
                Dialogue_CloseNow();
                Scenario_ClearUi();
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1)) {
                Scenario_Check("review6_a_snapshot_is_taken_before_the_fight", EnemyPersist_SnapshotRun() && EnemyPersist_HasSnapshot());
                _s.boost = { hp: 9999, mp: 99 };
                Scenario_GotoBattle("r6_win", ENEMY_SLIME);
                Scenario_Next(_s, 961);
            }
            if (_s.t > 600) { Scenario_Check("review6_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 961:   // 1 HP left on the enemy at the menu, ATTACK through it; look while the message shows, then back on the map
            if (_bc != noone) {
                if (_bc.battle_over && !variable_struct_exists(_h, "over")) {
                    _h.over = true;
                    Scenario_Check("review6_the_snapshot_is_held_while_the_slain_message_shows", EnemyPersist_HasSnapshot());
                }
                if (_s.t > 10 && !_bc.battle_over && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && _ready_tap) {
                    if (!variable_struct_exists(_h, "e1")) { _h.e1 = true; _bc.e.hp = 1; }
                    Scenario_Tap((_bc.menu_index != 0) ? "menu_up" : "confirm");
                }
            }
            if (variable_struct_exists(_h, "over") && room == rm_floor1 && Scenario_FloorReady(rm_floor1)) {
                if (!variable_struct_exists(_h, "back")) _h.back = _s.t;
                if (!EnemyPersist_HasSnapshot()) {
                    Scenario_Check("review6_the_snapshot_is_gone_once_the_map_has_saved", true);
                    Scenario_Next(_s, 950);   // goes on with hunt6ui (950..), the end of the chain (its NoticeEnd removes the files, the kept run file too, and the profile)
                } else if (_s.t > _h.back + 120) {
                    Scenario_Check("review6_the_snapshot_is_gone_once_the_map_has_saved", false, "still held 120 frames after the map came back");
                    Scenario_NoticeEnd();
                }
            }
            if (_s.t > 3000) { Scenario_Check("review6_the_fight_is_won", false, "room=" + room_get_name(room) + " state=" + string(_bc != noone ? _bc.battle_state : -1)); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- hunt6ui (smoke steps 950-959, the end of the chain; bug hunt session 6, findings in .planning/research/bughunt-session6-ui.md) ----
// A straight run of free tiles for the player to walk along: { cx, cy, act } (the start tile and the move action), or undefined.
function Scenario_Hunt6UiCorridor(_pl) {
    var _T = GRID_TILE_SIZE;
    var _dirs = [{ act: "move_right", dx: 1, dy: 0 }, { act: "move_left", dx: -1, dy: 0 }, { act: "move_down", dx: 0, dy: 1 }, { act: "move_up", dx: 0, dy: -1 }];
    var _c0x = round(_pl.x / _T);
    var _c0y = round(_pl.y / _T);
    for (var _ring = 0; _ring <= 10; _ring++) {
        for (var _oy = -_ring; _oy <= _ring; _oy++) {
            for (var _ox = -_ring; _ox <= _ring; _ox++) {
                if (max(abs(_ox), abs(_oy)) != _ring) continue;
                for (var _d = 0; _d < 4; _d++) {
                    var _ok = true;
                    for (var _k = 0; _k <= 6 && _ok; _k++) {
                        var _tx = (_c0x + _ox + _dirs[_d].dx * _k) * _T;
                        var _ty = (_c0y + _oy + _dirs[_d].dy * _k) * _T;
                        if (_tx < 0 || _ty < 0 || _tx >= room_width - _T || _ty >= room_height - _T) { _ok = false; break; }
                        if (Player_TileBlocked(_pl, _tx, _ty) || instance_position(_tx + _T / 2, _ty + _T / 2, obj_room_transition) != noone) _ok = false;
                    }
                    if (_ok) return { cx: _c0x + _ox, cy: _c0y + _oy, act: _dirs[_d].act };
                }
            }
        }
    }
    return undefined;
}

function Scenario_StepSmokeHunt6Ui(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "h6u")) _s.h6u = { round: 0 };
    var _h = _s.h6u;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    switch (_s.step) {
        case 950:   // the new run's first floor: a straight run of free tiles, nothing else on the map
            if (_s.t < 600) {
                Dialogue_CloseNow();
                _gs.pending_wake_line = false;
            }
            if (_s.t > 40 && Scenario_FloorReady(rm_floor1) && Player_IsSettled(_pl) && _gs.ui.mode == UI_NONE) {
                Scenario_ClearUi();
                with (obj_enemy) instance_destroy();
                var _cor = Scenario_Hunt6UiCorridor(_pl);
                Scenario_Check("hunt6ui_the_floor_has_a_corridor_to_walk", is_struct(_cor));
                if (!is_struct(_cor)) { Scenario_NoticeEnd(); break; }
                _h.cor = _cor;
                Scenario_Next(_s, 951);
            }
            if (_s.t > 900) { Scenario_Check("hunt6ui_the_new_run_reaches_rm_floor1", false, "room=" + room_get_name(room) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 951:   // walk along the corridor and press Esc (round 0) or Tab (round 1) in the middle of a step: the press is not thrown away
            if (_s.t == 1) {
                Scenario_ClearUi();
                _pl = Scenario_PlacePlayer(_h.cor.cx, _h.cor.cy);
                Scenario_Hold(_h.cor.act, 400);
            }
            if (_s.t > 3 && !Player_IsSettled(_pl) && _pl.move_timer > 0 && _pl.move_timer <= 10) {
                _h.tap_f = _s.f;
                _h.mid = true;
                Scenario_Tap((_h.round == 0) ? "esc" : "menu");
                Scenario_Next(_s, 952);
            }
            if (_s.t > 120) { Scenario_Release(); Scenario_Check("hunt6ui_the_player_walks_the_corridor", false, "x=" + string(_pl.x) + " y=" + string(_pl.y)); Scenario_NoticeEnd(); }
            break;
        case 952:   // the menu opens on the first settled frame within the buffer window, and not before
            var _name = (_h.round == 0) ? "esc" : "tab";
            if (_gs.ui.mode == UI_MENU && is_struct(TabMenu_Get())) {
                Scenario_Release();
                Scenario_Check("hunt6ui_" + _name + "_pressed_mid_step_opens_the_menu", true);
                Scenario_Check("hunt6ui_" + _name + "_it_opens_with_the_player_settled", Player_IsSettled(_pl), "x=" + string(_pl.x) + " move_timer=" + string(_pl.move_timer));
                Scenario_Check("hunt6ui_" + _name + "_it_opens_within_one_step", _s.f - _h.tap_f <= 20, "frames=" + string(_s.f - _h.tap_f));
                if (_h.round == 0) {
                    Menu_Close(true);
                    _h.round = 1;
                    Scenario_Next(_s, 951);
                } else {
                    Scenario_Next(_s, 953);
                }
            } else if (_s.t > 40) {
                Scenario_Release();
                Scenario_Check("hunt6ui_" + _name + "_pressed_mid_step_opens_the_menu", false, "mode=" + string(_gs.ui.mode) + " settled=" + string(Player_IsSettled(_pl)));
                Scenario_NoticeEnd();
            }
            break;
        case 953:   // the menu is up: the pad's Y (the open button) closes it again, as Esc does
            if (_s.t == 1) global.input.last_device = "gamepad";
            if (_s.t > 1 && is_struct(TabMenu_Get()) && !variable_struct_exists(_h, "ytap") && current_time - TabMenu_Get().opened_ms >= UI_INPUT_LOCK_MS + 120) {
                _h.ytap = true;
                _h.ytap_t = _s.t;
                Scenario_Tap("pause");
            }
            if (variable_struct_exists(_h, "ytap") && _s.t > _h.ytap_t + 3) {
                Scenario_Check("hunt6ui_pad_y_closes_the_menu_it_opened", !is_struct(TabMenu_Get()) || TabMenu_Get().closed_ms >= 0);
                Menu_Close(true);
                Scenario_ClearUi();
                Scenario_Next(_s, 954);
            }
            if (_s.t > 90) { Scenario_Check("hunt6ui_pad_y_closes_the_menu_it_opened", false, "mode=" + string(_gs.ui.mode)); Menu_Close(true); Scenario_ClearUi(); Scenario_Next(_s, 954); }
            break;
        case 954:   // Settings > Controls > the Confirm row waits for a key; a pad leaves it with Back / Start, a keyboard X is a key to bind
            SettingsPopup_Ensure();
            var _sp = _gs.ui.settings_popup;
            if (_s.t == 1) {
                global.input.last_device = "keyboard";
                Menu_Open(5);
            }
            if (!variable_struct_exists(_h, "c0") && SettingsPopup_IsOpen("tab") && _s.t > 10 && current_time - _sp.menu.lock_ms >= UI_INPUT_LOCK_MS + 80) {
                _h.c0 = true;
                var _ci = -1;
                for (var _i = 0; _i < array_length(_sp.menu.items); _i++) if (_sp.menu.items[_i].id == "controls") _ci = _i;
                Ui_MenuFixCursor(_sp.menu, max(0, _ci));
                Scenario_Tap("confirm");
                _h.c0_t = _s.t;
            }
            if (variable_struct_exists(_h, "c0") && !variable_struct_exists(_h, "c1") && is_struct(_sp.controls) && _s.t > _h.c0_t + 10) {
                _h.c1 = true;
                Ui_MenuFixCursor(_sp.controls.menu, 0);   // the Confirm row
                Scenario_Tap("confirm");
                _h.c1_t = _s.t;
            }
            if (variable_struct_exists(_h, "c1") && !variable_struct_exists(_h, "c2") && is_struct(_sp.controls) && _sp.controls.capture != "" && _s.t > _h.c1_t + 10 && !InputLock_Active(_sp.controls.lock)) {
                _h.c2 = true;
                Scenario_Check("hunt6ui_capture_the_confirm_row_waits_for_a_key", _sp.controls.capture == "confirm");
                Scenario_Tap("cancel");   // with the keyboard as the last device: the key X is a key to bind, not a cancel
                _h.c2_t = _s.t;
            }
            if (variable_struct_exists(_h, "c2") && !variable_struct_exists(_h, "c3") && _s.t > _h.c2_t + 6) {
                _h.c3 = true;
                Scenario_Check("hunt6ui_capture_a_keyboard_back_press_is_not_a_cancel", is_struct(_sp.controls) && _sp.controls.capture == "confirm");
                global.input.last_device = "gamepad";
                Scenario_Tap("cancel");   // the pad's B
                _h.c3_t = _s.t;
            }
            if (variable_struct_exists(_h, "c3") && !variable_struct_exists(_h, "c4") && _s.t > _h.c3_t + 6) {
                _h.c4 = true;
                Scenario_Check("hunt6ui_capture_pad_b_leaves_press_a_key", is_struct(_sp.controls) && _sp.controls.capture == "");
                Scenario_Check("hunt6ui_capture_pad_b_stays_on_the_controls_page", SettingsPopup_IsOpen("tab") && is_struct(_sp.controls));
                Scenario_Check("hunt6ui_capture_nothing_was_rebound", global.input.bindings.confirm[0] == vk_space);
                if (is_struct(_sp.controls)) Ui_MenuFixCursor(_sp.controls.menu, 0);
                Scenario_Tap("confirm");   // wait for a key again, now with the pad as the last device: the prompt names the pad's Back button
                _h.c4_t = _s.t;
            }
            if (variable_struct_exists(_h, "c4") && !variable_struct_exists(_h, "c5") && is_struct(_sp.controls) && _sp.controls.capture != "" && _s.t > _h.c4_t + 10 && !InputLock_Active(_sp.controls.lock)) {
                _h.c5 = true;
                Scenario_Check("hunt6ui_capture_the_prompt_on_a_pad_names_the_back_button", string_pos("[k:back]", _sp.controls.menu.items[0].help) > 0, _sp.controls.menu.items[0].help);
                Scenario_Tap("menu");   // the pad's Start
                _h.c5_t = _s.t;
            }
            if (variable_struct_exists(_h, "c5") && !variable_struct_exists(_h, "c6") && _s.t > _h.c5_t + 6) {
                _h.c6 = true;
                Scenario_Check("hunt6ui_capture_pad_start_leaves_press_a_key", is_struct(_sp.controls) && _sp.controls.capture == "");
                Menu_Close(true);
                Scenario_ClearUi();
                Scenario_Next(_s, 955);
            }
            if (_s.t > 400) { Scenario_Check("hunt6ui_the_controls_page_flow", false, "c0=" + string(variable_struct_exists(_h, "c0")) + " c1=" + string(variable_struct_exists(_h, "c1")) + " c2=" + string(variable_struct_exists(_h, "c2")) + " c4=" + string(variable_struct_exists(_h, "c4")) + " c5=" + string(variable_struct_exists(_h, "c5"))); Menu_Close(true); Scenario_ClearUi(); Scenario_Next(_s, 955); }
            break;
        case 955:   // Settings > Window: the second press of a quick double press does not answer "Keep this?"; a deliberate one later does
            SettingsPopup_Ensure();
            var _sp2 = _gs.ui.settings_popup;
            if (_s.t == 1) {
                global.input.last_device = "keyboard";
                _h.old_settings = GameSettings_Copy(GameSettings_Ensure());
                Menu_Open(5);
            }
            if (!variable_struct_exists(_h, "k0") && SettingsPopup_IsOpen("tab") && _s.t > 10 && current_time - _sp2.menu.lock_ms >= UI_INPUT_LOCK_MS + 80) {
                _h.k0 = true;
                var _wi = -1;
                for (var _j = 0; _j < array_length(_sp2.menu.items); _j++) if (_sp2.menu.items[_j].id == "window") _wi = _j;
                Scenario_Check("hunt6ui_keep_the_settings_have_a_window_row", _wi >= 0);
                Ui_MenuFixCursor(_sp2.menu, max(0, _wi));
                Scenario_Tap("confirm");   // the first press changes the window mode
                _h.k0_ms = current_time;
            }
            if (variable_struct_exists(_h, "k0") && !variable_struct_exists(_h, "k1") && KeepThis_Active() && current_time - _h.k0_ms >= 120) {
                _h.k1 = true;
                _h.k1_dt = current_time - _h.k0_ms;
                Scenario_Tap("confirm");   // the second press of a quick double press
                _h.k1_t = _s.t;
            }
            if (variable_struct_exists(_h, "k1") && !variable_struct_exists(_h, "k2") && _s.t > _h.k1_t + 6) {
                _h.k2 = true;
                if (_h.k1_dt > 380) show_debug_message("[TEST] SKIP keep: the machine stalled (" + string(_h.k1_dt) + " ms), that was not a quick double press");
                else Scenario_Check("hunt6ui_keep_a_quick_second_press_does_not_answer_keep_this", KeepThis_Active(), "dt=" + string(_h.k1_dt));
            }
            if (variable_struct_exists(_h, "k2") && !variable_struct_exists(_h, "k3") && KeepThis_Active() && current_time - _h.k0_ms >= KEEP_THIS_ANSWER_LOCK_MS + 250) {
                _h.k3 = true;
                Scenario_Tap("confirm");   // a deliberate answer later
                _h.k3_t = _s.t;
            }
            if (variable_struct_exists(_h, "k3") && !variable_struct_exists(_h, "k4") && _s.t > _h.k3_t + 6) {
                _h.k4 = true;
                Scenario_Check("hunt6ui_keep_a_later_confirm_keeps_the_change", !KeepThis_Active());
                GameSettings_Commit(_h.old_settings, true, true);   // put the settings back as they were
                Menu_Close(true);
                Scenario_ClearUi();
                Scenario_Next(_s, 956);
            }
            if (_s.t > 500) { Scenario_Check("hunt6ui_the_keep_this_flow", false, "k0=" + string(variable_struct_exists(_h, "k0")) + " k1=" + string(variable_struct_exists(_h, "k1")) + " k3=" + string(variable_struct_exists(_h, "k3")) + " active=" + string(KeepThis_Active())); if (KeepThis_Active()) KeepThis_Revert(); GameSettings_Commit(_h.old_settings, true, true); Menu_Close(true); Scenario_ClearUi(); Scenario_Next(_s, 956); }
            break;
        case 956:   // goes on with hunt7map (980..), the end of the chain
            Scenario_Next(_s, 980);
            break;
    }
}

// ============================================================================
// Bug hunt 7, map and world (hunt7map), smoke steps 980..989. They go on from the new run of the steps before; the last one calls Scenario_NoticeEnd.
//   980-983: a fresh rm_floor8, the Stranger put 2 tiles from the exit to floor 7, the player leaves and comes back: he is 4 tiles from the exit and nobody is within 3 tiles of the
//            arrival tile (D158 has no exception for him), and the run save already holds him where the clean-up put him (a Continue shows the same room).
//   984-987: the post-Run grace period (battle_cooldown) does not run down while the Tab menu is open, and runs down again once it is closed.
// ============================================================================
function Scenario_StepSmokeHunt7Map(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "h7m")) _s.h7m = {};
    var _h = _s.h7m;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _T = GRID_TILE_SIZE;
    switch (_s.step) {
        case 980:   // a fresh rm_floor8 (its own enemies): via another room, the controller only restores a room on a room change
            if (_s.t == 1) {
                Scenario_Release();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                room_goto(rm_floor7);
            }
            if (_s.t > 20 && room == rm_floor7) {
                room_goto(rm_floor8);
                Scenario_Next(_s, 981);
            }
            if (_s.t > 900) { Scenario_Check("hunt7map_rm_floor7_is_reached", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 981:   // the Stranger 2 tiles from the exit to floor 7; the player on that exit leaves
            if (_s.t > 20 && Scenario_FloorReady(rm_floor8) && Player_IsSettled(_pl)) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _st = instance_exists(obj_stranger) ? instance_find(obj_stranger, 0) : noone;
                Scenario_Check("hunt7map_rm_floor8_has_the_stranger", _st != noone);
                var _ex = noone;
                with (obj_room_transition) { if (transition_id == "floor8_to_floor7") _ex = id; }
                Scenario_Check("hunt7map_the_exit_to_floor_7_is_there", _ex != noone);
                if (_st == noone || _ex == noone) { Scenario_NoticeEnd(); break; }
                with (obj_enemy) { if (id != _st) instance_destroy(); }
                EnemyAI_Init(_st);
                _st.prof.sight = 0;   // he only has to stand there: he followed the player to the exit
                _h.ex_cx = round(_ex.bbox_left / _T);
                _h.ex_cy = round(_ex.bbox_top / _T);
                var _g = Nav_Get().grid;
                var _at = undefined;
                for (var _dy = -2; _dy <= 2 && is_undefined(_at); _dy++) {
                    for (var _dx = -2; _dx <= 2 && is_undefined(_at); _dx++) {
                        var _d = point_distance(0, 0, _dx, _dy);
                        if (_d < 1.9 || _d > 2.5) continue;
                        if (Nav_CellBlocked(_g, _h.ex_cx + _dx, _h.ex_cy + _dy)) continue;
                        _at = [_h.ex_cx + _dx, _h.ex_cy + _dy];
                    }
                }
                Scenario_Check("hunt7map_there_is_a_free_cell_2_tiles_from_the_exit", !is_undefined(_at));
                if (is_undefined(_at)) { Scenario_NoticeEnd(); break; }
                Scenario_PlaceEnemy(_st, _at[0], _at[1]);
                _h.st_pid = _st.persist_id;
                Scenario_PlacePlayer(_h.ex_cx, _h.ex_cy);
                Scenario_Hold(Scenario_Hunt2DirAction(_ex.require_dir), 4);
                Scenario_Next(_s, 982);
            }
            if (_s.t > 900) { Scenario_Check("hunt7map_a_fresh_rm_floor8_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 982:   // in rm_floor7, on the exit back: leave again
            if (_s.t > 5 && Scenario_FloorReady(rm_floor7) && Player_IsSettled(_pl)) {
                Scenario_Release();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _ex2 = instance_position(_pl.x + _T / 2, _pl.y + _T / 2, obj_room_transition);
                Scenario_Check("hunt7map_arrived_in_rm_floor7_on_an_exit", _ex2 != noone);
                if (_ex2 == noone) { Scenario_NoticeEnd(); break; }
                Scenario_Hold(Scenario_Hunt2DirAction(_ex2.require_dir), 6);
                Scenario_Next(_s, 983);
            }
            if (_s.t > 900) { Scenario_Check("hunt7map_the_player_arrives_in_rm_floor7", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 983:   // back in rm_floor8, looked at on the first frame after the arrival was applied (before he can react)
            if (room == rm_floor8 && instance_exists(obj_player) && instance_exists(obj_stranger) && !_gs.transition.pending) {
                Scenario_Release();
                var _st2 = instance_find(obj_stranger, 0);
                var _cs = Scenario_H11Cell(_st2);
                var _pc = Scenario_H11Cell(_pl);
                Scenario_Check("hunt7map_the_player_arrived_on_the_exit_he_left_by", _pc.cx == _h.ex_cx && _pc.cy == _h.ex_cy, "player at " + string(_pc.cx) + "," + string(_pc.cy));
                Scenario_Check("hunt7map_the_stranger_who_waited_at_the_exit_is_4_tiles_from_it", point_distance(_cs.cx, _cs.cy, _h.ex_cx, _h.ex_cy) >= AI_EXIT_RELOCATE_TILES, "stranger at " + string(_cs.cx) + "," + string(_cs.cy));
                var _near = 0;
                with (obj_enemy) { if (point_distance(Nav_CellOf(x + 8), Nav_CellOf(y + 8), _pc.cx, _pc.cy) < AI_ARRIVAL_CLEAR_TILES) _near++; }
                Scenario_Check("hunt7map_nobody_within_3_tiles_of_the_arrival_tile_the_stranger_included", _near == 0, "near=" + string(_near));
                // a Continue loads what the run save holds: it must hold him where the clean-up put him
                var _lv = RunSave_Build().levelData;
                var _key = RoomState_Key(rm_floor8, _h.st_pid);
                var _rec = variable_struct_exists(_lv, _key) ? variable_struct_get(_lv, _key) : undefined;
                Scenario_Check("hunt7map_the_run_save_has_the_stranger", is_struct(_rec) && is_struct(_rec.vars) && variable_struct_exists(_rec.vars, "x") && variable_struct_exists(_rec.vars, "y"));
                if (is_struct(_rec) && is_struct(_rec.vars) && variable_struct_exists(_rec.vars, "x")) {
                    var _sx = Nav_CellOf(_rec.vars.x + _T / 2);
                    var _sy = Nav_CellOf(_rec.vars.y + _T / 2);
                    Scenario_Check("hunt7map_the_run_save_holds_him_where_the_clean_up_put_him_4_tiles_from_the_exit", point_distance(_sx, _sy, _h.ex_cx, _h.ex_cy) >= AI_EXIT_RELOCATE_TILES, "saved at " + string(_sx) + "," + string(_sy));
                }
                Scenario_Next(_s, 984);
            }
            if (_s.t > 900) { Scenario_Release(); Scenario_Check("hunt7map_the_player_is_back_in_rm_floor8", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 984:   // a quiet map, the grace period full, the Tab menu opened
            if (_s.t > 10 && Scenario_FloorReady(rm_floor8) && Player_IsSettled(_pl) && _gs.ui.mode == UI_NONE) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                _pl.battle_cooldown = BATTLE_COOLDOWN_FRAMES;
                Scenario_Tap("menu");
                Scenario_Next(_s, 985);
            }
            if (_s.t > 900) { Scenario_Check("hunt7map_the_map_is_free_for_the_menu", false, "room=" + room_get_name(room) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 985:   // 40 frames with the menu open: the grace period has not run down
            if (!variable_struct_exists(_h, "cd0")) {
                if (_gs.ui.mode == UI_MENU && is_struct(TabMenu_Get())) {
                    _h.cd0 = _pl.battle_cooldown;
                    _h.cd_f = _s.f;
                }
            } else if (_s.f - _h.cd_f >= 40) {
                Scenario_Check("hunt7map_the_grace_period_does_not_run_down_while_the_menu_is_open", _pl.battle_cooldown == _h.cd0, "was " + string(_h.cd0) + " now " + string(_pl.battle_cooldown));
                Scenario_Check("hunt7map_the_menu_was_open_all_that_time", _gs.ui.mode == UI_MENU);
                Menu_Close(true);
                Scenario_ClearUi();
                Scenario_Next(_s, 986);
            }
            if (_s.t > 300) { Scenario_Check("hunt7map_the_tab_menu_opens", false, "mode=" + string(_gs.ui.mode)); Menu_Close(true); Scenario_ClearUi(); Scenario_NoticeEnd(); }
            break;
        case 986:   // the menu is closed: the grace period runs down again
            if (_s.t == 12) {
                Scenario_Check("hunt7map_the_grace_period_runs_down_again_once_the_menu_is_closed", _pl.battle_cooldown < _h.cd0, "was " + string(_h.cd0) + " now " + string(_pl.battle_cooldown));
                Scenario_Next(_s, 987);
            }
            break;
        case 987:   // goes on with the round 3 menus (1040..1045), the end of the chain
            Scenario_Next(_s, 1040);
            break;
    }
}

// ============================================================================
// Round 3 menus (R3 notes 9, 21, 25; D171; R-096, R-097), smoke steps 1040..1049: the Controls page's "Reset to Defaults" through real keys. One key is rebound, Reset asks (the cursor
// on No), No and Esc change nothing, Yes puts the defaults back and a notice says so, the changed row flashes once the notice is gone; a second Reset says the keys were already the
// defaults. They go on from the step before (hunt7map, 980..987) and the last one calls Scenario_NoticeEnd.
// ============================================================================
function Scenario_R3RowIndex(_menu, _id) {
    for (var _i = 0; _i < array_length(_menu.items); _i++) if (_menu.items[_i].id == _id) return _i;
    return -1;
}

function Scenario_R3Abort(_s, _what, _detail) {
    Scenario_Check(_what, false, _detail);
    Confirm_Close();
    Notice_Interrupt();
    Menu_Close(true);
    Scenario_ClearUi();
    Settings_SetKeys(Binds_Defaults());
    Scenario_NoticeEnd();
}

function Scenario_StepSmokeR3Menus(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "r3m")) _s.r3m = {};
    var _h = _s.r3m;
    SettingsPopup_Ensure();
    var _sp = _gs.ui.settings_popup;
    var _ask = "Reset every key to its default?";
    var _run_f = string([ord("F")]);
    switch (_s.step) {
        case 1040:   // Settings > Controls with the keyboard: the Run row waits for a key and takes F (the key press itself is the page's own entry point)
            if (_s.t == 1) {
                Scenario_ClearUi();
                Dialogue_CloseNow();
                global.input.last_device = "keyboard";
                Settings_SetKeys(Binds_Defaults());
                Menu_Open(5);
            }
            if (!variable_struct_exists(_h, "c0") && SettingsPopup_IsOpen("tab") && _s.t > 10 && current_time - _sp.menu.lock_ms >= UI_INPUT_LOCK_MS + 80) {
                _h.c0 = true;
                Ui_MenuFixCursor(_sp.menu, max(0, Scenario_R3RowIndex(_sp.menu, "controls")));
                Scenario_Tap("confirm");
                _h.c0_t = _s.t;
            }
            if (variable_struct_exists(_h, "c0") && !variable_struct_exists(_h, "c1") && is_struct(_sp.controls) && _s.t > _h.c0_t + 10) {
                _h.c1 = true;
                Ui_MenuFixCursor(_sp.controls.menu, max(0, Scenario_R3RowIndex(_sp.controls.menu, "run")));
                Scenario_Tap("confirm");
                _h.c1_t = _s.t;
            }
            if (variable_struct_exists(_h, "c1") && !variable_struct_exists(_h, "c2") && is_struct(_sp.controls) && _sp.controls.capture == "run" && _s.t > _h.c1_t + 10 && !InputLock_Active(_sp.controls.lock)) {
                _h.c2 = true;
                ControlsPage_OnKey(_sp, ord("F"));
                _h.c2_t = _s.t;
            }
            if (variable_struct_exists(_h, "c2") && _s.t > _h.c2_t + 6) {
                Scenario_Check("r3menus_run_was_rebound_to_f", string(GameSettings_Ensure().keys.run) == _run_f, string(GameSettings_Ensure().keys.run));
                Scenario_Next(_s, 1041);
            }
            if (_s.t > 400) Scenario_R3Abort(_s, "r3menus_the_controls_page_opens_and_takes_a_key", "c0=" + string(variable_struct_exists(_h, "c0")) + " c1=" + string(variable_struct_exists(_h, "c1")) + " c2=" + string(variable_struct_exists(_h, "c2")));
            break;
        case 1041:   // Reset to Defaults asks first, the cursor on No: No keeps the key, so does Esc
            if (_s.t == 10) {
                Ui_MenuFixCursor(_sp.controls.menu, max(0, Scenario_R3RowIndex(_sp.controls.menu, "reset")));
                Scenario_Tap("confirm");
                _h.r0_t = _s.t;
            }
            if (variable_struct_exists(_h, "r0_t") && !variable_struct_exists(_h, "r1") && Confirm_IsOpen() && _s.t > _h.r0_t + 6 && current_time - Confirm_Menu().lock_ms >= UI_INPUT_LOCK_MS + 80) {
                _h.r1 = true;
                Scenario_Check("r3menus_reset_asks_first", Confirm_Question() == _ask, Confirm_Question());
                Scenario_Check("r3menus_the_question_starts_on_no", Confirm_Menu().cursor == 1);
                Scenario_Check("r3menus_asking_changed_no_key", string(GameSettings_Ensure().keys.run) == _run_f);
                Scenario_Check("r3menus_asking_pops_no_notice_yet", !Notice_IsOpen());
                Scenario_Tap("confirm");   // No
                _h.r1_t = _s.t;
            }
            if (variable_struct_exists(_h, "r1") && !variable_struct_exists(_h, "r2") && _s.t > _h.r1_t + 8) {
                _h.r2 = true;
                Scenario_Check("r3menus_no_closes_the_question", !Confirm_IsOpen());
                Scenario_Check("r3menus_no_keeps_the_custom_key", string(GameSettings_Ensure().keys.run) == _run_f);
                Scenario_Check("r3menus_no_pops_no_notice", !Notice_IsOpen());
                Scenario_Check("r3menus_no_stays_on_the_controls_page", is_struct(_sp.controls) && _gs.ui.mode == UI_MENU);
                Scenario_Tap("confirm");   // the cursor is still on Reset: ask again
                _h.r2_t = _s.t;
            }
            if (variable_struct_exists(_h, "r2") && !variable_struct_exists(_h, "r3") && Confirm_IsOpen() && _s.t > _h.r2_t + 6 && current_time - Confirm_Menu().lock_ms >= UI_INPUT_LOCK_MS + 80) {
                _h.r3 = true;
                Scenario_Tap("esc");   // Back is No
                _h.r3_t = _s.t;
            }
            if (variable_struct_exists(_h, "r3") && _s.t > _h.r3_t + 8) {
                Scenario_Check("r3menus_esc_closes_the_question", !Confirm_IsOpen());
                Scenario_Check("r3menus_esc_keeps_the_custom_key", string(GameSettings_Ensure().keys.run) == _run_f);
                Scenario_Check("r3menus_esc_pops_no_notice", !Notice_IsOpen());
                Scenario_Next(_s, 1042);
            }
            if (_s.t > 400) Scenario_R3Abort(_s, "r3menus_reset_asks_and_no_changes_nothing", "r0=" + string(variable_struct_exists(_h, "r0_t")) + " r1=" + string(variable_struct_exists(_h, "r1")) + " r2=" + string(variable_struct_exists(_h, "r2")) + " r3=" + string(variable_struct_exists(_h, "r3")) + " open=" + string(Confirm_IsOpen()));
            break;
        case 1042:   // Reset, Yes: the defaults are back and a notice says so, over the open menu
            if (_s.t == 6) {
                Scenario_Tap("confirm");
                _h.y0_t = _s.t;
            }
            if (variable_struct_exists(_h, "y0_t") && !variable_struct_exists(_h, "y1") && Confirm_IsOpen() && _s.t > _h.y0_t + 6 && current_time - Confirm_Menu().lock_ms >= UI_INPUT_LOCK_MS + 80) {
                _h.y1 = true;
                Scenario_Tap("menu_up");   // No -> Yes
                _h.y1_t = _s.t;
            }
            if (variable_struct_exists(_h, "y1") && !variable_struct_exists(_h, "y2") && _s.t > _h.y1_t + 8) {
                _h.y2 = true;
                Scenario_Check("r3menus_the_cursor_moved_to_yes", Confirm_IsOpen() && Confirm_Menu().cursor == 0);
                Scenario_Tap("confirm");   // Yes
                _h.y2_t = _s.t;
            }
            if (variable_struct_exists(_h, "y2") && !variable_struct_exists(_h, "y3") && _s.t > _h.y2_t + 8) {
                _h.y3 = true;
                Scenario_Check("r3menus_yes_puts_the_default_run_key_back", string(GameSettings_Ensure().keys.run) == string(Binds_Defaults().run), string(GameSettings_Ensure().keys.run));
                Scenario_Check("r3menus_yes_closes_the_question", !Confirm_IsOpen());
                Scenario_Check("r3menus_yes_opens_the_notice", Notice_IsOpen() && Notice_Text() == "Keys are back to the defaults.", Notice_Text());
                Scenario_Check("r3menus_the_menu_stays_open_under_the_notice", _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()) && is_struct(_sp.controls));
                Scenario_Check("r3menus_the_changed_row_is_marked_to_flash", is_struct(_sp.controls) && string(_sp.controls.flash_rows) == string(["run"]), is_struct(_sp.controls) ? string(_sp.controls.flash_rows) : "no page");
                Scenario_Check("r3menus_the_flash_waits_for_the_notice", is_struct(_sp.controls) && _sp.controls.flash_at < 0);
                Scenario_Check("r3menus_the_bindings_in_use_are_the_defaults", global.input.bindings.run[0] == vk_shift);
                Scenario_Next(_s, 1043);
            }
            if (_s.t > 400) Scenario_R3Abort(_s, "r3menus_reset_yes_flow", "y0=" + string(variable_struct_exists(_h, "y0_t")) + " y1=" + string(variable_struct_exists(_h, "y1")) + " y2=" + string(variable_struct_exists(_h, "y2")) + " open=" + string(Confirm_IsOpen()));
            break;
        case 1043:   // the notice is answered; the menu is still there and the changed row flashes
            if (!variable_struct_exists(_h, "n0") && Notice_CanAnswer()) {
                _h.n0 = true;
                Scenario_Tap("confirm");
                _h.n0_t = _s.t;
            }
            if (variable_struct_exists(_h, "n0") && !variable_struct_exists(_h, "n1") && !Notice_IsOpen() && _s.t > _h.n0_t + 6) {
                _h.n1 = true;
                _h.n1_t = _s.t;
                Scenario_Check("r3menus_the_notice_is_gone", !Notice_IsOpen());
                Scenario_Check("r3menus_the_menu_is_still_open_after_the_notice", _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()) && SettingsPopup_IsOpen("tab") && is_struct(_sp.controls));
            }
            if (variable_struct_exists(_h, "n1") && _s.t > _h.n1_t + 3) {
                var _fi = is_struct(_sp.controls) ? Scenario_R3RowIndex(_sp.controls.menu, "run") : -1;
                Scenario_Check("r3menus_the_flash_started_when_the_notice_closed", is_struct(_sp.controls) && _sp.controls.flash_at >= 0 && _sp.controls.flash_at <= current_time);
                Scenario_Check("r3menus_the_run_row_carries_the_flash", _fi >= 0 && _sp.controls.menu.items[_fi].flash_at == _sp.controls.flash_at);
                Scenario_Check("r3menus_a_row_that_did_not_change_does_not_flash", is_struct(_sp.controls) && !variable_struct_exists(_sp.controls.menu.items[Scenario_R3RowIndex(_sp.controls.menu, "up")], "flash_at"));
                Scenario_Next(_s, 1044);
            }
            if (_s.t > 400) Scenario_R3Abort(_s, "r3menus_the_notice_is_answered", "n0=" + string(variable_struct_exists(_h, "n0")) + " open=" + string(Notice_IsOpen()));
            break;
        case 1044:   // Reset again with nothing to reset: the notice says the keys were already the defaults, and nothing flashes
            if (_s.t == 40) {   // let the first flash run out so a flash that did start would show as new
                Ui_MenuFixCursor(_sp.controls.menu, max(0, Scenario_R3RowIndex(_sp.controls.menu, "reset")));
                Scenario_Tap("confirm");
                _h.a0_t = _s.t;
            }
            if (variable_struct_exists(_h, "a0_t") && !variable_struct_exists(_h, "a1") && Confirm_IsOpen() && _s.t > _h.a0_t + 6 && current_time - Confirm_Menu().lock_ms >= UI_INPUT_LOCK_MS + 80) {
                _h.a1 = true;
                Scenario_Tap("menu_up");
                _h.a1_t = _s.t;
            }
            if (variable_struct_exists(_h, "a1") && !variable_struct_exists(_h, "a2") && _s.t > _h.a1_t + 8) {
                _h.a2 = true;
                Scenario_Tap("confirm");   // Yes
                _h.a2_t = _s.t;
            }
            if (variable_struct_exists(_h, "a2") && !variable_struct_exists(_h, "a3") && _s.t > _h.a2_t + 8) {
                _h.a3 = true;
                Scenario_Check("r3menus_the_second_reset_says_already_the_defaults", Notice_IsOpen() && Notice_Text() == "Keys were already the defaults.", Notice_Text());
                Scenario_Check("r3menus_the_second_reset_flashes_no_row", is_struct(_sp.controls) && array_length(_sp.controls.flash_rows) == 0);
                _h.a3_t = _s.t;
            }
            if (variable_struct_exists(_h, "a3") && !variable_struct_exists(_h, "a4") && Notice_CanAnswer()) {
                _h.a4 = true;
                Scenario_Tap("confirm");
                _h.a4_t = _s.t;
            }
            if (variable_struct_exists(_h, "a4") && _s.t > _h.a4_t + 8 && !Notice_IsOpen()) {
                Scenario_Check("r3menus_the_menu_is_open_after_the_second_notice", _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()) && is_struct(_sp.controls));
                Scenario_Next(_s, 1045);
            }
            if (_s.t > 500) Scenario_R3Abort(_s, "r3menus_the_second_reset_flow", "a0=" + string(variable_struct_exists(_h, "a0_t")) + " a1=" + string(variable_struct_exists(_h, "a1")) + " a2=" + string(variable_struct_exists(_h, "a2")) + " a3=" + string(variable_struct_exists(_h, "a3")) + " a4=" + string(variable_struct_exists(_h, "a4")) + " open=" + string(Confirm_IsOpen()) + "/" + string(Notice_IsOpen()));
            break;
        case 1045:   // the end of the chain: removes the files and the profile the steps made
            Menu_Close(true);
            Scenario_ClearUi();
            Settings_SetKeys(Binds_Defaults());
            Scenario_Next(_s, 1000);   // goes on with r3light (1000..1004), the end of the chain
            break;
    }
}

// Round 3, packet light (R-089, R-090, R-091), smoke steps 1000..1004. They go on from hunt7map (987); the last one calls Scenario_NoticeEnd.
//   1000-1001: a walk of 6 tiles and then a run of 8 in rm_floor1 (a Foreground layer over the Instances) and in rm_floor3 (none), with real key input and Screen shake on:
//              every squashed frame of the player is drawn by the pass at the end of the layer the player is on.
//   1002:      rm_floor1, the same tile, the picture of the player plain and squashed 10 ms in: as bright as each other (the haze over the room must not decide).
//   1003:      on each merchant floor the merchant's cell cuts no part of the floor off, and he can be talked to from a free cell.
// ============================================================================
function Scenario_R3LightDir(_pl, _last) {
    var _opts = [
        { act: "move_left", dx: -1, dy: 0 }, { act: "move_right", dx: 1, dy: 0 },
        { act: "move_up", dx: 0, dy: -1 }, { act: "move_down", dx: 0, dy: 1 }
    ];
    var _order = [];   // the last way first, then the sides, then back
    if (_last >= 0) array_push(_order, _last);
    for (var _i = 0; _i < 4; _i++) {
        if (_i == _last) continue;
        if (_last >= 0 && _opts[_i].dx == -_opts[_last].dx && _opts[_i].dy == -_opts[_last].dy) continue;
        array_push(_order, _i);
    }
    if (_last >= 0) {
        for (var _j = 0; _j < 4; _j++) {
            if (_opts[_j].dx == -_opts[_last].dx && _opts[_j].dy == -_opts[_last].dy) array_push(_order, _j);
        }
    }
    for (var _o = 0; _o < array_length(_order); _o++) {
        var _c = _order[_o];
        var _nx = _pl.x + _opts[_c].dx * 16;
        var _ny = _pl.y + _opts[_c].dy * 16;
        if (Player_TileBlocked(_pl, _nx, _ny)) continue;
        if (instance_position(_nx + 8, _ny + 8, obj_room_transition) != noone) continue;   // never walk out of the room
        if (instance_position(_nx + 8, _ny + 8, obj_npc) != noone) continue;
        return { i: _c, act: _opts[_c].act };
    }
    return undefined;
}

// How many floor cells the player can reach from his own, with the cell (_bx, _by) blocked as well; near: a free neighbour of that cell was reached; hit: the cell (_hx, _hy) was reached.
function Scenario_R3LightReach(_g, _sx, _sy, _bx, _by, _hx = -100, _hy = -100) {
    var _seen = array_create(_g.w * _g.h, false);
    var _q = [_sy * _g.w + _sx];
    _seen[_sy * _g.w + _sx] = true;
    var _n = 0;
    var _near = false;
    var _hit = false;
    var _dxs = [1, 0, -1, 0];
    var _dys = [0, -1, 0, 1];
    while (array_length(_q) > 0) {
        var _cur = _q[0];
        array_delete(_q, 0, 1);
        _n++;
        var _cx = _cur mod _g.w;
        var _cy = _cur div _g.w;
        if (_cx == _hx && _cy == _hy) _hit = true;
        if (abs(_cx - _bx) + abs(_cy - _by) == 1) _near = true;
        for (var _d = 0; _d < 4; _d++) {
            var _nx = _cx + _dxs[_d];
            var _ny = _cy + _dys[_d];
            if (!Nav_GridInside(_g, _nx, _ny)) continue;
            if (_nx == _bx && _ny == _by) continue;
            if (Nav_CellBlocked(_g, _nx, _ny)) continue;
            if (_seen[_ny * _g.w + _nx]) continue;
            _seen[_ny * _g.w + _nx] = true;
            array_push(_q, _ny * _g.w + _nx);
        }
    }
    return { n: _n, near: _near, hit: _hit };
}

function Scenario_StepSmokeR3Light(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "r3l")) _s.r3l = { ri: 0, mi: 0, tiles: 0, dir: -1, cell: -1, run: false, sq: 0 };
    var _h = _s.r3l;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _walk_rooms = [rm_floor1, rm_floor3];
    var _merch_rooms = [rm_floor2, rm_floor5, rm_floor8];
    switch (_s.step) {
        case 1000:   // a room to walk in
            if (_h.ri >= array_length(_walk_rooms)) { Scenario_Next(_s, 1002); break; }
            if (_s.t == 1) {
                Scenario_Release();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                MapFx_Clear();
                room_goto(_walk_rooms[_h.ri]);
            }
            if (_s.t > 40 && Scenario_FloorReady(_walk_rooms[_h.ri]) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();   // the room's enemies would start a fight
                Dialogue_CloseNow();
                Scenario_ClearUi();
                GameSettings_Ensure().screen_shake = 1;
                global.player_draw_log = { n: 0, layers: {} };
                _h.tiles = 0;
                _h.dir = -1;
                _h.cell = -1;
                _h.run = false;
                _h.sq = 0;
                Scenario_Next(_s, 1001);
            }
            if (_s.t > 900) { Scenario_Check("r3light_" + room_get_name(_walk_rooms[_h.ri]) + "_is_reached", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 1001:   // 6 tiles walked, then 8 run: one key press per tile, as a player holds them
            if (!instance_exists(_pl)) { Scenario_Check("r3light_the_player_exists", false); Scenario_NoticeEnd(); break; }
            if (_pl.squash_on) _h.sq++;
            if (_gs.ui.mode != UI_NONE || array_length(_gs.ui.lines) > 0) { Dialogue_CloseNow(); Scenario_ClearUi(); }
            if (Player_IsSettled(_pl)) {
                var _cell = round(_pl.x / 16) + round(_pl.y / 16) * 1000;
                if (_cell != _h.cell) { _h.cell = _cell; _h.tiles++; }
                if (_h.tiles > 6) _h.run = true;
                if (_h.tiles > 14) {
                    var _name = room_get_name(room);
                    var _log = variable_global_exists("player_draw_log") ? global.player_draw_log : { n: 0, layers: {} };
                    var _lname = layer_get_name(_pl.layer);
                    var _on_own = variable_struct_exists(_log.layers, _lname) ? variable_struct_get(_log.layers, _lname) : 0;
                    Scenario_Release();
                    Scenario_Check("r3light_" + _name + "_the_player_squashed_while_he_walked_and_ran", _h.sq >= 6 && _log.n >= 6, "squash frames=" + string(_h.sq) + " drawn=" + string(_log.n));
                    Scenario_Check("r3light_" + _name + "_every_squash_frame_is_drawn_at_the_end_of_the_layer_the_player_is_on", _log.n > 0 && _on_own == _log.n, "player layer=" + _lname + " passes=" + json_stringify(_log.layers));
                    _h.ri++;
                    Scenario_Next(_s, 1000);
                    break;
                }
                var _d = Scenario_R3LightDir(_pl, _h.dir);
                if (is_struct(_d)) {
                    _h.dir = _d.i;
                    _pl.face = [LEFT, RIGHT, UP, DOWN][_d.i];
                    Scenario_Hold(_d.act, 2);
                    if (_h.run) Scenario_Hold("run", 2);
                }
            }
            if (_s.t > 1500) { Scenario_Release(); Scenario_Check("r3light_the_walk_and_run_end", false, "tiles=" + string(_h.tiles) + " room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 1002:   // rm_floor1 again: the same tile, the player plain and squashed, in the same light and under the same haze
            if (_s.t == 1) {
                Scenario_Release();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                MapFx_Clear();
                room_goto(rm_floor1);
            }
            if (_s.t < 40 || !Scenario_FloorReady(rm_floor1) || !Player_IsSettled(_pl)) {
                if (_s.t > 900) { Scenario_Check("r3light_rm_floor1_is_reached_for_the_picture_check", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
                break;
            }
            if (!variable_struct_exists(_h, "p")) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                GameSettings_Ensure().screen_shake = 1;
                var _now = MapFx_Now();
                _h.p = { f: _s.f, now: _now };
                global.mapfx_clock = _now;   // a frozen clock: the flicker of the fire and the squash do not move between the two pictures
                global.light_clock = _now;
                _pl.squash_start = _now - 1000;   // plain: the squash is long over
            }
            if (_s.f == _h.p.f + 4) {
                _h.p.lum_plain = Scenario_AppBoxLuminance(_pl.x, _pl.y, 16, 16);
                Scenario_Check("r3light_the_plain_player_is_drawn_for_the_control", _pl.visible && !_pl.squash_on);
                _pl.squash_start = _h.p.now - 10;   // squashed: 10 ms into it
            }
            if (_s.f == _h.p.f + 8) {
                _h.p.lum_sq = Scenario_AppBoxLuminance(_pl.x, _pl.y, 16, 16);
                Scenario_Check("r3light_the_squashed_player_is_drawn", _pl.squash_on && !_pl.visible);
                Scenario_Check("r3light_the_squashed_player_is_as_bright_as_the_plain_one", abs(_h.p.lum_sq - _h.p.lum_plain) <= _h.p.lum_plain * 0.12 + 3, "plain=" + string(_h.p.lum_plain) + " squashed=" + string(_h.p.lum_sq));
                global.mapfx_clock = -1;
                global.light_clock = -1;
                _pl.squash_start = -100000;
                Scenario_Next(_s, 1003);
            }
            if (_s.t > 300) { Scenario_Check("r3light_the_picture_check_ends", false); Scenario_NoticeEnd(); }
            break;
        case 1003:   // each merchant floor: the merchant cuts no part of the floor off and has a free cell next to him
            if (_h.mi >= array_length(_merch_rooms)) { Scenario_Next(_s, 1004); break; }
            if (_s.t == 1) {
                Dialogue_CloseNow();
                Scenario_ClearUi();
                MapFx_Clear();
                room_goto(_merch_rooms[_h.mi]);
            }
            if (_s.t > 40 && Scenario_FloorReady(_merch_rooms[_h.mi])) {
                var _name2 = room_get_name(room);
                var _mer = Merchant_EnsureInRoom();
                Scenario_Check("r3light_" + _name2 + "_has_a_merchant", _mer != noone);
                if (_mer != noone) {
                    var _g = Nav_Get().grid;
                    var _mcx = round(_mer.x / 16);
                    var _mcy = round(_mer.y / 16);
                    var _pcx = round(_pl.x / 16);
                    var _pcy = round(_pl.y / 16);
                    // the merchant is an interactable: his own cell is blocked in the grid; take that off for the count without him, then make the grid build again
                    _g.block[_mcy * _g.w + _mcx] = 0;
                    var _free = Scenario_R3LightReach(_g, _pcx, _pcy, -100, -100, _mcx, _mcy);
                    var _with = Scenario_R3LightReach(_g, _pcx, _pcy, _mcx, _mcy);
                    Nav_Get().nw = -1;
                    var _px8 = _mcx * 16 + 8;
                    var _py8 = _mcy * 16 + 8;
                    Scenario_Check("r3light_" + _name2 + "_the_merchants_cell_is_a_floor_cell", instance_position(_px8, _py8, obj_wall) == noone && instance_position(_px8, _py8, obj_room_transition) == noone && _free.hit, "cell=" + string(_mcx) + "," + string(_mcy));
                    Scenario_Check("r3light_" + _name2 + "_the_merchant_cuts_no_part_of_the_floor_off", _free.hit && _with.n == _free.n - 1, "reach without=" + string(_free.n) + " with=" + string(_with.n));
                    Scenario_Check("r3light_" + _name2 + "_a_free_cell_next_to_the_merchant_can_be_reached", _with.near);
                }
                _h.mi++;
                _s.t = 0;
            }
            if (_s.t > 900) { Scenario_Check("r3light_a_merchant_floor_is_reached", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 1004:   // goes on with r3stealth (1050..1059), the end of the chain
            Scenario_Next(_s, 1050);
            break;
    }
}

// ============================================================================
// Round 3 packet stealth (D179; R-098, R-099), smoke steps 1050..1059 (rm_floor3, the game's own input state; the end of the chain: the last step calls Scenario_NoticeEnd).
//   1050-1053: a slime facing left at (5,6) spots the player 3 tiles ahead of it at (2,6): "!", it turns to him. He RUNS away (down three tiles, then right along row 9 straight
//              through the bush patch (5..7,9), which he can walk into). The slime walks to the last cell it saw him on, STANDS there searching about 3 s, puts up ONE "?",
//              goes home (5,6) and is idle there within 7 s of the spot, and cannot notice him for 2 s from the moment it gives up (spot_cooldown 120).
//   1054-1055: R-099 re-acquire: the slime has just given up, the player stands in plain view 3 tiles in front of it: nothing for 110 frames, then it notices him.
//   1056-1058: hiding: the player stands still in the bush patch (3,5): hidden, drawn see-through. A slime walks home along row 7 past the edge of its cone (2 tiles diagonally
//              from him): no sighting. The control: the same pass with the player standing in the open on (4,5): spotted.
// ============================================================================
function Scenario_StepSmokeR3Stealth(_s) {
    if (!variable_struct_exists(_s, "st")) _s.st = { };
    var _h = _s.st;
    var _T = GRID_TILE_SIZE;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _e = (variable_struct_exists(_h, "e") && instance_exists(_h.e)) ? _h.e : noone;
    switch (_s.step) {
        case 1050:   // rm_floor3 by a real room change; the slime at (5,6) facing left, the player at (2,6)
            if (asset_get_index("Bush_Patches") == -1 || asset_get_index("EnemyAI_GiveUp") == -1) { Scenario_Check("r3stealth_the_stealth_code_exists", false); Scenario_NoticeEnd(); break; }
            if (_s.t == 1) {
                Scenario_Release();
                Scenario_ClearUi();
                Dialogue_CloseNow();
                Scenario_NewKnight(CLASS_KNIGHT);
                room_goto(rm_floor2);
            }
            if (_s.t == 30 && room == rm_floor2) room_goto(rm_floor3);
            if (_s.t > 70 && Scenario_FloorReady(rm_floor3) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                var _pp = Bush_Patches("rm_floor3");
                var _made = (array_length(_pp) >= 2);
                var _cells = 0;
                for (var _i = 0; _i < array_length(_pp); _i++) {
                    for (var _k = 0; _k < array_length(_pp[_i]); _k++) {
                        _cells++;
                        if (instance_position(_pp[_i][_k][0] * _T + _T / 2, _pp[_i][_k][1] * _T + _T / 2, obj_tall_grass) == noone) _made = false;
                    }
                }
                Scenario_Check("r3stealth_the_bushes_of_rm_floor3_stand_in_the_room", _made && _cells >= 4, "cells=" + string(_cells));
                Scenario_Check("r3stealth_the_bush_patch_on_row_9_is_where_the_run_goes", Hide_IsCell("rm_floor3", 5, 9) && Hide_IsCell("rm_floor3", 6, 9) && Hide_IsCell("rm_floor3", 7, 9));
                _h.e = Scenario_H11Enemy(obj_slime, 5, 6, -1, LEFT);
                Scenario_PlacePlayer(2, 6);
                _pl.face = DOWN;   // already facing the way he will run: a tap on a new direction only turns (D69)
                _h.f0 = _s.f;
                Scenario_Next(_s, 1051);
            }
            if (_s.t > 600) { Scenario_Check("r3stealth_rm_floor3_is_ready", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 1051:   // spotted at once (3 tiles ahead, in its cone)
            if (_e == noone) { Scenario_Check("r3stealth_the_slime_is_alive", false); Scenario_NoticeEnd(); break; }
            if (_e.ai_mode == "chase") {
                _h.spot_f = _s.f;
                Scenario_Check("r3stealth_a_slime_facing_the_player_3_tiles_away_spots_him", _s.f - _h.f0 <= 20, "after " + string(_s.f - _h.f0) + " frames");
                Scenario_Check("r3stealth_the_exclamation_mark_is_up", _e.alert_pop > 0);
                Scenario_Check("r3stealth_it_faces_him", _e.look_dir == LEFT);
                _h.search_f = -1;
                _h.return_f = -1;
                _h.home_f = -1;
                _h.moved_in_search = false;
                _h.walked_in_bush = false;
                _h.min_row = 6;
                Scenario_Hold("move_down", 26);   // 3 tiles at the run speed (24 frames)
                Scenario_Hold("run", 80);
                Scenario_Next(_s, 1052);
            }
            if (_s.t > 60) { Scenario_Check("r3stealth_a_slime_facing_the_player_3_tiles_away_spots_him", false, "mode=" + _e.ai_mode); Scenario_NoticeEnd(); }
            break;
        case 1052:   // down three tiles, then right along row 9
            if (_s.t == 27) {
                Scenario_Hold("move_right", 40);   // 5 tiles
                Scenario_Next(_s, 1053);
            }
            break;
        case 1053:   // watch the slime until it is idle at home again
            if (_e == noone) { Scenario_Check("r3stealth_the_slime_is_alive_after_the_run", false); Scenario_NoticeEnd(); break; }
            var _ec = Scenario_H11Cell(_e);
            var _pc = Scenario_H11Cell(_pl);
            if (instance_position(_pl.x + _T / 2, _pl.y + _T / 2, obj_tall_grass) != noone) _h.walked_in_bush = true;
            if (_e.ai_mode == "search") {
                if (_h.search_f < 0) {
                    _h.search_f = _s.f;
                    _h.search_cx = _ec.cx;
                    _h.search_cy = _ec.cy;
                    Scenario_Check("r3stealth_the_search_starts_on_the_last_cell_it_saw_him", _ec.cx == _e.last_seen_cx && _ec.cy == _e.last_seen_cy, "at " + string(_ec.cx) + "," + string(_ec.cy) + " last seen " + string(_e.last_seen_cx) + "," + string(_e.last_seen_cy));
                }
                if (_ec.cx != _h.search_cx || _ec.cy != _h.search_cy) _h.moved_in_search = true;
            }
            if (_e.ai_mode == "return" && _h.return_f < 0) {
                _h.return_f = _s.f;
                _h.cooldown = _e.spot_cooldown;
                _h.pops = _e.q_pops;
            }
            if (_e.ai_mode == "idle" && _h.return_f >= 0 && _h.home_f < 0) {
                _h.home_f = _s.f;
                Scenario_Check("r3stealth_the_slime_is_home_again", _ec.cx == 5 && _ec.cy == 6 && !_e.moving, "at " + string(_ec.cx) + "," + string(_ec.cy));
            }
            if (_h.home_f >= 0 || _s.f - _h.spot_f > 700) {
                Scenario_Release();
                var _took = _h.home_f - _h.spot_f;
                Scenario_Check("r3stealth_it_found_its_way_home", _h.home_f >= 0, "mode=" + _e.ai_mode);
                Scenario_Check("r3stealth_the_slime_is_home_within_7_seconds_of_spotting_him", _h.home_f >= 0 && _took <= 420, "took " + string(_took) + " frames");
                Scenario_Check("r3stealth_it_searched_for_about_3_seconds", _h.search_f >= 0 && _h.return_f >= 0 && (_h.return_f - _h.search_f) >= 150 && (_h.return_f - _h.search_f) <= 230, "frames " + string(_h.return_f - _h.search_f));
                Scenario_Check("r3stealth_it_stood_still_while_it_searched", _h.search_f >= 0 && !_h.moved_in_search);
                Scenario_Check("r3stealth_it_put_up_exactly_one_question_mark", _h.return_f >= 0 && _h.pops == 1 && _e.q_pops == 1, "q_pops=" + string(_e.q_pops));
                Scenario_Check("r3stealth_it_cannot_notice_him_for_2_seconds_after_giving_up", _h.return_f >= 0 && _h.cooldown >= 115 && _h.cooldown <= 120, "cooldown=" + string(variable_struct_exists(_h, "cooldown") ? _h.cooldown : -1));
                Scenario_Check("r3stealth_the_player_walked_through_the_bush_with_real_keys", _h.walked_in_bush);
                Scenario_Check("r3stealth_no_fight_started", room == rm_floor3 && !Transition_IsActive());
                Scenario_Next(_s, 1054);
            }
            break;
        case 1054:   // the slime has just given up; the player stands in plain view 3 tiles in front of it
            if (_e == noone) { Scenario_Check("r3stealth_the_slime_is_alive_for_the_ignore", false); Scenario_NoticeEnd(); break; }
            Scenario_PlaceEnemy(_e, 5, 6);
            _e.look_dir = LEFT;
            _e.turn_timer = 100000;
            _e.idle_timer = 100000;
            _e.ai_mode = "search";
            _e.srch = Search_Create(5, 6, 180);
            EnemyAI_GiveUp(_e);   // as the search does when it is over
            Scenario_PlacePlayer(2, 6);
            _pl.face = RIGHT;
            _h.g0 = _s.f;
            _h.cf = -1;
            Scenario_Next(_s, 1055);
            break;
        case 1055:   // 110 frames of nothing, then it notices him
            if (_e == noone) { Scenario_Check("r3stealth_the_slime_is_alive_in_the_ignore", false); Scenario_NoticeEnd(); break; }
            if (_e.ai_mode == "chase" && _h.cf < 0) _h.cf = _s.f - _h.g0;
            if (_s.t >= 170) {
                Scenario_Check("r3stealth_in_plain_view_it_does_not_notice_him_for_2_seconds_after_giving_up", _h.cf < 0 || _h.cf >= 115, "noticed after " + string(_h.cf) + " frames");
                Scenario_Check("r3stealth_and_then_it_does", _h.cf >= 115 && _h.cf <= 160, "noticed after " + string(_h.cf) + " frames");
                with (obj_enemy) instance_destroy();
                Scenario_Next(_s, 1056);
            }
            break;
        case 1056:   // the player stands still in the bush patch (3,5)
            if (_s.t == 1) {
                Scenario_PlacePlayer(3, 5);
                _pl.face = DOWN;
            }
            if (_s.t == HIDE_SETTLE_FRAMES + 10) {
                Scenario_Check("r3stealth_standing_still_in_the_bush_hides_the_player", Player_IsHidden(_pl));
                Scenario_Check("r3stealth_the_hidden_player_is_drawn_see_through", abs(_pl.image_alpha - HIDE_PLAYER_ALPHA) < 0.01, "alpha=" + string(_pl.image_alpha));
                _h.e = Scenario_H11Enemy(obj_slime, 7, 7, -1, LEFT);   // it walks home along row 7 (2,7), past the edge of its cone: 2 tiles diagonally from the player
                _h.e.ai_mode = "return";
                _h.e.home_cx = 2;
                _h.e.home_cy = 7;
                _h.e.home_x = 2 * _T;
                _h.e.home_y = 7 * _T;
                _h.g0 = _s.f;
                _h.min_cx = 7;
                _h.bad = false;
                Scenario_Next(_s, 1057);
            }
            break;
        case 1057:   // the pass: not seen
            if (_e == noone) { Scenario_Check("r3stealth_the_passing_slime_is_alive", false); Scenario_NoticeEnd(); break; }
            var _ec2 = Scenario_H11Cell(_e);
            _h.min_cx = min(_h.min_cx, _ec2.cx);
            if (_e.ai_mode == "chase" || _e.alert_pop > 0) _h.bad = true;
            if (_s.f - _h.g0 >= 190) {
                Scenario_Check("r3stealth_the_slime_walked_past_the_hidden_player", _h.min_cx <= 3, "min cx " + string(_h.min_cx));
                Scenario_Check("r3stealth_a_slime_passing_the_edge_of_its_cone_2_tiles_from_a_hidden_player_does_not_spot_him", !_h.bad && Player_IsHidden(_pl), "mode=" + _e.ai_mode);
                with (obj_enemy) instance_destroy();
                Scenario_PlacePlayer(4, 5);   // the control: the same pass, the player in the open (not grass) on (4,5)
                _pl.face = DOWN;
                Scenario_Next(_s, 1058);
            }
            break;
        case 1058:   // control: spotted
            if (_s.t == HIDE_SETTLE_FRAMES + 10) {
                Scenario_Check("r3stealth_control_standing_still_in_the_open_does_not_hide", !Player_IsHidden(_pl));
                _h.e = Scenario_H11Enemy(obj_slime, 7, 7, -1, LEFT);
                _h.e.ai_mode = "return";
                _h.e.home_cx = 2;
                _h.e.home_cy = 7;
                _h.e.home_x = 2 * _T;
                _h.e.home_y = 7 * _T;
                _h.g0 = _s.f;
                _h.spotted = false;
            }
            if (_s.t > HIDE_SETTLE_FRAMES + 10) {
                if (instance_exists(_h.e) && _h.e.ai_mode == "chase") _h.spotted = true;
                if (_h.spotted || _s.f - _h.g0 >= 190) {
                    Scenario_Check("r3stealth_control_the_same_pass_in_the_open_spots_him", _h.spotted);
                    with (obj_enemy) instance_destroy();
                    Scenario_Next(_s, 1059);
                }
            }
            break;
        case 1059:   // the end of the chain: removes the files and the profile the steps made
            Scenario_NoticeEnd();
            break;
    }
}

// ---- Round 3 menus pictures 1030..1039: the Gear tab (Equipped and Bag headers, No Armor and No Accessory under them), the Skills tab (the Passives header), the Controls
// page's reset question and the notice after it (in the game), and the same question and notice over the title's settings; windowed scale 3 (480 x 432), 4 (640 x 576) and 5
// (800 x 720) (the Controls scenes at 3 and 5 only), the title ones at 3 only. shot_r3menus_<scene>_<w>x<h>.png. The last pictures of the run: they end it. ----
function Scenario_R3Scenes() {
    return ["gear", "skills", "reset_ask", "reset_notice", "reset_flash", "title_ask", "title_notice"];
}

function Scenario_R3Scales(_di) {
    if (_di >= 5) return [3];
    if (_di >= 2) return [3, 5];   // the Controls page at 640 x 576 cuts its first label ('Confi..': a layout fault of the Settings tab that is not this packet's, reported)
    return [3, 4, 5];
}

function Scenario_R3IsTitle(_di) {
    return (_di >= 5);
}

function Scenario_R3Cleanup() {
    Confirm_Close();
    Notice_Interrupt();
    if (is_struct(TabMenu_Get())) Menu_Close(true);
    SettingsPopup_Close(true);
    Settings_SetKeys(Binds_Defaults());
    Scenario_ClearUi();
}

function Scenario_StepShotsR3Menus(_s) {
    var _scenes = Scenario_R3Scenes();
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "r3s")) _s.r3s = { n: 0, di: 0, si: 0 };
    var _o = _s.r3s;
    var _scales = Scenario_R3Scales(_o.di);
    var _tag = _scenes[_o.di] + "_" + string(_scales[_o.si]);
    var _title = Scenario_R3IsTitle(_o.di);
    var _sc = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    switch (_s.step) {
        case 1030:   // enter the room at this scale: a floor (two take turns) for the in-game scenes, the title for the others
            if (_s.t == 1) {
                Scenario_ClearUi();
                Dialogue_CloseNow();
                Loc_SetLanguage("en");
                if (_title) {
                    Scenario_NewKnight(CLASS_KNIGHT);   // the pictures before this left a character that owes a level-up point: its screen would open over the title
                    CardsUi_Close();
                    Scenario_SetWindowScale(_scales[_o.si]);
                    room_goto(rm_start);
                } else {
                    if (_scenes[_o.di] == "skills") {
                        Scenario_TabFixture();
                    } else {
                        var _g = Scenario_NewKnight(CLASS_KNIGHT);
                        var _k = _g.player_ch;
                        _k.inventory = Inv_Add(_k.inventory, 1, 1);
                        Equip_Item(_k, 1);   // the weapon is worn; armor and accessory are not: two empty slots, and the bag holds an armor, an accessory and a second weapon
                        _k.inventory = Inv_Add(_k.inventory, 22, 1);
                        _k.inventory = Inv_Add(_k.inventory, 40, 1);
                        _k.inventory = Inv_Add(_k.inventory, 2, 1);
                        GameState_SetPlayer(_k);
                    }
                    Scenario_SetWindowScale(_scales[_o.si]);
                    _o.n++;
                    room_goto((_o.n mod 2 == 1) ? rm_floor2 : rm_floor3);
                }
            }
            if (_s.t >= 25) {
                if (_title ? (room == rm_start && _sc != noone) : Scenario_FloorReady((_o.n mod 2 == 1) ? rm_floor2 : rm_floor3)) Scenario_Next(_s, 1031);
            }
            if (_s.t > 600) { Scenario_Check("shots_r3menus_enters_the_room_" + _tag, false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 1031:   // set the scene up
            if (_title) {
                with (obj_start_controller) { if (state == "boot_logo" || state == "splash") state = "main"; }
                with (obj_start_controller) { state = "settings"; }
                SettingsPopup_Open("title");
            } else {
                with (obj_enemy) instance_destroy();
                switch (_scenes[_o.di]) {
                    case "gear":   Menu_Open(3); break;
                    case "skills": Menu_Open(1); break;
                    default:       Menu_Open(5); break;
                }
            }
            if (string_pos("reset", _scenes[_o.di]) == 1 || string_pos("title", _scenes[_o.di]) == 1) {
                SettingsPopup_Ensure();
                var _sp = _gs.ui.settings_popup;
                var _kc = Binds_Copy(Binds_Defaults());
                variable_struct_set(_kc, "run", [ord("F")]);   // one key that is not the default, so the reset has something to change
                Settings_SetKeys(_kc);
            }
            Scenario_Next(_s, 1032);
            break;
        case 1032:   // let the panels settle (the Settings tab opens by itself), open the Controls page and the question, then check and take the picture
            if (string_pos("reset", _scenes[_o.di]) == 1 || string_pos("title", _scenes[_o.di]) == 1) {
                SettingsPopup_Ensure();
                var _sp2 = _gs.ui.settings_popup;
                if (!variable_struct_exists(_s, "r3_c") && SettingsPopup_IsOpen() && _s.t >= 12) {
                    _s.r3_c = true;
                    ControlsPage_Open(_sp2);
                    Ui_MenuFixCursor(_sp2.controls.menu, max(0, Scenario_R3RowIndex(_sp2.controls.menu, "reset")));
                    ControlsPage_OnConfirm(_sp2.controls.menu, Scenario_R3RowIndex(_sp2.controls.menu, "reset"));   // the question
                    if (string_pos("notice", _scenes[_o.di]) > 0 || _scenes[_o.di] == "reset_flash") {
                        Confirm_Resolve(true);   // Yes: the keys are back and the notice opens
                    }
                    if (_scenes[_o.di] == "reset_flash") Notice_Interrupt();   // the picture is of the page after the notice: its changed row blinks
                    _s.r3_t = _s.t;
                }
                if (_scenes[_o.di] == "reset_flash" && variable_struct_exists(_s, "r3_c") && is_struct(_sp2.controls)) {
                    _sp2.controls.flash_at = current_time;   // held on: the blink lasts 600 ms, a picture needs it to be on at the moment it is taken
                    ControlsPage_Refresh(_sp2);
                }
                if (!variable_struct_exists(_s, "r3_c")) {
                    if (_s.t > 300) { Scenario_Check("shots_r3menus_the_settings_open_" + _tag, false); Scenario_R3Cleanup(); Scenario_NoticeEnd(); }
                    break;
                }
                if (_s.t < _s.r3_t + 30) break;   // the pop-up fades in
            } else if (_s.t < 24) {
                break;
            }
            _s.shot = "shot_r3menus_" + _scenes[_o.di] + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
            switch (_scenes[_o.di]) {
                case "gear":
                    Scenario_Check("shots_r3menus_gear_menu_is_open_" + _tag, _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()), "mode=" + string(_gs.ui.mode));
                    Scenario_TabLayoutChecks(_tag);
                    var _gm = TabMenu_TopMenu();
                    var _bagi = Scenario_R3RowIndex(_gm, "head_bag");
                    Scenario_Check("shots_r3menus_gear_has_both_headers_" + _tag, _gm.items[0].kind == "head" && _bagi > 0 && _gm.items[_bagi].kind == "head");
                    Scenario_Check("shots_r3menus_gear_empty_slots_are_dim_rows_" + _tag, _gm.items[Scenario_R3RowIndex(_gm, "empty_body")].dim && _gm.items[Scenario_R3RowIndex(_gm, "empty_accessory")].dim);
                    Scenario_Check("shots_r3menus_gear_cursor_is_on_a_row_" + _tag, _gm.items[_gm.cursor].kind != "head");
                    break;
                case "skills":
                    Scenario_Check("shots_r3menus_skills_menu_is_open_" + _tag, _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()) && TabMenu_Ids()[TabMenu_Get().tab] == "skills", "mode=" + string(_gs.ui.mode));
                    Scenario_TabLayoutChecks(_tag);
                    var _skm = TabMenu_TopMenu();
                    var _pi = Scenario_R3RowIndex(_skm, "head_passives");
                    Scenario_Check("shots_r3menus_skills_has_the_passives_header_" + _tag, _pi > 0 && _skm.items[_pi].kind == "head");
                    break;
                case "reset_ask":
                case "title_ask":
                    Scenario_Check("shots_r3menus_the_question_is_up_" + _tag, Confirm_IsOpen() && Confirm_Question() == "Reset every key to its default?" && Confirm_Menu().cursor == 1, Confirm_IsOpen() ? Confirm_Question() : "none");
                    break;
                case "reset_flash":
                    var _fp = _gs.ui.settings_popup.controls;
                    var _fri = is_struct(_fp) ? Scenario_R3RowIndex(_fp.menu, "run") : -1;
                    Scenario_Check("shots_r3menus_the_run_row_is_flashing_" + _tag, _fri >= 0 && variable_struct_exists(_fp.menu.items[_fri], "flash_at") && Ui_FlashOn(current_time - _fp.menu.items[_fri].flash_at) && !Notice_IsOpen() && string(_fp.flash_rows) == string(["run"]));
                    break;
                case "reset_notice":
                case "title_notice":
                    Scenario_Check("shots_r3menus_the_notice_is_up_" + _tag, Notice_IsOpen() && Notice_Text() == "Keys are back to the defaults.", Notice_Text());
                    break;
            }
            Scenario_ShotLayout(_s.shot);
            Scenario_Next(_s, 1033);
            break;
        case 1033:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_R3Cleanup();
                variable_struct_remove(_s, "r3_c");
                variable_struct_remove(_s, "r3_t");
                if (_title) {
                    with (obj_start_controller) { state = "main"; }
                }
                _o.si++;
                if (_o.si >= array_length(Scenario_R3Scales(_o.di))) { _o.si = 0; _o.di++; }
                if (_o.di >= array_length(_scenes)) {
                    Scenario_SetWindowScale(3);
                    Scenario_Next(_s, 1040);   // goes on with r3stealth (1040..1043), the end of the pictures
                } else {
                    Scenario_Next(_s, 1030);
                }
            }
            break;
    }
}

// ============================================================================
// Round 3 packet stealth (D179, R-098) pictures 1040-1049, three scenes at scale 3 (480 x 432) and scale 5 (800 x 720), shot_r3stealth_<scene>_<w>x<h>.png:
//   dark   rm_floor7 (a dark cave): a spider facing right, the very faint cone in front of it, the player standing behind it, not seen
//   lit    rm_floor2 (the daylight clearing): a dire wolf facing right (sight 4: a longer cone), the player behind it
//   chase  rm_floor3: a slime that chases (a little stronger cone, sight 4 instead of 3)
// The checks at the moment of the picture: exactly one cone was drawn, it is faint (0.10 calm, 0.16 chasing at most), the enemy faces the way the picture is built for,
// and the player stands outside the cone.
// ============================================================================
function Scenario_R3StealthScene(_i) {
    switch (_i) {
        case 0: return { name: "dark", rm: rm_floor7, pcx: 2, pcy: 5, foe: obj_spider, ecx: 5, ecy: 5, face: RIGHT, chase: false, wait: 40 };
        case 1: return { name: "lit", rm: rm_floor2, pcx: 3, pcy: 6, foe: obj_dire_wolf, ecx: 6, ecy: 6, face: RIGHT, chase: false, wait: 40 };
        case 2: return { name: "chase", rm: rm_floor3, pcx: 2, pcy: 6, foe: obj_slime, ecx: 5, ecy: 6, face: RIGHT, chase: true, wait: 40 };
    }
    return undefined;
}

function Scenario_R3StealthJudge(_h, _sc, _pl) {
    var _T = GRID_TILE_SIZE;
    var _tag = "shots_r3stealth_" + _sc.name + "_";
    var _e = instance_exists(_h.e) ? _h.e : noone;
    Scenario_Check(_tag + "the_enemy_is_alive", _e != noone);
    Scenario_Check(_tag + "no_dialogue_is_open", GameState_Get().ui.mode == UI_NONE && array_length(GameState_Get().ui.lines) == 0);
    if (_e == noone) return;
    if (asset_get_index("Sight_ConeStats") == -1) { Scenario_Check(_tag + "the_cone_drawing_exists", false); return; }
    var _st = Sight_ConeStats();
    Scenario_Check(_tag + "exactly_one_cone_was_drawn_with_cells", _st.enemies == 1 && _st.cells > 0, "enemies=" + string(_st.enemies) + " cells=" + string(_st.cells));
    var _max = _sc.chase ? 0.16 : 0.10;
    Scenario_Check(_tag + "the_cone_is_faint", _st.alpha_max >= 0.05 && _st.alpha_max <= _max + 0.0001, "alpha_max=" + string(_st.alpha_max));
    Scenario_Check(_tag + "the_enemy_faces_the_way_the_picture_is_built_for", variable_instance_exists(_e, "look_dir") && _e.look_dir == _sc.face);
    Scenario_Check(_tag + "the_enemy_is_" + (_sc.chase ? "chasing" : "calm"), _sc.chase ? (_e.ai_mode == "chase") : (_e.ai_mode == "idle" && _e.alert_pop == 0), "mode=" + _e.ai_mode);
    var _ec = Scenario_H11Cell(_e);
    var _pcx = Nav_CellOf(_pl.x + _T / 2);
    var _pcy = Nav_CellOf(_pl.y + _T / 2);
    var _cone = Vis_Cone(Nav_Get().grid, _ec.cx, _ec.cy, Vis_EnemyTiles(_e.prof, _e.ai_mode), _e.prof.see_through, _e.look_dir);
    Scenario_Check(_tag + "the_player_stands_outside_the_cone", !Vis_Has(_cone, _pcx, _pcy));
}

function Scenario_StepShotsR3Stealth(_s) {
    if (!variable_struct_exists(_s, "r3st")) _s.r3st = { i: 0, e: noone };
    var _h = _s.r3st;
    var _pl = instance_exists(obj_player) ? instance_find(obj_player, 0) : noone;
    var _sc = Scenario_R3StealthScene(_h.i);
    switch (_s.step) {
        case 1040:   // build the scene _h.i
            if (_sc == undefined) { Scenario_SetWindowScale(3); Scenario_NoticeEnd(); break; }   // the end of the pictures: removes the files and the profile the steps made
            if (_s.t == 1) {
                Scenario_Release();
                Scenario_ClearUi();
                Dialogue_CloseNow();
                global.light_clock = 1500;   // the fires' flicker is frozen at one step, so a picture can be taken again
                Scenario_NewKnight(CLASS_KNIGHT);
                Scenario_SetWindowScale(3);
                _h.via = (_sc.rm == rm_floor2) ? rm_floor3 : rm_floor2;
                room_goto(_h.via);   // via another room: the controller only spawns the player on a room change
            }
            if (_s.t == 30 && room == _h.via) room_goto(_sc.rm);
            if (_s.t > 70 && Scenario_FloorReady(_sc.rm) && Player_IsSettled(_pl)) {
                with (obj_enemy) instance_destroy();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                Scenario_PlacePlayer(_sc.pcx, _sc.pcy);
                _pl.face = RIGHT;
                _h.e = Scenario_H11Enemy(_sc.foe, _sc.ecx, _sc.ecy, -1, _sc.face);
                if (_sc.chase) {
                    _h.e.ai_mode = "chase";   // standing in chase mode: its cone is the chasing one and it has not seen the player (he is behind it)
                    _h.e.react_timer = 100000;
                    _h.e.last_seen_cx = _sc.pcx;
                    _h.e.last_seen_cy = _sc.pcy;
                }
                Scenario_Next(_s, 1041);
            }
            if (_s.t > 600) { Scenario_Check("shots_r3stealth_" + _sc.name + "_room_is_ready", false, "room=" + room_get_name(room) + " player=" + string(_pl != noone)); Scenario_NoticeEnd(); }
            break;
        case 1041:   // scale 3, wait, shoot
            if (_s.t == 1) Scenario_SetWindowScale(3);
            if (_s.t >= _sc.wait) {
                Scenario_R3StealthJudge(_h, _sc, _pl);
                _s.shot = "shot_r3stealth_" + _sc.name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 1042);
            }
            break;
        case 1042:   // scale 5
            if (_s.t == 3) Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
            if (_s.t == 4) Scenario_SetWindowScale(5);
            if (_s.t >= 40) {
                _s.shot = "shot_r3stealth_" + _sc.name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 1043);
            }
            break;
        case 1043:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                with (obj_enemy) instance_destroy();
                _h.i++;
                Scenario_Next(_s, 1040);
            }
            break;
    }
}

// Pictures 800-809 (480 x 432 = scale 3, then 800 x 720 = scale 5): an elite slime and an elite plant on the map (the outline follows the sprite), the death scene with its picture.
function Scenario_ShotEliteDeath(_s, _name) {
    _s.shot = "shot_elitedeath_" + _name + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
    Scenario_ShotLayout(_s.shot, (_name == "death") ? "fade=1" : "");   // the death scene is a picture on a dark screen with a fade: the edge check does not apply
}

function Scenario_EliteShotRetype(_inst, _enemy_id) {
    _inst.enemy_id = _enemy_id;
    Enemy_ReapplyConfig(_inst);
    _inst.elite_mod = "armored";
    _inst.image_index = 0;
}

function Scenario_StepShotsEliteDeath(_s) {
    var _gs = GameState_Get();
    var _flow = (variable_global_exists("run_flow") && is_struct(global.run_flow)) ? global.run_flow : undefined;
    var _scn = instance_exists(obj_start_controller) ? instance_find(obj_start_controller, 0) : noone;
    var _scales = [3, 5];
    switch (_s.step) {
        case 800:   // floor 4, the first enemy a frozen elite slime, the player three tiles from it
            if (_s.t == 1) {
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP elite and death shots (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_NoticeEnd();
                    break;
                }
                Scenario_SetWindowScale(_scales[_s.eg_i]);
                Loc_SetLanguage("en");
                Dialogue_CloseNow();
                Scenario_ClearUi();
                _gs.pending_wake_line = false;   // run 2 of the first pass owes its wake line: it would open over the map
                var _g = Scenario_NewKnight(CLASS_KNIGHT);
                _g.run = Run_Create(2468);
                room_goto(rm_floor4);
            }
            if (_s.t == 60) {
                Scenario_ClearUi();
                var _pl = instance_find(obj_player, 0);
                var _first = noone;
                with (obj_enemy) { cine_lock_count = 1; if (_first == noone) _first = id; }
                Scenario_Check("shots_elitedeath_map_has_enemies", instance_exists(_first));
                if (!instance_exists(_first)) { Scenario_NoticeEnd(); break; }
                Scenario_EliteShotRetype(_first, ENEMY_SLIME);
                _s.eg_enemy = _first;
                _pl.x = Grid_Snap(_first.x - 48);
                _pl.y = Grid_Snap(_first.y);
                _pl.moving = false;
                _pl.move_timer = 0;
            }
            if (_s.t == 100) Scenario_ShotEliteDeath(_s, "slime");
            if (_s.t == 106) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_EliteShotRetype(_s.eg_enemy, ENEMY_KILLER_PLANT);
            }
            if (_s.t == 120) Scenario_ShotEliteDeath(_s, "plant");
            if (_s.t == 126) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                Scenario_Next(_s, 801);
            }
            break;
        case 801:   // a run on a clean profile, then a death by a slime
            if (_s.t == 1) {
                Scenario_ClearUi();
                Profile_ResetForTest();
                RunSave_Delete();
                _gs.in_main_menu = false;
                Run_StartNew(false, 5551);
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1) && _s.t > 40) {
                Scenario_ClearUi();
                GameState_SetBattleEnemy("h13_shot", ENEMY_SLIME, 1);
                Player_OnDeath(_gs.player_ch);
                Scenario_Next(_s, 802);
            }
            if (_s.t > 600) { Scenario_Check("shots_elitedeath_run_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 802:   // the death line, faded in, with its picture
            if (is_struct(_flow) && _scn != noone && _scn.state == "run_flow" && _flow.phase == "death" && _flow.t >= 70) {
                Scenario_Check("shots_elitedeath_the_picture_is_there", RunFlow_DeathLayoutNow(_flow.ctx.text).show);
                Scenario_ShotEliteDeath(_s, "death");
                Scenario_Next(_s, 803);
            }
            if (_s.t > 900) { Scenario_Check("shots_elitedeath_reaches_the_death_line", false, "state=" + (_scn != noone ? string(_scn.state) : "none")); Scenario_NoticeEnd(); }
            break;
        case 803:
            if (_s.t >= 4) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                _s.eg_i++;
                if (_s.eg_i >= array_length(_scales)) {
                    Scenario_SetWindowScale(3);
                    Scenario_Next(_s, 1010);   // goes on with R3 bvis (1010..1013), then the round 3 menus pictures (1030, the end)
                } else {
                    _flow.phase = "summary";
                    _flow.t = 0;
                    Scenario_Next(_s, 804);
                }
            }
            break;
        case 804:   // confirm on the summary: run 2 starts; then back to the first picture at the next size
            if (_s.t == 20) Scenario_Tap("confirm");
            if (_s.t > 40 && Scenario_FloorReady(rm_floor1) && Run_IsActive()) Scenario_Next(_s, 800);
            if (_s.t > 900) { Scenario_Check("shots_elitedeath_back_to_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
    }
}

// ---- H8a (D150, D156) steps 850..853, through the real keys: the Items tab refuses a potion at full HP / MP and an antidote with no poison (the item is
// not used up, HP / MP do not change) and the same item works once it is needed; a bed at full HP and MP is refused (still free), a hurt player rests;
// the Status tab shows the full sentence of the highlighted status; System > Help > Stats & terms opens its page. Its last step calls Scenario_NoticeEnd. ----
function Scenario_StepSmokeLabels(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "lb")) _s.lb = { rc: { bed: noone, key: "", set_t: -1 } };
    var _o = _s.lb;
    var _u = TabMenu_Get();
    switch (_s.step) {
        case 850:   // the Items tab: HP potion x2, MP potion, antidote; all needed nothing yet
            if (_s.t == 1) {
                Scenario_ClearUi();
                global.tutorial_off = true;
                with (obj_enemy) instance_destroy();
                var _ch = _gs.player_ch;
                _ch.inventory = [];
                _ch.inventory = Inv_Add(_ch.inventory, 10, 2);
                _ch.inventory = Inv_Add(_ch.inventory, 11, 1);
                _ch.inventory = Inv_Add(_ch.inventory, 12, 1);
                _ch.status = [];
                _ch.hp = _ch.max_hp;
                _ch.mp = _ch.max_mp;
                GameState_SetPlayer(_ch);
                if (instance_exists(obj_player) && variable_instance_exists(obj_player, "character")) obj_player.character = _gs.player_ch;
                _o.gold0 = Run_Get().gold;
                Ui_MemSet(Ui_MemGlobal(), "tab_menu_active", 2);   // the menu opens on Items
                Ui_MemSet(Ui_MemGlobal(), "tab_items", 0);
            }
            if (_s.t == 8) Scenario_Tap("menu");
            if (_s.t == 30) {
                _u = TabMenu_Get();
                Scenario_Check("labels_the_menu_opens_on_items", is_struct(_u) && _u.tab == 2, "tab=" + string(is_struct(_u) ? _u.tab : -1));
                var _tm = TabMenu_TopMenu();
                Scenario_Check("labels_the_cursor_is_on_the_hp_potion", is_struct(_tm) && _tm.items[_tm.cursor].id == "item_10", "id=" + (is_struct(_tm) ? string(_tm.items[_tm.cursor].id) : "?"));
                Scenario_Tap("confirm");   // an HP potion at full HP
            }
            if (_s.t == 44) {
                _u = TabMenu_Get();
                Scenario_Check("labels_hp_potion_at_full_hp_says_so", is_struct(_u) && _u.toast == "HP is already full.", "toast=" + (is_struct(_u) ? _u.toast : "?"));
                Scenario_Check("labels_hp_potion_at_full_hp_is_not_used_up", Inv_Count(_gs.player_ch.inventory, 10) == 2, "count=" + string(Inv_Count(_gs.player_ch.inventory, 10)));
                Scenario_Check("labels_hp_is_unchanged_by_the_refused_potion", _gs.player_ch.hp == _gs.player_ch.max_hp);
                _gs.player_ch.hp = max(1, _gs.player_ch.max_hp - 6);
                _o.hp1 = _gs.player_ch.hp;
                Scenario_Tap("confirm");   // the same potion, now needed
            }
            if (_s.t == 58) {
                _u = TabMenu_Get();
                Scenario_Check("labels_the_same_potion_works_when_hurt", Inv_Count(_gs.player_ch.inventory, 10) == 1 && _gs.player_ch.hp > _o.hp1 && _gs.player_ch.hp <= _gs.player_ch.max_hp, "count=" + string(Inv_Count(_gs.player_ch.inventory, 10)) + " hp=" + string(_gs.player_ch.hp));
                Scenario_Check("labels_and_says_how_much_it_restored", is_struct(_u) && string_pos("Restored", _u.toast) == 1, "toast=" + (is_struct(_u) ? _u.toast : "?"));
                Scenario_Tap("menu_down");
            }
            if (_s.t == 70) Scenario_Tap("confirm");   // the MP potion at full MP
            if (_s.t == 84) {
                _u = TabMenu_Get();
                Scenario_Check("labels_mp_potion_at_full_mp_says_so", is_struct(_u) && _u.toast == "MP is already full.", "toast=" + (is_struct(_u) ? _u.toast : "?"));
                Scenario_Check("labels_mp_potion_at_full_mp_is_not_used_up", Inv_Count(_gs.player_ch.inventory, 11) == 1);
                Scenario_Check("labels_mp_is_unchanged_by_the_refused_potion", _gs.player_ch.mp == _gs.player_ch.max_mp);
                Scenario_Tap("menu_down");
            }
            if (_s.t == 96) Scenario_Tap("confirm");   // the antidote with no poison
            if (_s.t == 110) {
                _u = TabMenu_Get();
                Scenario_Check("labels_an_antidote_with_no_poison_says_so", is_struct(_u) && _u.toast == "No status to cure.", "toast=" + (is_struct(_u) ? _u.toast : "?"));
                Scenario_Check("labels_the_antidote_is_not_used_up", Inv_Count(_gs.player_ch.inventory, 12) == 1);
                Status_Add(_gs.player_ch, STATUS_POISON, 0, 0, 2);
                Scenario_Tap("confirm");   // the antidote, now needed
            }
            if (_s.t == 124) {
                _u = TabMenu_Get();
                Scenario_Check("labels_the_antidote_cures_a_poison", Inv_Count(_gs.player_ch.inventory, 12) == 0 && !Status_Has(_gs.player_ch, STATUS_POISON), "count=" + string(Inv_Count(_gs.player_ch.inventory, 12)));
                Scenario_Check("labels_and_says_it_is_cured", is_struct(_u) && string_pos("cured", _u.toast) > 0, "toast=" + (is_struct(_u) ? _u.toast : "?"));
                Scenario_Check("labels_the_gold_is_untouched", Run_Get().gold == _o.gold0);
                Scenario_Tap("esc");
            }
            if (_s.t == 140) {
                Scenario_Check("labels_the_menu_closes", _gs.ui.mode == UI_NONE && !is_struct(TabMenu_Get()));
                Scenario_Next(_s, 851);
            }
            break;
        case 851:   // a bed with full HP and MP: refused, the bed stays free, nothing changes
            if (_s.t == 1) {
                Scenario_ClearUi();
                var _c3 = _gs.player_ch;
                _c3.hp = _c3.max_hp;
                _c3.mp = _c3.max_mp;
                _c3.status = [];
                _o.rc = { bed: noone, key: "", set_t: -1 };
                Scenario_RestBed(_o.rc, 5, 7);
                _o.rc.set_t = _s.t;
            }
            if (_o.rc.set_t > 0 && _s.t >= _o.rc.set_t + 20) { Scenario_Tap("interact"); _o.rc.set_t = -1; }
            if (BedUi_IsOpen() && !variable_struct_exists(_o, "b_open")) {
                _o.b_open = _s.t;
                Scenario_Check("labels_the_bed_menu_opens", _gs.ui.mode == UI_BED && Ui_StackTop(global.bed_ui.stk).id == "bed_main");
                Scenario_Check("labels_rest_looks_unavailable_when_rested", Test_FieldOr(Ui_StackTop(global.bed_ui.stk).items[0], "dim", false));
            }
            if (variable_struct_exists(_o, "b_open") && !variable_struct_exists(_o, "b_tap") && BedUi_IsOpen() && InputLock_Settled(global.bed_ui.lock, 4 * TRANSITION_FRAME_MS)) {
                _o.b_tap = _s.t;
                Scenario_Tap("confirm");   // Rest
            }
            if (variable_struct_exists(_o, "b_tap") && _s.t == _o.b_tap + 14) {
                Scenario_Check("labels_rest_at_full_is_refused_with_the_line", array_length(_gs.ui.lines_raw) >= 1 && _gs.ui.lines_raw[0] == "You are already rested.", "lines=" + json_stringify(_gs.ui.lines_raw));
                Scenario_Check("labels_the_refused_bed_is_still_free", Bed_CanUse(_gs.flags, _o.rc.key) && !BedUi_IsOpen());
                Scenario_Check("labels_the_refused_rest_changes_nothing", _gs.player_ch.hp == _gs.player_ch.max_hp && _gs.player_ch.mp == _gs.player_ch.max_mp);
            }
            if (variable_struct_exists(_o, "b_tap") && _s.t > _o.b_tap + 14) {
                Scenario_CardsTalk(_s);
                if (_s.t > _o.b_tap + 40 && _gs.ui.mode == UI_NONE && array_length(_gs.ui.lines) == 0) Scenario_Next(_s, 852);
            }
            if (_s.t > 600) { Scenario_Check("labels_the_refused_bed_flow", false, "open=" + string(BedUi_IsOpen()) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 852:   // hurt: the same bed works, and is used up
            if (_s.t == 1) {
                _gs.player_ch.hp = max(1, _gs.player_ch.max_hp - 4);
                _gs.player_ch.mp = max(0, _gs.player_ch.max_mp - 1);
                _o.rc.set_t = _s.t;
                variable_struct_remove(_o, "b_open");
                variable_struct_remove(_o, "b_tap");
            }
            if (_o.rc.set_t > 0 && _s.t >= _o.rc.set_t + 10) { Scenario_Tap("interact"); _o.rc.set_t = -1; }
            if (BedUi_IsOpen() && !variable_struct_exists(_o, "b_open")) _o.b_open = _s.t;
            if (variable_struct_exists(_o, "b_open") && !variable_struct_exists(_o, "b_tap") && BedUi_IsOpen() && InputLock_Settled(global.bed_ui.lock, 4 * TRANSITION_FRAME_MS)) {
                _o.b_tap = _s.t;
                Scenario_Check("labels_rest_does_not_look_unavailable_when_hurt", !Test_FieldOr(Ui_StackTop(global.bed_ui.stk).items[0], "dim", false));
                Scenario_Tap("confirm");
            }
            if (variable_struct_exists(_o, "b_tap") && _s.t == _o.b_tap + 14) {
                Scenario_Check("labels_rest_when_hurt_heals_hp_and_mp", _gs.player_ch.hp == _gs.player_ch.max_hp && _gs.player_ch.mp == _gs.player_ch.max_mp, "hp=" + string(_gs.player_ch.hp) + "/" + string(_gs.player_ch.max_hp));
                Scenario_Check("labels_and_uses_the_bed_up", Bed_Used(_gs.flags, _o.rc.key));
            }
            if (variable_struct_exists(_o, "b_tap") && _s.t > _o.b_tap + 14) {
                Scenario_CardsTalk(_s);
                if (_s.t > _o.b_tap + 40 && _gs.ui.mode == UI_NONE && array_length(_gs.ui.lines) == 0) Scenario_Next(_s, 853);
            }
            if (_s.t > 600) { Scenario_Check("labels_the_hurt_bed_flow", false, "open=" + string(BedUi_IsOpen()) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 853:   // the Status tab highlights a status; System > Help > Stats & terms
            if (_s.t == 1) {
                Scenario_ClearUi();
                if (instance_exists(_o.rc.bed)) with (_o.rc.bed) instance_destroy();
                var _g2 = _gs.player_ch;
                _g2.status = [];
                Status_Add(_g2, STATUS_GUARD, 4, 0);
                Status_Add(_g2, STATUS_POISON, 0, 0, 3);
                Ui_MemSet(Ui_MemGlobal(), "tab_menu_active", 0);
                Ui_MemSet(Ui_MemGlobal(), "tab_status", 0);
                Ui_MemSet(Ui_MemGlobal(), "tab_system", 0);
            }
            if (_s.t == 8) Scenario_Tap("menu");
            if (_s.t == 30) {
                _u = TabMenu_Get();
                Scenario_Check("labels_the_menu_opens_on_status", is_struct(_u) && _u.tab == 0);
                Scenario_Tap("menu_down");
            }
            if (_s.t == 42 || _s.t == 54 || _s.t == 66) Scenario_Tap("menu_down");
            if (_s.t == 78) {
                var _sm = TabMenu_TopMenu();
                var _row = _sm.items[_sm.cursor];
                Scenario_Check("labels_the_cursor_is_on_the_guard_status", _row.id == "status_" + string(STATUS_GUARD), "id=" + string(_row.id));
                Scenario_Check("labels_the_highlighted_status_says_what_it_does_and_its_turns", string_pos("4 turns left", _row.help) > 0 && string_pos("next hit", string_lower(_row.help)) > 0, "help=" + _row.help);
                Scenario_Tap("menu_down");
            }
            if (_s.t == 90) {
                var _sm2 = TabMenu_TopMenu();
                var _row2 = _sm2.items[_sm2.cursor];
                Scenario_Check("labels_the_poison_row_says_its_stacks", _row2.id == "status_" + string(STATUS_POISON) && string_pos("3 stacks", _row2.help) > 0, "help=" + _row2.help);
                Scenario_Tap("tab_prev");   // Q from Status wraps to System
            }
            if (_s.t == 106) {
                _u = TabMenu_Get();
                Scenario_Check("labels_q_from_status_reaches_system", is_struct(_u) && _u.tab == 6);
                Scenario_Tap("confirm");   // Help
            }
            if (_s.t == 120) {
                var _hm = TabMenu_TopMenu();
                Scenario_Check("labels_help_opens_with_the_stats_page_added", TabMenu_Depth() == 2 && _hm.id == "help" && array_length(_hm.items) == 12, "depth=" + string(TabMenu_Depth()) + " items=" + string(array_length(_hm.items)));
                Scenario_Tap("menu_up");   // wraps to the last row
            }
            if (_s.t == 134) {
                var _hm2 = TabMenu_TopMenu();
                Scenario_Check("labels_the_last_help_row_is_stats_and_terms", _hm2.items[_hm2.cursor].id == "stats_terms", "id=" + string(_hm2.items[_hm2.cursor].id));
                Scenario_Tap("confirm");
            }
            if (_s.t == 148) {
                var _st = TabMenu_TopMenu();
                Scenario_Check("labels_the_stats_page_opens", TabMenu_Depth() == 3 && _st.id == "help_stats", "depth=" + string(TabMenu_Depth()) + " id=" + string(_st.id));
                Scenario_Check("labels_the_stats_page_lists_every_term", array_length(_st.items) == array_length(Help_StatsItems()) && array_length(_st.items) >= 28);
                Scenario_Tap("menu_down");
            }
            if (_s.t == 162) {
                var _st2 = TabMenu_TopMenu();
                Scenario_Check("labels_the_stats_page_scrolls_by_cursor", _st2.cursor == 1);
                Scenario_Tap("cancel");
            }
            if (_s.t == 176) {
                Scenario_Check("labels_back_returns_to_the_help_list", TabMenu_Depth() == 2 && TabMenu_TopMenu().id == "help");
                Menu_Close(true);
                Scenario_Next(_s, 920);   // goes on with H8b (920..929), then H5 (750..), H13a (790..), the end of the chain
            }
            break;
    }
}

// ---- H8a (D150, D156) pictures 870..873: the battle HUD with three statuses on each side and a label under every chip, the same with an enemy chip highlighted
// (its full sentence in a plate), in Korean, the Status tab with a highlighted status and the XP bar, the Gear tab header, the Help stats page; windowed
// scale 3 (480 x 432) and 5 (800 x 720), Korean at 3 only. shot_labels_<scene>_<w>x<h>.png. The last picture of the run: it ends the run. ----
function Scenario_LabelsScenes() {
    return ["battle", "battle_tip", "status", "gear", "help_stats", "battle_ko"];
}

function Scenario_LabelsScales(_di) {
    return (_di == 5) ? [3] : [3, 5];
}

function Scenario_LabelsIsBattle(_di) {
    return (_di == 0 || _di == 1 || _di == 5);
}

// Every chip rectangle of one side lies inside _zone (or the screen), none overlaps another, and each is wide enough for its label.
function Scenario_LabelsChipChecks(_bc, _tag) {
    var _rs = _bc.hud.rects.chips;
    var _gw = Display_GuiW();
    var _gh = Display_GuiH();
    var _np = 0;
    var _ne = 0;
    var _bad_screen = "";
    var _bad_zone = "";
    var _bad_overlap = "";
    var _bad_wide = "";
    var _pz = _bc.hud.rects.zones.player;
    for (var _i = 0; _i < array_length(_rs); _i++) {
        var _r = _rs[_i];
        if (_r.who == TL_PLAYER) _np++; else _ne++;
        if (_r.x < 0 || _r.y < 0 || _r.x + _r.w > _gw || _r.y + _r.h > _gh) _bad_screen += string(_i) + " ";
        if (_r.who == TL_PLAYER && !(_r.x >= _pz.x && _r.y >= _pz.y && _r.x + _r.w <= _pz.x + _pz.w && _r.y + _r.h <= _pz.y + _pz.h)) _bad_zone += string(_i) + " ";
        if (_r.w < _r.chip.lw) _bad_wide += string(_i) + " ";
        for (var _j = _i + 1; _j < array_length(_rs); _j++) if (Test_RectsOverlap(_r, _rs[_j])) _bad_overlap += string(_i) + "/" + string(_j) + " ";
    }
    Scenario_Check("shots_labels_player_has_three_chips_" + _tag, _np == 3, "n=" + string(_np));
    Scenario_Check("shots_labels_enemy_has_three_chips_" + _tag, _ne == 3, "n=" + string(_ne));
    Scenario_Check("shots_labels_chips_are_on_screen_" + _tag, _bad_screen == "", _bad_screen);
    Scenario_Check("shots_labels_player_chips_sit_in_the_panel_" + _tag, _bad_zone == "", _bad_zone + json_stringify(_pz));
    Scenario_Check("shots_labels_no_chip_overlaps_another_" + _tag, _bad_overlap == "", _bad_overlap);
    Scenario_Check("shots_labels_every_cell_holds_its_label_" + _tag, _bad_wide == "", _bad_wide);
    var _tl = _bc.hud.rects.timeline;
    var _hit_tl = "";
    for (var _k = 0; _k < array_length(_rs); _k++) if (Test_RectsOverlap(_rs[_k], _tl)) _hit_tl += string(_k) + " ";
    Scenario_Check("shots_labels_no_chip_touches_the_turn_strip_" + _tag, _hit_tl == "", _hit_tl);
}

function Scenario_StepShotsLabels(_s) {
    var _scenes = Scenario_LabelsScenes();
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "lb2")) _s.lb2 = { n: 0, di: 0, si: 0 };
    var _o = _s.lb2;
    var _scales = Scenario_LabelsScales(_o.di);
    var _tag = _scenes[_o.di] + "_" + string(_scales[_o.si]);
    switch (_s.step) {
        case 870:   // enter the room (a fight, or one of the two floors in turn) at this scale
            if (_s.t == 1) {
                Scenario_ClearUi();
                if (Scenario_LabelsIsBattle(_o.di)) {
                    Scenario_NewKnight();
                    Scenario_SetWindowScale(_scales[_o.si]);
                    Scenario_GotoBattle("shots_labels_" + _tag, ENEMY_SPIDER);
                } else {
                    Scenario_TabFixture();
                    Scenario_SetWindowScale(_scales[_o.si]);
                    _o.n++;
                    room_goto((_o.n mod 2 == 1) ? rm_floor2 : rm_floor3);
                }
            }
            if (_s.t >= 25) {
                if (Scenario_LabelsIsBattle(_o.di) ? (room == rm_battle && instance_exists(obj_battle_controller)) : Scenario_FloorReady((_o.n mod 2 == 1) ? rm_floor2 : rm_floor3)) Scenario_Next(_s, 871);
            }
            if (_s.t > 600) { Scenario_Check("shots_labels_enters_the_room_" + _tag, false, "room=" + room_get_name(room)); Scenario_Finish(); }
            break;
        case 871:   // set the scene up
            if (_o.di == 5) Loc_SetLanguage("ko");   // after the room has loaded: a room's controller reloads the language from the settings
            else if (Loc_GetLanguage() != "en") Loc_SetLanguage("en");
            if (Scenario_LabelsIsBattle(_o.di)) {
                var _bc = instance_find(obj_battle_controller, 0);
                _bc.wait_timer = COMBAT_HOLD_FOREVER_MS;
                _bc.p.skills = [SKILL_HILT_BASH, SKILL_MUSCLE_UP, SKILL_WOUND];
                _bc.p.hp = max(1, _bc.p.max_hp - 5);
                _bc.p.mp = max(0, _bc.p.max_mp - 2);
                _bc.hud.hp_shown = _bc.p.hp;
                _bc.hud.mp_shown = _bc.p.mp;
                _bc.pops = [];
                _bc.combat_log = [];
                _bc.p = Status_Add(_bc.p, STATUS_POISON, 0, 0, 3);
                _bc.p = Status_Add(_bc.p, STATUS_BLEED, 3, 0, 2);
                _bc.p = Status_Add(_bc.p, STATUS_BRACE, 2, 0);
                _bc.e = Status_Add(_bc.e, STATUS_BURN, 2, 3);
                _bc.e = Status_Add(_bc.e, STATUS_BLOODTHIRSTY, 4, 0);
                _bc.e = Status_Add(_bc.e, STATUS_SOLIDIFY, 3, 0);
                _bc.e.hp = floor(_bc.e.max_hp * 0.8);
                _bc.enemy_hp_shown = _bc.e.hp;
                _bc.tl_who = TL_PLAYER;
                _bc.turn = TURN_PLAYER;
                _bc.enemy_action_pending = false;
                _bc.battle_state = BSTATE_MENU;
                variable_struct_remove(_bc.hud, "chip_focus");
                if (_o.di == 1) _bc.hud.chip_focus = { who: TL_ENEMY, idx: 1 };   // Bloodthirsty, in the middle of the enemy's row
            } else {
                with (obj_enemy) instance_destroy();
                switch (_scenes[_o.di]) {
                    case "status":
                        Status_Add(_gs.player_ch, STATUS_GUARD, 4, 0);
                        Status_Add(_gs.player_ch, STATUS_POISON, 0, 0, 3);
                        Status_Add(_gs.player_ch, STATUS_BURN, 2, 3);
                        Ui_MemSet(Ui_MemGlobal(), "tab_status", 0);
                        Menu_Open(0);
                        Ui_MenuFixCursor(TabMenu_TopMenu(), 4);   // Guard, with its sentence and its turns left
                        break;
                    case "gear":
                        Menu_Open(3);
                        break;
                    case "help_stats":
                        Menu_Open(6);
                        TabHelp_Open();
                        TabHelpStats_Open();
                        Ui_MenuFixCursor(TabMenu_TopMenu(), 8);   // Perfect, with the number from the data
                        break;
                }
            }
            Scenario_Next(_s, 872);
            break;
        case 872:   // let the panels settle, check the layout, take the picture
            if (_s.t >= 24) {
                _s.shot = "shot_labels_" + _scenes[_o.di] + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                if (Scenario_LabelsIsBattle(_o.di)) {
                    var _bc2 = instance_find(obj_battle_controller, 0);
                    Scenario_Check("shots_labels_in_battle_" + _tag, room == rm_battle && instance_exists(_bc2));
                    Scenario_LabelsChipChecks(_bc2, _tag);
                    Scenario_BattleUiOverlaps(_bc2, "labels_" + _tag);
                    var _pl = Battle_StatusChips(_bc2.p);
                    Scenario_Check("shots_labels_the_player_row_reads_psn_bld_brace_" + _tag, array_length(_pl) == 3 && _pl[0].label == Status_ShortName(STATUS_POISON) + " 3" && _pl[1].label == Status_ShortName(STATUS_BLEED) + " 2" && _pl[2].label == Status_ShortName(STATUS_BRACE) + " 2");
                    if (_o.di == 1) {
                        var _tp = _bc2.hud.rects.chip_tip;
                        Scenario_Check("shots_labels_the_highlighted_chip_has_its_plate_" + _tag, is_struct(_tp) && _tp.w > 0 && _tp.x >= 0 && _tp.y >= 0 && _tp.x + _tp.w <= Display_GuiW() && _tp.y + _tp.h <= Display_GuiH(), json_stringify(_tp));
                    } else {
                        Scenario_Check("shots_labels_no_plate_without_a_highlight_" + _tag, !is_struct(_bc2.hud.rects.chip_tip));
                    }
                    if (_o.di == 5) Scenario_Check("shots_labels_the_korean_name_is_not_the_english_one", Status_ShortName(STATUS_POISON) != "PSN");
                } else {
                    Scenario_Check("shots_labels_menu_is_open_" + _tag, _gs.ui.mode == UI_MENU && is_struct(TabMenu_Get()), "mode=" + string(_gs.ui.mode));
                    Scenario_TabLayoutChecks(_tag);
                    var _tm = TabMenu_TopMenu();
                    if (_scenes[_o.di] == "status") Scenario_Check("shots_labels_the_status_row_shows_its_turns_left_" + _tag, string_pos("4 turns left", _tm.items[_tm.cursor].help) > 0, _tm.items[_tm.cursor].help);
                    if (_scenes[_o.di] == "gear") Scenario_Check("shots_labels_the_gear_header_says_equipped_" + _tag, _tm.items[0].label == "Equipped" && _tm.items[0].kind == "head");
                    if (_scenes[_o.di] == "help_stats") Scenario_Check("shots_labels_the_stats_page_is_up_" + _tag, TabMenu_Depth() == 3 && _tm.id == "help_stats" && _tm.items[_tm.cursor].id == "perfect");
                }
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 873);
            }
            break;
        case 873:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                if (is_struct(TabMenu_Get())) Menu_Close(true);
                Scenario_ClearUi();
                if (Loc_GetLanguage() != "en") Loc_SetLanguage("en");
                _o.si++;
                if (_o.si >= array_length(Scenario_LabelsScales(_o.di))) { _o.si = 0; _o.di++; }
                if (_o.di >= array_length(_scenes)) {
                    Scenario_Next(_s, 930);   // goes on with H8b (930..939), then H13a (800..), the end of the pictures
                } else {
                    Scenario_Next(_s, 870);
                }
            }
            break;
    }
}

// ---- H8b (D149, D156) steps 920..929: the text markup in the running game. A dialogue line with a term, an accent and a button goes through the real
// dialogue box (pages fit, the typewriter counts what is seen, the glyph follows the device used last and the box lays itself out again when it changes,
// confirm completes and advances), a tutorial text fits its pop-up, and the battle skill list shows one prompt line. A pad cannot be plugged into a
// headless run, so "the last device" is set the way Prompt_DeviceStep sets it (global.input.last_device); the glyph and the layout then follow for real.
// Its last step calls Scenario_NoticeEnd (then H5, 750). ----
function Scenario_RichPagesFit(_gs) {
    var _lay = Dialogue_TextLayout(_gs.ui.speaker);
    var _ok = array_length(_gs.ui.lines) > 0;
    for (var _i = 0; _i < array_length(_gs.ui.lines); _i++) {
        var _rows = string_split(Dialogue_LineText(_gs.ui.lines[_i]), "\n");
        if (array_length(_rows) > _lay.max_lines) _ok = false;
        for (var _r = 0; _r < array_length(_rows); _r++) if (Markup_Width(_rows[_r]) > _lay.text_w) _ok = false;
    }
    return _ok;
}

function Scenario_StepSmokeRichText(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "rt")) _s.rt = {};
    var _o = _s.rt;
    var _bc = (room == rm_battle && instance_exists(obj_battle_controller)) ? instance_find(obj_battle_controller, 0) : noone;
    switch (_s.step) {
        case 920:   // a dialogue line with markup, the keyboard in hand
            if (_s.t == 1) {
                Scenario_ClearUi();
                global.tutorial_off = true;
                global.input.last_device = "keyboard";
                Dialogue_StartWithSpeaker(Loc_T("smoke.rt.speaker", "Stranger"), [
                    Loc_T("smoke.rt.line.0", "A [t]Poison[/t] crept in, and the [a]BREAK[/a] is near. Press [k:confirm] to go on, or [k:left][k:right] to look about."),
                    Loc_T("smoke.rt.line.1", "[t]Steadfast[/t] holds; [k:confirm] again.")]);
            }
            if (_s.t == 6) {
                Scenario_Check("richtext_the_dialogue_box_is_open", _gs.ui.mode == UI_DIALOGUE, "mode=" + string(_gs.ui.mode));
                Scenario_Check("richtext_the_pages_keep_their_markup", array_length(_gs.ui.lines) >= 2 && Prompt_HasTokens(Dialogue_LineText(_gs.ui.lines[0])), "pages=" + string(array_length(_gs.ui.lines)));
                Scenario_Check("richtext_every_page_line_fits_the_box", Scenario_RichPagesFit(_gs));
                Scenario_Check("richtext_the_box_was_laid_out_for_the_keyboard", _gs.ui.dialogue_layout_dev == "keyboard", "dev=" + string(_gs.ui.dialogue_layout_dev));
                var _seg = Markup_Segments(Dialogue_LineText(_gs.ui.lines[0]));
                var _g = -1;
                for (var _i = 0; _i < array_length(_seg); _i++) if (_seg[_i].kind == "glyph") { _g = _i; break; }
                Scenario_Check("richtext_the_first_button_is_a_keycap", _g >= 0 && _seg[_g].info.kind == "key" && _seg[_g].info.label == "Space");
            }
            if (_s.t > 6 && _gs.ui.mode == UI_DIALOGUE && variable_struct_exists(_gs.ui, "dialogue_state") && _gs.ui.dialogue_state == UI_DIALOGUE_STATE_READY) {
                var _full = _gs.ui.dialogue_full_text;
                Scenario_Check("richtext_the_typewriter_reveals_every_visible_character", _gs.ui.dialogue_visible_count == Markup_Length(_full), "shown=" + string(_gs.ui.dialogue_visible_count) + " of " + string(Markup_Length(_full)));
                Scenario_Check("richtext_no_bracket_is_on_the_screen", string_pos("[", Markup_Strip(Markup_Reveal(_full, _gs.ui.dialogue_visible_count))) == 0);
                Scenario_Next(_s, 921);
            }
            if (_s.t > 900) { Scenario_Check("richtext_the_line_finishes_typing", false, "state=" + string(variable_struct_exists(_gs.ui, "dialogue_state") ? _gs.ui.dialogue_state : -1)); Scenario_NoticeEnd(); }
            break;
        case 921:   // the device changes: the buttons follow, the box lays itself out again and keeps its place
            if (_s.t == 1) {
                _o.idx = _gs.ui.index;
                global.input.last_device = "gamepad";
            }
            if (_s.t == 4) {
                Scenario_Check("richtext_the_box_lays_itself_out_again_for_the_pad", _gs.ui.dialogue_layout_dev == "gamepad", "dev=" + string(_gs.ui.dialogue_layout_dev));
                Scenario_Check("richtext_the_pages_still_fit_with_the_pad_glyphs", Scenario_RichPagesFit(_gs));
                Scenario_Check("richtext_the_box_keeps_its_page", _gs.ui.mode == UI_DIALOGUE && _gs.ui.index == _o.idx, "index=" + string(_gs.ui.index) + " want " + string(_o.idx));
                var _seg2 = Markup_Segments(Dialogue_LineText(_gs.ui.lines[_gs.ui.index]));
                var _gp = -1;
                for (var _j = 0; _j < array_length(_seg2); _j++) if (_seg2[_j].kind == "glyph") { _gp = _j; break; }
                Scenario_Check("richtext_the_button_is_now_the_pad_A", _gp >= 0 && _seg2[_gp].info.kind == "pad" && _seg2[_gp].info.label == "A");
                global.input.last_device = "keyboard";
            }
            if (_s.t == 10) {
                Scenario_Check("richtext_the_keyboard_comes_back", _gs.ui.dialogue_layout_dev == "keyboard");
                Dialogue_TypewriterPrepareCurrentLine();
                Dialogue_TypewriterRevealInstant();
                _gs.ui.dialogue_state = UI_DIALOGUE_STATE_READY;
            }
            if (_s.t == 16) Scenario_Tap("confirm");
            if (_s.t == 24) {
                Scenario_Check("richtext_confirm_moves_to_the_next_page", _gs.ui.mode == UI_DIALOGUE && _gs.ui.index == _o.idx + 1, "index=" + string(_gs.ui.index) + " mode=" + string(_gs.ui.mode));
                Dialogue_TypewriterPrepareCurrentLine();
                Dialogue_TypewriterRevealInstant();
                _gs.ui.dialogue_state = UI_DIALOGUE_STATE_READY;
            }
            if (_s.t == 30) Scenario_Tap("confirm");
            if (_s.t == 40) {
                Scenario_Check("richtext_confirm_on_the_last_page_closes_the_box", _gs.ui.mode == UI_NONE, "mode=" + string(_gs.ui.mode));
                Scenario_Next(_s, 922);
            }
            break;
        case 922:   // the first-time texts: the bar, arrows and defence pop-ups name their buttons, and every tutorial text fits its pop-up
            if (_s.t == 1) {
                var _ids = Tutorial_Ids();
                var _fit = true;
                var _tw = round(Ui_Metrics().gw * 0.7);
                for (var _t = 0; _t < array_length(_ids); _t++) {
                    var _b = Tutorial_Get(_ids[_t]).body;
                    if (string_pos("[", Markup_Strip(_b)) > 0 || Prompt_RichLayout(_b, _tw).lines < 1) _fit = false;
                }
                Scenario_Check("richtext_every_tutorial_text_lays_out_without_a_bracket", _fit);
                Scenario_Check("richtext_the_bar_text_has_its_button", Prompt_HasTokens(Tutorial_Get("bar").body) && Prompt_TokensHaveAction(Prompt_Tokens(Tutorial_Get("bar").body)));
                Scenario_Check("richtext_the_arrows_text_has_four_arrows", array_length(Markup_Segments(Tutorial_Get("arrows").body, "keyboard")) >= 5);
                Scenario_Check("richtext_the_footer_is_a_button_and_a_word", Markup_Strip(Tutorial_Footer(), "gamepad") == "A Continue", Markup_Strip(Tutorial_Footer(), "gamepad"));
                Scenario_NewKnight();
                Scenario_GotoBattle("smoke_richtext", ENEMY_SLIME);
            }
            if (_s.t > 20 && _bc != noone && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && is_struct(_bc.ui_cmd)) {
                _bc.p.skills = [SKILL_HILT_BASH, SKILL_MUSCLE_UP];
                _bc.p.hp = _bc.p.max_hp;
                Scenario_Check("richtext_the_command_menu_draws_no_hint_label", array_length(Battle_HintLabels(_bc.battle_state)) == 0);
                Scenario_Next(_s, 923);
            }
            if (_s.t > 600) { Scenario_Check("richtext_the_battle_reaches_the_player_menu", false, "state=" + string(_bc != noone ? _bc.battle_state : -1)); Scenario_NoticeEnd(); }
            break;
        case 923:   // the skill list: one prompt line, on one line
            if (_s.t == 1) Scenario_Tap("menu_down");
            if (_s.t == 8) Scenario_Tap("confirm");
            if (_s.t == 26) {
                var _hl = Battle_HintLabels(_bc.battle_state);
                Scenario_Check("richtext_the_skill_list_is_open", _bc.battle_state == BSTATE_SKILL_MENU, "state=" + string(_bc.battle_state));
                Scenario_Check("richtext_the_skill_list_has_one_prompt_label", array_length(_hl) == 1 && _hl[0].action == "confirm", "labels=" + string(array_length(_hl)));
                Scenario_Check("richtext_the_prompt_line_is_one_line_in_the_panel", _bc.ui_skill.det_rect.w > 0 && Prompt_RichLayout(_hl[0].text, _bc.ui_skill.det_rect.w).lines == 1);
                Scenario_BattleUiOverlaps(_bc, "richtext_skill_list");
                Scenario_Tap("esc");
            }
            if (_s.t == 40) {
                Scenario_Check("richtext_back_still_goes_up_without_a_back_label", _bc.battle_state == BSTATE_MENU, "state=" + string(_bc.battle_state));
                Scenario_Next(_s, 750);   // goes on with H5 (750..769), then H13a (790..), the end of the chain
            }
            break;
    }
}

// ---- H8b (D149, D156) pictures 930..939: shot_richtext_<scene>_<w>x<h>.png at 480x432 and 800x720. Scenes: the dialogue box with a term, an accent and a
// button (keyboard, pad), the card pick with terms and its hint line (keyboard arrows, pad d-pad), the battle skill list with its one prompt line. ----
function Scenario_RichShotScenes() {
    return ["dialogue_kb", "dialogue_pad", "card_kb", "card_pad", "battle_prompt"];
}

function Scenario_StepShotsRichText(_s) {
    var _scenes = Scenario_RichShotScenes();
    var _scales = [3, 5];
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "rs")) _s.rs = { di: 0, si: 0 };
    var _o = _s.rs;
    var _scene = _scenes[_o.di];
    var _pad = (string_pos("pad", _scene) > 0);
    var _is_battle = (_scene == "battle_prompt");
    switch (_s.step) {
        case 930:   // enter the room at this scale
            if (_s.t == 1) {
                Scenario_NewKnight();
                Scenario_SetWindowScale(_scales[_o.si]);
                if (_is_battle) Scenario_GotoBattle("shots_richtext_" + string(_o.di) + "_" + string(_o.si), ENEMY_SPIDER);
                else room_goto(rm_floor1);
            }
            if (_s.t >= 25) Scenario_Next(_s, 931);
            break;
        case 931:   // set the scene up
            Loc_SetLanguage("en");
            global.tutorial_off = true;
            global.input.last_device = _pad ? "gamepad" : "keyboard";
            if (_is_battle) {
                var _inb = (room == rm_battle && instance_exists(obj_battle_controller));
                Scenario_Check("shots_richtext_in_battle", _inb, "room=" + room_get_name(room));
                if (!_inb) { Scenario_Finish(); return; }
                var _bc = instance_find(obj_battle_controller, 0);
                _bc.wait_timer = COMBAT_HOLD_FOREVER_MS;
                _bc.p.skills = [SKILL_HILT_BASH, SKILL_MUSCLE_UP, SKILL_WOUND];
                _bc.p.hp = 6;
                _bc.p.mp = 4;
                _bc.hud.hp_shown = 6;
                _bc.hud.mp_shown = 4;
                _bc.pops = [];
                _bc.combat_log = [];
                _bc.tl_who = TL_PLAYER;
                _bc.turn = TURN_PLAYER;
                _bc.enemy_action_pending = false;
                _bc.battle_state = BSTATE_MENU;
            } else if (string_pos("dialogue", _scene) == 1) {
                Scenario_ClearUi();
                Dialogue_StartWithSpeaker(Loc_T("shots.rt.speaker", "Stranger"), [Loc_T("shots.rt.line", "A [t]Poison[/t] crept in, and the [a]BREAK[/a] is near. Press [k:confirm] to go on, or [k:left][k:right] to look about. [t]Steadfast[/t] holds.")]);
            } else {
                Scenario_ClearUi();
                var _ch = _gs.player_ch;
                _ch.skills = [SKILL_FIREBALL];
                _ch.card_picks = 2;
                _ch.offer = [Card_SkillId(SKILL_POISON_ARROW), Card_SkillId(SKILL_MUSCLE_UP), "pas:steady_hands"];
                CardsUi_Open("cards");
            }
            Scenario_Next(_s, 932);
            break;
        case 932:   // let the menus build, then open what the scene shows
            if (_s.t >= 4) {
                if (_is_battle) {
                    var _bc2 = instance_find(obj_battle_controller, 0);
                    Battle_OpenList(_bc2, BSTATE_SKILL_MENU);
                    _bc2.ui_skill.cursor = 1;
                } else if (string_pos("dialogue", _scene) == 1) {
                    Dialogue_TypewriterPrepareCurrentLine();
                    Dialogue_TypewriterRevealInstant();
                    _gs.ui.dialogue_state = UI_DIALOGUE_STATE_READY;
                }
                Scenario_Next(_s, 933);
            }
            break;
        case 933:   // checks, then the picture
            if (_s.t >= 30) {
                var _tag = _scene + "_" + string(_scales[_o.si]);
                if (_is_battle) {
                    var _bc3 = instance_find(obj_battle_controller, 0);
                    var _hl = Battle_HintLabels(_bc3.battle_state);
                    Scenario_Check("shots_richtext_the_list_is_open_" + _tag, _bc3.battle_state == BSTATE_SKILL_MENU);
                    Scenario_Check("shots_richtext_one_prompt_label_" + _tag, array_length(_hl) == 1);
                    Scenario_Check("shots_richtext_the_prompt_is_one_line_" + _tag, array_length(_hl) == 1 && Prompt_RichLayout(_hl[0].text, _bc3.ui_skill.det_rect.w).lines == 1);
                    Scenario_BattleUiOverlaps(_bc3, "richtext_" + _tag);
                } else if (string_pos("dialogue", _scene) == 1) {
                    Scenario_Check("shots_richtext_the_dialogue_is_open_" + _tag, _gs.ui.mode == UI_DIALOGUE);
                    Scenario_Check("shots_richtext_the_pages_fit_" + _tag, Scenario_RichPagesFit(_gs));
                    var _sg = Markup_Segments(Dialogue_LineText(_gs.ui.lines[0]));
                    var _gi = -1;
                    for (var _i = 0; _i < array_length(_sg); _i++) if (_sg[_i].kind == "glyph") { _gi = _i; break; }
                    Scenario_Check("shots_richtext_the_button_follows_the_device_" + _tag, _gi >= 0 && _sg[_gi].info.kind == (_pad ? "pad" : "key"));
                } else {
                    Scenario_Check("shots_richtext_the_card_pick_is_open_" + _tag, CardsUi_Kind() == "cards" && array_length(global.cards_ui.pick.ids) == 3);
                }
                _s.shot = "shot_richtext_" + _scene + "_" + string(window_get_width()) + "x" + string(window_get_height()) + ".png";
                Scenario_ShotLayout(_s.shot);
                Scenario_Next(_s, 934);
            }
            break;
        case 934:
            if (_s.t >= 3) {
                Scenario_Check("shots_saved_" + _s.shot, file_exists(_s.shot));
                if (_gs.ui.mode == UI_DIALOGUE) Dialogue_CloseNow();
                if (CardsUi_Kind() == "cards") CardsUi_Close();
                _o.si++;
                if (_o.si >= array_length(_scales)) { _o.si = 0; _o.di++; }
                global.input.last_device = "keyboard";
                if (_o.di >= array_length(_scenes)) {
                    Scenario_Next(_s, 910);   // goes on with H12a (910..913), then H13a (800..), the end of the pictures
                } else {
                    Scenario_Next(_s, 930);
                }
            }
            break;
    }
}
// ---- Bug hunt 5a (D141), steps 800..803. They go on from the Notes steps (a run in a map room); the last one calls Scenario_NoticeEnd.
// 800/801: the snapshot taken before a fight (as EnemyPersist_BeginEncounter takes it) is held in the fight and gone once the fight is WON and the map is back.
// 802/803: the same, but the fight is LOST (1 HP, poisoned): the snapshot is gone when the run ends. ----
function Scenario_StepSmokeHunt5a(_s) {
    var _gs = GameState_Get();
    var _bc = (room == rm_battle && instance_exists(obj_battle_controller)) ? instance_find(obj_battle_controller, 0) : noone;
    if (!variable_struct_exists(_s, "h5")) _s.h5 = {};
    var _h = _s.h5;
    var _ready_tap = ((_s.f - _s.last_tap) >= 4);
    switch (_s.step) {
        case 800:   // a snapshot, then a battle that starts without BeginEncounter (the snapshot is all that says "a map fight began")
            if (_s.t == 1) {
                Scenario_Release();
                Dialogue_CloseNow();
                Scenario_ClearUi();
                if (room != rm_floor1 && !Transition_IsActive()) room_goto(rm_floor1);
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1)) {
                Scenario_Check("hunt5a_a_snapshot_is_taken_before_the_fight", EnemyPersist_SnapshotRun() && EnemyPersist_HasSnapshot());
                _s.boost = { hp: 9999, mp: 99 };   // the battle copy of the player is sturdy: the fight is only the way to the win
                Scenario_GotoBattle("h5a_win", ENEMY_SLIME);
                Scenario_Next(_s, 801);
            }
            if (_s.t > 600) { Scenario_Check("hunt5a_reaches_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 801:   // 1 HP left on the enemy when the menu is up, ATTACK through the menu; back on the map
            if (_bc != noone) {
                if (!variable_struct_exists(_h, "in_fight")) {
                    _h.in_fight = true;
                    Scenario_Check("hunt5a_the_snapshot_is_held_during_the_fight", EnemyPersist_HasSnapshot());
                }
                if (_s.t > 10 && !_bc.battle_over && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && _ready_tap) {
                    if (!variable_struct_exists(_h, "e1")) { _h.e1 = true; _bc.e.hp = 1; }
                    Scenario_Tap((_bc.menu_index != 0) ? "menu_up" : "confirm");
                }
            }
            if (variable_struct_exists(_h, "in_fight") && room == rm_floor1 && Scenario_FloorReady(rm_floor1)) {
                Scenario_Check("hunt5a_a_won_fight_leaves_no_snapshot", !EnemyPersist_HasSnapshot());
                Scenario_Next(_s, 802);
            }
            if (_s.t > 3000) { Scenario_Check("hunt5a_the_fight_is_won", false, "room=" + room_get_name(room) + " state=" + string(_bc != noone ? _bc.battle_state : -1)); Scenario_NoticeEnd(); }
            break;
        case 802:   // a snapshot again, then a battle the player will lose
            if (_s.t == 1) {
                Scenario_Release();
                Dialogue_CloseNow();
                Scenario_ClearUi();
            }
            if (_s.t > 5 && Scenario_FloorReady(rm_floor1)) {
                Scenario_Check("hunt5a_a_second_snapshot_is_taken", EnemyPersist_SnapshotRun() && EnemyPersist_HasSnapshot());
                Scenario_GotoBattle("h5a_lose", ENEMY_SLIME);
                Scenario_Next(_s, 803);
            }
            if (_s.t > 600) { Scenario_Check("hunt5a_back_in_rm_floor1", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 803:   // 1 HP and 3 Poison stacks, an enemy that never acts; ATTACK through the menu: the tick after it takes the last HP
            if (!variable_struct_exists(_h, "p_set")) {
                if (_bc != noone && _s.t > 10 && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER) {
                    _h.p_set = true;
                    _h.d0 = Profile_Get().deaths;
                    _bc.e.max_hp = 999;
                    _bc.e.hp = 999;
                    Turn_Push(_bc.tl, TL_ENEMY, 100000);
                    _bc.p.hp = 1;
                    _bc.p = Status_Add(_bc.p, STATUS_POISON, 0, 0, 3);
                    Scenario_Check("hunt5a_the_snapshot_is_held_in_the_lost_fight", EnemyPersist_HasSnapshot());
                }
            } else if (_bc != noone && !_bc.battle_over && _bc.battle_state == BSTATE_MENU && _bc.turn == TURN_PLAYER && _ready_tap) {
                Scenario_Tap((_bc.menu_index != 0) ? "menu_up" : "confirm");
            }
            if (variable_struct_exists(_h, "p_set") && Profile_Get().deaths > _h.d0) {
                Scenario_Check("hunt5a_the_player_died", _gs.player_ch.hp <= 0, "hp=" + string(_gs.player_ch.hp));
                Scenario_Check("hunt5a_a_lost_fight_leaves_no_snapshot", !EnemyPersist_HasSnapshot());
                Scenario_Next(_s, 804);
            }
            if (_s.t > 1500) { Scenario_Check("hunt5a_the_fight_is_lost", false, "state=" + string(_bc != noone ? _bc.battle_state : -1) + " set=" + string(variable_struct_exists(_h, "p_set")) + " room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 804:   // the death line, then the summary: confirm, the next run starts on the map (the chain goes on from there)
            var _fl = (variable_global_exists("run_flow") && is_struct(global.run_flow)) ? global.run_flow : undefined;
            if (is_struct(_fl) && _fl.phase == "death") { _fl.t = max(_fl.t, _fl.ctx.frames - 2); }   // the line is checked elsewhere (H13a): skip its wait
            if (is_struct(_fl) && _fl.phase == "summary" && !variable_struct_exists(_h, "sum_t")) _h.sum_t = _s.t;
            if (variable_struct_exists(_h, "sum_t") && _s.t == _h.sum_t + 20) Scenario_Tap("confirm");
            if (room == rm_cutscene && _s.t mod 30 == 0) Scenario_Tap("confirm");   // a wake / intro line on the way: one tap a line
            if (variable_struct_exists(_h, "sum_t") && _s.t > _h.sum_t + 40 && Scenario_FloorReady(rm_floor1) && Run_IsActive()) Scenario_Next(_s, 820);   // goes on with D164 (820..829)
            if (_s.t > 1500) { Scenario_Check("hunt5a_the_next_run_starts_after_the_summary", false, "room=" + room_get_name(room) + " phase=" + (is_struct(_fl) ? string(_fl.phase) : "none")); Scenario_NoticeEnd(); }
            break;
    }
}

// ============================================================================
// H12a (D154): the small flavour choices, through real keys (smoke steps 890-909, the end of the chain). Writes the real profile.sav: only inside the gate
// (Scenario_CanSaveSlot). The questions are switched on for these steps only (global.choice_off).
//   890      a Knight with 87 gold in a run, a clean profile; on to the merchant's room
//   891-893  the merchant: interact opens his question as a box, the replies open above it, the second one is picked, its reply is read, the shop opens; the
//            answer is in the profile (memory and file); the next visit opens the shop at once and his first greeting remembers the answer; with a clean
//            profile the first reply shows another next line
//   894-896  the Stranger: his question comes before your reaction to him; the first reply is picked; the reaction follows; the next run he greets without asking
//   897-898  the wake line: the question follows it; the second reply; the next time a line that remembers follows the wake line instead
//   899-902  the torn survey page (D147 + D154): walked onto it is picked up and nothing is asked; in the Codex Notes reader the question comes after the
//            note's lines, the replies wake when the text is read to its end, Down / Up / Confirm pick the first one (stored, in the file), the reply is read;
//            reopened, the later line is part of the note and nothing is asked
//   909      the end (the files are removed)
// Nothing in any of it may change HP, MP, gold, items or stats (Scenario_ChoiceVitals).
// ============================================================================
function Scenario_ChoiceVitals() {
    var _gs = GameState_Get();
    var _c = _gs.player_ch;
    return json_stringify({ hp: _c.hp, mp: _c.mp, max_hp: _c.max_hp, max_mp: _c.max_mp, stats: _c.stats, inv: _c.inventory, skills: _c.skills, level: _c.level, gold: _gs.run.gold });
}

// A Knight in a run with 87 gold and a few potions, owed nothing (no card or stat screen opens by itself).
function Scenario_ChoiceFixture() {
    var _gs = Scenario_NewKnight(CLASS_KNIGHT);
    var _k = _gs.player_ch;
    _k.inventory = Inv_Add(_k.inventory, 10, 2);
    _k.inventory = Inv_Add(_k.inventory, 30, 1);
    _k.hp = max(1, _k.max_hp - 3);
    _k.mp = max(0, _k.max_mp - 1);
    GameState_SetPlayer(_k);
    _gs.run = Run_Create(8901);
    _gs.run.gold = 87;
    return _gs;
}

function Scenario_ChoiceNew() {
    return { boxes: [], sig: "", q: 0, labels: [], cursor_start: -1, cursor_pick: -1, watch: "", watched: false };
}

// Drives one moment through the real keys and writes down what it sees. Every dialogue box that opens is read with Confirm; a box with replies waits for them to open,
// _pick (0 or 1; -1 = no question is expected) is chosen with Down / Confirm. _c.boxes = [{ lines, speaker, asking }] in order, _c.labels / cursor_start / cursor_pick
// of the replies; _c.watch (a lines_raw as json) sets _c.watched when that box shows. True once every box is closed and the keys have had time to act.
function Scenario_ChoiceDrive(_s, _c, _pick) {
    var _gs = GameState_Get();
    var _ready = (_s.f - _s.last_tap) >= 14;
    var _in_box = (_gs.ui.mode == UI_DIALOGUE);
    if (_in_box) {
        var _asking = is_struct(Dialogue_Choice());
        var _sig = json_stringify(_gs.ui.lines_raw) + "|" + string(_gs.ui.speaker) + "|" + string(_asking);
        if (_sig != _c.sig) {
            _c.sig = _sig;
            array_push(_c.boxes, { lines: _gs.ui.lines_raw, speaker: _gs.ui.speaker, asking: _asking });
            if (json_stringify(_gs.ui.lines_raw) == _c.watch) _c.watched = true;
        }
        if (Dialogue_ChoiceIsOpen() && _pick >= 0) {
            var _m = Dialogue_Choice().menu;
            if (_c.q == 0) {
                _c.labels = [];
                for (var _i = 0; _i < array_length(_m.items); _i++) array_push(_c.labels, _m.items[_i].label);
                _c.cursor_start = _m.cursor;
                if (_pick > 0) Scenario_Tap("menu_down");
                _c.q = 1;
            } else if (_c.q == 1 && _ready) {
                _c.cursor_pick = _m.cursor;
                Scenario_Tap("confirm");
                _c.q = 2;
            }
        } else if (_ready) {
            Scenario_Tap("confirm");
        }
        return false;
    }
    return (array_length(_c.boxes) > 0 && (_s.f - _s.last_tap) >= 20);
}

// Closes the shop through its own back key once its input delay is over. True when it is closed.
function Scenario_ChoiceLeaveShop(_s, _h) {
    if (!ShopUi_IsOpen()) return true;
    if (InputLock_Settled(global.shop_ui.lock, 4 * TRANSITION_FRAME_MS) && (_s.f - _s.last_tap) >= 14) Scenario_Tap("cancel");
    return false;
}

function Scenario_StepSmokeChoices(_s) {
    var _gs = GameState_Get();
    if (!variable_struct_exists(_s, "chs")) _s.chs = { c: Scenario_ChoiceNew(), vit: "", reply2: "", flags: {} };
    var _h = _s.chs;
    var _c = _h.c;
    switch (_s.step) {
        case 890:   // a Knight with 87 gold in a run, a clean profile, the merchant's room
            if (_s.t == 1) {
                if (!Scenario_CanSaveSlot()) {
                    show_debug_message("[TEST] SKIP flavour choices (LOCALAPPDATA is not the gate scratch folder)");
                    Scenario_NoticeEnd();
                    break;
                }
                if (Transition_IsActive()) { _s.t = 0; break; }
                Dialogue_CloseNow();
                Scenario_ClearUi();
                RunSave_Delete();
                _gs = Scenario_ChoiceFixture();
                Profile_ResetForTest();
                _gs.pending_wake_line = false;
                global.choice_off = false;
                _h.vit = Scenario_ChoiceVitals();
                Scenario_Check("choices_the_questions_are_on_for_these_steps", Choice_Enabled() && Choice_Get(Profile_Get(), "merchant") == 0);
                Scenario_Check("choices_the_fixture_is_owed_nothing", Cards_NextOwed(_gs.player_ch) == "");
                room_goto(rm_floor2);
            }
            if (_s.t > 40 && Scenario_FloorReady(rm_floor2)) {
                with (obj_enemy) instance_destroy();   // the room's enemies would hunt the player
                var _plm = Scenario_PlacePlayer(Merchant_SpotFor(rm_floor2).x div GRID_TILE_SIZE, Merchant_SpotFor(rm_floor2).y div GRID_TILE_SIZE + 1);   // the cell below him
                _plm.face = UP;
                _h.c = Scenario_ChoiceNew();
                Scenario_Next(_s, 891);
            }
            if (_s.t > 900) { Scenario_Check("choices_reach_the_merchants_room", false, "room=" + room_get_name(room)); Scenario_NoticeEnd(); }
            break;
        case 891:   // the merchant, a clean profile: his question, the second reply, then the shop
            if (_s.t == 25) Scenario_Tap("interact");
            if (_s.t > 25) {
                var _done = Scenario_ChoiceDrive(_s, _c, 1);
                if (array_length(_c.boxes) == 1 && !variable_struct_exists(_h.flags, "m_ask")) {
                    _h.flags.m_ask = true;
                    Scenario_Check("choices_merchant_interact_opens_his_question_not_the_shop", !ShopUi_IsOpen() && _c.boxes[0].asking && _c.boxes[0].speaker == Loc_T("merchant.name", "Merchant"));
                    Scenario_Check("choices_merchant_the_question_is_his_two_lines", json_stringify(_c.boxes[0].lines) == json_stringify(Choice_Def("merchant").ask), json_stringify(_c.boxes[0].lines));
                    Scenario_Check("choices_merchant_nothing_is_stored_before_the_pick", Choice_Get(Profile_Get(), "merchant") == 0);
                }
                if (_c.q == 1 && !variable_struct_exists(_h.flags, "m_menu")) {
                    _h.flags.m_menu = true;
                    Scenario_Check("choices_merchant_two_replies_open_above_the_box", array_length(_c.labels) == 2 && _c.labels[0] == Choice_Def("merchant").labels[0] && _c.labels[1] == Choice_Def("merchant").labels[1], json_stringify(_c.labels));
                    Scenario_Check("choices_merchant_the_cursor_starts_on_the_first_reply", _c.cursor_start == 0);
                    Scenario_Check("choices_merchant_the_replies_sit_above_the_box", Dialogue_Choice().menu.rect.y + Dialogue_Choice().menu.rect.h <= Dialogue_BoxRect().y);
                }
                if (array_length(_c.boxes) == 2 && !variable_struct_exists(_h.flags, "m_reply")) {
                    _h.flags.m_reply = true;
                    Scenario_Check("choices_merchant_down_picked_the_second_reply", _c.cursor_pick == 1);
                    Scenario_Check("choices_merchant_the_second_reply_is_his_next_line", json_stringify(_c.boxes[1].lines) == json_stringify(Choice_Def("merchant").reply[1]) && !_c.boxes[1].asking && _c.boxes[1].speaker == _c.boxes[0].speaker, json_stringify(_c.boxes[1].lines));
                    Scenario_Check("choices_merchant_the_answer_is_remembered", Choice_Get(Profile_Get(), "merchant") == 2);
                    var _disk = Profile_Load(Profile_Path());
                    Scenario_Check("choices_merchant_the_answer_is_in_the_profile_file", _disk.status == "ok" && Choice_Get(_disk.profile, "merchant") == 2 && _disk.profile.profile_version == 2, "status=" + _disk.status);
                    Scenario_Check("choices_merchant_the_shop_waits_for_the_reply", !ShopUi_IsOpen());
                    _h.reply2 = json_stringify(_c.boxes[1].lines);
                }
                if (_done) {
                    Scenario_Check("choices_merchant_two_boxes_then_the_shop", array_length(_c.boxes) == 2 && ShopUi_IsOpen() && _gs.ui.mode == UI_SHOP);
                    Scenario_Check("choices_merchant_nothing_changed_in_the_character_or_the_gold", Scenario_ChoiceVitals() == _h.vit);
                    Scenario_Check("choices_merchant_his_first_greeting_remembers_the_answer", Merchant_Line("greet", 0) == Choice_Def("merchant").again[1][0]);
                    Scenario_Next(_s, 892);
                }
            }
            if (_s.t > 1500) { Scenario_Check("choices_merchant_flow_ends", false, "q=" + string(_c.q) + " boxes=" + string(array_length(_c.boxes)) + " mode=" + string(_gs.ui.mode)); Scenario_NoticeEnd(); }
            break;
        case 892:   // leave the shop; the next visit opens it at once, without a question
            if (!variable_struct_exists(_h.flags, "left1")) {
                if (Scenario_ChoiceLeaveShop(_s, _h)) { _h.flags.left1 = _s.t; Scenario_Check("choices_merchant_cancel_leaves_the_shop", _gs.ui.mode == UI_NONE); }
            } else if (_s.t == _h.flags.left1 + 40) {
                _h.flags.box_seen = false;
                Scenario_Tap("interact");
            }
            if (variable_struct_exists(_h.flags, "left1") && _s.t > _h.flags.left1 + 40) {
                if (_gs.ui.mode == UI_DIALOGUE) _h.flags.box_seen = true;
                if (ShopUi_IsOpen()) {
