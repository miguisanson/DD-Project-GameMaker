    Test_True("STAT-01 stats are atk, def, spd, mag", variable_struct_exists(_k.stats, "atk") && variable_struct_exists(_k.stats, "def") && variable_struct_exists(_k.stats, "spd") && variable_struct_exists(_k.stats, "mag"));
