    var _c = { title_stk: undefined };
    Title_Build(_c);
    Test_False("H2 Title_Build sets no armed flag", variable_struct_exists(_c, "title_new_armed"));
}

function Test_Suite_Confirm() {
    Test_ConfirmPart("the shared pop-up", Test_ConfirmCore);
    Test_ConfirmPart("abandon and quit in the System tab", Test_ConfirmSystem);
    Test_ConfirmPart("New Game over a saved run", Test_ConfirmNewGame);
    Test_ConfirmPart("class pick and echo pick", Test_ConfirmClassAndEcho);
    Test_ConfirmPart("skill swap", Test_ConfirmReplace);
    Test_ConfirmPart("selling gear", Test_ConfirmSell);
    Test_ConfirmPart("no press-twice path left", Test_ConfirmNoArmed);
}

// ---- H6 (D146, D156): hold-to-skip and cutscene text in the shared dialogue box -------------------------------------------------------
// Expected values are the decisions written out, not read from the macros: tapping confirm only advances text; holding the same key shows the "Hold to skip" prompt
// after 1000 ms (never on a tap), fading in over 200 ms with a bar that fills from 1000 to 2000 ms, and the skip fires at 2000 ms exactly once. The clock is injected:
// Skip_Step takes the step length in ms, so 1 ms steps make every edge exact.
// Simulates steps of _step_ms up to _ms: the key is down while the time is <= _held_until (the first step is the press unless _press_first is false), then up.
// Returns the state, the number of fires, the step time of the first fire and the highest prompt alpha.
function Test_CutSkipRun(_st, _ms, _step_ms, _held_until, _press_first = true) {
    var _fired = 0, _amax = 0, _fire_at = -1;
    for (var _t = _step_ms; _t <= _ms + 0.001; _t += _step_ms) {
        _st = Skip_Step(_st, true, (_press_first && abs(_t - _step_ms) < 0.001), (_t <= _held_until + 0.001), _step_ms);
        if (_st.fired) {
            _fired++;
            if (_fire_at < 0) _fire_at = _t;
        }
        _amax = max(_amax, Skip_HintAlpha(_st));
    }
    return { st: _st, fired: _fired, amax: _amax, fire_at: _fire_at };
}

function Test_Suite_CutSkip() {
    // --- the numbers
    Test_Eq("D146 the skip completes at 2000 ms", SKIP_HOLD_MS, 2000);
    Test_Eq("D146 the prompt appears at 1000 ms of holding", SKIP_HINT_MS, 1000);
    Test_Eq("D146 the prompt fades in over 200 ms", SKIP_HINT_FADE_MS, 200);

    // --- 1. holding: 999 ms shows nothing and skips nothing
    var _r = Test_CutSkipRun(Skip_StateNew(), 999, 1, 999);
    Test_Eq("D146 held 999 ms: the prompt alpha is 0", Skip_HintAlpha(_r.st), 0);
    Test_Eq("D146 held 999 ms: the prompt never showed", _r.amax, 0);
    Test_Eq("D146 held 999 ms: no skip", _r.fired, 0);
    // from 1000 ms it fades in over 200 ms: half after 100 ms of fading, full after 200
    _r = Test_CutSkipRun(Skip_StateNew(), 1000, 1, 1000);
    Test_True("D146 held 1000 ms: the prompt starts to fade in (alpha " + string(Skip_HintAlpha(_r.st)) + ")", Skip_HintAlpha(_r.st) > 0 && Skip_HintAlpha(_r.st) < 0.02);
    _r = Test_CutSkipRun(Skip_StateNew(), 1100, 1, 1100);
    Test_True("D146 held 1100 ms: the prompt is half faded in (alpha " + string(Skip_HintAlpha(_r.st)) + ")", abs(Skip_HintAlpha(_r.st) - 0.5) < 0.01);
    _r = Test_CutSkipRun(Skip_StateNew(), 1200, 1, 1200);
    Test_Eq("D146 held 1200 ms: the prompt is fully shown", Skip_HintAlpha(_r.st), 1);
    _r = Test_CutSkipRun(Skip_StateNew(), 1999, 1, 1999);
    Test_Eq("D146 held 1999 ms: the prompt is fully shown", Skip_HintAlpha(_r.st), 1);
    Test_Eq("D146 held 1999 ms: no skip yet", _r.fired, 0);

    // released at 1500 ms: no skip, the prompt fades out, nothing is advanced (no fire, the hold count is back to 0)
    _r = Test_CutSkipRun(Skip_StateNew(), 1500, 1, 1500);
    Test_Eq("D146 held to 1500 ms: the prompt is fully shown", Skip_HintAlpha(_r.st), 1);
    _r = Test_CutSkipRun(_r.st, 100, 1, 0, false);   // 100 more ms with the key up
    Test_True("D146 100 ms after the release: the prompt is half faded out (alpha " + string(Skip_HintAlpha(_r.st)) + ")", abs(Skip_HintAlpha(_r.st) - 0.5) < 0.01);
    Test_Eq("D146 a release at 1500 ms: no skip", _r.fired, 0);
    Test_Eq("D146 a release at 1500 ms: the hold count is back to 0", _r.st.held_ms, 0);
    _r = Test_CutSkipRun(_r.st, 100, 1, 0, false);
    Test_Eq("D146 200 ms after the release: the prompt is gone", Skip_HintAlpha(_r.st), 0);
    Test_Eq("D146 200 ms after the release: still no skip", _r.fired, 0);
    // pressing again starts the count from 0
    _r = Test_CutSkipRun(_r.st, 500, 1, 500);
    Test_Eq("D146 a second press counts from 0: no prompt after 500 ms", _r.amax, 0);

    // held to 2000 ms: fires exactly once, at 2000, and holding longer does not fire again
    _r = Test_CutSkipRun(Skip_StateNew(), 3500, 1, 3500);
    Test_Eq("D146 held 3500 ms: exactly one skip", _r.fired, 1);
    Test_Eq("D146 the skip fires at the 2000 ms step", _r.fire_at, 2000);
    _r = Test_CutSkipRun(Skip_StateNew(), 2000, 1, 2000);
    Test_Eq("D146 held 2000 ms: the skip has fired once", _r.fired, 1);

    // the same at 60 fps and 30 fps steps (120 and 60 steps; one fewer does not fire)
    var _f60 = Presentation_StepMs(16667);
    var _f30 = Presentation_StepMs(33333);
    _r = Test_CutSkipRun(Skip_StateNew(), 119 * _f60, _f60, 1000000);
    Test_Eq("D146 119 steps at 60 fps: no skip", _r.fired, 0);
    _r = Test_CutSkipRun(Skip_StateNew(), 120 * _f60, _f60, 1000000);
    Test_Eq("D146 120 steps at 60 fps: skip", _r.fired, 1);
    _r = Test_CutSkipRun(Skip_StateNew(), 59 * _f30, _f30, 1000000);
    Test_Eq("D146 59 steps at 30 fps: no skip", _r.fired, 0);
    _r = Test_CutSkipRun(Skip_StateNew(), 60 * _f30, _f30, 1000000);
    Test_Eq("D146 60 steps at 30 fps: skip", _r.fired, 1);
    _r = Test_CutSkipRun(Skip_StateNew(), 59 * _f60, _f60, 1000000);
    Test_Eq("D146 59 steps at 60 fps (983 ms): no prompt", _r.amax, 0);

    // --- 2. a tap never shows the prompt and never skips; a key held from before the scene does neither
    _r = Test_CutSkipRun(Skip_StateNew(), 400, 1, 120);   // pressed, held 120 ms, released
    Test_Eq("D146 a tap: the prompt never shows", _r.amax, 0);
    Test_Eq("D146 a tap: no skip", _r.fired, 0);
    _r = Test_CutSkipRun(Skip_StateNew(), 3000, 1, 999);   // held 999 ms (the longest tap), then up for 2 s
    Test_Eq("D146 a 999 ms press: the prompt never shows", _r.amax, 0);
    Test_Eq("D146 a 999 ms press: no skip", _r.fired, 0);
    var _fired = 0, _amax = 0, _st = Skip_StateNew();
    for (var _i = 0; _i < 300; _i++) {   // many taps, one every 100 ms, each held 30 ms
        _st = Skip_Step(_st, true, (_i mod 100) == 0, (_i mod 100) < 30, 1);
        if (_st.fired) _fired++;
        _amax = max(_amax, Skip_HintAlpha(_st));
    }
    Test_Eq("D146 repeated taps: no prompt", _amax, 0);
    Test_Eq("D146 repeated taps: no skip", _fired, 0);
    _r = Test_CutSkipRun(Skip_StateNew(), 3000, 1, 3000, false);   // never pressed in the scene
    Test_Eq("D146 a key held from before the scene: no prompt", _r.amax, 0);
    Test_Eq("D146 a key held from before the scene: no skip", _r.fired, 0);
    // leaving the scene (nothing claims the skip) clears the prompt at once
    _r = Test_CutSkipRun(Skip_StateNew(), 1500, 1, 1500);
    _st = Skip_Step(_r.st, false, false, true, 1);
    Test_Eq("D146 leaving the scene hides the prompt", Skip_HintAlpha(_st), 0);
    Test_Eq("D146 leaving the scene clears the hold", _st.held_ms, 0);

    // --- 3. the bar: (held - 1000) / 1000, clamped 0..1
    Test_Eq("D146 bar at 0 ms", Skip_Fraction(0), 0);
    Test_Eq("D146 bar at 500 ms", Skip_Fraction(500), 0);
    Test_Eq("D146 bar at 1000 ms", Skip_Fraction(1000), 0);
    Test_Eq("D146 bar at 1250 ms", Skip_Fraction(1250), 0.25);
    Test_Eq("D146 bar at 1500 ms", Skip_Fraction(1500), 0.5);
    Test_Eq("D146 bar at 2000 ms", Skip_Fraction(2000), 1);
    Test_Eq("D146 bar past 2000 ms stays full", Skip_Fraction(2600), 1);
    _r = Test_CutSkipRun(Skip_StateNew(), 1500, 1, 1500);
    Test_Eq("D146 the live bar after a 1500 ms hold is half full", Skip_Fraction(_r.st.held_ms), 0.5);

    // --- 4. cutscene text goes through the shared dialogue box (D156)
    var _gs = GameState_Get();
    var _had_ui = variable_struct_exists(_gs, "ui");
    var _ui0 = _had_ui ? _gs.ui : undefined;
    var _had_ctl = instance_exists(obj_ui_controller);
    var _ui = {};
    if (is_struct(_ui0)) {
        var _names = variable_struct_get_names(_ui0);
        for (var _n = 0; _n < array_length(_names); _n++) variable_struct_set(_ui, _names[_n], variable_struct_get(_ui0, _names[_n]));
    }
    _ui.mode = UI_NONE;
    _ui.cutscene_active = true;
    _ui.cutscene_text_only = false;
    _ui.dialogue_box_half = false;
    _gs.ui = _ui;
    // a segment written the old way (text_only, a slow chars_per_sec) must still open in the normal box
    Cutscene_SegmentApply({ sprite: black_screen, lines: ["The plan was to ambush the enemy.", "You fell."], text_only: true, chars_per_sec: 12 });
    Test_Eq("D156 a cutscene line opens the dialogue", _gs.ui.mode, UI_DIALOGUE);
    Test_False("D156 the cutscene does not use the separate text-only style", Dialogue_IsCutsceneTextOnly());
    Test_False("D156 the cutscene does not use the tall half-screen box", _gs.ui.dialogue_box_half);
    var _mt = Ui_Metrics();
    var _box = Dialogue_BoxRect();
    var _lay = Dialogue_TextLayout("");
    Test_False("D156 the cutscene text layout is the normal one", _lay.cutscene_text_only);
    Test_Eq("D156 the box is the shared one: 8p + 3 lines high", _box.h, 8 * _mt.p + 3 * _mt.line_h);
    Test_Eq("D156 the box is the shared one: along the bottom edge", _box.y, _mt.gh - _box.h - _mt.margin);
    Test_Eq("D156 the text starts 4p inside the frame (x)", _lay.text_x, _box.x + 4 * _mt.p);
    Test_Eq("D156 the text starts 4p inside the frame (y)", _lay.text_y, _box.y + 4 * _mt.p);
    Test_Eq("D156 the text leaves 10p on the right for the arrow", _lay.text_w, _box.w - 14 * _mt.p);
    Dialogue_TypewriterPrepareCurrentLine();
    Test_Eq("D156 the typewriter speed is the normal dialogue one", _gs.ui.dialogue_chars_per_sec, max(1, 60 * Settings_TextSpeedMul(GameSettings_Ensure().text_speed)));
    Test_Eq("D156 the line is ready for the next confirm as soon as in a normal box", _gs.ui.dialogue_hold_duration_ms, 150);
    Test_Eq("D156 a cutscene line has no longer advance block than a normal one", _gs.ui.dialogue_open_lock.ms, 0);
    Dialogue_CloseNow();
    _gs.ui.cutscene_active = false;
    if (_had_ui) _gs.ui = _ui0; else variable_struct_remove(_gs, "ui");
    if (!_had_ctl && instance_exists(obj_ui_controller)) instance_destroy(obj_ui_controller);
}

// ============================================================================
// H14 (D157, D159): enemy vision as light, and the darker rooms with their light pools. Expected sets below are worked out by hand
// (a lit cell is one where some part can be seen from the middle of the viewer's cell), never copied from the code's output.
// Map characters: "." free, "#" wall (blocks sight and movement).
// A row of a visible set (Test_LightRows): "@" the viewer, "X" lit, "." inside the radius but dark, " " outside the radius, "!" lit but outside the radius (a bug).
// ============================================================================
function Test_LightRows(_g, _cx, _cy, _tiles, _see_through = false) {
    var _cone = Vis_Cone(_g, _cx, _cy, _tiles, _see_through);
    var _r = floor(_tiles);
    var _out = "";
    for (var _dy = -_r; _dy <= _r; _dy++) {
        var _row = "";
        for (var _dx = -_r; _dx <= _r; _dx++) {
            var _in = (_dx * _dx + _dy * _dy <= _tiles * _tiles);
            var _ch = " ";
            if (_dx == 0 && _dy == 0) _ch = "@";
            else if (Vis_Has(_cone, _cx + _dx, _cy + _dy)) _ch = _in ? "X" : "!";
            else if (_in) _ch = ".";
            _row += _ch;
        }
        _out += (_dy > -_r ? "|" : "") + _row;
    }
    return _out;
}

function Test_LightCount(_g, _cx, _cy, _tiles, _see_through = false) {
    var _cone = Vis_Cone(_g, _cx, _cy, _tiles, _see_through);
    var _r = floor(_tiles);
    var _n = 0;
    for (var _dy = -_r; _dy <= _r; _dy++) {
        for (var _dx = -_r; _dx <= _r; _dx++) {
            if (Vis_Has(_cone, _cx + _dx, _cy + _dy)) _n++;
        }
    }
    return _n;
}

function Test_LightOpen(_w, _h) {
    var _rows = [];
    var _row = "";
    for (var _i = 0; _i < _w; _i++) _row += ".";
    for (var _j = 0; _j < _h; _j++) array_push(_rows, _row);
    return _rows;
}

function Test_LightVis() {
    // an open room: the lit cells are exactly the circle (cells whose middle is within the radius)
    var _open = Nav_GridFromRows(Test_LightOpen(7, 7));
    Test_Eq("H14 vis: open room, radius 2 is the round 13-cell shape", Test_LightRows(_open, 3, 3, 2),
        "  X  | XXX |XX@XX| XXX |  X  ");
    var _big = Nav_GridFromRows(Test_LightOpen(13, 13));
    Test_Eq("H14 vis: open room, radius 1 lights 5 cells", Test_LightCount(_big, 6, 6, 1), 5);
    Test_Eq("H14 vis: open room, radius 2 lights 13 cells", Test_LightCount(_big, 6, 6, 2), 13);
    Test_Eq("H14 vis: open room, radius 3 lights 29 cells", Test_LightCount(_big, 6, 6, 3), 29);
    Test_Eq("H14 vis: open room, radius 4 lights 49 cells", Test_LightCount(_big, 6, 6, 4), 49);
    Test_Eq("H14 vis: open room, radius 5 lights 81 cells", Test_LightCount(_big, 6, 6, 5), 81);
    Test_Eq("H14 vis: open room, radius 2.5 lights 21 cells (2,1 is in, 2,2 is out)", Test_LightCount(_big, 6, 6, 2.5), 21);

    // one pillar two cells to the right: the two cells straight behind it are dark, the pillar itself and the cells beside the shadow are lit
    var _pil = Nav_GridFromRows(["...........", "...........", "...........", "...........", ".......#...", "...........", "...........", "...........", "..........."]);
    Test_Eq("H14 vis: a pillar casts a shadow behind it, radius 4", Test_LightRows(_pil, 5, 4, 4),
        "    X    |  XXXXX  | XXXXXXX | XXXXXXX |XXXX@XX..| XXXXXXX | XXXXXXX |  XXXXX  |    X    ");

    // a wall two cells to the right with a one-cell gap on the viewer's row: the light goes through the gap in a thin beam
    var _gap = Nav_GridFromRows(["......#..", "......#..", "......#..", "......#..", ".........", "......#..", "......#..", "......#..", "......#.."]);
    Test_Eq("H14 vis: a wall with a gap lets a thin beam through, radius 4", Test_LightRows(_gap, 4, 4, 4),
        "    X    |  XXXXX  | XXXXXX. | XXXXXXX |XXXX@XXXX| XXXXXXX | XXXXXX. |  XXXXX  |    X    ");

    // a room's edge counts as a wall: from the corner only the quarter inside the grid is lit, and nothing crashes
    var _corner = Nav_GridFromRows(Test_LightOpen(5, 5));
    var _cc = Vis_Cone(_corner, 0, 0, 2);
    var _in_ok = Vis_Has(_cc, 0, 0) && Vis_Has(_cc, 1, 0) && Vis_Has(_cc, 2, 0) && Vis_Has(_cc, 0, 1) && Vis_Has(_cc, 1, 1) && Vis_Has(_cc, 0, 2);
    Test_True("H14 vis: from a corner the six cells of the quarter circle are lit", _in_ok);
    Test_False("H14 vis: from a corner (2,1) is outside the circle", Vis_Has(_cc, 2, 1));
    Test_False("H14 vis: a cell far outside the cone's window is never lit", Vis_Has(_cc, 40, 40));

    // an enemy that sees through walls (ghosts): the whole circle, walls or not
    var _col = Nav_GridFromRows([".....#...", ".....#...", ".....#...", ".....#...", ".....#...", ".....#...", ".....#..."]);
    Test_Eq("H14 vis: a ghost's circle ignores the wall, radius 3 lights 29 cells", Test_LightCount(_col, 3, 3, 3, true), 29);
    Test_True("H14 vis: a ghost lights the cell behind the wall", Vis_Has(Vis_Cone(_col, 3, 3, 3, true), 6, 3));
    Test_False("H14 vis: a normal enemy does not light the cell behind the wall", Vis_Has(Vis_Cone(_col, 3, 3, 3, false), 6, 3));
    Test_True("H14 vis: a normal enemy lights the wall in front of it", Vis_Has(Vis_Cone(_col, 3, 3, 3, false), 5, 3));

    // the sight test and the light are the same set
    var _T = GRID_TILE_SIZE;
    Test_False("H14 vis: Sight_CanSee does not see the cell behind the pillar", Sight_CanSee(_pil, 5 * _T, 4 * _T, 8 * _T, 4 * _T, 4, false, false));
    Test_True("H14 vis: Sight_CanSee sees the cell beside the shadow", Sight_CanSee(_pil, 5 * _T, 4 * _T, 8 * _T, 3 * _T, 4, false, false));
    Test_True("H14 vis: Sight_CanSee sees the pillar's own cell", Sight_CanSee(_pil, 5 * _T, 4 * _T, 7 * _T, 4 * _T, 4, false, false));
    Test_False("H14 vis: Sight_CanSee does not see outside the radius", Sight_CanSee(_pil, 5 * _T, 4 * _T, 5 * _T, 9 * _T, 4, false, false));
    Test_True("H14 vis: a ghost's Sight_CanSee goes through the wall", Sight_CanSee(_col, 3 * _T, 3 * _T, 6 * _T, 3 * _T, 3, true, false));
    Test_False("H14 vis: a hidden player two cells away is not seen though the cell is lit", Sight_CanSee(_pil, 5 * _T, 4 * _T, 3 * _T, 4 * _T, 4, false, true));
    Test_True("H14 vis: a hidden player one cell away is seen", Sight_CanSee(_pil, 5 * _T, 4 * _T, 4 * _T, 4 * _T, 4, false, true));

    // the radius an enemy sees (and lights) with: its sight, one more while it chases, none for a boss
    var _slime = EnemyAI_Profile(ENEMY_SLIME);
    var _wolf = EnemyAI_Profile(ENEMY_DIREWOLF);
    var _boss = EnemyAI_Profile(ENEMY_FINAL_BOSS);
    Test_Eq("H14 vis: a slime lights a radius of 3 while idle (D179)", Vis_EnemyTiles(_slime, "idle"), 3);
    Test_Eq("H14 vis: a slime lights a radius of 4 while it chases (+1 tile)", Vis_EnemyTiles(_slime, "chase"), 4);
    Test_Eq("H14 vis: a slime lights a radius of 3 while it searches", Vis_EnemyTiles(_slime, "search"), 3);
    Test_Eq("H14 vis: a dire wolf lights a radius of 4 while idle (D179)", Vis_EnemyTiles(_wolf, "idle"), 4);
    Test_Eq("H14 vis: a dire wolf lights a radius of 5 while it chases", Vis_EnemyTiles(_wolf, "chase"), 5);
    Test_Eq("H14 vis: the final boss lights nothing", Vis_EnemyTiles(_boss, "idle"), 0);

    // the set is worked out once per (cell, radius) and again only when the grid changes
    var _cg = Nav_GridFromRows(Test_LightOpen(12, 12));
    var _b0 = Vis_BuildCount();
    for (var _i = 0; _i < 50; _i++) Sight_CanSee(_cg, 5 * _T, 5 * _T, (3 + (_i mod 5)) * _T, 5 * _T, 4, false, false);
    Test_Eq("H14 vis: 50 sight tests from one cell build the set once", Vis_BuildCount() - _b0, 1);
    Sight_CanSee(_cg, 6 * _T, 5 * _T, 3 * _T, 5 * _T, 4, false, false);
    Test_Eq("H14 vis: another cell builds one more", Vis_BuildCount() - _b0, 2);
    Sight_CanSee(_cg, 5 * _T, 5 * _T, 3 * _T, 5 * _T, 5, false, false);
    Test_Eq("H14 vis: another radius builds one more", Vis_BuildCount() - _b0, 3);
    Sight_CanSee(_cg, 5 * _T, 5 * _T, 3 * _T, 5 * _T, 4, false, false);
    Sight_CanSee(_cg, 6 * _T, 5 * _T, 3 * _T, 5 * _T, 4, false, false);
    Test_Eq("H14 vis: going back to a known cell and radius builds nothing", Vis_BuildCount() - _b0, 3);
    Nav_GridSet(_cg, 7, 5, true, true);
    Sight_CanSee(_cg, 5 * _T, 5 * _T, 3 * _T, 5 * _T, 4, false, false);
    Test_Eq("H14 vis: a changed grid builds the set again", Vis_BuildCount() - _b0, 4);
    Test_False("H14 vis: the new wall now hides the cell behind it", Sight_CanSee(_cg, 5 * _T, 5 * _T, 9 * _T, 5 * _T, 4, false, false));
}

// For every floor room and every enemy slot at its home cell, every cell within the radius is lit exactly when EnemyAI_CanSee would see a (not hidden) player standing there;
// a hidden player is seen only within 1 tile (D153). Also: the circle, the viewer's own cell, and a bigger radius never lights less.
function Test_LightConsistency() {
    var _rooms = Scenario_GridRooms();
    var _T = GRID_TILE_SIZE;
    var _bad = "";
    var _bad_h = "";
    var _bad_sub = "";
    var _bad_circle = "";
    var _cells = 0;
    var _cones = 0;
    var _prof = EnemyAI_Profile(ENEMY_SLIME);
    for (var _ri = 0; _ri < array_length(_rooms); _ri++) {
        var _name = room_get_name(_rooms[_ri]);
        var _m = Test_H11Model(_rooms[_ri]);
        var _g = _m.grid;
        var _nav = { grid: _g };
        for (var _si = 0; _si < array_length(_m.slots); _si++) {
            var _ex = _m.slots[_si].x;
            var _ey = _m.slots[_si].y;
            var _ecx = Nav_CellOf(_ex + _T / 2);
            var _ecy = Nav_CellOf(_ey + _T / 2);
            var _inst = { x: _ecx * _T, y: _ecy * _T, prof: _prof };
            for (var _tiles = 3; _tiles <= 6; _tiles++) {
                var _cone = Vis_Cone(_g, _ecx, _ecy, _tiles, false);
                var _bigger = Vis_Cone(_g, _ecx, _ecy, _tiles + 1, false);
                _cones++;
                if (!Vis_Has(_cone, _ecx, _ecy)) _bad_circle += " " + _name + "/" + string(_ecx) + "," + string(_ecy) + ":own-cell";
                for (var _dy = -_tiles - 1; _dy <= _tiles + 1; _dy++) {
                    for (var _dx = -_tiles - 1; _dx <= _tiles + 1; _dx++) {
                        var _cx = _ecx + _dx;
                        var _cy = _ecy + _dy;
                        var _lit = Vis_Has(_cone, _cx, _cy);
                        var _in = (_dx * _dx + _dy * _dy <= _tiles * _tiles);
                        if (_lit && !_in) _bad_circle += " " + _name + "/" + string(_ecx) + "," + string(_ecy) + ":outside(" + string(_dx) + "," + string(_dy) + ")";
                        if (_lit && !Vis_Has(_bigger, _cx, _cy)) _bad_sub += " " + _name + "/" + string(_ecx) + "," + string(_ecy) + ":r" + string(_tiles) + "(" + string(_dx) + "," + string(_dy) + ")";
                        if (!_in || !Nav_GridInside(_g, _cx, _cy)) continue;
                        _cells++;
                        var _pl = { x: _cx * _T, y: _cy * _T };
                        var _sees = EnemyAI_CanSee(_inst, _pl, _nav, _tiles, false);
                        if (_sees != _lit && string_length(_bad) < 400) _bad += " " + _name + "/" + string(_ecx) + "," + string(_ecy) + ":r" + string(_tiles) + "(" + string(_dx) + "," + string(_dy) + ")" + (_lit ? "lit-not-seen" : "seen-not-lit");
                        var _seesh = EnemyAI_CanSee(_inst, _pl, _nav, _tiles, true);
                        var _want_h = _lit && (max(abs(_dx), abs(_dy)) <= HIDE_SEEN_TILES);
                        if (_seesh != _want_h && string_length(_bad_h) < 400) _bad_h += " " + _name + "/" + string(_ecx) + "," + string(_ecy) + ":r" + string(_tiles) + "(" + string(_dx) + "," + string(_dy) + ")";
                    }
                }
            }
        }
    }
    Test_True("H14 consistency: the rooms hold cones to check (" + string(_cones) + " cones, " + string(_cells) + " cells)", _cones >= 50 && _cells > 2000);
    Test_Eq("H14 consistency: a cell is lit exactly when EnemyAI_CanSee sees a player there (bad:" + _bad + ")", _bad, "");
    Test_Eq("H14 consistency: a hidden player is seen only on a lit cell within 1 tile (bad:" + _bad_h + ")", _bad_h, "");
    Test_Eq("H14 consistency: the set stays inside the circle and holds the enemy's own cell (bad:" + _bad_circle + ")", _bad_circle, "");
    Test_Eq("H14 consistency: a bigger radius never lights less (bad:" + _bad_sub + ")", _bad_sub, "");
}

// Light sources: one entry per LIT fire stand or torch placed in the room (the objects are read from the room asset here, not from the table).
function Test_LightSources() {
    var _rooms = Scenario_GridRooms();
    var _with = 0;
    var _bad = "";
    var _bad_shape = "";
    var _pal = [UI_C_DARKEST, UI_C_DARK, UI_C_LIGHT, UI_C_LIGHTEST];
    for (var _ri = 0; _ri < array_length(_rooms); _ri++) {
        var _name = room_get_name(_rooms[_ri]);
        var _info = room_get_info(_rooms[_ri], false, true, false, false, false);
        var _want = [];
        for (var _i = 0; _i < array_length(_info.instances); _i++) {
            var _in = _info.instances[_i];
            var _o = _in.object_index;
            if (is_string(_o)) _o = asset_get_index(_o);
            if (_o == obj_fire_stand || _o == obj_torch) array_push(_want, string(Nav_CellOf(_in.x + 8)) + "," + string(Nav_CellOf(_in.y + 8)));
        }
        var _src = Light_Sources(_name);
        var _got = [];
        for (var _k = 0; _k < array_length(_src); _k++) {
            array_push(_got, string(_src[_k].cx) + "," + string(_src[_k].cy));
            var _ok_col = false;
            for (var _p = 0; _p < 4; _p++) if (_src[_k].col == _pal[_p]) _ok_col = true;
            if (!(_src[_k].r >= 2 && _src[_k].r <= 5 && _ok_col)) _bad_shape += " " + _name + ":" + string(_k);
        }
        array_sort(_want, true);
        array_sort(_got, true);
        var _ws = "";
        var _gs = "";
        for (var _q = 0; _q < array_length(_want); _q++) _ws += _want[_q] + ";";
        for (var _q2 = 0; _q2 < array_length(_got); _q2++) _gs += _got[_q2] + ";";
        if (_ws != _gs) _bad += " " + _name + ":want[" + _ws + "]got[" + _gs + "]";
        if (array_length(_got) > 0) _with++;
    }
    Test_Eq("H14 light: every lit fire stand and torch of every room is a listed source (bad:" + _bad + ")", _bad, "");
    Test_Eq("H14 light: every source has a radius of 2..5 tiles and a palette colour (bad:" + _bad_shape + ")", _bad_shape, "");
    Test_Eq("H14 light: 9 rooms have light sources", _with, 9);
    Test_Eq("H14 light: rm_floor2 has none", array_length(Light_Sources("rm_floor2")), 0);
    Test_Eq("H14 light: an unknown room has none", array_length(Light_Sources("rm_nothing")), 0);
    Test_Eq("H14 light: rm_floor8 lists 6 fire stands", array_length(Light_Sources("rm_floor8")), 6);
    Test_Eq("H14 light: rm_floor6 lists 2 torches and 2 fire stands", array_length(Light_Sources("rm_floor6")), 4);

    // flicker: inside its stated range, deterministic for a given time, steady inside one tick, and it does move
    var _r_px = 3.5 * GRID_TILE_SIZE;
    var _rng = Light_FlickerRange(_r_px);
    Test_True("H14 light: the flicker range is the radius -12% .. +12%", abs(_rng.lo - _r_px * 0.88) < 0.001 && abs(_rng.hi - _r_px * 1.12) < 0.001);
    var _out = 0;
    var _lo = 1000000;
    var _hi = -1000000;
    var _nondet = 0;
    for (var _seed = 0; _seed < 20; _seed++) {
        for (var _ms = 0; _ms < 60000; _ms += 41) {
            var _v = Light_FlickerRadius(_r_px, _seed, _ms);
            if (_v < _rng.lo - 0.0001 || _v > _rng.hi + 0.0001) _out++;
            if (_v != Light_FlickerRadius(_r_px, _seed, _ms)) _nondet++;
            _lo = min(_lo, _v);
            _hi = max(_hi, _v);
        }
    }
    Test_Eq("H14 light: the flickering radius never leaves its range (60000 ms, 20 seeds)", _out, 0);
    Test_Eq("H14 light: the flicker is deterministic for a given time", _nondet, 0);
    Test_True("H14 light: the flicker really moves (spread " + string(_hi - _lo) + " of " + string(_rng.hi - _rng.lo) + ")", (_hi - _lo) > 0.6 * (_rng.hi - _rng.lo));
    Test_Eq("H14 light: the flicker is steady inside one 90 ms tick", Light_FlickerRadius(_r_px, 3, 900), Light_FlickerRadius(_r_px, 3, 950));
    Test_True("H14 light: two seeds do not flicker in step", Light_FlickerRadius(_r_px, 1, 900) != Light_FlickerRadius(_r_px, 2, 900) || Light_FlickerRadius(_r_px, 1, 1800) != Light_FlickerRadius(_r_px, 2, 1800));
}

function Test_LightLook() {
    Test_Eq("H14 look: the base darkness alpha is 0.28 (D164 amends the 0.4 of D159)", LIGHT_DARK_ALPHA, 0.28);
    Test_Eq("H14 look: the darkness colour is #071821 (red 7)", colour_get_red(LIGHT_DARK_COLOUR), 7);
    Test_Eq("H14 look: the darkness colour is #071821 (green 24)", colour_get_green(LIGHT_DARK_COLOUR), 24);
    Test_Eq("H14 look: the darkness colour is #071821 (blue 33)", colour_get_blue(LIGHT_DARK_COLOUR), 33);
    Test_Eq("H14 look: the darkness colour is the palette's darkest", LIGHT_DARK_COLOUR, UI_C_DARKEST);

    // the pocket a hidden player sits in: dark unless the enemy is within 1 tile of the player
    Test_True("H14 pocket: a hidden player's cell is dark for an enemy 3 tiles away", Light_PocketCell(8, 4, 5, 4));
    Test_False("H14 pocket: not for an enemy next to it", Light_PocketCell(6, 4, 5, 4));
    Test_False("H14 pocket: not for an enemy diagonally next to it", Light_PocketCell(6, 5, 5, 4));
    Test_False("H14 pocket: no hidden player, no pocket", Light_PocketCell(8, 4, -1, -1));

    // the light surface: made on demand, made again when it was lost, resized when the view changes
    var _s1 = Light_EnsureSurface(160, 144);
    Test_True("H14 surface: the light surface exists", surface_exists(_s1));
    Test_Eq("H14 surface: it is as big as the view (160 wide)", surface_get_width(_s1), 160);
    Test_Eq("H14 surface: it is as big as the view (144 high)", surface_get_height(_s1), 144);
    surface_free(_s1);
    Test_False("H14 surface: it is gone after a loss", surface_exists(_s1));
    var _s2 = Light_EnsureSurface(160, 144);
    Test_True("H14 surface: it is made again after a loss", surface_exists(_s2));
    var _s3 = Light_EnsureSurface(80, 72);
    Test_True("H14 surface: it follows a new view size", surface_exists(_s3) && surface_get_width(_s3) == 80 && surface_get_height(_s3) == 72);
    Light_FreeSurface();
    Test_False("H14 surface: freed on request", surface_exists(_s3));
}

function Test_Suite_Lighting() {
    var _need = ["Vis_Cone", "Vis_Has", "Vis_BuildCount", "Vis_EnemyTiles", "Light_Sources", "Light_FlickerRadius", "Light_FlickerRange", "Light_PocketCell", "Light_EnsureSurface", "Light_FreeSurface"];
    var _missing = "";
    for (var _i = 0; _i < array_length(_need); _i++) {
        if (asset_get_index(_need[_i]) == -1) _missing += " " + _need[_i];
    }
    Test_Eq("H14 the lighting functions exist (missing:" + _missing + ")", _missing, "");
    if (_missing != "") return;
    Test_LightVis();
    Test_LightConsistency();
    Test_LightSources();
    Test_LightLook();
}

// ---- D164 (amends D159): lighter rooms, daylight rooms with sun spots, extra torches placed in code ----
// Expected values come from D164 and the packet brief, not from the code: the base darkness is lighter than the 0.4 of D159 but not barely dimmed
// (0.2 .. 0.4 for a plain room), a room open to the sky (rm_floor2) is about 0.10 (never above 0.15), every daylight room has at least one sun spot,
// every sun spot is inside its room, and an extra torch sits on a wall cell that faces a floor cell, never on an exit or a spawn, at most 3 to a room, 4 tiles apart.
function Test_D164Rooms() {
    return ["rm_floor1", "rm_floor2", "rm_floor3", "rm_floor4", "rm_floor5", "rm_floor6", "rm_floor6_5", "rm_floor7", "rm_floor8", "rm_floor9", "rm_floor9_5"];
}

function Test_D164RoomIds() {
    return [rm_floor1, rm_floor2, rm_floor3, rm_floor4, rm_floor5, rm_floor6, rm_floor6_5, rm_floor7, rm_floor8, rm_floor9, rm_floor9_5];
}

function Test_D164Dark() {
    Test_True("D164 dark: a plain room (rm_floor3) is lighter than 0.4 (" + string(Light_RoomDark("rm_floor3")) + ")", Light_RoomDark("rm_floor3") < 0.4);
    Test_True("D164 dark: a plain room (rm_floor3) keeps the effect, 0.2 or more", Light_RoomDark("rm_floor3") >= 0.2);
    Test_True("D164 dark: the daylight room rm_floor2 is 0.15 or less (" + string(Light_RoomDark("rm_floor2")) + ")", Light_RoomDark("rm_floor2") <= 0.15);
    Test_True("D164 dark: the daylight room is not pitch bright either (0.05 or more)", Light_RoomDark("rm_floor2") >= 0.05);
    Test_Eq("D164 dark: the base darkness macro is 0.28", LIGHT_DARK_ALPHA, 0.28);
    Test_Eq("D164 dark: an unknown room gets the base darkness", Light_RoomDark("rm_nothing"), LIGHT_DARK_ALPHA);
    var _day = Light_DaylightRooms();
    var _bad = "";
    var _rooms = Test_D164Rooms();
    for (var _i = 0; _i < array_length(_rooms); _i++) {
        var _d = Light_RoomDark(_rooms[_i]);
        var _is_day = false;
        for (var _k = 0; _k < array_length(_day); _k++) if (_day[_k] == _rooms[_i]) _is_day = true;
        if (_is_day) { if (!(_d <= 0.15 && _d >= 0.05)) _bad += " " + _rooms[_i] + ":" + string(_d); }
        else if (!(_d >= 0.2 && _d < 0.4)) _bad += " " + _rooms[_i] + ":" + string(_d);
    }
    Test_Eq("D164 dark: every daylight room is 0.05..0.15 and every other room 0.2..0.4 (bad:" + _bad + ")", _bad, "");
    var _has2 = false;
    for (var _k2 = 0; _k2 < array_length(_day); _k2++) if (_day[_k2] == "rm_floor2") _has2 = true;
    Test_True("D164 dark: rm_floor2 is a daylight room", _has2);
}

function Test_D164Sun() {
    var _day = Light_DaylightRooms();
    var _bad_day = "";
    for (var _i = 0; _i < array_length(_day); _i++) {
        var _n = 0;
        var _src = Light_AllSources(_day[_i]);
        for (var _k = 0; _k < array_length(_src); _k++) if (_src[_k].sun) _n++;
        if (_n < 1) _bad_day += " " + _day[_i];
    }
    Test_Eq("D164 sun: every daylight room has at least one sun spot (bad:" + _bad_day + ")", _bad_day, "");
    var _bad_in = "";
    var _bad_shape = "";
    var _suns = 0;
    var _rooms = Test_D164Rooms();
    var _rm = Test_D164RoomIds();
    for (var _ri = 0; _ri < array_length(_rooms); _ri++) {
        var _info = room_get_info(_rm[_ri], false, false, false, false, false);
        var _w = ceil(_info.width / GRID_TILE_SIZE);
        var _h = ceil(_info.height / GRID_TILE_SIZE);
        var _all = Light_AllSources(_rooms[_ri]);
        for (var _q = 0; _q < array_length(_all); _q++) {
            var _s = _all[_q];
            if (!_s.sun) continue;
            _suns++;
            if (!(_s.cx >= 0 && _s.cy >= 0 && _s.cx < _w && _s.cy < _h)) _bad_in += " " + _rooms[_ri] + ":" + string(_s.cx) + "," + string(_s.cy);
            if (!(_s.r >= 2 && _s.r <= 6 && _s.obj == noone && Light_IsLit(_s))) _bad_shape += " " + _rooms[_ri] + ":" + string(_s.cx) + "," + string(_s.cy);
        }
    }
    Test_Eq("D164 sun: every sun spot is inside its room grid (bad:" + _bad_in + ")", _bad_in, "");
    Test_Eq("D164 sun: every sun spot has a radius of 2..6 tiles, no object and is always lit (bad:" + _bad_shape + ")", _bad_shape, "");
    Test_True("D164 sun: the rooms list at least 4 sun spots (" + string(_suns) + ")", _suns >= 4);
    var _s1 = Light_Sun(3, 4, 5);
    Test_True("D164 sun: Light_Sun makes a sun source (no object, always lit)", _s1.sun && _s1.obj == noone && _s1.cx == 3 && _s1.cy == 4 && _s1.r == 5 && Light_IsLit(_s1));
    Test_False("D164 sun: a fire stand or torch is not a sun", Light_Fire(1, 1).sun || Light_Torch(1, 1).sun);
    Test_Eq("D164 sun: the fixtures of the room art are unchanged (rm_floor3 lists its fire stand only)", array_length(Light_Sources("rm_floor3")), 1);
}

function Test_D164Torches() {
    var _rooms = Test_D164Rooms();
    var _rm = Test_D164RoomIds();
    var _bad_wall = "";
    var _bad_face = "";
    var _bad_exit = "";
    var _bad_gap = "";
    var _bad_over = "";
    var _bad_fix = "";
    var _total = 0;
    var _with = 0;
    for (var _ri = 0; _ri < array_length(_rooms); _ri++) {
        var _list = Light_ExtraTorches(_rooms[_ri]);
        if (array_length(_list) > 0) _with++;
        _total += array_length(_list);
        if (array_length(_list) > 3) _bad_over += " " + _rooms[_ri];
        var _m = Test_H11Model(_rm[_ri]);
        var _g = _m.grid;
        var _fix = Light_Sources(_rooms[_ri]);
        for (var _i = 0; _i < array_length(_list); _i++) {
            var _c = _list[_i];
            var _tag = " " + _rooms[_ri] + ":" + string(_c.cx) + "," + string(_c.cy);
            if (!(Nav_CellBlocked(_g, _c.cx, _c.cy) && Nav_SightBlocked(_g, _c.cx, _c.cy))) _bad_wall += _tag;
            var _free = (!Nav_CellBlocked(_g, _c.cx + 1, _c.cy)) || (!Nav_CellBlocked(_g, _c.cx - 1, _c.cy)) || (!Nav_CellBlocked(_g, _c.cx, _c.cy + 1)) || (!Nav_CellBlocked(_g, _c.cx, _c.cy - 1));
            if (!_free) _bad_face += _tag;
            for (var _e = 0; _e < array_length(_m.exits); _e++) if (max(abs(_m.exits[_e][0] - _c.cx), abs(_m.exits[_e][1] - _c.cy)) < 2) { _bad_exit += _tag; break; }
            for (var _sp = 0; _sp < array_length(_m.spawns); _sp++) if (max(abs(_m.spawns[_sp][0] - _c.cx), abs(_m.spawns[_sp][1] - _c.cy)) < 2) { _bad_exit += _tag; break; }
            for (var _j = _i + 1; _j < array_length(_list); _j++) {
                if (point_distance(_c.cx, _c.cy, _list[_j].cx, _list[_j].cy) < 4) _bad_gap += _tag + "~" + string(_list[_j].cx) + "," + string(_list[_j].cy);
            }
            for (var _f = 0; _f < array_length(_fix); _f++) if (_fix[_f].cx == _c.cx && _fix[_f].cy == _c.cy) _bad_fix += _tag;
        }
    }
    Test_Eq("D164 torches: every extra torch stands on a wall cell of the nav grid (bad:" + _bad_wall + ")", _bad_wall, "");
    Test_Eq("D164 torches: every extra torch has a free 4-neighbour (faces a floor cell) (bad:" + _bad_face + ")", _bad_face, "");
    Test_Eq("D164 torches: no extra torch is on or next to an exit or a spawn (bad:" + _bad_exit + ")", _bad_exit, "");
    Test_Eq("D164 torches: extra torches in a room are 4 tiles apart or more (bad:" + _bad_gap + ")", _bad_gap, "");
    Test_Eq("D164 torches: at most 3 extra torches in a room (bad:" + _bad_over + ")", _bad_over, "");
    Test_Eq("D164 torches: no extra torch on a cell that already holds a fire stand or torch (bad:" + _bad_fix + ")", _bad_fix, "");
    Test_True("D164 torches: more torches (" + string(_total) + " extra, at least 8)", _total >= 8);
    Test_True("D164 torches: at least 5 rooms get extra torches (" + string(_with) + ")", _with >= 5);
    Test_Eq("D164 torches: a daylight room gets none (rm_floor2)", array_length(Light_ExtraTorches("rm_floor2")), 0);
    Test_Eq("D164 torches: an unknown room gets none", array_length(Light_ExtraTorches("rm_nothing")), 0);
    // the full list of a room = the room art's fixtures + sun spots + the extra torches
    var _suns3 = 0;
    var _all3 = Light_AllSources("rm_floor3");
    for (var _q = 0; _q < array_length(_all3); _q++) if (_all3[_q].sun) _suns3++;
    Test_Eq("D164 torches: rm_floor3's full list is its fixtures, its sun spots and its extra torches", array_length(_all3), array_length(Light_Sources("rm_floor3")) + _suns3 + array_length(Light_ExtraTorches("rm_floor3")));
    Test_True("D164 torches: rm_floor3's extra torches are in its full list and lit by an obj_torch", array_length(_all3) >= 3 && _all3[array_length(_all3) - 1].obj == obj_torch);
}

function Test_Suite_D164() {
    var _need = ["Light_RoomDark", "Light_Sun", "Light_DaylightRooms", "Light_ExtraTorches", "Light_AllSources", "Light_PlaceExtraTorches"];
    var _missing = "";
    for (var _i = 0; _i < array_length(_need); _i++) {
        if (asset_get_index(_need[_i]) == -1) _missing += " " + _need[_i];
    }
    Test_Eq("D164 the lighting functions exist (missing:" + _missing + ")", _missing, "");
    if (_missing != "") return;
    Test_D164Dark();
    Test_D164Sun();
    Test_D164Torches();
}

// ---- H7: lore notes (D147) ----
// Expected values come from D147 and the packet brief: a note is picked up by walking onto it (no key), is read once, is gone from the map at once, never
// spawns again in any later run (the profile remembers it) and never blocks a path; the found ones are read in the Codex Notes page, which says "found x/8".
function Test_Suite_Notes() {
    var _defs = Note_Defs();
    Test_Eq("D147 still eight notes", array_length(_defs), 8);

    // which notes stand on the map
    var _p = Profile_Default();
    Test_Eq("D147 a fresh profile: rm_floor1 has its note", array_length(Notes_ToSpawn(_p, "rm_floor1", 0)), 1);
    Test_Eq("D147 a note that is not found yet and has its deaths still spawns", array_length(Notes_ToSpawn(_p, "rm_floor2", 3)), 1);
    Test_Eq("D147 a note waits for its deaths", array_length(Notes_ToSpawn(_p, "rm_floor2", 2)), 0);
    Test_Eq("D147 a room without notes has none", array_length(Notes_ToSpawn(_p, "rm_battle", 99)), 0);
    Note_MarkCollected(_p, "map_page");
    Test_Eq("D147 a found note never spawns again", array_length(Notes_ToSpawn(_p, "rm_floor1", 0)), 0);
    Test_Eq("D147 another note still spawns", array_length(Notes_ToSpawn(_p, "rm_floor3", 0)), 1);
    var _pn = Profile_Normalize(json_parse(json_stringify(_p)));
    Test_Eq("D147 a note found in an earlier run is still gone in a later one (profile in, profile out)", array_length(Notes_ToSpawn(_pn, "rm_floor1", 0)), 0);

    // walking onto a note picks it up
    var _p2 = Profile_Default();
    var _d = Note_Find("map_page");
    Notes_LiveSet("rm_floor1", Notes_ToSpawn(_p2, "rm_floor1", 0));
    Test_Eq("D147 the note is on the map", Notes_LiveCount("rm_floor1"), 1);
    Test_Eq("D147 it is the survey page, on its tile", Notes_LiveAtTile("rm_floor1", _d.tx, _d.ty), "map_page");
    Test_Eq("D147 another tile has none", Notes_LiveAtTile("rm_floor1", _d.tx + 1, _d.ty), "");
    Test_Eq("D147 another room has none", Notes_LiveAtTile("rm_floor2", _d.tx, _d.ty), "");
    Test_False("D147 standing next to it picks nothing up", is_struct(Notes_PickupAt(_p2, "rm_floor1", _d.tx + 1, _d.ty)));
    Test_False("D147 so it is not found yet", Note_IsCollected(_p2, "map_page"));
    var _got = Notes_PickupAt(_p2, "rm_floor1", _d.tx, _d.ty);
    Test_True("D147 stepping on it picks the note up", is_struct(_got) && _got.id == "map_page");
    Test_True("D147 it is marked found in the profile", Note_IsCollected(_p2, "map_page"));
    Test_Eq("D147 it is gone from the map at once", Notes_LiveCount("rm_floor1"), 0);
    Test_False("D147 stepping on the same tile again picks up nothing", is_struct(Notes_PickupAt(_p2, "rm_floor1", _d.tx, _d.ty)));
    Test_Eq("D147 the notice names the note", Note_FoundText(_got), "Note found: Torn survey page");
    Notes_LiveSet("", []);

    // the Codex page: found by title, the rest ???, a count, a reader
    var _r0 = Codex_NoteRows(Profile_Default());
    Test_Eq("D147 the page has a row for all 8", array_length(_r0), 8);
    Test_Eq("D147 nothing found: every row is ???", _r0[0].label + _r0[7].label, "??????");
    Test_Eq("D147 the title counts what is found (none)", Codex_NotesTitle(Profile_Default()), "Notes Found 0/8");
    var _r1 = Codex_NoteRows(_p2);
    Test_Eq("D147 a found note is listed by its title", _r1[0].label, "Torn survey page");
    Test_Eq("D147 the others stay ???", _r1[1].label, "???");
    Test_Eq("D147 the title counts what is found (one)", Codex_NotesTitle(_p2), "Notes Found 1/8");
    Test_Eq("D147 a found row knows which note it opens", _r1[0].note_id, "map_page");
    Test_False("D147 a ??? row opens nothing", variable_struct_exists(_r1[1], "note_id"));
    Test_True("D147 a found row's footer says Read", string_pos("Read", _r1[0].hint) > 0);

    // the reader: full text, scrolls when long, Back closes (one level up)
    var _text = NoteReader_Text(_d);
    Test_True("D147 the reader has every line of the note", string_pos(_d.lines[0], _text) > 0 && string_pos(_d.lines[1], _text) > 0 && string_pos(_d.lines[2], _text) > 0);
    var _rd = NoteReader_New(_d);
    Test_Eq("D147 the reader shows the note's title", _rd.layout.title, "Torn survey page");
    Test_True("D147 the reader is marked as a reader", _rd.data.reader);
    Test_Eq("D147 a short text does not scroll", NoteReader_MaxScroll(3, 8), 0);
    Test_Eq("D147 a long text scrolls by what does not fit", NoteReader_MaxScroll(20, 8), 12);
    Test_Eq("D147 down moves one line", NoteReader_Scroll(3, 1, 20, 8), 4);
    Test_Eq("D147 down stops at the last line", NoteReader_Scroll(12, 1, 20, 8), 12);
    Test_Eq("D147 up stops at the top", NoteReader_Scroll(0, -1, 20, 8), 0);
    Test_Eq("D147 up moves one line", NoteReader_Scroll(5, -1, 20, 8), 4);
    Test_Eq("D147 a text that fits stays at the top", NoteReader_Scroll(0, 1, 3, 8), 0);
    var _long = "";
    for (var _i = 0; _i < 30; _i++) _long += "A long note goes on and on. ";
    Test_True("D147 long text wraps to many lines", array_length(NoteReader_Lines(_long, 120)) > array_length(NoteReader_Lines("Hi", 120)) + 5);

    // the notice and the rise on the map
    Test_Eq("D147 a note rises out of the tile as a note", MapFx_RiseKind("note"), "note");
    MapFx_Clear();
    MapFx_NoteFound(24, 100);
    Test_Eq("D147 picking a note up starts one rise effect", MapFx_Count("rise"), 1);
    MapFx_Clear();

    // the profile file keeps what was found
    var _f = "test_notes_profile.sav";
    Save_DeleteFileSet(_f);
    var _w = Profile_Default();
    Note_MarkCollected(_w, "wall_breath");
    Note_MarkCollected(_w, "carved_arrow");
    Test_True("D147 profile write reports success", Profile_SaveTo(_f, _w));
    var _lr = Profile_Load(_f);
    Test_Eq("D147 profile reads back ok", _lr.status, "ok");
    Test_True("D147 found notes survive the profile file", Note_IsCollected(_lr.profile, "wall_breath") && Note_IsCollected(_lr.profile, "carved_arrow") && !Note_IsCollected(_lr.profile, "map_page"));
    Test_Eq("D147 the count survives the profile file", Codex_NoteCount(_lr.profile), 2);
    Save_DeleteFileSet(_f);
}

// ============================================================================
// H5 (D144, D148): skill memory in the profile (version 2), the echo of discovered skills of the picked class, and the class screen
// (undiscovered skills read ???, a locked Nobody is greyed, a sprite preview, lore text with no "to find"). Expected values come from the brief.
// ============================================================================
function Test_ClassMemV1Json() {
    return "{\"profile_version\":1,\"story_seen\":{\"cutscene:intro\":true},\"unlocks\":{\"nobody_class\":true,\"item_9\":true},\"echo_pool\":[{\"kind\":\"item\",\"id\":11}],"
        + "\"history\":[{\"seed\":5,\"class_id\":1,\"level\":4,\"floor\":3,\"room\":\"rm_floor3\",\"result\":\"died\",\"cause\":\"enemy 0\",\"kills\":6,\"gold\":0}],"
        + "\"bestiary\":{\"e1\":{\"met\":3,\"elite\":false}},\"deaths\":4,\"wins\":1,\"runs_started\":6,\"best_floor\":3,\"legacy_notice_seen\":true}";
}

function Test_ClassMemSet(_ids) {
    var _p = Profile_Default();
    for (var _i = 0; _i < array_length(_ids); _i++) Profile_SkillLearn(_p, _ids[_i]);
    return _p;
}

function Test_ClassMemSameSet(_a, _ids) {
    if (array_length(_a) != array_length(_ids)) return false;
    for (var _i = 0; _i < array_length(_ids); _i++) { if (!array_contains(_a, _ids[_i])) return false; }
    return true;
}

function Test_ClassMemOfferIds(_opts) {
    var _out = [];
    for (var _i = 0; _i < array_length(_opts); _i++) array_push(_out, _opts[_i].id);
    return _out;
}

function Test_ClassMemRowTexts(_m) {
    var _t = "";
    for (var _i = 0; _i < array_length(_m.items); _i++) {
        var _it = _m.items[_i];
        _t += "|" + string(_it.label) + "|" + string(_it.value) + "|" + string(_it.help);
        for (var _l = 0; _l < array_length(_it.lines); _l++) _t += "|" + string(_it.lines[_l].label) + "|" + string(_it.lines[_l].value);
    }
    return _t;
}

function Test_ClassMemMigration() {
    // 1. a hand-written v1 profile loads as v2 with an empty skill memory and every other field intact
    var _f = "test_profile_h5.sav";
    Save_DeleteFileSet(_f);
    Test_RawWrite(_f, Test_ClassMemV1Json());
    var _r = Profile_Load(_f);
    var _p = _r.profile;
    Test_Eq("H5 migration: a v1 file still loads (not rejected as old)", _r.status, "ok");
    Test_Eq("H5 migration: the profile version is now 3 (saves1: name)", _p.profile_version, 3);
    Test_Eq("H5 migration: PROFILE_VERSION is 3 (saves1: name)", PROFILE_VERSION, 3);
    Test_True("H5 migration: the skill memory exists and is empty", variable_struct_exists(_p, "skills_known") && is_struct(_p.skills_known) && array_length(variable_struct_get_names(_p.skills_known)) == 0);
    Test_Eq("H5 migration: deaths kept", _p.deaths, 4);
    Test_Eq("H5 migration: wins kept", _p.wins, 1);
    Test_Eq("H5 migration: runs started kept", _p.runs_started, 6);
    Test_Eq("H5 migration: best floor kept", _p.best_floor, 3);
    Test_True("H5 migration: legacy_notice_seen kept", _p.legacy_notice_seen);
    Test_True("H5 migration: story kept", Profile_StorySeen(_p, "cutscene:intro"));
    Test_True("H5 migration: unlocks kept", Profile_IsUnlocked(_p, "nobody_class") && Profile_IsUnlocked(_p, "item_9"));
    Test_True("H5 migration: history kept", array_length(_p.history) == 1 && _p.history[0].room == "rm_floor3" && _p.history[0].seed == 5 && _p.history[0].kills == 6);
    Test_True("H5 migration: bestiary kept", variable_struct_exists(_p.bestiary, "e1") && _p.bestiary.e1.met == 3);
    Test_True("H5 migration: the old echo_pool field is still readable", is_array(_p.echo_pool) && array_length(_p.echo_pool) == 1 && _p.echo_pool[0].id == 11);
    // a v1 file that already carries a skills_known key is not trusted: the memory starts empty
    var _v1x = Profile_Normalize({ profile_version: 1, skills_known: { "2": true } });
    Test_Eq("H5 migration: a v1 profile ignores a stray skills_known", array_length(variable_struct_get_names(_v1x.skills_known)), 0);
    // saved again it is a v2 file, and reads back the same
    Test_True("H5 migration: the migrated profile can be written", Profile_SaveTo(_f, _p));
    Test_True("H5 migration: the file now says version 3 (saves1: name)", string_pos("\"profile_version\":3", Test_RawRead(_f)) > 0);
    var _r2 = Profile_Load(_f);
    Test_True("H5 migration: the written v2 reads back with the same counters", _r2.status == "ok" && _r2.profile.deaths == 4 && _r2.profile.wins == 1 && _r2.profile.runs_started == 6 && array_length(_r2.profile.history) == 1);
    // 2. v2 round trip
    var _w = Test_ClassMemSet([SKILL_WOUND, SKILL_FIREBALL, SKILL_REV_UP]);
    Profile_StoryMark(_w, "cutscene:intro");
    Test_True("H5 round trip: write", Profile_SaveTo(_f, _w));
    var _r3 = Profile_Load(_f);
    Test_Eq("H5 round trip: reads back ok", _r3.status, "ok");
    Test_True("H5 round trip: the three skills are known", Profile_SkillKnown(_r3.profile, SKILL_WOUND) && Profile_SkillKnown(_r3.profile, SKILL_FIREBALL) && Profile_SkillKnown(_r3.profile, SKILL_REV_UP));
    Test_False("H5 round trip: another skill is not known", Profile_SkillKnown(_r3.profile, SKILL_HILT_BASH));
    Test_Eq("H5 round trip: exactly three entries", array_length(variable_struct_get_names(_r3.profile.skills_known)), 3);
    Test_True("H5 round trip: the rest of the profile is intact", Profile_StorySeen(_r3.profile, "cutscene:intro"));
    // junk in the memory is dropped
    var _junk = Profile_Normalize({ profile_version: 2, skills_known: { "2": true, "x": true, "3": false, "-1": true, "4": "yes" } });
    Test_True("H5 normalize: only valid true entries are kept", Profile_SkillKnown(_junk, 2) && !Profile_SkillKnown(_junk, 3) && !Profile_SkillKnown(_junk, 4) && array_length(variable_struct_get_names(_junk.skills_known)) == 1);
    var _bad = Profile_Normalize({ profile_version: 2, skills_known: [1, 2] });
    Test_Eq("H5 normalize: a wrong-typed memory falls back to empty", array_length(variable_struct_get_names(_bad.skills_known)), 0);
    // a newer file is still refused
    Save_DeleteFileSet(_f);
    Test_RawWrite(_f, json_stringify({ profile_version: 4, deaths: 1 }));
    Test_Eq("H5 migration: version 4 is newer (saves1: was version 3)", Profile_Load(_f).status, "newer");
    Save_DeleteFileSet(_f);
}

function Test_ClassMemRecording() {
    Profile_ResetForTest();
    var _p = Profile_Get();
    Test_False("H5 record: nothing is known on a fresh profile", Profile_SkillKnown(_p, SKILL_FIREBALL));
    // card pick
    var _m = CharacterCreate_Player(CLASS_MAGE);
    var _r = Card_Take(_m, Card_SkillId(SKILL_FIREBALL));
    Test_True("H5 record: a card pick records the skill", Profile_SkillKnown(Profile_Get(), SKILL_FIREBALL));
    Test_True("H5 record: and the character has it", array_contains(_r.ch.skills, SKILL_FIREBALL));
    // recording twice is harmless
    Card_Take(_r.ch, Card_SkillId(SKILL_FIREBALL));
    Test_Eq("H5 record: taking it again adds no second entry", array_length(variable_struct_get_names(Profile_Get().skills_known)), 1);
    Test_True("H5 record: the helper says new once, then not new", Skill_Discover(SKILL_ICE_SPEAR) && !Skill_Discover(SKILL_ICE_SPEAR));
    // an upgrade of a skill is not a new skill
    Card_Take(CharacterCreate_Player(CLASS_KNIGHT), Card_UpgradeId(SKILL_WOUND));
    Test_False("H5 record: an upgrade card does not record its skill", Profile_SkillKnown(Profile_Get(), SKILL_WOUND));
    // a full skill list: the card is not learned yet; the swap records it
    var _full = CharacterCreate_Player(CLASS_MAGE);
    _full.skills = [SKILL_FIREBALL, SKILL_ICE_SPEAR, SKILL_FORESIGHT];
    var _rf = Card_Take(_full, Card_SkillId(SKILL_MEDITATION));
    Test_True("H5 record: a card that needs a swap asks first", _rf.needs_replace);
    Test_False("H5 record: and is not recorded before the swap", Profile_SkillKnown(Profile_Get(), SKILL_MEDITATION));
    Card_ReplaceSkill(_full, SKILL_ICE_SPEAR, SKILL_MEDITATION);
    Test_True("H5 record: the swap records the new skill", Profile_SkillKnown(Profile_Get(), SKILL_MEDITATION));
    // the echo take
    var _e = CharacterCreate_Player(CLASS_KNIGHT);
    _e.echo_offer = [{ kind: "skill", id: SKILL_HORIZ_SLASH }];
    var _et = Run_EchoTake(_e, 0);
    Test_True("H5 record: taking an echo skill records it", Profile_SkillKnown(Profile_Get(), SKILL_HORIZ_SLASH) && array_contains(_et.skills, SKILL_HORIZ_SLASH));
    // a skill learned directly (any other path through Player_LearnSkill)
    Player_LearnSkill(CharacterCreate_Player(CLASS_ARCHER), SKILL_TAKE_AIM);
    Test_True("H5 record: learning a skill directly records it", Profile_SkillKnown(Profile_Get(), SKILL_TAKE_AIM));
    // the character's whole list (class pick, run end)
    var _all = CharacterCreate_Player(CLASS_KNIGHT);
    _all.skills = [SKILL_MUSCLE_UP, SKILL_HILT_BASH];
    Skills_DiscoverAll(_all.skills);
    Test_True("H5 record: a whole skill list is recorded", Profile_SkillKnown(Profile_Get(), SKILL_MUSCLE_UP) && Profile_SkillKnown(Profile_Get(), SKILL_HILT_BASH));
    // not skills: nonsense and enemy skills
    Test_False("H5 record: -1 is never recorded", Skill_Discover(-1));
    Test_False("H5 record: an id that is no skill is never recorded", Skill_Discover(9999));
    Test_False("H5 record: an enemy skill is never recorded", Skill_Discover(SKILL_BITE));
    Test_False("H5 record: the enemy skill is not in the memory", Profile_SkillKnown(Profile_Get(), SKILL_BITE));
    // it is flushed: a reload from disk still has it
    var _disk = Profile_Load(Profile_Path());
    Test_True("H5 record: the memory was written to the profile file", _disk.status == "ok" && Profile_SkillKnown(_disk.profile, SKILL_FIREBALL) && Profile_SkillKnown(_disk.profile, SKILL_TAKE_AIM));
}

function Test_ClassMemClassLists() {
    Test_True("H5 class skills: Knight has Wound, Hilt Bash, Muscle Up, Rev Up, Horizontal Slash", Test_ClassMemSameSet(Skill_IdsOfClass(CLASS_KNIGHT), [SKILL_WOUND, SKILL_HILT_BASH, SKILL_MUSCLE_UP, SKILL_REV_UP, SKILL_HORIZ_SLASH]));
    Test_True("H5 class skills: Archer has Wound, Poison Arrow, Evasion, Double Shot, Take Aim", Test_ClassMemSameSet(Skill_IdsOfClass(CLASS_ARCHER), [SKILL_WOUND, SKILL_POISON_ARROW, SKILL_EVASION, SKILL_DOUBLE_SHOT, SKILL_TAKE_AIM]));
    Test_True("H5 class skills: Mage has Fireball, Poison Mist, Ice Spear, Meditation, Foresight", Test_ClassMemSameSet(Skill_IdsOfClass(CLASS_MAGE), [SKILL_FIREBALL, SKILL_POISON_MIST, SKILL_ICE_SPEAR, SKILL_MEDITATION, SKILL_FORESIGHT]));
    Test_Eq("H5 class skills: Nobody has none", array_length(Skill_IdsOfClass(CLASS_NOBODY)), 0);
    var _p = Test_ClassMemSet([SKILL_WOUND, SKILL_REV_UP, SKILL_FIREBALL]);
    Test_True("H5 known of class: a Knight knows Wound and Rev Up only", Test_ClassMemSameSet(Skill_KnownOfClass(_p, CLASS_KNIGHT), [SKILL_WOUND, SKILL_REV_UP]));
    Test_True("H5 known of class: an Archer knows Wound only (the skill is shared with the Knight)", Test_ClassMemSameSet(Skill_KnownOfClass(_p, CLASS_ARCHER), [SKILL_WOUND]));
    Test_True("H5 known of class: a Mage knows Fireball only", Test_ClassMemSameSet(Skill_KnownOfClass(_p, CLASS_MAGE), [SKILL_FIREBALL]));
    Test_Eq("H5 known of class: Nobody knows none", array_length(Skill_KnownOfClass(_p, CLASS_NOBODY)), 0);
}

function Test_ClassMemEcho() {
    // 0 discovered: no offer
    var _none = Profile_Default();
    Test_Eq("H5 echo: a class with 0 discovered skills offers nothing", array_length(Run_EchoSkillOptions(_none, CLASS_KNIGHT, 5)), 0);
    var _other = Test_ClassMemSet([SKILL_FIREBALL, SKILL_ICE_SPEAR]);
    Test_Eq("H5 echo: other classes' skills do not count (Knight)", array_length(Run_EchoSkillOptions(_other, CLASS_KNIGHT, 5)), 0);
    Test_Eq("H5 echo: Nobody is never offered anything", array_length(Run_EchoSkillOptions(Test_ClassMemSet([SKILL_WOUND, SKILL_FIREBALL]), CLASS_NOBODY, 5)), 0);
    // 2 discovered: exactly those two
    var _two = Test_ClassMemSet([SKILL_WOUND, SKILL_HILT_BASH, SKILL_FIREBALL]);
    var _o2 = Run_EchoSkillOptions(_two, CLASS_KNIGHT, 5);
    Test_True("H5 echo: 2 discovered Knight skills -> exactly those 2", Test_ClassMemSameSet(Test_ClassMemOfferIds(_o2), [SKILL_WOUND, SKILL_HILT_BASH]));
    // 5 discovered: exactly 3 distinct, of the class, same for the same seed
    var _five = Test_ClassMemSet([SKILL_WOUND, SKILL_HILT_BASH, SKILL_MUSCLE_UP, SKILL_REV_UP, SKILL_HORIZ_SLASH, SKILL_FIREBALL]);
    var _o5 = Run_EchoSkillOptions(_five, CLASS_KNIGHT, 777);
    var _ids5 = Test_ClassMemOfferIds(_o5);
    var _distinct = array_length(_ids5) == 3 && _ids5[0] != _ids5[1] && _ids5[0] != _ids5[2] && _ids5[1] != _ids5[2];
    Test_Eq("H5 echo: 5 discovered -> exactly 3 offered", array_length(_o5), 3);
    Test_True("H5 echo: the 3 are distinct", _distinct);
    var _allk = true; var _allskill = true;
    for (var _i = 0; _i < array_length(_o5); _i++) {
        if (!array_contains(Skill_IdsOfClass(CLASS_KNIGHT), _o5[_i].id)) _allk = false;
        if (_o5[_i].kind != "skill") _allskill = false;
    }
    Test_True("H5 echo: all 3 are Knight skills", _allk);
    Test_True("H5 echo: never an item", _allskill);
    var _o5b = Run_EchoSkillOptions(_five, CLASS_KNIGHT, 777);
    Test_True("H5 echo: the same seed gives the same 3 in the same order", json_stringify(_o5) == json_stringify(_o5b));
    var _seen = {};
    for (var _sd = 1; _sd <= 30; _sd++) variable_struct_set(_seen, json_stringify(Test_ClassMemOfferIds(Run_EchoSkillOptions(_five, CLASS_KNIGHT, _sd))), true);
    Test_True("H5 echo: other seeds can give other offers", array_length(variable_struct_get_names(_seen)) > 1);
    // a shared skill (Wound belongs to the Knight and the Archer) is offered to both its classes, never to the Mage
    var _wnd = Test_ClassMemSet([SKILL_WOUND]);
    Test_Eq("H5 echo: Wound is offered to a Knight", array_length(Run_EchoSkillOptions(_wnd, CLASS_KNIGHT, 1)), 1);
    Test_Eq("H5 echo: and to an Archer", array_length(Run_EchoSkillOptions(_wnd, CLASS_ARCHER, 1)), 1);
    Test_Eq("H5 echo: but not to a Mage", array_length(Run_EchoSkillOptions(_wnd, CLASS_MAGE, 1)), 0);
    // a skill the character already holds is not offered again
    var _own = Run_EchoSkillOptions(_two, CLASS_KNIGHT, 5, [SKILL_WOUND]);
    Test_True("H5 echo: a skill already held is left out", Test_ClassMemSameSet(Test_ClassMemOfferIds(_own), [SKILL_HILT_BASH]));

    // the class pick: Run_EchoGrant reads the profile
    Profile_ResetForTest();
    var _base = Card_ClassCharacter(CharacterCreate_Player(CLASS_NOBODY), CLASS_KNIGHT);
    var _g0 = Run_EchoGrant(_base);
    Test_Eq("H5 grant: nothing discovered -> no echo offer", array_length(_g0.echo_offer), 0);
    Test_True("H5 grant: and nothing is owed (the run goes on)", Cards_NextOwed(_g0) != "echo");
    Skill_Discover(SKILL_WOUND);
    Skill_Discover(SKILL_FIREBALL);
    var _g1 = Run_EchoGrant(Card_ClassCharacter(CharacterCreate_Player(CLASS_NOBODY), CLASS_KNIGHT));
    Test_True("H5 grant: a Knight is offered only the discovered Knight skill", Test_ClassMemSameSet(Test_ClassMemOfferIds(_g1.echo_offer), [SKILL_WOUND]));
    Test_Eq("H5 grant: and the echo screen is owed", Cards_NextOwed(_g1), "echo");
    var _g2 = Run_EchoGrant(Card_ClassCharacter(CharacterCreate_Player(CLASS_NOBODY), CLASS_MAGE));
    Test_True("H5 grant: a Mage is offered only the discovered Mage skill", Test_ClassMemSameSet(Test_ClassMemOfferIds(_g2.echo_offer), [SKILL_FIREBALL]));
    var _g3 = Run_EchoGrant(Card_ClassCharacter(CharacterCreate_Player(CLASS_NOBODY), CLASS_ARCHER));
    Test_True("H5 grant: an Archer is offered the shared Wound only", Test_ClassMemSameSet(Test_ClassMemOfferIds(_g3.echo_offer), [SKILL_WOUND]));
    // taking it puts it in the deck
    var _taken = Run_EchoTake(_g1, 0);
    Test_True("H5 grant: taking the echo puts the skill in the deck", array_contains(_taken.skills, SKILL_WOUND) && array_length(_taken.echo_offer) == 0);
    // an old item pool in the profile is read, ignored, and cleared by the class pick
    Profile_ResetForTest();
    var _pf = Profile_Get();
    _pf.echo_pool = [{ kind: "item", id: 11 }];
    var _g4 = Run_EchoGrant(Card_ClassCharacter(CharacterCreate_Player(CLASS_NOBODY), CLASS_ARCHER));
    Test_Eq("H5 legacy: an old item pool never becomes an offer", array_length(_g4.echo_offer), 0);
    Test_Eq("H5 legacy: and is cleared by the class pick", array_length(Profile_Get().echo_pool), 0);
    Profile_ResetForTest();
}

function Test_ClassMemMenu() {
    Loc_SetLanguage("en");
    var _fresh = Profile_Default();
    var _m = CardsUi_ClassMenu(_fresh);
    Test_Eq("H5 menu: four rows", array_length(_m.items), 4);
    Test_Eq("H5 menu: the unknown skill reads ???", Loc_T("class.skill.unknown", "x"), "???");
    for (var _c = 0; _c < 3; _c++) {
        var _it = _m.items[_c];
        Test_Eq("H5 menu: class " + string(_c) + " has five skill rows", array_length(_it.skills), 5);
        var _qs = 0;
        for (var _k = 0; _k < array_length(_it.skills); _k++) { if (_it.skills[_k].label == "???" && !_it.skills[_k].known) _qs++; }
        Test_Eq("H5 menu: a fresh profile shows all five skills as ??? (class " + string(_c) + ")", _qs, 5);
        var _lq = 0;
        for (var _l = 0; _l < array_length(_it.lines); _l++) { if (_it.lines[_l].label == "???") _lq++; }
        Test_Eq("H5 menu: and the details panel lines show them too (class " + string(_c) + ")", _lq, 5);
    }
    // discovered ones show by name
    var _known = Test_ClassMemSet([SKILL_WOUND, SKILL_HILT_BASH, SKILL_REV_UP]);   // Wound is shared by the Knight and the Archer
    var _m2 = CardsUi_ClassMenu(_known);
    var _kn = _m2.items[0];
    var _names = [];
    var _qs2 = 0;
    for (var _k2 = 0; _k2 < array_length(_kn.skills); _k2++) {
        if (_kn.skills[_k2].known) array_push(_names, _kn.skills[_k2].label); else if (_kn.skills[_k2].label == "???") _qs2++;
    }
    Test_True("H5 menu: the Knight shows Wound, Hilt Bash and Rev Up by name", array_length(_names) == 3 && array_contains(_names, SkillDB_GetBase(SKILL_WOUND).name) && array_contains(_names, SkillDB_GetBase(SKILL_HILT_BASH).name) && array_contains(_names, SkillDB_GetBase(SKILL_REV_UP).name));
    Test_Eq("H5 menu: and the other two stay ???", _qs2, 2);
    var _ar = _m2.items[1];
    var _arn = 0;
    for (var _k3 = 0; _k3 < array_length(_ar.skills); _k3++) { if (_ar.skills[_k3].known) _arn++; }
    Test_Eq("H5 menu: the Archer shows the shared Wound only", _arn, 1);
    var _ma = _m2.items[2];
    var _man = 0;
    for (var _k4 = 0; _k4 < array_length(_ma.skills); _k4++) { if (_ma.skills[_k4].known) _man++; }
    Test_Eq("H5 menu: the Mage shows none", _man, 0);
    // the lines carry the names too
    var _hasname = false;
    for (var _l2 = 0; _l2 < array_length(_kn.lines); _l2++) { if (_kn.lines[_l2].label == SkillDB_GetBase(SKILL_WOUND).name) _hasname = true; }
    Test_True("H5 menu: the details lines show the discovered name", _hasname);

    // Nobody: locked is greyed and cannot be picked
    var _nb = _m.items[3];
    Test_True("H5 menu: Nobody is locked on a fresh profile", _nb.locked);
    Test_True("H5 menu: and greyed (dim)", variable_struct_exists(_nb, "dim") && _nb.dim);
    Test_False("H5 menu: the other classes are not greyed", variable_struct_exists(_m.items[0], "dim") && _m.items[0].dim);
    Confirm_Close();
    CardsUi_ClassConfirm(_m, 3);
    Test_False("H5 menu: confirming the locked Nobody opens no pop-up", Confirm_IsOpen());
    Test_True("H5 menu: the locked row says it is locked", string_length(_nb.help) > 0 && _nb.help == Loc_T("class.nobody.locked_hint", "Win a run to unlock this path."));
    var _won = Profile_Default();
    Profile_Unlock(_won, "nobody_class");
    var _m3 = CardsUi_ClassMenu(_won);
    Test_False("H5 menu: Nobody is open after a win", _m3.items[3].locked);
    Test_False("H5 menu: and not greyed", variable_struct_exists(_m3.items[3], "dim") && _m3.items[3].dim);
    CardsUi_ClassConfirm(_m3, 3);
    Test_True("H5 menu: an open Nobody can be asked about", Confirm_IsOpen());
    Confirm_Close();

    // a preview sprite for every row
    for (var _r = 0; _r < 4; _r++) {
        var _row = _m.items[_r];
        var _hasspr = variable_struct_exists(_row, "pic") && is_struct(_row.pic) && sprite_exists(_row.pic.spr);
        Test_True("H5 menu: row " + string(_r) + " has a preview sprite that exists", _hasspr);
        Test_True("H5 menu: row " + string(_r) + " has a sprite with more than one frame to animate", _hasspr && sprite_get_number(_row.pic.spr) >= 2);
    }
    Test_True("H5 menu: the Knight preview is the Knight's own sprite", _m.items[0].pic.spr == DB_PlayerClass(CLASS_KNIGHT).sprites.down);
    Test_True("H5 menu: the Mage preview is the Mage's own sprite", _m.items[2].pic.spr == DB_PlayerClass(CLASS_MAGE).sprites.down);
}

function Test_ClassMemText() {
    var _bad = ["to find", chr(52286)];   // the Korean word for "find" is the second one
    var _langs = ["en", "ko"];
    var _won = Profile_Default();
    Profile_Unlock(_won, "nobody_class");
    for (var _g = 0; _g < 2; _g++) {
        Loc_SetLanguage(_langs[_g]);
        for (var _v = 0; _v < 2; _v++) {
            var _t = Test_ClassMemRowTexts(CardsUi_ClassMenu(_v == 0 ? Profile_Default() : _won));
            for (var _b = 0; _b < 2; _b++) Test_False("H5 text (" + _langs[_g] + "): the class screen has no find wording " + string(_b) + " (profile " + string(_v) + ")", string_pos(_bad[_b], _t) > 0);
        }
        var _lines = "";
        var _ids = [CLASS_KNIGHT, CLASS_ARCHER, CLASS_MAGE, CLASS_NOBODY];
        var _distinct = {};
        for (var _i = 0; _i < 4; _i++) {
            var _s = Card_ClassSentence(_ids[_i]);
            _lines += _s;
            Test_True("H5 text (" + _langs[_g] + "): class " + string(_i) + " has a description", string_length(_s) > 20);
            variable_struct_set(_distinct, _s, true);
        }
        Test_Eq("H5 text (" + _langs[_g] + "): the four descriptions differ", array_length(variable_struct_get_names(_distinct)), 4);
        for (var _b2 = 0; _b2 < 2; _b2++) Test_False("H5 text (" + _langs[_g] + "): no description has find wording " + string(_b2), string_pos(_bad[_b2], _lines) > 0);
        Test_Eq("H5 text (" + _langs[_g] + "): the unknown-skill mark", Loc_T("class.skill.unknown", "x"), "???");
    }
    Loc_SetLanguage("en");
}

function Test_Suite_ClassMem() {
    var _keep = variable_global_exists("profile") ? global.profile : undefined;
    var _keep_st = variable_global_exists("profile_status") ? global.profile_status : "missing";
    var _lang = Loc_GetLanguage();
    Test_ClassMemMigration();
    Test_ClassMemClassLists();
    Test_ClassMemRecording();
    Test_ClassMemEcho();
    Test_ClassMemMenu();
    Test_ClassMemText();
    Loc_SetLanguage(_lang);
    Profile_ResetForTest();
    global.profile = _keep;
    global.profile_status = _keep_st;
}

// ============================================================================================================
// H13a (D156): the elite outline follows the sprite's shape; the old death picture (GAME_OVER) is the backdrop of the death line.
// Expected values come from the brief: a 1 px outline round the opaque pixels (no rectangle), the pulse's two beats a second in the two light
// palette colours, the picture "GAME_OVER" in the four palette colours, inside the GUI and clear of the text block at 480 x 432 and 800 x 720.
// ============================================================================================================

// The alpha > 0 mask (24 x 24, the sprite drawn at 4,4) of a sprite frame: _mode "sprite" = the sprite itself, "outline" = what Elite_DrawOutline draws.
function Test_EliteMask(_spr, _img, _mode) {
    var _surf = surface_create(24, 24);
    surface_set_target(_surf);
    draw_clear_alpha(c_black, 0);
    if (_mode == "sprite") draw_sprite_ext(_spr, _img, 4, 4, 1, 1, 0, c_white, 1);
    else if (_mode == "rim") Elite_DrawRim(_spr, _img, 4, 4, 1, 1, 0, c_white, 1);
    else Elite_DrawOutline(_spr, _img, 4, 4, 1, 1, 0, c_white, 1);
    surface_reset_target();
    var _m = array_create(24 * 24, false);
    for (var _y = 0; _y < 24; _y++) {
        for (var _x = 0; _x < 24; _x++) _m[_y * 24 + _x] = (((surface_getpixel_ext(_surf, _x, _y) >> 24) & 255) > 0);
    }
    surface_free(_surf);
    return _m;
}

// How many pixels of the outline differ from "every pixel one step (8 ways) from an opaque pixel of the sprite".
// 0 = the outline is exactly the sprite's silhouette pushed 1 px in 8 directions: nothing farther than 1 px, no rectangle, no gap.
function Test_EliteOutlineDiff(_spr, _img) {
    var _sp = Test_EliteMask(_spr, _img, "sprite");
    var _ol = Test_EliteMask(_spr, _img, "outline");
    var _diff = 0;
    for (var _y = 0; _y < 24; _y++) {
        for (var _x = 0; _x < 24; _x++) {
            var _want = false;
            for (var _dy = -1; _dy <= 1; _dy++) {
                for (var _dx = -1; _dx <= 1; _dx++) {
                    if (_dx == 0 && _dy == 0) continue;
                    var _sx = _x - _dx;
                    var _sy = _y - _dy;
                    if (_sx >= 0 && _sy >= 0 && _sx < 24 && _sy < 24 && _sp[_sy * 24 + _sx]) _want = true;
                }
            }
            if (_want != _ol[_y * 24 + _x]) _diff++;
        }
    }
    return _diff;
}

// How many pixels differ between "light outline + dark rim" and "every pixel within 2 px (8 ways, 2 steps) of an opaque pixel of the sprite": 0 = the rim is a 1 px dark edge outside the outline.
function Test_EliteRimDiff(_spr, _img) {
    var _sp = Test_EliteMask(_spr, _img, "sprite");
    var _ol = Test_EliteMask(_spr, _img, "outline");
    var _rm = Test_EliteMask(_spr, _img, "rim");
    var _diff = 0;
    for (var _y = 0; _y < 24; _y++) {
        for (var _x = 0; _x < 24; _x++) {
            var _want = false;
            for (var _dy = -2; _dy <= 2; _dy++) {
                for (var _dx = -2; _dx <= 2; _dx++) {
                    if (_dx == 0 && _dy == 0) continue;
                    var _sx = _x - _dx;
                    var _sy = _y - _dy;
                    if (_sx >= 0 && _sy >= 0 && _sx < 24 && _sy < 24 && _sp[_sy * 24 + _sx]) _want = true;
                }
            }
            if (_want != (_ol[_y * 24 + _x] || _rm[_y * 24 + _x])) _diff++;
        }
    }
    return _diff;
}

function Test_Suite_EliteDeath() {
    // --- 1. the outline: 8 one-pixel steps, the same pulse
    var _off = Elite_OutlineOffsets();
    Test_Eq("H13 the outline is drawn at 8 offsets", array_length(_off), 8);
    var _seen = {};
    var _far = 0;
    var _zero = 0;
    for (var _i = 0; _i < array_length(_off); _i++) {
        if (max(abs(_off[_i][0]), abs(_off[_i][1])) > 1) _far++;
        if (_off[_i][0] == 0 && _off[_i][1] == 0) _zero++;
        variable_struct_set(_seen, string(_off[_i][0]) + "," + string(_off[_i][1]), true);
    }
    Test_Eq("H13 no outline offset is farther than 1 px", _far, 0);
    Test_Eq("H13 no outline offset is the sprite's own place", _zero, 0);
    Test_Eq("H13 the 8 outline offsets are all different", array_length(variable_struct_get_names(_seen)), 8);
    var _rim = Elite_RimOffsets();
    var _rim_ok = (array_length(_rim) == 16);
    for (var _i = 0; _i < array_length(_rim); _i++) { if (max(abs(_rim[_i][0]), abs(_rim[_i][1])) != 2) _rim_ok = false; }
    Test_True("H13 the dark rim is drawn at 16 offsets, all exactly 2 px out", _rim_ok);
    Test_Eq("H13 the pulse starts on the lightest colour", Elite_OutlineColor(0), UI_C_LIGHTEST);
    Test_Eq("H13 the first beat lasts 250 ms", Elite_OutlineColor(249), UI_C_LIGHTEST);
    Test_Eq("H13 the second beat is the light colour", Elite_OutlineColor(250), UI_C_LIGHT);
    Test_Eq("H13 the second beat ends at 500 ms", Elite_OutlineColor(499), UI_C_LIGHT);
    Test_Eq("H13 two beats a second: back to the lightest at 500 ms", Elite_OutlineColor(500), UI_C_LIGHTEST);
    Test_Eq("H13 the light colour again at 750 ms", Elite_OutlineColor(750), UI_C_LIGHT);

    // --- 2. what it draws: the sprite's silhouette one pixel out, for every frame of a short and a tall enemy
    var _names = ["slime_moving", "killer_plant_moving", "dire_wolf_moving"];
    for (var _n = 0; _n < array_length(_names); _n++) {
        var _spr = asset_get_index(_names[_n]);
        Test_True("H13 the sprite " + _names[_n] + " exists", _spr != -1);
        if (_spr == -1) continue;
        for (var _f = 0; _f < sprite_get_number(_spr); _f++) {
            Test_Eq("H13 outline of " + _names[_n] + " frame " + string(_f) + " is the silhouette 1 px out (pixels off)", Test_EliteOutlineDiff(_spr, _f), 0);
            Test_Eq("H13 the dark rim of " + _names[_n] + " frame " + string(_f) + " edges the outline 1 px further out (pixels off)", Test_EliteRimDiff(_spr, _f), 0);
            var _cs = 0;
            var _co = 0;
            var _ms = Test_EliteMask(_spr, _f, "sprite");
            var _mo = Test_EliteMask(_spr, _f, "outline");
            for (var _q = 0; _q < 24 * 24; _q++) { if (_ms[_q]) _cs++; if (_mo[_q]) _co++; }
            Test_True("H13 the masks are read from real drawn pixels: " + _names[_n] + " frame " + string(_f) + " has a sprite and a larger outline", _cs > 20 && _co > _cs / 4 && _co < 4 * _cs);
        }
    }

    // --- 3. the death picture is the old GAME_OVER sprite, in the four palette colours
    Test_Eq("H13 the death scene's picture is the sprite GAME_OVER", RunFlow_DeathImageName(), "GAME_OVER");
    var _go = asset_get_index("GAME_OVER");
    Test_True("H13 the sprite GAME_OVER exists", _go != -1 && asset_get_type("GAME_OVER") == asset_sprite);
    Test_Eq("H13 palette: the darkest colour stays", DeathImage_NearestColor(7, 24, 33), UI_C_DARKEST);
    Test_Eq("H13 palette: a dark green goes to the dark colour", DeathImage_NearestColor(60, 115, 85), UI_C_DARK);
    Test_Eq("H13 palette: a mid green goes to the light colour", DeathImage_NearestColor(120, 180, 100), UI_C_LIGHT);
    Test_Eq("H13 palette: a pale green goes to the lightest colour", DeathImage_NearestColor(210, 245, 195), UI_C_LIGHTEST);
    var _pic = RunFlow_DeathImage();
    Test_True("H13 the death picture is made", sprite_exists(_pic));
    if (sprite_exists(_pic) && _go != -1) {
        Test_Eq("H13 the death picture is as wide as GAME_OVER", sprite_get_width(_pic), sprite_get_width(_go));
        Test_Eq("H13 the death picture is as high as GAME_OVER", sprite_get_height(_pic), sprite_get_height(_go));
        var _w = sprite_get_width(_pic);
        var _h = sprite_get_height(_pic);
        var _surf = surface_create(_w, _h);
        surface_set_target(_surf);
        draw_clear_alpha(c_black, 0);
        draw_sprite(_pic, 0, 0, 0);
        surface_reset_target();
        var _bad = 0;
        for (var _y = 0; _y < _h; _y++) {
            for (var _x = 0; _x < _w; _x++) {
                var _c = surface_getpixel(_surf, _x, _y);
                if (_c != UI_C_DARKEST && _c != UI_C_DARK && _c != UI_C_LIGHT && _c != UI_C_LIGHTEST) _bad++;
            }
        }
        surface_free(_surf);
        Test_Eq("H13 every pixel of the death picture is one of the four palette colours (others)", _bad, 0);
    }

    // --- 4. the layout: the picture inside the GUI and clear of the text block, at 480 x 432 and 800 x 720
    var _lang0 = Loc_GetLanguage();
    var _disp0 = variable_global_exists("display") ? global.display : undefined;
    var _f0 = draw_get_font();
    Loc_SetLanguage("en");
    var _lines = ["A slime. You were beaten by a slime.", "The tunnel took you again. It did not hurry, and it did not look away, and the slime that did it was in no way special or kind."];
    var _sizes = [[480, 432], [800, 720]];
    for (var _z = 0; _z < array_length(_sizes); _z++) {
        var _sw = _sizes[_z][0];
        var _sh = _sizes[_z][1];
        global.display = { layout: Display_CalcLayout(_sw, _sh), apply_count: 0 };
        var _mt = Ui_Metrics();
        for (var _t = 0; _t < array_length(_lines); _t++) {
            var _tag = "H13 " + string(_sw) + "x" + string(_sh) + " line " + string(_t) + ": ";
            var _L = RunFlow_DeathLayoutNow(_lines[_t]);
            Test_True(_tag + "the picture is shown", _L.show);
            Test_True(_tag + "the picture is inside the GUI", _L.img_x >= 0 && _L.img_y >= 0 && _L.img_x + _L.img_w <= _mt.gw && _L.img_y + _L.img_h <= _mt.gh);
            Test_True(_tag + "the text block is inside the GUI", _L.text_x >= 0 && _L.text_y >= 0 && _L.text_x + _L.text_w <= _mt.gw && _L.text_y + _L.text_h <= _mt.gh);
            Test_True(_tag + "the picture does not touch the text block", _L.img_y + _L.img_h <= _L.text_y || _L.text_y + _L.text_h <= _L.img_y);
            Test_True(_tag + "the picture is centred across", abs((_L.img_x + _L.img_w / 2) - _mt.gw / 2) <= 1);
            Test_True(_tag + "the picture keeps its 160 : 144 shape", abs(_L.img_w * 144 - _L.img_h * 160) <= 160);
            Test_Eq(_tag + "the text block is as tall as the line needs", _L.text_h, Ui_TextBlockH(_lines[_t], _L.text_w));
            Test_True(_tag + "the picture leaves room: at most 70% of the height", _L.img_h <= floor(_mt.gh * 0.7));
        }
    }
    global.display = _disp0;
    Loc_SetLanguage(_lang0);
    draw_set_font(_f0);
}

// ---- H8a (D150, D156): status labels, the XP bar, the "Equipped" header, the Help stats page, the refusals ----
// A field of a struct that the older builders may not have, or the default.
function Test_FieldOr(_s, _k, _d) {
    return (is_struct(_s) && variable_struct_exists(_s, _k)) ? variable_struct_get(_s, _k) : _d;
}

function Test_Suite_Labels() {
    Loc_SetLanguage("en");

    // ---- D150: the short name of every status (the brief's examples: PSN, BLD, Thirst); at most 6 characters in English ----
    var _names = [[STATUS_POISON, "PSN"], [STATUS_BLEED, "BLD"], [STATUS_BURN, "BRN"], [STATUS_STUN, "STN"], [STATUS_GUARD, "GRD"], [STATUS_DMG_UP, "REV"],
                  [STATUS_EVASION, "EVA"], [STATUS_CRIT_UP, "AIM"], [STATUS_HIT_UP, "FORE"], [STATUS_MEDITATION, "MED"], [STATUS_SOLIDIFY, "Solid"],
                  [STATUS_BLOODTHIRSTY, "Thirst"], [STATUS_BLESSING, "Bless"], [STATUS_SUNDER, "Sunder"], [STATUS_BRACE, "Brace"]];
    var _ids = Status_AllIds();
    Test_Eq("D150 there are 15 statuses to label", array_length(_ids), 15);
    var _seen = {};
    var _all_short = true;
    for (var _i = 0; _i < array_length(_names); _i++) {
        var _sn = Status_ShortName(_names[_i][0]);
        Test_Eq("D150 short name of status " + string(_names[_i][0]), _sn, _names[_i][1]);
        if (string_length(_sn) < 1 || string_length(_sn) > 6) _all_short = false;
        variable_struct_set(_seen, (_sn == "") ? ("none" + string(_i)) : string_lower(_sn), true);
    }
    Test_True("D150 every English short name is 1 to 6 characters", _all_short);
    Test_Eq("D150 no two statuses share a short name", array_length(variable_struct_get_names(_seen)), 15);

    // ---- the label = short name + the count the player needs: a poison's or a bleed's stacks, otherwise the turns left ----
    var _ch = CharacterCreate_Player(CLASS_MAGE);
    _ch = Status_Add(_ch, STATUS_POISON, 0, 0, 3);
    _ch = Status_Add(_ch, STATUS_BLEED, 3, 0, 2);
    _ch = Status_Add(_ch, STATUS_BURN, 2, 3);
    _ch = Status_Add(_ch, STATUS_BRACE, 2, 0);
    _ch = Status_Add(_ch, STATUS_BLOODTHIRSTY, 4, 0);
    Test_Eq("D150 poison with 3 stacks reads PSN 3", Status_ShortLabel(STATUS_POISON, Status_Find(_ch, STATUS_POISON)), "PSN 3");
    Test_Eq("D150 bleeding with 2 stacks reads BLD 2", Status_ShortLabel(STATUS_BLEED, Status_Find(_ch, STATUS_BLEED)), "BLD 2");
    Test_Eq("D150 burning with 2 turns left reads BRN 2", Status_ShortLabel(STATUS_BURN, Status_Find(_ch, STATUS_BURN)), "BRN 2");
    Test_Eq("D150 braced with 2 turns left reads Brace 2", Status_ShortLabel(STATUS_BRACE, Status_Find(_ch, STATUS_BRACE)), "Brace 2");
    Test_Eq("D150 bloodthirsty reads Thirst 4", Status_ShortLabel(STATUS_BLOODTHIRSTY, Status_Find(_ch, STATUS_BLOODTHIRSTY)), "Thirst 4");
    Test_Eq("D150 the count of a poison is its stacks", Status_LabelCount(STATUS_POISON, Status_Find(_ch, STATUS_POISON)), "3");
    Test_Eq("D150 the count of a burn is its turns", Status_LabelCount(STATUS_BURN, Status_Find(_ch, STATUS_BURN)), "2");
    Test_Eq("D150 a status with no data reads its name alone", Status_ShortLabel(STATUS_CRIT_UP), "AIM");
    Test_Eq("D150 a status with 0 turns reads its name alone", Status_ShortLabel(STATUS_GUARD, { id: STATUS_GUARD, turns: 0, power: 0, stacks: 1 }), "GRD");
    Test_Eq("D150 one poison stack reads PSN 1", Status_ShortLabel(STATUS_POISON, { id: STATUS_POISON, turns: 1, power: 0, stacks: 1 }), "PSN 1");

    // ---- the chips carry the label and the full sentence ----
    var _chips = Battle_StatusChips(_ch);
    Test_Eq("D150 five statuses make five chips", array_length(_chips), 5);
    Test_Eq("D150 the poison chip's label", Test_FieldOr(_chips[0], "label", "?"), "PSN 3");
    Test_Eq("D150 the bleed chip's label", Test_FieldOr(_chips[1], "label", "?"), "BLD 2");
    Test_Eq("D150 the burn chip's label", Test_FieldOr(_chips[2], "label", "?"), "BRN 2");
    Test_Eq("D150 the chip's full sentence is the highlighted sentence", Test_FieldOr(_chips[3], "full", "?"), Status_FullLine(STATUS_BRACE, Status_Find(_ch, STATUS_BRACE)));
    var _en = EnemyCreate(ENEMY_SLIME);
    _en = Status_Add(_en, STATUS_BURN, 2, 3);
    Test_Eq("D150 an enemy's chips are labelled the same way", Test_FieldOr(Battle_StatusChips(_en)[0], "label", "?"), "BRN 2");

    // ---- the highlighted sentence: what it does, then the turns left (statuses whose own sentence already counts the turns add nothing) ----
    for (var _j = 0; _j < array_length(_ids); _j++) {
        var _fl = Status_FullLine(_ids[_j]);
        Test_True("D150 status " + string(_ids[_j]) + " has a sentence", string_length(_fl) > 8 && string_pos("{", _fl) == 0 && string_pos("}", _fl) == 0);
    }
    var _gd = { id: STATUS_GUARD, turns: 4, power: 0, stacks: 1 };
    Test_Eq("D150 a buff's sentence ends with its turns left", Status_FullLine(STATUS_GUARD, _gd), Status_Describe(STATUS_GUARD, _gd).line + " 4 turns left.");
    var _gd1 = { id: STATUS_GUARD, turns: 1, power: 0, stacks: 1 };
    Test_Eq("D150 one turn left is singular", Status_FullLine(STATUS_GUARD, _gd1), Status_Describe(STATUS_GUARD, _gd1).line + " 1 turn left.");
    var _pe = Status_Find(_ch, STATUS_POISON);
    Test_Eq("D150 a poison's sentence already says its stacks: nothing added", Status_FullLine(STATUS_POISON, _pe), Status_Describe(STATUS_POISON, _pe).line);
    var _be = Status_Find(_ch, STATUS_BURN);
    Test_Eq("D150 a burn's sentence already says its turns: nothing added", Status_FullLine(STATUS_BURN, _be), Status_Describe(STATUS_BURN, _be).line);
    Test_Eq("D150 with no data the sentence is the general one", Status_FullLine(STATUS_GUARD), Status_Describe(STATUS_GUARD).line);

    // ---- the Status tab shows the full sentence when a status row is highlighted ----
    var _kn = CharacterCreate_Player(CLASS_KNIGHT);
    _kn = Status_Add(_kn, STATUS_GUARD, 4, 0);
    var _rows = TabStatus_Items(_kn);
    var _row = undefined;
    for (var _r = 0; _r < array_length(_rows); _r++) if (_rows[_r].id == "status_" + string(STATUS_GUARD)) _row = _rows[_r];
    Test_True("D150 the Status tab has a row for the status", is_struct(_row));
    Test_Eq("D150 the highlighted row says what it does and the turns left", Test_FieldOr(_row, "help", ""), Status_FullLine(STATUS_GUARD, Status_Find(_kn, STATUS_GUARD)));
    Test_True("D150 and the turns left are in it", string_pos("4 turns left", Test_FieldOr(_row, "help", "")) > 0);

    // ---- Korean: every short name exists, differs from the English, and is short enough to sit under the chip ----
    Loc_SetLanguage("ko");
    var _ko_ok = true;
    var _ko_diff = true;
    var _ko_names = "";
    for (var _k = 0; _k < array_length(_ids); _k++) {
        var _kn2 = Status_ShortName(_ids[_k]);
        _ko_names += _kn2 + ",";
        if (string_length(_kn2) < 1 || string_length(_kn2) > 3) _ko_ok = false;
        if (_kn2 == _names[_k][1]) _ko_diff = false;
    }
    Test_True("D150 Korean short names are 1 to 3 characters: " + _ko_names, _ko_ok);
    Test_True("D150 Korean short names are Korean words", _ko_diff);
    Test_Eq("D150 a Korean poison label is the Korean word and the count", Status_ShortLabel(STATUS_POISON, Status_Find(_ch, STATUS_POISON)), Status_ShortName(STATUS_POISON) + " 3");
    Loc_SetLanguage("en");

    // ---- the label's size: 3 x 5 glyphs, 4 cells per character with the space; the chip row makes room ----
    Test_Eq("D150 PSN 3 is 19 cells wide at 2 px", Battle_ChipLabelW("PSN", "3", 2), 38);
    Test_Eq("D150 a name alone is its letters", Battle_ChipLabelW("PSN", "", 2), 22);
    Test_Eq("D150 Thirst 4 at 3 px", Battle_ChipLabelW("Thirst", "4", 3), 93);
    Test_Eq("D150 the label row is 5 glyph rows high in English", Battle_ChipLabelH(), 5 * Battle_IconK());
    var _cm = Battle_ChipMetrics(3, 32, 2, 176, [38, 38, 38]);
    Test_Eq("D150 three wide cells all show", _cm.shown, 3);
    Test_Eq("D150 their row is 3 x 38 + 2 gaps", _cm.w, 118);
    var _cm2 = Battle_ChipMetrics(6, 32, 2, 176, [38, 38, 38, 38, 38, 38]);
    Test_Eq("D150 six wide cells: three show", _cm2.shown, 3);
    Test_Eq("D150 and the rest become a plus chip", _cm2.more, 3);
    Test_Eq("D150 the row with the plus chip", _cm2.w, 156);
    var _cm3 = Battle_ChipMetrics(2, 32, 2, 176, [20, 20]);
    Test_Eq("D150 narrow labels do not shrink the chip's cell", _cm3.w, 2 * 36 + 2);
    var _cm4 = Battle_ChipMetrics(4, 32, 2, 100);
    Test_True("D150 the old call (no label widths) still works", _cm4.shown >= 1 && _cm4.c == 36);

    // ---- the player panel is taller by the label row at 480 x 432; the other sizes already had room (the band is the command menu) ----
    var _sizes = [[480, 432, 2, 16, 2, 120], [640, 576, 3, 24, 2, 174], [800, 720, 4, 32, 3, 232], [960, 864, 6, 48, 4, 348]];   // gui w, h, p, line, k, expected band height with the labels
    for (var _z = 0; _z < array_length(_sizes); _z++) {
        var _g = _sizes[_z];
        var _tlb = 3 * _g[2] + (16 * _g[4] + 6 * _g[2]) + 2 * _g[2] + (_g[3] + _g[2]);
        var _zn = BattleHud_Zones(_g[0], _g[1], _g[2], _g[3], _tlb, 16 * _g[4], 5 * _g[4]);
        var _tag = "D150 zones " + string(_g[0]) + "x" + string(_g[1]);
        Test_Eq(_tag + ": the band holds the panel with its label row", _zn.band_h, _g[5]);
        Test_True(_tag + ": the panel is on screen", _zn.player.y >= _tlb && _zn.player.y + _zn.player.h <= _g[1] - _zn.m);
        Test_True(_tag + ": the log still sits above it", _zn.msg.y + _zn.msg.h <= _zn.player.y && _zn.msg.y >= _tlb);
        var _need = 8 * _g[2] + 3 * _g[3] + 6 * _g[2] + 16 * _g[4] + 5 * _g[4] + _g[2];
        Test_True(_tag + ": the panel is at least as tall as its rows, chips and labels", _zn.player.h >= _need);
    }
    var _z0 = BattleHud_Zones(480, 432, 2, 16, 60, 32);
    Test_Eq("D150 without a label height the zones are as before", _z0.band_h, 116);

    // ---- D156: the XP bar is not the HP bar nor the MP bar ----
    var _hp = Ui_BarStyle("hp");
    var _mp = Ui_BarStyle("mp");
    var _xp = Ui_BarStyle("xp");
    Test_Eq("D156 the HP bar is solid", _hp.pattern, "solid");
    Test_Eq("D156 the MP bar is striped", _mp.pattern, "stripe");
    Test_Eq("D156 the XP bar is in segments", _xp.pattern, "segments");
    Test_Eq("D156 the XP bar uses the brightest palette green", _xp.fill, UI_C_LIGHTEST);
    Test_Eq("D156 the HP bar uses the mid green", _hp.fill, UI_C_LIGHT);
    Test_True("D156 the XP style differs from both others", _xp.pattern != _hp.pattern && _xp.pattern != _mp.pattern && _xp.fill != _hp.fill && _xp.fill != _mp.fill);
    Test_True("D156 the XP bar is thinner than the HP and MP bars", Ui_BarHeight("xp", 16, 2) < Ui_BarHeight("hp", 16, 2) && Ui_BarHeight("xp", 16, 2) == Ui_BarHeight("mp", 16, 2) div 2);
    Test_True("D156 the XP bar is still thick enough to read (2 pixels)", Ui_BarHeight("xp", 16, 2) >= 2 * 2);
    Test_True("D156 the XP bar is a whole number of pixels at every size", Ui_BarHeight("xp", 48, 6) mod 6 == 0 && Ui_BarHeight("xp", 32, 4) mod 4 == 0);
    Test_Eq("D156 (G11: EXP, one word) the experience bar is labelled EXP", Loc_T("tab.lbl.xp", "?"), "EXP");

    // ---- D156: the Gear header says Equipped, as a section header like Bag; no "Worn" is left in English ----
    var _gear = TabGear_Items(CharacterCreate_Player(CLASS_KNIGHT));
    Test_Eq("D156 the first Gear header is Equipped", _gear[0].label, "Equipped");
    Test_Eq("D156 it is a section header", _gear[0].kind, "head");
    Test_Eq("D156 its text key now holds Equipped", Loc_GetRaw("tab.gear.worn", "en"), "Equipped");
    var _bag_kn = CharacterCreate_Player(CLASS_KNIGHT);
    _bag_kn.inventory = Inv_Add(_bag_kn.inventory, 2, 1);
    var _gear2 = TabGear_Items(_bag_kn);
    var _bag_head = undefined;
    for (var _gi = 0; _gi < array_length(_gear2); _gi++) if (_gear2[_gi].id == "head_bag") _bag_head = _gear2[_gi];
    Test_True("D156 Bag and Equipped are the same kind of header", is_struct(_bag_head) && _bag_head.kind == _gear2[0].kind && _bag_head.enabled == _gear2[0].enabled && _bag_head.value == _gear2[0].value);
    var _worn_keys = ["tab.gear.worn", "shop.worn", "tab.gear.empty", "tab.gear.empty_help"];
    var _no_worn = true;
    var _bad_key = "";
    for (var _wk = 0; _wk < array_length(_worn_keys); _wk++) {
        if (string_pos("worn", string_lower(Loc_GetRaw(_worn_keys[_wk], "en"))) > 0) { _no_worn = false; _bad_key += _worn_keys[_wk] + " "; }
    }
    Test_True("D156 no English Gear or shop text says worn: " + _bad_key, _no_worn);

    // ---- D156: the Help page "Stats & terms" ----
    var _hi = TabHelp_Items();
    Test_Eq("D156 the Help list has the 12 hints (R3 ideas2 added the trapped chest) and the stats page", array_length(_hi), 13);
    Test_Eq("D156 the stats page is the last row", _hi[array_length(_hi) - 1].id, "stats_terms");
    Test_Eq("D156 its title", _hi[array_length(_hi) - 1].label, "Stats & Terms");
    Test_Eq("D156 the hints keep their places", _hi[0].id, "timeline");
    var _terms = Help_StatsItems();
    var _tid = {};
    for (var _t = 0; _t < array_length(_terms); _t++) variable_struct_set(_tid, _terms[_t].id, _terms[_t]);
    var _must = ["power", "atk", "def", "mag", "spd", "hp", "mp", "crit", "perfect", "good", "ok", "break", "elite"];
    for (var _m = 0; _m < array_length(_must); _m++) {
        var _have = variable_struct_exists(_tid, _must[_m]);
        Test_True("D156 the stats page lists " + _must[_m], _have);
        if (_have) {
            var _tr = variable_struct_get(_tid, _must[_m]);
            Test_True("D156 " + _must[_m] + " has a short line", string_length(_tr.help) >= 12 && string_length(_tr.help) <= 120 && string_pos("{", _tr.help) == 0);
        }
    }
    for (var _si = 0; _si < array_length(_ids); _si++) {
        var _sk = "status_" + string(_ids[_si]);
        var _sh = variable_struct_exists(_tid, _sk);
        Test_True("D156 the stats page lists status " + string(_ids[_si]), _sh);
        if (_sh) {
            var _sr = variable_struct_get(_tid, _sk);
            Test_Eq("D156 status " + string(_ids[_si]) + " is explained by the game's own sentence", _sr.help, Status_Describe(_ids[_si]).line);
            Test_Eq("D156 and listed under its name", _sr.label, StatusDB_Get(_ids[_si]).name);
        }
    }
    Test_Eq("D156 the stats page rows start with Power", array_length(_terms) > 0 ? _terms[0].label : "", "Power");
    var _lbl = {};
    for (var _l = 0; _l < array_length(_terms); _l++) variable_struct_set(_lbl, _terms[_l].label, true);
    Test_Eq("D156 no term is listed twice", array_length(variable_struct_get_names(_lbl)), array_length(_terms));
    var _grades = (variable_struct_exists(_tid, "perfect") ? _tid.perfect.help : "") + "|" + (variable_struct_exists(_tid, "good") ? _tid.good.help : "") + "|" + (variable_struct_exists(_tid, "ok") ? _tid.ok.help : "");
    Test_True("D156 the grades give the damage numbers (+30%, +10%)", string_pos("30%", _grades) > 0 && string_pos("10%", _grades) > 0);
    Test_True("D156 BREAK says +50% damage", variable_struct_exists(_tid, "break") && string_pos("50%", variable_struct_get(_tid, "break").help) > 0);
    Test_True("D156 Crit says the damage is doubled", variable_struct_exists(_tid, "crit") && string_pos("2", _tid.crit.help) > 0);

    // ---- D156: refusals. A potion at full HP / MP, a cure with nothing to cure, an item that would do nothing: refused, not used up ----
    var _m1 = CharacterCreate_Player(CLASS_MAGE);
    _m1.inventory = [];
    _m1.inventory = Inv_Add(_m1.inventory, 10, 2);
    _m1.inventory = Inv_Add(_m1.inventory, 11, 2);
    _m1.inventory = Inv_Add(_m1.inventory, 12, 1);
    _m1.inventory = Inv_Add(_m1.inventory, 13, 1);
    _m1.hp = _m1.max_hp;
    _m1.mp = _m1.max_mp;
    var _r1 = TabItems_Use(_m1, 10);
    Test_False("D156 an HP potion at full HP is refused", _r1.ok);
    Test_Eq("D156 with the HP-is-full line", _r1.msg, "HP is already full.");
    Test_Eq("D156 the HP potion is not used up", Inv_Count(_r1.ch.inventory, 10), 2);
    Test_Eq("D156 HP is as it was", _r1.ch.hp, _r1.ch.max_hp);
    var _r2 = TabItems_Use(_m1, 11);
    Test_False("D156 an MP potion at full MP is refused", _r2.ok);
    Test_Eq("D156 with the MP-is-full line", _r2.msg, "MP is already full.");
    Test_Eq("D156 the MP potion is not used up", Inv_Count(_r2.ch.inventory, 11), 2);
    var _r3 = TabItems_Use(_m1, 12);
    Test_False("D156 an antidote with no poison is refused", _r3.ok);
    Test_Eq("D156 with the nothing-to-cure line", _r3.msg, "No status to cure.");
    Test_Eq("D156 the antidote is not used up", Inv_Count(_r3.ch.inventory, 12), 1);
    _m1 = Status_Add(_m1, STATUS_BLEED, 3, 0, 1);
    var _r4 = TabItems_Use(_m1, 12);
    Test_False("D156 an antidote against a bleed only is refused (wrong status)", _r4.ok);
    Test_Eq("D156 the antidote is still there", Inv_Count(_r4.ch.inventory, 12), 1);
    Test_True("D156 and the bleed is still there", Status_Has(_r4.ch, STATUS_BLEED));
    var _r5 = TabItems_Use(_m1, 13);
    Test_True("D156 a bandage against the bleed works", _r5.ok);
    Test_Eq("D156 the bandage is used up", Inv_Count(_r5.ch.inventory, 13), 0);
    Test_False("D156 the bleed is gone", Status_Has(_r5.ch, STATUS_BLEED));
    _m1.hp = _m1.max_hp - 5;
    var _hp_before = _m1.hp;
    var _r6 = TabItems_Use(_m1, 10);
    Test_True("D156 the same HP potion at less than full HP works", _r6.ok);
    Test_Eq("D156 and is used up", Inv_Count(_r6.ch.inventory, 10), 1);
    Test_True("D156 and HP went up (never past the maximum)", _r6.ch.hp > _hp_before && _r6.ch.hp <= _r6.ch.max_hp);
    _m1.mp = max(0, _m1.max_mp - 3);
    var _r7 = TabItems_Use(_m1, 11);
    Test_True("D156 the MP potion at less than full MP works", _r7.ok);
    Test_Eq("D156 and is used up", Inv_Count(_r7.ch.inventory, 11), 1);
    _m1 = Status_Add(_m1, STATUS_POISON, 0, 0, 2);
    var _r8 = TabItems_Use(_m1, 12);
    Test_True("D156 the antidote against a poison works", _r8.ok);
    Test_Eq("D156 and is used up", Inv_Count(_r8.ch.inventory, 12), 0);

    // an item whose whole effect would do nothing (a made-up consumable with no effect)
    var _fake = variable_clone(ItemDB_Get(10));
    _fake.id = 998;
    _fake.use = { effect: "none", power: 0, status: -1, target: TGT_SELF, fx_sprite: noone, fx_frames: 12, fx_speed: 0.2, skill_id: -1 };
    ds_map_add(global.item_db, 998, _fake);
    var _m2 = CharacterCreate_Player(CLASS_MAGE);
    _m2.inventory = [];
    _m2.inventory = Inv_Add(_m2.inventory, 998, 1);
    _m2.hp = max(1, _m2.max_hp - 4);
    var _r9 = TabItems_Use(_m2, 998);
    Test_False("D156 a consumable that would do nothing is refused", _r9.ok);
    Test_Eq("D156 with the nothing-happens line", _r9.msg, "Nothing happens.");
    Test_Eq("D156 and is not used up", Inv_Count(_r9.ch.inventory, 998), 1);
    ds_map_delete(global.item_db, 998);

    // ---- D156: the bed ----
    var _bk = Bed_Key("rm_floor3", 48, 64);
    var _b1 = CharacterCreate_Player(CLASS_MAGE);
    _b1.hp = _b1.max_hp;
    _b1.mp = _b1.max_mp;
    Test_False("D156 a rested character cannot rest", Bed_CanRest(_b1));
    var _bf = {};
    var _bc1 = Bed_Choose(_b1, _bf, _bk, "heal", -1);
    Test_False("D156 resting at full HP and MP is refused", _bc1.ok);
    Test_Eq("D156 with the already-rested line", _bc1.msg, "You are already rested.");
    Test_False("D156 the bed is not used up", Bed_Used(_bf, _bk));
    Test_True("D156 the bed can be used later", Bed_CanUse(_bf, _bk));
    Test_True("D156 HP and MP are as they were", _bc1.ch.hp == _b1.max_hp && _bc1.ch.mp == _b1.max_mp);
    var _b2 = CharacterCreate_Player(CLASS_MAGE);
    _b2.hp = _b2.max_hp - 3;
    _b2.mp = _b2.max_mp;
    Test_True("D156 missing HP: it can rest", Bed_CanRest(_b2));
    var _bc2 = Bed_Choose(_b2, _bf, _bk, "heal", -1);
    Test_True("D156 resting with missing HP works", _bc2.ok && _bc2.ch.hp == _bc2.ch.max_hp);
    Test_True("D156 and uses the bed up", Bed_Used(_bf, _bk));
    var _b3 = CharacterCreate_Player(CLASS_MAGE);
    _b3.hp = _b3.max_hp;
    _b3.mp = max(0, _b3.max_mp - 2);
    var _bf3 = {};
    Test_True("D156 full HP but missing MP: resting still helps", Bed_CanRest(_b3) && Bed_Choose(_b3, _bf3, _bk, "heal", -1).ok);
    var _bf4 = {};
    var _bc4 = Bed_Choose(_b1, _bf4, _bk, "upgrade", SKILL_WOUND);
    Test_False("D156 upgrading a skill he does not have is refused", _bc4.ok);
    Test_False("D156 and the bed stays free", Bed_Used(_bf4, _bk));
    Test_True("D156 with a line that says so", string_length(_bc4.msg) > 5);
    var _bmenu = Bed_MenuItems(_b1);
    Test_True("D156 the Rest row looks unavailable when rested", Test_FieldOr(_bmenu[0], "dim", false));
    Test_False("D156 the Rest row is not dim when HP is missing", Test_FieldOr(Bed_MenuItems(_b2)[0], "dim", false));
}

// ============================================================================================================================
// H8b (D149, D156): one text markup for terms, accents and button prompts, and device-aware prompts. Expected values come from the packet
// brief: [t]..[/t] is a game term in the palette's bright green, [a]..[/a] the one accent #E8C547, [k:action] a button glyph by device;
// the keyboard shows key names (arrows for the move keys), the pad Xbox-style glyphs; battle lists carry one prompt label.
// ============================================================================================================================
function Test_RT_Spans(_text, _style) {
    var _out = [];
    var _seg = Markup_Segments(_text, "keyboard");
    for (var _i = 0; _i < array_length(_seg); _i++) if (_seg[_i].kind == "text" && _seg[_i].st == _style) array_push(_out, _seg[_i].s);
    return _out;
}

function Test_RT_Count(_text, _kind) {
    var _n = 0;
    var _seg = Markup_Segments(_text, "keyboard");
    for (var _i = 0; _i < array_length(_seg); _i++) if (_seg[_i].kind == _kind) _n++;
    return _n;
}

function Test_Suite_RichText() {
    if (!script_exists(asset_get_index("Markup_Segments"))) {
        Test_True("RT the markup parser exists (Markup_Segments): not implemented", false);
        return;
    }
    Ui_Metrics();   // sets the UI font, so the widths below are real
    Binds_Apply(Binds_Defaults());
    var _dev0 = global.input.last_device;

    // ---- 1. the parser ----
    var _seg = Markup_Segments("[t]Poison[/t] hurts", "keyboard");
    Test_Eq("RT '[t]Poison[/t] hurts' makes two segments", array_length(_seg), 2);
    Test_True("RT the first segment is the term 'Poison'", array_length(_seg) == 2 && _seg[0].kind == "text" && _seg[0].s == "Poison" && _seg[0].st == "term");
    Test_True("RT the second segment is plain ' hurts'", array_length(_seg) == 2 && _seg[1].kind == "text" && _seg[1].s == " hurts" && _seg[1].st == "");
    Test_Eq("RT a term is drawn in the palette's bright green", Markup_Colour("term", UI_C_TEXT), make_color_rgb($86, $C0, $6C));
    Test_Eq("RT plain text keeps the colour it was given", Markup_Colour("", UI_C_LIGHT), UI_C_LIGHT);
    Test_Eq("RT the stripped text has no markup", Markup_Strip("[t]Poison[/t] hurts", "keyboard"), "Poison hurts");
    Test_Eq("RT '[a]BREAK[/a]' is one accent segment", array_length(Test_RT_Spans("Hit [a]BREAK[/a] now", "accent")), 1);
    Test_Eq("RT the accent segment is BREAK", Test_RT_Spans("Hit [a]BREAK[/a] now", "accent")[0], "BREAK");
    // nested, unknown, unclosed and stray tags degrade to plain text and never leave a bracket
    var _nest = "[t]one [a]two[/a] three[/t]";
    Test_Eq("RT nested tags: no term survives", array_length(Test_RT_Spans(_nest, "term")), 0);
    Test_Eq("RT nested tags: the text is all there", Markup_Strip(_nest, "keyboard"), "one two three");
    Test_Eq("RT an unknown tag is dropped, its text kept", Markup_Strip("a [zz]b[/zz] c", "keyboard"), "a b c");
    Test_Eq("RT an unknown tag makes no styled segment", array_length(Test_RT_Spans("a [zz]b[/zz] c", "term")) + array_length(Test_RT_Spans("a [zz]b[/zz] c", "accent")), 0);
    Test_Eq("RT an unclosed tag is plain", Markup_Strip("a [t]b c", "keyboard"), "a b c");
    Test_Eq("RT an unclosed tag makes no term", array_length(Test_RT_Spans("a [t]b c", "term")), 0);
    Test_Eq("RT a stray closing tag is dropped", Markup_Strip("a b[/t] c", "keyboard"), "a b c");
    Test_Eq("RT an unknown action is dropped", Markup_Strip("Press [k:dance] now", "keyboard"), "Press  now");
    Test_Eq("RT a lone bracket stays text", Markup_Strip("a [ b ] c", "keyboard"), "a [ b ] c");
    Test_Eq("RT the old {confirm} spelling still works", Markup_Strip("Press {confirm}.", "gamepad"), "Press A.");
    Test_True("RT the problems list names a nested tag", array_length(Markup_Problems(_nest)) > 0);
    Test_True("RT the problems list names an unknown tag", array_length(Markup_Problems("[zz]x[/zz]")) > 0);
    Test_True("RT the problems list names an unclosed tag", array_length(Markup_Problems("[t]x")) > 0);
    Test_True("RT the problems list names an unknown action", array_length(Markup_Problems("[k:dance]")) > 0);
    Test_Eq("RT well-formed markup has no problems", array_length(Markup_Problems("[t]a[/t] [a]b[/a] [k:confirm] {n}")), 0);
    Test_True("RT markup is told from plain text", Prompt_HasTokens("[t]a[/t]") && Prompt_HasTokens("x [a]b[/a]") && Prompt_HasTokens("[k:back]") && !Prompt_HasTokens("plain [x") && !Prompt_HasTokens("plain"));
    // width: the markup costs nothing, a glyph costs its real width
    var _sp = UI_TextWidth("a a") - UI_TextWidth("aa");
    Test_Eq("RT the width of marked text is the width of the plain words", Markup_Width("[t]Poison[/t] hurts", "keyboard"), UI_TextWidth("Poison") + _sp + UI_TextWidth("hurts"));
    Test_Eq("RT marked and plain text are the same width", Markup_Width("[t]Poison[/t] [a]hurts[/a]", "keyboard"), Markup_Width("Poison hurts", "keyboard"));
    var _gk = Prompt_GlyphW(Prompt_Info("confirm", "keyboard"));
    Test_Eq("RT a key glyph counts its real width (keyboard)", Markup_Width("Press [k:confirm]", "keyboard"), UI_TextWidth("Press") + _sp + _gk);
    var _gp = Prompt_GlyphW(Prompt_Info("confirm", "gamepad"));
    Test_Eq("RT a pad glyph counts its real width (pad)", Markup_Width("Press [k:confirm]", "gamepad"), UI_TextWidth("Press") + _sp + _gp);
    Test_Eq("RT a glyph next to text with no space adds no space", Markup_Width("[k:confirm]x", "keyboard"), _gk + UI_TextWidth("x"));
    // length and reveal (the typewriter counts what is seen: a glyph is one character)
    Test_Eq("RT visible length ignores the tags", Markup_Length("[t]Poison[/t] hurts"), 12);
    Test_Eq("RT a glyph is one visible character", Markup_Length("Press [k:confirm]."), 8);
    Test_Eq("RT reveal cuts inside a tag and keeps it closed", Markup_Reveal("[t]Poison[/t] hurts", 3), "[t]Poi[/t]");
    Test_Eq("RT reveal past a tag goes on", Markup_Reveal("[t]Poison[/t] hurts", 8), "[t]Poison[/t] h");
    Test_Eq("RT reveal stops before a glyph that is not due", Markup_Reveal("Press [k:confirm].", 6), "Press ");
    Test_Eq("RT reveal shows the glyph when it is due", Markup_Reveal("Press [k:confirm].", 7), "Press [k:confirm]");
    Test_Eq("RT reveal of everything is the text", Markup_Reveal("[t]Poison[/t] hurts", 99), "[t]Poison[/t] hurts");
    Test_Eq("RT reveal of plain text is the plain prefix", Markup_Reveal("plain text", 5), "plain");
    // wrap: lines of markup, every line fits, the words and the term survive
    var _wtxt = "The [t]Poison[/t] stings and the [a]BREAK[/a] hurts a great deal, so press [k:confirm] soon.";
    var _ww = Markup_Width("The Poison stings and the BREAK", "keyboard") + 2;
    var _wl = Markup_Wrap(_wtxt, _ww, "keyboard");
    var _fits = true;
    var _joined = "";
    for (var _i = 0; _i < array_length(_wl); _i++) {
        if (Markup_Width(_wl[_i], "keyboard") > _ww) _fits = false;
        _joined += ((_i > 0) ? " " : "") + Markup_Strip(_wl[_i], "keyboard");
    }
    Test_True("RT the wrap makes more than one line", array_length(_wl) > 1);
    Test_True("RT every wrapped line fits the width", _fits);
    Test_Eq("RT the wrapped lines hold every word", _joined, Markup_Strip(_wtxt, "keyboard"));
    Test_True("RT the term is still a term on its line", array_length(_wl) > 0 && array_length(Test_RT_Spans(_wl[0], "term")) == 1);
    Test_Eq("RT a hard newline starts a new line", array_length(Markup_Wrap("one\ntwo", 9999, "keyboard")), 2);
    Test_Eq("RT plain text wraps to its own words", Markup_Wrap("plain", 9999, "keyboard")[0], "plain");
    // laid-out text is kept per text and device, and follows a rebound key at once
    var _wk0 = Markup_Width("[k:confirm]", "keyboard");
    Test_Eq("RT the same text measures the same twice (from the kept layout)", Markup_Width("[k:confirm]", "keyboard"), _wk0);
    Binds_Apply(Binds_Assign(Binds_Defaults(), "confirm", ord("T")).keys);
    Test_True("RT a rebound key changes the width of the button at once", Markup_Width("[k:confirm]", "keyboard") != _wk0);
    Binds_Apply(Binds_Defaults());
    Test_Eq("RT the default key is back at once", Markup_Width("[k:confirm]", "keyboard"), _wk0);
    // pieces that hang on to the one before (no space) never part from it at a line end
    var _gl = Prompt_GlyphW(Prompt_Info("left", "keyboard"));
    var _w2 = Markup_Width("aaaa", "keyboard") + _sp + _gl + 1;   // room for the first arrow, not for the second
    var _pair = Markup_Wrap("aaaa [k:left][k:right]", _w2, "keyboard");
    Test_Eq("RT two arrows in a row go to the next line together", array_length(_pair), 2);
    Test_True("RT the pair of arrows is on one line", array_length(_pair) == 2 && Test_RT_Count(_pair[0], "glyph") == 0 && Test_RT_Count(_pair[1], "glyph") == 2);
    var _w3 = Markup_Width("aaaa", "keyboard") + _sp + _gk + 1;   // room for the glyph, not for the full stop after it
    var _dot = Markup_Wrap("aaaa [k:confirm].", _w3, "keyboard");
    Test_True("RT a full stop stays with the button before it", array_length(_dot) == 2 && Test_RT_Count(_dot[1], "glyph") == 1 && Markup_Strip(_dot[1], "keyboard") == "Space.");
    var _lay2 = Prompt_RichLayout("aaaa [k:left][k:right]", _w2, "keyboard");
    Test_True("RT the layout keeps the arrows together too", _lay2.lines == 2 && _lay2.items[1].line == 1 && _lay2.items[2].line == 1);

    // ---- 2. device-aware prompts ----
    var _ck = Markup_Segments("[k:confirm]", "keyboard");
    Test_True("RT [k:confirm] on the keyboard is the key name", array_length(_ck) == 1 && _ck[0].kind == "glyph" && _ck[0].info.kind == "key" && _ck[0].info.label == "Space");
    var _cp = Markup_Segments("[k:confirm]", "gamepad");
    Test_True("RT [k:confirm] on the pad is the A button", array_length(_cp) == 1 && _cp[0].kind == "glyph" && _cp[0].info.kind == "pad" && _cp[0].info.label == "A");
    global.input.last_device = "gamepad";
    Test_Eq("RT after a pad input the live prompt is the pad glyph", Markup_Segments("[k:confirm]")[0].info.kind, "pad");
    Test_Eq("RT after a pad input the plain text is the button", Markup_Strip("[k:confirm]"), "A");
    global.input.last_device = "keyboard";
    Test_Eq("RT after a key press the live prompt is the keyboard", Markup_Segments("[k:confirm]")[0].info.kind, "key");
    Test_Eq("RT after a key press the plain text is the key name", Markup_Strip("[k:confirm]"), "Space");
    Test_Eq("RT the interact key is Space", Markup_Strip("[k:interact]", "keyboard"), "Space");
    Test_Eq("RT the pad back button is B", Markup_Strip("[k:back]", "gamepad"), "B");
    Test_Eq("RT the pad shoulders are LB and RB", Markup_Strip("[k:tab_prev][k:tab_next]", "gamepad"), "LBRB");
    Test_Eq("RT the pad Start button exists", Markup_Strip("[k:start]", "gamepad"), "Start");
    Test_Eq("RT the pad X button is the menu", Markup_Strip("[k:menu]", "gamepad"), "X");
    // arrows instead of letters
    Test_Eq("RT a keyboard left prompt is an arrow glyph", Prompt_Info("left", "keyboard").dir, "left");
    Test_Eq("RT a keyboard right prompt is an arrow glyph", Prompt_Info("right", "keyboard").dir, "right");
    Test_Eq("RT a keyboard up prompt is an arrow glyph", Prompt_Info("up", "keyboard").dir, "up");
    Test_Eq("RT a keyboard down prompt is an arrow glyph", Prompt_Info("down", "keyboard").dir, "down");
    Test_Eq("RT a pad left prompt is a d-pad glyph", Prompt_Info("left", "gamepad").dir, "left");
    Test_Eq("RT a pad confirm prompt has no direction", Prompt_Info("confirm", "gamepad").dir, "");
    Test_Eq("RT a keyboard confirm prompt has no direction", Prompt_Info("confirm", "keyboard").dir, "");
    var _sk = Binds_Assign(Binds_Defaults(), "left", ord("J")).keys;
    Binds_Apply(_sk);
    Test_True("RT a move key rebound to a letter while the arrow is still bound shows the arrow", Prompt_Info("left", "keyboard").dir == "left");
    global.input.bindings.move_left = [ord("J")];
    Test_True("RT a move key bound to a letter only shows that letter", Prompt_Info("left", "keyboard").dir == "" && Prompt_Info("left", "keyboard").label == "J");
    Binds_Apply(Binds_Defaults());
    Test_True("RT the default move keys show the arrow", Prompt_Info("left", "keyboard").dir == "left");
    var _pl = Markup_Segments("[k:left][k:right]", "gamepad");
    Test_Eq("RT a run of d-pad prompts is one glyph", array_length(_pl), 1);
    Test_True("RT the run lights both arms", array_length(_pl) == 1 && array_length(_pl[0].info.dirs) == 2);
    Test_Eq("RT on the keyboard each arrow is its own glyph", array_length(Markup_Segments("[k:up][k:down][k:left][k:right]", "keyboard")), 4);
    Test_True("RT an arrow keycap is at least as wide as tall", Prompt_GlyphW(Prompt_Info("left", "keyboard")) >= Prompt_GlyphH());

    // no key letters are left in the English text (arrows and glyphs come from the markup)
    Loc_Init();
    var _keys = variable_struct_get_names(Loc_GetData().strings);
    Test_True("RT the workbook is loaded for the text audit", array_length(_keys) > 500);
    var _bad = "";
    var _problems = "";
    var _acc_bad = "";
    var _par_bad = "";
    var _pats = ["A/D", "W/S", "WASD", "A / D", "Up / Down", "Left / Right", "Press Z", "Press X", "Press Space", "Press Enter", "Press Esc"];
    var _allowed = ["BREAK", "Perfect"];   // D178: a received item is no longer an accent: its name carries its rarity tag
    for (var _k = 0; _k < array_length(_keys); _k++) {
        var _e = variable_struct_get(Loc_GetData().strings, _keys[_k]);
        if (!is_struct(_e)) continue;
        var _en = variable_struct_exists(_e, "en") ? string(_e.en) : "";
        var _ko = variable_struct_exists(_e, "ko") ? string(_e.ko) : "";
        for (var _q = 0; _q < array_length(_pats); _q++) if (string_pos(_pats[_q], _en) > 0) _bad += _keys[_k] + " ";
        if (array_length(Markup_Problems(_en)) > 0 || array_length(Markup_Problems(_ko)) > 0) _problems += _keys[_k] + " ";
        var _acc = Test_RT_Spans(_en, "accent");
        for (var _a = 0; _a < array_length(_acc); _a++) if (!array_contains(_allowed, _acc[_a])) _acc_bad += _keys[_k] + ":" + _acc[_a] + " ";
        if (array_length(Test_RT_Spans(_en, "accent")) != array_length(Test_RT_Spans(_ko, "accent")) || Test_RT_Count(_en, "glyph") != Test_RT_Count(_ko, "glyph")) _par_bad += _keys[_k] + " ";
    }
    Test_Eq("RT no English string names keys as letters or slashes", _bad, "");
    Test_Eq("RT every English and Korean string has well-formed markup", _problems, "");
    Test_Eq("RT [a] holds only BREAK or Perfect", _acc_bad, "");
    Test_Eq("RT English and Korean carry the same accents and buttons", _par_bad, "");
    Test_True("RT the key terms are marked in English (tutorial, status, stat text)", array_length(Test_RT_Spans(Loc_T("tutorial.stagger.body"), "accent")) >= 1 && array_length(Test_RT_Spans(Loc_T("status.desc.poison"), "term")) >= 1 && array_length(Test_RT_Spans(Loc_T("menu.tooltip.stat.atk.desc"), "term")) >= 1);
    Test_True("RT the button mentions are button markup", Test_RT_Count(Loc_T("tutorial.bar.body"), "glyph") >= 1 && Test_RT_Count(Loc_T("tutorial.arrows.body"), "glyph") == 4 && Test_RT_Count(Loc_T("runflow.continue"), "glyph") == 1);

    // ---- 3. the accent colour ----
    Test_Eq("RT the accent is exactly #E8C547", Markup_Colour("accent", UI_C_TEXT), make_color_rgb($E8, $C5, $47));
    Test_Eq("RT the accent macro is #E8C547 too", UI_C_ACCENT, make_color_rgb($E8, $C5, $47));
    Test_True("RT the term colour is not the accent", Markup_Colour("term", UI_C_TEXT) != UI_C_ACCENT);
    Test_True("RT plain text is never the accent", Markup_Colour("", UI_C_TEXT) != UI_C_ACCENT && Markup_Colour("", UI_C_LIGHT) != UI_C_ACCENT && Markup_Colour("", UI_C_DARK) != UI_C_ACCENT);
    Test_True("RT an unknown style falls back to the base colour", Markup_Colour("zz", UI_C_LIGHT) == UI_C_LIGHT);

    // ---- 4. battle hint labels: one prompt line ----
    Test_Eq("RT the battle command menu draws no hint label", array_length(Battle_HintLabels(BSTATE_MENU)), 0);
    Test_Eq("RT the skill list draws one hint label", array_length(Battle_HintLabels(BSTATE_SKILL_MENU)), 1);
    Test_Eq("RT the item list draws one hint label", array_length(Battle_HintLabels(BSTATE_ITEM_MENU)), 1);
    Test_Eq("RT the attack bar draws no hint label", array_length(Battle_HintLabels(BSTATE_ATTACK_TIMING)), 0);
    Test_Eq("RT the arrow bar draws no hint label", array_length(Battle_HintLabels(BSTATE_SKILL_QTE)), 0);
    Test_Eq("RT the defence bar draws no hint label", array_length(Battle_HintLabels(BSTATE_ENEMY_DEFENCE)), 0);
    var _hl = Battle_HintLabels(BSTATE_SKILL_MENU);
    Test_True("RT the one label is the confirm prompt", array_length(_hl) == 1 && _hl[0].action == "confirm");
    Test_Eq("RT the battle prompt line has one button", Test_RT_Count(Loc_T("battle.hint.list"), "glyph"), 1);
    Test_Eq("RT the battle prompt line is not a Back hint", string_pos("Back", Loc_T("battle.hint.list")), 0);

    global.input.last_device = _dev0;
    Binds_Apply(Binds_Defaults());
}
// Bug hunt 5a (D141): the quit-before-fight snapshot belongs to ONE fight. It is taken by EnemyPersist_BeginEncounter and must be gone when that fight ends
// (won, fled, lost) or once Quit has used it, or a later quit in a fight that did not start from the map would write a stale run over the autosave.
// The "lost" path (Run_OnPlayerDeath) is checked by the smoke steps 800..802.
function Test_Suite_Hunt5a() {
    var _gs = Test_FixBegin(DIFFICULTY_NORMAL);
    var _old_persist = _gs.persist;
    var _old_pid = _gs.battle.enemy_persist_id;
    var _old_eid = _gs.battle.enemy_id;
    var _old_room = _gs.battle.enemy_room;
    _gs.persist = {};

    // the clear itself
    global.encounter_snapshot = "{}";
    Test_True("hunt5a: a snapshot is held (setup)", EnemyPersist_HasSnapshot());
    EnemyPersist_ClearSnapshot();
    Test_False("hunt5a: clearing the snapshot leaves none", EnemyPersist_HasSnapshot());
    EnemyPersist_ClearSnapshot();
    Test_False("hunt5a: clearing with none is harmless", EnemyPersist_HasSnapshot());

    // a won fight from the map
    _gs.battle.enemy_persist_id = "h5a_e1";
    _gs.battle.enemy_id = 0;
    _gs.battle.enemy_room = rm_floor2;
    global.encounter_snapshot = "{}";
    EnemyPersist_ResolveBattle(true);
    Test_True("hunt5a: a won fight keeps the snapshot while the message shows (review 6: a quit there must still save)", EnemyPersist_HasSnapshot());
    EnemyPersist_AfterMapSave();
    Test_False("hunt5a: the map's save after a won fight clears the snapshot", EnemyPersist_HasSnapshot());

    // a fled fight from the map
    global.encounter_snapshot = "{}";
    EnemyPersist_ResolveBattle(false);
    Test_True("hunt5a: a fled fight keeps the snapshot while the message shows", EnemyPersist_HasSnapshot());
    EnemyPersist_AfterMapSave();
    Test_False("hunt5a: the map's save after a fled fight clears the snapshot", EnemyPersist_HasSnapshot());

    // a fight that did not start from the map (no enemy to resolve) still ends
    _gs.battle.enemy_persist_id = "";
    global.encounter_snapshot = "{}";
    EnemyPersist_ResolveBattle(true);
    Test_True("hunt5a: a won fight with no map enemy keeps the snapshot until the map has saved", EnemyPersist_HasSnapshot());
    EnemyPersist_AfterMapSave();
    Test_False("hunt5a: and the map's save clears it", EnemyPersist_HasSnapshot());
    global.encounter_snapshot = "{}";
    EnemyPersist_ResolveBattle(false);
    Test_True("hunt5a: a fled fight with no map enemy keeps the snapshot until the map has saved", EnemyPersist_HasSnapshot());
    EnemyPersist_AfterMapSave();
    Test_False("hunt5a: and the map's save clears it too", EnemyPersist_HasSnapshot());
    // a map save with a fight still going (not decided) leaves its snapshot alone
    global.encounter_snapshot = "{}";
    global.encounter_resolved = false;
    EnemyPersist_AfterMapSave();
    Test_True("hunt5a: a map save does not clear the snapshot of a fight that is not decided", EnemyPersist_HasSnapshot());
    EnemyPersist_ClearSnapshot();

    // Quit used it: a second quit must not write it again
    var _gs2 = _gs;
    var _had_run = variable_struct_exists(_gs2, "run");
    var _old_run = _had_run ? _gs2.run : undefined;
    var _old_cp = _gs2.checkpoint;
    var _old_ch = _gs2.player_ch;
    var _old_flags = _gs2.flags;
    _gs2.run = Run_Create(5151);
    _gs2.checkpoint = { room: rm_floor2, x: 48, y: 64 };
    _gs2.player_ch = CharacterCreate_Player(CLASS_MAGE);
    _gs2.flags = {};
    var _f = "test_hunt5a_run.sav";
    Save_DeleteFileSet(_f);
    Test_True("hunt5a: a snapshot is taken (setup)", EnemyPersist_SnapshotRun());
    Test_True("hunt5a: Quit writes it", EnemyPersist_WriteSnapshot(_f));
    Test_False("hunt5a: once written the snapshot is spent", EnemyPersist_HasSnapshot());
    Test_False("hunt5a: a second write has nothing to write", EnemyPersist_WriteSnapshot(_f));
    global.encounter_snapshot = undefined;
    Save_DeleteFileSet(_f);
    if (_had_run) _gs2.run = _old_run; else variable_struct_remove(_gs2, "run");
    _gs2.checkpoint = _old_cp;
    _gs2.player_ch = _old_ch;
    _gs2.flags = _old_flags;

    _gs.persist = _old_persist;
    _gs.battle.enemy_persist_id = _old_pid;
    _gs.battle.enemy_id = _old_eid;
    _gs.battle.enemy_room = _old_room;
}

// ---- H12a (D154): small flavour choices (the Stranger, the merchant, a note, the wake line) -----------------------------------------------------------
// Expected values come from the brief: at least 4 choice points, 2 replies each, the reply changes the NEXT line, the answer is remembered in the profile's
// unlocks map ("choice_<id>" = 1 or 2, no format change: PROFILE_VERSION stays 2), a stored answer changes a LATER line, and nothing changes HP / MP / items /
// gold / stats. The English texts of the merchant's greeting variants are the ones the writer fixed in the brief.
function Test_ChoiceIds() {
    return ["stranger", "merchant", "map_page", "wake"];
}

function Test_ChoiceProfileWith(_n) {
    var _p = Profile_Default();
    var _ids = Test_ChoiceIds();
    for (var _i = 0; _i < array_length(_ids); _i++) Choice_Set(_p, _ids[_i], _n);
    return _p;
}

function Test_ChoiceDefs() {
    var _ids = Test_ChoiceIds();
    Test_Eq("D154 the choice points, in order", json_stringify(Choice_Ids()), json_stringify(_ids));
    for (var _i = 0; _i < array_length(_ids); _i++) {
        var _id = _ids[_i];
        var _d = Choice_Def(_id);
        Test_Eq("D154 " + _id + ": the profile key", Choice_Key(_id), "choice_" + _id);
        Test_Eq("D154 " + _id + ": exactly 2 replies to pick", array_length(_d.labels), 2);
        Test_True("D154 " + _id + ": the two replies read differently", _d.labels[0] != _d.labels[1] && _d.labels[0] != "" && _d.labels[1] != "");
        Test_True("D154 " + _id + ": a question of at least one line", array_length(_d.ask) >= 1 && _d.ask[0] != "");
        Test_True("D154 " + _id + ": each reply has a next line", array_length(_d.reply) == 2 && array_length(_d.reply[0]) >= 1 && array_length(_d.reply[1]) >= 1);
        Test_True("D154 " + _id + ": reply 1 and reply 2 show a different next line", _d.reply[0][0] != _d.reply[1][0] && json_stringify(_d.reply[0]) != json_stringify(_d.reply[1]));
        Test_True("D154 " + _id + ": each answer has a later line", array_length(_d.again) == 2 && array_length(_d.again[0]) >= 1 && array_length(_d.again[1]) >= 1);
        Test_True("D154 " + _id + ": the later line differs by answer", _d.again[0][0] != _d.again[1][0]);
    }
}

function Test_ChoiceStorage() {
    var _ids = Test_ChoiceIds();
    for (var _i = 0; _i < array_length(_ids); _i++) {
        var _id = _ids[_i];
        var _p = Profile_Default();
        Test_Eq("D154 " + _id + ": unanswered reads 0", Choice_Get(_p, _id), 0);
        Test_Eq("D154 " + _id + ": no later line before an answer", array_length(Choice_AgainLines(_id, _p)), 0);
        Test_True("D154 " + _id + ": answer 1 is stored", Choice_Set(_p, _id, 1) && Choice_Get(_p, _id) == 1);
        Test_True("D154 " + _id + ": stored as the number 1 in the unlocks map", is_real(variable_struct_get(_p.unlocks, "choice_" + _id)) && variable_struct_get(_p.unlocks, "choice_" + _id) == 1);
        Test_Eq("D154 " + _id + ": answer 1 gives the first later line", json_stringify(Choice_AgainLines(_id, _p)), json_stringify(Choice_Def(_id).again[0]));
        Test_True("D154 " + _id + ": the answer can be changed to 2", Choice_Set(_p, _id, 2) && Choice_Get(_p, _id) == 2);
        Test_Eq("D154 " + _id + ": answer 2 gives the second later line", json_stringify(Choice_AgainLines(_id, _p)), json_stringify(Choice_Def(_id).again[1]));
        Test_False("D154 " + _id + ": 3 is no answer", Choice_Set(_p, _id, 3));
        Test_False("D154 " + _id + ": 0 is no answer", Choice_Set(_p, _id, 0));
        Test_Eq("D154 " + _id + ": a refused answer leaves the stored one", Choice_Get(_p, _id), 2);
    }
    // junk in a file reads as unanswered
    var _j = Profile_Normalize({ profile_version: 2, unlocks: { choice_stranger: "x", choice_wake: 7, choice_merchant: true, choice_map_page: 2 } });
    Test_Eq("D154 junk: a text value is no answer", Choice_Get(_j, "stranger"), 0);
    Test_Eq("D154 junk: 7 is no answer", Choice_Get(_j, "wake"), 0);
    Test_Eq("D154 junk: true is no answer", Choice_Get(_j, "merchant"), 0);
    Test_Eq("D154 junk: 2 is an answer", Choice_Get(_j, "map_page"), 2);
}

function Test_ChoiceSaveLoad() {
    var _f = "test_profile_h12.sav";
    Save_DeleteFileSet(_f);
    var _w = Profile_Default();
    Profile_Unlock(_w, "nobody_class");
    Profile_StoryMark(_w, "cutscene:intro");
    _w.deaths = 3;
    Choice_Set(_w, "stranger", 2);
    Choice_Set(_w, "merchant", 1);
    Choice_Set(_w, "map_page", 1);
    Choice_Set(_w, "wake", 2);
    Test_True("D154 save: the profile writes", Profile_SaveTo(_f, _w));
    Test_True("D154 save: the file says version 3 (saves1: name)", string_pos("\"profile_version\":3", Test_RawRead(_f)) > 0);
    var _r = Profile_Load(_f);
    Test_Eq("D154 save: reads back ok", _r.status, "ok");
    Test_Eq("D154 save: PROFILE_VERSION is 3 (saves1: name)", PROFILE_VERSION, 3);
    Test_Eq("D154 load: the Stranger's answer survives", Choice_Get(_r.profile, "stranger"), 2);
    Test_Eq("D154 load: the merchant's answer survives", Choice_Get(_r.profile, "merchant"), 1);
    Test_Eq("D154 load: the note's answer survives", Choice_Get(_r.profile, "map_page"), 1);
    Test_Eq("D154 load: the wake answer survives", Choice_Get(_r.profile, "wake"), 2);
    Test_Eq("D154 load: the later line follows the loaded answer", json_stringify(Choice_AgainLines("stranger", _r.profile)), json_stringify(Choice_Def("stranger").again[1]));
    Test_True("D154 load: the other unlocks and the story are intact", Profile_IsUnlocked(_r.profile, "nobody_class") && Profile_StorySeen(_r.profile, "cutscene:intro") && _r.profile.deaths == 3);
    Test_Eq("D154 load: the unlocks map holds only the old key and the four answers", array_length(variable_struct_get_names(_r.profile.unlocks)), 5);
    // a profile from before this packet (no answers) loads and reads unanswered
    var _old = Profile_Default();
    Profile_Unlock(_old, "nobody_class");
    Test_True("D154 old file: writes", Profile_SaveTo(_f, _old));
    var _r0 = Profile_Load(_f);
    Test_True("D154 old file: every choice reads unanswered", Choice_Get(_r0.profile, "stranger") == 0 && Choice_Get(_r0.profile, "merchant") == 0 && Choice_Get(_r0.profile, "map_page") == 0 && Choice_Get(_r0.profile, "wake") == 0);
    Save_DeleteFileSet(_f);
}

function Test_ChoiceLaterLines() {
    var _keep = variable_global_exists("profile") ? global.profile : undefined;
    var _keep_st = variable_global_exists("profile_status") ? global.profile_status : "missing";
    // the merchant's greeting: the first of his four lines changes with the answer, the other three do not
    global.profile = Profile_Default();
    var _plain = Merchant_Line("greet", 0);
    Test_Eq("D154 merchant: unanswered, the first greeting is the old one", _plain, "You came a long way down. Brave. Or lost.");
    global.profile = Test_ChoiceProfileWith(1);
    Test_Eq("D154 merchant: answer 1 (a way out) greets with the first variant", Merchant_Line("greet", 0), "Found your way out yet? No? Then buy something.");
    global.profile = Test_ChoiceProfileWith(2);
    Test_Eq("D154 merchant: answer 2 (something to buy) greets with the second variant", Merchant_Line("greet", 0), "Back to spend, I hope. That I understand.");
    Test_True("D154 merchant: the other greetings do not change", Merchant_Line("greet", 1) == "Coins keep the dark away. Mostly." && Merchant_Line("greet", 2) == "Don't ask where I sleep." && Merchant_Line("greet", 3) == "Buy something. Please.");
    Test_True("D154 merchant: buy / sell / leave lines do not change", Merchant_Line("buy", 0) == "Good choice. You will need it." && Merchant_Line("sell", 0) == "I'll take it. No questions." && Merchant_Line("leave", 0) == "Come back. They always do.");
    // the note: a read note with an answer carries the later line after its own lines; without one it is unchanged
    var _note = Note_Find("map_page");
    global.profile = Profile_Default();
    Test_Eq("D154 note: unanswered, the note reads as it did", array_length(Note_ReadLines(_note)), array_length(_note.lines));
    global.profile = Test_ChoiceProfileWith(2);
    var _lines = Note_ReadLines(_note);
    Test_Eq("D154 note: answered, the later line follows the note's own lines", array_length(_lines), array_length(_note.lines) + 1);
    Test_True("D154 note: the note's own lines come first, unchanged", _lines[0] == _note.lines[0] && _lines[array_length(_note.lines) - 1] == _note.lines[array_length(_note.lines) - 1]);
    Test_Eq("D154 note: the added line is the answer's", _lines[array_length(_lines) - 1], Choice_Def("map_page").again[1][0]);
    var _other = Note_Find("wall_breath");
    Test_Eq("D154 note: a note without a choice never changes", array_length(Note_ReadLines(_other)), array_length(_other.lines));
    global.profile = _keep;
    global.profile_status = _keep_st;
}

// D147 + D154: a note asks its question in the Codex reader, not on pickup. The reader's line list: before an answer the note's own lines and the question;
// with global.choice_off, or a note without a choice, only the note; after an answer the note's lines and the later line; right after the pick, the note's lines
// and the reply.
function Test_ChoiceNoteReader() {
    var _keep = variable_global_exists("profile") ? global.profile : undefined;
    var _keep_st = variable_global_exists("profile_status") ? global.profile_status : "missing";
    var _keep_off = variable_global_exists("choice_off") ? global.choice_off : false;
    Test_True("D147+D154 the reader's functions exist", script_exists(asset_get_index("Note_ReaderLines")) && script_exists(asset_get_index("Note_AsksQuestion")) && script_exists(asset_get_index("Note_ReplyLines")));
    if (script_exists(asset_get_index("Note_ReaderLines")) && script_exists(asset_get_index("Note_AsksQuestion")) && script_exists(asset_get_index("Note_ReplyLines"))) {
        var _note = Note_Find("map_page");
        var _def = Choice_Def("map_page");
        var _n = array_length(_note.lines);
        global.choice_off = false;
        global.profile = Profile_Default();
        Test_True("D147+D154 reader: an unanswered note with a choice asks", Note_AsksQuestion(_note));
        var _q = Note_ReaderLines(_note);
        Test_Eq("D147+D154 reader: unanswered, the note's lines and the question's lines", array_length(_q), _n + array_length(_def.ask));
        Test_True("D147+D154 reader: the note's own lines come first, then the question", _q[0] == _note.lines[0] && _q[_n - 1] == _note.lines[_n - 1] && _q[_n] == _def.ask[0] && _q[array_length(_q) - 1] == _def.ask[array_length(_def.ask) - 1]);
        Test_Eq("D147+D154 reply: the note's lines and the reply of the second answer", json_stringify(Note_ReplyLines(_note, 1)), json_stringify(array_concat(_note.lines, _def.reply[1])));
        Test_Eq("D147+D154 reply: the first answer has its own reply", Note_ReplyLines(_note, 0)[_n], _def.reply[0][0]);
        Choice_Set(global.profile, "map_page", 2);
        Test_True("D147+D154 reader: an answered note does not ask again", !Note_AsksQuestion(_note));
        var _a = Note_ReaderLines(_note);
        Test_Eq("D147+D154 reader: answered, the note's lines and the later line", json_stringify(_a), json_stringify(array_concat(_note.lines, _def.again[1])));
        Test_Eq("D147+D154 reader: answered, it is the same list the dialogue helper gives", json_stringify(_a), json_stringify(Note_ReadLines(_note)));
        global.profile = Profile_Default();
        global.choice_off = true;
        Test_True("D147+D154 reader: with the questions off a note does not ask", !Note_AsksQuestion(_note));
        Test_Eq("D147+D154 reader: with the questions off, only the note's lines", json_stringify(Note_ReaderLines(_note)), json_stringify(_note.lines));
        global.choice_off = false;
        var _plain = Note_Find("wall_breath");
        Test_True("D147+D154 reader: a note without a choice never asks", !Note_AsksQuestion(_plain));
        Test_Eq("D147+D154 reader: a note without a choice reads as its lines", json_stringify(Note_ReaderLines(_plain)), json_stringify(_plain.lines));
        var _bad = Note_Find("no_such_note");
        Test_True("D147+D154 reader: an unknown note does not ask", !Note_AsksQuestion(_bad));
    }
    global.choice_off = _keep_off;
    global.profile = _keep;
    global.profile_status = _keep_st;
}

// Remembering an answer touches the unlocks map and nothing else of the profile, and never the character or the run.
function Test_ChoiceNoEffect() {
    var _gs = GameState_Get();
    var _ch = CharacterCreate_Player(CLASS_KNIGHT);
    _ch.inventory = Inv_Add(_ch.inventory, 10, 2);
    var _old_ch = _gs.player_ch;
    _gs.player_ch = _ch;
    var _had_run = variable_struct_exists(_gs, "run") && is_struct(_gs.run);
    var _old_run = _had_run ? _gs.run : undefined;
    _gs.run = Run_Create(2468);
    _gs.run.gold = 31;
    var _ch0 = json_stringify(_gs.player_ch);
    var _run0 = json_stringify(_gs.run);
    var _ids = Test_ChoiceIds();
    for (var _i = 0; _i < array_length(_ids); _i++) {
        for (var _n = 1; _n <= 2; _n++) {
            var _p = Profile_Default();
            Profile_SkillLearn(_p, SKILL_WOUND);
            _p.deaths = 2;
            _p.wins = 1;
            var _hist0 = array_length(_p.history);
            Choice_Set(_p, _ids[_i], _n);
            var _tag = _ids[_i] + " answer " + string(_n);
            Test_Eq("D154 no effect (" + _tag + "): HP, MP, stats, items, skills of the character", json_stringify(_gs.player_ch), _ch0);
            Test_Eq("D154 no effect (" + _tag + "): gold and the rest of the run", json_stringify(_gs.run), _run0);
            Test_True("D154 no effect (" + _tag + "): the profile counters and memory", _p.deaths == 2 && _p.wins == 1 && array_length(_p.history) == _hist0 && Profile_SkillKnown(_p, SKILL_WOUND) && array_length(variable_struct_get_names(_p.unlocks)) == 1);
        }
    }
    _gs.player_ch = _old_ch;
    if (_had_run) _gs.run = _old_run;
    else variable_struct_remove(_gs, "run");
}

// Every line of every text fits one page of the real dialogue box, in both languages, and the two replies fit beside the box.
function Test_ChoiceAllDiffer(_a, _b) {
    var _ok = true;
    for (var _i = 0; _i < array_length(_a.ask); _i++) { if (_a.ask[_i] == _b.ask[_i]) _ok = false; }
    for (var _l = 0; _l < 2; _l++) {
        if (_a.labels[_l] == _b.labels[_l]) _ok = false;
        for (var _r = 0; _r < array_length(_a.reply[_l]); _r++) { if (_a.reply[_l][_r] == _b.reply[_l][_r]) _ok = false; }
        for (var _y = 0; _y < array_length(_a.again[_l]); _y++) { if (_a.again[_l][_y] == _b.again[_l][_y]) _ok = false; }
    }
    return _ok;
}

function Test_ChoiceText() {
    var _lang = Loc_GetLanguage();
    var _ids = Test_ChoiceIds();
    var _langs = ["en", "ko"];
    var _en = {};
    for (var _g = 0; _g < 2; _g++) {
        Loc_SetLanguage(_langs[_g]);
        UI_SetFont();
        var _lay = Dialogue_TextLayout("Merchant");
        var _box = Dialogue_BoxRect();
        for (var _i = 0; _i < array_length(_ids); _i++) {
            var _d = Choice_Def(_ids[_i]);
            var _all = [];
            for (var _a = 0; _a < array_length(_d.ask); _a++) array_push(_all, _d.ask[_a]);
            for (var _k = 0; _k < 2; _k++) {
                for (var _r = 0; _r < array_length(_d.reply[_k]); _r++) array_push(_all, _d.reply[_k][_r]);
                for (var _y = 0; _y < array_length(_d.again[_k]); _y++) array_push(_all, _d.again[_k][_y]);
            }
            var _fits = true;
            var _empty = false;
            for (var _l = 0; _l < array_length(_all); _l++) {
                if (_all[_l] == "") _empty = true;
                if (array_length(Dialogue_WrapToLines(_all[_l], _lay.text_w)) > _lay.max_lines) _fits = false;
            }
            Test_False("D154 text (" + _langs[_g] + "): " + _ids[_i] + " has no empty line", _empty);
            Test_True("D154 text (" + _langs[_g] + "): " + _ids[_i] + " every line fits one page of the box", _fits);
            Test_True("D154 text (" + _langs[_g] + "): " + _ids[_i] + " the replies fit beside the box", UI_TextWidth(_d.labels[0]) <= _box.w / 2 && UI_TextWidth(_d.labels[1]) <= _box.w / 2);
            if (_g == 0) variable_struct_set(_en, _ids[_i], json_stringify(_d));
            else Test_True("D154 text (ko): " + _ids[_i] + " is translated (every piece differs from the English)", Test_ChoiceAllDiffer(_d, json_parse(variable_struct_get(_en, _ids[_i]))));
        }
    }
    Loc_SetLanguage(_lang);
}

function Test_Suite_Choices() {
    var _keep = variable_global_exists("profile") ? global.profile : undefined;
    var _keep_st = variable_global_exists("profile_status") ? global.profile_status : "missing";
    var _lang = Loc_GetLanguage();
    Loc_SetLanguage("en");
    Test_True("D154 the choice functions exist", script_exists(asset_get_index("Choice_Ids")) && script_exists(asset_get_index("Choice_Def")) && script_exists(asset_get_index("Choice_Get")) && script_exists(asset_get_index("Choice_Set")) && script_exists(asset_get_index("Choice_AgainLines")) && script_exists(asset_get_index("Note_ReadLines")));
    Test_ChoiceDefs();
    Test_ChoiceStorage();
    Test_ChoiceSaveLoad();
    Test_ChoiceLaterLines();
    Test_ChoiceNoteReader();
    Test_ChoiceNoEffect();
    Test_ChoiceText();
    Loc_SetLanguage(_lang);
    global.profile = _keep;
    global.profile_status = _keep_st;
}
// ---- hunt 6 (run loop and persistence): seeds the entry can take, the Continue card time, a kept run file ----
// Writes a run save with the real save code (RunSave_WriteTo) holding the given play time, reads it back with RunSave_LoadFrom and gives the result to the caller.
// The run, class, checkpoint and persist the test borrows are put back.
function Test_RealRunSaveLoad(_play_ms) {
    var _gs = GameState_Get();
    var _had_run = variable_struct_exists(_gs, "run");
    var _old_run = _had_run ? _gs.run : undefined;
    var _old_cp = _gs.checkpoint;
    var _old_persist = _gs.persist;
    var _old_class = _gs.selected_class;
    _gs.run = Run_Create(4321);
    _gs.run.gold = 55;
    _gs.run.stats.play_ms = _play_ms;
    _gs.selected_class = CLASS_MAGE;
    _gs.checkpoint = { room: rm_floor3, x: 48, y: 64 };
    _gs.persist = {};
    var _f = "test_hunt6_card.sav";
    Save_DeleteFileSet(_f);
    RunSave_WriteTo(_f);
    var _l = RunSave_LoadFrom(_f);
    Save_DeleteFileSet(_f);
    if (_had_run) _gs.run = _old_run; else variable_struct_remove(_gs, "run");
    _gs.checkpoint = _old_cp;
    _gs.persist = _old_persist;
    _gs.selected_class = _old_class;
    return _l;
}

function Test_Suite_Hunt6Run() {
    // 1. every random seed can be typed back into the seed entry (D152: up to 9 digits) and is a valid seed
    var _not_typable = 0;
    var _invalid = 0;
    var _first_bad = 0;
    var _max = 0;
    repeat (2000) {
        var _n = Run_NewSeed();
        _max = max(_max, _n);
        if (!Seed_IsValid(_n)) _invalid++;
        if (SeedParse(string(_n)) != _n) { _not_typable++; if (_first_bad == 0) _first_bad = _n; }
    }
    Test_Eq("hunt6run seed: every drawn seed is a valid seed", _invalid, 0);
    Test_Eq("hunt6run seed: every drawn seed parses back from its own digits (first bad: " + string(_first_bad) + ")", _not_typable, 0);
    Test_True("hunt6run seed: no drawn seed is longer than the nine digits the entry takes (largest " + string(_max) + ")", _max <= 999999999);
    var _entry = SeedEntry_New();
    var _digits = string(Run_NewSeed());
    for (var _i = 1; _i <= string_length(_digits); _i++) SeedEntry_Type(_entry, ord(string_char_at(_digits, _i)) - 48);
    Test_Eq("hunt6run seed: a drawn seed typed into the entry gives the same number", SeedEntry_Value(_entry), real(_digits));
    Test_Eq("hunt6run seed: a typed seed still maps to itself", Run_ResolveSeed(123456789), 123456789);

    // 2. the Continue card shows the time played that the real run save holds (stats.play_ms, D137)
    var _l = Test_RealRunSaveLoad(3725000);
    Test_Eq("hunt6run card: the real run save loads ok", _l.status, "ok");
    var _m = Title_CardModel(_l);
    Test_Eq("hunt6run card: the card reads the time played from a real run save", _m.time_ms, 3725000);
    var _t = Title_CardText(_m);
    Test_Eq("hunt6run card: a real run save gives a Time row", _t.rows[array_length(_t.rows) - 1].label, Loc_T("title.card.time", "Time"));
    Test_Eq("hunt6run card: the Time row reads h:mm:ss", _t.rows[array_length(_t.rows) - 1].value, "1:02:05");
    var _t0 = Title_CardText(Title_CardModel(Test_RealRunSaveLoad(0)));
    Test_Eq("hunt6run card: a real run save of a fresh run shows 0:00", _t0.rows[array_length(_t0.rows) - 1].value, "0:00");
    Test_Eq("hunt6run card: a save with no stats drops the time (old save)", Title_CardModel({ status: "ok", run: { gold: 1, floor: 1, statData: {} } }).time_ms, -1);

    // 3. Run_AbandonSaved keeps a damaged run file as it keeps a newer one (the rule New Game follows; the smoke step 840 pins Run_StartNew itself)
    var _ab = "test_hunt6_damaged.sav";
    Save_DeleteFileSet(_ab);
    Test_RawWrite(_ab, "{ this is not a run save");
    Test_Eq("hunt6run keep: the damaged run file reads as corrupt", RunSave_LoadFrom(_ab).status, "corrupt");
    Run_AbandonSaved(_ab);
    Test_True("hunt6run keep: Run_AbandonSaved keeps a damaged run file", RunSave_ExistsAt(_ab));
    Test_Eq("hunt6run keep: the damaged run file is unchanged", Test_RawRead(_ab), "{ this is not a run save");
    Save_DeleteFileSet(_ab);
}

/// ---- Review 6 (review-opus-session6.md, findings 1 to 4) ----
// Expected values come from the rules, not from the code: D16 (nothing is deleted that this build cannot read; the player may switch builds on one save folder),
// D148 ("???" until a skill was discovered in any run), D132 + D141 (closing in a fight keeps what was taken since the last autosave), D159 / D164 (a figure standing in the
// dark looks like it; only the marks drawn after the darkness stay bright).

// The run, class, checkpoint and persist the tests borrow, kept to put back.
function Test_Review6Borrow() {
    var _gs = GameState_Get();
    return { had_run: variable_struct_exists(_gs, "run"), run: variable_struct_exists(_gs, "run") ? _gs.run : undefined, cp: _gs.checkpoint, persist: _gs.persist, cls: _gs.selected_class, ch: _gs.player_ch, flags: _gs.flags, snap: variable_global_exists("encounter_snapshot") ? global.encounter_snapshot : undefined };
}

function Test_Review6Return(_b) {
    var _gs = GameState_Get();
    if (_b.had_run) _gs.run = _b.run; else variable_struct_remove(_gs, "run");
    _gs.checkpoint = _b.cp;
    _gs.persist = _b.persist;
    _gs.selected_class = _b.cls;
    _gs.player_ch = _b.ch;
    _gs.flags = _b.flags;
    global.encounter_snapshot = _b.snap;
}

function Test_Review6DropKept(_path) {
    var _k = RunSave_KeptFiles(_path);
    for (var _i = 0; _i < array_length(_k); _i++) Save_DeleteFileSet(_k[_i]);
}

// The alpha byte of every pixel of a surface's first _side x _side pixels, read in one go.
function Test_SurfaceAlpha(_surf, _side) {
    var _w = surface_get_width(_surf);
    var _buf = buffer_create(_w * surface_get_height(_surf) * 4, buffer_fixed, 1);
    buffer_get_surface(_buf, _surf, 0);
    var _m = array_create(_side * _side, 0);
    for (var _y = 0; _y < _side; _y++) {
        for (var _x = 0; _x < _side; _x++) _m[_y * _side + _x] = buffer_peek(_buf, (_y * _w + _x) * 4 + 3, buffer_u8);
    }
    buffer_delete(_buf);
    return _m;
}

// What the elite marks paint on top of the sprite's own pixels, and outside them: { inside, outside, bright } (bright = outside pixels that are fully opaque and exactly _col).
function Test_EliteFxOverSprite(_spr, _img, _col) {
    return Test_RingOverSprite(Elite_FxRing(_spr, _img, 1, 1, 0, _col), _spr, _img, _col);
}

// The same for any marks picture { surf, r } built round a sprite (the elite's outline, the merchant's glow).
function Test_RingOverSprite(_ring, _spr, _img, _col) {
    var _side = _ring.r * 2;
    var _w = surface_get_width(_ring.surf);
    var _buf = buffer_create(_w * surface_get_height(_ring.surf) * 4, buffer_fixed, 1);
    buffer_get_surface(_buf, _ring.surf, 0);
    var _spr_surf = surface_create(_side, _side);
    surface_set_target(_spr_surf);
    draw_clear_alpha(c_black, 0);
    draw_sprite_ext(_spr, _img, _ring.r, _ring.r, 1, 1, 0, c_white, 1);
    surface_reset_target();
    var _sp = Test_SurfaceAlpha(_spr_surf, _side);
    surface_free(_spr_surf);
    var _out = { inside: 0, outside: 0, bright: 0 };
    for (var _y = 0; _y < _side; _y++) {
        for (var _x = 0; _x < _side; _x++) {
            var _o = (_y * _w + _x) * 4;
            var _a = buffer_peek(_buf, _o + 3, buffer_u8);
            if (_a <= 0) continue;
            if (_sp[_y * _side + _x] > 0) { _out.inside++; continue; }
            _out.outside++;
            var _c = buffer_peek(_buf, _o, buffer_u8) | (buffer_peek(_buf, _o + 1, buffer_u8) << 8) | (buffer_peek(_buf, _o + 2, buffer_u8) << 16);
            if (_a == 255 && _c == (_col & $FFFFFF)) _out.bright++;
        }
    }
    buffer_delete(_buf);
    return _out;
}

function Test_Suite_Review6() {
    // ---- 1. New Game keeps a newer-version or damaged run.sav: it is moved to a sibling name BEFORE the new run saves, so the new run's first autosave cannot overwrite it ----
    var _b = Test_Review6Borrow();
    var _gs = GameState_Get();
    var _p = "test_review6_run.sav";
    Save_DeleteFileSet(_p);
    Test_Review6DropKept(_p);
    var _newer = json_stringify({ run_version: RUN_SAVE_VERSION + 50, seed: 1, marker: "keep me" });
    Test_RawWrite(_p, _newer);
    RunSave_DeleteUnlessKept(_p, undefined, true);   // what Run_StartNew does
    var _kept = RunSave_KeptFiles(_p);
    Test_False("review6 keep: the newer file is no longer at the run file's name", RunSave_ExistsAt(_p));
    Test_Eq("review6 keep: it is kept under one other name", array_length(_kept), 1);
    if (array_length(_kept) == 1) {
        Test_Eq("review6 keep: the kept file holds the newer run unchanged", Test_RawRead(_kept[0]), _newer);
        Test_True("review6 keep: the kept name is a sibling in the save folder (no path)", string_pos("/", _kept[0]) == 0 && string_pos("\\", _kept[0]) == 0 && string_pos(":", _kept[0]) == 0 && string_copy(_kept[0], 1, 21) == "test_review6_run.kept");
    }
    // the new run's first autosave (the same write Run_AutoSave makes): run.sav is the new run, the kept file is still there
    _gs.run = Run_Create(6200);
    _gs.run.gold = 31;
    _gs.selected_class = CLASS_MAGE;
    _gs.checkpoint = { room: rm_floor1, x: 48, y: 64 };
    _gs.persist = {};
    Test_True("review6 keep: the new run saves", RunSave_WriteTo(_p));
    var _nl = RunSave_LoadFrom(_p);
    Test_Eq("review6 keep: run.sav is the new run after its first save", _nl.status, "ok");
    Test_Eq("review6 keep: it is the new run's gold", is_struct(_nl.run) ? _nl.run.gold : -1, 31);
    _kept = RunSave_KeptFiles(_p);
    Test_Eq("review6 keep: the kept file is still there after the new run saved", array_length(_kept), 1);
    if (array_length(_kept) >= 1) Test_Eq("review6 keep: and still unchanged", Test_RawRead(_kept[0]), _newer);
    // a damaged file is kept the same way, and a second one gets its own name even in the same second
    Save_DeleteFileSet(_p);
    Test_RawWrite(_p, "{ this is not a run save");
    RunSave_DeleteUnlessKept(_p, undefined, true);
    _kept = RunSave_KeptFiles(_p);
    Test_False("review6 keep: the damaged file is moved off the run file's name", RunSave_ExistsAt(_p));
    Test_Eq("review6 keep: both kept files exist under different names", array_length(_kept), 2);
    var _texts = [];
    for (var _i = 0; _i < array_length(_kept); _i++) array_push(_texts, Test_RawRead(_kept[_i]));
    Test_True("review6 keep: one holds the damaged text", array_contains(_texts, "{ this is not a run save"));
    Test_True("review6 keep: the other still holds the newer run", array_contains(_texts, _newer));
    // a good run file is not "kept": it is cleared as before, and nothing is made from it
    Test_Review6DropKept(_p);
    Test_True("review6 keep: setup, a current run file", RunSave_WriteTo(_p));
    RunSave_DeleteUnlessKept(_p, undefined, true);
    Test_False("review6 keep: a current run file is cleared", RunSave_ExistsAt(_p));
    Test_Eq("review6 keep: and nothing is kept from it", array_length(RunSave_KeptFiles(_p)), 0);
    RunSave_DeleteUnlessKept(_p, undefined, true);
    Test_Eq("review6 keep: no file at all keeps nothing", array_length(RunSave_KeptFiles(_p)), 0);
    Save_DeleteFileSet(_p);
    Test_Review6DropKept(_p);
    Test_Review6Return(_b);

    // ---- 2. A version 1 profile has no skill memory, but its echo entries name skills the last run had: they become the memory ----
    var _pf = "test_review6_profile.sav";
    Save_DeleteFileSet(_pf);
    Test_RawWrite(_pf, json_stringify({
        profile_version: 1, story_seen: {}, unlocks: {}, deaths: 1,
        echo_pool: [{ kind: "skill", id: SKILL_TAKE_AIM }, { kind: "item", id: SKILL_FIREBALL }, { kind: "skill", id: SKILL_MUSCLE_UP }],
        history: []
    }));
    var _l1 = Profile_Load(_pf);
    Test_Eq("review6 v1: the old profile loads ok", _l1.status, "ok");
    Test_True("review6 v1: a skill in the echo pool is remembered (Take Aim)", Profile_SkillKnown(_l1.profile, SKILL_TAKE_AIM));
    Test_True("review6 v1: the other skill in the pool is remembered (Muscle Up)", Profile_SkillKnown(_l1.profile, SKILL_MUSCLE_UP));
    Test_False("review6 v1: an item in the pool is not a skill (id of Fireball)", Profile_SkillKnown(_l1.profile, SKILL_FIREBALL));
    var _o1 = Profile_Normalize({ profile_version: 1, echo_offer: [{ kind: "skill", id: SKILL_WOUND }] });
    Test_True("review6 v1: a skill in the old echo offer is remembered", Profile_SkillKnown(_o1, SKILL_WOUND));
    var _o2 = Profile_Normalize({ profile_version: 1, echo: { kind: "skill", id: SKILL_FIREBALL } });
    Test_True("review6 v1: a skill in the old chosen echo is remembered", Profile_SkillKnown(_o2, SKILL_FIREBALL));
    var _o3 = Profile_Normalize({ profile_version: 1, echo_pool: [{ kind: "item", id: SKILL_WOUND }] });
    Test_Eq("review6 v1: a pool of items alone gives no skill memory", array_length(variable_struct_get_names(_o3.skills_known)), 0);
    Save_DeleteFileSet(_pf);

    // ---- 3. Quit or close after the fight is decided (the enemy fell, or the escape worked) and before the map is back: the pre-fight snapshot is still there ----
    var _b3 = Test_Review6Borrow();
    var _old_pid = _gs.battle.enemy_persist_id;
    var _old_eid = _gs.battle.enemy_id;
    var _old_room = _gs.battle.enemy_room;
    var _cf = "test_review6_close.sav";
    for (var _won = 0; _won < 2; _won++) {
        var _w = (_won == 1) ? "slain" : "ran away";
        _gs.run = Run_Create(6300);
        _gs.run.gold = 5;
        var _m = CharacterCreate_Player(CLASS_MAGE);
        _m.hp = 7;
        _gs.player_ch = _m;
        _gs.selected_class = CLASS_MAGE;
        _gs.flags = {};
        _gs.checkpoint = { room: rm_floor2, x: 48, y: 64 };
        _gs.persist = {};
        RoomState_SetAlive(rm_floor2, "r6_e1");
        global.encounter_snapshot = undefined;
        EnemyPersist_SnapshotRun();   // the moment before the encounter (chests and cards taken since the last autosave are in it)
        _gs.battle.enemy_persist_id = "r6_e1";
        _gs.battle.enemy_id = 0;
        _gs.battle.enemy_room = rm_floor2;
        var _m2 = CharacterCreate_Player(CLASS_MAGE);
        _m2.hp = 3;
        _gs.player_ch = _m2;
        _gs.run.gold = 40;   // the reward
        EnemyPersist_ResolveBattle(_won == 1);
        Test_True("review6 " + _w + ": the pre-fight snapshot is still held while the message shows", EnemyPersist_HasSnapshot());
        Save_DeleteFileSet(_cf);
        Test_True("review6 " + _w + ": closing now writes a run save", Run_SaveOnClose(true, rm_battle, _cf));
        var _cl = RunSave_LoadFrom(_cf);
        Test_Eq("review6 " + _w + ": it reads back ok", _cl.status, "ok");
        Test_Eq("review6 " + _w + ": it is the moment before the encounter (the gold then)", is_struct(_cl.run) ? _cl.run.gold : -1, 5);
        Save_DeleteFileSet(_cf);
    }
    // the fade back to the map is part of "before the map is back": a close there writes the snapshot too (it is complete text, the fade does not matter to it)
    _gs.run = Run_Create(6300);
    _gs.run.gold = 5;
    var _m4 = CharacterCreate_Player(CLASS_MAGE);
    _m4.hp = 7;
    _gs.player_ch = _m4;
    _gs.flags = {};
    _gs.checkpoint = { room: rm_floor2, x: 48, y: 64 };
    _gs.persist = {};
    global.encounter_snapshot = undefined;
    EnemyPersist_SnapshotRun();
    EnemyPersist_ResolveBattle(true);
    Transition_Init();
    var _tx_was = _gs.transition_fx.active;
    _gs.transition_fx.active = true;
    var _fade_ok = Run_SaveOnClose(true, rm_battle, _cf);
    _gs.transition_fx.active = _tx_was;
    Test_True("review6 fade: closing during the fade back to the map writes the pre-fight run", _fade_ok);
    Test_Eq("review6 fade: it reads back ok", RunSave_LoadFrom(_cf).status, "ok");
    Save_DeleteFileSet(_cf);
    _gs.battle.enemy_persist_id = _old_pid;
    _gs.battle.enemy_id = _old_eid;
    _gs.battle.enemy_room = _old_room;
    Test_Review6Return(_b3);

    // ---- 4. An elite's marks do not paint over the sprite: the sprite stays under the room's darkness, only the outline and rim (drawn after it) stay bright ----
    var _names = ["slime_moving", "killer_plant_moving", "dire_wolf_moving"];
    for (var _n = 0; _n < array_length(_names); _n++) {
        var _spr = asset_get_index(_names[_n]);
        if (_spr == -1) { Test_True("review6 elite: the sprite " + _names[_n] + " exists", false); continue; }
        var _r = Test_EliteFxOverSprite(_spr, 0, UI_C_LIGHTEST);
        Test_Eq("review6 elite: " + _names[_n] + " marks paint no pixel of the sprite itself", _r.inside, 0);
        Test_True("review6 elite: " + _names[_n] + " marks still paint the outline round it (" + string(_r.outside) + " px)", _r.outside > 0);
        Test_True("review6 elite: " + _names[_n] + " outline pixels are the full pulse colour (" + string(_r.bright) + " px)", _r.bright > 0);
    }
}

// ---- Hunt 6 combat (bug hunt session 6, findings 1 to 6 in .planning/research/bughunt-session6-combat.md) ----
// Expected values come from the decisions and the tooltips, not from the code: D99 (Guard: the next hit deals half), D100 / BUG-16 (the number a tooltip shows is
// the number applied), D132 + D141 (closing the window saves the run; in a fight that is the moment just before the encounter), D74 (a fast fighter acts twice
// in a row), I-072 (an item the Stranger stole is won back by beating him).
function Test_Suite_Hunt6Combat() {
    var _gs = GameState_Get();
    ItemDB_Init(); SkillDB_Init(); StatusDB_Init(); EnemyDB_Init(); Loot_Init(); CardDB_Init();

    // ---- 1. the Esc / Tab menu in a fight is read-only for potions and gear (the battle's own ITEM command is the turn) ----
    var _k = Test_Hero(CLASS_KNIGHT);
    _k.hp = 1;
    var _used = TabItems_Use(_k, 10, true);
    Test_False("hunt6 menu: a potion is not drunk from the menu in a fight", _used.ok);
    Test_Eq("hunt6 menu: the refused potion did not heal", _k.hp, 1);
    Test_Eq("hunt6 menu: the refused potion is not spent", Inv_Count(_k.inventory, 10), 2);
    Test_Eq("hunt6 menu: the refusal says to use ITEM in the battle menu", _used.msg, Loc_T("menu.msg.items_in_fight", "In a battle, use Item in the battle menu."));
    var _outside = TabItems_Use(_k, 10);
    Test_True("hunt6 menu: outside a fight the same potion is drunk", _outside.ok);
    var _kh = CharacterCreate_Player(CLASS_KNIGHT);
    _kh.inventory = Inv_Add(_kh.inventory, 1, 1);
    Test_True("hunt6 menu: outside a fight a potion row has a Use hint", TabItems_Items(_kh, false)[0].hint != "");
    Test_True("hunt6 menu: in a fight a potion row has no Use hint", TabItems_Items(_kh, true)[0].hint == "");
    var _g = CharacterCreate_Player(CLASS_KNIGHT);
    _g.inventory = Inv_Add(_g.inventory, 1, 1);
    _g.inventory = Inv_Add(_g.inventory, 22, 1);
    Equip_Item(_g, 1);
    var _put = Gear_Toggle(_g, 22, true);
    Test_False("hunt6 menu: armor is not put on from the menu in a fight", _put.ok);
    Test_Eq("hunt6 menu: the body slot stays empty", Equip_SlotGet(_g, "body"), 0);
    Test_Eq("hunt6 menu: the refusal says gear cannot change in a fight", _put.msg, Loc_T("menu.msg.gear_in_fight", "You can't change gear during a battle."));
    var _take = Gear_Toggle(_g, 1, true);
    Test_False("hunt6 menu: the weapon is not taken off from the menu in a fight", _take.ok);
    Test_Eq("hunt6 menu: the weapon stays worn", Equip_SlotGet(_g, "weapon"), 1);
    Test_True("hunt6 menu: outside a fight armor goes on", Gear_Toggle(_g, 22).ok);

    // ---- 3. Guard (the Brace status) lasts until the player's next turn starts (D180), not through the player's own turns before the enemy acted ----
    var _slime = EnemyCreate(ENEMY_SLIME);
    var _src = { power: 6, stat_type: STAT_ATK };
    var _plain = Combat_ApplyDamage(_slime, CharacterCreate_Player(CLASS_KNIGHT), _src, 1, 1, { is_skill: false }).dmg;
    var _bp = CharacterCreate_Player(CLASS_KNIGHT);
    var _bc = Test_Hunt1Bc(_bp, EnemyCreate(ENEMY_SLIME));
    Battle_GuardApply(_bp);
    Battle_PlayerFinalizeTurn(_bc, _bc.p, _bc.e);   // the Guard turn
    Battle_PlayerFinalizeTurn(_bc, _bc.p, _bc.e);   // D74: a faster player acts again before the enemy (P P E)
    Battle_PlayerFinalizeTurn(_bc, _bc.p, _bc.e);
    Test_True("hunt6 guard: still braced after the player acted three times in a row", Status_Has(_bc.p, STATUS_BRACE));
    var _hit = Combat_ApplyDamage(_slime, _bc.p, _src, 1, 1, { is_skill: false });
    Test_True("hunt6 guard: the enemy's hit then deals about half (" + string(_plain) + " -> " + string(_hit.dmg) + ")", _plain >= 2 && abs(_hit.dmg - _plain * 0.5) <= 1);
    Test_True("hunt6 guard: that hit does not use the Brace up (D180)", Status_Has(_hit.defender, STATUS_BRACE));
    var _bp2 = CharacterCreate_Player(CLASS_KNIGHT);
    var _bc2 = Test_Hunt1Bc(_bp2, EnemyCreate(ENEMY_SLIME));
    Battle_GuardApply(_bp2);
    Test_Eq("hunt6 guard: the chip reads 1: it lasts until the player's next turn (D180)", Battle_StatusCurrentTurns(_bc2.p, STATUS_BRACE), 1);
    Battle_PlayerFinalizeTurn(_bc2, _bc2.p, _bc2.e);   // the Guard turn
    Test_True("hunt6 guard: braced when the enemy's turn comes", Status_Has(_bc2.p, STATUS_BRACE));
    _bc2.enemy_actions_remaining = 0;
    Battle_EnemyFinalizeTurnState(_bc2, _bc2.p, _bc2.e);   // the enemy spends its turn on a wind-up: no hit
    for (var _more = 0; _more < 4 && _bc2.tl_who == TL_ENEMY; _more++) {   // a faster enemy acts again first; the Brace holds for those turns
        Test_True("hunt6 guard: still braced for the enemy's next turn", Status_Has(_bc2.p, STATUS_BRACE));
        _bc2.enemy_actions_remaining = 0;
        Battle_EnemyFinalizeTurnState(_bc2, _bc2.p, _bc2.e);
    }
    Test_Eq("hunt6 guard: the player's turn is next", _bc2.tl_who, TL_PLAYER);
    Test_False("hunt6 guard: gone as the player's next turn starts, even when the enemy's turn had no hit (D180)", Status_Has(_bc2.p, STATUS_BRACE));

    // ---- 4. Take Aim and Muscle Up last as many player actions as the tooltip says (the cast turn's own tick does not count) ----
    var _tk = [[CLASS_ARCHER, SKILL_TAKE_AIM, STATUS_CRIT_UP, 9, "Take Aim"], [CLASS_KNIGHT, SKILL_MUSCLE_UP, STATUS_GUARD, 6, "Muscle Up"]];
    for (var _i = 0; _i < array_length(_tk); _i++) {
        var _n = _tk[_i][4];
        var _hero = Test_Hero(_tk[_i][0]);
        _hero.mp = 99;
        var _stated = SkillDB_Get(_tk[_i][1]).status_turns;
        Test_Eq("hunt6 " + _n + ": the tooltip number", _stated, _tk[_i][3]);
        Skill_Use(_hero, _hero, _tk[_i][1]);
        Test_Eq("hunt6 " + _n + ": applied right after the cast = the tooltip number", Battle_StatusCurrentTurns(_hero, _tk[_i][2]), _stated);
        _hero = Status_Tick(_hero);   // the cast turn's own end-of-turn tick
        Test_Eq("hunt6 " + _n + ": the cast turn does not use one up", Battle_StatusCurrentTurns(_hero, _tk[_i][2]), _stated);
        for (var _t = 1; _t < _stated; _t++) _hero = Status_Tick(_hero);
        Test_True("hunt6 " + _n + ": still on for the last of its " + string(_stated) + " turns", Status_Has(_hero, _tk[_i][2]));
        _hero = Status_Tick(_hero);
        Test_False("hunt6 " + _n + ": gone after " + string(_stated) + " turns", Status_Has(_hero, _tk[_i][2]));
    }

    // ---- 2. closing the window in a fight writes the moment just before the encounter (D141), not the older autosave ----
    var _had_run = variable_struct_exists(_gs, "run");
    var _old_run = _had_run ? _gs.run : undefined;
    var _old_cp = _gs.checkpoint;
    var _old_persist = _gs.persist;
    var _old_ch = _gs.player_ch;
    var _old_flags = _gs.flags;
    var _old_snap = variable_global_exists("encounter_snapshot") ? global.encounter_snapshot : undefined;
    _gs.run = Run_Create(6100);
    _gs.run.gold = 5;
    _gs.run.kills = 1;
    var _m = CharacterCreate_Player(CLASS_MAGE);
    _m.hp = 7;
    _m.mp = 4;
    _gs.player_ch = _m;
    _gs.selected_class = CLASS_MAGE;
    _gs.flags = {};
    _gs.checkpoint = { room: rm_floor2, x: 48, y: 64 };
    _gs.persist = {};
    RoomState_SetAlive(rm_floor2, "h6_e1");
    global.encounter_snapshot = undefined;
    EnemyPersist_SnapshotRun();
    var _m2 = CharacterCreate_Player(CLASS_MAGE);
    _m2.hp = 1;
    _m2.mp = 0;
    _gs.player_ch = _m2;
    _gs.run.gold = 99;
    var _cf = "test_hunt6_close.sav";
    Save_DeleteFileSet(_cf);
    Test_True("hunt6 close: closing the window in a fight writes a run save", Run_SaveOnClose(true, rm_battle, _cf));
    var _cl = RunSave_LoadFrom(_cf);
    Test_Eq("hunt6 close: it reads back ok", _cl.status, "ok");
    _gs.run = Run_Create(1);
    _gs.persist = {};
    if (is_struct(_cl.run)) RunSave_ApplyState(_cl.run);
    Test_Eq("hunt6 close: the saved HP is the pre-fight HP", _gs.player_ch.hp, 7);
    Test_Eq("hunt6 close: the saved MP is the pre-fight MP", _gs.player_ch.mp, 4);
    Test_Eq("hunt6 close: the saved gold is the pre-fight gold", _gs.run.gold, 5);
    Save_DeleteFileSet(_cf);
    _gs.run = Run_Create(6100);
    var _m3 = CharacterCreate_Player(CLASS_MAGE);
    _m3.hp = 0;
    _gs.player_ch = _m3;
    Test_False("hunt6 close: a dead player writes no snapshot", Run_SaveOnClose(true, rm_battle, _cf));
    Test_False("hunt6 close: and no file appears", RunSave_ExistsAt(_cf));
    global.encounter_snapshot = undefined;
    _gs.player_ch = _m2;
    Test_False("hunt6 close: a fight with no snapshot writes nothing", Run_SaveOnClose(true, rm_battle, _cf));
    Test_False("hunt6 close: and no file appears either", RunSave_ExistsAt(_cf));
    Save_DeleteFileSet(_cf);

    // ---- 5. what the Stranger stole stays recoverable when the player runs or throws a Smoke Bomb (I-072) ----
    var _bt = _gs.battle;
    var _bt0 = { pid: _bt.enemy_persist_id, eid: _bt.enemy_id, room: _bt.enemy_room };
    _gs.persist = {};
    _gs.run = Run_Create(6101);
    _gs.run.drop_dry = 10;
    _bt.enemy_persist_id = "h6_str";
    _bt.enemy_id = ENEMY_STRANGER;
    _bt.enemy_room = rm_floor2;
    RoomState_SetAlive(rm_floor2, "h6_str");
    var _str = EnemyCreate(ENEMY_STRANGER);
    _str = Skill_StealRecord(_str, 10, 1);
    EnemyPersist_ResolveBattle(false, _str.stolen_items);   // the player got away
    var _rec = RoomState_Get(rm_floor2, "h6_str");
    Test_True("hunt6 steal: the Stranger is still on the map after the escape", is_struct(_rec) && !Test_FieldOr(_rec, "removed", false));
    var _kept = Test_FieldOr(_rec, "stolen_items", []);
    Test_Eq("hunt6 steal: he still holds what he took", array_length(_kept), 1);
    Test_Eq("hunt6 steal: it is the potion", (array_length(_kept) > 0) ? _kept[0].id : -1, 10);
    // the next fight with him: the item is on him again, a win gives it back
    var _str2 = EnemyCreate(ENEMY_STRANGER);
    EnemyPersist_RestoreStolen(_str2);
    Test_Eq("hunt6 steal: the next fight starts with it on him", array_length(Test_FieldOr(_str2, "stolen_items", [])), 1);
    EnemyPersist_ResolveBattle(false, Test_FieldOr(_str2, "stolen_items", []));   // a second escape
    Test_Eq("hunt6 steal: a second escape does not copy it", array_length(Test_FieldOr(RoomState_Get(rm_floor2, "h6_str"), "stolen_items", [])), 1);
    var _kn = Test_Hero(CLASS_KNIGHT);
    var _have = Inv_Count(_kn.inventory, 10);
    var _rw = Battle_GrantRewards(_kn, _str2);
    Test_True("hunt6 steal: beating him gives the potion back", Inv_Count(_rw.player.inventory, 10) >= _have + 1);
    EnemyPersist_ResolveBattle(true);
    var _gone = RoomState_Get(rm_floor2, "h6_str");
    Test_True("hunt6 steal: once he is beaten the record holds no loot", Test_FieldOr(_gone, "removed", false) && array_length(Test_FieldOr(_gone, "stolen_items", [])) == 0);
    // leaving the room and coming back rebuilds the enemy's record from the instance: the loot is carried over
    RoomState_SetAlive(rm_floor2, "h6_str");
    EnemyPersist_ResolveBattle(false, [{ id: 31, qty: 2 }]);
    var _carried = RoomState_CarryStolen(rm_floor2, "h6_str", { removed: false, vars: {} });
    Test_Eq("hunt6 steal: a rebuilt record keeps the loot", array_length(Test_FieldOr(_carried, "stolen_items", [])), 1);
    // either way out of the fight settles the same: the loot is kept and the Stranger's first-meeting line is queued
    _gs.flags = {};
    RoomState_SetAlive(rm_floor2, "h6_str");
    Battle_EscapeResolve(_str);
    Test_Eq("hunt6 steal: the escape helper keeps the loot", array_length(Test_FieldOr(RoomState_Get(rm_floor2, "h6_str"), "stolen_items", [])), 1);
    Test_True("hunt6 steal: a Smoke Bomb escape queues the Stranger's reaction too", Dialogue_NarrativeIsPending("first_stranger_encounter_reaction"));
    _gs.flags = {};
    Battle_EscapeResolve(EnemyCreate(ENEMY_SLIME));
    Test_False("hunt6 steal: running from a slime queues no Stranger line", Dialogue_NarrativeIsPending("first_stranger_encounter_reaction"));

    _bt.enemy_persist_id = _bt0.pid;
    _bt.enemy_id = _bt0.eid;
    _bt.enemy_room = _bt0.room;
    global.encounter_snapshot = _old_snap;
    if (_had_run) _gs.run = _old_run; else variable_struct_remove(_gs, "run");
    _gs.checkpoint = _old_cp;
    _gs.persist = _old_persist;
    _gs.player_ch = _old_ch;
    _gs.flags = _old_flags;
}

// ---- Hunt 6 menus, UI and input (bug hunt session 6, findings 1 to 5 in .planning/research/bughunt-session6-ui.md) ----
// Expected values come from the decisions, not from the code: D140 (Esc / Tab / Start open the one menu and Esc is Back inside it, the pad's Y is its Esc, window changes
// revert unless confirmed), D95 (Back works the same everywhere, pad included), D99 / hunt 6 combat (the menu in a fight is read-only and says what to do instead).
function Test_Suite_Hunt6Ui() {
    // ---- 1. a menu press while the player is mid-step is kept for a short window and opens the menu on the first settled frame ----
    var _b = MenuOpenBuf_New();
    Test_True("hunt6ui buffer: a press on a settled frame opens at once", MenuOpenBuf_Step(_b, 1000, 10, true, true, true));
    _b = MenuOpenBuf_New();
    Test_False("hunt6ui buffer: a press mid-step does not open yet", MenuOpenBuf_Step(_b, 1000, 10, true, true, false));
    Test_False("hunt6ui buffer: still mid-step next frame", MenuOpenBuf_Step(_b, 1016, 11, false, true, false));
    Test_True("hunt6ui buffer: it opens on the first settled frame", MenuOpenBuf_Step(_b, 1033, 12, false, true, true));
    Test_False("hunt6ui buffer: the request is used once", MenuOpenBuf_Step(_b, 1050, 13, false, true, true));
    _b = MenuOpenBuf_New();
    MenuOpenBuf_Step(_b, 1000, 10, true, true, false);
    Test_False("hunt6ui buffer: a request older than the window is forgotten", MenuOpenBuf_Step(_b, 1000 + MENU_OPEN_BUFFER_MS + 1, 11, false, true, true));
    Test_True("hunt6ui buffer: the window covers a whole walking step (16 frames = 267 ms)", MENU_OPEN_BUFFER_MS >= 267);
    _b = MenuOpenBuf_New();
    MenuOpenBuf_Step(_b, 1000, 10, true, true, false);
    MenuOpenBuf_Step(_b, 1016, 11, false, false, false);   // a dialogue or a menu took over for a frame
    Test_False("hunt6ui buffer: a request is dropped when the map was not free", MenuOpenBuf_Step(_b, 1033, 12, false, true, true));
    _b = MenuOpenBuf_New();
    MenuOpenBuf_Step(_b, 1000, 10, true, true, false);
    Test_False("hunt6ui buffer: frames the controller skipped (a transition, a pop-up) drop it", MenuOpenBuf_Step(_b, 1100, 15, false, true, true));
    _b = MenuOpenBuf_New();
    MenuOpenBuf_Step(_b, 1000, 10, true, false, false);   // pressed in a dialogue or a battle transition: nothing to keep
    Test_False("hunt6ui buffer: a press when the map is not free is not kept", MenuOpenBuf_Step(_b, 1016, 11, false, true, true));

    // ---- 2. a pad cancels the Controls page's "Press a key..." (Back, X / Start or Y); a keyboard X is a key to bind, never a cancel ----
    Test_True("hunt6ui capture: pad Back cancels", Controls_CaptureCancel("gamepad", true, false, false));
    Test_True("hunt6ui capture: pad Start / X cancels", Controls_CaptureCancel("gamepad", false, true, false));
    Test_True("hunt6ui capture: pad Y cancels", Controls_CaptureCancel("gamepad", false, false, true));
    Test_False("hunt6ui capture: nothing pressed cancels nothing", Controls_CaptureCancel("gamepad", false, false, false));
    Test_False("hunt6ui capture: the keyboard's X is a key to bind, not a cancel", Controls_CaptureCancel("keyboard", true, false, false));
    Test_False("hunt6ui capture: the keyboard's menu key is not a cancel here", Controls_CaptureCancel("keyboard", false, true, true));
    Test_True("hunt6ui capture: the prompt on a pad names the Back button", string_pos("[k:back]", Controls_WaitingText("Confirm", "gamepad")) > 0);
    Test_True("hunt6ui capture: the prompt on a keyboard still says Esc", string_pos("Esc", Controls_WaitingText("Confirm", "keyboard")) > 0);
    Test_True("hunt6ui capture: the prompt names the action", string_pos("Confirm", Controls_WaitingText("Confirm", "gamepad")) > 0);

    // ---- 3. Esc stays Back when Back is rebound (it is reserved, so no other row can take it) ----
    var _bk = Binds_Assign(Binds_Defaults(), "back", vk_backspace);
    Test_True("hunt6ui back: Back can be rebound to Backspace", _bk.ok);
    var _act = Binds_ToActions(_bk.keys);
    Test_Eq("hunt6ui back: the player's key is first", _act.cancel[0], vk_backspace);
    Test_True("hunt6ui back: Esc still works as Back", array_contains(_act.cancel, vk_escape));
    Test_True("hunt6ui back: the second Back key stays", array_contains(_act.cancel, ord("X")));
    var _dact = Binds_ToActions(Binds_Defaults());
    var _esc_n = 0;
    for (var _i = 0; _i < array_length(_dact.cancel); _i++) if (_dact.cancel[_i] == vk_escape) _esc_n++;
    Test_Eq("hunt6ui back: with the defaults Esc is there once", _esc_n, 1);
    Test_True("hunt6ui back: the Controls page still shows the player's own keys, not Esc", Test_SameArray(_bk.keys.back, [vk_backspace, ord("X")]));

    // ---- 4. the "Keep this?" prompt is not answered by the second click of a double click ----
    Test_False("hunt6ui keep: a click 100 ms after the change does not answer", KeepThis_AnswerReady(1000, 1100, false));
    Test_False("hunt6ui keep: nor one 350 ms after (a slow double click)", KeepThis_AnswerReady(1000, 1350, false));
    Test_True("hunt6ui keep: one after the lock does", KeepThis_AnswerReady(1000, 1000 + KEEP_THIS_ANSWER_LOCK_MS + 10, false));
    Test_False("hunt6ui keep: never while the window is still changing", KeepThis_AnswerReady(1000, 9000, true));
    var _rect = { x: 40, y: 50, w: 100, h: 60 };
    Test_True("hunt6ui keep: a click inside the box answers", KeepThis_ClickOk(_rect, 60, 70));
    Test_False("hunt6ui keep: a click outside the box does not", KeepThis_ClickOk(_rect, 10, 10));
    Test_False("hunt6ui keep: a click when the box was never drawn does not", KeepThis_ClickOk({ x: -1, y: -1, w: 0, h: 0 }, 0, 0));

    // ---- 5. the Items tab in a fight says the read-only reason for a throwable too, not the map's throw text ----
    ItemDB_Init();
    var _ch = CharacterCreate_Player(CLASS_KNIGHT);
    _ch.inventory = Inv_Add(_ch.inventory, 30, 1);
    var _rows = TabItems_Items(_ch, true);
    var _row = undefined;
    for (var _r = 0; _r < array_length(_rows); _r++) if (variable_struct_exists(_rows[_r], "throwable") && _rows[_r].throwable) _row = _rows[_r];
    Test_True("hunt6ui items: the bag lists the Firebomb as a throwable", is_struct(_row));
    if (is_struct(_row)) {
        var _fight = TabItems_Press(_ch, _row, true);
        Test_False("hunt6ui items: nothing is thrown from the menu in a fight", _fight.ok);
        Test_Eq("hunt6ui items: in a fight the throwable row says the read-only reason", _fight.msg, Loc_T("menu.msg.items_in_fight", "In a fight, use ITEM in the battle menu."));
        var _map = TabItems_Press(_ch, _row, false);
        Test_Eq("hunt6ui items: on the map the throwable row still says to throw it in a battle", _map.msg, Loc_T("item.msg.throw_in_battle", "Throw it at an enemy in battle."));
        Test_Eq("hunt6ui items: the Firebomb is not spent either way", Inv_Count(_ch.inventory, 30), 1);
    }
}

// ============================================================================================================================
// Bug hunt session 7: progression (a Nobody's loot, potion numbers, a throwable at its cap, a multi-level level-up prompt)
// ============================================================================================================================
function Test_Hunt7IsGear(_item_id) {
    var _it = ItemDB_Get(_item_id);
    return is_struct(_it) && (_it.type == ITEM_WEAPON || _it.type == ITEM_ARMOR);
}

function Test_Hunt7CountGear(_loot) {
    var _n = 0;
    for (var _i = 0; _i < array_length(_loot); _i++) if (Test_Hunt7IsGear(_loot[_i].item_id)) _n++;
    return _n;
}

function Test_Suite_Hunt7Prog() {
    ItemDB_Init();
    var _gs = Test_FixBegin(DIFFICULTY_NORMAL);
    var _had_run = variable_struct_exists(_gs, "run");
    var _run0 = _had_run ? _gs.run : undefined;

    // ---- 1. P2: a Nobody that has chosen (it stays Nobody) is never offered a weapon or armor it cannot wear ----
    var _nb = CharacterCreate_Player(CLASS_NOBODY);
    _nb.class_chosen = true;
    var _pre = CharacterCreate_Player(CLASS_NOBODY);
    _pre.class_chosen = false;   // the run's start, before the class chest: it will become a class that can wear gear
    var _kn1 = CharacterCreate_Player(CLASS_KNIGHT);
    Test_False("h7prog gear: a Nobody is not eligible for a Wooden Sword", Loot_ItemEligibleForPlayer(1, _nb));
    Test_False("h7prog gear: a Nobody is not eligible for Leather Armor", Loot_ItemEligibleForPlayer(20, _nb));
    Test_False("h7prog gear: nor for a Cloth Robe", Loot_ItemEligibleForPlayer(23, _nb));
    Test_True("h7prog gear: a Nobody can still be given a potion", Loot_ItemEligibleForPlayer(10, _nb));
    Test_True("h7prog gear: and a ring (anyone wears it)", Loot_ItemEligibleForPlayer(40, _nb));
    Test_True("h7prog gear: the Nobody before the class chest is still offered gear (it becomes a class)", Loot_ItemEligibleForPlayer(1, _pre));
    Test_True("h7prog gear: a Knight is still offered Knight gear", Loot_ItemEligibleForPlayer(1, _kn1));
    Test_False("h7prog gear: and not Mage gear", Loot_ItemEligibleForPlayer(7, _kn1));
    _gs.player_ch = _nb;
    var _gear_nb = 0, _empty_nb = 0, _gear_pre = 0, _gear_kn = 0, _gear_barrel = 0;
    for (var _sd = 1; _sd <= 90; _sd++) {
        for (var _lv = 1; _lv <= 3; _lv++) {
            var _room = "rm_floor" + string(1 + (_sd mod 9));
            var _lt = Shuffle_ChestLoot(_sd, _room, "q" + string(_sd), _lv, "chest_basic", _nb);
            if (array_length(_lt) < 1) _empty_nb++;
            _gear_nb += Test_Hunt7CountGear(_lt);
            _gear_pre += Test_Hunt7CountGear(Shuffle_ChestLoot(_sd, _room, "q" + string(_sd), _lv, "chest_basic", _pre));
            _gear_kn += Test_Hunt7CountGear(Shuffle_ChestLoot(_sd, _room, "q" + string(_sd), _lv, "chest_basic", _kn1));
            _gear_barrel += Test_Hunt7CountGear(Shuffle_ChestLoot(_sd, _room, "b" + string(_sd), _lv, "barrel_basic", _nb));
        }
    }
    Test_Eq("h7prog gear: 270 chests of a chosen Nobody hold no weapon or armor", _gear_nb, 0);
    Test_Eq("h7prog gear: and none of them is empty (the draw falls back to a usable item)", _empty_nb, 0);
    Test_Eq("h7prog gear: 270 barrels of a chosen Nobody hold no weapon or armor", _gear_barrel, 0);
    Test_True("h7prog gear: the Nobody before its class chest still finds gear", _gear_pre > 0);
    Test_True("h7prog gear: a Knight still finds gear", _gear_kn > 0);
    var _rg = Rng_New(77, "h7enemy");
    var _e_gear = 0, _e_none = 0, _e_t23 = 0;
    for (var _i = 0; _i < 360; _i++) {
        var _eit = Loot_RollFromTable("enemy", 1 + (_i mod 3), _nb, CLASS_NOBODY, [], _rg);
        if (!is_struct(_eit)) { _e_none++; continue; }
        if (Test_Hunt7IsGear(_eit.item_id)) _e_gear++;
        if (_eit.item_id == 14 || _eit.item_id == 17) _e_t23++;
    }
    Test_Eq("h7prog gear: 360 enemy drops of a chosen Nobody hold no gear", _e_gear, 0);
    Test_Eq("h7prog gear: and none rolls nothing", _e_none, 0);
    Test_True("h7prog gear: the rarity tier is still rolled first (middle-tier potions still drop)", _e_t23 > 0);
    var _c3 = 0;
    for (var _j = 0; _j < 300; _j++) {
        var _cit = Loot_RollFromTable("chest", 3, _nb, CLASS_NOBODY, [], _rg);
        if (is_struct(_cit) && (_cit.item_id == 15 || _cit.item_id == 18)) _c3++;
    }
    Test_True("h7prog gear: the top tier still shows for a Nobody (a Lv3 potion when the gear is filtered out)", _c3 > 0);
    _gs.run = Run_Create(7);
    var _g_gear = 0, _g_none = 0;
    for (var _k = 0; _k < 80; _k++) {
        var _gl = GraveLoot_RollTierItem(2 + (_k mod 2), CLASS_NOBODY, _nb);
        if (array_length(_gl) < 1) _g_none++;
        _g_gear += Test_Hunt7CountGear(_gl);
    }
    Test_Eq("h7prog gear: 80 grave rewards of a chosen Nobody hold no gear", _g_gear, 0);
    Test_Eq("h7prog gear: and none is empty", _g_none, 0);

    // ---- 2. P3: the map Items tab, the shop and the echo show the number a potion will heal, not the base ----
    var _kn = CharacterCreate_Player(CLASS_KNIGHT);
    _kn.level = 5;
    _kn.inventory = Inv_Add(_kn.inventory, 10, 1);
    _gs.player_ch = _kn;
    var _hp1 = ItemDB_Get(10);
    Test_Eq("h7prog potion: an HP Potion Lv1 at level 5 heals 8 + 4 = 12", Item_ComputeAmount(_kn, _hp1.use), 12);
    Test_Eq("h7prog potion: its sentence says 12", Item_Sentence(_hp1, _kn), "Restores 12 [t]HP[/t].");
    Test_Eq("h7prog potion: its number line says 12", Item_NumberLines(_hp1, _kn)[0].value, "12");
    Test_Eq("h7prog potion: with no character the sentence keeps the base number", Item_Sentence(_hp1), "Restores 8 [t]HP[/t].");
    var _irow = undefined;
    var _irows = TabItems_Items(_kn, false);
    for (var _r = 0; _r < array_length(_irows); _r++) if (_irows[_r].item_id == 10) _irow = _irows[_r];
    Test_True("h7prog potion: the Items tab lists the potion", is_struct(_irow));
    if (is_struct(_irow)) {
        Test_Eq("h7prog potion: the Items tab sentence says 12", _irow.help, "Restores 12 [t]HP[/t].");
        Test_Eq("h7prog potion: the Items tab number says 12", _irow.lines[0].value, "12");
    }
    var _srow = ShopUi_ItemFor({ kind: "item", id: 10, qty: 3, price: 10 }, _kn, 50);
    Test_Eq("h7prog potion: the shop sentence says 12", _srow.help, "Restores 12 [t]HP[/t].");
    Test_Eq("h7prog potion: the shop number says 12", _srow.lines[0].value, "12");
    var _echo = CardsUi_EchoDetails({ kind: "item", id: 10 });
    Test_Eq("h7prog potion: the echo panel says 12", _echo.sentence, "Restores 12 [t]HP[/t].");
    var _t1 = variable_clone(_kn); _t1.hp = 1; _t1.max_hp = 99;
    Item_Use(10, _kn, _t1);
    Test_Eq("h7prog potion: using it heals exactly the number that was shown", _t1.hp - 1, real(Item_NumberLines(_hp1, _kn)[0].value));
    _kn.passives = ["pas:potion_lore"];   // +15%
    Test_Eq("h7prog potion: with Potion Lore it heals round(12 x 1.15) = 14", Item_ComputeAmount(_kn, _hp1.use), 14);
    Test_Eq("h7prog potion: and the number line says 14", Item_NumberLines(_hp1, _kn)[0].value, "14");
    var _t2 = variable_clone(_kn); _t2.hp = 1; _t2.max_hp = 99;
    Item_Use(10, _kn, _t2);
    Test_Eq("h7prog potion: and it heals 14", _t2.hp - 1, 14);
    var _kn9 = CharacterCreate_Player(CLASS_KNIGHT);
    _kn9.level = 9;
    var _hp3 = ItemDB_Get(15);
    Test_Eq("h7prog potion: an HP Potion Lv3 at level 9 heals 28 + floor(8 x 1.2) = 37", Item_ComputeAmount(_kn9, _hp3.use), 37);
    Test_Eq("h7prog potion: the shop number says 37", ShopUi_ItemFor({ kind: "item", id: 15, qty: 1, price: 40 }, _kn9, 99).lines[0].value, "37");
    var _mp1 = ItemDB_Get(11);
    Test_Eq("h7prog potion: an MP Potion's number line is what it restores at level 9", Item_NumberLines(_mp1, _kn9)[0].value, string(Item_ComputeAmount(_kn9, _mp1.use)));
    var _kn1b = CharacterCreate_Player(CLASS_KNIGHT);
    Test_Eq("h7prog potion: at level 1 the number is still the base 8", Item_NumberLines(_hp1, _kn1b)[0].value, "8");

    // ---- 3. P3: a chest, drop or grave never rolls a throwable that is already at its stack cap (no "x0") ----
    var _kt = CharacterCreate_Player(CLASS_KNIGHT);
    _gs.player_ch = _kt;
    var _base_inv = variable_clone(_kt.inventory);
    var _cap = Throw_Cap(_kt);
    _kt.inventory = Inv_Add(variable_clone(_base_inv), 33, _cap);
    Test_Eq("h7prog cap: (setup) the Knight holds a full stack of Smoke Bombs", Inv_Count(_kt.inventory, 33), _cap);
    Test_False("h7prog cap: a full stack of Smoke Bombs is not eligible", Loot_ItemEligibleForPlayer(33, _kt));
    Test_True("h7prog cap: another throwable is", Loot_ItemEligibleForPlayer(30, _kt));
    _kt.inventory = Inv_Add(variable_clone(_base_inv), 33, _cap - 1);
    Test_True("h7prog cap: one short of the cap is still eligible", Loot_ItemEligibleForPlayer(33, _kt));
    var _zero = 0, _hits = 0, _empty = 0, _over = 0;
    for (var _s2 = 1; _s2 <= 400; _s2++) {
        var _fl = 1 + (_s2 mod 3);
        var _thr = Loot_FloorExtras(_s2, _fl)[0].item_id;
        _kt.inventory = Inv_Add(variable_clone(_base_inv), _thr, _cap);
        var _cl = Shuffle_ChestLoot(_s2, "rm_floor" + string(_fl), "t" + string(_s2), 1 + (_s2 mod 3), "chest_basic", _kt);
        if (array_length(_cl) < 1) _empty++;
        for (var _m = 0; _m < array_length(_cl); _m++) if (_cl[_m].item_id == _thr) _hits++;
        _kt.inventory = Loot_Grant(_kt.inventory, _cl);
        for (var _m2 = 0; _m2 < array_length(_cl); _m2++) if (_cl[_m2].qty <= 0) _zero++;
        if (Inv_Count(_kt.inventory, _thr) > _cap) _over++;
    }
    Test_Eq("h7prog cap: 400 chests never roll the throwable the player holds a full stack of", _hits, 0);
    Test_Eq("h7prog cap: no chest line has a zero quantity", _zero, 0);
    Test_Eq("h7prog cap: no chest is empty", _empty, 0);
    Test_Eq("h7prog cap: the stack never goes over the cap", _over, 0);
    _gs.run = Run_Create(9);
    _kt.inventory = Inv_Add(Inv_Add(variable_clone(_base_inv), 33, _cap), 30, _cap);   // the only throwables the enemy table has
    var _d_thr = 0, _d_none = 0, _d_dry_wrong = 0;
    for (var _n = 0; _n < 200; _n++) {
        _gs.run.drop_dry = 10;   // the drop chance is 100%
        var _drop = Loot_RollEnemy({ id: ENEMY_SLIME, level: 1, loot_key: "enemy_basic" });
        if (array_length(_drop) < 1) { _d_none++; continue; }
        if (_drop[0].item_id == 33 || _drop[0].item_id == 30) _d_thr++;
        if (_gs.run.drop_dry != 0) _d_dry_wrong++;
    }
    Test_Eq("h7prog cap: 200 enemy drops never roll a throwable at its cap", _d_thr, 0);
    Test_Eq("h7prog cap: and a sure drop is never lost to it", _d_none, 0);
    Test_Eq("h7prog cap: every received drop resets the dry-fight counter", _d_dry_wrong, 0);
    var _b_zero = 0, _b_over = 0;
    var _inv4 = Inv_Add(Inv_Add(variable_clone(_base_inv), 33, _cap - 1), 30, _cap - 1);
    for (var _s3 = 1; _s3 <= 300; _s3++) {
        _kt.inventory = variable_clone(_inv4);
        var _bl = Loot_RollContainer(1, "enemy_boss", Rng_New(_s3, "h7boss"), undefined, _kt);   // a boss leaves two items
        _kt.inventory = Loot_Grant(_kt.inventory, _bl);
        for (var _m3 = 0; _m3 < array_length(_bl); _m3++) if (_bl[_m3].qty <= 0) _b_zero++;
        if (Inv_Count(_kt.inventory, 33) > _cap || Inv_Count(_kt.inventory, 30) > _cap) _b_over++;
    }
    Test_Eq("h7prog cap: a two-item drop never shows a zero line when the first item fills the stack", _b_zero, 0);
    Test_Eq("h7prog cap: and never goes over the cap", _b_over, 0);

    // ---- 4. P3: a level-up that gives several levels steps through each level's growth (D143) ----
    _gs.run = Run_Create(31);
    var _lvn = CharacterCreate_Player(CLASS_NOBODY);
    _lvn = Player_AddExp(_lvn, Exp_NextLevel(1) + Exp_NextLevel(2));
    Test_True("h7prog levelup: (setup) one fight owes the Nobody two levels (D177: he is still level 1 until the screens are answered)", _lvn.level == 1 && _lvn.levels_owed == 2);
    _gs.player_ch = _lvn;
    var _m1 = CardsUi_StatMenu();
    Test_Eq("h7prog levelup: the first prompt is level 2", _m1.layout.title, "Level 2: Place 1 Point");
    Test_Eq("h7prog levelup: with level 2's growth rows gold (ATK, SPD, VIG, MND)", Test_LvGoldRows(_m1), "ATK,SPD,VIG,MND");
    _lvn = Cards_PlaceStat(_lvn, STAT_ATK);
    _gs.player_ch = _lvn;
    var _m2 = CardsUi_StatMenu();
    Test_Eq("h7prog levelup: the second prompt is level 3", _m2.layout.title, "Level 3: Place 1 Point");
    Test_Eq("h7prog levelup: with level 3's growth rows gold (DEF, MAG, VIG, MND)", Test_LvGoldRows(_m2), "DEF,MAG,VIG,MND");
    var _lvk = CharacterCreate_Player(CLASS_KNIGHT);
    _lvk = Player_AddExp(_lvk, Exp_NextLevel(1) + Exp_NextLevel(2) + Exp_NextLevel(3));
    _gs.player_ch = _lvk;
    var _ttl = [];
    for (var _p = 0; _p < 3; _p++) {
        array_push(_ttl, CardsUi_StatMenu().layout.title);
        _lvk = Cards_PlaceStat(_lvk, STAT_ATK);
        _gs.player_ch = _lvk;
    }
    Test_Eq("h7prog levelup: three levels give three prompts, levels 2, 3 and 4", _ttl[0] + "|" + _ttl[1] + "|" + _ttl[2], "Level 2: Place 1 Point|Level 3: Place 1 Point|Level 4: Place 1 Point");
    var _single = CharacterCreate_Player(CLASS_KNIGHT);
    _single.level = 6;
    _single.stat_points = 0;
    _gs.player_ch = _single;
    Test_Eq("h7prog levelup: with no point owed the prompt falls back to the current level", CardsUi_StatMenu().layout.title, "Level 6: Place 1 Point");

    if (_had_run) _gs.run = _run0; else variable_struct_remove(_gs, "run");
}
// ============================================================================================================================
// H13b (D156): the "text fits" suite. Every workbook row of the known card / plate / list types goes through the fit helper (UiFit_Check and the draws'
// own pure layout functions) at 480 x 432, 640 x 576 and 800 x 720, in English and in Korean. A failure names the row, what it needs and what it has.
// ============================================================================================================================
function TextFit_Begin() {
    var _s = { lang0: Loc_GetLanguage(), disp0: (variable_global_exists("display") ? global.display : undefined), own: false, f0: draw_get_font() };
    if (!(is_struct(_s.disp0) && is_struct(_s.disp0.layout))) {
        _s.own = true;
        global.display = { layout: Display_CalcLayout(480, 432), apply_count: 0, frame: 0 };
    }
    _s.layout0 = global.display.layout;
    return _s;
}

function TextFit_Set(_w, _h, _lang) {
    Loc_SetLanguage(_lang);
    global.display.layout = Display_CalcLayout(_w, _h);
    UI_SetFont();
    Ui_Metrics();
}

function TextFit_End(_s) {
    global.display.layout = _s.layout0;
    Loc_SetLanguage(_s.lang0);
    if (_s.own) global.display = _s.disp0;
    draw_set_font(_s.f0);
}

function TextFit_Sizes() {
    return [[480, 432], [640, 576], [800, 720]];
}

// The rows that no layout can fit and that the text side has to shorten (reported with the packet; each is listed with what it needs). A failure that matches an
// entry (the assertion's name ends with `where`, the failure text holds `has`) is not reported; every entry must still match something, so the day the text is
// shortened the entry is deleted from here. Nothing else may fail.
function TextFit_Known() {
    return [];   // R-106: nothing is left for the text side; every skill, passive and card name is shown in full (wrapped, or in a wider column)
}

// _fn(_w, _h, _lang) -> an array of failure texts; one assertion per picture size and language, named _name.
function TextFit_Each(_name, _fn) {
    var _s = TextFit_Begin();
    var _sizes = TextFit_Sizes();
    var _langs = ["en", "ko"];
    var _known = TextFit_Known();
    if (!variable_global_exists("textfit_known_hits")) global.textfit_known_hits = array_create(array_length(_known), 0);
    for (var _i = 0; _i < array_length(_sizes); _i++) {
        for (var _j = 0; _j < array_length(_langs); _j++) {
            TextFit_Set(_sizes[_i][0], _sizes[_i][1], _langs[_j]);
            var _all = _fn(_sizes[_i][0], _sizes[_i][1], _langs[_j]);
            var _label = _name + " " + string(_sizes[_i][0]) + "x" + string(_sizes[_i][1]) + " " + _langs[_j];
            var _fails = [];
            for (var _f = 0; _f < array_length(_all); _f++) {
                var _is_known = false;
                for (var _k = 0; _k < array_length(_known); _k++) {
                    if (_known[_k].where == _label && string_pos(_known[_k].has, _all[_f]) > 0) {
                        _is_known = true;
                        global.textfit_known_hits[_k]++;
                    }
                }
                if (!_is_known) array_push(_fails, _all[_f]);
            }
            var _txt = "";
            for (var _m = 0; _m < min(5, array_length(_fails)); _m++) _txt += ((_m > 0) ? "; " : "") + _fails[_m];
            if (array_length(_fails) > 5) _txt += "; +" + string(array_length(_fails) - 5) + "x";
            Test_Eq("H13b fit " + _label, _txt, "");
        }
    }
    TextFit_End(_s);
}

// A wrapped block of text in a column _w wide. The text may use the 2p of padding between the column and the frame's fill (it stays inside the frame, which is
// what the scripted runs check); a word wider than that is a failure.
function TextFit_Block(_fails, _what, _txt, _w, _p) {
    var _c = UiFit_Check(_txt, _w + 2 * _p, -1, true);
    if (!_c.ok) array_push(_fails, _what + " '" + string_copy(string(_txt), 1, 24) + "' " + string(_c.w) + ">" + string(_w));
}

// One line of text in a room _room wide, no wrapping. Pushes a failure text when it does not fit.
function TextFit_Line(_fails, _what, _txt, _room) {
    var _c = UiFit_Check(_txt, _room, -1, false);
    if (!_c.ok) array_push(_fails, _what + " '" + string(_txt) + "' " + string(_c.w) + ">" + string(_room));
}

// R-106: one list row's label in a panel _panel_w wide, laid out the way the draw does (Ui_RowFit): on one line, wrapped over at most two lines (a smaller type step for
// one too-wide word), or with its value on a line under it. Pushes a failure text when no layout fits it. Returns the layout.
function TextFit_Row(_fails, _what, _label, _val, _panel_w, _p, _icon_px, _icon_item, _mt) {
    var _r = Ui_RowFit(_label, _val, _panel_w, _p, _icon_px, _icon_item, true, _mt);
    if (!_r.ok) array_push(_fails, _what + " '" + string(_label) + "' fits no layout: " + string(UI_TextWidth(_label)) + ">" + string(_r.room));
    else if (_r.lines > 2) array_push(_fails, _what + " '" + string(_label) + "' takes " + string(_r.lines) + " lines");
    return _r;
}

// R-106: a menu title in the panel's inner width _room, laid out the way the draw does (Ui_TitleFit): wrapped over at most two lines.
function TextFit_Title(_fails, _what, _title, _room, _mt) {
    var _t = Ui_TitleFit(_title, _room, _mt);
    if (_t.w > _room) array_push(_fails, _what + " '" + string(_title) + "' needs " + string(_t.w) + " has " + string(_room));
    else if (_t.lines > 2) array_push(_fails, _what + " '" + string(_title) + "' takes " + string(_t.lines) + " lines");
}

// The rows of a Tab page against its list and details panels (the draw's own widths: TabMenu_Zones, TabMenu_Widths, Ui_MenuLabelRoom, Ui_DetailsHeight).
function TextFit_TabPage(_fails, _tid, _rows, _title, _cols = 1) {
    var _z = TabMenu_Zones(_tid);
    var _mt = _z.mt;
    var _p = _mt.p;
    var _m = Ui_MenuNew("fit_" + _tid, _rows, { layout: { title: _title, anchor: "center", details: true, details_pos: "right", details_cols: _cols, det_art: true, hides_below: true } });
    var _mc = Ui_MenuMeasureRowsFresh(_m, _mt);
    var _wd = TabMenu_Widths(_z, Ui_MenuListNeed(_mc, _p), _mc.det_need);
    if (_wd.list_w + _wd.det_w > _z.list_w + _z.det_w) array_push(_fails, _tid + " widths " + string(_wd.list_w) + "+" + string(_wd.det_w) + " exceed the body " + string(_z.list_w + _z.det_w));
    TextFit_Title(_fails, _tid + " title", _title, _wd.list_w - 8 * _p, _mt);
    var _inner = _wd.det_w - 8 * _p;
    var _col_w = (_inner - (_cols - 1) * 3 * _p) / _cols;
    for (var _i = 0; _i < array_length(_rows); _i++) {
        var _r = _rows[_i];
        var _val = variable_struct_exists(_r, "value") ? _r.value : "";
        if (variable_struct_get(_r, "kind") != "head") {
            var _rf = TextFit_Row(_fails, _tid + " row", _r.label, _val, _wd.list_w, _p, _mc.icon_px, variable_struct_exists(_r, "icon_item"), _mt);
            if (_rf.row_h > _z.body_h - 8 * _p) array_push(_fails, _tid + " row '" + string(_r.label) + "' is " + string(_rf.row_h) + " tall in a list " + string(_z.body_h) + " tall");
        }
        if (!variable_struct_exists(_r, "help") || _r.help == "") continue;
        var _lines = variable_struct_exists(_r, "lines") ? _r.lines : [];
        for (var _l = 0; _l < array_length(_lines); _l++) {
            TextFit_Line(_fails, _tid + " line value", _lines[_l].value, _col_w + 2 * _p);   // a label that does not fit with its value goes over it, a label wider than the column wraps
            if (UI_TextWidth(_lines[_l].label) > _col_w) TextFit_Block(_fails, _tid + " line label", _lines[_l].label, _col_w, _p);
        }
        var _dh = Ui_DetailsHeight(_wd.det_w, _r.help, _lines, _cols, variable_struct_exists(_r, "seq") ? array_length(_r.seq) : 0, _r);
        // Ui_DetailsHeight keeps 4p under the last line; the text may use 2p of it (it stays inside the frame's fill, which the scripted runs check)
        if (_dh - 2 * _p > _z.body_h) array_push(_fails, _tid + " details of '" + string(_r.label) + "' need " + string(_dh) + " have " + string(_z.body_h) + " (list " + string(_wd.list_w) + " of " + string(Ui_MenuListNeed(_mc, _p)) + " asked, details " + string(_wd.det_w) + " of " + string(_mc.det_need) + " asked)");
    }
}

// A character that owns every item and knows every skill and card passive of every class, with every status on it.
function TextFit_Char() {
    ItemDB_Init(); SkillDB_Init(); EnemyDB_Init();
    var _ch = CharacterCreate_Player(CLASS_KNIGHT);
    for (var _i = 1; _i < 120; _i++) {
        var _it = ItemDB_Get(_i);
        if (is_struct(_it) && _it.id == _i) _ch.inventory = Inv_Add(_ch.inventory, _i, 9);
    }
    var _cls = [CLASS_KNIGHT, CLASS_ARCHER, CLASS_MAGE];
    _ch.skills = [];
    _ch.passives = [];
    for (var _c = 0; _c < array_length(_cls); _c++) {
        var _ids = Skill_IdsOfClass(_cls[_c]);
        for (var _s = 0; _s < array_length(_ids); _s++) if (!Card_ArrayHas(_ch.skills, _ids[_s])) array_push(_ch.skills, _ids[_s]);
        var _pids = Card_PoolPassiveIds(_cls[_c]);
        for (var _q = 0; _q < array_length(_pids); _q++) if (!Card_ArrayHas(_ch.passives, _pids[_q])) array_push(_ch.passives, _pids[_q]);
    }
    var _sids = Status_AllIds();
    for (var _t = 0; _t < array_length(_sids); _t++) _ch = Status_Add(_ch, _sids[_t], 3, 2);
    return _ch;
}

// R-106: the same character with an upgrade on every skill (every skill name then ends in "+"), and the rows of the lists that show its skills. The skill rows read
// the upgrades through the current player (Card_PlayerRef), so it is the current player while they are built.
function TextFit_UpgradedRows(_what) {
    var _c = TextFit_Char();
    _c.upgrades = [];
    for (var _i = 0; _i < array_length(_c.skills); _i++) array_push(_c.upgrades, _c.skills[_i]);
    var _gs = GameState_Get();
    var _old = _gs.player_ch;
    _gs.player_ch = _c;
    var _rows = (_what == "tab") ? TabSkills_Items(_c) : Battle_SkillRows(_c, undefined);
    _gs.player_ch = _old;
    return _rows;
}

// A centred list menu (the replace, echo and bed lists) at the width it measures itself to: every label must fit its row.
function TextFit_CentreMenu(_fails, _what, _items, _title) {
    var _mt = Ui_Metrics();
    var _m = Ui_MenuNew("fit_" + _what, _items, { layout: { title: _title, anchor: "center", details: true } });
    var _mc = Ui_MenuMeasure(_m, _mt);
    for (var _i = 0; _i < array_length(_items); _i++) {
        var _val = variable_struct_exists(_items[_i], "value") ? _items[_i].value : "";
        TextFit_Row(_fails, _what + " row", _items[_i].label, _val, _mc.panel_w, _mt.p, _mc.icon_px, false, _mt);
    }
    TextFit_Title(_fails, _what + " title", _title, _mc.panel_w - 8 * _mt.p, _mt);
}

// A profile that has met every enemy (elite too), read every note, finished a run of each result.
function TextFit_Profile() {
    var _prof = Profile_Default();
    var _ids = Codex_EnemyIds();
    for (var _i = 0; _i < array_length(_ids); _i++) Codex_Met(_prof, _ids[_i], true);
    var _defs = Note_Defs();
    for (var _n = 0; _n < array_length(_defs); _n++) Note_MarkCollected(_prof, _defs[_n].id);
    var _res = ["won", "abandoned", "died"];
    var _cl = [CLASS_KNIGHT, CLASS_ARCHER, CLASS_MAGE, CLASS_NOBODY];
    for (var _h = 0; _h < 4; _h++) array_push(_prof.history, { class_id: _cl[_h], level: LEVEL_CAP, floor: 9, result: _res[_h mod 3], cause: EnemyDB_Get(ENEMY_FINAL_BOSS).name, kills: 999, seed: 99999 });
    Profile_Unlock(_prof, "nobody_class");
    return _prof;
}

// The widest of _names as drawn now.
function TextFit_Longest(_names) {
    var _best = "";
    var _bw = -1;
    for (var _i = 0; _i < array_length(_names); _i++) {
        var _w = UI_TextWidth(_names[_i]);
        if (_w > _bw) { _bw = _w; _best = _names[_i]; }
    }
    return _best;
}

function Test_Suite_TextFit() {
    global.textfit_known_hits = array_create(array_length(TextFit_Known()), 0);
    // ---- the Tab pages: every row's label in its list, every number line and sentence in its details panel ----
    TextFit_Each("tab skills", function(_w, _h, _l) { var _f = []; var _c = TextFit_Char(); TextFit_TabPage(_f, "skills", TextFit_UpgradedRows("tab"), TabMenu_Title("skills", _c)); return _f; });
    TextFit_Each("tab skills plain names", function(_w, _h, _l) { var _f = []; var _c = TextFit_Char(); TextFit_TabPage(_f, "skills", TabSkills_Items(_c), TabMenu_Title("skills", _c)); return _f; });
    TextFit_Each("tab items", function(_w, _h, _l) { var _f = []; var _c = TextFit_Char(); TextFit_TabPage(_f, "items", TabItems_Items(_c), TabMenu_Title("items", _c)); return _f; });
    TextFit_Each("tab gear", function(_w, _h, _l) { var _f = []; var _c = TextFit_Char(); TextFit_TabPage(_f, "gear", TabGear_Items(_c), TabMenu_Title("gear", _c)); return _f; });
    TextFit_Each("tab status", function(_w, _h, _l) { var _f = []; var _c = TextFit_Char(); TextFit_TabPage(_f, "status", TabStatus_Items(_c), TabMenu_Title("status", _c)); return _f; });
    var _kinds = ["bestiary", "notes", "history", "unlocks"];
    for (var _ki = 0; _ki < 4; _ki++) {
        TextFit_Each("codex " + _kinds[_ki], method({ k: _kinds[_ki] }, function(_w, _h, _l) { var _f = []; var _pg = TabCodex_Page(k, TextFit_Profile()); TextFit_TabPage(_f, "codex_" + k, _pg.rows, _pg.title, _pg.cols); return _f; }));
    }
    TextFit_Each("codex list", function(_w, _h, _l) { var _f = []; TextFit_TabPage(_f, "codex", TabCodex_Items(TextFit_Profile()), Loc_T("tab.title.codex", "Codex")); return _f; });
    TextFit_Each("tab system", function(_w, _h, _l) { var _f = []; TextFit_TabPage(_f, "system", TabSystem_Items(false), Loc_T("tab.title.system", "System")); return _f; });
    TextFit_Each("help list", function(_w, _h, _l) { var _f = []; TextFit_TabPage(_f, "system", TabHelp_Items(), Loc_T("help.title", "Help")); return _f; });
    TextFit_Each("help stats", function(_w, _h, _l) { var _f = []; TextFit_TabPage(_f, "system", Help_StatsItems(), Loc_T("help.stats.title", "Stats & terms")); return _f; });

    // R-106: the Settings > Controls page (the first label was cut to "Confi.." at 640 x 576): every action's label with its keys, and with "Press a key..." in its place
    TextFit_Each("controls page", function(_w, _h, _l) {
        var _f = [];
        var _title = Loc_T("controls.title", "Controls");
        TextFit_TabPage(_f, "settings", Controls_Items(Binds_Defaults(), ""), _title);
        var _ids = Binds_RowIds();
        for (var _i = 0; _i < array_length(_ids); _i++) TextFit_TabPage(_f, "settings", Controls_Items(Binds_Defaults(), _ids[_i], _ids[_i], Controls_WaitingText(Binds_RowLabel(_ids[_i]), "keyboard")), _title);
        return _f;
    });

    // R-106: the lists that show skill names beside the Skills tab and the battle: the replace list, the echo list (with its "Skill: " prefix) and the bed's upgrade list, upgraded names too
    TextFit_Each("skill name lists", function(_w, _h, _l) {
        var _f = [];
        var _c = TextFit_Char();
        var _rep = [];
        var _echo = [];
        var _bed = [];
        var _names = [];
        for (var _i = 0; _i < array_length(_c.skills); _i++) {
            var _id = _c.skills[_i];
            var _up = SkillDB_GetBase(_id).name + "+";
            array_push(_names, _up);
            array_push(_rep, { label: _up, value: Loc_T("card.mp_short", "{mp} MP", { mp: "99" }), help: "", lines: [] });
            array_push(_echo, { label: Run_EchoLabel({ kind: "skill", id: _id }), help: "", lines: [] });
            array_push(_bed, { label: SkillDB_GetBase(_id).name, value: "+", help: "", lines: [] });
        }
        TextFit_CentreMenu(_f, "replace", _rep, Loc_T("cards.replace.title", "Learn {skill}: Replace Which?", { skill: TextFit_Longest(_names) }));
        TextFit_CentreMenu(_f, "echo", _echo, Loc_T("echo.pick.title", "Keep One Skill You Remember"));
        TextFit_CentreMenu(_f, "bed", _bed, Loc_T("bed.upgrade_title", "Upgrade Which Skill?"));
        return _f;
    });

    // ---- the battle: the command rows, the skill and item rows with their icons and MP / count, the number lines of the details panel ----
    TextFit_Each("battle commands", function(_w, _h, _l) {
        var _f = [];
        var _mt = Ui_Metrics();
        var _z = Battle_Zones();
        var _pw = min(Battle_CmdPanelW(_z, _mt), _mt.gw - 2 * _mt.margin);
        var _rows = Battle_CmdItems();
        _rows[4].value = "100%";
        for (var _i = 0; _i < array_length(_rows); _i++) TextFit_Line(_f, "cmd", _rows[_i].label, Ui_MenuLabelRoom(_pw, _mt.p, 0, false, variable_struct_exists(_rows[_i], "value") ? _rows[_i].value : ""));
        return _f;
    });
    TextFit_Each("battle lists", function(_w, _h, _l) {
        var _f = [];
        var _mt = Ui_Metrics();
        var _p = _mt.p;
        var _z = Battle_Zones();
        var _c = TextFit_Char();
        var _sets = [TextFit_UpgradedRows("battle"), Battle_ItemRows(_c)];
        var _icon_px = 16 * max(1, floor(_mt.row_h / 16));
        var _col_w = (_z.right.w - 8 * _p - 3 * _p) / 2;
        for (var _s = 0; _s < 2; _s++) {
            for (var _i = 0; _i < array_length(_sets[_s]); _i++) {
                var _r = _sets[_s][_i];
                TextFit_Row(_f, (_s == 0) ? "skill" : "item", _r.label, _r.value, _z.right.w, _p, (_s == 0) ? _icon_px : 0, (_s == 1), _mt);
                for (var _k = 0; _k < array_length(_r.lines); _k++) {
                    TextFit_Line(_f, "battle line value of '" + string(_r.label) + "'", _r.lines[_k].value, _col_w + 2 * _p);
                    if (UI_TextWidth(_r.lines[_k].label) > _col_w) TextFit_Block(_f, "battle line label of '" + string(_r.label) + "'", _r.lines[_k].label, _col_w, _p);
                }
            }
        }
        return _f;
    });

    // ---- the attack preview plate: the worst hits the game can show (a single value, a multi-hit run, an unequal run of four) ----
    TextFit_Each("attack plate", function(_w, _h, _l) {
        var _f = [];
        var _mt = Ui_Metrics();
        var _z = Battle_Zones();
        var _pw = min(Battle_CmdPanelW(_z, _mt), _mt.gw - 2 * _mt.margin);
        var _cmd = { x: _mt.gw - _mt.margin - _pw, y: _z.band_top, w: _pw, h: _z.cmd_h };
        var _cases = [{ ok_hits: [9], perfect_hits: [12] }, { ok_hits: [24, 24], perfect_hits: [30, 30] }, { ok_hits: [10, 14], perfect_hits: [12, 18] }, { ok_hits: [99], perfect_hits: [99] }];   // a hit, two equal hits, two unequal hits (a guard used up), the largest number
        for (var _i = 0; _i < array_length(_cases); _i++) {
            var _pl = Battle_PreviewPlateLayout(_cmd, _z, _mt, _cases[_i]);
            if (_pl.r.h > _cmd.h) array_push(_f, "plate case " + string(_i) + " is taller than the command menu");
            if (!_pl.ok) array_push(_f, "plate case " + string(_i) + " needs " + string(_pl.text_w) + " has " + string(_pl.fit_w));
            if (_pl.r.x < _z.player.x + _z.player.w) array_push(_f, "plate case " + string(_i) + " overlaps the player panel");
            if (_pl.r.y + _pl.r.h > _mt.gh) array_push(_f, "plate case " + string(_i) + " leaves the screen");
        }
        return _f;
    });

    // ---- the card pick: every card at the pick's column width (the draw's own CardsUi_PickColumns / CardsUi_InnerW / CardsUi_NameFit), and the whole screen (title, cards, hint) on the screen ----
    TextFit_Each("card pick", function(_w, _h, _l) {
        var _f = [];
        var _mt = Ui_Metrics();
        var _p = _mt.p;
        var _col = CardsUi_PickColumns(_mt, 3);
        var _cw = _col.cw;
        var _iw = CardsUi_InnerW(_cw, _mt);
        var _all = CardDB_All();
        var _hint = Loc_T("cards.pick.hint", "[k:left][k:right] Choose   [k:confirm] Take");
        if (3 * _cw + 2 * _col.gap > _mt.gw - 2 * _p) array_push(_f, "the three cards (" + string(_cw) + " each) do not fit the screen " + string(_mt.gw));
        for (var _i = 0; _i < array_length(_all); _i++) {
            var _c = _all[_i];
            var _name = Card_Name(_c);
            var _nf = CardsUi_NameFit(_name, _iw - 5 * _p, _mt);
            if (_nf.w > _iw - 5 * _p) array_push(_f, "card name '" + _name + "' needs " + string(_nf.w) + " has " + string(_iw - 5 * _p) + " (type step " + string(_nf.step) + ")");
            if (_nf.lines > 2) array_push(_f, "card name '" + _name + "' takes " + string(_nf.lines) + " lines");
            TextFit_Block(_f, "card tag", Card_TypeTag(_c), _iw - 5 * _p, _p);
            TextFit_Block(_f, "card sentence of '" + _name + "'", Card_Sentence(_c), _iw, _p);
            var _ls = Card_Lines(_c);
            for (var _k = 0; _k < array_length(_ls); _k++) {
                TextFit_Block(_f, "card line label of '" + _name + "'", _ls[_k].label, _iw, _p);
                TextFit_Line(_f, "card line value of '" + _name + "'", _ls[_k].value, _iw);
            }
            var _one = CardsUi_PickPlan([_c], _cw, _hint, _mt);   // the screen with this card as the tallest
            if (_one.lay.bottom > _mt.gh - _mt.p) array_push(_f, "pick screen with '" + _name + "' (" + string(_one.ch_max) + ") ends at " + string(_one.lay.bottom) + " of " + string(_mt.gh));
        }
        return _f;
    });

    // ---- pop-ups: every tutorial and confirm question wraps into its box and the box stays on the screen ----
    TextFit_Each("pop-ups", function(_w, _h, _l) {
        var _f = [];
        var _mt = Ui_Metrics();
        var _ids = Tutorial_Ids();
        for (var _i = 0; _i < array_length(_ids); _i++) {
            var _e = Tutorial_Get(_ids[_i]);
            var _b = Tutorial_Box(_e, 0);
            TextFit_Line(_f, "tutorial title", _e.title, _b.iw);
            TextFit_Block(_f, "tutorial '" + _ids[_i] + "' body", _e.body, _b.iw, _mt.p);
            if (_b.y + _b.h > _mt.gh - _mt.margin) array_push(_f, "tutorial '" + _ids[_i] + "' box ends at " + string(_b.y + _b.h) + " of " + string(_mt.gh));
        }
        var _c = TextFit_Char();
        var _items = [];
        for (var _n = 1; _n < 120; _n++) { var _it = ItemDB_Get(_n); if (is_struct(_it) && _it.id == _n) array_push(_items, _it.name); }
        var _skills = [];
        for (var _s = 0; _s < array_length(_c.skills); _s++) array_push(_skills, SkillDB_Get(_c.skills[_s]).name);
        var _cls = [];
        for (var _k = 0; _k < 4; _k++) array_push(_cls, DB_PlayerClass(_k).name);
        var _item = TextFit_Longest(_items);
        var _skill = TextFit_Longest(_skills);
        var _qs = [Loc_T("confirm.abandon", "Abandon this run? It counts as a death, but you keep the echo."), TabSystem_Question("quit", false), TabSystem_Question("quit", true),
                   Loc_T("class.select.become", "Become {cls}?", { cls: TextFit_Longest(_cls) }), Loc_T("confirm.echo", "Keep {name} as your echo?", { name: _item }),
                   Loc_T("confirm.replace", "Forget {forget} and learn {learn}?", { forget: _skill, learn: _skill }), Loc_T("confirm.sell", "Sell {name} for {price}?", { name: _item, price: "9999" }),
                   Loc_T("confirm.new_game", "Start a new game? The saved run will be abandoned.")];
        for (var _q = 0; _q < array_length(_qs); _q++) {
            var _cb = Confirm_Box(_qs[_q], _mt);
            TextFit_Block(_f, "confirm", _qs[_q], _cb.iw, _mt.p);
            if (_cb.y + _cb.h > _mt.gh - _mt.margin) array_push(_f, "confirm '" + string_copy(_qs[_q], 1, 20) + "' box ends at " + string(_cb.y + _cb.h));
        }
        return _f;
    });

    // ---- the credits roll: every line inside the screen's width, every file name of the sound credits inside its column ----
    TextFit_Each("credits", function(_w, _h, _l) {
        var _f = [];
        var _mt = Ui_Metrics();
        var _cl = Credits_Layout();
        for (var _i = 0; _i < array_length(_cl.rows); _i++) {
            var _r = _cl.rows[_i];
            if (_r.kind == "names") TextFit_Block(_f, "credits names", _r.text, _cl.col_w, _mt.p);
            else if (_r.kind != "gap") TextFit_Line(_f, "credits " + _r.kind, _r.text, _mt.gw - 2 * _mt.margin);
        }
        return _f;
    });

    // ---- the run summary (R-105, note 27): the title, the cause line and the rows at one column and at two, for each result and class, as the draw lays them out ----
    TextFit_Each("run summary", function(_w, _h, _l) {
        var _f = [];
        var _mt = Ui_Metrics();
        var _p = _mt.p;
        var _cls = [CLASS_KNIGHT, CLASS_ARCHER, CLASS_MAGE, CLASS_NOBODY];
        var _res = ["died", "abandoned", "won"];
        var _foe = EnemyDB_Get(ENEMY_FINAL_BOSS).name;
        var _run = Run_Create(99999999);
        _run.kills = 9999;
        _run.stats = { qte_total: 9999, qte_perfect: 9999, crits: 9999, dmg_dealt: 999999, dmg_taken: 999999, fights_won: 999, play_ms: 359999000 };
        var _titles = RunTitle_All();
        for (var _t = 0; _t < array_length(_titles); _t++) TextFit_Line(_f, "run summary title", RunTitle_Text(_titles[_t]), _mt.gw - 2 * _mt.margin);
        for (var _c = 0; _c < array_length(_cls); _c++) {
            for (var _r = 0; _r < array_length(_res); _r++) {
                var _ch = CharacterCreate_Player(_cls[_c]);
                _ch.level = LEVEL_CAP;
                var _entry = Run_MakeHistoryEntry(_run, _ch, "rm_floor9", _res[_r], (_res[_r] == "died") ? _foe : "");
                var _rows = RunFlow_SummaryRows(_entry);
                var _sentence = RunFlow_CauseLine(_entry);
                var _tag = "run summary (" + _res[_r] + ", class " + string(_cls[_c]) + ")";
                for (var _cols = 1; _cols <= 2; _cols++) {   // the draw's own choice: one column, two when the one-column panel is too tall
                    var _pw = (_cols == 1) ? min(_mt.gw - 2 * _mt.margin, round(_mt.gw * 0.62)) : min(_mt.gw - 2 * _mt.margin, round(_mt.gw * 0.9));
                    var _dh = Ui_DetailsHeight(_pw, _sentence, _rows, _cols);
                    var _total = _mt.line_h + 3 * _p + _dh + 3 * _p + _mt.line_h;
                    var _inner = _pw - 8 * _p;
                    var _col_w = (_inner - (_cols - 1) * 3 * _p) / _cols;
                    TextFit_Block(_f, _tag + " cause line (" + string(_cols) + " col)", _sentence, _inner, _p);
                    for (var _i = 0; _i < array_length(_rows); _i++) {
                        TextFit_Line(_f, _tag + " value of '" + string(_rows[_i].label) + "' (" + string(_cols) + " col)", _rows[_i].value, _col_w + 2 * _p);
                        if (UI_TextWidth(_rows[_i].label) > _col_w) TextFit_Block(_f, _tag + " label (" + string(_cols) + " col)", _rows[_i].label, _col_w, _p);
                    }
                    if (_cols == 2 && _total > _mt.gh - 2 * _mt.margin) array_push(_f, _tag + " two columns need " + string(_total) + " of " + string(_mt.gh - 2 * _mt.margin));
                }
            }
        }
        return _f;
    });

    // ---- the rows the text side has to shorten are still too long (an entry that matches nothing is deleted from TextFit_Known) ----
    var _known = TextFit_Known();
    for (var _e = 0; _e < array_length(_known); _e++) {
        Test_True("H13b known text row still needs shorter text: " + _known[_e].where + " " + _known[_e].has, global.textfit_known_hits[_e] > 0);
    }
}
// ============================================================================
// Bug hunt 7, map and world (build 7f4d08e): the step squash under the darkness, the merchant under the darkness, a sprite saved by name.
// (The grace period in a menu, the Stranger in the arrival clean-up and the clean-up in the run save are checked in the smoke run, steps 980..989.)
// ============================================================================
function Test_Suite_Hunt7Map() {
    Test_RunSuite("Hunt7Map.draw", Test_Hunt7MapDraw);
    Test_RunSuite("Hunt7Map.merchant", Test_Hunt7MapMerchant);
    Test_RunSuite("Hunt7Map.save", Test_Hunt7MapSave);
}

// 1. The world pass draws every picture of a world object (a figure, a note on the floor) BEFORE the room's darkness, and only marks after it.
function Test_Hunt7MapDraw() {
    var _parts = World_FxParts();
    var _light = -1;
    var _squash = -1;
    for (var _i = 0; _i < array_length(_parts); _i++) {
        if (_parts[_i].name == "light") _light = _i;
        if (_parts[_i].name == "player_squash") _squash = _i;
    }
    Test_True("hunt7map draw: the darkness is one part of the world pass", _light >= 0);
    Test_True("hunt7map draw: the player's step squash is drawn, and before the darkness", _squash >= 0 && _squash < _light);
    var _late_body = "";
    var _early_mark = "";
    for (var _j = 0; _j < array_length(_parts); _j++) {
        if (_parts[_j].body && _j > _light) _late_body += _parts[_j].name + " ";
        if (!_parts[_j].body && _j < _light) _early_mark += _parts[_j].name + " ";
    }
    Test_Eq("hunt7map draw: no picture of a world object comes after the darkness", _late_body, "");
    Test_Eq("hunt7map draw: nothing but the darkness itself is a mark before it", _early_mark, "");
    var _names = "";
    for (var _k = _light + 1; _k < array_length(_parts); _k++) _names += _parts[_k].name + " ";
    Test_Eq("hunt7map draw: after the darkness only the marks stay bright", _names, "nav player_prompt elite mapfx ");   // R-091: the merchant's glow moved before the darkness
}

// 1b. The merchant's gold glow is a ring round his shape with his own pixels cut out (as the elite's marks): the sprite itself is the object's own draw, under the darkness.
function Test_Hunt7MapMerchant() {
    var _spr = asset_get_index(Merchant_SpriteName());
    if (_spr == -1) _spr = nobody_down;
    Test_True("hunt7map merchant: there is a sprite to test with", sprite_exists(_spr));
    var _o = Test_RingOverSprite(Merchant_FxRing(_spr, 0, UI_C_MERCHANT_GOLD), _spr, 0, UI_C_MERCHANT_GOLD);
    Test_Eq("hunt7map merchant: the glow paints nothing over the merchant's own pixels", _o.inside, 0);
    Test_True("hunt7map merchant: the glow is there round him", _o.outside > 0);
    Test_True("hunt7map merchant: the glow is the gold, fully opaque (the pulse is the draw's alpha)", _o.bright > 0);
}

// 5. A swapped torch, chest or barrel is saved with its sprite's NAME (a raw sprite number changes when a sprite is added between builds), and an old save with the number still loads.
function Test_Hunt7MapSave() {
    RoomState_Init();
    var _gs = GameState_Get();
    var _objs = [obj_torch, obj_chest, obj_barrel];
    for (var _i = 0; _i < array_length(_objs); _i++) {
        var _on = object_get_name(_objs[_i]);
        var _pid = "hunt7map_" + _on;
        var _key = RoomState_Key(room, _pid);
        var _a = instance_create_depth(0, 0, 0, _objs[_i]);
        _a.persist_id = _pid;
        var _swap = _a.swap_sprite;
        var _swap_name = sprite_get_name(_swap);
        var _plain = _a.sprite_index;
        Test_True("hunt7map save " + _on + ": it has a swap sprite and a different plain one", sprite_exists(_swap) && _swap != _plain);
        _a.sprite_index = _swap;
        _a.swapped = true;
        RoomState_SaveInstance(_a, ["swapped", "sprite_index"], false);
        instance_destroy(_a);
        // through the save file's own text
        var _rec = json_parse(json_stringify(RoomState_Get(room, _pid)));
        Test_True("hunt7map save " + _on + ": the saved record names the sprite", string_pos("\"" + _swap_name + "\"", json_stringify(_rec)) > 0);
        Test_False("hunt7map save " + _on + ": and holds no raw sprite number", variable_struct_exists(_rec.vars, "sprite_index"));
        variable_struct_set(_gs.persist, _key, _rec);
        var _b = instance_create_depth(0, 0, 0, _objs[_i]);
        _b.persist_id = _pid;
        RoomState_ApplyInstance(_b);
        Test_True("hunt7map save " + _on + ": loaded, it is swapped", _b.swapped);
        Test_Eq("hunt7map save " + _on + ": loaded, it shows the swap sprite", sprite_get_name(_b.sprite_index), _swap_name);
        instance_destroy(_b);
        // an old save: the raw number, as the build before this wrote it
        variable_struct_set(_gs.persist, _key, { removed: false, vars: { swapped: true, sprite_index: _swap }, obj_name: _on });
        var _c = instance_create_depth(0, 0, 0, _objs[_i]);
        _c.persist_id = _pid;
        RoomState_ApplyInstance(_c);
        Test_True("hunt7map save " + _on + ": an old save with the number still loads swapped", _c.swapped);
        Test_Eq("hunt7map save " + _on + ": and shows the swap sprite", sprite_get_name(_c.sprite_index), _swap_name);
        instance_destroy(_c);
        // an old save from a build whose sprite numbers were different: the number points at some other sprite, the swap sprite still wins
        variable_struct_set(_gs.persist, _key, { removed: false, vars: { swapped: true, sprite_index: _plain }, obj_name: _on });
        var _d = instance_create_depth(0, 0, 0, _objs[_i]);
        _d.persist_id = _pid;
        RoomState_ApplyInstance(_d);
        Test_Eq("hunt7map save " + _on + ": an old save with a stale number shows the swap sprite, not the stale picture", sprite_get_name(_d.sprite_index), _swap_name);
        instance_destroy(_d);
        variable_struct_remove(_gs.persist, _key);
    }
}


// ============================================================================================================
// Bug hunt 7, feel and audio (hunt7feel): R-080..R-084.
//   (The QTE clocks over a real focus loss, in a fight, are checked in the smoke run, steps 990..999.)
// ============================================================================================================
function Test_Suite_Hunt7Feel() {
    Test_RunSuite("Hunt7Feel.freeze", Test_Hunt7FeelFreeze);
    Test_RunSuite("Hunt7Feel.text", Test_Hunt7FeelText);
    Test_RunSuite("Hunt7Feel.deny", Test_Hunt7FeelDeny);
    Test_RunSuite("Hunt7Feel.break", Test_Hunt7FeelBreak);
    Test_RunSuite("Hunt7Feel.bus", Test_Hunt7FeelBus);
}

// 1. R-080 (D122): while the window is not in front every QTE clock (the sliding bar, the arrows, the defence bar with its telegraph) advances by nothing.
function Test_Hunt7FeelFreeze() {
    var _had = variable_global_exists("focus_prev");
    var _old = _had ? global.focus_prev : true;
    global.focus_prev = true;
    Test_Eq("hunt7feel freeze: with the window in front a 16667 us frame adds 16.667 ms", Qte_StepMs(16667), 16.667);
    global.focus_prev = false;
    Test_Eq("hunt7feel freeze: with the window out of front a frame adds nothing", Qte_StepMs(16667), 0);
    Test_Eq("hunt7feel freeze: a hitch adds nothing either", Qte_StepMs(200000), 0);
    global.focus_prev = true;
    Test_Eq("hunt7feel freeze: and when it is back the clock runs again", Qte_StepMs(16667), 16.667);
    global.focus_prev = _old;
}

// 2. R-081 (D9, D133): the Korean loot line has its space after the colon; the auto-resolve victory line is a localized row.
function Test_Hunt7FeelText() {
    var _lang = Loc_GetLanguage();
    var _loot = [{ item_id: 31, qty: 1 }];
    Loc_SetLanguage("en");
    var _en = Loot_BuildMessageEntries(_loot, Loc_T("combat.msg.loot_prefix", "Loot: "));
    Test_Eq("hunt7feel text: the English loot line", _en[0].text, "Loot: " + Item_NameMarked(31, 1));
    Loc_SetLanguage("ko");
    var _ko = Loot_BuildMessageEntries(_loot, Loc_T("combat.msg.loot_prefix", "Loot: "));
    Test_Eq("hunt7feel text: the Korean loot line has a space after the colon", _ko[0].text, "전리품: " + Item_NameMarked(31, 1));
    Test_Eq("hunt7feel text: a prefix that already ends in a space gets no second one", Loot_BuildMessageEntries(_loot, "Loot: ")[0].text, "Loot: " + Item_NameMarked(31, 1));
    Test_Eq("hunt7feel text: the Korean auto-resolve victory line is Korean", Enemy_AutoResolveBuildMessage({ name: "슬라임" }, { }), "슬라임을(를) 가볍게 쓰러뜨렸습니다.");
    Loc_SetLanguage("en");
    Test_Eq("hunt7feel text: the English auto-resolve victory line is unchanged", Enemy_AutoResolveBuildMessage({ name: "Slime" }, { }), "You overpower Slime.");
    Loc_SetLanguage(_lang);
}

// 3. R-082 (D133): a row the player cannot use (a skill that costs too much MP, a list with nothing in it) answers with the refusal sound, not the confirm ding.
function Test_Hunt7FeelDeny() {
    var _bc = Test_H3Bc();
    _bc.run_fails = 0;
    _bc.p.skills = [SKILL_MUSCLE_UP];
    _bc.p.inventory = [];
    var _rows = Battle_SkillRows(_bc.p, _bc.e);
    Test_True("hunt7feel deny: (setup) the skill costs MP", _rows[0].cost > 0);
    _bc.p.mp = _rows[0].cost;
    Battle_MenusBuild(_bc);
    Test_Eq("hunt7feel deny: a skill the player can pay for confirms", Ui_ConfirmSound(_bc.ui_skill, 0), "ui_confirm");
    _bc.p.mp = 0;
    Battle_MenusBuild(_bc);
    Test_Eq("hunt7feel deny: a skill with too little MP is refused", Ui_ConfirmSound(_bc.ui_skill, 0), "ui_deny");
    Test_Eq("hunt7feel deny: Attack in the command menu confirms", Ui_ConfirmSound(_bc.ui_cmd, 0), "ui_confirm");
    Test_Eq("hunt7feel deny: Skill with a skill known confirms", Ui_ConfirmSound(_bc.ui_cmd, 1), "ui_confirm");
    Test_Eq("hunt7feel deny: Item with an empty bag is refused", Ui_ConfirmSound(_bc.ui_cmd, 2), "ui_deny");
    _bc.p.skills = [];
    Battle_MenusBuild(_bc);
    Test_Eq("hunt7feel deny: Skill with no skills is refused", Ui_ConfirmSound(_bc.ui_cmd, 1), "ui_deny");
    Test_Eq("hunt7feel deny: Guard still confirms", Ui_ConfirmSound(_bc.ui_cmd, 3), "ui_confirm");
    instance_destroy(_bc.enemy_inst);
}

// 4. R-083 (D138): the BREAK layer is a different sample from the grade sound it lands on, for every grade (a Perfect used to start the same sample twice).
function Test_Hunt7FeelBreak() {
    SFX_RegisterDefaults();
    var _grades = [QTE_PERFECT, QTE_GOOD, QTE_OK, QTE_WEAK];
    for (var _g = 0; _g < array_length(_grades); _g++) {
        var _grade_key = Qte_GradeSfxKey(_grades[_g]);
        var _layer_key = Battle_BreakSfxKey(_grades[_g] == QTE_PERFECT);
        var _a = SFX_DebugResolve(_grade_key);
        var _b = SFX_DebugResolve(_layer_key);
        Test_True("hunt7feel break: (setup) grade " + string(_g) + " and its BREAK layer both resolve", _a.ok && _b.ok);
        Test_True("hunt7feel break: the BREAK layer on grade " + string(_g) + " is another sample than the grade sound", _a.asset != _b.asset);
    }
}

// 5. R-084 (D49): world sounds (chest, barrel, torch, the "!" and "?" over an enemy) follow the SFX volume; menu sounds follow the UI volume.
function Test_Hunt7FeelBus() {
    SFX_RegisterDefaults();
    var _world = ["chest_open", "barrel_break", "kill_torch", "alert_spotted", "alert_lost"];
    for (var _i = 0; _i < array_length(_world); _i++) {
        Test_True("hunt7feel bus: " + _world[_i] + " resolves to a sound", SFX_DebugResolve(_world[_i]).ok);
        Test_Eq("hunt7feel bus: " + _world[_i] + " is on the SFX bus", SFX_CategoryForKey(_world[_i]), "sfx");
    }
    var _ui = ["ui_move", "ui_confirm", "ui_back", "ui_openclose", "ui_deny", "save_confirm"];
    for (var _j = 0; _j < array_length(_ui); _j++) Test_Eq("hunt7feel bus: " + _ui[_j] + " stays on the UI bus", SFX_CategoryForKey(_ui[_j]), "ui");
}

// ============================================================================================================================
// Review 7 (session 7, findings 2, 3 and 4; finding 1, the attack plate R-085, is checked in smoke step 411): R-085..R-088.
// ============================================================================================================================
function Test_Suite_Review7() {
    Test_RunSuite("Review7.focus", Test_Review7Focus);
    Test_RunSuite("Review7.sprite", Test_Review7Sprite);
    Test_RunSuite("Review7.historycols", Test_Review7HistoryCols);
}

// 2. R-086: a scenario that fails with the window "unfocused" must not freeze every later QTE of the run. Scenario_ClearUi, which every stage and every
// failure path of the scripted runs goes through before the next part, puts the focus back.
function Test_Review7Focus() {
    var _had = variable_global_exists("focus_prev");
    var _old = _had ? global.focus_prev : true;
    global.focus_prev = false;
    Test_Eq("review7 focus: (setup) an unfocused window freezes the QTE clock", Qte_StepMs(16000), 0);
    Scenario_ClearUi();
    Test_True("review7 focus: the scenario cleanup puts the focus back", global.focus_prev);
    Test_True("review7 focus: the QTE clock runs again after it", Qte_StepMs(16000) > 0);
    global.focus_prev = _old;
}

// 3. R-087: a saved sprite name that no longer resolves must not leave an opened chest closed: the swap sprite is the fallback, as for an old numeric save.
function Test_Review7Sprite() {
    var _open = chest_opened_asset;
    var _shut = chest_asset;
    var _a = { swapped: true, swap_sprite: _open, sprite_index: _shut };
    RoomState_ApplySprite(_a, { sprite_name: "spr_no_longer_exists_in_this_build" });
    Test_Eq("review7 sprite: a swapped chest with a lost sprite name shows the swap sprite", _a.sprite_index, _open);
    var _b = { swapped: false, swap_sprite: _open, sprite_index: _shut };
    RoomState_ApplySprite(_b, { sprite_name: "spr_no_longer_exists_in_this_build" });
    Test_Eq("review7 sprite: an unswapped chest with a lost sprite name is left as it is", _b.sprite_index, _shut);
    var _c = { swapped: true, swap_sprite: _shut, sprite_index: _shut };
    RoomState_ApplySprite(_c, { sprite_name: "chest_opened_asset" });
    Test_Eq("review7 sprite: a name that resolves is still used", _c.sprite_index, _open);
    var _d = { swapped: true, swap_sprite: _open, sprite_index: _shut };
    RoomState_ApplySprite(_d, { sprite_name: 12345 });
    Test_Eq("review7 sprite: a name that is not even a string falls back too", _d.sprite_index, _open);
}

// 4. R-088: the Run History page picks its number-line columns for the window it is in; resizing (or changing the text scale) while it is open picks again.
// For every start size and every size it is resized to, the open page ends with the columns a freshly opened page has there.
function Test_Review7HistoryCols() {
    var _s = TextFit_Begin();
    var _sizes = TextFit_Sizes();
    var _langs = ["en", "ko"];
    var _differs = false;
    for (var _l = 0; _l < 2; _l++) {
        for (var _a = 0; _a < array_length(_sizes); _a++) {
            TextFit_Set(_sizes[_a][0], _sizes[_a][1], _langs[_l]);
            var _page = TabCodex_Page("history", TextFit_Profile());
            var _m = TabCodex_MakeMenu("history", _page);
            for (var _b = 0; _b < array_length(_sizes); _b++) {
                TextFit_Set(_sizes[_b][0], _sizes[_b][1], _langs[_l]);
                TabMenu_FitMenu(_m, TabMenu_Zones("codex_history"));
                var _want = Codex_HistoryCols(_page.rows);
                if (_want != _page.cols) _differs = true;
                Test_Eq("review7 history: " + _langs[_l] + " opened at " + string(_sizes[_a][0]) + " then resized to " + string(_sizes[_b][0]) + " has the columns of that size", _m.layout.details_cols, _want);
            }
        }
    }
    Test_True("review7 history: (setup) some resize changes the column count, so the check can fail", _differs);
    TextFit_End(_s);
}

// ============================================================================
// Round 3 playtest, the card pick (owner notes 11, 10, 28; D168; R-095): the pick screen has the three cards and nothing else (no Skip, no gold for refusing),
// every card's text fits its frame (Test_Suite_TextFit "card pick" proves every card at every size), "The Pale Choirbeast" is "Pale Choirbeast".
// ============================================================================
function Test_Suite_R3Cards() {
    Test_RunSuite("R3Cards.cursor", Test_R3CardsCursor);
    Test_RunSuite("R3Cards.skip", Test_R3CardsSkip);
    Test_RunSuite("R3Cards.names", Test_R3CardsNames);
}

// The cursor moves between the cards only: left / right wrap, up / down do nothing, and no input ever leads to a row past the last card.
function Test_R3CardsCursor() {
    Test_Eq("r3cards cursor: right moves to the next card", Cards_PickMove(0, 3, 1, 0, 0), 1);
    Test_Eq("r3cards cursor: left from the first card wraps to the last", Cards_PickMove(0, 3, -1, 0, 0), 2);
    Test_Eq("r3cards cursor: right from the last card wraps to the first", Cards_PickMove(2, 3, 1, 0, 2), 0);
    Test_Eq("r3cards cursor: down stays on the card (there is no row below)", Cards_PickMove(1, 3, 0, 1, 1), 1);
    Test_Eq("r3cards cursor: up stays on the card", Cards_PickMove(1, 3, 0, -1, 1), 1);
    Test_Eq("r3cards cursor: down on the last card stays on it", Cards_PickMove(2, 3, 0, 1, 2), 2);
    var _past = 0;
    for (var _cur = 0; _cur < 3; _cur++) {
        for (var _dx = -1; _dx <= 1; _dx++) {
            for (var _dy = -1; _dy <= 1; _dy++) {
                var _to = Cards_PickMove(_cur, 3, _dx, _dy, _cur);
                if (_to < 0 || _to > 2) _past++;
            }
        }
    }
    Test_Eq("r3cards cursor: no input reaches a row other than the three cards", _past, 0);
}

// No Skip: the offer is three cards, the Skip text is gone from the workbook in both languages.
function Test_R3CardsSkip() {
    var _gs = GameState_Get();
    var _old = _gs.player_ch;
    CardDB_Init();
    var _ch = Test_CardPlayer(CLASS_MAGE, [SKILL_FIREBALL]);
    _ch.offer = [Card_SkillId(SKILL_ICE_SPEAR), Card_UpgradeId(SKILL_FIREBALL), "fb:rest"];
    _gs.player_ch = _ch;
    var _pk = CardsUi_PickNew();
    Test_Eq("r3cards skip: the pick screen holds exactly the three cards", array_length(_pk.ids), 3);
    _gs.player_ch = _old;
    Test_Eq("r3cards skip: no Skip text in English", Loc_GetRaw("cards.pick.skip", "en"), "");
    Test_Eq("r3cards skip: no Skip text in Korean", Loc_GetRaw("cards.pick.skip", "ko"), "");
}

// D168: the final boss is "Pale Choirbeast" (no article), in the workbook and in the DB's own fallback.
function Test_R3CardsNames() {
    EnemyDB_Init();
    var _lang0 = Loc_GetLanguage();
    Loc_SetLanguage("en");
    Test_Eq("r3cards names: the final boss is Pale Choirbeast", EnemyDB_Get(ENEMY_FINAL_BOSS).name, "Pale Choirbeast");
    Loc_SetLanguage(_lang0);
}

// ============================================================================================================================
// Round 3 menus (owner notes 9, 21, 25; D171): R-096 section headers stand out, R-097 "Reset to Defaults" asks and shows what it did. The QTE grade words
// are all capitals in English (note 9). The flow through real keys is in smoke steps 1040..1049, the pictures in shots 1030..1039.
// ============================================================================================================================
function Test_Suite_R3Menus() {
    Test_RunSuite("R3Menus.gradewords", Test_R3GradeWords);
    Test_RunSuite("R3Menus.headers", Test_R3Headers);
    Test_RunSuite("R3Menus.reset", Test_R3Reset);
}

// Note 9: PERFECT, GOOD, OK and WEAK in capitals (only these four words); Korean is as it was; the 2x word fits every window width.
function Test_R3GradeWords() {
    var _s = TextFit_Begin();
    var _keys = ["PERFECT", "GOOD", "OK", "WEAK"];
    var _en = ["PERFECT", "GOOD", "OK", "WEAK"];
    var _ko = [chr(0xC644) + chr(0xBCBD), chr(0xC88B) + chr(0xC74C), chr(0xBB34) + chr(0xB09C), chr(0xC57D) + chr(0xD568)];   // as before: wanbyeok, joeum, munan, yakham
    var _sizes = TextFit_Sizes();
    for (var _i = 0; _i < 4; _i++) {
        TextFit_Set(480, 432, "en");
        Test_Eq("r3 grade word en " + _keys[_i], Qte_GradeLabel(_keys[_i]), _en[_i]);
        TextFit_Set(480, 432, "ko");
        Test_Eq("r3 grade word ko " + _keys[_i], Qte_GradeLabel(_keys[_i]), _ko[_i]);
    }
    for (var _z = 0; _z < array_length(_sizes); _z++) {
        for (var _l = 0; _l < 2; _l++) {
            var _lang = (_l == 0) ? "en" : "ko";
            TextFit_Set(_sizes[_z][0], _sizes[_z][1], _lang);
            for (var _w = 0; _w < 4; _w++) {
                var _tw = UI_TextWidth(Qte_GradeLabel(_keys[_w])) * 2;
                Test_True("r3 grade word " + _lang + " " + _keys[_w] + " at 2x fits the " + string(_sizes[_z][0]) + " px width", _tw <= Display_GuiW() - 2 * Ui_Metrics().margin);
            }
        }
    }
    // an enemy near a screen edge must not push the word off the screen: the left edge is held inside the margins
    Test_Eq("r3 grade word: a centre near the left edge is held at the margin", Qte_GradeWordLeft(5, 100, 480, 8), 8);
    Test_Eq("r3 grade word: a centre near the right edge is held at the margin", Qte_GradeWordLeft(475, 100, 480, 8), 480 - 8 - 100);
    Test_Eq("r3 grade word: a centre in the middle stays centred", Qte_GradeWordLeft(240, 100, 480, 8), 190);
    TextFit_End(_s);
}

// Note 21 / R-096 (and the review of it, R-106): a section header (kind "head") is pale text with a thin light rule after it and no fill, so it never looks like the cursor
// band (the dark green); an empty slot is a dim light-green row. Never selectable, one shared draw.
function Test_R3Headers() {
    var _head = { id: "h", kind: "head", label: "Equipped", value: "", enabled: false };
    var _dim = { id: "d", kind: "button", label: "No Armor", value: "", enabled: true, dim: true };
    var _item = { id: "i", kind: "button", label: "Iron Sword", value: "", enabled: true };
    var _hs = Ui_RowStyle(_head, false);
    var _ds = Ui_RowStyle(_dim, false);
    var _is = Ui_RowStyle(_item, false);
    Test_Eq("r3 header: it has no fill", _hs.strip, -1);
    Test_True("r3 header: its draw does not share the cursor band's fill (the dark green)", _hs.strip != UI_C_DARK);
    Test_Eq("r3 header: the rule after the text is the light green", _hs.rule, UI_C_LIGHT);
    Test_Eq("r3 header: the text is the palette's lightest", _hs.text, UI_C_LIGHTEST);
    Test_Eq("r3 header: it is the same with the cursor on it", Ui_RowStyle(_head, true).strip, -1);
    Test_True("r3 header: its text colour differs from a dim row's as drawn", Ui_TextColor(_hs.text) != Ui_TextColor(_ds.text));
    Test_True("r3 header: its rule marks it out from a dim row (which has none)", _hs.rule != _ds.rule);
    Test_Eq("r3 a dim row has no rule", _ds.rule, -1);
    Test_Eq("r3 an empty-slot (dim) row stays the light green", _ds.text, UI_C_LIGHT);
    Test_Eq("r3 an empty-slot (dim) row has no strip", _ds.strip, -1);
    Test_Eq("r3 an item row has no strip", _is.strip, -1);
    Test_Eq("r3 an item row has no rule", _is.rule, -1);
    Test_Eq("r3 an item row keeps the main text colour", Ui_TextColor(_is.text), UI_C_TEXT);
    // the header's place: a gap above it, except for the first row of the list
    var _first = Ui_HeadRect(10, 200, 50, 16, 3, true);
    var _later = Ui_HeadRect(10, 200, 50, 16, 3, false);
    Test_Eq("r3 header strip: the first one has no gap above", _first.y, 50);
    Test_Eq("r3 header strip: a later one leaves a gap of one pixel unit above", _later.y, 53);
    Test_Eq("r3 header strip: the first one ends at the bottom of the row", _first.y + _first.h, 66);
    Test_Eq("r3 header strip: a later one ends at the bottom of the row", _later.y + _later.h, 66);
    Test_Eq("r3 header strip: it spans the row", _later.x + _later.w, 200);
    // the real lists
    var _g = TabGear_Items(CharacterCreate_Player(CLASS_KNIGHT));
    var _armor = Test_RowById(_g, "id", "empty_body");
    var _acc = Test_RowById(_g, "id", "empty_accessory");
    Test_True("r3 gear: the Equipped header is a head row", _g[0].kind == "head" && _g[0].label == "Equipped");
    Test_Eq("r3 gear: No Armor draws the dim light green", Ui_RowStyle(_armor, false).text, UI_C_LIGHT);
    Test_Eq("r3 gear: No Accessory draws the dim light green", Ui_RowStyle(_acc, false).text, UI_C_LIGHT);
    Test_True("r3 gear: the header does not look like No Armor", Ui_RowStyle(_g[0], false).rule != Ui_RowStyle(_armor, false).rule);
    var _kn = CharacterCreate_Player(CLASS_KNIGHT);
    _kn.inventory = Inv_Add(_kn.inventory, 2, 1);
    var _g2 = TabGear_Items(_kn);
    var _bag = -1;
    for (var _i = 0; _i < array_length(_g2); _i++) if (_g2[_i].id == "head_bag") _bag = _i;
    Test_True("r3 gear: the Bag header is a head row with a rule and no fill", _bag >= 0 && _g2[_bag].kind == "head" && Ui_RowStyle(_g2[_bag], false).rule == UI_C_LIGHT && Ui_RowStyle(_g2[_bag], false).strip == -1);
    // the cursor never rests on a header
    var _m = Ui_MenuNew("r3_head", _g2, {});
    Test_True("r3 gear: the cursor starts on a row, not a header", _m.items[_m.cursor].kind != "head");
}

// Note 25 / R-097: what a reset changed, the notice text, the flash.
function Test_R3Reset() {
    var _old = Binds_Copy(Binds_Defaults());
    variable_struct_set(_old, "run", [ord("F")]);
    variable_struct_set(_old, "tab_next", [ord("G")]);
    var _changed = Controls_ChangedRows(_old, Binds_Defaults());
    Test_Eq("r3 reset: the rows that differ from the defaults are named", string(_changed), string(["run", "tab_next"]));
    Test_Eq("r3 reset: nothing differs when the keys are the defaults", array_length(Controls_ChangedRows(Binds_Defaults(), Binds_Defaults())), 0);
    Loc_SetLanguage("en");
    Test_Eq("r3 reset: the notice says keys are back", Controls_ResetText(2), "Keys are back to the defaults.");
    Test_Eq("r3 reset: the notice says when nothing changed", Controls_ResetText(0), "Keys were already the defaults.");
    Test_Eq("r3 reset: the question", Loc_T("controls.reset_ask", "?"), "Reset every key to its default?");
    Test_True("r3 flash: on at the start", Ui_FlashOn(0));
    Test_False("r3 flash: off before it starts", Ui_FlashOn(-1));
    Test_False("r3 flash: blinks off", Ui_FlashOn(250));
    Test_True("r3 flash: and on again", Ui_FlashOn(350));
    Test_False("r3 flash: over after 600 ms", Ui_FlashOn(600));
    Test_Eq("r3 flash: lasts about 600 ms", CONTROLS_FLASH_MS, 600);
    // the page rows carry the flash start for the changed rows only
    var _items = Controls_Items(Binds_Defaults(), "", "", "", ["run"], 1234);
    Test_Eq("r3 flash: a changed row carries the start time", Test_RowById(_items, "id", "run").flash_at, 1234);
    var _other = Test_RowById(_items, "id", "tab_next");
    Test_True("r3 flash: an unchanged row does not", !variable_struct_exists(_other, "flash_at") || _other.flash_at < 0);
    // the Korean strings exist
    Loc_SetLanguage("ko");
    Test_True("r3 reset: the question has a Korean text", Loc_T("controls.reset_ask", "?") != "Reset every key to its default?" && Loc_T("controls.reset_ask", "?") != "?");
    Test_True("r3 reset: the already-defaults notice has a Korean text", Loc_T("controls.reset_same", "?") != "Keys were already the defaults." && Loc_T("controls.reset_same", "?") != "?");
    Loc_SetLanguage("en");
}

// ============================================================================================================================
// Round 3 playtest, packet light (owner notes 1, 2, 18): R-089 the player flashes light and dark when he moves, R-090 he stays bright when he runs,
// R-091 the merchant is not touched by the light. (The player's layer over a real walk and run in rm_floor1 and rm_floor3, the same picture plain and squashed
// in rm_floor1, and the merchant's cell on each merchant floor are checked in smoke steps 1000..1004.)
// ============================================================================================================================
function Test_Suite_R3Light() {
    Test_RunSuite("R3Light.parts", Test_R3LightParts);
    Test_RunSuite("R3Light.plan", Test_R3LightPlan);
    Test_RunSuite("R3Light.spots", Test_R3LightSpots);
}

// 1. R-089/R-090/R-091: the pictures of the player's squash and of the merchant's glow are "body" parts: drawn at the end of the Instances layer (where the plain
// player and the enemies are drawn), under the Foreground haze and before the darkness; everything else of the world pass stays at the end of the top layer.
function Test_R3LightParts() {
    var _parts = World_FxParts();
    var _light = -1;
    for (var _i = 0; _i < array_length(_parts); _i++) {
        if (_parts[_i].name == "light") _light = _i;
    }
    Test_True("r3light parts: the darkness is a part of the world pass", _light >= 0);
    var _bodies = ["player_squash", "merchant_glow"];
    for (var _b = 0; _b < array_length(_bodies); _b++) {
        var _at = -1;
        for (var _i = 0; _i < array_length(_parts); _i++) {
            if (_parts[_i].name == _bodies[_b]) _at = _i;
        }
        Test_True("r3light parts: " + _bodies[_b] + " is a part of the world pass", _at >= 0);
        Test_True("r3light parts: " + _bodies[_b] + " comes before the darkness", _at >= 0 && _at < _light);
        Test_Eq("r3light parts: " + _bodies[_b] + " is drawn in the body pass (end of the Instances layer)", (_at >= 0 && variable_struct_exists(_parts[_at], "pass")) ? _parts[_at].pass : "(no pass)", "body");
    }
    for (var _j = 0; _j < array_length(_parts); _j++) {
        if (_parts[_j].name == "light" || _parts[_j].name == "nav" || _parts[_j].name == "player_prompt" || _parts[_j].name == "elite" || _parts[_j].name == "mapfx") {
            Test_Eq("r3light parts: " + _parts[_j].name + " stays in the top pass", variable_struct_exists(_parts[_j], "pass") ? _parts[_j].pass : "(no pass)", "top");
        }
    }
}

// 2. Where the passes run: with a Foreground layer (rm_floor1, rm_floor2) the body pass is the end of Instances and the top pass the end of Foreground; a room without one
// has a single script at the end of Instances that draws both. Either way the player's squash is on the layer the player's plain sprite is on.
function Test_R3LightPlan() {
    var _fg = World_FxPlan(true);
    var _no = World_FxPlan(false);
    Test_Eq("r3light plan: with a Foreground layer the body pass is at the end of Instances", _fg.body_layer, "Instances");
    Test_Eq("r3light plan: with a Foreground layer the top pass is at the end of Foreground", _fg.top_layer, "Foreground");
    Test_True("r3light plan: with a Foreground layer there are two scripts", _fg.split);
    Test_Eq("r3light plan: without a Foreground layer the body pass is at the end of Instances", _no.body_layer, "Instances");
    Test_Eq("r3light plan: without a Foreground layer the top pass is at the end of Instances too", _no.top_layer, "Instances");
    Test_False("r3light plan: without a Foreground layer there is one script", _no.split);
}

// 3. R-091: no merchant spot lies within the inner half of the radius of any light pool of its floor (a pool's centre as the light pass puts it: the middle of the tile for a
// sun spot, the flame a little above the middle for a fire or torch).
function Test_R3LightSpots() {
    var _rooms = [rm_floor2, rm_floor5, rm_floor8];
    var _T = GRID_TILE_SIZE;
    for (var _r = 0; _r < array_length(_rooms); _r++) {
        var _name = room_get_name(_rooms[_r]);
        var _sp = Merchant_SpotFor(_rooms[_r]);
        var _src = Light_AllSources(_name);
        Test_True("r3light spots: " + _name + " has a merchant spot and light pools to check against", is_struct(_sp) && array_length(_src) > 0);
        if (!is_struct(_sp)) continue;
        var _mx = _sp.x + _T / 2;
        var _my = _sp.y + _T / 2;
        for (var _i = 0; _i < array_length(_src); _i++) {
            var _s = _src[_i];
            var _px = _s.cx * _T + _T / 2;
            var _py = _s.cy * _T + (_s.sun ? _T / 2 : 5);
            var _d = point_distance(_mx, _my, _px, _py);
            Test_True("r3light spots: " + _name + " merchant is outside the inner half of the pool at " + string(_s.cx) + "," + string(_s.cy) + " (" + string(round(_d)) + " px of " + string(_s.r * _T * 0.5) + ")", _d > _s.r * _T * 0.5);
        }
    }
}

// ============================================================================================================================
// Round 3 packet bvis (owner notes 5, 23, 8): R-092 (the snake covered by its plate and chips), R-093 (chip labels cut or overlapping), R-094 (a
// bleed chip blinking for no visible reason). Expected values are the packet brief's: a soft shadow of two nested ellipses under every enemy, one
// ground line for every enemy's feet, the plate and the chip row clear of the sprite at every size and language, and a last-turn blink that is an
// outline round the icon (never a filled box).
// ============================================================================================================================
function Test_Suite_R3Bvis() {
    Test_RunSuite("R3Bvis.ground", Test_R3Ground);
    Test_RunSuite("R3Bvis.shadow", Test_R3Shadow);
    Test_RunSuite("R3Bvis.layout", Test_R3Layout);
    Test_RunSuite("R3Bvis.blink", Test_R3Blink);
}

// A stand-in battle controller for one enemy at the place a real battle gives it: the enemy (an elite when _mod is not ""), _nst of its statuses
// (poison 3 stacks, bleed 2, burn 2, bloodthirsty 4, solidify 3, in that order), BREAK when _broke, a skill banner when _banner.
function Test_R3Make(_id, _mod, _nst, _broke, _banner) {
    var _pl = CharacterCreate_Player(CLASS_KNIGHT);
    var _en = EnemyCreate(_id);
    _en = Elite_Apply(_en, _mod);
    var _ids = [STATUS_POISON, STATUS_BLEED, STATUS_BURN, STATUS_BLOODTHIRSTY, STATUS_SOLIDIFY];
    var _tn = [0, 3, 2, 4, 3];
    var _st = [3, 2, 1, 1, 1];
    for (var _i = 0; _i < _nst && _i < 5; _i++) _en = Status_Add(_en, _ids[_i], _tn[_i], 0, _st[_i]);
    _en.broken = _broke;
    var _tl = Turn_New([Turn_Fighter(TL_PLAYER, 5), Turn_Fighter(TL_ENEMY, 4)]);
    var _inst = instance_create_depth(0, 0, 0, obj_enemy_battle);
    _inst.sprite_index = _en.sprite;
    var _at = Battle_EnemyPlace(_en.sprite);
    _inst.x = _at.x;
    _inst.y = _at.y;
    return { p: _pl, e: _en, tl: _tl, enemy_inst: _inst, cam_base_x: 0, cam_base_y: 0, skill_banner_active: _banner, skill_banner_name: "Fireball",
             battle_state: BSTATE_ATTACK_TIMING, hud: { clock: 0, hp_shown: 1, mp_shown: 1, rects: {} } };
}

function Test_R3Rect(_x, _y, _w, _h) {
    return { x: _x, y: _y, w: _w, h: _h };
}

// 1. The ground line: the opaque bottom of every enemy sprite is on one y, the picture is centred, and the biggest enemy still fits under the strip.
function Test_R3Ground() {
    var _first = undefined;
    var _same = true;
    var _list = "";
    var _centred = true;
    for (var _id = ENEMY_SLIME; _id <= ENEMY_FINAL_BOSS; _id++) {
        var _spr = EnemyDB_Get(_id).sprite;
        var _at = Battle_EnemyPlace(_spr);
        var _bottom = _at.y - sprite_get_yoffset(_spr) + sprite_get_bbox_bottom(_spr) + 1;
        _list += string(_id) + ":" + string(_bottom) + " ";
        if (is_undefined(_first)) _first = _bottom;
        else if (_bottom != _first) _same = false;
        if (abs((_at.x - sprite_get_xoffset(_spr) + sprite_get_width(_spr) * 0.5) - (DISPLAY_BASE_W * 0.5)) > 0.51) _centred = false;
    }
    Test_True("r3bvis ground: every enemy's opaque bottom is on the same world y (" + _list + ")", _same);
    Test_True("r3bvis ground: every enemy is centred across the picture", _centred);
    Test_True("r3bvis ground: the feet stand in the lower half of the picture, above the HUD", is_undefined(_first) ? false : (_first >= 72 && _first <= 96));
}

// 2. The shadow: 70% of the opaque width, a quarter of that high, centred under the feet a pixel or two below, two nested ellipses.
function Test_R3Shadow() {
    var _s = TextFit_Begin();
    var _sizes = TextFit_Sizes();
    var _bad = "";
    var _bad_ground = "";
    for (var _z = 0; _z < array_length(_sizes); _z++) {
        TextFit_Set(_sizes[_z][0], _sizes[_z][1], "en");
        var _ws = Display_WorldScale();
        var _bottom0 = undefined;
        for (var _id = ENEMY_SLIME; _id <= ENEMY_FINAL_BOSS; _id++) {
            var _bc = Test_R3Make(_id, "", 0, false, false);
            var _er = Battle_EnemyRect(_bc);
            var _sh = Battle_EnemyShadowRect(_bc);
            var _tag = string(_id) + "@" + string(_sizes[_z][0]) + " ";
            if (abs(_sh.w - _er.w * 0.7) > 2) _bad += _tag + "w=" + string(_sh.w) + "/" + string(_er.w * 0.7) + " ";
            if (abs(_sh.h - _sh.w * 0.25) > 2) _bad += _tag + "h=" + string(_sh.h) + " ";
            if (abs((_sh.x + _sh.w * 0.5) - (_er.x + _er.w * 0.5)) > 1.5) _bad += _tag + "cx ";
            var _below = (_sh.y + _sh.h * 0.5) - (_er.y + _er.h);
            if (_below < _ws - 1 || _below > 2 * _ws + 1) _bad += _tag + "below=" + string(_below) + " ";
            if (!(_sh.iw > 0 && _sh.iw < _sh.w && _sh.ih > 0 && _sh.ih < _sh.h && abs((_sh.ix + _sh.iw * 0.5) - (_sh.x + _sh.w * 0.5)) <= 1.5)) _bad += _tag + "inner ";
            if (is_undefined(_bottom0)) _bottom0 = _er.y + _er.h;
            else if (_er.y + _er.h != _bottom0) _bad_ground += _tag;
            instance_destroy(_bc.enemy_inst);
        }
    }
    Test_Eq("r3bvis shadow: width 70% of the opaque width, height a quarter of it, under the feet, an inner ellipse (" + _bad + ")", _bad, "");
    Test_Eq("r3bvis shadow: the feet of every enemy are on one GUI y at every size (" + _bad_ground + ")", _bad_ground, "");
    TextFit_End(_s);

    // it scales with the sprite's draw scale (push-in, recoil) and fades with the enemy
    var _spr = EnemyDB_Get(ENEMY_SLIME).sprite;
    var _a = Battle_EnemyShadowGeom(_spr, 100, 50, 3, 3, 3);
    var _b = Battle_EnemyShadowGeom(_spr, 100, 50, 6, 6, 3);
    var _c = Battle_EnemyShadowGeom(_spr, 100, 50, 3, 1.5, 3);
    Test_True("r3bvis shadow: twice the draw scale is twice as wide and as high", _a.w > 0 && abs(_b.w / _a.w - 2) < 0.05 && abs(_b.h / _a.h - 2) < 0.1);
    Test_True("r3bvis shadow: a squashed sprite (recoil) keeps its width and loses height", _c.w > 0 && abs(_c.w - _a.w) <= 1 && abs(_c.h / _a.h - 0.5) < 0.1);
    var _f1 = Battle_EnemyShadowAlpha(1);
    var _f2 = Battle_EnemyShadowAlpha(0.5);
    var _f0 = Battle_EnemyShadowAlpha(0);
    Test_True("r3bvis shadow: outer 0.25 and inner 0.4 at full strength", abs(_f1.outer - 0.25) < 0.001 && abs(_f1.inner - 0.4) < 0.001);
    Test_True("r3bvis shadow: half faded is half as strong, faded out is gone", abs(_f2.outer - 0.125) < 0.001 && abs(_f2.inner - 0.2) < 0.001 && _f0.outer == 0 && _f0.inner == 0);
}

// 3. Plate and chips: clear of the opaque sprite and of each other, on screen, under the strip (and the skill banner), above the player panel, no chip cut.
function Test_R3Layout() {
    var _s = TextFit_Begin();
    var _sizes = TextFit_Sizes();
    var _langs = ["en", "ko"];
    var _cases = [];
    for (var _id = ENEMY_SLIME; _id <= ENEMY_FINAL_BOSS; _id++) {
        array_push(_cases, { id: _id, em: "", nst: 4, brk: true });
        array_push(_cases, { id: _id, em: "", nst: 5, brk: true });
        array_push(_cases, { id: _id, em: "", nst: 0, brk: false });
        if (_id <= ENEMY_KILLER_PLANT) {
            array_push(_cases, { id: _id, em: "regenerating", nst: 4, brk: true });
            array_push(_cases, { id: _id, em: "venomous", nst: 5, brk: true });
            array_push(_cases, { id: _id, em: "armored", nst: 0, brk: false });
        }
    }
    var _f = { plate_sprite: "", chips_sprite: "", chips_plate: "", screen: "", strip: "", panel: "", count: "", cut: "", name: "", setup: "", sprite_room: "" };
    var _n = 0;
    for (var _l = 0; _l < 2; _l++) {
        for (var _z = 0; _z < array_length(_sizes); _z++) {
            TextFit_Set(_sizes[_z][0], _sizes[_z][1], _langs[_l]);
            var _gw = Display_GuiW();
            var _gh = Display_GuiH();
            var _mt = Ui_Metrics();
            for (var _c = 0; _c < array_length(_cases); _c++) {
                for (var _ban = 0; _ban < 2; _ban++) {
                    var _k = _cases[_c];
                    var _bc = Test_R3Make(_k.id, _k.em, _k.nst, _k.brk, _ban == 1);
                    var _tag = _langs[_l] + " " + string(_sizes[_z][0]) + " e" + string(_k.id) + _k.em + " st" + string(_k.nst) + (_k.brk ? "+brk" : "") + (_ban == 1 ? " banner" : "") + "; ";
                    _n++;
                    var _hdr = Battle_EnemyHeaderRect(_bc);
                    var _er = Battle_EnemyRect(_bc);
                    var _pl = Test_R3Rect(_hdr.x1, _hdr.y1, _hdr.bw, _hdr.h);
                    if (!variable_struct_exists(_hdr, "chips_rect")) { _f.setup = "no chips_rect on the header rect"; instance_destroy(_bc.enemy_inst); continue; }
                    var _cr = _hdr.chips_rect;
                    var _nchips = array_length(Battle_FighterChips(_bc, TL_ENEMY));
                    var _have = _nchips > 0;
                    var _top = Battle_TimelineBottom();
                    var _ban_r = Battle_BannerRect(_bc);
                    if (is_struct(_ban_r)) _top = max(_top, _ban_r.y + _ban_r.h);
                    var _zones = Battle_Zones();
                    if (_ban == 0 && ((_k.id < ENEMY_MINI_BOSS && (_er.y < Battle_TimelineBottom() || _er.y + _er.h > _zones.band_top)) || (_k.id >= ENEMY_MINI_BOSS && _langs[_l] == "en" && _er.y + _er.h > _zones.band_top))) _f.sprite_room += _tag + json_stringify(_er) + "; ";
                    if (Test_RectsOverlap(_pl, _er)) _f.plate_sprite += _tag;
                    if (_have && Test_RectsOverlap(_cr, _er)) _f.chips_sprite += _tag;
                    if (_have && Test_RectsOverlap(_cr, _pl)) _f.chips_plate += _tag;
                    if (_pl.x < 0 || _pl.y < 0 || _pl.x + _pl.w > _gw || _pl.y + _pl.h > _gh || (_have && (_cr.x < 0 || _cr.y < 0 || _cr.x + _cr.w > _gw || _cr.y + _cr.h > _gh))) _f.screen += _tag;
                    if (_pl.y < _top || (_have && _cr.y < _top)) _f.strip += _tag;
                    if (Test_RectsOverlap(_pl, _zones.player) || (_have && Test_RectsOverlap(_cr, _zones.player))) _f.panel += _tag + json_stringify(_pl) + json_stringify(_cr) + json_stringify(_zones.player) + _hdr.side + json_stringify(_er) + "; ";
                    if (_have && (_hdr.chips_shown + _hdr.chips_more != _nchips || _hdr.chips_shown < 1)) _f.count += _tag + "shown=" + string(_hdr.chips_shown) + " more=" + string(_hdr.chips_more) + "; ";
                    if (_have && _cr.w > _hdr.chips_max + 2 * _mt.p) _f.cut += _tag + "w=" + string(_cr.w) + " max=" + string(_hdr.chips_max) + "; ";
                    var _nm_all = "";
                    var _nm_bad = false;
                    for (var _nl = 0; _nl < array_length(_hdr.name_lines); _nl++) {
                        _nm_all += ((_nl > 0) ? " " : "") + _hdr.name_lines[_nl];
                        if (_pl.w < UI_TextWidth(_hdr.name_lines[_nl]) + 6 * _mt.p) _nm_bad = true;
                    }
                    if (_nm_all != Battle_EnemyName(_bc.e)) _nm_bad = true;
                    if (_pl.h < 8 * _mt.p + array_length(_hdr.name_lines) * _mt.line_h) _nm_bad = true;
                    if (_nm_bad) _f.name += _tag + "w=" + string(_pl.w) + " " + _hdr.side + " " + json_stringify(_hdr.name_lines) + "; ";
                    instance_destroy(_bc.enemy_inst);
                }
            }
        }
    }
    Test_True("r3bvis layout: (setup) " + string(_n) + " layouts were looked at", _n >= 600);
    Test_Eq("r3bvis layout: (setup) the header rect exposes the chip row", _f.setup, "");
    Test_Eq("r3bvis layout: the sprite stands between the turn strip and the player panel (a boss only has to clear the panel, and in English: too tall to clear both bars at every size)", _f.sprite_room, "");
    Test_Eq("r3bvis layout: the plate never covers the enemy's opaque sprite", _f.plate_sprite, "");
    Test_Eq("r3bvis layout: the chip row never covers the enemy's opaque sprite", _f.chips_sprite, "");
    Test_Eq("r3bvis layout: the chip row and the plate do not overlap", _f.chips_plate, "");
    Test_Eq("r3bvis layout: plate and chips are fully on screen", _f.screen, "");
    Test_Eq("r3bvis layout: plate and chips stay under the turn strip and the banner", _f.strip, "");
    Test_Eq("r3bvis layout: plate and chips stay off the player panel", _f.panel, "");
    Test_Eq("r3bvis layout: every chip is shown or counted in a plus chip, at least one shown", _f.count, "");
    Test_Eq("r3bvis layout: the chip row is never wider than the room it was given (no cut label)", _f.cut, "");
    Test_Eq("r3bvis layout: every line of the name (the whole name, on one line or two) fits inside the plate", _f.name, "");
    TextFit_End(_s);
}

// 4. The last-turn blink is an outline round the chip's icon cell and a label that toggles white / light green (I-108), never a filled box; it follows the turns left.
function Test_R3Blink() {
    var _on = Battle_ChipBlink(true, true, 0);
    var _off = Battle_ChipBlink(true, true, 250);
    var _on2 = Battle_ChipBlink(true, false, 500);
    Test_True("r3bvis blink: on the lit beat of the last turn the icon cell is outlined", _on.outline);
    Test_True("r3bvis blink: on the dark beat (250 ms later) the outline is off", !_off.outline);
    Test_True("r3bvis blink: and it is on again 500 ms in", _on2.outline);
    Test_True("r3bvis blink: never a filled box, on either beat", !_on.box && !_off.box && !_on2.box);
    Test_True("r3bvis blink: the label is white on the lit beat and light green on the dark beat", _on.label_col == UI_C_TEXT && _off.label_col == UI_C_LIGHT && _on2.label_col == UI_C_TEXT);
    var _calm = Battle_ChipBlink(false, true, 0);
    var _calm2 = Battle_ChipBlink(false, false, 0);
    Test_True("r3bvis blink: a chip with turns left does not blink: no outline, no box", !_calm.outline && !_calm.box && !_calm2.outline && !_calm2.box);
    Test_True("r3bvis blink: its label is plain white, a debuff or a buff (I-108)", _calm.label_col == UI_C_TEXT && _calm2.label_col == UI_C_TEXT);

    // R-094: a bleed blinks on its last TURN, not because its stack count is 1
    var _ch = CharacterCreate_Player(CLASS_KNIGHT);
    _ch = Status_Add(_ch, STATUS_BLEED, 3, 0, 1);
    var _c1 = Battle_StatusChips(_ch)[0];
    Test_Eq("r3bvis blink: (setup) one bleed stack reads BLD 1", _c1.label, "BLD 1");
    Test_True("r3bvis blink: a bleed with 1 stack and 3 turns left does not blink", !_c1.last);
    var _ch2 = CharacterCreate_Player(CLASS_KNIGHT);
    _ch2 = Status_Add(_ch2, STATUS_BLEED, 1, 0, 3);
    var _c2 = Battle_StatusChips(_ch2)[0];
    Test_True("r3bvis blink: a bleed with 3 stacks and its last turn blinks", _c2.last);
    var _ch3 = CharacterCreate_Player(CLASS_KNIGHT);
    _ch3 = Status_Add(_ch3, STATUS_POISON, 0, 0, 1);
    _ch3 = Status_Add(_ch3, STATUS_BURN, 1, 3);
    var _c3 = Battle_StatusChips(_ch3);
    Test_True("r3bvis blink: a poison never blinks (its count is stacks)", !_c3[0].last);
    Test_True("r3bvis blink: a burn on its last turn blinks", _c3[1].last);
}

// ============================================================================================================
// Packet saves1 (D175): up to 4 profiles, each with 3 save files. Every test runs in a sandbox: a file-name prefix of its own (global.save_prefix) and its own in-memory
// profile index / profile, so the real scratch profile the other suites use is never touched. Expected values come from the packet brief, not from the code.
// ============================================================================================================
function Test_Suite_Profiles() {
    Test_RunSuite("Profiles.versions", Test_ProfVersions);
    Test_RunSuite("Profiles.create", Test_ProfCreateRun);
    Test_RunSuite("Profiles.separate", Test_ProfSeparateRun);
    Test_RunSuite("Profiles.delete", Test_ProfDeleteRun);
    Test_RunSuite("Profiles.slots", Test_ProfSlotsRun);
    Test_RunSuite("Profiles.slotdelete", Test_ProfSlotDeleteRun);
    Test_RunSuite("Profiles.continue", Test_ProfContinueRun);
    Test_RunSuite("Profiles.migrate", Test_ProfMigrateRun);
    Test_RunSuite("Profiles.migrate_locked", Test_ProfMigrateLockedRun);
    Test_RunSuite("Profiles.migrate_partial", Test_ProfMigratePartialRun);
    Test_RunSuite("Profiles.index", Test_ProfIndexRun);
    Test_RunSuite("Profiles.reset", Test_ProfResetRun);
    Test_RunSuite("Profiles.runsummary", Test_ProfRunSummary);
}

function Test_ProfCreateRun() { Test_ProfRun("tp1_", Test_ProfCreate); }
function Test_ProfSeparateRun() { Test_ProfRun("tp2_", Test_ProfSeparate); }
function Test_ProfDeleteRun() { Test_ProfRun("tp3_", Test_ProfDelete); }
function Test_ProfSlotsRun() { Test_ProfRun("tp4_", Test_ProfSlots); }
function Test_ProfSlotDeleteRun() { Test_ProfRun("tp5_", Test_ProfSlotDelete); }
function Test_ProfContinueRun() { Test_ProfRun("tp6_", Test_ProfContinue); }
function Test_ProfMigrateRun() { Test_ProfRun("tp7_", Test_ProfMigrate); }
function Test_ProfMigrateLockedRun() { Test_ProfRun("tp8_", Test_ProfMigrateLocked); }
function Test_ProfMigratePartialRun() { Test_ProfRun("tp9_", Test_ProfMigratePartial); }
function Test_ProfIndexRun() { Test_ProfRun("tpa_", Test_ProfIndex); }
function Test_ProfResetRun() { Test_ProfRun("tpb_", Test_ProfReset); }

// Runs _fn inside a sandbox with the given file prefix; always puts the globals back and removes the files.
function Test_ProfRun(_prefix, _fn) {
    var _saved = {
        prefix: variable_global_exists("save_prefix") ? global.save_prefix : "",
        index: variable_global_exists("profiles_index") ? global.profiles_index : undefined,
        profile: variable_global_exists("profile") ? global.profile : undefined,
        status: variable_global_exists("profile_status") ? global.profile_status : "missing",
        slot: variable_global_exists("save_slot_active") ? global.save_slot_active : 0
    };
    Test_ProfClean(_prefix);
    global.save_prefix = _prefix;
    global.profiles_index = undefined;
    global.profile = undefined;
    global.profile_status = "missing";
    global.save_slot_active = 0;
    Loc_SetLanguage("en");
    try {
        _fn(_prefix);
    } catch (_e) {
        global.test.errors++;
        Test_Log("[TEST] ERROR profiles sandbox " + _prefix + " " + string(_e.message));
    }
    Test_ProfClean(_prefix);
    global.save_prefix = _saved.prefix;
    global.profiles_index = _saved.index;
    global.profile = _saved.profile;
    global.profile_status = _saved.status;
    global.save_slot_active = _saved.slot;
}

function Test_ProfDeleteAll(_path) {
    var _tails = ["", ".pre-profiles", ".corrupt"];
    for (var _t = 0; _t < array_length(_tails); _t++) {
        Save_DeleteFileSet(_path + _tails[_t]);
    }
    if (file_exists(_path + ".bak.pre-profiles")) file_delete(_path + ".bak.pre-profiles");
    var _kept = RunSave_KeptFiles(_path);
    for (var _k = 0; _k < array_length(_kept); _k++) Save_DeleteFileSet(_kept[_k]);
}

function Test_ProfClean(_prefix) {
    Test_ProfDeleteAll(_prefix + "profiles.sav");
    Test_ProfDeleteAll(_prefix + "profile.sav");
    Test_ProfDeleteAll(_prefix + "run.sav");
    for (var _i = 0; _i < 4; _i++) {
        Test_ProfDeleteAll(_prefix + "profile_" + string(_i) + ".sav");
        for (var _s = 0; _s < 3; _s++) Test_ProfDeleteAll(_prefix + "run_" + string(_i) + "_" + string(_s) + ".sav");
    }
}

// Forget the in-memory index and profile: the next call reads profiles.sav again, like a new launch.
function Test_ProfRelaunch() {
    global.profiles_index = undefined;
    global.profile = undefined;
    global.profile_status = "missing";
}

function Test_ProfIds() {
    var _l = Profiles_List();
    var _out = [];
    for (var _i = 0; _i < array_length(_l); _i++) array_push(_out, _l[_i].id);
    return _out;
}

function Test_ProfEntry(_id) {
    var _l = Profiles_List();
    for (var _i = 0; _i < array_length(_l); _i++) if (_l[_i].id == _id) return _l[_i];
    return undefined;
}

function Test_ProfName(_id) {
    var _e = Test_ProfEntry(_id);
    return is_struct(_e) ? _e.name : "<none>";
}

// A run file as JSON text. Version 3 carries the summary block; version 2 does not. _ms < 0: no play time recorded.
function Test_ProfRunText(_ver, _seed, _cls, _level, _floor, _ms, _saved) {
    var _r = {
        run_version: _ver, seed: _seed, floor: _floor, gold: 10, kills: 2, rng: {},
        statData: { selected_class: _cls, player: { class_id: _cls, level: _level }, save_room_name: "rm_floor" + string(_floor), saved_at: _saved }
    };
    if (_ms >= 0) _r.stats = { play_ms: _ms };
    if (_ver >= 3) _r.summary = { class_id: _cls, level: _level, floor: _floor, run_time_ms: _ms, seed: _seed, saved_at: _saved };
    return json_stringify(_r);
}

function Test_ProfPutRun(_path, _ver, _seed, _cls, _level, _floor, _ms, _saved) {
    return Save_WriteFileAtomic(_path, Test_ProfRunText(_ver, _seed, _cls, _level, _floor, _ms, _saved), RunSave_IsCurrentRaw);
}

function Test_ProfVersions() {
    Test_Eq("profiles: PROFILE_VERSION is 3 (adds name)", PROFILE_VERSION, 3);
    Test_Eq("profiles: RUN_SAVE_VERSION is 4 (adds VIG and MND)", RUN_SAVE_VERSION, 4);
    Test_Eq("profiles: the default profile has an empty name until the index gives one", Profile_Default().name, "");
    Test_Eq("profiles: a v3 profile keeps its name copy", Profile_Normalize({ profile_version: 3, name: "Zed" }).name, "Zed");
    Test_Eq("profiles: a v2 profile has no name (the index is authoritative)", Profile_Normalize({ profile_version: 2, deaths: 1 }).name, "");
    var _v2 = json_parse(Test_ProfRunText(2, 5, CLASS_KNIGHT, 3, 2, 9000, 40));
    var _v1 = json_parse(Test_ProfRunText(1, 5, CLASS_KNIGHT, 3, 2, 9000, 40));
    var _v3 = json_parse(Test_ProfRunText(3, 5, CLASS_KNIGHT, 3, 2, 9000, 40));
    var _v4 = json_parse(Test_ProfRunText(4, 5, CLASS_KNIGHT, 3, 2, 9000, 40));
    var _v5 = json_parse(Test_ProfRunText(5, 5, CLASS_KNIGHT, 3, 2, 9000, 40));
    Test_Eq("profiles: a v2 run file is still ok (migrated, not refused)", RunSave_Check(_v2), "ok");
    Test_Eq("profiles: a v3 run file is ok", RunSave_Check(_v3), "ok");
    Test_Eq("profiles: a v1 run file is old", RunSave_Check(_v1), "old");
    Test_Eq("profiles: a v4 run file is ok (D176)", RunSave_Check(_v4), "ok");
    Test_Eq("profiles: a run file one version ahead is newer", RunSave_Check(_v5), "newer");
    Test_True("profiles: a v2 run file passes the write validator", RunSave_IsCurrentRaw(_v2));
    // loading a v2 file migrates it in memory: it comes back as the current version (4, D176) with a summary block derived from what the file has
    var _f = "test_prof_v2_run.sav";
    Save_DeleteFileSet(_f);
    Test_RawWrite(_f, Test_ProfRunText(2, 5, CLASS_KNIGHT, 3, 2, 9000, 40));
    var _l = RunSave_LoadFrom(_f);
    Test_Eq("profiles: a v2 run file loads with status ok", _l.status, "ok");
    Test_Eq("profiles: and comes back as version 4", _l.status == "ok" ? _l.run.run_version : -1, 4);
    Test_True("profiles: with a summary block", _l.status == "ok" && variable_struct_exists(_l.run, "summary") && is_struct(_l.run.summary));
    if (_l.status == "ok" && variable_struct_exists(_l.run, "summary")) {
        Test_Eq("profiles: derived summary class", _l.run.summary.class_id, CLASS_KNIGHT);
        Test_Eq("profiles: derived summary level", _l.run.summary.level, 3);
        Test_Eq("profiles: derived summary floor", _l.run.summary.floor, 2);
        Test_Eq("profiles: derived summary run time", _l.run.summary.run_time_ms, 9000);
        Test_Eq("profiles: derived summary seed", _l.run.summary.seed, 5);
        Test_Eq("profiles: derived summary saved_at", _l.run.summary.saved_at, 40);
    }
    Save_DeleteFileSet(_f);
}

function Test_ProfCreate(_p) {
    var _l0 = Profiles_List();
    Test_Eq("profiles: a fresh save folder starts with one profile", array_length(_l0), 1);
    Test_Eq("profiles: it is named Profile 1", Test_ProfName(0), "Profile 1");
    Test_Eq("profiles: it is id 0 and the active one", Profiles_Active(), 0);
    Test_True("profiles: the index file was written", file_exists(_p + "profiles.sav"));
    Test_True("profiles: the first profile's file was written", file_exists(_p + "profile_0.sav"));
    Test_Eq("profiles: Profile_Path is the active profile's file", Profile_Path(), _p + "profile_0.sav");
    Test_Eq("profiles: RunSave_Path is the active profile's save file 1", RunSave_Path(), _p + "run_0_0.sav");
    Test_Eq("profiles: the index says version 1", json_parse(Test_RawRead(_p + "profiles.sav")).index_version, 1);
    // names: trimmed, limited to 12, empty refused
    Test_Eq("profiles: create returns the next id", Profiles_Create("  Ann  "), 1);
    Test_Eq("profiles: the name is trimmed", Test_ProfName(1), "Ann");
    Test_Eq("profiles: a long name is accepted", Profiles_Create("ABCDEFGHIJKLMNOP"), 2);
    Test_Eq("profiles: the name is limited to 12 letters", Test_ProfName(2), "ABCDEFGHIJKL");
    Test_Eq("profiles: an empty name is refused", Profiles_Create(""), -1);
    Test_Eq("profiles: a blank name is refused", Profiles_Create("    "), -1);
    Test_Eq("profiles: a refused name made no profile", array_length(Profiles_List()), 3);
    Test_Eq("profiles: the 4th profile gets id 3", Profiles_Create("Dee"), 3);
    Test_Eq("profiles: the 5th is refused", Profiles_Create("Eve"), -1);
    Test_Eq("profiles: there are 4", array_length(Profiles_List()), 4);
    Test_Eq("profiles: the list is sorted by id", string(Test_ProfIds()), string([0, 1, 2, 3]));
    Test_True("profiles: a created profile has its own file", file_exists(_p + "profile_3.sav"));
    // it is all on disk
    Test_ProfRelaunch();
    Test_Eq("profiles: after a relaunch the 4 profiles are still there", array_length(Profiles_List()), 4);
    Test_Eq("profiles: names survive", Test_ProfName(2), "ABCDEFGHIJKL");
    Test_Eq("profiles: the active one survives", Profiles_Active(), 0);
    // rename
    Test_True("profiles: rename works", Profiles_Rename(1, "  Zed "));
    Test_Eq("profiles: rename trims", Test_ProfName(1), "Zed");
    Test_False("profiles: rename to empty is refused", Profiles_Rename(1, ""));
    Test_Eq("profiles: a refused rename keeps the name", Test_ProfName(1), "Zed");
    Test_False("profiles: rename of an unknown id is refused", Profiles_Rename(9, "Nope"));
    Test_True("profiles: rename limits to 12 letters", Profiles_Rename(0, "ABCDEFGHIJKLMNOP"));
    Test_Eq("profiles: the renamed active profile is cut to 12", Test_ProfName(0), "ABCDEFGHIJKL");
    Test_ProfRelaunch();
    Test_Eq("profiles: a rename is saved in the index", Test_ProfName(1), "Zed");
    Test_Eq("profiles: and in the profile file's name copy", Profile_Load(_p + "profile_1.sav").profile.name, "Zed");
    Test_Eq("profiles: and for the active profile too", Profile_Load(_p + "profile_0.sav").profile.name, "ABCDEFGHIJKL");
    // a freed id is reused
    Test_True("profiles: delete works", Profiles_Delete(2));
    Test_Eq("profiles: the lowest free id is reused", Profiles_Create("New"), 2);
    Test_True("profiles: switch works", Profiles_Switch(2));
    Test_Eq("profiles: Profile_Path follows the active profile", Profile_Path(), _p + "profile_2.sav");
    Test_Eq("profiles: and its save file 1", RunSave_Path(), _p + "run_2_0.sav");
}

function Test_ProfSeparate(_p) {
    var _intro = Story_CutsceneKey("intro");
    var _end = Story_CutsceneKey("ending");
    Test_False("profiles: profile A has not seen the intro", Story_Seen(_intro));
    Story_Mark(_intro);
    Codex_RecordMeeting(0, false);
    Test_True("profiles: A has seen the intro", Story_Seen(_intro));
    var _b = Profiles_Create("Bea");
    Test_True("profiles: switching to B works", Profiles_Switch(_b));
    Test_Eq("profiles: B is active", Profiles_Active(), _b);
    Test_False("profiles: B has not seen the intro (a new profile starts fresh)", Story_Seen(_intro));
    Test_Eq("profiles: B's Codex is empty", Codex_BestiaryCount(Profile_Get()), 0);
    Test_Eq("profiles: B starts without runs", Profile_Get().runs_started, 0);
    Test_Eq("profiles: the status of a fresh profile file is ok", global.profile_status, "ok");
    Story_Mark(_end);
    Test_True("profiles: B has seen the ending", Story_Seen(_end));
    Test_True("profiles: switching back to A works", Profiles_Switch(0));
    Test_True("profiles: A still has the intro", Story_Seen(_intro));
    Test_False("profiles: A has not seen B's ending", Story_Seen(_end));
    Test_Eq("profiles: A keeps its Codex entry", Codex_BestiaryCount(Profile_Get()), 1);
    // the data is on disk per profile
    var _da = Profile_Load(_p + "profile_0.sav").profile;
    var _db = Profile_Load(_p + "profile_" + string(_b) + ".sav").profile;
    Test_True("profiles: A's file holds the intro, not the ending", Profile_StorySeen(_da, _intro) && !Profile_StorySeen(_db, _intro) && !Profile_StorySeen(_da, _end));
    Test_True("profiles: B's file holds the ending", Profile_StorySeen(_db, _end));
    Test_Eq("profiles: the file name copy is the index name", _db.name, "Bea");
    // after a relaunch the same
    Test_ProfRelaunch();
    Test_True("profiles: after a relaunch A still has the intro", Story_Seen(_intro));
    Test_False("profiles: switching to a profile that does not exist is refused", Profiles_Switch(3));
    Test_Eq("profiles: and the active profile is unchanged", Profiles_Active(), 0);
    // switching flushes the profile it leaves
    Profile_Get().deaths = 7;
    Profiles_Switch(_b);
    Test_Eq("profiles: leaving a profile saved what it held", Profile_Load(_p + "profile_0.sav").profile.deaths, 7);
    Profiles_Switch(0);
    Test_Eq("profiles: and it is back after switching in", Profile_Get().deaths, 7);
    // the save file in use follows the profile
    Slot_SetActive(2);
    Profiles_Switch(_b);
    Test_Eq("profiles: B starts on its own save file 1", RunSave_Path(), _p + "run_" + string(_b) + "_0.sav");
    Profiles_Switch(0);
    Test_Eq("profiles: A comes back on the save file it last used", RunSave_Path(), _p + "run_0_2.sav");
}

function Test_ProfDelete(_p) {
    var _b = Profiles_Create("Bea");
    var _c = Profiles_Create("Cy");
    Test_ProfPutRun(_p + "run_1_0.sav", 3, 11, CLASS_KNIGHT, 2, 1, 1000, 10);
    Test_ProfPutRun(_p + "run_1_2.sav", 3, 12, CLASS_MAGE, 2, 1, 1000, 11);
    Test_True("profiles: B's runs exist", RunSave_ExistsAt(_p + "run_1_0.sav") && RunSave_ExistsAt(_p + "run_1_2.sav"));
    Profiles_Switch(_b);
    Story_Mark("cutscene:intro");
    Test_True("profiles: delete the active profile", Profiles_Delete(_b));
    Test_Eq("profiles: the lowest remaining profile becomes active", Profiles_Active(), 0);
    Test_Eq("profiles: the list is 0 and 2", string(Test_ProfIds()), string([0, 2]));
    Test_False("profiles: the deleted profile's file is gone", file_exists(_p + "profile_1.sav"));
    Test_False("profiles: and its run files", RunSave_ExistsAt(_p + "run_1_0.sav") || RunSave_ExistsAt(_p + "run_1_2.sav"));
    Test_False("profiles: the profile now loaded is not the deleted one's", Story_Seen("cutscene:intro"));
    Profile_Flush();
    Test_False("profiles: the deleted profile's file did not come back on a flush", file_exists(_p + "profile_1.sav"));
    Test_False("profiles: deleting an unknown id is refused", Profiles_Delete(3));
    Test_True("profiles: deleting a profile that is not active keeps the active one", Profiles_Delete(_c) && Profiles_Active() == 0);
    Test_Eq("profiles: one left", string(Test_ProfIds()), string([0]));
    Story_Mark("cutscene:intro");
    Test_True("profiles: delete the last profile", Profiles_Delete(0));
    Test_Eq("profiles: a fresh profile is made", array_length(Profiles_List()), 1);
    Test_Eq("profiles: it is id 0, active", Profiles_Active(), 0);
    Test_Eq("profiles: it is named Profile 1", Test_ProfName(0), "Profile 1");
    Test_False("profiles: it is fresh, nothing seen", Story_Seen("cutscene:intro"));
    Test_True("profiles: and it has its file", file_exists(_p + "profile_0.sav"));
    Test_ProfRelaunch();
    Test_Eq("profiles: after a relaunch it is still the only one", string(Test_ProfIds()), string([0]));
}

function Test_ProfSlots(_p) {
    var _r0 = _p + "run_0_0.sav";
    var _r1 = _p + "run_0_1.sav";
    var _r2 = _p + "run_0_2.sav";
    Test_ProfPutRun(_r0, 3, 111, CLASS_KNIGHT, 4, 2, 125000, 5);
    Test_ProfPutRun(_r2, 2, 222, CLASS_MAGE, 7, 5, 300000, 9);   // a version 2 file: no summary block
    var _s = Slots_Summary(0);
    Test_Eq("slots: three entries", array_length(_s), 3);
    Test_Eq("slots: entry 0 has slot 0", _s[0].slot, 0);
    Test_True("slots: slot 0 exists", _s[0].exists);
    Test_Eq("slots: slot 0 is ok", _s[0].status, "ok");
    Test_Eq("slots: slot 0 class", _s[0].class_id, CLASS_KNIGHT);
    Test_Eq("slots: slot 0 level", _s[0].level, 4);
    Test_Eq("slots: slot 0 floor", _s[0].floor, 2);
    Test_Eq("slots: slot 0 run time", _s[0].run_time_ms, 125000);
    Test_Eq("slots: slot 0 seed", _s[0].seed, 111);
    Test_Eq("slots: slot 0 saved_at", _s[0].saved_at, 5);
    Test_False("slots: slot 1 does not exist", _s[1].exists);
    Test_Eq("slots: slot 1 is empty", _s[1].status, "empty");
    Test_Eq("slots: slot 2 is ok", _s[2].status, "ok");
    Test_Eq("slots: slot 2 (a v2 file) class", _s[2].class_id, CLASS_MAGE);
    Test_Eq("slots: slot 2 level", _s[2].level, 7);
    Test_Eq("slots: slot 2 floor", _s[2].floor, 5);
    Test_Eq("slots: slot 2 run time", _s[2].run_time_ms, 300000);
    Test_Eq("slots: slot 2 seed", _s[2].seed, 222);
    Test_Eq("slots: first empty is slot 1", Slots_FirstEmpty(0), 1);
    // the other statuses
    Test_RawWrite(_r1, "{{ not json");
    Test_Eq("slots: a damaged file is corrupt", Slots_Summary(0)[1].status, "corrupt");
    Test_True("slots: a damaged file exists", Slots_Summary(0)[1].exists);
    Test_Eq("slots: a damaged file is not an empty slot", Slots_FirstEmpty(0), -1);
    Test_RawWrite(_r1, json_stringify({ run_version: 99, seed: 1 }));
    Test_Eq("slots: a newer file is newer", Slots_Summary(0)[1].status, "newer");
    Test_RawWrite(_r1, json_stringify({ seed: 1, statData: {} }));
    Test_Eq("slots: a file without a version is old", Slots_Summary(0)[1].status, "old");
    Test_Eq("slots: an unreadable slot shows its fields as missing (class)", Slots_Summary(0)[1].class_id, -1);
    Test_Eq("slots: an unreadable slot shows its fields as missing (run time)", Slots_Summary(0)[1].run_time_ms, -1);
    // a v2 file without a play time: that field is missing
    Test_ProfPutRun(_r1, 2, 333, CLASS_ARCHER, 2, 1, -1, 12);
    Test_Eq("slots: a file without a play time lists it as missing", Slots_Summary(0)[1].run_time_ms, -1);
    Test_Eq("slots: but the rest is there", Slots_Summary(0)[1].seed, 333);
    Test_Eq("slots: all three used, no empty slot", Slots_FirstEmpty(0), -1);
    // another profile has its own slots
    var _b = Profiles_Create("Bea");
    Test_Eq("slots: a new profile has all three empty", Slots_FirstEmpty(_b), 0);
    Test_Eq("slots: and lists them empty", Slots_Summary(_b)[0].status + Slots_Summary(_b)[1].status + Slots_Summary(_b)[2].status, "emptyemptyempty");
    Test_Eq("slots: an unknown profile has no slots", Slots_FirstEmpty(3), -1);
    // the active slot
    Test_Eq("slots: the active slot starts at 0", Slot_Active(), 0);
    Slot_SetActive(2);
    Test_Eq("slots: setting it changes RunSave_Path", RunSave_Path(), _r2);
    Test_Eq("slots: and Slot_Active", Slot_Active(), 2);
    Slot_SetActive(7);
    Test_Eq("slots: a slot outside 0..2 is refused (keeps the last)", Slot_Active(), 2);
    Test_True("slots: RunSave_HasSave reads the active slot", RunSave_HasSave());
    RunSave_Delete();
    Test_False("slots: RunSave_Delete removes the active slot's file", RunSave_ExistsAt(_r2));
    Test_True("slots: and leaves the others", RunSave_ExistsAt(_r0) && RunSave_ExistsAt(_r1));
    Test_Eq("slots: the freed slot is the first empty", Slots_FirstEmpty(0), 2);
    Slot_SetActive(1);
    Test_Eq("slots: RunSave_Path follows the slot", RunSave_Path(), _r1);
}

function Test_ProfSlotDelete(_p) {
    var _r0 = _p + "run_0_0.sav";
    Test_ProfPutRun(_r0, 3, 444, CLASS_KNIGHT, 5, 3, 60000, 7);
    Test_Eq("slot delete: no history yet", array_length(Profile_Get().history), 0);
    Test_True("slot delete: a saved run is deleted", Slot_Delete(0, 0));
    Test_False("slot delete: the file set is gone", file_exists(_r0) || file_exists(_r0 + ".bak"));
    Test_Eq("slot delete: it counts as one abandoned run", array_length(Profile_Get().history), 1);
    if (array_length(Profile_Get().history) == 1) {
        var _h = Profile_Get().history[0];
        Test_Eq("slot delete: the entry says abandoned", _h.result, "abandoned");
        Test_Eq("slot delete: the entry keeps the seed", _h.seed, 444);
        Test_Eq("slot delete: the entry keeps the class", _h.class_id, CLASS_KNIGHT);
        Test_Eq("slot delete: the entry keeps the level", _h.level, 5);
    }
    Test_Eq("slot delete: the history is written to the profile file", array_length(Profile_Load(Profile_Path()).profile.history), 1);
    Test_False("slot delete: an empty slot has nothing to delete", Slot_Delete(0, 1));
    Test_Eq("slot delete: and records nothing", array_length(Profile_Get().history), 1);
    Test_False("slot delete: a slot outside 0..2 is refused", Slot_Delete(0, 5));
    // a run of another profile is recorded in that profile, not the active one
    var _b = Profiles_Create("Bea");
    var _rb = _p + "run_" + string(_b) + "_1.sav";
    Test_ProfPutRun(_rb, 3, 555, CLASS_MAGE, 2, 1, 1000, 8);
    Test_True("slot delete: a slot of another profile", Slot_Delete(_b, 1));
    Test_False("slot delete: its file is gone", RunSave_ExistsAt(_rb));
    Test_Eq("slot delete: the active profile's history is unchanged", array_length(Profile_Get().history), 1);
    var _pb = Profile_Load(_p + "profile_" + string(_b) + ".sav").profile;
    Test_Eq("slot delete: the other profile's file got the abandoned entry", array_length(_pb.history) == 1 ? _pb.history[0].seed : -1, 555);
    // a damaged file is not destroyed: it is moved aside and the slot is empty
    var _r2 = _p + "run_0_2.sav";
    Test_RawWrite(_r2, "{{ not json");
    Test_True("slot delete: a damaged slot can be cleared", Slot_Delete(0, 2));
    Test_False("slot delete: the slot is empty", RunSave_ExistsAt(_r2));
    Test_Eq("slot delete: but the damaged file is kept next to it", array_length(RunSave_KeptFiles(_r2)), 1);
    Test_Eq("slot delete: and records no history for it", array_length(Profile_Get().history), 1);
}

function Test_ProfContinue(_p) {
    Test_Eq("continue: no saves, nothing to continue", Slots_ContinueTarget(0), -1);
    Test_ProfPutRun(_p + "run_0_1.sav", 3, 1, CLASS_KNIGHT, 1, 1, 10, 100);
    Test_Eq("continue: last_slot (0) has no file: the only existing slot", Slots_ContinueTarget(0), 1);
    Test_ProfPutRun(_p + "run_0_2.sav", 3, 2, CLASS_MAGE, 1, 1, 10, 200);
    Test_Eq("continue: last_slot has no file: the newest existing slot", Slots_ContinueTarget(0), 2);
    Test_ProfPutRun(_p + "run_0_0.sav", 3, 3, CLASS_ARCHER, 1, 1, 10, 50);
    Test_Eq("continue: last_slot has a file: it wins even when older", Slots_ContinueTarget(0), 0);
    Slot_SetActive(1);
    Test_Eq("continue: the slot last used is the target", Slots_ContinueTarget(0), 1);
    Test_ProfRelaunch();
    Test_Eq("continue: it is remembered across a relaunch", Slots_ContinueTarget(0), 1);
    Test_Eq("continue: and a relaunch starts on it", Slot_Active(), 1);
    Test_Eq("continue: so the old RunSave_Path call is the Continue file", RunSave_Path(), _p + "run_0_1.sav");
    RunSave_Delete(_p + "run_0_1.sav");
    Test_Eq("continue: the file of last_slot is gone: newest of the rest", Slots_ContinueTarget(0), 2);
    RunSave_Delete(_p + "run_0_0.sav");
    RunSave_Delete(_p + "run_0_2.sav");
    Test_Eq("continue: nothing left, Continue is off", Slots_ContinueTarget(0), -1);
    var _b = Profiles_Create("Bea");
    Test_Eq("continue: another profile with no saves has none", Slots_ContinueTarget(_b), -1);
    Test_Eq("continue: an unknown profile has none", Slots_ContinueTarget(3), -1);
}

function Test_ProfLegacyProfileText() {
    return json_stringify({ profile_version: 2, story_seen: { "cutscene:intro": true }, unlocks: { nobody_class: true }, deaths: 3, wins: 1, runs_started: 5, history: [], bestiary: {}, skills_known: { "2": true } });
}

function Test_ProfMigrate(_p) {
    // the owner's files from before profiles: profile.sav and run.sav, both version 2 (the run file written twice so it has a .bak)
    Save_WriteFileAtomic(_p + "profile.sav", Test_ProfLegacyProfileText(), Profile_IsCurrentRaw);
    Test_ProfPutRun(_p + "run.sav", 2, 776, CLASS_KNIGHT, 2, 1, 1, 1);
    Test_ProfPutRun(_p + "run.sav", 2, 777, CLASS_ARCHER, 3, 2, 90000, 30);
    var _legacy_run = Test_RawRead(_p + "run.sav");
    var _legacy_profile = Test_RawRead(_p + "profile.sav");
    Test_True("migrate: the run file has a .bak to carry over", file_exists(_p + "run.sav.bak"));
    Test_False("migrate: no index yet", file_exists(_p + "profiles.sav"));
    var _l = Profiles_List();
    Test_Eq("migrate: one profile", array_length(_l), 1);
    Test_Eq("migrate: it is id 0", _l[0].id, 0);
    Test_Eq("migrate: it is named Profile 1", _l[0].name, "Profile 1");
    Test_Eq("migrate: it is active", Profiles_Active(), 0);
    Test_Eq("migrate: its last slot is 0", _l[0].last_slot, 0);
    Test_True("migrate: profile_0.sav exists", file_exists(_p + "profile_0.sav"));
    Test_True("migrate: run_0_0.sav exists", file_exists(_p + "run_0_0.sav"));
    var _pr = Profile_Load(_p + "profile_0.sav");
    Test_Eq("migrate: the profile loads ok", _pr.status, "ok");
    Test_True("migrate: the story is kept", Profile_StorySeen(_pr.profile, "cutscene:intro"));
    Test_Eq("migrate: the counters are kept", _pr.profile.deaths * 100 + _pr.profile.wins * 10 + _pr.profile.runs_started, 315);
    Test_True("migrate: the unlock and skill memory are kept", Profile_IsUnlocked(_pr.profile, "nobody_class") && Profile_SkillKnown(_pr.profile, 2));
    var _rr = RunSave_LoadFrom(_p + "run_0_0.sav");
    Test_Eq("migrate: the run loads ok", _rr.status, "ok");
    Test_Eq("migrate: it is the owner's run", _rr.status == "ok" ? _rr.run.seed : -1, 777);
    Test_Eq("migrate: the run file is the same text", Test_RawRead(_p + "run_0_0.sav"), _legacy_run);
    Test_True("migrate: the run's .bak came along", file_exists(_p + "run_0_0.sav.bak"));
    Test_Eq("migrate: the profile file is the same text", Test_RawRead(_p + "profile_0.sav"), _legacy_profile);
    Test_True("migrate: the profile original is kept as .pre-profiles", file_exists(_p + "profile.sav.pre-profiles"));
    Test_True("migrate: the run original is kept as .pre-profiles", file_exists(_p + "run.sav.pre-profiles"));
    Test_Eq("migrate: the kept profile is untouched", Test_RawRead(_p + "profile.sav.pre-profiles"), _legacy_profile);
    Test_Eq("migrate: the kept run is untouched", Test_RawRead(_p + "run.sav.pre-profiles"), _legacy_run);
    Test_False("migrate: the old names are free", file_exists(_p + "profile.sav") || file_exists(_p + "run.sav"));
    Test_Eq("migrate: Continue points at the migrated run", Slots_ContinueTarget(0), 0);
    Test_Eq("migrate: the active paths are the migrated files", Profile_Path() + "|" + RunSave_Path(), _p + "profile_0.sav|" + _p + "run_0_0.sav");
    // the second launch does nothing, even if an old-named file shows up again
    var _idx = Test_RawRead(_p + "profiles.sav");
    Test_RawWrite(_p + "profile.sav", json_stringify({ profile_version: 2, deaths: 99 }));
    Test_ProfRelaunch();
    Test_Eq("migrate: the second launch still has one profile", array_length(Profiles_List()), 1);
    Test_Eq("migrate: the index file is unchanged", Test_RawRead(_p + "profiles.sav"), _idx);
    Test_Eq("migrate: the profile is unchanged (deaths still 3)", Profile_Get().deaths, 3);
    Test_True("migrate: a file with the old name is left alone", file_exists(_p + "profile.sav"));
    Test_Eq("migrate: the migrated profile file is unchanged", Test_RawRead(_p + "profile_0.sav"), _legacy_profile);
}

function Test_ProfMigrateLocked(_p) {
    // a profile.sav written by a newer build is copied as it is and still reported as locked
    var _newer = json_stringify({ profile_version: PROFILE_VERSION + 50, deaths: 3, marker: "keep me" });
    Test_RawWrite(_p + "profile.sav", _newer);
    Test_Eq("migrate locked: one profile", array_length(Profiles_List()), 1);
    Test_Eq("migrate locked: the copy is byte for byte the original", Test_RawRead(_p + "profile_0.sav"), _newer);
    Test_Eq("migrate locked: Profile_Load still reports newer", Profile_Load(_p + "profile_0.sav").status, "newer");
    Test_Eq("migrate locked: the game reports it too", Profile_Get().locked, true);
    Test_Eq("migrate locked: and the status is newer", global.profile_status, "newer");
    Test_False("migrate locked: a flush never writes over it", Profile_Flush());
    Test_Eq("migrate locked: the file is unchanged after a flush", Test_RawRead(_p + "profile_0.sav"), _newer);
    Test_True("migrate locked: the original is kept as .pre-profiles", file_exists(_p + "profile.sav.pre-profiles"));
}

function Test_ProfMigratePartial(_p) {
    // only a run.sav exists: the profile is new, the run is save file 1
    Test_ProfPutRun(_p + "run.sav", 2, 888, CLASS_MAGE, 2, 1, 1000, 3);
    Test_Eq("migrate partial: a run with no profile gives one profile", array_length(Profiles_List()), 1);
    Test_True("migrate partial: it has a profile file", file_exists(_p + "profile_0.sav"));
    Test_Eq("migrate partial: the run is save file 1", RunSave_LoadFrom(_p + "run_0_0.sav").status, "ok");
    Test_True("migrate partial: the run original is kept", file_exists(_p + "run.sav.pre-profiles"));
    Test_Eq("migrate partial: Continue is on", Slots_ContinueTarget(0), 0);
    Test_ProfClean(_p);
    Test_ProfRelaunch();
    // only a profile.sav: no save files
    Save_WriteFileAtomic(_p + "profile.sav", Test_ProfLegacyProfileText(), Profile_IsCurrentRaw);
    Test_Eq("migrate partial: a profile with no run gives one profile", array_length(Profiles_List()), 1);
    Test_Eq("migrate partial: its progress is kept", Profile_Get().deaths, 3);
    Test_Eq("migrate partial: Continue is off", Slots_ContinueTarget(0), -1);
    Test_Eq("migrate partial: all three slots are empty", Slots_FirstEmpty(0), 0);
}

function Test_ProfIndex(_p) {
    Profiles_Rename(0, "Ann");
    var _b = Profiles_Create("Bob");
    Profiles_Switch(_b);
    Story_Mark("cutscene:intro");
    Test_ProfPutRun(_p + "run_1_2.sav", 3, 1, CLASS_KNIGHT, 1, 1, 10, 100);
    // a damaged index (and no usable .bak): rebuilt from the profile files, the damaged file is kept
    Test_ProfRelaunch();
    Save_DeleteFileSet(_p + "profiles.sav");
    Test_RawWrite(_p + "profiles.sav", "{{ not json");
    Test_Eq("index: rebuilt with both profiles", string(Test_ProfIds()), string([0, 1]));
    Test_Eq("index: names come from the profile files", Test_ProfName(0) + "|" + Test_ProfName(1), "Ann|Bob");
    Test_Eq("index: the lowest id is active", Profiles_Active(), 0);
    Test_Eq("index: the last slot is the newest save file of that profile", Test_ProfEntry(1).last_slot, 2);
    Test_True("index: the damaged index is kept", file_exists(_p + "profiles.sav.corrupt"));
    Test_True("index: the new index is valid", is_struct(Save_ReadJsonFile(_p + "profiles.sav", Profiles_IndexIsValid)));
    Test_False("index: the active profile did not get the other's story", Story_Seen("cutscene:intro"));
    Profiles_Switch(1);
    Test_True("index: the other profile kept its story", Story_Seen("cutscene:intro"));
    // a valid file of the wrong shape counts as damaged too
    Test_ProfRelaunch();
    Save_DeleteFileSet(_p + "profiles.sav");
    Save_DeleteFileSet(_p + "profiles.sav.corrupt");
    Test_RawWrite(_p + "profiles.sav", json_stringify({ index_version: 1, active: 5, profiles: [] }));
    Test_Eq("index: an empty list is rebuilt", string(Test_ProfIds()), string([0, 1]));
    // a damaged main file with a good .bak: read from the .bak
    Test_ProfRelaunch();
    Profiles_Rename(1, "Bobby");
    Test_True("index: a .bak exists after a second write", file_exists(_p + "profiles.sav.bak"));
    Test_RawWrite(_p + "profiles.sav", "garbage");
    Test_ProfRelaunch();
    Test_Eq("index: the .bak still lists both profiles", array_length(Profiles_List()), 2);
    Test_Eq("index: and the first name", Test_ProfName(0), "Ann");
    // the validator
    Test_False("index: validator refuses 5 profiles", Profiles_IndexIsValid({ index_version: 1, active: 0, profiles: [{ id: 0, name: "a" }, { id: 1, name: "a" }, { id: 2, name: "a" }, { id: 3, name: "a" }, { id: 4, name: "a" }] }));
    Test_False("index: validator refuses duplicate ids", Profiles_IndexIsValid({ index_version: 1, active: 0, profiles: [{ id: 0, name: "a" }, { id: 0, name: "b" }] }));
    Test_False("index: validator refuses an id above 3", Profiles_IndexIsValid({ index_version: 1, active: 0, profiles: [{ id: 4, name: "a" }] }));
    Test_False("index: validator refuses another version", Profiles_IndexIsValid({ index_version: 2, active: 0, profiles: [{ id: 0, name: "a" }] }));
    Test_True("index: validator accepts a good index", Profiles_IndexIsValid({ index_version: 1, active: 0, profiles: [{ id: 0, name: "a", created: 1, last_slot: 0, last_played: 0 }] }));
}

function Test_ProfReset(_p) {
    Profile_Get().deaths = 5;
    Profile_Flush();
    Test_Eq("reset: the profile file has the deaths", Profile_Load(Profile_Path()).profile.deaths, 5);
    Profile_ResetForTest();
    Test_Eq("reset: the profile in memory is fresh", Profile_Get().deaths, 0);
    Test_Eq("reset: and says missing", global.profile_status, "missing");
    Test_False("reset: the profile file is gone", file_exists(Profile_Path()));
    Test_Eq("reset: the profile list is untouched", array_length(Profiles_List()), 1);
    Test_Eq("reset: the path is still the active profile's", Profile_Path(), _p + "profile_0.sav");
}

function Test_ProfRunSummary() {
    var _gs = Test_FixBegin(DIFFICULTY_NORMAL);
    var _had_run = variable_struct_exists(_gs, "run");
    var _old_run = _had_run ? _gs.run : undefined;
    var _old_cp = _gs.checkpoint;
    _gs.run = Run_Create(12345);
    RunStats_Of(_gs.run).play_ms = 61000;
    var _pl = CharacterCreate_Player(CLASS_MAGE);
    _pl.level = 3;
    _gs.player_ch = _pl;
    _gs.selected_class = CLASS_MAGE;
    _gs.checkpoint = { room: rm_floor3, x: 48, y: 64 };
    var _raw = RunSave_Build();
    Test_True("run summary: the run file carries a summary block", variable_struct_exists(_raw, "summary") && is_struct(_raw.summary));
    if (variable_struct_exists(_raw, "summary")) {
        var _s = _raw.summary;
        Test_Eq("run summary: class", _s.class_id, CLASS_MAGE);
        Test_Eq("run summary: level", _s.level, 3);
        Test_Eq("run summary: floor", _s.floor, 3);
        Test_Eq("run summary: run time", _s.run_time_ms, 61000);
        Test_Eq("run summary: seed", _s.seed, 12345);
        Test_Eq("run summary: saved at matches the save", _s.saved_at, _raw.statData.saved_at);
    }
    Test_Eq("run summary: the file says version 4 (D176)", _raw.run_version, 4);
    _gs.checkpoint = _old_cp;
    if (_had_run) _gs.run = _old_run; else variable_struct_remove(_gs, "run");
}

// Round 3 playtest, packet textfit2 (owner: "make sure all skill card names fit in the skills tab"; R-106): a list row's label that does not fit beside its value wraps over
// two lines (a taller row), takes the next smaller type step only for one too-wide word, or puts its value on a line under it; nothing is cut. The proof for every skill,
// passive and card name at every size and language is Test_Suite_TextFit (TextFit_Known is empty); this suite checks the layout rules and the list's own bookkeeping.
// The pictures are shots 1050..1059.
// ============================================================================================================================
function Test_Suite_TextFit2() {
    Test_RunSuite("TextFit2.rowfit", Test_TextFit2RowFit);
    Test_RunSuite("TextFit2.scroll", Test_TextFit2Scroll);
    Test_RunSuite("TextFit2.menu", Test_TextFit2Menu);
}

// The panel width that leaves exactly _room for a label (no icon): the 4p inset each side, the 5p marker column and the 4p of the inner edge; with a value _value_w wide.
function TextFit2_PanelFor(_room, _p, _value_w = 0) {
    return _room + 13 * _p + ((_value_w > 0) ? _value_w + 3 * _p : 0);
}

function Test_TextFit2RowFit() {
    var _s = TextFit_Begin();
    TextFit_Set(640, 576, "en");
    var _mt = Ui_Metrics();
    var _p = _mt.p;
    var _name = "Horizontal Slash+";
    var _w = UI_TextWidth(_name);
    Test_Eq("textfit2 the helper's panel leaves the room asked for", Ui_MenuLabelRoom(TextFit2_PanelFor(100, _p), _p, 0, false, ""), 100);
    var _one = Ui_RowFit(_name, "", TextFit2_PanelFor(_w, _p), _p, 0, false, true, _mt);
    Test_Eq("textfit2 a label that fits stays on one line", _one.mode, "one");
    Test_Eq("textfit2 a one-line row is a normal row", _one.row_h, _mt.row_h);
    var _wrap = Ui_RowFit(_name, "", TextFit2_PanelFor(_w - 1, _p), _p, 0, false, true, _mt);
    Test_Eq("textfit2 a label one unit too wide wraps", _wrap.mode, "wrap");
    Test_Eq("textfit2 it wraps over two lines", _wrap.lines, 2);
    Test_Eq("textfit2 it keeps the type size when its words fit", _wrap.step, 0);
    Test_True("textfit2 each wrapped line fits the room", _wrap.w <= _wrap.room);
    Test_True("textfit2 a two-line row is two lines and the padding tall (give or take a rounding unit)", abs(_wrap.row_h - (2 * _mt.line_h + 2 * _p)) <= 1);
    Test_True("textfit2 a two-line row is taller than a normal one", _wrap.row_h > _mt.row_h);
    // one word wider than the room: one size smaller (D168)
    var _cw = UI_TextWidth("Confirm");
    var _sm = Ui_RowFit("Confirm", "", TextFit2_PanelFor(_cw - 1, _p), _p, 0, false, true, _mt);
    Test_Eq("textfit2 one word too wide takes the smaller type step", _sm.step, 1);
    Test_Eq("textfit2 it stays one line", _sm.lines, 1);
    Test_True("textfit2 and fits", _sm.ok && _sm.w <= _sm.room);
    Test_Eq("textfit2 on a normal row", _sm.row_h, _mt.row_h);
    // a long value beside the word: the value goes on a line under the label (a button row only)
    var _vtxt = "Space / Z / Enter";
    var _st = Ui_RowFit("Confirm", _vtxt, TextFit2_PanelFor(_cw + 2, _p), _p, 0, false, true, _mt);
    Test_Eq("textfit2 a word that cannot share the row with its value stacks the value under it", _st.mode, "stack");
    Test_True("textfit2 a stacked row is a label line and a value line tall", abs(_st.row_h - (2 * _mt.line_h + 2 * _p)) <= 1 && _st.ok);
    Test_True("textfit2 the value's line starts under the label", _st.value_y >= _p + _mt.line_h - 1);
    Test_Eq("textfit2 the whole room is the label's when stacked", _st.room, Ui_MenuLabelRoom(TextFit2_PanelFor(_cw + 2, _p), _p, 0, false, ""));
    var _nostack = Ui_RowFit("Confirm", _vtxt, TextFit2_PanelFor(_cw + 2, _p), _p, 0, false, false, _mt);
    Test_Eq("textfit2 a row that may not stack (a setting with arrows or a bar) is cut", _nostack.mode, "cut");
    Test_False("textfit2 and says it does not fit", _nostack.ok);
    var _cut = Ui_RowFit("Confirm", "x", 14 * _p, _p, 0, false, true, _mt);
    Test_False("textfit2 a panel too narrow for the word fits no layout", _cut.ok);
    // an icon takes room from the label
    var _ic = Ui_RowFit(_name, "9 MP", 400, _p, 16, false, true, _mt);
    Test_Eq("textfit2 the icon column is part of the room", _ic.room, Ui_MenuLabelRoom(400, _p, 16, false, "9 MP"));
    // a title: one line when it fits, wrapped when it does not
    var _t = "Learn Horizontal Slash+: Replace Which?";
    var _tw = UI_TextWidth(_t);
    Test_Eq("textfit2 a title that fits is one line", Ui_TitleFit(_t, _tw, _mt).lines, 1);
    var _t2 = Ui_TitleFit(_t, _tw - 1, _mt);
    Test_Eq("textfit2 a title one unit too wide wraps over two lines", _t2.lines, 2);
    Test_True("textfit2 and each line fits", _t2.w <= _tw - 1);
    TextFit_End(_s);
}

function Test_TextFit2Scroll() {
    var _eq = [10, 10, 10, 10, 10, 10, 10, 10, 10, 10];
    Test_Eq("textfit2 scroll: equal rows, the cursor below the window pulls it down", Ui_ScrollTopH(5, 0, _eq, 40), Ui_ScrollTop(5, 0, 4, 10));
    Test_Eq("textfit2 scroll: equal rows, the cursor above the window pulls it up", Ui_ScrollTopH(0, 2, _eq, 40), Ui_ScrollTop(0, 2, 4, 10));
    Test_Eq("textfit2 scroll: equal rows, the last item shows the last full window", Ui_ScrollTopH(9, 0, _eq, 40), Ui_ScrollTop(9, 0, 4, 10));
    Test_Eq("textfit2 scroll: equal rows, a cursor inside the window leaves it alone", Ui_ScrollTopH(4, 3, _eq, 40), Ui_ScrollTop(4, 3, 4, 10));
    Test_Eq("textfit2 scroll: a list that fits never scrolls", Ui_ScrollTopH(3, 2, [10, 10, 10, 10], 100), 0);
    var _un = [10, 20, 10, 10, 10];
    Test_Eq("textfit2 scroll: a tall row counts its height (cursor on row 3 in 40: 20 + 10 + 10)", Ui_ScrollTopH(3, 0, _un, 40), 1);
    Test_Eq("textfit2 scroll: cursor on the last row of 10 + 20 + 10 + 10 + 10 in 40 shows the last three", Ui_ScrollTopH(4, 0, _un, 40), 2);
    Test_Eq("textfit2 scroll: the window never stops short of the end when the end fits", Ui_ScrollTopH(4, 3, _un, 50), 1);
    Test_Eq("textfit2 scroll: rows end: 20 + 10 + 10 fit 40", Ui_RowsEnd(_un, 1, 40), 3);
    Test_Eq("textfit2 scroll: a row is never half in: 10 then 20 does not fit 25", Ui_RowsEnd(_un, 0, 25), 0);
    Test_Eq("textfit2 scroll: a row taller than the window is still the first row", Ui_RowsEnd(_un, 1, 15), 1);
    Test_Eq("textfit2 scroll: heights add up", Ui_RowsH(_un, 1, 3), 40);
}

// The real menu measure: the battle's skill list at 800 x 720 with every skill upgraded: the names that do not fit wrap and make their rows taller; the others stay normal.
function Test_TextFit2Menu() {
    var _s = TextFit_Begin();
    TextFit_Set(800, 720, "en");
    var _mt = Ui_Metrics();
    var _z = Battle_Zones();
    var _rows = TextFit_UpgradedRows("battle");
    var _m = Ui_MenuNew("textfit2_battle", _rows, { layout: { x_anchor: "right", panel_w: _z.right.w, y_bottom: _z.list_bottom, details: true, details_pos: "above", details_cols: 2, rows_max: 3 } });
    var _mc = Ui_MenuMeasure(_m, _mt);
    Test_Eq("textfit2 menu: one height per row", array_length(_mc.rhs), array_length(_rows));
    var _hs = -1;
    var _short = -1;
    for (var _i = 0; _i < array_length(_rows); _i++) {
        if (_rows[_i].label == "Horizontal Slash+") _hs = _i;
        if (_short < 0 || string_length(_rows[_i].label) < string_length(_rows[_short].label)) _short = _i;
    }
    Test_True("textfit2 menu: (setup) the list holds Horizontal Slash+ and a short name", _hs >= 0 && _short >= 0);
    if (_hs >= 0) {
        Test_Eq("textfit2 menu: Horizontal Slash+ wraps in the battle list at 800 x 720", _mc.fits[_hs].mode, "wrap");
        Test_True("textfit2 menu: and its row is taller than a normal one", _mc.rhs[_hs] > _mt.row_h);
        Test_True("textfit2 menu: the list knows the most any row is taller", _mc.extra_h >= _mc.rhs[_hs] - _mt.row_h && _mc.extra_h > 0);
    }
    if (_short >= 0) Test_Eq("textfit2 menu: a short name keeps a normal row", _mc.rhs[_short], _mt.row_h);
    for (var _j = 0; _j < array_length(_rows); _j++) Test_True("textfit2 menu: " + _rows[_j].label + " is laid out (nothing is cut)", _mc.fits[_j].ok);
    // the same list with nothing too long has no extra height at all
    var _plain = [{ label: "Bite", value: "3 MP", enabled: true, help: "", lines: [] }, { label: "Wound", value: "4 MP", enabled: true, help: "", lines: [] }];
    var _m2 = Ui_MenuNew("textfit2_plain", _plain, { layout: { x_anchor: "right", panel_w: _z.right.w, y_bottom: _z.list_bottom } });
    var _mc2 = Ui_MenuMeasure(_m2, _mt);
    Test_Eq("textfit2 menu: short names make no extra height", _mc2.extra_h, 0);
    Test_Eq("textfit2 menu: and every row is a normal row", _mc2.rhs[0] + _mc2.rhs[1], 2 * _mt.row_h);
    TextFit_End(_s);
}

// ============================================================================================================================
// Round 3 packet stealth, part A: sight (owner notes 22, 29; D179; R-098). Expected values are the brief's, worked out by hand:
//   an enemy sees the player when he is within 1 tile in any direction, OR within its sight (3 tiles; dire wolf and mad whisp 4) AND inside a 90 degree cone
//   round the way it faces AND nothing that blocks sight is between. A cell is in the cone when it is in front and no further off to the side than it is ahead
//   (45 degrees inclusive). Walls, trees, rocks, stumps, barrels, chests, graves and tall grass block sight; torches, fire stands, skulls, bones, dung, NPCs,
//   doors, switches and beds do not. A very faint cone (0.06..0.10 alpha, softer at the edge, a little stronger while it chases) is drawn under the darkness.
// ============================================================================================================================
function Test_Suite_R3Stealth() {
    Test_RunSuite("R3Stealth.cone", Test_R3Cone);
    Test_RunSuite("R3Stealth.blockers", Test_R3Blockers);
    Test_RunSuite("R3Stealth.profiles", Test_R3Profiles);
    Test_RunSuite("R3Stealth.draw", Test_R3ConeDraw);
}

// Can an enemy on cell (_ecx,_ecy) facing _face see a player on cell (_pcx,_pcy)?
function Test_R3Sees(_g, _ecx, _ecy, _pcx, _pcy, _tiles, _face, _see_through = false, _hidden = false) {
    var _T = GRID_TILE_SIZE;
    return Sight_CanSee(_g, _ecx * _T, _ecy * _T, _pcx * _T, _pcy * _T, _tiles, _see_through, _hidden, _face);
}

// 1. The cone: in front, behind, beside, the ring of 1 tile, the range, the four facings, ghosts, hidden players.
function Test_R3Cone() {
    var _g = Nav_GridFromRows(Test_LightOpen(21, 11));
    // the enemy stands on (10,5), facing RIGHT, sight 3
    Test_True("r3stealth cone: 3 tiles straight ahead is seen", Test_R3Sees(_g, 10, 5, 13, 5, 3, RIGHT));
    Test_False("r3stealth cone: 4 tiles straight ahead is out of range", Test_R3Sees(_g, 10, 5, 14, 5, 3, RIGHT));
    Test_True("r3stealth cone: a wolf or a whisp (sight 4) sees 4 tiles ahead", Test_R3Sees(_g, 10, 5, 14, 5, 4, RIGHT));
    Test_True("r3stealth cone: 2 ahead and 1 up is inside the cone", Test_R3Sees(_g, 10, 5, 12, 4, 3, RIGHT));
    Test_True("r3stealth cone: 2 ahead and 2 up is on the edge of the cone (45 degrees counts)", Test_R3Sees(_g, 10, 5, 12, 3, 3, RIGHT));
    Test_True("r3stealth cone: 2 ahead and 2 down is on the other edge", Test_R3Sees(_g, 10, 5, 12, 7, 3, RIGHT));
    Test_False("r3stealth cone: 3 ahead and 1 up is outside the circle of 3", Test_R3Sees(_g, 10, 5, 13, 4, 3, RIGHT));
    Test_False("r3stealth cone: 1 ahead and 2 up is outside the cone (too far to the side)", Test_R3Sees(_g, 10, 5, 11, 3, 3, RIGHT));
    Test_False("r3stealth cone: 2 tiles beside it (up) is not seen", Test_R3Sees(_g, 10, 5, 10, 3, 3, RIGHT));
    Test_False("r3stealth cone: 2 tiles beside it (down) is not seen", Test_R3Sees(_g, 10, 5, 10, 7, 3, RIGHT));
    Test_False("r3stealth cone: 2 tiles behind it is not seen", Test_R3Sees(_g, 10, 5, 8, 5, 3, RIGHT));
    Test_False("r3stealth cone: 3 tiles behind it is not seen", Test_R3Sees(_g, 10, 5, 7, 5, 3, RIGHT));
    Test_False("r3stealth cone: behind and a little off is not seen", Test_R3Sees(_g, 10, 5, 8, 4, 3, RIGHT));
    // the ring of one tile, in every direction
    var _ring_bad = "";
    for (var _dy = -1; _dy <= 1; _dy++) {
        for (var _dx = -1; _dx <= 1; _dx++) {
            if (!Test_R3Sees(_g, 10, 5, 10 + _dx, 5 + _dy, 3, RIGHT)) _ring_bad += " (" + string(_dx) + "," + string(_dy) + ")";
        }
    }
    Test_Eq("r3stealth cone: every cell within 1 tile is seen whichever way it faces (missed:" + _ring_bad + ")", _ring_bad, "");
    // the other three facings (the same shape turned)
    Test_True("r3stealth cone: facing LEFT it sees 3 tiles to the left", Test_R3Sees(_g, 10, 5, 7, 5, 3, LEFT));
    Test_False("r3stealth cone: facing LEFT it does not see 3 tiles to the right", Test_R3Sees(_g, 10, 5, 13, 5, 3, LEFT));
    Test_True("r3stealth cone: facing UP it sees 3 tiles up", Test_R3Sees(_g, 10, 5, 10, 2, 3, UP));
    Test_False("r3stealth cone: facing UP it does not see 2 tiles down", Test_R3Sees(_g, 10, 5, 10, 7, 3, UP));
    Test_False("r3stealth cone: facing UP it does not see 2 tiles to the right", Test_R3Sees(_g, 10, 5, 12, 5, 3, UP));
    Test_True("r3stealth cone: facing DOWN it sees 3 tiles down", Test_R3Sees(_g, 10, 5, 10, 8, 3, DOWN));
    Test_True("r3stealth cone: facing DOWN it sees 2 down and 2 left (the edge)", Test_R3Sees(_g, 10, 5, 8, 7, 3, DOWN));
    Test_False("r3stealth cone: facing DOWN it does not see 3 tiles up", Test_R3Sees(_g, 10, 5, 10, 2, 3, DOWN));
    // the cone is a set of cells: facing RIGHT with sight 3 on open floor: 9 cells ahead (3 + 5 + 1), its own cell and the 5 ring cells not already ahead = 15
    var _cone = Vis_Cone(_g, 10, 5, 3, false, RIGHT);
    var _n = 0;
    for (var _y = 0; _y < 11; _y++) {
        for (var _x = 0; _x < 21; _x++) {
            if (Vis_Has(_cone, _x, _y)) _n++;
        }
    }
    Test_Eq("r3stealth cone: facing RIGHT with sight 3 on open floor lights 15 cells", _n, 15);
    // it is the same set the sight test uses, for every cell of the window and every facing
    var _mismatch = "";
    for (var _f = 0; _f < 4; _f++) {
        var _c4 = Vis_Cone(_g, 10, 5, 4, false, _f);
        for (var _yy = 0; _yy < 11; _yy++) {
            for (var _xx = 4; _xx < 17; _xx++) {
                if (Vis_Has(_c4, _xx, _yy) != Test_R3Sees(_g, 10, 5, _xx, _yy, 4, _f)) _mismatch += " f" + string(_f) + "(" + string(_xx) + "," + string(_yy) + ")";
            }
        }
    }
    Test_Eq("r3stealth cone: the light set and Sight_CanSee agree on every cell and facing (differ:" + _mismatch + ")", _mismatch, "");
    // a wall ahead: the cell behind it is not seen, the wall's own cell is lit
    var _gw = Nav_GridFromRows(["....................", "....................", "....................", "....................", "....................", "............#.......", "....................", "....................", "...................."]);
    Test_False("r3stealth cone: a wall 2 ahead hides the player behind it", Test_R3Sees(_gw, 10, 5, 13, 5, 3, RIGHT));
    Test_True("r3stealth cone: the wall's own cell is lit", Vis_Has(Vis_Cone(_gw, 10, 5, 3, false, RIGHT), 12, 5));
    Test_True("r3stealth cone: a ghost sees through the wall in front", Test_R3Sees(_gw, 10, 5, 13, 5, 3, RIGHT, true));
    Test_False("r3stealth cone: a ghost still does not see behind it", Test_R3Sees(_gw, 10, 5, 8, 5, 3, RIGHT, true));
    Test_False("r3stealth cone: a ghost still does not see 2 tiles beside it", Test_R3Sees(_gw, 10, 5, 10, 3, 3, RIGHT, true));
    // hidden players: only from 1 tile, cone or not
    Test_False("r3stealth cone: a hidden player 2 ahead is not seen", Test_R3Sees(_g, 10, 5, 12, 5, 3, RIGHT, false, true));
    Test_True("r3stealth cone: a hidden player 1 ahead is seen", Test_R3Sees(_g, 10, 5, 11, 5, 3, RIGHT, false, true));
    Test_True("r3stealth cone: a hidden player 1 behind is seen", Test_R3Sees(_g, 10, 5, 9, 5, 3, RIGHT, false, true));
    // the radius it sees with: its sight, one more while it chases
    Test_Eq("r3stealth cone: a slime sees 3 tiles when idle", Vis_EnemyTiles(EnemyAI_Profile(ENEMY_SLIME), "idle"), 3);
    Test_Eq("r3stealth cone: a slime sees 4 tiles while it chases", Vis_EnemyTiles(EnemyAI_Profile(ENEMY_SLIME), "chase"), 4);
    Test_Eq("r3stealth cone: a dire wolf sees 4 tiles when idle", Vis_EnemyTiles(EnemyAI_Profile(ENEMY_DIREWOLF), "idle"), 4);
    Test_Eq("r3stealth cone: a dire wolf sees 5 tiles while it chases", Vis_EnemyTiles(EnemyAI_Profile(ENEMY_DIREWOLF), "chase"), 5);
    Test_Eq("r3stealth cone: a mad whisp sees 4 tiles when idle", Vis_EnemyTiles(EnemyAI_Profile(ENEMY_MADWHISP), "idle"), 4);
    Test_Eq("r3stealth cone: a boss sees nothing", Vis_EnemyTiles(EnemyAI_Profile(ENEMY_FINAL_BOSS), "idle"), 0);
}

// 2. What blocks sight: one function names every prop; the room grid takes it from the live instances.
function Test_R3Blockers() {
    if (asset_get_index("Sight_BlocksObject") == -1) { Test_True("r3stealth blockers: Sight_BlocksObject exists (not implemented yet)", false); return; }
    var _block = [obj_wall, obj_tree_1, obj_tree_2, obj_tree_stump1, obj_tree_stump2, obj_rock1, obj_rock2, obj_barrel, obj_barrel_lv1, obj_barrel_lv2, obj_barrel_lv3, obj_barrel_broken,
                  obj_chest, obj_chest_lv1, obj_chest_lv2, obj_chest_lv3, obj_chest_class_select, obj_chest_skillbook, obj_chest_opened, obj_tall_grass, obj_grave];
    var _pass = [obj_torch, obj_torch_off, obj_fire_stand, obj_fire_stand_off, obj_skull_1, obj_skull_2, obj_bone, obj_horned_skull, obj_dung_pile, obj_npc, obj_door, obj_switch, obj_bed, obj_interactable];
    var _bad_b = "";
    for (var _i = 0; _i < array_length(_block); _i++) {
        if (!Sight_BlocksObject(_block[_i])) _bad_b += " " + object_get_name(_block[_i]);
    }
    var _bad_p = "";
    for (var _j = 0; _j < array_length(_pass); _j++) {
        if (Sight_BlocksObject(_pass[_j])) _bad_p += " " + object_get_name(_pass[_j]);
    }
    Test_Eq("r3stealth blockers: walls, trees, stumps, rocks, barrels, chests, graves and tall grass block sight (missed:" + _bad_b + ")", _bad_b, "");
    Test_Eq("r3stealth blockers: torches, fire stands, skulls, bones, dung, NPCs, doors, switches and beds do not (wrongly block:" + _bad_p + ")", _bad_p, "");

    // on a hand-made map: a barrel ('o': solid and blocks sight) between the enemy and the player hides him; a torch ('~': solid, sight passes) does not; grass ('g') is walkable and blocks sight
    var _gb = Nav_GridFromRows(["...........", "...........", "...........", "....o......", "...........", "..........."]);
    Test_False("r3stealth blockers: a barrel between the enemy and the player hides him", Test_R3Sees(_gb, 2, 3, 6, 3, 4, RIGHT));
    Test_True("r3stealth blockers: the same player in the next row is seen past the barrel", Test_R3Sees(_gb, 2, 2, 6, 2, 4, RIGHT));
    var _gt = Nav_GridFromRows(["...........", "...........", "...........", "....~......", "...........", "..........."]);
    Test_True("r3stealth blockers: a torch between them does not hide him", Test_R3Sees(_gt, 2, 3, 6, 3, 4, RIGHT));
    var _gg = Nav_GridFromRows(["...........", "...........", "...........", "....g......", "...........", "..........."]);
    Test_False("r3stealth blockers: grass between them hides him", Test_R3Sees(_gg, 2, 3, 6, 3, 4, RIGHT));
    Test_False("r3stealth blockers: grass can be walked through", Nav_CellBlocked(_gg, 4, 3));
    Test_True("r3stealth blockers: grass blocks sight", Nav_SightBlocked(_gg, 4, 3));

    // the live room grid: instances put into the room are classified by Sight_BlocksObject (barrel, tree 2x2, torch, grass)
    // (the test room is small, 10 x 9 cells: everything is put inside it, and the grid must say so, because a cell outside a grid counts as blocked for movement and for sight)
    var _made = [instance_create_depth(16, 32, 0, obj_barrel), instance_create_depth(48, 32, 0, obj_tree_1), instance_create_depth(96, 32, 0, obj_torch), instance_create_depth(128, 32, 0, obj_tall_grass)];
    var _lg = Nav_BuildGrid();
    Test_True("r3stealth blockers: (setup) the cells used are inside the live grid", Nav_GridInside(_lg, 8, 2) && Nav_GridInside(_lg, 4, 3));
    Test_True("r3stealth blockers: the live grid has the barrel as a solid that blocks sight", Nav_CellBlocked(_lg, 1, 2) && Nav_SightBlocked(_lg, 1, 2));
    Test_True("r3stealth blockers: the live grid has the tree's four cells blocking sight", Nav_SightBlocked(_lg, 3, 2) && Nav_SightBlocked(_lg, 4, 3));
    Test_True("r3stealth blockers: the live grid has the torch solid but see-through", Nav_CellBlocked(_lg, 6, 2) && !Nav_SightBlocked(_lg, 6, 2));
    Test_True("r3stealth blockers: the live grid has the grass blocking sight", Nav_SightBlocked(_lg, 8, 2));
    for (var _k = 0; _k < array_length(_made); _k++) instance_destroy(_made[_k]);
}

// 3. The sight of each kind: 3 tiles, wolf and whisp 4; the ghost still sees through walls; bosses see nothing.
function Test_R3Profiles() {
    var _want = [[ENEMY_SLIME, 3], [ENEMY_SPIDER, 3], [ENEMY_SNAKE, 3], [ENEMY_KILLER_PLANT, 3], [ENEMY_GHOSTSWORD, 3], [ENEMY_STRANGER, 3], [ENEMY_DIREWOLF, 4], [ENEMY_MADWHISP, 4]];
    for (var _i = 0; _i < array_length(_want); _i++) {
        Test_Eq("r3stealth profiles: sight of enemy " + string(_want[_i][0]) + " is " + string(_want[_i][1]) + " tiles", EnemyAI_Profile(_want[_i][0]).sight, _want[_i][1]);
    }
    Test_True("r3stealth profiles: the ghost sword still sees through walls", EnemyAI_Profile(ENEMY_GHOSTSWORD).see_through);
    Test_False("r3stealth profiles: a slime does not", EnemyAI_Profile(ENEMY_SLIME).see_through);
    Test_Eq("r3stealth profiles: the mini boss sees nothing", EnemyAI_Profile(ENEMY_MINI_BOSS).sight, 0);
    Test_Eq("r3stealth profiles: the final boss sees nothing", EnemyAI_Profile(ENEMY_FINAL_BOSS).sight, 0);
    // today's chase speeds are kept (px per frame)
    var _chase = [[ENEMY_SLIME, 0.7], [ENEMY_SPIDER, 0.85], [ENEMY_SNAKE, 0.85], [ENEMY_MADWHISP, 0.85], [ENEMY_KILLER_PLANT, 0.8], [ENEMY_DIREWOLF, 1.0], [ENEMY_GHOSTSWORD, 0.85], [ENEMY_STRANGER, 0.9]];
    for (var _j = 0; _j < array_length(_chase); _j++) {
        Test_Eq("r3stealth profiles: chase speed of enemy " + string(_chase[_j][0]) + " is kept at " + string(_chase[_j][1]), EnemyAI_Profile(_chase[_j][0]).chase, _chase[_j][1]);
    }
}

// 4. The faint cone: a part of the world pass under the darkness, very faint, softer at the edge, a little stronger while it chases.
function Test_R3ConeDraw() {
    var _parts = World_FxParts();
    var _sight = -1;
    var _light = -1;
    for (var _i = 0; _i < array_length(_parts); _i++) {
        if (_parts[_i].name == "sight") _sight = _i;
        if (_parts[_i].name == "light") _light = _i;
    }
    Test_True("r3stealth draw: the sight cone is a part of the world pass", _sight >= 0);
    Test_True("r3stealth draw: it is drawn before the darkness (under it)", _sight >= 0 && _sight < _light);
    Test_Eq("r3stealth draw: it is drawn in the top pass with the darkness", (_sight >= 0 && variable_struct_exists(_parts[_sight], "pass")) ? _parts[_sight].pass : "(no pass)", "top");
    if (asset_get_index("Sight_ConeAlpha") == -1) { Test_True("r3stealth draw: Sight_ConeAlpha exists (not implemented yet)", false); return; }
    var _bad = "";
    for (var _band = 0; _band <= 2; _band++) {
        var _a = Sight_ConeAlpha(_band, false);
        var _c = Sight_ConeAlpha(_band, true);
        if (_a < 0.06 - 0.0001 || _a > 0.10 + 0.0001) _bad += " calm" + string(_band) + "=" + string(_a);
        if (_c <= _a || _c > 0.16) _bad += " chase" + string(_band) + "=" + string(_c);
    }
    Test_Eq("r3stealth draw: every band is 0.06..0.10 calm and a little stronger (at most 0.16) while it chases (bad:" + _bad + ")", _bad, "");
    Test_True("r3stealth draw: the edge (band 0) is softer than the middle (band 2)", Sight_ConeAlpha(0, false) < Sight_ConeAlpha(2, false));
}

// ============================================================================================================================
// Round 3 packet stealth, part B: escape and hiding (D179; R-099). Expected values are the brief's:
//   after losing the player an enemy walks to the last cell it saw him on, searches 3 seconds (180 frames, looking round, never walking along where he was heading), puts up
//   ONE "?", goes home and cannot notice him for 2 seconds (120 frames) from the moment it gives up; touching it still starts a fight. It hears a RUNNING player within 2 tiles
//   and only when it has a clear line or a way of at most 2 steps (no hearing through walls). Every chase speed is under the run speed (2 px per frame).
//   Tall grass is walkable and blocks sight; a player standing still in it for 20 frames is hidden. Every floor from 2 on has at least 2 patches of 2 to 4 cells.
// ============================================================================================================================
function Test_Suite_R3StealthB() {
    Test_RunSuite("R3StealthB.search", Test_R3Search);
    Test_RunSuite("R3StealthB.hear", Test_R3Hear);
    Test_RunSuite("R3StealthB.speed", Test_R3ChaseSpeed);
    Test_RunSuite("R3StealthB.grass", Test_R3Grass);
    Test_RunSuite("R3StealthB.bushes", Test_R3Bushes);
}

// 1. The search: about 3 s, in place, one "?" at the end, then home; the ignore after it.
function Test_R3Search() {
    if (asset_get_index("EnemyAI_GiveUp") == -1) { Test_True("r3stealth search: EnemyAI_GiveUp exists (not implemented yet)", false); return; }
    var _g = Nav_GridFromRows(Test_LightOpen(16, 5));
    var _se = Search_Create(8, 2, 180);
    var _ticks = 0;
    var _pops = 0;
    var _pop_tick = -1;
    var _walks = 0;
    var _turns = 0;
    var _done = false;
    while (_ticks < 1000 && !_done) {
        _ticks++;
        var _r = Search_Step(_se, _g, 8, 2);
        if (_r.pop) { _pops++; _pop_tick = _ticks; }
        if (_r.goal_cx >= 0) _walks++;
        if (variable_struct_exists(_r, "turn") && _r.turn) _turns++;
        if (_r.done) _done = true;
    }
    Test_True("r3stealth search: the search ends", _done);
    Test_True("r3stealth search: it takes about 3 seconds (150 to 210 frames, took " + string(_ticks) + ")", _ticks >= 150 && _ticks <= 210);
    Test_Eq("r3stealth search: the ? goes up exactly once", _pops, 1);
    Test_Eq("r3stealth search: and it goes up as it gives up", _pop_tick, _ticks);
    Test_Eq("r3stealth search: it never walks on (no goal cell: no leg along where the player was heading)", _walks, 0);
    Test_True("r3stealth search: it looks round (at least 3 turns)", _turns >= 3);
    var _after = Search_Step(_se, _g, 8, 2);
    Test_True("r3stealth search: a finished search stays finished and never pops again", _after.done && !_after.pop);
    // giving up at once (it cannot reach the cell): done on the next step, still one ?
    var _s2 = Search_Create(8, 2, 180);
    Search_Step(_s2, _g, 8, 2);
    Search_GiveUp(_s2);
    var _g1 = Search_Step(_s2, _g, 8, 2);
    Test_True("r3stealth search: giving up ends it on the next step with its one ?", _g1.done && _g1.pop);
    // the state it leaves: heading home, blind to the player for 2 seconds
    var _e = { ai_mode: "search", srch: _s2, stuck_frames: 7, spot_cooldown: 0 };
    EnemyAI_GiveUp(_e);
    Test_Eq("r3stealth search: it goes home after giving up", _e.ai_mode, "return");
    Test_Eq("r3stealth search: it cannot notice the player for 2 seconds (120 frames)", _e.spot_cooldown, 120);
    Test_True("r3stealth search: the search is forgotten", is_undefined(_e.srch));
}

// 2. Hearing: a RUN, within 2 tiles, needs a clear line or a way of at most 2 steps.
function Test_R3Hear() {
    Test_True("r3stealth hear: running 2 tiles away is heard", Hear_RunHeard(10, 5, 12, 5, true));
    Test_False("r3stealth hear: running 3 tiles away is not heard", Hear_RunHeard(10, 5, 13, 5, true));
    Test_False("r3stealth hear: walking 2 tiles away is not heard", Hear_RunHeard(10, 5, 12, 5, false));
    Test_True("r3stealth hear: running on the diagonal next to it is heard", Hear_RunHeard(10, 5, 11, 6, true));
    Test_False("r3stealth hear: 2 tiles across and 1 down (2.2 tiles) is not heard", Hear_RunHeard(10, 5, 12, 6, true));
    var _open = Nav_GridFromRows(Test_LightOpen(12, 5));
    Test_True("r3stealth hear: in the open, 2 tiles, running: heard", Hear_RunHeard(5, 2, 7, 2, true, _open));
    Test_False("r3stealth hear: in the open, 3 tiles, running: not heard", Hear_RunHeard(5, 2, 8, 2, true, _open));
    var _wall = Nav_GridFromRows(["............", "............", ".....#......", "............", "............"]);
    Test_False("r3stealth hear: 2 tiles away with a wall between is not heard (no hearing through walls)", Hear_RunHeard(4, 2, 6, 2, true, _wall));
    var _barrel = Nav_GridFromRows(["............", "............", ".....o......", "............", "............"]);
    Test_False("r3stealth hear: nor with a barrel between", Hear_RunHeard(4, 2, 6, 2, true, _barrel));
    var _grass = Nav_GridFromRows(["............", "............", ".....g......", "............", "............"]);
    Test_True("r3stealth hear: grass between is no wall: it is 2 steps through it, heard", Hear_RunHeard(4, 2, 6, 2, true, _grass));
    Test_True("r3stealth hear: next to the wall, a diagonal step away, is heard", Hear_RunHeard(4, 1, 5, 1, true, _wall));
    // through the senses: behind a wall 2 tiles away, running: no sight, no sound
    var _T = GRID_TILE_SIZE;
    var _prof = EnemyAI_Profile(ENEMY_SLIME);
    var _p = EnemyAI_Perceive(_wall, _prof, 4 * _T, 2 * _T, 6 * _T, 2 * _T, true, false, RIGHT);
    Test_False("r3stealth hear: through the senses, a runner behind a wall 2 tiles away is neither seen", _p.sees);
    Test_False("r3stealth hear: nor heard", _p.heard);
    _p = EnemyAI_Perceive(_open, _prof, 4 * _T, 2 * _T, 2 * _T, 2 * _T, true, false, RIGHT);
    Test_False("r3stealth hear: a runner 2 tiles behind it is not seen (it faces away)", _p.sees);
    Test_True("r3stealth hear: but he is heard", _p.heard);
}

// 3. Running outpaces every enemy (the player walks at 1 px per frame and runs at 2: obj_player run_speed).
function Test_R3ChaseSpeed() {
    var _run = 2;
    var _bad = "";
    for (var _id = 0; _id <= ENEMY_FINAL_BOSS; _id++) {
        var _p = EnemyAI_Profile(_id);
        if (!(_p.chase < _run)) _bad += " " + string(_id) + ":" + string(_p.chase);
        if (!(_p.ret_speed < _run)) _bad += " ret" + string(_id) + ":" + string(_p.ret_speed);
    }
    Test_Eq("r3stealth speed: every enemy's chase and return speed is under the run speed of 2 (bad:" + _bad + ")", _bad, "");
}

// 4. Tall grass is walkable, blocks sight, and hides a player who stands still in it.
function Test_R3Grass() {
    if (asset_get_index("Grid_PropBlocks") == -1) { Test_True("r3stealth grass: Grid_PropBlocks exists (not implemented yet)", false); return; }
    // (the test room is 10 x 9 cells)
    var _mv = instance_create_depth(48, 16, 0, obj_barrel);   // something with a mask to move about
    var _grass = instance_create_depth(96, 16, 0, obj_tall_grass);
    var _barrel = instance_create_depth(80, 16, 0, obj_barrel);
    Test_False("r3stealth grass: a step into tall grass is not blocked", Grid_PropBlocks(_mv, 96, 16));
    Test_True("r3stealth grass: a step into a barrel is", Grid_PropBlocks(_mv, 80, 16));
    Test_False("r3stealth grass: a step into nothing is not", Grid_PropBlocks(_mv, 112, 16));
    Test_True("r3stealth grass: standing half on grass and half on the barrel is blocked", Grid_PropBlocks(_mv, 88, 16));
    Test_False("r3stealth grass: the player's own tile test lets the grass through", Player_TileBlocked(_mv, 96, 16));
    Test_True("r3stealth grass: and keeps the barrel", Player_TileBlocked(_mv, 80, 16));
    Test_True("r3stealth grass: an enemy's tile test lets the grass through", Grid_TileFree(_mv, 96, 16));
    Test_False("r3stealth grass: and keeps the barrel", Grid_TileFree(_mv, 80, 16));
    var _lg = Nav_BuildGrid();
    Test_False("r3stealth grass: the room grid lets enemies walk through the grass", Nav_CellBlocked(_lg, 6, 1));
    Test_True("r3stealth grass: and blocks sight there", Nav_SightBlocked(_lg, 6, 1));
    Test_True("r3stealth grass: the barrel blocks both", Nav_CellBlocked(_lg, 5, 1) && Nav_SightBlocked(_lg, 5, 1));
    // hidden: standing still on grass for HIDE_SETTLE_FRAMES (20)
    var _pl = { x: 96, y: 16, moving: false, still_frames: 20 };
    Test_True("r3stealth grass: standing still in grass for 20 frames hides the player", Player_IsHidden(_pl));
    _pl.still_frames = 19;
    Test_False("r3stealth grass: not before that", Player_IsHidden(_pl));
    _pl.still_frames = 100;
    _pl.moving = true;
    Test_False("r3stealth grass: moving in grass does not hide", Player_IsHidden(_pl));
    _pl.moving = false;
    _pl.x = 112;
    Test_False("r3stealth grass: standing still beside it does not", Player_IsHidden(_pl));
    _pl.x = 80;
    Test_False("r3stealth grass: nor on the barrel's cell", Player_IsHidden(_pl));
    _pl.x = 96;
    instance_destroy(_grass);
    Test_False("r3stealth grass: with no grass under him he is not hidden", Player_IsHidden(_pl));
    instance_destroy(_barrel);
    instance_destroy(_mv);
    // placing bushes in code: one instance per cell, never twice on a cell
    var _made = Bush_Place([[[1, 5], [2, 5]], [[7, 6], [7, 7]]]);
    Test_Eq("r3stealth grass: Bush_Place makes one grass per cell", _made, 4);
    Test_Eq("r3stealth grass: there is grass on its cells", (instance_position(1 * 16 + 8, 5 * 16 + 8, obj_tall_grass) != noone && instance_position(7 * 16 + 8, 7 * 16 + 8, obj_tall_grass) != noone) ? 1 : 0, 1);
    var _bg = instance_position(1 * 16 + 8, 5 * 16 + 8, obj_tall_grass);
    Test_True("r3stealth grass: a bush placed in code is drawn (the object itself is invisible: the room art paints its own grass)", _bg != noone && _bg.visible && _bg.sprite_index == tall_grass_asset);
    Test_Eq("r3stealth grass: a second call makes none", Bush_Place([[[1, 5], [2, 5]], [[7, 6], [7, 7]]]), 0);
    with (obj_tall_grass) instance_destroy();
}

// 5. Where the bushes are: every floor from 2 on has 2 or more patches of 2 to 4 cells, on reachable free floor, off the way between the exits, never on or in front of an exit, a spawn
// or an enemy's place; the old hiding cells are among them. (The room model is the one the spawn checks use: Test_H11Model.)
function Test_R3Bushes() {
    if (asset_get_index("Bush_Patches") == -1) { Test_True("r3stealth bushes: Bush_Patches exists (not implemented yet)", false); return; }
    var _rooms = Scenario_GridRooms();
    var _bad = "";
    var _floors = 0;
    for (var _ri = 0; _ri < array_length(_rooms); _ri++) {
        var _name = room_get_name(_rooms[_ri]);
        var _pp = Bush_Patches(_name);
        if (_rooms[_ri] == rm_floor1) {
            Test_Eq("r3stealth bushes: floor 1 has none", array_length(_pp), 0);
            continue;
        }
        _floors++;
        if (array_length(_pp) < 2) _bad += " " + _name + ":fewer-than-2-patches";
        var _m = Test_H11Model(_rooms[_ri]);
        var _g = _m.grid;
        var _start = _m.spawns[0];
        var _reach = Test_H11Flood(_g, _start[0], _start[1]);
        var _path = {};
        for (var _a = 0; _a < array_length(_m.spawns); _a++) {
            for (var _b = _a + 1; _b < array_length(_m.spawns); _b++) {
                var _p = Nav_FindPath(_g, _m.spawns[_a][0], _m.spawns[_a][1], _m.spawns[_b][0], _m.spawns[_b][1]);
                for (var _c = 0; _c < array_length(_p); _c++) variable_struct_set(_path, string(_p[_c][0]) + "," + string(_p[_c][1]), true);
            }
        }
        var _seen = {};
        var _total = 0;
        for (var _pi = 0; _pi < array_length(_pp); _pi++) {
            var _cells = _pp[_pi];
            var _n = array_length(_cells);
            _total += _n;
            if (_n < 2 || _n > 4) _bad += " " + _name + ":patch" + string(_pi) + "-has-" + string(_n) + "-cells";
            var _joined = 1;
            for (var _k = 0; _k < _n; _k++) {
                var _cx = _cells[_k][0];
                var _cy = _cells[_k][1];
                var _key = string(_cx) + "," + string(_cy);
                var _at = " " + _name + ":(" + _key + ")";
                if (!Nav_GridInside(_g, _cx, _cy)) { _bad += _at + "outside"; continue; }
                if (Nav_CellBlocked(_g, _cx, _cy)) _bad += _at + "blocked";
                if (!_reach[_cy * _g.w + _cx]) _bad += _at + "unreachable";
                if (variable_struct_exists(_path, _key)) _bad += _at + "on-the-way-between-exits";
                if (variable_struct_exists(_seen, _key)) _bad += _at + "twice";
                variable_struct_set(_seen, _key, true);
                for (var _s = 0; _s < array_length(_m.spawns); _s++) {
                    if (_m.spawns[_s][0] == _cx && _m.spawns[_s][1] == _cy) _bad += _at + "on-a-spawn";
                }
                for (var _x = 0; _x < array_length(_m.exits); _x++) {
                    if (abs(_m.exits[_x][0] - _cx) + abs(_m.exits[_x][1] - _cy) <= 1) _bad += _at + "at-an-exit";
                }
                for (var _e = 0; _e < array_length(_m.slots); _e++) {
                    if (Nav_CellOf(_m.slots[_e].x + 8) == _cx && Nav_CellOf(_m.slots[_e].y + 8) == _cy) _bad += _at + "on-an-enemy-place";
                }
                // joined to another cell of its patch
                if (_k > 0) {
                    var _near = false;
                    for (var _j = 0; _j < _k; _j++) {
                        if (abs(_cells[_j][0] - _cx) + abs(_cells[_j][1] - _cy) == 1) _near = true;
                    }
                    if (!_near && _n > 1) _joined = 0;
                }
            }
            if (!_joined) _bad += " " + _name + ":patch" + string(_pi) + "-is-not-in-one-piece";
        }
        if (_total > 12) _bad += " " + _name + ":more-than-12-cells";
        // Hide_Cells is the flat list of the bush cells
        var _hc = Hide_Cells(_name);
        if (array_length(_hc) != _total) _bad += " " + _name + ":Hide_Cells-has-" + string(array_length(_hc)) + "-of-" + string(_total);
    }
    Test_True("r3stealth bushes: floors 2 and on were checked (" + string(_floors) + ")", _floors >= 9);
    Test_Eq("r3stealth bushes: every floor from 2 on has 2 or more patches of 2 to 4 cells in the right places (bad:" + _bad + ")", _bad, "");
    // the old hiding cells are bushes now
    var _old = [["rm_floor2", 3, 3], ["rm_floor2", 12, 3], ["rm_floor3", 3, 4], ["rm_floor4", 4, 3], ["rm_floor5", 4, 2], ["rm_floor6", 4, 3], ["rm_floor7", 9, 2]];
    var _miss = "";
    for (var _o = 0; _o < array_length(_old); _o++) {
        if (!Hide_IsCell(_old[_o][0], _old[_o][1], _old[_o][2])) _miss += " " + _old[_o][0] + ":(" + string(_old[_o][1]) + "," + string(_old[_o][2]) + ")";
    }
    Test_Eq("r3stealth bushes: the old hiding cells are bush cells (missing:" + _miss + ")", _miss, "");
    Test_Eq("r3stealth bushes: an unknown room has none", array_length(Bush_Patches("rm_nothing")), 0);
}

// ============================================================================================================================
// Round 3 playtest, packet fixdet (R-108): in the battle's Skill and Item lists the details panel, the list and the "Choose" hint never stand on the enemy or the player panel,
// whatever the row heights (wrapped names are taller), size and language. When space is short the details panel drops its least important lines first (it keeps the sentence
// and the Damage / Perfect / MP lines), then the list shows fewer rows. The Damage / Perfect line pair never leaves a value alone on a row. Picture: shot 1050..1059's battle_skills.
// ============================================================================================================================
function Test_Suite_R3FixDet() {
    Test_RunSuite("R3FixDet.lists", Test_R3FixDetLists);
    Test_RunSuite("R3FixDet.pairs", Test_R3FixDetPairs);
    Test_RunSuite("R3FixDet.gold", Test_R3FixDetGold);
}

// The lines a battle details panel keeps (by label): Damage, Perfect and MP for a skill; the first line for anything else (an item). In the last resort (nothing else makes room: one list row,
// the hint left out) the MP line goes too (the list row shows it) and an item keeps no line.
function Test_R3FixDetKeeps(_lines, _is_skill, _last = false) {
    var _out = [];
    for (var _i = 0; _i < array_length(_lines); _i++) {
        var _lb = _lines[_i].label;
        var _keep = _is_skill ? (_lb == Loc_T("battle.det.damage", "Damage") || _lb == Loc_T("battle.det.perfect", "Perfect") || _lb == Loc_T("card.lbl.mp", "MP")) : (_i == 0);
        if (_last && (!_is_skill || _lb == Loc_T("card.lbl.mp", "MP"))) _keep = false;
        if (_keep) array_push(_out, _lb);
    }
    return _out;
}

function Test_R3FixDetLabels(_lines) {
    var _out = [];
    for (var _i = 0; _i < array_length(_lines); _i++) array_push(_out, _lines[_i].label);
    return _out;
}

function Test_R3FixDetLists() {
    var _s = TextFit_Begin();
    var _gs = GameState_Get();
    var _old = _gs.player_ch;
    var _langs = ["en", "ko"];
    var _sizes = TextFit_Sizes();
    var _f = { enemy: "", player: "", screen: "", hint: "", keep: "", order: "", rows: "", setup: "" };
    var _n = 0;
    var _hid = 0;
    var _l2 = 0;
    var _stp = 0;
    for (var _l = 0; _l < 2; _l++) {
        for (var _z = 0; _z < array_length(_sizes); _z++) {
            TextFit_Set(_sizes[_z][0], _sizes[_z][1], _langs[_l]);
            var _mt = Ui_Metrics();
            var _gh = Display_GuiH();
            var _gw = Display_GuiW();
            var _ch = TextFit_Char();
            _ch.upgrades = [];
            for (var _u = 0; _u < array_length(_ch.skills); _u++) array_push(_ch.upgrades, _ch.skills[_u]);
            _gs.player_ch = _ch;
            var _bc = Test_R3Make(ENEMY_FINAL_BOSS, "", 0, false, false);
            _bc.p = _ch;
            _bc.run_fails = 0;
            _bc.ui_cmd = undefined;
            Battle_MenusBuild(_bc);
            Battle_MenusLayout(_bc);
            var _er = Battle_EnemyRect(_bc);
            var _zn = Battle_Zones();
            var _menus = [_bc.ui_skill, _bc.ui_item];
            for (var _k = 0; _k < 2; _k++) {
                var _m = _menus[_k];
                var _state = (_k == 0) ? BSTATE_SKILL_MENU : BSTATE_ITEM_MENU;
                for (var _i = 0; _i < array_length(_m.items); _i++) {
                    _m.cursor = _i;
                    var _it = _m.items[_i];
                    var _mc = Ui_MenuMeasure(_m, _mt);
                    var _g = Ui_MenuGeom(_m, _mt, _mc, 1);
                    var _hr = Battle_ListHintRect(_g.det_rect, _state, _g.hint_hidden);
                    var _tag = _langs[_l] + " " + string(_sizes[_z][0]) + " " + ((_k == 0) ? "skill " : "item ") + string(_it.label) + "; ";
                    _n++;
                    var _rects = [["list", _g.rect], ["details", _g.det_rect], ["hint", _hr]];
                    for (var _q = 0; _q < 3; _q++) {
                        var _r = _rects[_q][1];
                        if (_r.w <= 0) continue;
                        if (Test_RectsOverlap(_r, _er)) _f.enemy += _tag + _rects[_q][0] + json_stringify(_r) + " enemy" + json_stringify(_er) + "; ";
                        if (Test_RectsOverlap(_r, _zn.player)) _f.player += _tag + _rects[_q][0] + "; ";
                        if (_r.x < 0 || _r.y < 0 || _r.x + _r.w > _gw || _r.y + _r.h > _gh) _f.screen += _tag + _rects[_q][0] + json_stringify(_r) + "; ";
                    }
                    if (_g.det_rect.w > 0 && _hr.w <= 0 && !_g.hint_hidden) _f.hint += _tag + "no hint; ";
                    // what the panel kept: the sentence, and the lines in priority order (level 0 all, 1 the kept ones, 2 the last resort)
                    var _full = Test_R3FixDetLabels(_it.lines);
                    var _shown = json_stringify(Test_R3FixDetLabels(_g.lines_shown));
                    var _want = (_g.lines_level == 0) ? json_stringify(_full) : ((_g.lines_level >= 3) ? json_stringify([]) : json_stringify(Test_R3FixDetKeeps(_it.lines, _k == 0, _g.lines_level >= 2)));   // I-107: level 3 keeps no number line
                    if (_g.det_rect.w <= 0 || _shown != _want) _f.keep += _tag + "level " + string(_g.lines_level) + " shown=" + _shown + " want=" + _want + "; ";
                    var _normal_rows = min(3, array_length(_m.items));
                    var _reduced = (_g.rows_vis < _normal_rows);
                    var _seq = (variable_struct_exists(_it, "seq") && array_length(_it.seq) > 0);
                    if (_reduced && (_g.lines_level < 1 || (_seq && !_g.seq_drop))) _f.rows += _tag + "rows=" + string(_g.rows_vis) + " level " + string(_g.lines_level) + "; ";
                    if (_g.gap < _mt.margin && _g.rows_vis != 1 && !_g.det_tight) _f.rows += _tag + "gap shrunk with " + string(_g.rows_vis) + " rows; ";
                    if (_g.hint_hidden && (_g.rows_vis > 2 || _g.lines_level < 1)) _f.order += _tag + "hint left out with " + string(_g.rows_vis) + " rows, level " + string(_g.lines_level) + "; ";
                    if (_g.lines_level >= 2 && !(_g.hint_hidden && _g.rows_vis <= 2)) _f.order += _tag + "last-resort lines before the hint and the rows gave way; ";
                    if (_g.lines_level >= 1 && _seq && !_g.seq_drop && _g.rows_vis < _normal_rows) _f.order += _tag + "arrows kept while rows go; ";
                    if ((_g.det_step > 0 || _g.det_tight) && !(_g.hint_hidden && _g.rows_vis <= 2 && _g.lines_level >= 2)) _f.order += _tag + "smaller type before the rest gave way; ";
                    if (_g.hint_hidden) _hid++;
                    if (_g.det_step > 0) _stp++;
                    if (_g.lines_level >= 2) _l2++;
                }
                if (array_length(_m.items) < 3) _f.setup += _langs[_l] + " " + string(_sizes[_z][0]) + " list " + string(_k) + " has " + string(array_length(_m.items)) + " rows; ";
            }
            instance_destroy(_bc.enemy_inst);
        }
    }
    _gs.player_ch = _old;
    Test_True("r3fixdet lists: (setup) every row of both lists was looked at (" + string(_n) + ")", _n >= 100);
    Test_Eq("r3fixdet lists: (setup) both lists have enough rows to scroll", _f.setup, "");
    Test_Eq("r3fixdet lists: neither the list nor its details panel nor the hint stands on the enemy (480, 640, 800; en, ko)", _f.enemy, "");
    Test_Eq("r3fixdet lists: nor on the player panel", _f.player, "");
    Test_Eq("r3fixdet lists: all of them are on screen", _f.screen, "");
    Test_Eq("r3fixdet lists: the hint stays with the details panel", _f.hint, "");
    Test_Eq("r3fixdet lists: the details panel keeps its sentence and its lines in priority order: Damage / Perfect / MP stay while anything else goes first (only the last resort drops the MP the row also shows)", _f.keep, "");
    Test_Eq("r3fixdet lists: the list shows fewer rows only after the details dropped what they could", _f.rows, "");
    Test_Eq("r3fixdet lists: the order of giving way is lines, arrows, rows (down to two), then the hint, then the last-resort lines, then the smaller type (I-107: one row only after all of that)", _f.order, "");
    Test_True("r3fixdet lists: (info) the hint is left out in " + string(_hid) + " of " + string(_n) + " layouts, the last-resort lines in " + string(_l2) + ", the smaller type in " + string(_stp), true);
    TextFit_End(_s);
}

// The Damage / Perfect pair: two label-value pairs on one row when both fit, else one under the other; a value is never alone on a row of its own.
function Test_R3FixDetPairs() {
    var _s = TextFit_Begin();
    TextFit_Set(640, 576, "en");
    var _mt = Ui_Metrics();
    var _p = _mt.p;
    var _lines = [{ label: "Damage", value: "17" }, { label: "Perfect", value: "22" }];
    var _nd = Ui_DetailsLineNeed("Damage", "17", _p);
    var _np = Ui_DetailsLineNeed("Perfect", "22", _p);
    Test_True("r3fixdet pairs: (setup) Perfect 22 needs more than Damage 17", _np > _nd);
    var _wide = Ui_DetailsPlan(_lines, 2 * _np + 3 * _p, 2, _mt);
    Test_Eq("r3fixdet pairs: both fit a row: one row of two", array_length(_wide.rows), 1);
    Test_Eq("r3fixdet pairs: with two cells", array_length(_wide.rows[0].cells), 2);
    Test_Eq("r3fixdet pairs: and it is one text row tall", _wide.h, _mt.line_h + _p);
    var _mid = Ui_DetailsPlan(_lines, _nd + _np + 3 * _p, 2, _mt);   // equal columns are too narrow for Perfect 22 but the two pairs fit one row at their own widths
    Test_Eq("r3fixdet pairs: the pairs fit one row at their own width: one row", array_length(_mid.rows), 1);
    if (array_length(_mid.rows) == 1) {
        Test_Eq("r3fixdet pairs: Damage 17 is as wide as it needs, at the left edge", _mid.rows[0].cells[0].x + _mid.rows[0].cells[0].w, _nd);
        Test_Eq("r3fixdet pairs: Perfect 22 ends at the right edge", _mid.rows[0].cells[1].x + _mid.rows[0].cells[1].w, _nd + _np + 3 * _p);
        Test_Eq("r3fixdet pairs: and is as wide as it needs", _mid.rows[0].cells[1].w, _np);
        Test_Eq("r3fixdet pairs: one text row tall", _mid.h, _mt.line_h + _p);
    }
    var _in = 2 * _nd + 3 * _p;   // the columns fit Damage 17 but not Perfect 22 (and the two pairs together do not fit one row)
    var _tight = Ui_DetailsPlan(_lines, _in, 2, _mt);
    Test_Eq("r3fixdet pairs: Perfect does not fit its column: the pair goes on two rows", array_length(_tight.rows), 2);
    Test_True("r3fixdet pairs: Damage 17 is one row, Perfect 22 the next", array_length(_tight.rows) == 2 && _tight.rows[0].cells[0].i == 0 && _tight.rows[1].cells[0].i == 1);
    if (array_length(_tight.rows) == 2) {
        Test_Eq("r3fixdet pairs: each is the whole width", _tight.rows[0].cells[0].w, _in);
        Test_Eq("r3fixdet pairs: each is one text row tall (the value is not alone under its label)", _tight.rows[1].h, _mt.line_h + _p);
    }
    Test_Eq("r3fixdet pairs: so the pair is two text rows tall", _tight.h, 2 * (_mt.line_h + _p));
    Test_Eq("r3fixdet pairs: the height helper reads the plan", Ui_DetailsLinesH(_lines, _in, 2, _mt), _tight.h);
    // two lines that fit never move: Power / MP beside each other
    var _pm = Ui_DetailsPlan([{ label: "Power", value: "7" }, { label: "MP", value: "5" }], 400, 2, _mt);
    Test_Eq("r3fixdet pairs: Power and MP stay on one row", array_length(_pm.rows), 1);
    // the real battle pair at every size and language: no value stacked under its label, no label wrapped
    var _bad = "";
    var _langs = ["en", "ko"];
    var _sizes = TextFit_Sizes();
    for (var _l = 0; _l < 2; _l++) {
        for (var _z = 0; _z < array_length(_sizes); _z++) {
            TextFit_Set(_sizes[_z][0], _sizes[_z][1], _langs[_l]);
            var _mt2 = Ui_Metrics();
            var _zn = Battle_Zones();
            var _pair = [{ label: Loc_T("battle.det.damage", "Damage"), value: "999" }, { label: Loc_T("battle.det.perfect", "Perfect"), value: "999" }];
            var _pl = Ui_DetailsPlan(_pair, _zn.right.w - 8 * _mt2.p, 2, _mt2);
            for (var _r = 0; _r < array_length(_pl.rows); _r++) {
                for (var _c = 0; _c < array_length(_pl.rows[_r].cells); _c++) {
                    var _cell = _pl.rows[_r].cells[_c];
                    var _ln = _pair[_cell.i];
                    if (Ui_DetailsLineStacked(_ln.label, _ln.value, _cell.w, _mt2.p) || UI_TextWidth(_ln.label) > _cell.w) _bad += _langs[_l] + " " + string(_sizes[_z][0]) + " " + _ln.label + "; ";
                }
            }
        }
    }
    Test_Eq("r3fixdet pairs: at 480, 640, 800 in en and ko the Damage and Perfect lines each fit their cell", _bad, "");
    TextFit_End(_s);
}

// R-109: the gold box (top left) is not drawn under a level-up or card screen, a menu or the title; it is on the bare map and over a dialogue. The card screens' panels reach the corner it stands in.
function Test_R3FixDetGold() {
    Test_True("r3fixdet gold: the bare map shows the gold box", Hud_GoldShown(UI_NONE, rm_floor1, false));
    Test_True("r3fixdet gold: a dialogue does not hide it", Hud_GoldShown(UI_DIALOGUE, rm_floor1, false));
    Test_False("r3fixdet gold: the level-up and card screens hide it", Hud_GoldShown(UI_CARDS, rm_floor1, false));
    Test_False("r3fixdet gold: the Tab menu hides it", Hud_GoldShown(UI_MENU, rm_floor1, false));
    Test_False("r3fixdet gold: a cutscene hides it", Hud_GoldShown(UI_NONE, rm_floor1, true));
    Test_False("r3fixdet gold: the title does not show it", Hud_GoldShown(UI_NONE, rm_start, false));
}

// ============================================================================================================
// Packet saves2 (D175): the title with profiles and three save files. Part 1: the title model (Continue / New Game / Load Game follow the active profile's save files) and the
// Load Game / overwrite picker. Every test runs in the saves1 sandbox (Test_ProfRun). Expected values come from the packet brief and D175, not from the code.
// ============================================================================================================
function Test_Suite_R3Saves2() {
    Test_RunSuite("R3Saves2.items", Test_R3s2ItemsRun);
    Test_RunSuite("R3Saves2.state", Test_R3s2StateRun);
    Test_RunSuite("R3Saves2.rows", Test_R3s2RowsRun);
    Test_RunSuite("R3Saves2.newgame", Test_R3s2NewGameRun);
    Test_RunSuite("R3Saves2.overwrite", Test_R3s2OverwriteRun);
    Test_RunSuite("R3Saves2.delete", Test_R3s2DeleteRun);
    Test_RunSuite("R3Saves2.name", Test_R3s2NameRun);
    Test_RunSuite("R3Saves2.grid", Test_R3s2GridRun);
    Test_RunSuite("R3Saves2.profrows", Test_R3s2ProfRowsRun);
    Test_RunSuite("R3Saves2.profswitch", Test_R3s2ProfSwitchRun);
    Test_RunSuite("R3Saves2.profdelete", Test_R3s2ProfDeleteRun);
    Test_RunSuite("R3Saves2.profcreate", Test_R3s2ProfCreateRun);
    Test_RunSuite("R3Saves2.codex", Test_R3s2CodexRun);
    Test_RunSuite("R3Saves2.buttons", Test_R3s2Buttons);
}

function Test_R3s2ItemsRun() { Test_ProfRun("tq1_", Test_R3s2Items); }
function Test_R3s2StateRun() { Test_ProfRun("tq2_", Test_R3s2State); }
function Test_R3s2RowsRun() { Test_ProfRun("tq3_", Test_R3s2Rows); }
function Test_R3s2NewGameRun() { Test_ProfRun("tq4_", Test_R3s2NewGame); }
function Test_R3s2OverwriteRun() { Test_ProfRun("tq5_", Test_R3s2Overwrite); }
function Test_R3s2DeleteRun() { Test_ProfRun("tq6_", Test_R3s2Delete); }

function Test_R3s2Ids(_items) {
    var _out = "";
    for (var _i = 0; _i < array_length(_items); _i++) _out += ((_i > 0) ? "," : "") + _items[_i].id;
    return _out;
}

function Test_R3s2Enabled(_items) {
    var _out = "";
    for (var _i = 0; _i < array_length(_items); _i++) _out += _items[_i].enabled ? "1" : "0";
    return _out;
}

// A fake title controller with the title menu on its stack: only what New Game / Load Game need.
function Test_R3s2Title() {
    var _c = { title_exit: undefined, title_stk: Ui_StackNew(), title_seed: undefined };
    var _m = Ui_MenuNew("test_r3s2_title", Title_MainItems(false, false), { owner: _c });
    Ui_StackPush(_c.title_stk, _m);
    return _c;
}

function Test_R3s2Items(_p) {
    var _a = Title_MainItems(false, false);
    Test_Eq("saves2 items: the rows in order (D175: Continue, New Game, Load Game, Settings, Quit)", Test_R3s2Ids(_a), "continue,new,load,settings,exit");
    Test_Eq("saves2 items: Continue reads Continue", _a[0].label, "Continue");
    Test_Eq("saves2 items: New Game reads New Game", _a[1].label, "New Game");
    Test_Eq("saves2 items: Load Game reads Load Game", _a[2].label, "Load Game");
    Test_Eq("saves2 items: no save file: only New Game, Settings and Quit are on", Test_R3s2Enabled(_a), "01011");
    Test_Eq("saves2 items: a Continue target turns Continue on", Test_R3s2Enabled(Title_MainItems(true, false)), "11011");
    Test_Eq("saves2 items: a save file turns Load Game on", Test_R3s2Enabled(Title_MainItems(false, true)), "01111");
    Test_Eq("saves2 items: both on", Test_R3s2Enabled(Title_MainItems(true, true)), "11111");
    Test_Eq("saves2 items: New Game with an empty save file starts in it", Title_NewPlan(2).kind, "start");
    Test_Eq("saves2 items: and says which one", Title_NewPlan(2).slot, 2);
    Test_Eq("saves2 items: New Game with no empty save file asks which to overwrite", Title_NewPlan(-1).kind, "overwrite");
    Test_Eq("saves2 items: the save file names", Title_SlotName(0) + "|" + Title_SlotName(2), "Save 1|Save 3");
    Test_Eq("saves2 items: the last-saved stamp", Title_FormatSaved(date_create_datetime(2026, 10, 16, 14, 5, 0)), "2026-10-16 14:05");
    Test_Eq("saves2 items: an unknown stamp is a dash", Title_FormatSaved(-1), "-");
}

function Test_R3s2State(_p) {
    var _st = Title_State();
    Test_Eq("saves2 state: a fresh profile has no Continue target", _st.cont, -1);
    Test_Eq("saves2 state: its first empty save file is the first one", _st.first_empty, 0);
    Test_False("saves2 state: and nothing to load", _st.any);
    Test_Eq("saves2 state: Title_State lists the three save files", array_length(_st.slots), 3);
    Test_ProfPutRun(_p + "run_0_1.sav", 3, 11, CLASS_KNIGHT, 3, 2, 9000, 40);
    _st = Title_State();
    Test_Eq("saves2 state: the only save file is the Continue target", _st.cont, 1);
    Test_Eq("saves2 state: the first empty one is still save 1", _st.first_empty, 0);
    Test_True("saves2 state: there is something to load", _st.any);
    Test_Eq("saves2 state: the items follow", Test_R3s2Enabled(Title_MainItems(_st.cont >= 0, _st.any)), "11111");
    Test_ProfPutRun(_p + "run_0_0.sav", 3, 12, CLASS_MAGE, 1, 1, 1000, 30);
    Test_ProfPutRun(_p + "run_0_2.sav", 3, 13, CLASS_ARCHER, 2, 1, 1000, 20);
    _st = Title_State();
    Test_Eq("saves2 state: all three used: no empty save file", _st.first_empty, -1);
    Test_Eq("saves2 state: so New Game asks which to overwrite", Title_NewPlan(_st.first_empty).kind, "overwrite");
    // Continue and Load Game follow the ACTIVE profile (R-107)
    var _b = Profiles_Create("Bea");
    Test_True("saves2 state: a second profile switches in", Profiles_Switch(_b));
    _st = Title_State();
    Test_Eq("saves2 state: the new profile has nothing to continue", _st.cont, -1);
    Test_False("saves2 state: nor to load", _st.any);
    Test_Eq("saves2 state: its first empty save file is its first", _st.first_empty, 0);
    Test_Eq("saves2 state: the items go grey again", Test_R3s2Enabled(Title_MainItems(_st.cont >= 0, _st.any)), "01011");
    Test_True("saves2 state: back to the first profile", Profiles_Switch(0));
    _st = Title_State();
    Test_True("saves2 state: its save files are back", _st.any && _st.first_empty == -1);
    Test_Eq("saves2 state: Title_State(pid) reads any profile", Title_State(_b).any, false);
}

function Test_R3s2Rows(_p) {
    var _t = date_create_datetime(2026, 10, 16, 14, 5, 0);
    Test_ProfPutRun(_p + "run_0_0.sav", 3, 21, CLASS_KNIGHT, 3, 2, 9000, _t);
    Test_RawWrite(_p + "run_0_1.sav", Test_ProfRunText(5, 22, CLASS_MAGE, 3, 2, 9000, _t));   // a version this build does not know: "newer" (written raw: the atomic writer would refuse it)
    var _rows = Title_SlotRows(Slots_Summary(0), "load");
    Test_Eq("saves2 rows: one row per save file", array_length(_rows), 3);
    Test_Eq("saves2 rows: the first label", _rows[0].label, "Save 1");
    Test_Eq("saves2 rows: a good save shows class and level", _rows[0].value, "Knight Lv 3");
    Test_True("saves2 rows: and can be picked", _rows[0].enabled);
    Test_Eq("saves2 rows: its floor line", Test_RowValue(_rows[0].lines, "Floor"), "2");
    Test_Eq("saves2 rows: its run time line", Test_RowValue(_rows[0].lines, "Time"), "0:09");
    Test_Eq("saves2 rows: its last saved line", Test_RowValue(_rows[0].lines, "Last Saved"), "2026-10-16 14:05");
    Test_Eq("saves2 rows: a newer file says it cannot be loaded", _rows[1].value, "Cannot load");
    Test_True("saves2 rows: but it can be selected (to delete it)", _rows[1].enabled);
    Test_Eq("saves2 rows: and says why in its details", _rows[1].help, "This run was saved by a newer version of the game and cannot be loaded.");
    Test_Eq("saves2 rows: an empty save file reads Empty", _rows[2].value, "Empty");
    Test_False("saves2 rows: and is greyed in Load Game", _rows[2].enabled);
    Test_Eq("saves2 rows: ids", Test_R3s2Ids(_rows), "slot_0,slot_1,slot_2");
    var _over = Title_SlotRows(Slots_Summary(0), "overwrite");
    Test_True("saves2 rows: in the overwrite picker an empty file is a row too", _over[2].enabled);
    Test_Eq("saves2 rows: slot numbers are kept", _rows[1].slot, 1);
    Test_RawWrite(_p + "run_0_2.sav", "{{ not json");
    var _bad = Title_SlotRows(Slots_Summary(0), "load");
    Test_Eq("saves2 rows: a damaged file cannot be loaded", _bad[2].value, "Cannot load");
}

function Test_R3s2NewGame(_p) {
    Test_ConfirmReset();
    var _c = Test_R3s2Title();
    var _m = _c.title_stk.menus[0];
    Title_NewPress(_c, _m);
    Test_False("saves2 new game: an empty save file asks nothing", Confirm_IsOpen());
    Test_Eq("saves2 new game: it goes on to the seed pick", Ui_StackTop(_c.title_stk).id, "seed_choice");
    Test_False("saves2 new game: and starts nothing before the pick", is_struct(_c.title_exit));
    Title_SeedChoiceConfirm(Ui_StackTop(_c.title_stk), 0);
    Test_True("saves2 new game: the pick starts it", is_struct(_c.title_exit));
    Test_Eq("saves2 new game: in save 1", Slot_Active(), 0);
    global.run_next_seed = undefined;
    // save 1 is used: the next New Game takes save 2 without asking
    Test_ProfPutRun(_p + "run_0_0.sav", 3, 31, CLASS_KNIGHT, 2, 1, 1000, 5);
    var _c2 = Test_R3s2Title();
    Title_NewPress(_c2, _c2.title_stk.menus[0]);
    Test_False("saves2 new game: save 1 used: still no question", Confirm_IsOpen());
    Title_SeedChoiceConfirm(Ui_StackTop(_c2.title_stk), 0);
    Test_Eq("saves2 new game: the first EMPTY save file is used", Slot_Active(), 1);
    Test_True("saves2 new game: save 1 is untouched", RunSave_ExistsAt(_p + "run_0_0.sav"));
    global.run_next_seed = undefined;
}

function Test_R3s2Overwrite(_p) {
    Test_ConfirmReset();
    for (var _s = 0; _s < 3; _s++) Test_ProfPutRun(_p + "run_0_" + string(_s) + ".sav", 3, 40 + _s, CLASS_KNIGHT, 2 + _s, 1, 1000, 10 + _s);
    var _c = Test_R3s2Title();
    Title_NewPress(_c, _c.title_stk.menus[0]);
    var _top = Ui_StackTop(_c.title_stk);
    Test_Eq("saves2 overwrite: all three used: the picker opens", _top.id, "slots_overwrite");
    Test_Eq("saves2 overwrite: it is titled as the question", _top.layout.title, "Overwrite which save file?");
    Test_Eq("saves2 overwrite: three rows, all pickable", Test_R3s2Enabled(_top.items), "111");
    Test_False("saves2 overwrite: nothing is asked yet", Confirm_IsOpen());
    Ui_MenuFixCursor(_top, 1);
    _top.on_confirm(_top, 1);
    Test_True("saves2 overwrite: picking a file asks Yes / No", Confirm_IsOpen());
    Test_Eq("saves2 overwrite: the question names the file", Confirm_Question(), "Overwrite Save 2? The run in it will be lost.");
    Test_Eq("saves2 overwrite: it starts on No", Confirm_Menu().cursor, 1);
    Confirm_Back();
    Test_True("saves2 overwrite: No keeps the file", RunSave_ExistsAt(_p + "run_0_1.sav"));
    Test_Eq("saves2 overwrite: and the picker stays", Ui_StackTop(_c.title_stk).id, "slots_overwrite");
    _top.on_confirm(_top, 1);
    Test_True("saves2 overwrite: Yes is answered", Test_ConfirmSayYes());
    Test_Eq("saves2 overwrite: Yes opens the seed pick", Ui_StackTop(_c.title_stk).id, "seed_choice");
    Test_True("saves2 overwrite: the file is not deleted before the run is really started", RunSave_ExistsAt(_p + "run_0_1.sav"));
    Test_False("saves2 overwrite: nothing started yet", is_struct(_c.title_exit));
    Title_SeedChoiceConfirm(Ui_StackTop(_c.title_stk), 0);
    Test_True("saves2 overwrite: the pick starts the run", is_struct(_c.title_exit));
    Test_Eq("saves2 overwrite: in the chosen file", Slot_Active(), 1);
    Test_False("saves2 overwrite: the old run in it is gone", RunSave_ExistsAt(_p + "run_0_1.sav"));
    Test_True("saves2 overwrite: the other files are untouched", RunSave_ExistsAt(_p + "run_0_0.sav") && RunSave_ExistsAt(_p + "run_0_2.sav"));
    var _h = Profile_Get().history;
    Test_Eq("saves2 overwrite: the lost run is in the history", array_length(_h), 1);
    if (array_length(_h) == 1) Test_Eq("saves2 overwrite: as abandoned", _h[0].result, "abandoned");
    global.run_next_seed = undefined;
}

function Test_R3s2Delete(_p) {
    Test_ConfirmReset();
    Test_ProfPutRun(_p + "run_0_0.sav", 3, 51, CLASS_KNIGHT, 2, 1, 1000, 10);
    Test_ProfPutRun(_p + "run_0_1.sav", 3, 52, CLASS_MAGE, 3, 2, 2000, 20);
    var _c = Test_R3s2Title();
    var _m = Title_PickerOpen(_c, "load");
    Test_Eq("saves2 delete: Load Game opens a picker", Ui_StackTop(_c.title_stk).id, "slots_load");
    Test_Eq("saves2 delete: the empty file is greyed", Test_R3s2Enabled(_m.items), "110");
    Test_Eq("saves2 delete: the cursor starts on the first file", _m.cursor, 0);
    Ui_MenuFixCursor(_m, 1);
    Title_PickerDeleteAsk(_c, _m);
    Test_True("saves2 delete: the delete key asks Yes / No", Confirm_IsOpen());
    Test_Eq("saves2 delete: it names the file", Confirm_Question(), "Delete Save 2? The run in it will be lost.");
    Test_Eq("saves2 delete: it starts on No", Confirm_Menu().cursor, 1);
    Confirm_Back();
    Test_True("saves2 delete: No keeps the file", RunSave_ExistsAt(_p + "run_0_1.sav"));
    Title_PickerDeleteAsk(_c, _m);
    Test_True("saves2 delete: Yes is answered", Test_ConfirmSayYes());
    Test_False("saves2 delete: the file is gone", RunSave_ExistsAt(_p + "run_0_1.sav"));
    Test_Eq("saves2 delete: the picker shows it empty", _m.items[1].value, "Empty");
    Test_False("saves2 delete: and greyed", _m.items[1].enabled);
    Test_Eq("saves2 delete: the run counts as abandoned", array_length(Profile_Get().history), 1);
    Test_Eq("saves2 delete: Continue falls back to the other file", Slots_ContinueTarget(), 0);
    Test_Eq("saves2 delete: the cursor moved off the greyed row", _m.cursor, 0);
    _m.cursor = 2;
    Title_PickerDeleteAsk(_c, _m);
    Test_False("saves2 delete: an empty file asks nothing", Confirm_IsOpen());
    Ui_MenuFixCursor(_m, 0);
    Title_PickerDeleteAsk(_c, _m);
    Test_True("saves2 delete: the last file asks too", Confirm_IsOpen());
    Test_ConfirmSayYes();
    Test_Eq("saves2 delete: with no file left the picker goes back to the title", Ui_StackDepth(_c.title_stk), 1);
    Test_False("saves2 delete: and Load Game has nothing", Title_State().any);
}

// ---- Part 2: the profile screen and the name entry ----
function Test_R3s2NameRun() { Test_ProfRun("tq7_", Test_R3s2Name); }
function Test_R3s2GridRun() { Test_ProfRun("tq8_", Test_R3s2Grid); }
function Test_R3s2ProfRowsRun() { Test_ProfRun("tq9_", Test_R3s2ProfRows); }
function Test_R3s2ProfSwitchRun() { Test_ProfRun("tqa_", Test_R3s2ProfSwitch); }
function Test_R3s2ProfDeleteRun() { Test_ProfRun("tqb_", Test_R3s2ProfDelete); }
function Test_R3s2ProfCreateRun() { Test_ProfRun("tqd_", Test_R3s2ProfCreate); }

function Test_R3s2Name(_p) {
    var _e = NameEntry_New("Profile 2");
    Test_Eq("saves2 name: the entry starts on the suggestion", _e.text, "Profile 2");
    Test_True("saves2 name: the suggestion can be accepted", NameEntry_CanConfirm(_e));
    Test_True("saves2 name: the first typed letter is accepted", NameEntry_Type(_e, "A"));
    Test_Eq("saves2 name: it replaces the suggestion", _e.text, "A");
    NameEntry_Type(_e, "B");
    NameEntry_Type(_e, "C");
    Test_Eq("saves2 name: typing ABC", _e.text, "ABC");
    Test_True("saves2 name: a digit is accepted", NameEntry_Type(_e, "7"));
    Test_True("saves2 name: so is a space", NameEntry_Type(_e, " "));
    Test_False("saves2 name: but not two spaces in a row", NameEntry_Type(_e, " "));
    NameEntry_Type(_e, "Z");
    Test_Eq("saves2 name: the text so far", _e.text, "ABC7 Z");
    Test_False("saves2 name: a character that is not a letter, digit or space is refused", NameEntry_Type(_e, "#"));
    Test_False("saves2 name: so is a lower case letter (the entry is upper case)", NameEntry_Type(_e, "q"));
    NameEntry_Backspace(_e);
    Test_Eq("saves2 name: backspace takes one away", _e.text, "ABC7 ");
    Test_Eq("saves2 name: the value is trimmed", NameEntry_Value(_e), "ABC7");
    for (var _i = 0; _i < 12; _i++) NameEntry_Type(_e, "X");
    Test_Eq("saves2 name: at most 12 characters", string_length(_e.text), 12);
    Test_False("saves2 name: the 13th is refused", NameEntry_Type(_e, "Y"));
    var _s = NameEntry_New("");
    Test_False("saves2 name: an empty name cannot be confirmed", NameEntry_CanConfirm(_s));
    NameEntry_Type(_s, " ");
    Test_Eq("saves2 name: a leading space is refused", _s.text, "");
    NameEntry_Type(_s, "A");
    NameEntry_Backspace(_s);
    Test_False("saves2 name: emptied again it is refused", NameEntry_CanConfirm(_s));
    var _f = NameEntry_New("Profile 3");
    NameEntry_Backspace(_f);
    Test_Eq("saves2 name: backspace on the suggestion clears all of it", _f.text, "");
    NameEntry_Backspace(_f);
    Test_Eq("saves2 name: and backspace on nothing does nothing", _f.text, "");
}

function Test_R3s2Grid(_p) {
    Test_Eq("saves2 grid: the first cell is A", NameEntry_CellChar(0, 0), "A");
    Test_Eq("saves2 grid: nine to a row: I ends the first", NameEntry_CellChar(8, 0), "I");
    Test_Eq("saves2 grid: J starts the second", NameEntry_CellChar(0, 1), "J");
    Test_Eq("saves2 grid: 0 follows Z", NameEntry_CellChar(8, 2), "0");
    Test_Eq("saves2 grid: the last cell is 9", NameEntry_CellChar(8, 3), "9");
    Test_Eq("saves2 grid: the fifth row is buttons, not letters", NameEntry_CellChar(0, 4), "");
    Test_Eq("saves2 grid: Space, Delete, OK each take a third of the last row", NameEntry_ButtonAt(0) + "," + NameEntry_ButtonAt(4) + "," + NameEntry_ButtonAt(8), "space,delete,ok");
    var _e = NameEntry_New("");
    NameEntry_Move(_e, -1, 0);
    Test_Eq("saves2 grid: left from the first column wraps to the last", _e.cx, 8);
    NameEntry_Move(_e, 1, 0);
    Test_Eq("saves2 grid: and right wraps back", _e.cx, 0);
    NameEntry_Move(_e, 0, -1);
    Test_Eq("saves2 grid: up from the first row wraps to the buttons", _e.cy, 4);
    NameEntry_Move(_e, 0, 1);
    Test_Eq("saves2 grid: down from the buttons wraps to the first row", _e.cy, 0);
    var _a = NameEntry_Press(_e);
    Test_Eq("saves2 grid: pressing a letter cell types it", _a.kind + _a.ch, "charA");
    _e.cx = 4;
    _e.cy = 4;
    Test_Eq("saves2 grid: pressing the middle button deletes", NameEntry_Press(_e).kind, "delete");
    _e.cx = 8;
    Test_Eq("saves2 grid: pressing the last button finishes", NameEntry_Press(_e).kind, "ok");
    _e.cx = 1;
    Test_Eq("saves2 grid: pressing the first button types a space", NameEntry_Press(_e).kind, "space");
}

// A profile file with stats, for another profile than the active one.
function Test_R3s2WriteStats(_pid, _runs, _wins, _best) {
    var _path = Profiles_PathOf(_pid);
    var _r = Profile_Load(_path);
    var _pr = _r.profile;
    _pr.runs_started = _runs;
    _pr.wins = _wins;
    _pr.best_floor = _best;
    Profile_SaveTo(_path, _pr);
}

function Test_R3s2ProfRows(_p) {
    var _rows = Title_ProfileRows();
    Test_Eq("saves2 profiles: one profile: its row and New Profile", Test_R3s2Ids(_rows), "prof_0,prof_new");
    Test_Eq("saves2 profiles: the row is the name", _rows[0].label, "Profile 1");
    Test_Eq("saves2 profiles: the active one is marked", _rows[0].value, "Active");
    Test_Eq("saves2 profiles: New Profile reads New Profile", _rows[1].label, "New Profile");
    Profile_Get().runs_started = 5;
    Profile_Get().wins = 2;
    Profile_Get().best_floor = 6;
    Profile_Flush();
    var _b = Profiles_Create("Bea");
    Test_R3s2WriteStats(_b, 9, 1, 3);
    _rows = Title_ProfileRows();
    Test_Eq("saves2 profiles: two profiles and New Profile", Test_R3s2Ids(_rows), "prof_0,prof_1,prof_new");
    Test_Eq("saves2 profiles: the active profile's runs", Test_RowValue(_rows[0].lines, "Runs"), "5");
    Test_Eq("saves2 profiles: its wins", Test_RowValue(_rows[0].lines, "Wins"), "2");
    Test_Eq("saves2 profiles: its best floor", Test_RowValue(_rows[0].lines, "Best Floor"), "6");
    Test_Eq("saves2 profiles: another profile's runs come from its own file", Test_RowValue(_rows[1].lines, "Runs"), "9");
    Test_Eq("saves2 profiles: its wins", Test_RowValue(_rows[1].lines, "Wins"), "1");
    Test_Eq("saves2 profiles: its best floor", Test_RowValue(_rows[1].lines, "Best Floor"), "3");
    Test_Eq("saves2 profiles: only the active one says Active", _rows[1].value, "");
    Profiles_Create("Cy");
    Profiles_Create("Di");
    _rows = Title_ProfileRows();
    Test_Eq("saves2 profiles: four profiles and no New Profile row", Test_R3s2Ids(_rows), "prof_0,prof_1,prof_2,prof_3");
    var _c = Test_R3s2Title();
    var _m = Title_ProfileOpen(_c);
    Test_Eq("saves2 profiles: the screen opens above the title", Ui_StackTop(_c.title_stk).id, "profiles");
    Test_Eq("saves2 profiles: titled Profiles", _m.layout.title, "Profiles");
    Test_Eq("saves2 profiles: the cursor starts on the active profile", _m.cursor, 0);
    Test_Eq("saves2 profiles: four rows", array_length(_m.items), 4);
}

function Test_R3s2ProfSwitch(_p) {
    Test_ProfPutRun(_p + "run_0_0.sav", 3, 61, CLASS_KNIGHT, 2, 1, 1000, 5);
    var _b = Profiles_Create("Bea");
    var _c = Test_R3s2Title();
    var _m = Title_ProfileOpen(_c);
    Test_Eq("saves2 switch: the screen is open", Ui_StackDepth(_c.title_stk), 2);
    Ui_MenuFixCursor(_m, 1);
    _m.on_confirm(_m, 1);
    Test_Eq("saves2 switch: confirming another profile switches to it", Profiles_Active(), _b);
    Test_Eq("saves2 switch: the screen closes", Ui_StackDepth(_c.title_stk), 1);
    Test_True("saves2 switch: the title is asked to refresh", _c.title_refresh);
    var _st = Title_State();
    Test_Eq("saves2 switch: Continue follows: Bea has no save file", _st.cont, -1);
    var _m2 = Title_ProfileOpen(_c);
    Test_Eq("saves2 switch: the cursor starts on the active profile", _m2.cursor, 1);
    Ui_MenuFixCursor(_m2, 0);
    _m2.on_confirm(_m2, 0);
    Test_Eq("saves2 switch: back to Profile 1", Profiles_Active(), 0);
    Test_Eq("saves2 switch: Continue follows: its save file is back", Title_State().cont, 0);
    var _m3 = Title_ProfileOpen(_c);
    _m3.on_confirm(_m3, 0);
    Test_Eq("saves2 switch: confirming the active profile changes nothing", Profiles_Active(), 0);
    Test_Eq("saves2 switch: and closes the screen", Ui_StackDepth(_c.title_stk), 1);
}

function Test_R3s2ProfDelete(_p) {
    Test_ConfirmReset();
    Test_ProfPutRun(_p + "run_0_0.sav", 3, 62, CLASS_KNIGHT, 2, 1, 1000, 5);
    var _b = Profiles_Create("Bea");
    Test_ProfPutRun(_p + "run_" + string(_b) + "_1.sav", 3, 63, CLASS_MAGE, 2, 1, 1000, 6);
    var _c = Test_R3s2Title();
    var _m = Title_ProfileOpen(_c);
    Ui_MenuFixCursor(_m, 1);
    Title_ProfileDeleteAsk(_c, _m);
    Test_True("saves2 profile delete: the delete key asks Yes / No", Confirm_IsOpen());
    Test_Eq("saves2 profile delete: the question names the profile", Confirm_Question(), "Delete profile Bea? Its Codex, history and save files are lost.");
    Test_Eq("saves2 profile delete: it starts on No", Confirm_Menu().cursor, 1);
    Confirm_Back();
    Test_Eq("saves2 profile delete: No keeps it", array_length(Profiles_List()), 2);
    Title_ProfileDeleteAsk(_c, _m);
    Test_True("saves2 profile delete: Yes is answered", Test_ConfirmSayYes());
    Test_Eq("saves2 profile delete: the profile is gone", array_length(Profiles_List()), 1);
    Test_False("saves2 profile delete: and its save files", RunSave_ExistsAt(_p + "run_" + string(_b) + "_1.sav"));
    Test_Eq("saves2 profile delete: the screen shows one profile and New Profile", Test_R3s2Ids(_m.items), "prof_0,prof_new");
    Test_Eq("saves2 profile delete: the other profile's save files are untouched", Title_State(0).any, true);
    Test_Eq("saves2 profile delete: the screen stays open", Ui_StackTop(_c.title_stk).id, "profiles");
    // deleting the active one switches as the data layer does
    var _d = Profiles_Create("Dee");
    Profiles_Switch(_d);
    var _m2 = Title_ProfileOpen(_c);
    Test_Eq("saves2 profile delete: the cursor is on the active profile", _m2.items[_m2.cursor].pid, _d);
    Title_ProfileDeleteAsk(_c, _m2);
    Test_ConfirmSayYes();
    Test_Eq("saves2 profile delete: deleting the active profile makes the first one active", Profiles_Active(), 0);
    Test_True("saves2 profile delete: the title is asked to refresh", _c.title_refresh);
    // the last profile cannot be deleted away: a fresh Profile 1 stands in
    var _m3 = Ui_StackTop(_c.title_stk);
    Title_ProfileDeleteAsk(_c, _m3);
    Test_ConfirmSayYes();
    Test_Eq("saves2 profile delete: the last profile is replaced by a fresh one", array_length(Profiles_List()), 1);
    Test_Eq("saves2 profile delete: named Profile 1", Profiles_ActiveName(), "Profile 1");
    Test_False("saves2 profile delete: with nothing saved", Title_State().any);
}

function Test_R3s2ProfCreate(_p) {
    Test_ConfirmReset();
    var _c = Test_R3s2Title();
    var _m = Title_ProfileOpen(_c);
    Ui_MenuFixCursor(_m, 1);
    _m.on_confirm(_m, 1);
    var _n = Title_NameOf(_c);
    Test_True("saves2 create: New Profile opens the name entry", is_struct(_n));
    Test_Eq("saves2 create: it suggests Profile 2", _n.e.text, "Profile 2");
    NameEntry_Type(_n.e, "A");
    NameEntry_Type(_n.e, "B");
    NameEntry_Type(_n.e, "C");
    Title_NameConfirm(_c);
    Test_False("saves2 create: confirming closes the entry", is_struct(Title_NameOf(_c)));
    Test_Eq("saves2 create: the profile exists", array_length(Profiles_List()), 2);
    Test_Eq("saves2 create: it is the active one, named ABC", Profiles_ActiveName(), "ABC");
    Test_Eq("saves2 create: the profile screen closes", Ui_StackDepth(_c.title_stk), 1);
    Test_True("saves2 create: the title is asked to refresh", _c.title_refresh);
    Test_False("saves2 create: it starts fresh: nothing saved", Title_State().any);
    Test_False("saves2 create: it starts fresh: the intro is not seen", Story_Seen(Story_CutsceneKey("intro")));
    // an empty name is refused and nothing is made
    var _m2 = Title_ProfileOpen(_c);
    Ui_MenuFixCursor(_m2, array_length(_m2.items) - 1);
    _m2.on_confirm(_m2, array_length(_m2.items) - 1);
    var _n2 = Title_NameOf(_c);
    NameEntry_Backspace(_n2.e);
    Title_NameConfirm(_c);
    Test_True("saves2 create: an empty name keeps the entry open", is_struct(Title_NameOf(_c)));
    Test_Eq("saves2 create: and makes no profile", array_length(Profiles_List()), 2);
    Test_True("saves2 create: with a line saying why", Title_NameOf(_c).msg);
    // Esc / Back cancels
    Title_NameCancel(_c);
    Test_False("saves2 create: cancel closes the entry", is_struct(Title_NameOf(_c)));
    Test_Eq("saves2 create: and the profile screen is still there", Ui_StackTop(_c.title_stk).id, "profiles");
}

// ---- Part 3: the Codex and Run History from the title (read-only, the active profile's) ----
function Test_R3s2CodexRun() { Test_ProfRun("tqe_", Test_R3s2Codex); }

function Test_R3s2Codex(_p) {
    var _c = Test_R3s2Title();
    Test_False("saves2 codex: nothing is open to begin with", is_struct(Title_CodexOf(_c)));
    Title_CodexOpen(_c);
    var _cx = Title_CodexOf(_c);
    Test_True("saves2 codex: the Codex button opens the screen", is_struct(_cx));
    var _root = Ui_StackTop(_cx.stk);
    Test_Eq("saves2 codex: the root is the Codex list as the Tab menu has it", Test_R3s2Ids(_root.items), "bestiary,notes,history,unlocks");
    Test_Eq("saves2 codex: titled Codex", _root.layout.title, "Codex");
    Test_False("saves2 codex: with no run in the history, Run History is greyed", _root.items[2].enabled);
    Test_Eq("saves2 codex: and counts 0", _root.items[2].value, "0");
    Profile_RecordRun(Profile_Get(), { seed: 5, class_id: CLASS_KNIGHT, level: 3, floor: 2, room: "rm_floor2", result: "died", cause: "Slime", kills: 4, gold: 9, at: 1 });
    Profile_Flush();
    var _c2 = Test_R3s2Title();
    Title_CodexOpen(_c2);
    var _r2 = Ui_StackTop(Title_CodexOf(_c2).stk);
    Test_True("saves2 codex: one run in the history turns Run History on", _r2.items[2].enabled);
    Test_Eq("saves2 codex: and counts 1", _r2.items[2].value, "1");
    var _before = json_stringify(Profile_Get());
    Test_True("saves2 codex: Run History opens", Title_CodexPage(_c2, "history"));
    var _hm = Ui_StackTop(Title_CodexOf(_c2).stk);
    Test_Eq("saves2 codex: the page is the Tab menu's Run History page", _hm.id, "codex_history");
    Test_Eq("saves2 codex: one run, newest first: class and level", _hm.items[0].label, "Knight Lv 3");
    Test_Eq("saves2 codex: it is on top of the list", Ui_StackDepth(Title_CodexOf(_c2).stk), 2);
    Test_True("saves2 codex: the Bestiary opens", Title_CodexPage(_c2, "bestiary"));
    Test_Eq("saves2 codex: with the ten enemies", array_length(Ui_StackTop(Title_CodexOf(_c2).stk).items), 10);
    Test_True("saves2 codex: Notes opens", Title_CodexPage(_c2, "notes"));
    Test_True("saves2 codex: Unlocks opens", Title_CodexPage(_c2, "unlocks"));
    Test_Eq("saves2 codex: looking changes nothing in the profile", json_stringify(Profile_Get()), _before);
    // it is the ACTIVE profile's: a second profile has an empty history
    var _b = Profiles_Create("Bea");
    Profiles_Switch(_b);
    var _c3 = Test_R3s2Title();
    Title_CodexOpen(_c3);
    var _r3 = Ui_StackTop(Title_CodexOf(_c3).stk);
    Test_Eq("saves2 codex: another profile has its own, empty history", _r3.items[2].value, "0");
    Test_False("saves2 codex: a page with nothing in it does not open", Title_CodexPage(_c3, "history"));
    Test_Eq("saves2 codex: the list stays", Ui_StackDepth(Title_CodexOf(_c3).stk), 1);
    Profiles_Switch(0);
    var _c4 = Test_R3s2Title();
    Title_CodexOpen(_c4);
    Test_Eq("saves2 codex: back on the first profile its run is counted again", Ui_StackTop(Title_CodexOf(_c4).stk).items[2].value, "1");
    // Back from the list closes the screen
    Title_CodexOnBack(Ui_StackTop(Title_CodexOf(_c4).stk), "root");
    Test_False("saves2 codex: Back at the list closes the Codex", is_struct(Title_CodexOf(_c4)));
    Test_Eq("saves2 codex: the title is still there", Ui_StackDepth(_c4.title_stk), 1);
}

// Which corner button a point is on (pure: the rectangles the draw keeps in title_btn).
function Test_R3s2Buttons() {
    var _c = { title_btn: { profile: { x: 10, y: 100, w: 60, h: 30 }, codex: { x: 10, y: 60, w: 50, h: 30 } } };
    Test_Eq("saves2 buttons: a point on the profile button", Title_ButtonHit(_c, 20, 110), "profile");
    Test_Eq("saves2 buttons: a point on the codex button", Title_ButtonHit(_c, 20, 70), "codex");
    Test_Eq("saves2 buttons: a point on neither", Title_ButtonHit(_c, 200, 200), "");
    Test_Eq("saves2 buttons: the right and bottom edges are outside", Title_ButtonHit(_c, 70, 110) + Title_ButtonHit(_c, 20, 130), "");
    var _z = { title_btn: { profile: { x: 0, y: 0, w: 0, h: 0 }, codex: { x: 0, y: 0, w: 0, h: 0 } } };
    Test_Eq("saves2 buttons: a button that was not drawn is not hit", Title_ButtonHit(_z, 0, 0), "");
}

// ---- R3 guardsmall item 1 (D180, R-102): Guard halves ALL damage until the player's next turn starts, and gives back 25% of max MP (at least 2, capped). ----
// Expected values come from the owner's decision: 25% of max MP rounded down, minimum 2, never above max MP; max MP per class and level from the class vectors above.

// One Guard through the real turn order: the Guard turn, then the enemy's turn (two hits in it when _hits), up to the player's next turn. Returns what happened.
function Test_R3GuardSequence(_hits, _src, _plain) {
    var _slime = EnemyCreate(ENEMY_SLIME);
    var _bp = CharacterCreate_Player(CLASS_KNIGHT);
    _bp.max_hp = 999; _bp.hp = 999;   // the hits must not end the fight
    var _bc = Test_Hunt1Bc(_bp, EnemyCreate(ENEMY_SLIME));
    _bc.p = Battle_GuardApply(_bc.p);
    Battle_PlayerFinalizeTurn(_bc, _bc.p, _bc.e);   // the Guard turn
    var _r = { enemy_turns: 0, braced_all_enemy: true, halved: true, gone_at_player: false, who: _bc.tl_who };
    for (var _k = 0; _k < 8; _k++) {
        if (_bc.tl_who == TL_ENEMY) {
            if (!Status_Has(_bc.p, STATUS_BRACE)) _r.braced_all_enemy = false;
            if (_hits) {
                var _a = Combat_ApplyDamage(_slime, _bc.p, _src, 1, 1, { is_skill: false });
                var _b = Combat_ApplyDamage(_slime, _a.defender, _src, 1, 1, { is_skill: false });
                if (abs(_a.dmg - _plain * 0.5) > 1 || _b.dmg != _a.dmg) _r.halved = false;
            }
            _bc.enemy_actions_remaining = 0;
            Battle_EnemyFinalizeTurnState(_bc, _bc.p, _bc.e);
            _r.enemy_turns++;
        } else if (_r.enemy_turns > 0) {
            _r.gone_at_player = !Status_Has(_bc.p, STATUS_BRACE);
            break;
        } else {
            Battle_PlayerFinalizeTurn(_bc, _bc.p, _bc.e);   // a faster player acts again before the enemy: the Brace waits for the enemy
        }
    }
    _r.who = _bc.tl_who;
    return _r;
}

function Test_Suite_R3Guard() {
    var _slime = EnemyCreate(ENEMY_SLIME);
    var _src = { power: 30, stat_type: STAT_ATK };
    var _plain = Combat_ApplyDamage(_slime, CharacterCreate_Player(CLASS_KNIGHT), _src, 1, 1, { is_skill: false }).dmg;
    Test_True("r3guard: (setup) an unguarded hit is big enough to halve (" + string(_plain) + ")", _plain >= 8);

    // two hits in one enemy turn (a chain) or in two enemy turns: both halved, the Brace is not used up by the first
    var _g = Battle_GuardApply(CharacterCreate_Player(CLASS_KNIGHT));
    var _h1 = Combat_ApplyDamage(_slime, _g, _src, 1, 1, { is_skill: false });
    Test_True("r3guard: the first hit is halved (" + string(_plain) + " -> " + string(_h1.dmg) + ")", abs(_h1.dmg - _plain * 0.5) <= 1);
    Test_True("r3guard: the Brace is still up after the first hit", Status_Has(_h1.defender, STATUS_BRACE));
    var _h2 = Combat_ApplyDamage(_slime, _h1.defender, _src, 1, 1, { is_skill: false });
    Test_Eq("r3guard: the second hit is halved the same", _h2.dmg, _h1.dmg);
    Test_True("r3guard: the Brace is still up after the second hit", Status_Has(_h2.defender, STATUS_BRACE));
    Test_True("r3guard: the damage preview shows the halved number", Combat_HitDamage(_slime, _g, _src) < _plain);

    // MP back: 25% of max MP, rounded down, minimum 2; max MP Knight 11 / 13, Archer 12 / 16, Mage 16 / 22, Nobody 11 / 13 at levels 1 / 3
    var _cls = [[CLASS_KNIGHT, "Knight"], [CLASS_ARCHER, "Archer"], [CLASS_MAGE, "Mage"], [CLASS_NOBODY, "Nobody"]];
    var _want = [[2, 3], [3, 4], [4, 5], [2, 3]];
    var _maxmp = [[11, 13], [12, 16], [16, 22], [11, 13]];   // D176 (r3levelup): max MP from MND; Mage 22 and Nobody 13 at level 3 (were 23 / 14 with MAG adding MP); 25% still rounds to 5 / 3
    for (var _c = 0; _c < 4; _c++) {
        for (var _lv = 0; _lv < 2; _lv++) {
            var _pl = CharacterCreate_Player(_cls[_c][0]);
            if (_lv == 1) { _pl = LevelUp_ApplyLevel(_pl); _pl = LevelUp_ApplyLevel(_pl); }
            var _tag = "r3guard: " + _cls[_c][1] + " level " + string(_lv * 2 + 1);
            Test_Eq(_tag + " (setup) max MP", _pl.max_mp, _maxmp[_c][_lv]);
            _pl.mp = 0;
            Test_Eq(_tag + " gets 25% of max MP (min 2) back from empty", Battle_GuardApply(_pl).mp, _want[_c][_lv]);
        }
    }
    var _lo = CharacterCreate_Player(CLASS_KNIGHT);
    _lo.max_mp = 6; _lo.mp = 0;
    Test_Eq("r3guard: a small MP pool still gets 2 back (25% of 6 rounds down to 1)", Battle_GuardApply(_lo).mp, 2);
    var _cap = CharacterCreate_Player(CLASS_MAGE);
    _cap.mp = _cap.max_mp - 1;
    Test_Eq("r3guard: the MP never goes above max MP", Battle_GuardApply(_cap).mp, _cap.max_mp);
    var _full = CharacterCreate_Player(CLASS_ARCHER);
    Test_Eq("r3guard: full MP stays full", Battle_GuardApply(_full).mp, _full.max_mp);

    // it still stacks with the defence bar: the bar takes its share off the already halved hit
    var _half = Combat_ApplyDamage(_slime, Battle_GuardApply(CharacterCreate_Player(CLASS_KNIGHT)), _src, 1, 1, { is_skill: false }).dmg;
    Test_True("r3guard: a Good block (half through) of the halved hit is about a quarter of the plain hit (" + string(_plain) + " -> " + string(Qte_DefenceDamage(_half, QTE_GOOD)) + ")", abs(Qte_DefenceDamage(_half, QTE_GOOD) - _plain * 0.25) <= 1.5);

    // the Brace ends when the player's next turn starts (after the enemy has acted): follow the real turn order
    var _s1 = Test_R3GuardSequence(true, _src, _plain);
    Test_True("r3guard: the enemy got a turn in the sequence", _s1.enemy_turns >= 1);
    Test_True("r3guard: the player was Braced for the enemy's whole turn", _s1.braced_all_enemy);
    Test_True("r3guard: both of its hits in that turn were halved", _s1.halved);
    Test_True("r3guard: and the Brace is gone as the player's next turn starts", _s1.gone_at_player && _s1.who == TL_PLAYER);
    var _s2 = Test_R3GuardSequence(false, _src, _plain);   // an enemy turn without a hit (a wind-up): the Brace still ends with it
    Test_True("r3guard: a turn with no hit: the player was Braced throughout it", _s2.enemy_turns >= 1 && _s2.braced_all_enemy);
    Test_True("r3guard: a turn with no hit: the Brace is gone as the player's next turn starts", _s2.gone_at_player && _s2.who == TL_PLAYER);
}

// ---- R3 guardsmall item 2 (R-103, owner note 17): a one-time reaction (the wolf's, the slime's) reaches the PROFILE the moment it is shown, so the game being killed or quit before the
// next autosave cannot replay it; an event the profile has seen never queues, whatever the run's flags say. ----
function Test_Suite_R3Wolf() { Test_ProfRun("tpw_", Test_R3WolfRun); }

function Test_R3VictoryHasSlimeLine(_lines) {
    var _want = Loc_T("combat.msg.floor1_reaction.0", "That thing was alive. And I nearly wasn't.");
    for (var _i = 0; _i < array_length(_lines); _i++) if (is_string(_lines[_i]) && _lines[_i] == _want) return true;
    return false;
}

function Test_R3WolfRun(_prefix) {
    var _gs = GameState_Get();
    var _old_flags = _gs.flags;
    var _had_battle = variable_struct_exists(_gs, "battle") && is_struct(_gs.battle);
    var _old_id = (_had_battle && variable_struct_exists(_gs.battle, "enemy_id")) ? _gs.battle.enemy_id : -1;
    var _old_room = (_had_battle && variable_struct_exists(_gs.battle, "enemy_room")) ? _gs.battle.enemy_room : -1;
    _gs.flags = {};
    var _id = "floor2_dire_wolf_reaction";
    var _key = "flag:" + Dialogue_NarrativeDoneFlagKey(_id);

    // the wolf: killed, queued, shown (marked done)
    Test_True("r3wolf: killing the Dire Wolf on floor 2 queues its reaction the first time", Dialogue_NarrativeOnEnemyDefeated(ENEMY_DIREWOLF, rm_floor2));
    Dialogue_NarrativeMarkDone(_id);
    Test_True("r3wolf: marking it done marks the profile's story key at once", Story_Seen(_key));
    // the game being killed: the process dies before the 10 s autosave: the profile comes back from disk, the run is rebuilt from the last save (without the flag)
    Test_ProfRelaunch();
    _gs.flags = {};
    Test_True("r3wolf: the profile file has it after the game was killed", Story_Seen(_key));
    Test_True("r3wolf: so the event reads as done", Dialogue_NarrativeIsDone(_id));
    Test_False("r3wolf: killing the wolf again does not queue the reaction", Dialogue_NarrativeOnEnemyDefeated(ENEMY_DIREWOLF, rm_floor2));
    Test_False("r3wolf: and nothing is pending", Dialogue_NarrativeIsPending(_id));

    // another event goes the same way (the Stranger's), and one nobody has seen is untouched
    Dialogue_NarrativeMarkDone("first_stranger_encounter_reaction");
    Test_ProfRelaunch();
    _gs.flags = {};
    Test_False("r3wolf: the Stranger's reaction does not queue again after the game was killed either", Dialogue_NarrativeOnStrangerEncounterResolved());
    Test_True("r3wolf: an event nobody has seen still queues", Dialogue_NarrativeOnLevelUp(1));

    // the slime's one-time lines after the first fight
    Profile_ResetForTest();
    _gs.flags = {};
    if (!_had_battle) _gs.battle = {};
    _gs.battle.enemy_id = ENEMY_SLIME;
    _gs.battle.enemy_room = rm_floor1;
    var _foe = EnemyCreate(ENEMY_SLIME);
    var _hero = CharacterCreate_Player(CLASS_KNIGHT);
    Test_True("r3wolf: the first slime kill says its line", Test_R3VictoryHasSlimeLine(Battle_BuildVictoryDialogueLines(_foe, {}, _hero)));
    Test_True("r3wolf: and marks the profile at once", Story_Seen("flag:floor1_slime_kill_reaction_done"));
    Test_ProfRelaunch();
    _gs.flags = {};
    Test_False("r3wolf: after the game was killed the slime line does not come back", Test_R3VictoryHasSlimeLine(Battle_BuildVictoryDialogueLines(_foe, {}, _hero)));

    _gs.flags = _old_flags;
    if (_had_battle) { _gs.battle.enemy_id = _old_id; _gs.battle.enemy_room = _old_room; } else variable_struct_remove(_gs, "battle");
}

// ---- R3 guardsmall item 3 (R-104, owner note 20): a shop row the player cannot carry (full throwables, gear already owned) is dimmed and its details say why; buying is still refused and keeps the gold. ----
function Test_Suite_R3Shop() {
    var _gs = GameState_Get();
    var _had_run = variable_struct_exists(_gs, "run");
    var _old_run = _had_run ? _gs.run : undefined;
    _gs.run = Run_Create(4711);
    _gs.run.gold = 200;
    var _full_txt = Loc_T("shop.reason.full", "Bag full for this item");
    var _owned_txt = Loc_T("shop.reason.owned", "Already owned");

    // full throwables: the Firebomb (30) row
    var _kn = CharacterCreate_Player(CLASS_KNIGHT);
    _kn.inventory = Inv_Add(_kn.inventory, 30, Throw_Cap(_kn));
    var _row = { kind: "item", id: 30, qty: 2, price: 27 };
    var _r1 = ShopUi_ItemFor(_row, _kn, 200);
    Test_True("r3shop: a Firebomb row is dim when the throwable cap is reached (with gold to spare)", _r1.dim);
    Test_False("r3shop: and cannot be bought", _r1.can_buy);
    Test_True("r3shop: the row can still be looked at", _r1.enabled);
    Test_True("r3shop: the details say 'Bag full for this item'", string_pos(_full_txt, _r1.help) > 0);
    var _gold0 = _gs.run.gold;
    var _buy = Shop_Buy(_kn, _gs.run, _row);
    Test_False("r3shop: buying is still refused", _buy.ok);
    Test_Eq("r3shop: with the reason 'full'", _buy.reason, "full");
    Test_Eq("r3shop: the gold is unchanged", _gs.run.gold, _gold0);
    Test_Eq("r3shop: the stock is unchanged", _row.qty, 2);

    // room for one more: the same row is a normal buyable row, with no reason
    var _kn2 = CharacterCreate_Player(CLASS_KNIGHT);
    _kn2.inventory = Inv_Add(_kn2.inventory, 30, Throw_Cap(_kn2) - 1);
    var _r2 = ShopUi_ItemFor({ kind: "item", id: 30, qty: 2, price: 27 }, _kn2, 200);
    Test_True("r3shop: with room for one more the row is buyable", _r2.can_buy && !_r2.dim);
    Test_True("r3shop: and shows no reason", string_pos(_full_txt, _r2.help) == 0 && string_pos(_owned_txt, _r2.help) == 0);

    // gear already owned (worn or in the bag)
    var _kn3 = CharacterCreate_Player(CLASS_KNIGHT);
    _kn3.inventory = Inv_Add(_kn3.inventory, 1, 1);
    Equip_Item(_kn3, 1);
    var _r3 = ShopUi_ItemFor({ kind: "item", id: 1, qty: 1, price: 30 }, _kn3, 200);
    Test_True("r3shop: a weapon the player already has is dim and cannot be bought", _r3.dim && !_r3.can_buy);
    Test_True("r3shop: the details say 'Already owned'", string_pos(_owned_txt, _r3.help) > 0);
    Test_False("r3shop: buying it is refused", Shop_Buy(_kn3, _gs.run, { kind: "item", id: 1, qty: 1, price: 30 }).ok);
    var _r4 = ShopUi_ItemFor({ kind: "item", id: 2, qty: 1, price: 30 }, _kn3, 200);
    Test_True("r3shop: a different weapon is buyable", _r4.can_buy && !_r4.dim && string_pos(_owned_txt, _r4.help) == 0);

    // the old dims stay: no gold, and sold out, with no bag reason
    var _r5 = ShopUi_ItemFor({ kind: "item", id: 10, qty: 3, price: 12 }, CharacterCreate_Player(CLASS_KNIGHT), 5);
    Test_True("r3shop: too little gold still dims a row, with no bag reason", _r5.dim && !_r5.can_buy && string_pos(_full_txt, _r5.help) == 0 && string_pos(_owned_txt, _r5.help) == 0);
    var _r6 = ShopUi_ItemFor({ kind: "item", id: 30, qty: 0, price: 27 }, _kn, 200);
    Test_True("r3shop: a sold-out row is dim and says Sold Out, not the bag reason", _r6.dim && _r6.value == Loc_T("shop.sold_out", "Sold Out") && string_pos(_full_txt, _r6.help) == 0);

    if (_had_run) _gs.run = _old_run; else variable_struct_remove(_gs, "run");
}

// ---- R3 guardsmall item 4 (D183, R-105, owner note 26): the run-end title varies by death tier, with its own titles for a win and for an abandoned run, and is never the same twice in a row for a profile. ----
function Test_Suite_R3Title() { Test_ProfRun("tpt_", Test_R3TitleRun); }

function Test_R3TitleKeys(_pool) {
    var _k = [];
    for (var _i = 0; _i < array_length(_pool); _i++) array_push(_k, _pool[_i].key);
    return _k;
}

function Test_ArrHasStr(_arr, _s) {
    for (var _i = 0; _i < array_length(_arr); _i++) if (_arr[_i] == _s) return true;
    return false;
}

function Test_R3TitleRun(_prefix) {
    var _tiers = [1, 2, 4, 7, 11];   // a death count in each tier (1st, 2nd-3rd, 4th-6th, 7th-10th, 11th on)
    var _all_keys = {};
    var _lines_ok = true;
    for (var _t = 0; _t < array_length(_tiers); _t++) {
        var _pool = RunTitle_Pool("died", _tiers[_t]);
        Test_True("r3title: death " + string(_tiers[_t]) + " has at least 3 titles to pick from (" + string(array_length(_pool)) + ")", array_length(_pool) >= 3);
        var _keys = Test_R3TitleKeys(_pool);
        for (var _k = 0; _k < array_length(_keys); _k++) {
            if (variable_struct_exists(_all_keys, _keys[_k])) _lines_ok = false;   // a title belongs to one tier only
            variable_struct_set(_all_keys, _keys[_k], true);
        }
    }
    Test_True("r3title: the five death tiers share no title", _lines_ok);
    var _win = Test_R3TitleKeys(RunTitle_Pool("won", 5));
    var _ab = Test_R3TitleKeys(RunTitle_Pool("abandoned", 5));
    Test_True("r3title: a win has at least 2 titles of its own", array_length(_win) >= 2);
    Test_True("r3title: an abandoned run has at least 2 titles of its own", array_length(_ab) >= 2);
    var _shared = false;
    for (var _w = 0; _w < array_length(_win); _w++) if (variable_struct_exists(_all_keys, _win[_w]) || Test_ArrHasStr(_ab, _win[_w])) _shared = true;
    for (var _a = 0; _a < array_length(_ab); _a++) if (variable_struct_exists(_all_keys, _ab[_a])) _shared = true;
    Test_False("r3title: the win and abandoned titles are not death titles, nor each other's", _shared);

    // never the last title again, whatever the salt
    var _again = false;
    var _results = ["died", "abandoned", "won"];
    for (var _r = 0; _r < 3; _r++) {
        var _pl = RunTitle_Pool(_results[_r], 5);
        if (array_length(_pl) < 2) _again = true;   // with one title there is no other to pick
        for (var _l = 0; _l < array_length(_pl); _l++) {
            for (var _salt = 0; _salt < 12; _salt++) if (RunTitle_Pick(_results[_r], 5, _pl[_l].key, _salt).key == _pl[_l].key) _again = true;
        }
    }
    Test_False("r3title: a pick is never the title shown last", _again);
    var _seen = {};
    for (var _salt2 = 0; _salt2 < 12; _salt2++) variable_struct_set(_seen, RunTitle_Pick("died", 2, "", _salt2).key, true);
    Test_True("r3title: across salts every title of a tier comes up", array_length(variable_struct_get_names(_seen)) == array_length(RunTitle_Pool("died", 2)) && array_length(RunTitle_Pool("died", 2)) >= 3);

    // the real choice, through the profile: twelve deaths in a row, the same tier several times
    var _prof = Profile_Get();
    var _prev = "";
    var _same = 0;
    var _stored = true;
    for (var _d = 1; _d <= 12; _d++) {
        _prof.deaths = _d;
        var _pick = RunTitle_Choose({ result: "died", seed: 1000 + _d });
        if (_pick.key == _prev) _same++;
        if (!variable_struct_exists(Profile_Get(), "last_title") || Profile_Get().last_title != _pick.key) _stored = false;
        _prev = _pick.key;
    }
    Test_Eq("r3title: twelve deaths in a row never show the same title twice running", _same, 0);
    Test_True("r3title: the profile keeps the key of the title it showed last", _stored);
    Profile_Flush();
    Test_ProfRelaunch();
    Test_True("r3title: ... also after a relaunch (it is in the profile file)", variable_struct_exists(Profile_Get(), "last_title") && Profile_Get().last_title == _prev);
    var _p2 = Profile_Get();
    _p2.deaths = 5;
    var _same2 = 0;
    var _prev2 = _prev;
    for (var _n = 0; _n < 8; _n++) {   // eight run ends in the same tier with the same seed, one after another
        var _pk = RunTitle_Choose({ result: "died", seed: 7 });
        if (_pk.key == _prev2) _same2++;
        _prev2 = _pk.key;
    }
    Test_Eq("r3title: the same tier and the same seed still never repeat", _same2, 0);

    // a win and an abandoned run show their own titles
    var _tw = RunTitle_Choose({ result: "won", seed: 3 });
    Test_True("r3title: a won run shows a win title", Test_ArrHasStr(_win, _tw.key));
    var _tw2 = RunTitle_Choose({ result: "won", seed: 3 });
    Test_True("r3title: and a second win shows another", _tw2.key != _tw.key && Test_ArrHasStr(_win, _tw2.key));
    var _ta = RunTitle_Choose({ result: "abandoned", seed: 3 });
    Test_True("r3title: an abandoned run shows an abandoned-run title", Test_ArrHasStr(_ab, _ta.key));
    Test_True("r3title: the text is a real sentence in the language of the moment", string_length(RunTitle_Text(_ta)) > 3);
}

// ============================================================================================================================
// Round 3 packet rarity (D178, R-110): every item has a rarity (1 Common white, 2 Rare gold #E8C547, 3 Epic gold that pulses to a lighter gold every 600 ms);
// every message that names an item marks the name with [r1] / [r2] / [r3]; lists draw the name in the rarity colour unless the row is dim; an icon of a Rare or
// Epic item has a small gem at its top-right corner (Epic: two frames). Expected values are the brief's: HP Potion Lv1 common, a tier-2 loot item rare, a tier-3 one epic;
// a loot-table item has the highest tier it appears at; an item in no loot table goes by its price (under 18 common, 18 to 39 rare, 40 and up epic).
// ============================================================================================================================
function Test_Suite_Rarity() {
    if (!script_exists(asset_get_index("Item_Rarity"))) {
        Test_True("r3rarity: Item_Rarity exists: not implemented", false);
        return;
    }
    var _lang = Loc_GetLanguage();
    Loc_SetLanguage("en");
    Test_RunSuite("Rarity.table", Test_RarityTable);
    Test_RunSuite("Rarity.markup", Test_RarityMarkup);
    Test_RunSuite("Rarity.colour", Test_RarityColour);
    Test_RunSuite("Rarity.paths", Test_RarityPaths);
    Test_RunSuite("Rarity.shop", Test_RarityShop);
    Test_RunSuite("Rarity.rows", Test_RarityRows);
    Test_RunSuite("Rarity.gem", Test_RarityGem);
    Test_RunSuite("Rarity.workbook", Test_RarityWorkbook);
    Loc_SetLanguage(_lang);
}

function Test_RarityTable() {
    Test_Eq("r3rarity table: HP Potion Lv1 is common", Item_Rarity(10), 1);
    Test_Eq("r3rarity table: Iron Sword (tier 2) is rare", Item_Rarity(2), 2);
    Test_Eq("r3rarity table: HP Potion Lv2 (tier 2) is rare", Item_Rarity(14), 2);
    Test_Eq("r3rarity table: Platinum Sword (tier 3) is epic", Item_Rarity(3), 3);
    Test_Eq("r3rarity table: HP Potion Lv3 (tier 3) is epic", Item_Rarity(15), 3);
    Test_Eq("r3rarity table: Wooden Sword (tier 1) is common", Item_Rarity(1), 1);
    Test_Eq("r3rarity table: Firebomb (enemy tier 2) is rare", Item_Rarity(30), 2);
    Test_Eq("r3rarity table: Smoke Bomb (enemy tier 1) is common", Item_Rarity(33), 1);
    // every loot-table item has the highest tier it appears at (in any table)
    var _best = {};
    var _tables = ["chest", "barrel", "enemy"];
    for (var _t = 0; _t < array_length(_tables); _t++) {
        var _tab = Loot_TableGet(_tables[_t]);
        for (var _i = 0; _i < array_length(_tab); _i++) {
            if (_tab[_i].item_id == 0) continue;
            var _k = string(_tab[_i].item_id);
            var _old = variable_struct_exists(_best, _k) ? variable_struct_get(_best, _k) : 0;
            variable_struct_set(_best, _k, max(_old, _tab[_i].tier));
        }
    }
    var _names = variable_struct_get_names(_best);
    var _bad = "";
    for (var _n = 0; _n < array_length(_names); _n++) if (Item_Rarity(real(_names[_n])) != variable_struct_get(_best, _names[_n])) _bad += _names[_n] + " ";
    Test_True("r3rarity table: the loot tables hold items to check", array_length(_names) >= 25);
    Test_Eq("r3rarity table: every loot-table item has the highest loot tier it appears at", _bad, "");
    // items in no loot table go by price: under 18 common, 18..39 rare, 40 and up epic
    Test_Eq("r3rarity table: Poison Pot (18, in no table) is rare", Item_Rarity(31), 2);
    Test_Eq("r3rarity table: Ice Flask (20, in no table) is rare", Item_Rarity(32), 2);
    var _acc_bad = "";
    for (var _a = 40; _a <= 46; _a++) if (Item_Rarity(_a) != 2) _acc_bad += string(_a) + " ";
    Test_Eq("r3rarity table: the rings and charms (28 to 36) are rare", _acc_bad, "");
    // every item in the DB has a rarity from 1 to 3
    var _db_bad = "";
    var _key = ds_map_find_first(global.item_db);
    var _count = 0;
    while (!is_undefined(_key)) {
        var _r = Item_Rarity(_key);
        if (_r < 1 || _r > 3) _db_bad += string(_key) + " ";
        _count++;
        _key = ds_map_find_next(global.item_db, _key);
    }
    Test_True("r3rarity table: the item DB has items to check", _count >= 30);
    Test_Eq("r3rarity table: every item has a rarity from 1 to 3", _db_bad, "");
    Test_Eq("r3rarity table: an unknown id is common (never an error)", Item_Rarity(9999), 1);
}

function Test_RarityMarkup() {
    var _n10 = string(ItemDB_Get(10).name);
    var _n2 = string(ItemDB_Get(2).name);
    var _n15 = string(ItemDB_Get(15).name);
    Test_Eq("r3rarity markup: a common name", Item_NameMarked(10), "[r1]" + _n10 + "[/r1]");
    Test_Eq("r3rarity markup: a rare name", Item_NameMarked(2), "[r2]" + _n2 + "[/r2]");
    Test_Eq("r3rarity markup: an epic name", Item_NameMarked(15), "[r3]" + _n15 + "[/r3]");
    Test_Eq("r3rarity markup: with a count the count follows the tag", Item_NameMarked(15, 3), "[r3]" + _n15 + "[/r3] x3");
    var _sentence = "Got " + Item_NameMarked(2) + " now";
    Test_True("r3rarity markup: the name is one rare span", array_length(Test_RT_Spans(_sentence, "r2")) == 1 && Test_RT_Spans(_sentence, "r2")[0] == _n2);
    Test_True("r3rarity markup: an epic span", array_length(Test_RT_Spans(Item_NameMarked(15), "r3")) == 1);
    Test_True("r3rarity markup: a common span", array_length(Test_RT_Spans(Item_NameMarked(10), "r1")) == 1);
    Test_Eq("r3rarity markup: the tags are not shown", Markup_Strip(_sentence, "keyboard"), "Got " + _n2 + " now");
    Test_Eq("r3rarity markup: the tags have no width", Markup_Width(Item_NameMarked(2), "keyboard"), Markup_Width(_n2, "keyboard"));
    Test_Eq("r3rarity markup: well-formed item tags have no problems", array_length(Markup_Problems("[r1]a[/r1] [r2]b[/r2] [r3]c[/r3]")), 0);
    Test_True("r3rarity markup: [r4] is not a tag we know", array_length(Markup_Problems("[r4]a[/r4]")) > 0);
    Test_True("r3rarity markup: an item tag does not nest a term", array_length(Markup_Problems("[r2]a [t]b[/t][/r2]")) > 0);
    Test_True("r3rarity markup: a text with an item tag goes through the rich drawer", Prompt_HasTokens(Item_NameMarked(2)));
    Test_Eq("r3rarity markup: reveal keeps the span closed", Markup_Reveal("x [r3]Platinum[/r3]", 5), "x [r3]Pla[/r3]");
    Test_Eq("r3rarity markup: a marked name fitted plain is the bare name", Ui_FitText(Item_NameMarked(2), 1000), _n2);
}

function Test_RarityColour() {
    Test_Eq("r3rarity colour: common is white", Rarity_Color(1, 0), UI_C_TEXT);
    Test_Eq("r3rarity colour: rare is exactly #E8C547", Rarity_Color(2, 0), make_color_rgb($E8, $C5, $47));
    Test_Eq("r3rarity colour: rare is the merchant gold", Rarity_Color(2, 123), UI_C_MERCHANT_GOLD);
    Test_Eq("r3rarity colour: rare does not pulse", Rarity_Color(2, 300), Rarity_Color(2, 0));
    Test_Eq("r3rarity colour: epic starts at the gold", Rarity_Color(3, 0), make_color_rgb($E8, $C5, $47));
    var _mid = Rarity_Color(3, 300);
    Test_True("r3rarity colour: epic is lighter than the gold in the middle of the pulse", _mid != Rarity_Color(3, 0) && color_get_red(_mid) >= $E8 && color_get_green(_mid) > $C5 && color_get_blue(_mid) > $47);
    Test_Eq("r3rarity colour: the pulse repeats every 600 ms", Rarity_Color(3, 600), Rarity_Color(3, 0));
    Test_Eq("r3rarity colour: and again 1200 ms on", Rarity_Color(3, 1200 + 300), Rarity_Color(3, 300));
    Test_Eq("r3rarity colour: the pulse is 0 at the start and 1 in the middle", string(Rarity_Pulse(0)) + "/" + string(Rarity_Pulse(300)), "0/1");
    Test_True("r3rarity colour: Markup_Colour follows the rarity", Markup_Colour("r1", UI_C_LIGHT) == UI_C_TEXT && Markup_Colour("r2", UI_C_LIGHT) == UI_C_MERCHANT_GOLD);
    Test_True("r3rarity colour: common text is not the term green", Rarity_Color(1, 0) != UI_C_TERM);
    global.rarity_clock = 300;
    Test_Eq("r3rarity colour: with the clock held at 300 ms epic is at its lightest", Markup_Colour("r3", UI_C_LIGHT), Rarity_Color(3, 300));
    global.rarity_clock = -1;
}

// each message path names the item through Item_NameMarked: the builders are called directly
function Test_RarityPaths() {
    var _n2 = "[r2]" + string(ItemDB_Get(2).name) + "[/r2]";
    var _n3 = "[r3]" + string(ItemDB_Get(3).name) + "[/r3]";
    var _n10 = "[r1]" + string(ItemDB_Get(10).name) + "[/r1]";
    var _n30 = "[r2]" + string(ItemDB_Get(30).name) + "[/r2]";
    // chest, barrel, grave: the received line
    var _rl = Loot_ReceivedLines(2, 1);
    Test_Eq("r3rarity paths: the chest line marks a rare name", _rl[0], "Received " + _n2 + " x1.");
    Test_Eq("r3rarity paths: and a common one", Loot_ReceivedLines(10, 3)[0], "Received " + _n10 + " x3.");
    Test_Eq("r3rarity paths: the received line no longer uses the one gold accent", string_pos("[a]", Loot_ReceivedLines(10, 3)[0]), 0);
    Loc_SetLanguage("ko");
    Test_True("r3rarity paths: the Korean line marks the name too", string_pos("[r2]" + string(ItemDB_Get(2).name) + "[/r2]", Loot_ReceivedLines(2, 1)[0]) > 0 && string_pos("[a]", Loot_ReceivedLines(2, 1)[0]) == 0);
    Loc_SetLanguage("en");
    // battle drop and auto-resolve drop (one builder)
    var _en = Loot_BuildMessageEntries([{ item_id: 3, qty: 1 }, { item_id: 10, qty: 2 }], "Loot: ");
    Test_Eq("r3rarity paths: a battle drop line marks an epic name", _en[0].text, "Loot: " + _n3 + " x1");
    Test_Eq("r3rarity paths: and a common one", _en[1].text, "Loot: " + _n10 + " x2");
    Test_Eq("r3rarity paths: the drop line carries the rarity for the gem", _en[0].icon_rarity, 3);
    Test_Eq("r3rarity paths: a common drop carries 1", _en[1].icon_rarity, 1);
    var _hero = Test_Hero(CLASS_KNIGHT);
    var _rw = { exp_gain: 1, levels_gained: 0, stat_points_gained: 0, gold: 0, loot: [{ item_id: 2, qty: 1 }] };
    var _lines = Battle_BuildVictoryDialogueLines(EnemyCreate(ENEMY_SLIME), _rw, _hero);
    var _found = false;
    for (var _i = 0; _i < array_length(_lines); _i++) if (is_struct(_lines[_i]) && string_pos(_n2, _lines[_i].text) > 0) _found = true;
    Test_True("r3rarity paths: the victory lines mark the drop", _found);
    // steal
    var _victim = Test_Hero(CLASS_KNIGHT);
    _victim.inventory = Inv_Add([], 2, 1);
    var _st = Skill_Use(EnemyCreate(ENEMY_STRANGER), _victim, SKILL_STEAL);
    Test_Eq("r3rarity paths: the steal line marks the name", _st.msg, "Stole " + _n2 + ".");
    // throw
    var _th = Throw_Resolve(30, Test_Hero(CLASS_KNIGHT), EnemyCreate(ENEMY_SLIME), QTE_OK);
    Test_True("r3rarity paths: the throw line marks the name", string_pos("You throw the " + _n30 + "!", _th.msg) == 1);
    // equip, unequip
    var _k = Test_Hero(CLASS_KNIGHT);
    _k.inventory = Inv_Add(_k.inventory, 2, 1);
    Test_Eq("r3rarity paths: the equip line marks the name", Equip_CanEquip(_k, 2).msg, "Equipped " + _n2 + ".");
    var _tg = Gear_Toggle(_k, 2);
    Test_True("r3rarity paths: (setup) the sword is worn", _tg.ok && _tg.equipped);
    var _off = Gear_Toggle(_tg.ch, 2);
    Test_Eq("r3rarity paths: the unequip line marks the name", _off.msg, "Unequipped " + _n2 + ".");
    // "Replaces {item}" in the gear details
    var _g = Test_Hero(CLASS_KNIGHT);
    _g.inventory = Inv_Add(_g.inventory, 1, 1);
    _g.inventory = Inv_Add(_g.inventory, 2, 1);
    Equip_Item(_g, 1);
    var _gi = TabGear_Items(_g);
    var _iron = Test_RowById(_gi, "item_id", 2);
    Test_True("r3rarity paths: the gear details say what a swap replaces, with a marked name", is_struct(_iron) && string_pos("Replaces [r1]" + string(ItemDB_Get(1).name) + "[/r1].", _iron.help) > 0);
    // the echo question
    Test_Eq("r3rarity paths: the echo question names an item in its colour", CardsUi_EchoName({ kind: "item", id: 2 }), _n2);
}

function Test_RarityShop() {
    var _gs = GameState_Get();
    var _hero = Test_Hero(CLASS_KNIGHT);
    var _had_run = variable_struct_exists(_gs, "run");
    var _old_run = _had_run ? _gs.run : undefined;
    var _old_shop = variable_global_exists("shop_ui") ? global.shop_ui : undefined;
    _gs.run = Run_Create(5160);
    _gs.run.gold = 500;
    global.shop_ui = { stk: Ui_StackNew(), shop_index: 0, msg: "", msg_ref: undefined, quote_kind: "", quote_idx: -1, msg_ms: -100000, lock: InputLock_New(0), opened_ms: current_time };
    var _n2 = "[r2]" + string(ItemDB_Get(2).name) + "[/r2]";
    // sell: a rare sword (gear asks first; the question names it in its colour)
    _hero.inventory = Inv_Add(_hero.inventory, 2, 1);
    var _m = Ui_MenuNew("test_r3rarity_sell", ShopUi_SellItems(), { on_confirm: ShopUi_SellConfirm });
    var _ig = -1;
    for (var _j = 0; _j < array_length(_m.items); _j++) if (_m.items[_j].item_id == 2) _ig = _j;
    Test_True("r3rarity shop: the sell list shows the sword", _ig >= 0);
    var _price = Shop_SellPrice(2);
    ShopUi_SellConfirm(_m, _ig);
    Test_Eq("r3rarity shop: the sell question marks the name", Confirm_Question(), "Sell " + _n2 + " for " + string(_price) + "?");
    Confirm_Back();
    ShopUi_SellConfirm(_m, _ig);
    Test_True("r3rarity shop: (setup) Yes sells the sword", Test_ConfirmSayYes());
    Test_Eq("r3rarity shop: the sold line marks the name", global.shop_ui.msg, "Sold " + _n2 + " for " + string(_price) + ".");
    // buy: the stock row of an item
    var _rows = Shop_RunStock(_gs.run, 0, _gs.player_ch);
    var _item_row = -1;
    for (var _r = 0; _r < array_length(_rows); _r++) if (_rows[_r].kind != "card" && _rows[_r].qty > 0 && _rows[_r].price <= _gs.run.gold) { _item_row = _r; break; }
    Test_True("r3rarity shop: the stock has an item to buy", _item_row >= 0);
    if (_item_row >= 0) {
        var _bid = _rows[_item_row].id;
        var _bm = Ui_MenuNew("test_r3rarity_buy", ShopUi_BuyItems(), { on_confirm: ShopUi_BuyConfirm });
        ShopUi_BuyConfirm(_bm, _item_row);
        Test_True("r3rarity shop: the bought line marks the name", string_pos("Bought " + Item_NameMarked(_bid) + " for ", global.shop_ui.msg) == 1);
    }
    global.shop_ui = _old_shop;
    if (_had_run) _gs.run = _old_run; else variable_struct_remove(_gs, "run");
}

function Test_RarityRows() {
    var _rare = ItemDB_Get(2);
    var _epic = ItemDB_Get(3);
    var _common = ItemDB_Get(1);
    Test_Eq("r3rarity rows: a rare row's name is gold", Ui_RowLabelColor({ label: "x", icon_item: _rare, enabled: true }, false), UI_C_MERCHANT_GOLD);
    Test_Eq("r3rarity rows: gold when selected too", Ui_RowLabelColor({ label: "x", icon_item: _rare, enabled: true }, true), UI_C_MERCHANT_GOLD);
    Test_Eq("r3rarity rows: a common row's name stays white", Ui_RowLabelColor({ label: "x", icon_item: _common, enabled: true }, false), UI_C_TEXT);
    global.rarity_clock = 300;
    Test_Eq("r3rarity rows: an epic row's name is the pulsing colour", Ui_RowLabelColor({ label: "x", icon_item: _epic, enabled: true }, false), Rarity_Color(3, 300));
    global.rarity_clock = -1;
    Test_Eq("r3rarity rows: a dim row stays light green even for a rare item", Ui_RowLabelColor({ label: "x", icon_item: _rare, enabled: true, dim: true }, false), UI_C_LIGHT);
    Test_Eq("r3rarity rows: a dim epic row too", Ui_RowLabelColor({ label: "x", icon_item: _epic, enabled: true, dim: true }, true), UI_C_LIGHT);
    Test_Eq("r3rarity rows: a disabled row stays dark", Ui_RowLabelColor({ label: "x", icon_item: _rare, enabled: false }, false), UI_C_DARK);
    Test_Eq("r3rarity rows: a row with no item is as before", Ui_RowLabelColor({ label: "Run", enabled: true }, false), UI_C_TEXT);
    Test_Eq("r3rarity rows: an empty slot (dim, no item) stays light green", Ui_RowLabelColor({ label: "No Armor", enabled: true, dim: true }, false), UI_C_LIGHT);
    Test_Eq("r3rarity rows: a header is as before", Ui_RowLabelColor({ label: "Bag", kind: "head", enabled: false }, false), UI_C_LIGHTEST);
    // the real lists
    var _k = Test_Hero(CLASS_KNIGHT);
    _k.inventory = Inv_Add(_k.inventory, 10, 1);
    _k.inventory = Inv_Add(_k.inventory, 14, 1);
    _k.inventory = Inv_Add(_k.inventory, 15, 1);
    var _it = TabItems_Items(_k);
    var _c1 = Ui_RowLabelColor(Test_RowById(_it, "item_id", 10), false);
    var _c2 = Ui_RowLabelColor(Test_RowById(_it, "item_id", 14), false);
    Test_True("r3rarity rows: the Items tab shows a common potion white and a rare one gold", _c1 == UI_C_TEXT && _c2 == UI_C_MERCHANT_GOLD);
    _k.inventory = Inv_Add(_k.inventory, 8, 1);   // a staff the Knight cannot wear: a rare item in a dim row
    var _gi = TabGear_Items(_k);
    var _staff = Test_RowById(_gi, "item_id", 8);
    Test_True("r3rarity rows: (setup) the Ruby Staff is a dim row for the Knight", is_struct(_staff) && _staff.dim);
    Test_Eq("r3rarity rows: and its name stays light green in the Gear tab", Ui_RowLabelColor(_staff, false), UI_C_LIGHT);
    var _bi = Battle_ItemRows(_k);
    Test_True("r3rarity rows: the battle item rows carry the item for the colour", array_length(_bi) >= 1 && variable_struct_exists(_bi[0], "icon_item"));
}

function Test_RarityGem() {
    Test_Eq("r3rarity gem: a common icon has no gem", array_length(Rarity_GemRows(1, 0)), 0);
    var _rare0 = Rarity_GemRows(2, 0);
    Test_Eq("r3rarity gem: a rare gem is 3 rows", array_length(_rare0), 3);
    var _sq = (array_length(_rare0) == 3) && string_length(_rare0[0]) == 3 && string_length(_rare0[1]) == 3 && string_length(_rare0[2]) == 3;
    Test_True("r3rarity gem: 3 wide and 3 tall", _sq);
    if (_sq) {
        Test_Eq("r3rarity gem: a rare gem is a gold diamond: the centre and the four middles", string_char_at(_rare0[1], 2) + string_char_at(_rare0[0], 2) + string_char_at(_rare0[2], 2) + string_char_at(_rare0[1], 1) + string_char_at(_rare0[1], 3), "ggggg");
        Test_True("r3rarity gem: the corners of a rare gem are not gold", string_char_at(_rare0[0], 1) != "g" && string_char_at(_rare0[0], 3) != "g" && string_char_at(_rare0[2], 1) != "g" && string_char_at(_rare0[2], 3) != "g");
    }
    Test_Eq("r3rarity gem: a rare gem does not sparkle", json_stringify(Rarity_GemRows(2, 1)), json_stringify(_rare0));
    Test_True("r3rarity gem: an epic gem has two different frames", json_stringify(Rarity_GemRows(3, 0)) != json_stringify(Rarity_GemRows(3, 1)));
    Test_Eq("r3rarity gem: an epic gem is also 3 tall", array_length(Rarity_GemRows(3, 1)), 3);
    Test_True("r3rarity gem: the frame flips every 300 ms", Rarity_GemFrame(0) == 0 && Rarity_GemFrame(299) == 0 && Rarity_GemFrame(300) == 1 && Rarity_GemFrame(600) == 0);
    Test_Eq("r3rarity gem: the gold of the gem", Rarity_GemColor("g"), UI_C_MERCHANT_GOLD);
}

// No workbook string writes an item tag (the game marks every item name it fills in) and none uses the gold accent round an item.
function Test_RarityWorkbook() {
    Loc_Init();
    var _keys = variable_struct_get_names(Loc_GetData().strings);
    var _bad = "";
    var _acc = "";
    for (var _k = 0; _k < array_length(_keys); _k++) {
        var _e = variable_struct_get(Loc_GetData().strings, _keys[_k]);
        if (!is_struct(_e)) continue;
        var _langs = ["en", "ko"];
        for (var _l = 0; _l < 2; _l++) {
            var _t = variable_struct_exists(_e, _langs[_l]) ? string(variable_struct_get(_e, _langs[_l])) : "";
            if (string_pos("[r1]", _t) > 0 || string_pos("[r2]", _t) > 0 || string_pos("[r3]", _t) > 0) _bad += _keys[_k] + "/" + _langs[_l] + " ";
            if (string_pos("[a]{item}[/a]", _t) > 0 || string_pos("[a]{name}[/a]", _t) > 0) _acc += _keys[_k] + "/" + _langs[_l] + " ";
        }
    }
    Test_True("r3rarity workbook: the workbook has strings to check", array_length(_keys) > 500);
    Test_Eq("r3rarity workbook: no string writes an item tag", _bad, "");
    Test_Eq("r3rarity workbook: no string puts the gold accent round an item", _acc, "");
}

// ============================================================================================================
// Packet mouse (D182, R-111, owner notes 12 and 13): a pixel-art cursor drawn in the GUI layer (the OS cursor stays hidden, so there was none to see), full mouse support
// (QTE bars, slider click / drag, the seed entry, notices, dialogue), right click = Back. Expected values come from the packet brief and D182, not from the code.
//   cursor: a move or a click shows it for 3 s; a key or pad press hides it until the mouse moves again; an unfocused window shows the OS cursor and draws none of ours.
//   art: an arrow 8 x 10 art pixels, a 1-px darkest outline round a lightest fill, scaled by the UI pixel; a pressed variant (1 px offset, a dimmer fill).
// ============================================================================================================
function Test_Suite_R3Mouse() {
    var _need = ["Mouse_Fake", "Mouse_FakeSet", "Mouse_FakeClear", "Mouse_FakeClick", "Mouse_FakeHold", "Mouse_FakeWheel", "Mouse_WinX", "Mouse_WinY", "Mouse_Pressed", "Mouse_Held", "Mouse_WheelDir",
        "MouseCursor_New", "MouseCursor_Step", "MouseCursor_Visible", "MouseCursor_OsHidden", "MouseCursor_Poke", "MouseCursor_Mask", "MouseCursor_Boxes", "Input_ClickConfirm", "Input_ClickBack",
        "Battle_ConfirmInput", "Slider_ValueAt", "Settings_SetValue", "Title_SeedHit", "Title_SeedApply"];
    var _missing = "";
    for (var _i = 0; _i < array_length(_need); _i++) if (!script_exists(asset_get_index(_need[_i]))) _missing += ((_missing != "") ? "," : "") + _need[_i];
    Test_Eq("r3mouse: every function of the mouse packet exists", _missing, "");
    if (_missing != "") return;
    Test_RunSuite("R3Mouse.cursor", Test_R3MouseCursor);
    Test_RunSuite("R3Mouse.art", Test_R3MouseArt);
    Test_RunSuite("R3Mouse.wrap", Test_R3MouseWrap);
    Test_RunSuite("R3Mouse.slider", Test_R3MouseSlider);
    Test_RunSuite("R3Mouse.seed", Test_R3MouseSeed);
    Test_RunSuite("R3Mouse.screens", Test_R3MouseScreens);
}

function Test_R3MouseCursor() {
    var _st = MouseCursor_New();
    Test_False("r3mouse cursor: nothing is drawn before the mouse is used", MouseCursor_Visible(_st, 0, true));
    MouseCursor_Step(_st, true, false, false, false, 1000);
    Test_True("r3mouse cursor: a move shows it", MouseCursor_Visible(_st, 1000, true));
    Test_True("r3mouse cursor: it is still there 2.9 s after the last move", MouseCursor_Visible(_st, 3900, true));
    Test_False("r3mouse cursor: it is gone 3.1 s after the last move", MouseCursor_Visible(_st, 4100, true));
    MouseCursor_Step(_st, false, true, false, false, 5000);
    Test_True("r3mouse cursor: a click without a move shows it", MouseCursor_Visible(_st, 5000, true));
    Test_True("r3mouse cursor: a click starts the 3 s again", MouseCursor_Visible(_st, 7900, true));
    Test_False("r3mouse cursor: and 3.1 s after the click it is gone", MouseCursor_Visible(_st, 8100, true));
    MouseCursor_Step(_st, true, false, false, false, 9000);
    MouseCursor_Step(_st, false, false, true, false, 9500);
    Test_False("r3mouse cursor: a key press hides it at once, 0.5 s after the move", MouseCursor_Visible(_st, 9500, true));
    MouseCursor_Step(_st, false, false, false, false, 9700);
    Test_False("r3mouse cursor: a quiet frame does not bring it back", MouseCursor_Visible(_st, 9700, true));
    MouseCursor_Step(_st, true, false, false, false, 10000);
    Test_True("r3mouse cursor: the mouse moving again does", MouseCursor_Visible(_st, 10000, true));
    MouseCursor_Step(_st, false, false, false, true, 10400);
    Test_False("r3mouse cursor: a pad press hides it as well", MouseCursor_Visible(_st, 10400, true));
    MouseCursor_Step(_st, true, false, false, false, 11000);
    Test_False("r3mouse cursor: an unfocused window draws no cursor of ours", MouseCursor_Visible(_st, 11000, false));
    Test_True("r3mouse cursor: the OS cursor stays hidden while the window has focus (no double cursor)", MouseCursor_OsHidden(true));
    Test_False("r3mouse cursor: the OS cursor shows normally when the window has no focus", MouseCursor_OsHidden(false));
    var _p = MouseCursor_New();
    MouseCursor_Poke(_p, 20000);
    Test_True("r3mouse cursor: a poke (the scripted runs) shows it for the 3 s", MouseCursor_Visible(_p, 22000, true) && !MouseCursor_Visible(_p, 23500, true));
}

function Test_R3MouseArt() {
    var _mask = MouseCursor_Mask();
    Test_Eq("r3mouse art: the arrow is 10 art pixels tall", array_length(_mask), 10);
    var _w_ok = true;
    var _chars_ok = true;
    var _fill = 0;
    var _out = 0;
    for (var _r = 0; _r < array_length(_mask); _r++) {
        if (string_length(_mask[_r]) != 8) _w_ok = false;
        for (var _c = 1; _c <= string_length(_mask[_r]); _c++) {
            var _ch = string_char_at(_mask[_r], _c);
            if (_ch == "F") _fill++;
            else if (_ch == "X") _out++;
            else if (_ch != ".") _chars_ok = false;
        }
    }
    Test_True("r3mouse art: every row is 8 art pixels wide", _w_ok);
    Test_True("r3mouse art: the pixels are outline (X), fill (F) or empty (.)", _chars_ok);
    Test_Eq("r3mouse art: the tip (the hot spot) is the top left pixel and is outline", string_char_at(_mask[0], 1), "X");
    Test_True("r3mouse art: there is a fill and an outline", _fill >= 10 && _out >= 14);
    var _closed = true;   // a fill pixel never touches the empty space or the edge of the grid: the outline is 1 px all round
    for (var _r2 = 0; _r2 < 10; _r2++) {
        for (var _c2 = 0; _c2 < 8; _c2++) {
            if (string_char_at(_mask[_r2], _c2 + 1) != "F") continue;
            var _nb = [[_c2 - 1, _r2], [_c2 + 1, _r2], [_c2, _r2 - 1], [_c2, _r2 + 1]];
            for (var _k = 0; _k < 4; _k++) {
                var _nx = _nb[_k][0];
                var _ny = _nb[_k][1];
                if (_nx < 0 || _nx > 7 || _ny < 0 || _ny > 9 || string_char_at(_mask[_ny], _nx + 1) == ".") _closed = false;
            }
        }
    }
    Test_True("r3mouse art: the outline closes the fill on every side", _closed);
    var _b = MouseCursor_Boxes(100, 50, 3, false);
    var _inside = true;
    var _area = 0;
    var _cols_ok = true;
    for (var _i = 0; _i < array_length(_b); _i++) {
        var _bx = _b[_i];
        if (_bx.x < 100 || _bx.y < 50 || _bx.x + _bx.w > 100 + 8 * 3 || _bx.y + _bx.h > 50 + 10 * 3) _inside = false;
        _area += _bx.w * _bx.h;
        if (_bx.col != UI_C_LIGHTEST && _bx.col != UI_C_DARKEST) _cols_ok = false;
    }
    Test_True("r3mouse art: the boxes stay inside 8 x 10 art pixels from the hot spot", _inside);
    Test_Eq("r3mouse art: the boxes cover exactly the art pixels (3 GUI units each)", _area, (_fill + _out) * 9);
    Test_True("r3mouse art: it is the palette's lightest fill with the darkest outline", _cols_ok);
    var _b1 = MouseCursor_Boxes(0, 0, 1, false);
    var _b4 = MouseCursor_Boxes(0, 0, 4, false);
    var _a1 = 0;
    var _a4 = 0;
    for (var _j = 0; _j < array_length(_b1); _j++) _a1 += _b1[_j].w * _b1[_j].h;
    for (var _j2 = 0; _j2 < array_length(_b4); _j2++) _a4 += _b4[_j2].w * _b4[_j2].h;
    Test_Eq("r3mouse art: it scales with the UI pixel (area x 16 at 4 times the size)", _a4, _a1 * 16);
    var _bp = MouseCursor_Boxes(100, 50, 3, true);
    var _minx = 99999;
    var _miny = 99999;
    var _fills_dim = true;
    for (var _k2 = 0; _k2 < array_length(_bp); _k2++) {
        _minx = min(_minx, _bp[_k2].x);
        _miny = min(_miny, _bp[_k2].y);
        if (_bp[_k2].col == UI_C_LIGHTEST) _fills_dim = false;
    }
    Test_True("r3mouse art: the pressed arrow is one art pixel down and to the right", _minx == 103 && _miny == 53, string(_minx) + "," + string(_miny));
    Test_True("r3mouse art: and its fill is not the lightest (it reads as pressed)", _fills_dim);
}

function Test_R3MouseWrap() {
    Mouse_FakeClear();
    Test_True("r3mouse wrap: with no fake the real mouse is read", is_undefined(Mouse_Fake()));
    Mouse_FakeSet(120, 80);
    Test_True("r3mouse wrap: a fake position is what the game sees (x, y)", Mouse_WinX() == 120 && Mouse_WinY() == 80);
    Test_False("r3mouse wrap: no button is down yet", Mouse_Pressed(mb_left) || Mouse_Pressed(mb_right) || Mouse_Held(mb_left));
    Mouse_FakeClick(mb_left);
    Test_True("r3mouse wrap: a fake click is a left press this frame", Mouse_Pressed(mb_left));
    Test_False("r3mouse wrap: and not a right one", Mouse_Pressed(mb_right));
    Test_True("r3mouse wrap: the left click is the confirm press", Input_ClickConfirm());
    Test_False("r3mouse wrap: and not the back press", Input_ClickBack());
    Test_True("r3mouse wrap: the battle's confirm (QTE bars) sees the click like the key", Battle_ConfirmInput());
    global.input.frame += 1;
    Test_False("r3mouse wrap: a click lasts one frame", Mouse_Pressed(mb_left));
    Test_False("r3mouse wrap: ... also for the battle's confirm", Battle_ConfirmInput());
    Mouse_FakeClick(mb_right);
    Test_True("r3mouse wrap: a right click is the back press", Input_ClickBack() && Mouse_Pressed(mb_right));
    Test_False("r3mouse wrap: and not the confirm press", Input_ClickConfirm());
    global.input.frame += 1;
    Mouse_FakeHold(mb_left, true);
    Test_True("r3mouse wrap: a held button is held", Mouse_Held(mb_left));
    Mouse_FakeHold(mb_left, false);
    Test_False("r3mouse wrap: and let go", Mouse_Held(mb_left));
    Mouse_FakeWheel(1);
    Test_Eq("r3mouse wrap: the wheel reads up as +1", Mouse_WheelDir(), 1);
    global.input.frame += 1;
    Test_Eq("r3mouse wrap: a wheel turn lasts one frame", Mouse_WheelDir(), 0);
    var _lay = Display_Layout();
    Mouse_FakeSet(_lay.gui_x + 50 * _lay.ui_scale, _lay.gui_y + 30 * _lay.ui_scale);
    Mouse_FakeClick(mb_left);
    Mouse_FakeHold(mb_left, true);
    var _sn = Ui_ReadInput();
    Test_True("r3mouse wrap: the menus' snapshot reads the click through it", _sn.click);
    Test_True("r3mouse wrap: ... the held button", _sn.held);
    Test_True("r3mouse wrap: ... and the position in GUI units", abs(_sn.mx - 50) < 0.01 && abs(_sn.my - 30) < 0.01, string(_sn.mx) + "," + string(_sn.my));
    var _mp = Ui_MousePos();
    Test_True("r3mouse wrap: Ui_MousePos agrees", abs(_mp.x - 50) < 0.01 && abs(_mp.y - 30) < 0.01);
    Mouse_FakeClear();
    global.ui_mouse = undefined;
    global.input.frame += 1;
    Test_False("r3mouse wrap: clearing the fake clears the click", Input_ClickConfirm());
}

function Test_R3MouseSlider() {
    Test_True("r3mouse slider: the left end of the bar is 0", abs(Slider_ValueAt(100, 100, 42, 0.05)) < 0.0001);
    Test_True("r3mouse slider: the right end of the bar is 1", abs(Slider_ValueAt(142, 100, 42, 0.05) - 1) < 0.0001);
    Test_True("r3mouse slider: the middle is 0.5", abs(Slider_ValueAt(121, 100, 42, 0.05) - 0.5) < 0.0001);
    Test_True("r3mouse slider: a value snaps to the 5 % step (26 % of the bar is 25 %)", abs(Slider_ValueAt(100 + 0.26 * 42, 100, 42, 0.05) - 0.25) < 0.0001);
    Test_True("r3mouse slider: left of the bar is 0 and right of it is 1 (a drag may leave it)", Slider_ValueAt(50, 100, 42, 0.05) == 0 && Slider_ValueAt(400, 100, 42, 0.05) == 1);
    var _p = GameSettings_Copy(GameSettings_Ensure());
    _p.audio_bgm = 0.5;
    Test_True("r3mouse slider: Settings_SetValue sets a volume and says it changed", Settings_SetValue(_p, "vol_bgm", 0.35));
    Test_True("r3mouse slider: ... to that value", abs(_p.audio_bgm - 0.35) < 0.0001);
    Test_False("r3mouse slider: the same value again changes nothing", Settings_SetValue(_p, "vol_bgm", 0.35));
    Settings_SetValue(_p, "vol_sfx", 7);
    Test_True("r3mouse slider: a value is clamped to 0..1", _p.audio_sfx == 1);
    Test_False("r3mouse slider: a row that is not a slider is refused", Settings_SetValue(_p, "shake", 1));
    var _m = Ui_MenuNew("r3mouse_slider", [
        { id: "a", label: "A", kind: "slider", enabled: true, amount: 0.5, value: "50%" },
        { id: "b", label: "B", kind: "choice", enabled: true, value: "On" }
    ], {});
    _m.rects = [{ x: 0, y: 0, w: 100, h: 10 }, { x: 0, y: 10, w: 100, h: 10 }];
    _m.bars = [{ x: 50, y: 0, w: 40, h: 10 }, { x: 0, y: 0, w: 0, h: 0 }];
    var _s = Ui_SnapNew();
    _s.mx = 60; _s.my = 5; _s.click = true; _s.held = true;
    var _ev = Ui_MenuStep(_m, _s, 90000);
    Test_True("r3mouse slider: a click on the bar sets that point", is_struct(_ev.slide) && _ev.slide.index == 0 && abs(_ev.slide.value - 0.25) < 0.0001);
    _s = Ui_SnapNew();
    _s.mx = 80; _s.my = 5; _s.held = true; _s.mouse_moved = true;
    _ev = Ui_MenuStep(_m, _s, 90016);
    Test_True("r3mouse slider: dragging with the button down follows the mouse", is_struct(_ev.slide) && abs(_ev.slide.value - 0.75) < 0.0001);
    _s = Ui_SnapNew();
    _s.mx = 300; _s.my = 90; _s.held = true; _s.mouse_moved = true;
    _ev = Ui_MenuStep(_m, _s, 90032);
    Test_True("r3mouse slider: ... also once the mouse has left the bar (to the end)", is_struct(_ev.slide) && _ev.slide.value == 1);
    _s = Ui_SnapNew();
    _s.mx = 300; _s.my = 90;
    _ev = Ui_MenuStep(_m, _s, 90048);
    Test_False("r3mouse slider: letting go ends the drag", is_struct(_ev.slide));
    _s = Ui_SnapNew();
    _s.mx = 20; _s.my = 15; _s.click = true; _s.held = true;
    _ev = Ui_MenuStep(_m, _s, 90064);
    Test_False("r3mouse slider: a click on another row does not slide", is_struct(_ev.slide));
    _s = Ui_SnapNew();
    _s.mx = 80; _s.my = 5; _s.held = true; _s.mouse_moved = true;
    _ev = Ui_MenuStep(_m, _s, 90080);
    Test_False("r3mouse slider: a button held down from elsewhere does not start a drag", is_struct(_ev.slide));
}

function Test_R3MouseSeed() {
    var _r = { panel: { x: 0, y: 0, w: 200, h: 100 }, cells: [], up: { x: 30, y: 30, w: 18, h: 8 }, down: { x: 30, y: 56, w: 18, h: 8 }, start: { x: 10, y: 80, w: 180, h: 10 } };
    for (var _i = 0; _i < 9; _i++) array_push(_r.cells, { x: 10 + _i * 20, y: 40, w: 18, h: 14 });
    var _e = { digits: [1, 2, 3], cur: 1 };   // the cursor can reach slots 0..3 (the blank slot after the digits)
    Test_Eq("r3mouse seed: a click on a digit cell is that cell", Title_SeedHit(_r, _e, 15, 45).kind, "cell");
    Test_Eq("r3mouse seed: ... and says which", Title_SeedHit(_r, _e, 15, 45).idx, 0);
    Test_Eq("r3mouse seed: the blank slot after the digits can be clicked", Title_SeedHit(_r, _e, 10 + 3 * 20 + 2, 45).idx, 3);
    Test_Eq("r3mouse seed: a cell the cursor cannot reach is not a hit", Title_SeedHit(_r, _e, 10 + 5 * 20 + 2, 45).kind, "");
    Test_Eq("r3mouse seed: the arrow above the cursor's cell raises the digit", Title_SeedHit(_r, _e, 35, 33).kind, "up");
    Test_Eq("r3mouse seed: the arrow below lowers it", Title_SeedHit(_r, _e, 35, 60).kind, "down");
    Test_Eq("r3mouse seed: the Start line starts", Title_SeedHit(_r, _e, 100, 85).kind, "start");
    Test_Eq("r3mouse seed: empty space is nothing", Title_SeedHit(_r, _e, 190, 5).kind, "");
    Test_True("r3mouse seed: a cell click moves the cursor", Title_SeedApply(_e, { kind: "cell", idx: 3 }) && _e.cur == 3);
    Test_True("r3mouse seed: the up arrow cycles the digit up (blank slot: 1)", Title_SeedApply(_e, { kind: "up", idx: -1 }) && array_length(_e.digits) == 4 && _e.digits[3] == 1);
    Test_True("r3mouse seed: the down arrow cycles it down (1 -> 0)", Title_SeedApply(_e, { kind: "down", idx: -1 }) && _e.digits[3] == 0);
    Test_False("r3mouse seed: a click on nothing changes nothing", Title_SeedApply(_e, { kind: "", idx: -1 }));
}

// One menu: a click on each enabled row confirms that row and a disabled row never; right click is Back; a click outside the rows does nothing.
function Test_R3MouseMenuRows(_name, _m) {
    var _n = array_length(_m.items);
    var _rects = [];
    for (var _i = 0; _i < _n; _i++) array_push(_rects, { x: 10, y: 10 + _i * 14, w: 100, h: 14 });
    _m.rects = _rects;
    var _en = Ui_ItemsEnabled(_m.items);
    var _bad = "";
    for (var _k = 0; _k < _n; _k++) {
        var _s = Ui_SnapNew();
        _s.mx = 20; _s.my = 10 + _k * 14 + 5; _s.click = true; _s.mouse_moved = true;
        var _ev = Ui_MenuStep(_m, _s, 50000 + _k * 100);
        if (_en[_k] && (!_ev.confirm || _ev.index != _k)) _bad += " row" + string(_k) + "-not-confirmed";
        if (!_en[_k] && _ev.confirm) _bad += " row" + string(_k) + "-disabled-confirmed";
    }
    Test_Eq("r3mouse screens: " + _name + ": a click on each enabled row confirms it, a disabled row never", _bad, "");
    var _sr = Ui_SnapNew();
    _sr.rclick = true;
    Test_True("r3mouse screens: " + _name + ": a right click is Back", Ui_MenuStep(_m, _sr, 60000).back);
    var _sc = Ui_SnapNew();
    _sc.mx = 500; _sc.my = 500; _sc.click = true;
    Test_False("r3mouse screens: " + _name + ": a click outside every row does nothing", Ui_MenuStep(_m, _sc, 60100).confirm);
}

function Test_R3MouseScreens() {
    var _p = GameSettings_Copy(GameSettings_Ensure());
    Test_R3MouseMenuRows("settings", Ui_MenuNew("r3m_settings", SettingsMenu_Items(_p, 5), {}));
    Test_R3MouseMenuRows("class choice", Ui_MenuNew("r3m_class", CardsUi_ClassMenu(Profile_Default()).items, {}));
    Test_R3MouseMenuRows("shop", ShopUi_RootMenu());
    Confirm_Open("Test?", undefined);
    var _cm = Confirm_Menu();
    Test_R3MouseMenuRows("yes / no", _cm);
    Confirm_Close();
    var _sy = Ui_MenuNew("r3m_wheel", [{ label: "A" }, { label: "B" }, { label: "C" }], {});
    _sy.cursor = 1;
    var _s = Ui_SnapNew();
    _s.wheel = -1;
    Ui_MenuStep(_sy, _s, 70000);
    Test_Eq("r3mouse screens: the wheel scrolls a list (down = next row)", _sy.cursor, 2);
}

// ==========================================================================================================================
// R3 levelup (D176, D177, D184; owner notes 14, 15, 16): VIG and MND stats, level gains on confirm, the level-up screen.
// Expected numbers come from tools/balance/vig_mnd.py (the table in E:\Temp\dd-briefs\out\vig-mnd-table.md), written before the GML.
// ==========================================================================================================================
function Test_Suite_R3LevelUp() {
    Test_LvCurves();
    Test_LvClassTable();
    Test_LvStatRules();
    Test_LvMigration();
    Test_LvDeferred();
    Test_LvScreen();
    Test_LvTextFit();
}

// A class at a level with its free point on the class's usual stat (auto-placed outside a run): VIG, MND, Max HP, Max MP.
function Test_LvAt(_name, _class, _level, _vig, _mnd, _hp, _mp) {
    var _c = CharacterCreate_Player(_class);
    for (var _i = 1; _i < _level; _i++) _c = LevelUp_ApplyLevel(_c);
    Test_Eq(_name + " level", _c.level, _level);
    Test_Eq(_name + " VIG", _c.stats.vig, _vig);
    Test_Eq(_name + " MND", _c.stats.mnd, _mnd);
    Test_Eq(_name + " max HP", _c.max_hp, _hp);
    Test_Eq(_name + " max MP", _c.max_mp, _mp);
}

// Every free point put on VIG (or MND) from level 2 to 10, the way a player in a run places it.
function Test_LvDump(_class, _stat) {
    var _c = CharacterCreate_Player(_class);
    global.levelup_auto_place = false;
    for (var _i = 2; _i <= 10; _i++) {
        _c = LevelUp_ApplyLevel(_c);
        _c = Cards_PlaceStat(_c, _stat);
    }
    global.levelup_auto_place = true;
    return _c;
}

function Test_LvCurves() {
    // Max HP from VIG: 3 per point above 10 up to VIG 28, then 2 up to VIG 38, then 1
    Test_Eq("levelup curve: VIG 10 is Max HP 10", Resource_MaxHpOfVig(10), 10);
    Test_Eq("levelup curve: VIG 12 is Max HP 16", Resource_MaxHpOfVig(12), 16);
    Test_Eq("levelup curve: VIG 28 is Max HP 64 (the last full point)", Resource_MaxHpOfVig(28), 64);
    Test_Eq("levelup curve: VIG 31 is Max HP 70 (soft cap: 2 a point)", Resource_MaxHpOfVig(31), 70);
    Test_Eq("levelup curve: VIG 38 is Max HP 84", Resource_MaxHpOfVig(38), 84);
    Test_Eq("levelup curve: VIG 39 is Max HP 85 (soft cap: 1 a point)", Resource_MaxHpOfVig(39), 85);
    Test_Eq("levelup curve: VIG 50 is Max HP 96", Resource_MaxHpOfVig(50), 96);
    Test_Eq("levelup curve: VIG below 10 is no less than 10", Resource_MaxHpOfVig(4), 10);
    // Max MP from MND: 1 per point above 10 up to MND 44, then 1/2 up to 56, then 1/4 (floored)
    Test_Eq("levelup curve: MND 11 is Max MP 11", Resource_MaxMpOfMnd(11), 11);
    Test_Eq("levelup curve: MND 16 is Max MP 16", Resource_MaxMpOfMnd(16), 16);
    Test_Eq("levelup curve: MND 44 is Max MP 44", Resource_MaxMpOfMnd(44), 44);
    Test_Eq("levelup curve: MND 45 is still Max MP 44 (half a point)", Resource_MaxMpOfMnd(45), 44);
    Test_Eq("levelup curve: MND 46 is Max MP 45", Resource_MaxMpOfMnd(46), 45);
    Test_Eq("levelup curve: MND 56 is Max MP 50", Resource_MaxMpOfMnd(56), 50);
    Test_Eq("levelup curve: MND 60 is Max MP 51 (a quarter a point)", Resource_MaxMpOfMnd(60), 51);
}

function Test_LvClassTable() {
    // class growth on reaching a level: VIG and MND next to ATK DEF SPD MAG
    var _g = LevelUp_ClassGrowthGain(CLASS_KNIGHT, 2);
    Test_True("levelup growth: Knight L2 is ATK+1 DEF+1 VIG+2 MND+1", _g.atk == 1 && _g.def == 1 && _g.spd == 0 && _g.mag == 0 && _g.vig == 2 && _g.mnd == 1);
    Test_Eq("levelup growth: Knight VIG L3", LevelUp_ClassGrowthGain(CLASS_KNIGHT, 3).vig, 2);
    Test_Eq("levelup growth: Knight VIG L4 is +3", LevelUp_ClassGrowthGain(CLASS_KNIGHT, 4).vig, 3);
    Test_Eq("levelup growth: Knight VIG L7 is +3", LevelUp_ClassGrowthGain(CLASS_KNIGHT, 7).vig, 3);
    Test_Eq("levelup growth: Knight VIG L10 is +3", LevelUp_ClassGrowthGain(CLASS_KNIGHT, 10).vig, 3);
    _g = LevelUp_ClassGrowthGain(CLASS_ARCHER, 6);
    Test_True("levelup growth: Archer is ATK+1 SPD+1 VIG+2 MND+2", _g.atk == 1 && _g.def == 0 && _g.spd == 1 && _g.mag == 0 && _g.vig == 2 && _g.mnd == 2);
    _g = LevelUp_ClassGrowthGain(CLASS_MAGE, 2);
    Test_True("levelup growth: Mage L2 is MAG+2 VIG+2 MND+3", _g.atk == 0 && _g.mag == 2 && _g.vig == 2 && _g.mnd == 3);
    Test_Eq("levelup growth: Mage VIG on an odd level is only +1", LevelUp_ClassGrowthGain(CLASS_MAGE, 3).vig, 1);
    Test_Eq("levelup growth: Mage VIG on level 10 is +2", LevelUp_ClassGrowthGain(CLASS_MAGE, 10).vig, 2);
    Test_Eq("levelup growth: Nobody VIG is +2", LevelUp_ClassGrowthGain(CLASS_NOBODY, 7).vig, 2);
    Test_Eq("levelup growth: Nobody MND L2 is +1", LevelUp_ClassGrowthGain(CLASS_NOBODY, 2).mnd, 1);
    Test_Eq("levelup growth: Nobody MND L5 is +2", LevelUp_ClassGrowthGain(CLASS_NOBODY, 5).mnd, 2);
    Test_Eq("levelup growth: Nobody MND L6 is +1", LevelUp_ClassGrowthGain(CLASS_NOBODY, 6).mnd, 1);
    Test_Eq("levelup growth: Nobody MND L9 is +2", LevelUp_ClassGrowthGain(CLASS_NOBODY, 9).mnd, 2);
    Test_Eq("levelup growth: a class with no growth has no VIG", LevelUp_ClassGrowthGain(99, 2).vig, 0);
    // the table: VIG, MND, Max HP, Max MP per class at levels 1, 2, 3, 5, 10 (the free point on the class's usual stat)
    Test_LvAt("levelup table knight 1", CLASS_KNIGHT, 1, 10, 11, 10, 11);
    Test_LvAt("levelup table knight 2", CLASS_KNIGHT, 2, 12, 12, 16, 12);
    Test_LvAt("levelup table knight 3", CLASS_KNIGHT, 3, 14, 13, 22, 13);
    Test_LvAt("levelup table knight 5", CLASS_KNIGHT, 5, 19, 15, 37, 15);
    Test_LvAt("levelup table knight 10", CLASS_KNIGHT, 10, 31, 20, 70, 20);
    Test_LvAt("levelup table archer 1", CLASS_ARCHER, 1, 10, 12, 10, 12);
    Test_LvAt("levelup table archer 2", CLASS_ARCHER, 2, 12, 14, 16, 14);
    Test_LvAt("levelup table archer 3", CLASS_ARCHER, 3, 14, 16, 22, 16);
    Test_LvAt("levelup table archer 5", CLASS_ARCHER, 5, 18, 20, 34, 20);
    Test_LvAt("levelup table archer 10", CLASS_ARCHER, 10, 28, 30, 64, 30);
    Test_LvAt("levelup table mage 1", CLASS_MAGE, 1, 10, 16, 10, 16);
    Test_LvAt("levelup table mage 2", CLASS_MAGE, 2, 12, 19, 16, 19);
    Test_LvAt("levelup table mage 3", CLASS_MAGE, 3, 13, 22, 19, 22);
    Test_LvAt("levelup table mage 5", CLASS_MAGE, 5, 16, 28, 28, 28);
    Test_LvAt("levelup table mage 10", CLASS_MAGE, 10, 24, 43, 52, 43);
    Test_LvAt("levelup table nobody 1", CLASS_NOBODY, 1, 10, 11, 10, 11);
    Test_LvAt("levelup table nobody 2", CLASS_NOBODY, 2, 12, 12, 16, 12);
    Test_LvAt("levelup table nobody 3", CLASS_NOBODY, 3, 14, 13, 22, 13);
    Test_LvAt("levelup table nobody 5", CLASS_NOBODY, 5, 18, 16, 34, 16);
    Test_LvAt("levelup table nobody 10", CLASS_NOBODY, 10, 28, 22, 64, 22);
    // D184: every class's Max HP and Max MP at every level stays within 10% of what the old silent growth gave (the free point on the class's usual stat);
    // the Mage is the most fragile
    var _classes = [CLASS_KNIGHT, CLASS_ARCHER, CLASS_MAGE, CLASS_NOBODY];
    var _off = "";
    var _frail = "";
    for (var _ci = 0; _ci < 4; _ci++) {
        var _c = CharacterCreate_Player(_classes[_ci]);
        for (var _l = 1; _l <= 10; _l++) {
            if (_l > 1) _c = LevelUp_ApplyLevel(_c);
            var _old_hp = Resource_MaxHp(_c.class_cfg.hd, _l);
            var _old_mp = Resource_MaxMp(_c.class_cfg.mp_gain, _l, _c.stats.mag);
            if (abs(_c.max_hp / _old_hp - 1) > 0.10) _off += " " + string(_classes[_ci]) + "/L" + string(_l) + "/hp";
            if (abs(_c.max_mp / _old_mp - 1) > 0.10) _off += " " + string(_classes[_ci]) + "/L" + string(_l) + "/mp";
            if (_l >= 2 && _classes[_ci] != CLASS_MAGE) {   // level 2 is a tie (16 each: 15 + 1 against 16 is as far as 10% allows), from level 3 the Mage has less
                var _mage = CharacterCreate_Player(CLASS_MAGE);
                for (var _m = 2; _m <= _l; _m++) _mage = LevelUp_ApplyLevel(_mage);
                if ((_l == 2) ? (_mage.max_hp > _c.max_hp) : (_mage.max_hp >= _c.max_hp)) _frail += " " + string(_classes[_ci]) + "/L" + string(_l);
            }
        }
    }
    Test_Eq("levelup D184: HP and MP stay within 10% of the old numbers at every level (off:" + _off + ")", _off, "");
    Test_Eq("levelup D184: the Mage has the least Max HP of every class at every level (tied at 2, less from 3; not less:" + _frail + ")", _frail, "");
    // D184: leveling VIG is not easy mode: all nine free points on VIG, against the class with its points elsewhere
    Test_Eq("levelup soft cap: a Knight with every free point on VIG has 86 Max HP at level 10 (not 70 + 27)", Test_LvDump(CLASS_KNIGHT, STAT_VIG).max_hp, 86);
    Test_Eq("levelup soft cap: an Archer's is 82", Test_LvDump(CLASS_ARCHER, STAT_VIG).max_hp, 82);
    Test_Eq("levelup soft cap: a Mage's is 74", Test_LvDump(CLASS_MAGE, STAT_VIG).max_hp, 74);
    Test_Eq("levelup soft cap: a Nobody's is 82", Test_LvDump(CLASS_NOBODY, STAT_VIG).max_hp, 82);
    Test_Eq("levelup soft cap: a Knight with every free point on MND has 29 Max MP", Test_LvDump(CLASS_KNIGHT, STAT_MND).max_mp, 29);
    Test_Eq("levelup soft cap: a Mage with every free point on MND has 48 Max MP", Test_LvDump(CLASS_MAGE, STAT_MND).max_mp, 48);
}

function Test_LvStatRules() {
    Test_Eq("levelup stats: STAT_VIG is 4", STAT_VIG, 4);
    Test_Eq("levelup stats: STAT_MND is 5", STAT_MND, 5);
    Test_Eq("levelup stats: VIG key", Stat_Key(STAT_VIG), "vig");
    Test_Eq("levelup stats: MND key", Stat_Key(STAT_MND), "mnd");
    Test_Eq("levelup stats: VIG name", Stat_ShortName(STAT_VIG), "VIG");
    Test_Eq("levelup stats: MND name", Stat_ShortName(STAT_MND), "MND");
    var _k = CharacterCreate_Player(CLASS_KNIGHT);
    Test_True("levelup stats: a new character has vig and mnd in its stats", variable_struct_exists(_k.stats, "vig") && variable_struct_exists(_k.stats, "mnd"));
    Test_Eq("levelup stats: Stat_Get reads VIG", Stat_Get(_k, STAT_VIG), 10);
    Test_Eq("levelup stats: Stat_Get reads MND", Stat_Get(_k, STAT_MND), 11);
    // D176: MAG no longer adds Max MP
    var _wiz = CharacterCreate_Player(CLASS_KNIGHT); _wiz.stats.mag = 41; _wiz = RecomputeResources(_wiz);
    Test_Eq("levelup stats: more MAG gives no Max MP", _wiz.max_mp, 11);
    // the free point on VIG / MND: +1 stat, the Max HP / Max MP it gives, and the current HP / MP rise with it
    var _p = CharacterCreate_Player(CLASS_KNIGHT);
    _p.stat_points = 2;
    _p.hp = 7;
    _p.mp = 5;
    var _p1 = Cards_PlaceStat(_p, STAT_VIG);
    Test_Eq("levelup point: VIG +1", _p1.stats.vig, 11);
    Test_Eq("levelup point: Max HP +3", _p1.max_hp, 13);
    Test_Eq("levelup point: HP rises by the same 3", _p1.hp, 10);
    Test_Eq("levelup point: it costs the point", _p1.stat_points, 1);
    var _p2 = Cards_PlaceStat(_p1, STAT_MND);
    Test_Eq("levelup point: MND +1", _p2.stats.mnd, 12);
    Test_Eq("levelup point: Max MP +1", _p2.max_mp, 12);
    Test_Eq("levelup point: MP rises by the same 1", _p2.mp, 6);
    var _p3 = Cards_PlaceStat(_p2, STAT_VIG);
    Test_Eq("levelup point: with no point left nothing changes", _p3.stats.vig, 11);
    var _bad = CharacterCreate_Player(CLASS_KNIGHT); _bad.stat_points = 1;
    _bad = Level_ApplyFreePoint(_bad, 17);
    Test_Eq("levelup point: an unknown stat keeps the point", _bad.stat_points, 1);
    // the prompt's rows: ATK DEF SPD MAG VIG MND, each value now > after
    var _o = Cards_FreePointOptions(CharacterCreate_Player(CLASS_MAGE));
    Test_Eq("levelup rows: six rows", array_length(_o), 6);
    Test_Eq("levelup rows: in the order ATK DEF SPD MAG VIG MND", _o[0].label + _o[1].label + _o[2].label + _o[3].label + _o[4].label + _o[5].label, "ATKDEFSPDMAGVIGMND");
    Test_True("levelup rows: the fifth is VIG, the sixth MND", _o[4].stat == STAT_VIG && _o[5].stat == STAT_MND);
    Test_True("levelup rows: a Mage's VIG goes 10 > 11, MND 16 > 17", _o[4].from == 10 && _o[4].to == 11 && _o[5].from == 16 && _o[5].to == 17);
    // the stat cap
    var _cap = CharacterCreate_Player(CLASS_KNIGHT); _cap.stats.vig = 60; _cap.stat_points = 1;
    _cap = Level_ApplyFreePoint(_cap, STAT_VIG);
    Test_Eq("levelup stats: VIG clamps at the stat maximum (60)", _cap.stats.vig, 60);
}

// What an old save held: no vig / mnd, the Max HP / Max MP bought with free points as hp_bonus (+3 a point) and mp_bonus (+2 a point).
function Test_LvLegacy(_class, _level, _hp_bonus, _mp_bonus) {
    var _s = DB_PlayerClass(_class).stats;
    return { class_id: _class, level: _level, exp: 0, hp: 5, mp: 3, stat_points: 0, hp_bonus: _hp_bonus, mp_bonus: _mp_bonus,
             stats: { atk: _s.atk, def: _s.def, spd: _s.spd, mag: _s.mag } };
}

function Test_LvMigration() {
    // each bonus point becomes a point of VIG / MND on top of the class's own growth to that level
    var _a = Player_MigrateVigMnd(Test_LvLegacy(CLASS_KNIGHT, 5, 6, 4));
    Test_Eq("levelup migrate: Knight L5 with hp_bonus 6 (2 points) has VIG 19 + 2", _a.stats.vig, 21);
    Test_Eq("levelup migrate: and mp_bonus 4 (2 points) has MND 15 + 2", _a.stats.mnd, 17);
    Test_False("levelup migrate: hp_bonus is gone", variable_struct_exists(_a, "hp_bonus"));
    Test_False("levelup migrate: mp_bonus is gone", variable_struct_exists(_a, "mp_bonus"));
    var _a2 = Player_MigrateVigMnd(_a);
    Test_True("levelup migrate: doing it twice changes nothing", _a2.stats.vig == 21 && _a2.stats.mnd == 17);
    var _m = Player_MigrateVigMnd(Test_LvLegacy(CLASS_MAGE, 1, 0, 0));
    Test_True("levelup migrate: a fresh Mage is VIG 10 MND 16", _m.stats.vig == 10 && _m.stats.mnd == 16);
    var _r = Player_MigrateVigMnd(Test_LvLegacy(CLASS_ARCHER, 3, 3, 2));
    Test_True("levelup migrate: Archer L3 with 1 + 1 points is VIG 14 + 1, MND 16 + 1", _r.stats.vig == 15 && _r.stats.mnd == 17);
    var _n = Player_MigrateVigMnd(Test_LvLegacy(CLASS_NOBODY, 10, 9, 6));
    Test_True("levelup migrate: Nobody L10 with 3 + 3 points is VIG 28 + 3, MND 22 + 3", _n.stats.vig == 31 && _n.stats.mnd == 25);
    var _f = Player_MigrateVigMnd(Test_LvLegacy(CLASS_KNIGHT, 2, 4, 3));
    Test_True("levelup migrate: a bonus that is not a whole number of points rounds down (4 > 1 point, 3 > 1 point)", _f.stats.vig == 13 && _f.stats.mnd == 13);
    var _bare = Player_MigrateVigMnd({ class_id: CLASS_KNIGHT, level: 3 });
    Test_False("levelup migrate: a struct with no stats is left alone", variable_struct_exists(_bare, "stats"));
    // loading normalises: the Max HP / Max MP come from the new stats, the current HP / MP are kept (up to the maxima)
    var _lo = Player_NormalizeProgression(Test_LvLegacy(CLASS_KNIGHT, 5, 6, 4), true);
    Test_Eq("levelup migrate: Knight L5 loads with Max HP 43 (VIG 21)", _lo.max_hp, 43);
    Test_Eq("levelup migrate: and Max MP 17 (MND 17)", _lo.max_mp, 17);
    Test_Eq("levelup migrate: the current HP is kept", _lo.hp, 5);
    Test_Eq("levelup migrate: the current MP is kept", _lo.mp, 3);
    // a run file written before (version 2 and 3) loads migrated to the current version with its player converted
    Test_Eq("levelup save: RUN_SAVE_VERSION is 4", RUN_SAVE_VERSION, 4);
    var _f3 = "test_levelup_v3_run.sav";
    var _f2 = "test_levelup_v2_run.sav";
    Save_DeleteFileSet(_f3);
    Save_DeleteFileSet(_f2);
    var _raw3 = { run_version: 3, seed: 9, floor: 2, gold: 5, kills: 1, rng: {}, summary: { class_id: CLASS_KNIGHT, level: 5, floor: 2, run_time_ms: 1000, seed: 9, saved_at: 3 },
                  statData: { selected_class: CLASS_KNIGHT, player: Test_LvLegacy(CLASS_KNIGHT, 5, 6, 4), save_room_name: "rm_floor2", saved_at: 3 } };
    var _raw2 = { run_version: 2, seed: 9, floor: 2, gold: 5, kills: 1, rng: {}, statData: { selected_class: CLASS_ARCHER, player: Test_LvLegacy(CLASS_ARCHER, 3, 3, 2), save_room_name: "rm_floor2", saved_at: 3 } };
    Test_RawWrite(_f3, json_stringify(_raw3));
    Test_RawWrite(_f2, json_stringify(_raw2));
    var _l3 = RunSave_LoadFrom(_f3);
    Test_Eq("levelup save: a version 3 file still loads", _l3.status, "ok");
    if (_l3.status == "ok") {
        Test_Eq("levelup save: and comes back as version 4", _l3.run.run_version, 4);
        var _pl = _l3.run.statData.player;
        Test_True("levelup save: its player has VIG 21 and MND 17", _pl.stats.vig == 21 && _pl.stats.mnd == 17);
        Test_False("levelup save: and no hp_bonus", variable_struct_exists(_pl, "hp_bonus"));
        Test_Eq("levelup save: the summary level is the saved level", _l3.run.summary.level, 5);
    }
    var _l2 = RunSave_LoadFrom(_f2);
    Test_Eq("levelup save: a version 2 file still loads", _l2.status, "ok");
    if (_l2.status == "ok") {
        Test_Eq("levelup save: and comes back as version 4 too", _l2.run.run_version, 4);
        Test_True("levelup save: its Archer has VIG 14 + 1 and MND 16 + 1", _l2.run.statData.player.stats.vig == 15 && _l2.run.statData.player.stats.mnd == 17);
    }
    Save_DeleteFileSet(_f3);
    Save_DeleteFileSet(_f2);
    Test_Eq("levelup save: a file one version ahead is newer", RunSave_Check({ run_version: 5, seed: 1, statData: {} }), "newer");
    Test_Eq("levelup save: a version 4 file is ok", RunSave_Check({ run_version: 4, seed: 1, statData: {} }), "ok");
    // a save written by this build carries the new stats and loads back the same
    var _gs = GameState_Get();
    var _had_run = variable_struct_exists(_gs, "run");
    var _old_run = _had_run ? _gs.run : undefined;
    var _old_p = _gs.player_ch;
    var _old_cp = _gs.checkpoint;
    var _old_persist = _gs.persist;
    _gs.run = Run_Create(4321);
    _gs.checkpoint = { room: rm_floor3, x: 48, y: 64 };
    _gs.persist = {};
    var _pc = CharacterCreate_Player(CLASS_MAGE);
    _pc = LevelUp_ApplyLevel(_pc);
    _pc = LevelUp_ApplyLevel(_pc);
    _gs.player_ch = _pc;
    var _ff = "test_levelup_v4_run.sav";
    Save_DeleteFileSet(_ff);
    RunSave_WriteTo(_ff);
    var _l4 = RunSave_LoadFrom(_ff);
    Save_DeleteFileSet(_ff);
    if (_had_run) _gs.run = _old_run; else variable_struct_remove(_gs, "run");
    _gs.player_ch = _old_p;
    _gs.checkpoint = _old_cp;
    _gs.persist = _old_persist;
    Test_Eq("levelup save: a run written now is version 4", _l4.status == "ok" ? _l4.run.run_version : -1, 4);
    Test_True("levelup save: with the Mage's VIG 13 and MND 22 in it", _l4.status == "ok" && _l4.run.statData.player.stats.vig == 13 && _l4.run.statData.player.stats.mnd == 22);
}

// ---- note 14 (D177): winning a fight does not change level, stats or Max HP / Max MP; the owed levels apply, one at a time, when the player confirms the screen ----
function Test_LvRunBegin() {
    var _gs = GameState_Get();
    var _keep = { had: variable_struct_exists(_gs, "run"), run: variable_struct_exists(_gs, "run") ? _gs.run : undefined, player: _gs.player_ch };
    _gs.run = Run_Create(5);
    return _keep;
}

function Test_LvRunEnd(_keep) {
    var _gs = GameState_Get();
    if (_keep.had) _gs.run = _keep.run; else variable_struct_remove(_gs, "run");
    _gs.player_ch = _keep.player;
}

function Test_LvDeferred() {
    var _k = Test_LvRunBegin();
    Test_False("levelup owed: a run is going, so level-ups are not auto-placed", Level_AutoPlaceEnabled());
    // one level's EXP: nothing changes but the debt
    var _a = CharacterCreate_Player(CLASS_KNIGHT);
    var _a0 = { atk: _a.stats.atk, def: _a.stats.def, vig: _a.stats.vig, mnd: _a.stats.mnd, hp: _a.max_hp, mp: _a.max_mp };
    _a = Player_AddExp(_a, Exp_NextLevel(1));
    Test_Eq("levelup owed: the level stays 1 after the EXP is won", _a.level, 1);
    Test_Eq("levelup owed: one level is owed", _a.levels_owed, 1);
    Test_True("levelup owed: ATK, DEF, VIG and MND are what they were", _a.stats.atk == _a0.atk && _a.stats.def == _a0.def && _a.stats.vig == _a0.vig && _a.stats.mnd == _a0.mnd);
    Test_True("levelup owed: Max HP and Max MP are what they were", _a.max_hp == _a0.hp && _a.max_mp == _a0.mp);
    Test_Eq("levelup owed: no free point is banked yet", _a.stat_points, 0);
    Test_Eq("levelup owed: no card pick is owed yet", _a.card_picks, 0);
    Test_Eq("levelup owed: the fight reports one level gained", _a.last_levels_gained, 1);
    Test_Eq("levelup owed: and one stat point gained (R-113: it was never set above 0)", _a.last_stat_points_gained, 1);
    Test_Eq("levelup owed: the EXP bar is on level 2's bar with nothing carried over", _a.exp_next, Exp_NextLevel(2));
    Test_Eq("levelup owed: nothing carried over", _a.exp, 0);
    Test_Eq("levelup owed: the screen is owed first", Cards_NextOwed(_a), "stat");
    Test_Eq("levelup owed: and it is the screen for level 2", LevelUp_PromptLevel(_a), 2);
    // more than one level in one grant: one owed per level, the rest of the EXP kept
    var _b = Player_AddExp(CharacterCreate_Player(CLASS_KNIGHT), Exp_NextLevel(1) + Exp_NextLevel(2) + 5);
    Test_Eq("levelup owed: two levels owed from one fight", _b.levels_owed, 2);
    Test_Eq("levelup owed: still level 1", _b.level, 1);
    Test_Eq("levelup owed: the EXP left over is kept", _b.exp, 5);
    Test_Eq("levelup owed: on level 3's bar", _b.exp_next, Exp_NextLevel(3));
    Test_Eq("levelup owed: two points gained", _b.last_stat_points_gained, 2);
    // a second fight on top of an owed level adds to it
    var _c = Player_AddExp(variable_clone(_a), Exp_NextLevel(2));
    Test_Eq("levelup owed: a second fight before the screen adds a level (2 owed)", _c.levels_owed, 2);
    Test_Eq("levelup owed: and that fight reports 1 gained", _c.last_levels_gained, 1);
    // what the screen shows: the character as it will be, the real one untouched
    var _pv = LevelUp_PreviewCharacter(_a);
    Test_Eq("levelup owed: the preview is level 2", _pv.level, 2);
    Test_True("levelup owed: with the class growth in its stats (ATK +1, DEF +1, VIG +2, MND +1)", _pv.stats.atk == _a0.atk + 1 && _pv.stats.def == _a0.def + 1 && _pv.stats.vig == _a0.vig + 2 && _pv.stats.mnd == _a0.mnd + 1);
    Test_True("levelup owed: the character itself did not move", _a.level == 1 && _a.levels_owed == 1 && _a.stats.atk == _a0.atk && _a.max_hp == _a0.hp);
    // confirming: the level, the growth and the chosen point, together
    _a.hp = 7;
    var _d = Cards_PlaceStat(variable_clone(_a), STAT_DEF);
    Test_Eq("levelup confirm: now level 2", _d.level, 2);
    Test_Eq("levelup confirm: nothing is owed any more", _d.levels_owed, 0);
    Test_Eq("levelup confirm: ATK got the growth", _d.stats.atk, _a0.atk + 1);
    Test_Eq("levelup confirm: DEF got the growth and the point", _d.stats.def, _a0.def + 2);
    Test_Eq("levelup confirm: VIG got the growth", _d.stats.vig, _a0.vig + 2);
    Test_Eq("levelup confirm: Max HP follows VIG (16)", _d.max_hp, 16);
    Test_Eq("levelup confirm: the current HP rises with it (7 + 6)", _d.hp, 13);
    Test_Eq("levelup confirm: the point is spent", _d.stat_points, 0);
    Test_Eq("levelup confirm: a card pick is owed now", _d.card_picks, 1);
    Test_Eq("levelup confirm: the card screen is next", Cards_NextOwed(_d), "cards");
    // two owed: one screen each
    var _e = Cards_PlaceStat(variable_clone(_b), STAT_ATK);
    Test_True("levelup confirm: two owed, the first confirm gives level 2 and leaves one owed", _e.level == 2 && _e.levels_owed == 1);
    Test_Eq("levelup confirm: the next screen is for level 3", LevelUp_PromptLevel(_e), 3);
    Test_Eq("levelup confirm: and it is a stat screen again before any card pick", Cards_NextOwed(_e), "stat");
    var _f = Cards_PlaceStat(_e, STAT_SPD);
    Test_True("levelup confirm: the second confirm gives level 3 and clears the debt", _f.level == 3 && _f.levels_owed == 0);
    Test_Eq("levelup confirm: two card picks are owed by then", _f.card_picks, 2);
    Test_Eq("levelup confirm: the EXP carried over is still there", _f.exp, 5);
    // the cap: the debt never goes past level 10, the EXP bar has nothing to fill
    var _g = CharacterCreate_Player(CLASS_KNIGHT);
    _g.level = 9;
    _g = Player_NormalizeProgression(_g, true);
    _g = Player_AddExp(_g, 5000);
    Test_True("levelup owed: level 9 with a huge grant owes only the one level to the cap", _g.level == 9 && _g.levels_owed == 1);
    Test_Eq("levelup owed: the bar is empty at the cap", _g.exp_next, 0);
    var _g2 = Player_AddExp(_g, 100);
    Test_True("levelup owed: at the owed cap more EXP changes nothing", _g2.levels_owed == 1 && _g2.last_levels_gained == 0);
    // saving and loading keep the debt and the EXP (the normalisation a load runs must not clamp it away)
    var _h = Player_NormalizeProgression(variable_clone(_b), true);
    Test_True("levelup owed: a load keeps the owed levels and the EXP", _h.levels_owed == 2 && _h.exp == 5 && _h.level == 1);
    // the run summary counts the owed levels (a death before the screen keeps today's numbers)
    Test_Eq("levelup owed: the effective level is the level plus the debt", Player_EffLevel(_b), 3);
    var _hist = Run_MakeHistoryEntry(Run_Get(), _b, "rm_floor2", "died", "Slime");
    Test_Eq("levelup owed: a death before the screen counts the owed levels in the history", _hist.level, 3);
    var _raw = { seed: 1, floor: 2, statData: { player: { class_id: CLASS_KNIGHT, level: 4, levels_owed: 1 }, save_room_name: "rm_floor2" } };
    Test_Eq("levelup owed: an abandoned save counts them too", Run_HistoryEntryFromSave(_raw).level, 5);
    var _gs = GameState_Get();
    var _cp0 = _gs.checkpoint;
    var _ps0 = _gs.persist;
    _gs.checkpoint = { room: rm_floor3, x: 48, y: 64 };
    _gs.persist = {};
    _gs.player_ch = _b;
    var _sv = RunSave_Build();
    _gs.checkpoint = _cp0;
    _gs.persist = _ps0;
    Test_Eq("levelup owed: the save's summary level counts them", _sv.summary.level, 3);
    Test_Eq("levelup owed: and the player in the save still has the debt", _sv.statData.player.levels_owed, 2);
    // the status card: the bar is full and says so, nothing else changes
    var _bar = TabMenu_XpBar(_a);
    Test_True("levelup owed: the EXP bar is full", _bar.ratio == 1);
    Test_Eq("levelup owed: and says Level Up", _bar.text, Loc_T("tab.val.level_up", "Level Up"));
    var _bar2 = TabMenu_XpBar(Test_LvAfterExp(CLASS_KNIGHT, 5));
    Test_True("levelup owed: with no debt the bar is EXP over the bar", abs(_bar2.ratio - 5 / Exp_NextLevel(1)) < 0.0001 && _bar2.text == "5/" + string(Exp_NextLevel(1)));
    // winning a battle: Battle_GrantRewards leaves the player as he was, with the debt
    EnemyDB_Init(); SkillDB_Init(); Loot_Init();
    var _p = CharacterCreate_Player(CLASS_KNIGHT);
    _p.exp = _p.exp_next - 1;
    var _rw = Battle_GrantRewards(variable_clone(_p), EnemyCreate(ENEMY_SLIME));
    Test_Eq("levelup battle: the rewards say one level was gained", _rw.levels_gained, 1);
    Test_Eq("levelup battle: and one stat point", _rw.stat_points_gained, 1);
    Test_True("levelup battle: the player coming out is still level 1 with the same Max HP / Max MP and stats", _rw.player.level == 1 && _rw.player.max_hp == _p.max_hp && _rw.player.max_mp == _p.max_mp && _rw.player.stats.atk == _p.stats.atk && _rw.player.stats.vig == _p.stats.vig);
    Test_Eq("levelup battle: with the level owed", _rw.player.levels_owed, 1);
    // a class chosen with a level owed keeps the debt
    var _cc = Card_ClassCharacter(variable_clone(_b), CLASS_MAGE);
    Test_True("levelup class: choosing a class keeps the owed levels and the level", _cc.levels_owed == 2 && _cc.level == 1);
    Test_Eq("levelup class: and the EXP", _cc.exp, 5);
    Test_LvRunEnd(_k);
    // outside a run (tests, tools) EXP still levels at once, and the points are still auto-placed
    var _o = Player_AddExp(CharacterCreate_Player(CLASS_KNIGHT), Exp_NextLevel(1) + Exp_NextLevel(2));
    Test_True("levelup owed: outside a run EXP levels the character at once (level 3, nothing owed)", _o.level == 3 && _o.levels_owed == 0);
    Test_Eq("levelup owed: and reports 2 stat points gained (R-113)", _o.last_stat_points_gained, 2);
}

// A fresh character of a class with _exp EXP won (outside a run: nothing levels).
function Test_LvAfterExp(_class, _exp) {
    var _c = CharacterCreate_Player(_class);
    return Player_AddExp(_c, _exp);
}

// ---- D177 (owner note 15): the level-up screen. Six rows ATK DEF SPD MAG VIG MND; the class's growth rows in gold with "now > now+growth", the other rows only the number;
// the row under the cursor (keyboard or mouse) shows its "> +1" (a growth row "now > now+growth+1"). Details: what the stat does, Now / After (VIG: Max HP, MND: Max MP). ----
function Test_LvRowValues(_m) {
    var _out = "";
    for (var _i = 0; _i < array_length(_m.items); _i++) _out += (_i > 0 ? "|" : "") + _m.items[_i].value;
    return _out;
}

function Test_LvGoldRows(_m) {
    var _out = "";
    for (var _i = 0; _i < array_length(_m.items); _i++) {
        var _it = _m.items[_i];
        if (variable_struct_exists(_it, "col") && _it.col == UI_C_MERCHANT_GOLD) _out += (_out != "" ? "," : "") + _it.label;
    }
    return _out;
}

function Test_LvScreen() {
    var _lang0 = Loc_GetLanguage();
    Loc_SetLanguage("en");
    var _k = Test_LvRunBegin();
    var _gs = GameState_Get();
    // the value rule, on its own
    Test_Eq("levelup screen: a growth row shows now > now + growth", Cards_StatRowValue(12, 1, false), "12 > 13");
    Test_Eq("levelup screen: a hovered growth row shows now > now + growth + 1", Cards_StatRowValue(12, 1, true), "12 > 14");
    Test_Eq("levelup screen: a row that does not grow shows only the number", Cards_StatRowValue(10, 0, false), "10");
    Test_Eq("levelup screen: hovered, it shows now > now + 1", Cards_StatRowValue(10, 0, true), "10 > 11");
    Test_Eq("levelup screen: a growth of 3 reads 10 > 13", Cards_StatRowValue(10, 3, false), "10 > 13");
    Test_Eq("levelup screen: a value at the cap does not pass 60", Cards_StatRowValue(60, 0, true), "60 > 60");
    // a Knight with a level owed: ATK +1, DEF +1, VIG +2, MND +1 are the growth rows
    var _kn = Player_AddExp(CharacterCreate_Player(CLASS_KNIGHT), Exp_NextLevel(1));
    _gs.player_ch = _kn;
    var _m = CardsUi_StatMenu();
    Test_Eq("levelup screen: six rows", array_length(_m.items), 6);
    Test_Eq("levelup screen: ATK DEF SPD MAG VIG MND in that order", _m.items[0].label + _m.items[1].label + _m.items[2].label + _m.items[3].label + _m.items[4].label + _m.items[5].label, "ATKDEFSPDMAGVIGMND");
    Test_Eq("levelup screen: the Knight's growth rows are gold", Test_LvGoldRows(_m), "ATK,DEF,VIG,MND");
    Test_Eq("levelup screen: the cursor starts on the class stat (DEF)", _m.cursor, STAT_DEF);
    Test_Eq("levelup screen: so DEF reads 12 > 14, the other growth rows now > now + growth, the rest only the number", Test_LvRowValues(_m), "11 > 12|12 > 14|9|3|10 > 12|11 > 12");
    _m.cursor = STAT_SPD;
    CardsUi_StatRefresh(_m);
    Test_Eq("levelup screen: with the cursor on SPD it reads 9 > 10 and DEF goes back to 12 > 13", Test_LvRowValues(_m), "11 > 12|12 > 13|9 > 10|3|10 > 12|11 > 12");
    _m.cursor = STAT_VIG;
    CardsUi_StatRefresh(_m);
    Test_Eq("levelup screen: on VIG it reads 10 > 13 (growth 2 + the point)", _m.items[4].value, "10 > 13");
    Test_Eq("levelup screen: the gold rows stay gold under the cursor", Test_LvGoldRows(_m), "ATK,DEF,VIG,MND");
    // a row's own colour is the text colour of that row, selected or not; a greyed row stays grey
    Test_Eq("levelup screen: a gold row draws gold", Ui_RowStyle(_m.items[0], false).text, UI_C_MERCHANT_GOLD);
    Test_Eq("levelup screen: and gold when selected", Ui_RowStyle(_m.items[0], true).text, UI_C_MERCHANT_GOLD);
    Test_Eq("levelup screen: a plain row is white", Ui_RowStyle(_m.items[2], false).text, UI_C_TEXT);
    Test_Eq("levelup screen: a greyed row stays grey whatever its colour", Ui_RowStyle({ label: "x", value: "", enabled: false, col: UI_C_MERCHANT_GOLD }, false).text, UI_C_DARK);
    // the details: what it does, Now and After
    Test_True("levelup screen: every row has a one-line explanation", string_length(_m.items[0].help) > 0 && string_length(_m.items[4].help) > 0 && string_length(_m.items[5].help) > 0);
    Test_Eq("levelup screen: the DEF row's Now / After are the stat now and after growth + the point", Test_RowValue(_m.items[1].lines, "Now") + ">" + Test_RowValue(_m.items[1].lines, "After"), "12>14");
    Test_Eq("levelup screen: the VIG row shows Max HP now and after (VIG 13 = 19)", Test_RowValue(_m.items[4].lines, Loc_T("cards.stat.hp_now", "Max HP Now")) + ">" + Test_RowValue(_m.items[4].lines, Loc_T("cards.stat.hp_after", "Max HP After")), "10>19");
    Test_Eq("levelup screen: the MND row shows Max MP now and after (MND 13 = 13)", Test_RowValue(_m.items[5].lines, Loc_T("cards.stat.mp_now", "Max MP Now")) + ">" + Test_RowValue(_m.items[5].lines, Loc_T("cards.stat.mp_after", "Max MP After")), "11>13");
    Test_Eq("levelup screen: the Korean-or-English legend replaces the 'Knight growth' line", _m.layout.note, Loc_T("levelup.legend", "Gold = your class grows these"));
    Test_True("levelup screen: the legend is not the old growth line", string_pos("growth:", _m.layout.note) == 0);
    Test_Eq("levelup screen: the legend is drawn in gold", _m.layout.note_col, UI_C_MERCHANT_GOLD);
    Test_Eq("levelup screen: the title names the level being confirmed", _m.layout.title, "Level 2: Place 1 Point");
    Test_Eq("levelup screen: the character itself has not moved", _kn.level + _kn.levels_owed * 10, 11);
    // a Mage: MAG, VIG and MND grow; ATK DEF SPD do not
    var _mg = Player_AddExp(CharacterCreate_Player(CLASS_MAGE), Exp_NextLevel(1));
    _gs.player_ch = _mg;
    var _mm = CardsUi_StatMenu();
    Test_Eq("levelup screen: the Mage's growth rows are MAG, VIG, MND", Test_LvGoldRows(_mm), "MAG,VIG,MND");
    Test_Eq("levelup screen: the cursor starts on MAG (12 > 15 hovered), VIG 10 > 12, MND 16 > 19", Test_LvRowValues(_mm), "5|7|10|12 > 15|10 > 12|16 > 19");
    // Nobody rotates: level 2's growth is ATK +1, SPD +1 (plus VIG +2, MND +1)
    var _nb = Player_AddExp(CharacterCreate_Player(CLASS_NOBODY), Exp_NextLevel(1));
    _gs.player_ch = _nb;
    var _nm = CardsUi_StatMenu();
    Test_Eq("levelup screen: Nobody's growth rows follow the rotation (level 2: ATK, SPD, VIG, MND)", Test_LvGoldRows(_nm), "ATK,SPD,VIG,MND");
    // two levels owed: the second screen is level 3's, with level 3's growth
    var _two = Player_AddExp(CharacterCreate_Player(CLASS_NOBODY), Exp_NextLevel(1) + Exp_NextLevel(2));
    _two = Cards_PlaceStat(_two, STAT_ATK);
    _gs.player_ch = _two;
    var _m3 = CardsUi_StatMenu();
    Test_Eq("levelup screen: the second owed level's screen is titled level 3", _m3.layout.title, "Level 3: Place 1 Point");
    Test_Eq("levelup screen: with level 3's growth rows (DEF, MAG, VIG, MND)", Test_LvGoldRows(_m3), "DEF,MAG,VIG,MND");
    // a point banked by an older save and no level owed: no growth, no gold, no legend
    var _old = CharacterCreate_Player(CLASS_KNIGHT);
    _old.stat_points = 1;
    _gs.player_ch = _old;
    var _om = CardsUi_StatMenu();
    Test_Eq("levelup screen: a banked point alone has no gold rows", Test_LvGoldRows(_om), "");
    Test_Eq("levelup screen: and no legend", _om.layout.note, "");
    Test_Eq("levelup screen: every row reads only the number, the one under the cursor (DEF) now > now + 1", Test_LvRowValues(_om), "11|12 > 13|9|3|10|11");
    Loc_SetLanguage("ko");
    var _ko = CardsUi_StatMenu();
    Test_True("levelup screen: the Korean legend is not the English one", _ko.layout.note != "Gold = your class grows these");
    Loc_SetLanguage(_lang0);
    // keyboard: Down moves the cursor one row and the +1 moves with it
    var _kb = Player_AddExp(CharacterCreate_Player(CLASS_KNIGHT), Exp_NextLevel(1));
    _gs.player_ch = _kb;
    var _km = CardsUi_StatMenu();
    var _sn = Ui_SnapNew();
    _sn.down = true;
    _sn.down_p = true;
    var _ev = Ui_MenuStep(_km, _sn, 5000);
    CardsUi_StatRefresh(_km);
    Test_True("levelup screen: Down moves the cursor from DEF to SPD", _ev.moved && _km.cursor == STAT_SPD);
    Test_Eq("levelup screen: and the +1 moves with it (SPD 9 > 10, DEF back to 12 > 13)", _km.items[2].value + "|" + _km.items[1].value, "9 > 10|12 > 13");
    // mouse: the row under the pointer is the cursor, a click confirms it
    var _mm2 = CardsUi_StatMenu();
    var _rects = [];
    for (var _ri = 0; _ri < 6; _ri++) array_push(_rects, { x: 0, y: _ri * 10, w: 100, h: 10 });
    _mm2.rects = _rects;
    var _ms2 = Ui_SnapNew();
    _ms2.mx = 5;
    _ms2.my = 35;
    _ms2.mouse_moved = true;
    var _ev2 = Ui_MenuStep(_mm2, _ms2, 5000);
    CardsUi_StatRefresh(_mm2);
    Test_True("levelup screen: the pointer over the MAG row moves the cursor there", _ev2.moved && _mm2.cursor == STAT_MAG);
    Test_Eq("levelup screen: MAG shows 3 > 4 under the pointer", _mm2.items[3].value, "3 > 4");
    Test_Eq("levelup screen: DEF is back to 12 > 13", _mm2.items[1].value, "12 > 13");
    _ms2.click = true;
    var _ev3 = Ui_MenuStep(_mm2, _ms2, 5000);
    Test_True("levelup screen: a click on the row confirms it", _ev3.confirm && _ev3.index == STAT_MAG);
    Test_LvRunEnd(_k);
}

// D177: every size and language the screen is drawn in: the rows, the title, the legend and the explanations fit (every cursor position: the value under the cursor is the longest).
function Test_LvFitFails(_class) {
    var _gs = GameState_Get();
    _gs.player_ch = Player_AddExp(CharacterCreate_Player(_class), 12);
    var _mt = Ui_Metrics();
    var _m = CardsUi_StatMenu();
    var _fails = [];
    var _mc = undefined;
    for (var _cur = 0; _cur < array_length(_m.items); _cur++) {
        _m.cursor = _cur;
        CardsUi_StatRefresh(_m);
        _mc = Ui_MenuMeasure(_m, _mt);
        for (var _i = 0; _i < array_length(_m.items); _i++) TextFit_Row(_fails, "levelup row", _m.items[_i].label, _m.items[_i].value, _mc.panel_w, _mt.p, _mc.icon_px, false, _mt);
    }
    TextFit_Title(_fails, "levelup title", _m.layout.title, _mc.panel_w - 8 * _mt.p, _mt);
    if (_m.layout.note != "") TextFit_Line(_fails, "levelup legend", _m.layout.note, _mc.panel_w - 8 * _mt.p);
    for (var _h = 0; _h < array_length(_m.items); _h++) TextFit_Block(_fails, "levelup help " + _m.items[_h].label, _m.items[_h].help, _mc.panel_w - 8 * _mt.p, _mt.p);
    return _fails;
}

function Test_LvTextFit() {
    var _k = Test_LvRunBegin();
    TextFit_Each("levelup screen (Knight)", function(_w, _h, _l) { return Test_LvFitFails(CLASS_KNIGHT); });
    TextFit_Each("levelup screen (Mage)", function(_w, _h, _l) { return Test_LvFitFails(CLASS_MAGE); });
    Test_LvRunEnd(_k);
}

// ============================================================================================================================
// Round 3 packet ideas1 (D173, D185): IDEA-07 weak points and IDEA-25 the death-screen tip (R-114, R-115).
// Expected values are the brief's: every enemy takes one of Poison / Bleeding / Burning better (+1 turn for Burning, +1 stack for Poison and Bleeding, never past the D78 caps
// of 10 and 3 stacks, and a Burning of 4 turns) and resists another (its chance is halved, rounded down to a whole percent, a sure 100% becomes 50%). The brief's examples:
// the Killer Plant burns longer, the Snake shrugs off Poison, the Ghost Sword does not bleed. The messages are "<Enemy> is weak to <Status>!" and "<Enemy> resists <Status>.".
// The Codex shows "Weak: ?" until the profile has seen the weakness. The death tip: the killer status first (poison, bleed, burn), then the enemy move (a boss's big move says
// how to beat it), then a generic pool that never shows the same tip twice running.
// ============================================================================================================================
function Test_Suite_R3Ideas1() {
    if (!script_exists(asset_get_index("WeakPoint_Table"))) {
        Test_True("r3ideas1: WeakPoint_Table exists: not implemented", false);
        return;
    }
    var _lang = Loc_GetLanguage();
    Loc_SetLanguage("en");
    Test_RunSuite("R3Ideas1.table", Test_R3IdTable);
    Test_RunSuite("R3Ideas1.math", Test_R3IdMath);
    Test_RunSuite("R3Ideas1.skills", Test_R3IdSkills);
    Test_RunSuite("R3Ideas1.throws", Test_R3IdThrows);
    Test_RunSuite("R3Ideas1.codex", Test_R3IdCodex);
    Test_RunSuite("R3Ideas1.tippure", Test_R3IdTipPure);
    Test_ProfRun("tpi_", Test_R3IdTipRun);
    Test_RunSuite("R3Ideas1.tipfit", Test_R3IdTipFit);
    Test_RunSuite("R3Ideas1.codexfit", Test_R3IdCodexFit);
    Test_RunSuite("R3Ideas1.workbook", Test_R3IdWorkbook);
    Loc_SetLanguage(_lang);
}

function Test_R3IdTable() {
    var _ids = Codex_EnemyIds();
    var _bad = "";
    var _weak_n = [0, 0, 0];
    var _res_n = [0, 0, 0];
    for (var _i = 0; _i < array_length(_ids); _i++) {
        var _c = EnemyDB_Get(_ids[_i]);
        if (!variable_struct_exists(_c, "weak") || !variable_struct_exists(_c, "resist")) { _bad += _c.name + ":missing "; continue; }
        var _w = _c.weak;
        var _r = _c.resist;
        if (_w < STATUS_POISON || _w > STATUS_BURN) _bad += _c.name + ":weak " + string(_w) + " ";
        else _weak_n[_w]++;
        if (_c.is_boss) {
            if (_r != -1 && (_r < STATUS_POISON || _r > STATUS_BURN)) _bad += _c.name + ":resist " + string(_r) + " ";
        } else {
            if (_r < STATUS_POISON || _r > STATUS_BURN) _bad += _c.name + ":resist " + string(_r) + " ";
        }
        if (_r >= 0 && _r == _w) _bad += _c.name + ":same ";
        if (_r >= STATUS_POISON && _r <= STATUS_BURN) _res_n[_r]++;
    }
    Test_Eq("r3ideas1 table: every enemy has a weak and a resist field in Poison / Bleeding / Burning, never both the same", _bad, "");
    Test_True("r3ideas1 table: each of the three statuses is the weakness of some enemy", _weak_n[0] > 0 && _weak_n[1] > 0 && _weak_n[2] > 0);
    Test_True("r3ideas1 table: each of the three statuses is the resistance of some enemy", _res_n[0] > 0 && _res_n[1] > 0 && _res_n[2] > 0);
    Test_Eq("r3ideas1 table: the Killer Plant burns longer (weak to Burning)", EnemyDB_Get(ENEMY_KILLER_PLANT).weak, STATUS_BURN);
    Test_Eq("r3ideas1 table: the Snake shrugs off Poison", EnemyDB_Get(ENEMY_SNAKE).resist, STATUS_POISON);
    Test_Eq("r3ideas1 table: the Ghost Sword does not bleed", EnemyDB_Get(ENEMY_GHOSTSWORD).resist, STATUS_BLEED);
    Test_Eq("r3ideas1 table: both bosses have a weakness", (EnemyDB_Get(ENEMY_MINI_BOSS).weak >= 0) + (EnemyDB_Get(ENEMY_FINAL_BOSS).weak >= 0), 2);
    var _t = WeakPoint_Table();
    Test_Eq("r3ideas1 table: a weak enemy takes +1 Burning turn", _t.turn_bonus, 1);
    Test_Eq("r3ideas1 table: a weak enemy takes +1 stack", _t.stack_bonus, 1);
    Test_Eq("r3ideas1 table: a resisted status lands with half the chance", _t.resist_mult, 0.5);
    Test_Eq("r3ideas1 table: Burning never lasts past 4 turns by a weakness", _t.burn_turn_cap, 4);
    Test_Eq("r3ideas1 table: a battle enemy reads its weakness from the database", Enemy_WeakStatus(EnemyCreate(ENEMY_KILLER_PLANT)), STATUS_BURN);
    Test_Eq("r3ideas1 table: and its resistance", Enemy_ResistStatus(EnemyCreate(ENEMY_SNAKE)), STATUS_POISON);
    Test_Eq("r3ideas1 table: the player has no weakness", Enemy_WeakStatus(CharacterCreate_Player(CLASS_KNIGHT)), -1);
    Test_Eq("r3ideas1 table: a bare struct has none", Enemy_ResistStatus({ hp: 1 }), -1);
}

function Test_R3IdMath() {
    var _hero = Test_Hero(CLASS_MAGE);
    var _plant = EnemyCreate(ENEMY_KILLER_PLANT);   // weak to Burning, resists Bleeding
    var _snake = EnemyCreate(ENEMY_SNAKE);          // weak to Bleeding, resists Poison
    var _whisp = EnemyCreate(ENEMY_MADWHISP);       // weak to Poison, resists Burning
    var _slime = EnemyCreate(ENEMY_SLIME);          // weak to Burning, resists Bleeding
    // turns: Burning 2 turns base
    Test_Eq("r3ideas1 math: Burning on a Killer Plant lasts 3 turns, not 2", Skill_StatusApplyArgs(_hero, _plant, STATUS_BURN, 2).turns, 3);
    Test_Eq("r3ideas1 math: Burning on a Snake (not weak) lasts 2 turns", Skill_StatusApplyArgs(_hero, _snake, STATUS_BURN, 2).turns, 2);
    Test_Eq("r3ideas1 math: a weak target is flagged", Skill_StatusApplyArgs(_hero, _plant, STATUS_BURN, 2).weak, true);
    Test_Eq("r3ideas1 math: a neutral target is not", Skill_StatusApplyArgs(_hero, _snake, STATUS_BURN, 2).weak, false);
    Test_Eq("r3ideas1 math: Burning turns reach the cap of 4 (3 -> 4)", Skill_StatusApplyArgs(_hero, _plant, STATUS_BURN, 3).turns, 4);
    Test_Eq("r3ideas1 math: and never go past it (4 stays 4)", Skill_StatusApplyArgs(_hero, _plant, STATUS_BURN, 4).turns, 4);
    Test_Eq("r3ideas1 math: (5 stays 5: the weakness never takes turns away)", Skill_StatusApplyArgs(_hero, _plant, STATUS_BURN, 5).turns, 5);
    // stacks: Poison cap 10, Bleeding cap 3 (D78)
    Test_Eq("r3ideas1 math: Poison on a Mad Whisp adds a stack (2 -> 3)", Skill_StatusApplyArgs(_hero, _whisp, STATUS_POISON, 1, 2).stacks, 3);
    Test_Eq("r3ideas1 math: Poison on a Slime (not weak) is 2", Skill_StatusApplyArgs(_hero, _slime, STATUS_POISON, 1, 2).stacks, 2);
    var _w7 = Status_Add(EnemyCreate(ENEMY_MADWHISP), STATUS_POISON, 1, 1, 7);
    Test_Eq("r3ideas1 math: 7 stacks + 2 + the weakness's 1 reaches the cap of 10", Skill_StatusApplyArgs(_hero, _w7, STATUS_POISON, 1, 2).stacks, 3);
    var _w8 = Status_Add(EnemyCreate(ENEMY_MADWHISP), STATUS_POISON, 1, 1, 8);
    Test_Eq("r3ideas1 math: at 8 stacks the 2 reach the cap and the weakness adds nothing", Skill_StatusApplyArgs(_hero, _w8, STATUS_POISON, 1, 2).stacks, 2);
    Test_Eq("r3ideas1 math: ... and it is not flagged when it added nothing", Skill_StatusApplyArgs(_hero, _w8, STATUS_POISON, 1, 2).weak, false);
    var _bl = Skill_StatusApplyArgs(_hero, _snake, STATUS_BLEED, 3, 1);
    Test_Eq("r3ideas1 math: Bleeding on a Snake adds a stack (1 -> 2), the turns stay 3", _bl.stacks * 10 + _bl.turns, 23);
    var _b2 = Status_Add(EnemyCreate(ENEMY_SNAKE), STATUS_BLEED, 3, 0, 2);
    Test_Eq("r3ideas1 math: Bleeding at 2 stacks: 2 + 1 + 1 would pass the cap of 3, so just 1", Skill_StatusApplyArgs(_hero, _b2, STATUS_BLEED, 3, 1).stacks, 1);
    var _b1 = Status_Add(EnemyCreate(ENEMY_SNAKE), STATUS_BLEED, 3, 0, 1);
    Test_Eq("r3ideas1 math: Bleeding at 1 stack: 1 + 1 + 1 reaches the cap of 3", Skill_StatusApplyArgs(_hero, _b1, STATUS_BLEED, 3, 1).stacks, 2);
    // the player never has a weak point
    var _pl = Test_Hero(CLASS_KNIGHT);
    Test_Eq("r3ideas1 math: a status on the player is never boosted", Skill_StatusApplyArgs(_hero, _pl, STATUS_BURN, 2).turns, 2);
    // resistance: halved, rounded down to a whole percent
    Test_Eq("r3ideas1 math: 75% on a resisting Snake is 37%", WeakPoint_ResistChance(_snake, STATUS_POISON, 0.75), 0.37);
    Test_Eq("r3ideas1 math: 100% becomes 50%", WeakPoint_ResistChance(_snake, STATUS_POISON, 1), 0.5);
    Test_Eq("r3ideas1 math: 70% becomes 35%", WeakPoint_ResistChance(_snake, STATUS_POISON, 0.7), 0.35);
    Test_Eq("r3ideas1 math: 65% becomes 32% (rounded down)", WeakPoint_ResistChance(_snake, STATUS_POISON, 0.65), 0.32);
    Test_Eq("r3ideas1 math: 60% becomes 30%", WeakPoint_ResistChance(_snake, STATUS_POISON, 0.6), 0.3);
    Test_Eq("r3ideas1 math: a status the enemy does not resist keeps its chance", WeakPoint_ResistChance(_snake, STATUS_BURN, 0.75), 0.75);
    Test_Eq("r3ideas1 math: a status on the player keeps its chance", WeakPoint_ResistChance(_pl, STATUS_POISON, 0.75), 0.75);
    Test_Eq("r3ideas1 math: a chance of 0 stays 0", WeakPoint_ResistChance(_snake, STATUS_POISON, 0), 0);
}

// Skill_Use: the log says so, the chance is halved, the Burning is longer.
function Test_R3IdSkills() {
    var _archer = CharacterCreate_Player(CLASS_ARCHER);
    var _landed = 0;
    var _resist_msg = 0;
    var _silent_fail = 0;
    var _exact = "";
    for (var _i = 0; _i < 100; _i++) {
        var _snake = EnemyCreate(ENEMY_SNAKE);
        _archer.mp = 99;
        var _r = Skill_Use(_archer, _snake, SKILL_POISON_ARROW);
        if (Status_Has(_snake, STATUS_POISON)) {
            _landed++;
            if (string_pos("resists", _r.msg) > 0) _resist_msg++;
        } else {
            if (string_pos("resists", _r.msg) > 0) { _resist_msg++; _exact = _r.msg; } else _silent_fail++;
        }
    }
    Test_True("r3ideas1 skills: Poison Arrow (75%) on a Snake lands about 37 times in 100 (" + string(_landed) + ")", _landed >= 25 && _landed <= 50);
    Test_Eq("r3ideas1 skills: every try that failed says the Snake resists", _silent_fail, 0);
    Test_Eq("r3ideas1 skills: and a landed try never does", _resist_msg, 100 - _landed);
    Test_Eq("r3ideas1 skills: the resist message", _exact, "Snake resists [t]Poison[/t].");
    // a neutral enemy: the full chance, no message
    var _land2 = 0;
    var _msg2 = 0;
    for (var _j = 0; _j < 100; _j++) {
        var _slime = EnemyCreate(ENEMY_SLIME);
        _archer.mp = 99;
        var _r2 = Skill_Use(_archer, _slime, SKILL_POISON_ARROW);
        if (Status_Has(_slime, STATUS_POISON)) _land2++;
        if (string_pos("resists", _r2.msg) > 0 || string_pos("weak to", _r2.msg) > 0) _msg2++;
    }
    Test_True("r3ideas1 skills: Poison Arrow on a Slime keeps its 75% (" + string(_land2) + " in 100)", _land2 >= 60 && _land2 <= 90);
    Test_Eq("r3ideas1 skills: a neutral enemy gets no weak / resist message", _msg2, 0);
    // a weakness: longer Burning, the message once per fight, the flag every time
    var _mage = CharacterCreate_Player(CLASS_MAGE);
    var _fb_chance = SkillDB_Get(SKILL_FIREBALL).status_chance;
    SkillDB_Get(SKILL_FIREBALL).status_chance = 1;
    var _plant = EnemyCreate(ENEMY_KILLER_PLANT);
    _mage.mp = 99;
    var _w1 = Skill_Use(_mage, _plant, SKILL_FIREBALL);
    _mage.mp = 99;
    var _w2 = Skill_Use(_mage, _plant, SKILL_FIREBALL);
    var _snake2 = EnemyCreate(ENEMY_SNAKE);
    _mage.mp = 99;
    var _w3 = Skill_Use(_mage, _snake2, SKILL_FIREBALL);
    SkillDB_Get(SKILL_FIREBALL).status_chance = _fb_chance;
    Test_Eq("r3ideas1 skills: Fireball's Burning lasts 3 turns on a Killer Plant", Battle_StatusCurrentTurns(_plant, STATUS_BURN), 3);
    Test_Eq("r3ideas1 skills: and 2 on a Snake", Battle_StatusCurrentTurns(_snake2, STATUS_BURN), 2);
    Test_True("r3ideas1 skills: the first Burning on the plant says it is weak to Burning", string_pos("Killer Plant is weak to [t]Burn[/t]!", _w1.msg) > 0);
    Test_False("r3ideas1 skills: the second one does not say it again", string_pos("weak to", _w2.msg) > 0);
    Test_Eq("r3ideas1 skills: the result still names the weakness (the Codex learns it)", _w1.weak_status * 100 + _w2.weak_status, STATUS_BURN * 100 + STATUS_BURN);
    Test_Eq("r3ideas1 skills: a neutral target's result names none", _w3.weak_status, -1);
    Test_Eq("r3ideas1 skills: and no resistance was met", _w1.resist_status, -1);
}

function Test_R3IdThrows() {
    var _hero = Test_Hero(CLASS_KNIGHT);
    var _plant = EnemyCreate(ENEMY_KILLER_PLANT);
    var _snake = EnemyCreate(ENEMY_SNAKE);
    var _r1 = Throw_Resolve(30, _hero, _plant, QTE_OK);
    var _r2 = Throw_Resolve(30, _hero, _snake, QTE_OK);
    Test_Eq("r3ideas1 throws: a Firebomb burns a Killer Plant for 3 turns", Battle_StatusCurrentTurns(_plant, STATUS_BURN), 3);
    Test_Eq("r3ideas1 throws: and a Snake for 2", Battle_StatusCurrentTurns(_snake, STATUS_BURN), 2);
    Test_True("r3ideas1 throws: the throw says the plant is weak to Burning", string_pos("Killer Plant is weak to [t]Burn[/t]!", _r1.msg) > 0);
    Test_Eq("r3ideas1 throws: the result names the weakness", _r1.weak_status, STATUS_BURN);
    Test_Eq("r3ideas1 throws: a neutral throw names none", _r2.weak_status, -1);
    // Poison Pot (4 stacks at OK): +1 on a weak Mad Whisp
    var _whisp = EnemyCreate(ENEMY_MADWHISP);
    Throw_Resolve(31, Test_Hero(CLASS_KNIGHT), _whisp, QTE_OK);
    Test_Eq("r3ideas1 throws: a Poison Pot puts 5 stacks on a Mad Whisp (weak to Poison)", Status_Stacks(_whisp, STATUS_POISON), 5);
    var _slime = EnemyCreate(ENEMY_SLIME);
    Throw_Resolve(31, Test_Hero(CLASS_KNIGHT), _slime, QTE_OK);
    Test_Eq("r3ideas1 throws: and 4 on a Slime", Status_Stacks(_slime, STATUS_POISON), 4);
    // a resisting Snake: half the pots do nothing
    var _thrower = Test_Hero(CLASS_KNIGHT);
    var _landed = 0;
    var _say = 0;
    for (var _i = 0; _i < 40; _i++) {
        var _sn = EnemyCreate(ENEMY_SNAKE);
        var _rr = Throw_Resolve(31, _thrower, _sn, QTE_OK);
        if (Status_Has(_sn, STATUS_POISON)) _landed++;
        else if (_rr.resist_status == STATUS_POISON && string_pos("Snake resists [t]Poison[/t].", _rr.msg) > 0) _say++;
    }
    Test_True("r3ideas1 throws: a Poison Pot (a sure 100%) lands about half the time on a Snake (" + string(_landed) + " in 40)", _landed >= 12 && _landed <= 28);
    Test_Eq("r3ideas1 throws: each pot that did nothing says why", _say, 40 - _landed);
}

function Test_R3IdCodex() {
    var _p = Profile_Default();
    Codex_Met(_p, ENEMY_SNAKE, false);
    Codex_Met(_p, ENEMY_MINI_BOSS, false);
    var _ids = Codex_EnemyIds();
    var _si = 0;
    var _bi = 0;
    for (var _i = 0; _i < array_length(_ids); _i++) { if (_ids[_i] == ENEMY_SNAKE) _si = _i; if (_ids[_i] == ENEMY_MINI_BOSS) _bi = _i; }
    var _lw = Loc_T("tab.lbl.weak", "Weak");
    var _lr = Loc_T("tab.lbl.resists", "Resists");
    var _rows = Codex_BestiaryRows(_p);
    Test_Eq("r3ideas1 codex: an unseen weakness shows ?", Test_RowValue(_rows[_si].lines, _lw), "?");
    Test_Eq("r3ideas1 codex: an unseen resistance shows ?", Test_RowValue(_rows[_si].lines, _lr), "?");
    Test_True("r3ideas1 codex: the rows are labelled Weak and Resists", _lw == "Weak" && _lr == "Resists");
    Test_True("r3ideas1 codex: a Snake not met yet is still ???", Codex_BestiaryRows(Profile_Default())[_si].label == "???");
    Test_True("r3ideas1 codex: the first sighting of a weakness is new", Codex_NoteWeakPoint(_p, ENEMY_SNAKE, "weak"));
    Test_False("r3ideas1 codex: the second is not", Codex_NoteWeakPoint(_p, ENEMY_SNAKE, "weak"));
    _rows = Codex_BestiaryRows(_p);
    Test_Eq("r3ideas1 codex: a seen weakness names the status", Test_RowValue(_rows[_si].lines, _lw), StatusDB_Get(STATUS_BLEED).name);
    Test_Eq("r3ideas1 codex: the resistance is still ?", Test_RowValue(_rows[_si].lines, _lr), "?");
    Test_True("r3ideas1 codex: a seen resistance is new", Codex_NoteWeakPoint(_p, ENEMY_SNAKE, "resist"));
    _rows = Codex_BestiaryRows(_p);
    Test_Eq("r3ideas1 codex: a seen resistance names the status", Test_RowValue(_rows[_si].lines, _lr), StatusDB_Get(STATUS_POISON).name);
    Test_Eq("r3ideas1 codex: a boss has a Weak row", Test_RowValue(_rows[_bi].lines, _lw), "?");
    var _boss_has_res = false;
    for (var _l = 0; _l < array_length(_rows[_bi].lines); _l++) if (_rows[_bi].lines[_l].label == _lr) _boss_has_res = true;
    Test_False("r3ideas1 codex: a boss without a resistance has no Resists row", _boss_has_res);
    Test_False("r3ideas1 codex: a weakness of an enemy not met yet is not kept", Codex_NoteWeakPoint(_p, ENEMY_SLIME, "weak"));
    var _pn = Profile_Normalize(json_parse(json_stringify(_p)));
    var _e = Codex_Entry(_pn, ENEMY_SNAKE);
    Test_True("r3ideas1 codex: both flags survive the profile file", is_struct(_e) && variable_struct_exists(_e, "weak_seen") && _e.weak_seen && variable_struct_exists(_e, "resist_seen") && _e.resist_seen);
    Test_Eq("r3ideas1 codex: and the met count", _e.met, 1);
    Test_Eq("r3ideas1 codex: a row read back from the file shows the status", Test_RowValue(Codex_BestiaryRows(_pn)[_si].lines, _lw), StatusDB_Get(STATUS_BLEED).name);
}

function Test_R3IdTipPure() {
    if (!script_exists(asset_get_index("DeathTip_Pick"))) { Test_True("r3ideas1 tip: DeathTip_Pick exists: not implemented", false); return; }
    var _p = DeathTip_Pick("status_poison", -1, "", 0);
    Test_Eq("r3ideas1 tip: a poison death gets the poison tip", _p.key, "death.tip.status_poison");
    Test_True("r3ideas1 tip: it names the Antidote", string_pos("Antidote", DeathTip_Text(_p)) > 0);
    Test_True("r3ideas1 tip: it says Poison killed you", string_pos("Poison", DeathTip_Text(_p)) == 1);
    var _b = DeathTip_Pick("status_bleed", -1, "", 0);
    Test_Eq("r3ideas1 tip: a bleed death", _b.key, "death.tip.status_bleed");
    Test_True("r3ideas1 tip: names the Bandage", string_pos("Bandage", DeathTip_Text(_b)) > 0);
    var _f = DeathTip_Pick("status_burn", -1, "", 0);
    Test_Eq("r3ideas1 tip: a burn death", _f.key, "death.tip.status_burn");
    Test_Eq("r3ideas1 tip: the killer status comes before the enemy move", DeathTip_Pick("status_poison", SKILL_PALE_HYMN, "", 3).key, "death.tip.status_poison");
    var _h = DeathTip_Pick("enemy_final_boss", SKILL_PALE_HYMN, "", 0);
    Test_Eq("r3ideas1 tip: Pale Hymn has its tip", _h.key, "death.tip.skill_pale_hymn");
    Test_True("r3ideas1 tip: it names the move and says BREAK it before it lands", string_pos("Pale Hymn", DeathTip_Text(_h)) > 0 && string_pos("BREAK", DeathTip_Text(_h)) > 0 && string_pos("before it lands", DeathTip_Text(_h)) > 0);
    var _ram = DeathTip_Pick("enemy_mini_boss", SKILL_RAMMING, "", 0);
    Test_Eq("r3ideas1 tip: Palehorn's Ramming has its tip", _ram.key, "death.tip.skill_ramming");
    Test_True("r3ideas1 tip: it says BREAK, Guard and the defence bar", string_pos("BREAK", DeathTip_Text(_ram)) > 0 && string_pos("Guard", DeathTip_Text(_ram)) > 0 && string_pos("defence bar", DeathTip_Text(_ram)) > 0);
    Test_Eq("r3ideas1 tip: an abandoned run has no tip", DeathTip_Pick("abandoned", -1, "", 0).key, "");
    // the generic pool
    var _pool = DeathTip_GenericPool();
    Test_True("r3ideas1 tip: the generic pool has at least 5 tips", array_length(_pool) >= 5);
    var _dup = false;
    for (var _i = 0; _i < array_length(_pool); _i++) for (var _j = _i + 1; _j < array_length(_pool); _j++) if (_pool[_i].key == _pool[_j].key) _dup = true;
    Test_False("r3ideas1 tip: no generic tip twice", _dup);
    var _again = false;
    var _seen = {};
    for (var _k = 0; _k < array_length(_pool); _k++) {
        for (var _s = 0; _s < 14; _s++) {
            var _g = DeathTip_Pick("enemy_slime", -1, _pool[_k].key, _s);
            if (_g.key == _pool[_k].key) _again = true;
            variable_struct_set(_seen, _g.key, true);
        }
    }
    Test_False("r3ideas1 tip: a generic pick is never the tip shown last", _again);
    Test_Eq("r3ideas1 tip: across picks every generic tip comes up", array_length(variable_struct_get_names(_seen)), array_length(_pool));
    var _unk = DeathTip_Pick("enemy_snake", SKILL_BITE, "", 2);
    Test_True("r3ideas1 tip: a move with no tip of its own falls back to the generic pool", string_pos("death.tip.gen", _unk.key) == 1);
    // true to the rules
    var _guard = "";
    var _brk = "";
    for (var _t = 0; _t < array_length(_pool); _t++) {
        if (_pool[_t].key == "death.tip.gen_guard") _guard = DeathTip_Text(_pool[_t]);
        if (_pool[_t].key == "death.tip.gen_break") _brk = DeathTip_Text(_pool[_t]);
    }
    Test_True("r3ideas1 tip: the Guard tip carries the MP share of the game's rule (" + string(round(GUARD_MP_PCT * 100)) + "%)", string_pos(string(round(GUARD_MP_PCT * 100)) + "%", _guard) > 0 && string_pos("halves", _guard) > 0);
    Test_True("r3ideas1 tip: the BREAK tip carries the BREAK bonus of the game's rule (" + string(round((BREAK_DAMAGE_MULT - 1) * 100)) + "%)", string_pos(string(round((BREAK_DAMAGE_MULT - 1) * 100)) + "%", _brk) > 0);
    // every tip is one short sentence
    var _all = DeathTip_All();
    var _long = "";
    for (var _a = 0; _a < array_length(_all); _a++) { var _tx = DeathTip_Text(_all[_a]); if (string_length(_tx) > 80) _long += _all[_a].key + " "; }
    Test_Eq("r3ideas1 tip: every tip is short (80 characters at most, tags counted)", _long, "");
}

function Test_R3IdTipRun(_prefix) {
    if (!script_exists(asset_get_index("DeathTip_Pick"))) { Test_True("r3ideas1 death: DeathTip_Pick exists: not implemented", false); return; }
    var _prof = Profile_Get();
    _prof.deaths = 3;
    _prof.last_tip = "";
    Death_KillerKey("died");
    Death_KillSkill();
    var _fps = max(1, game_get_speed(gamespeed_fps));
    // a poison tick that took the last HP
    Death_NoteDotKill(STATUS_POISON);
    var _c1 = Death_BuildContext("died", "Spider");
    Test_Eq("r3ideas1 death: a poison tick death gets the poison tip", _c1.tip_key, "death.tip.status_poison");
    Test_True("r3ideas1 death: the context carries the tip text", string_pos("Antidote", _c1.tip) > 0);
    Test_True("r3ideas1 death: the tip adds time to the scene", _c1.frames > DeathScene_Frames(_c1.text, _fps));
    Test_Eq("r3ideas1 death: the profile remembers the tip", Profile_Get().last_tip, "death.tip.status_poison");
    // an enemy move that took the last HP
    Death_NoteKillSkill(SKILL_PALE_HYMN);
    var _c2 = Death_BuildContext("died", "Pale Choirbeast");
    Test_Eq("r3ideas1 death: a Pale Hymn death gets the Pale Hymn tip", _c2.tip_key, "death.tip.skill_pale_hymn");
    Test_True("r3ideas1 death: and says BREAK", string_pos("BREAK", _c2.tip) > 0);
    // the note is spent: the next death without a move is generic
    var _c3 = Death_BuildContext("died", "Slime");
    Test_True("r3ideas1 death: the move note is used up, the next death gets a generic tip", string_pos("death.tip.gen", _c3.tip_key) == 1);
    // twelve generic deaths in a row never show the same tip twice running
    var _prev = _c3.tip_key;
    var _same = 0;
    for (var _d = 0; _d < 12; _d++) {
        var _cx = Death_BuildContext("died", "Slime");
        if (_cx.tip_key == _prev) _same++;
        _prev = _cx.tip_key;
    }
    Test_Eq("r3ideas1 death: twelve generic deaths in a row never repeat the tip back to back", _same, 0);
    Profile_Flush();
    Test_ProfRelaunch();
    Test_Eq("r3ideas1 death: the last tip is in the profile file", Profile_Get().last_tip, _prev);
    // an abandoned run
    var _before = Profile_Get().last_tip;
    var _ca = Death_BuildContext("abandoned", "");
    Test_Eq("r3ideas1 death: an abandoned run has no tip", _ca.tip, "");
    Test_Eq("r3ideas1 death: and leaves the last tip alone", Profile_Get().last_tip, _before);
    Test_Eq("r3ideas1 death: a context without a tip takes only the line's time", _ca.frames, DeathScene_Frames(_ca.text, _fps));
}

// The death scene's layout with a tip, at the three sizes, in both languages: everything inside the GUI, no word wider than its column.
function Test_R3IdTipFit() {
    if (!script_exists(asset_get_index("DeathTip_All"))) { Test_True("r3ideas1 tipfit: DeathTip_All exists: not implemented", false); return; }
    TextFit_Each("r3ideas1 death tip", function(_w, _h, _lang) {
        var _fails = [];
        var _mt = Ui_Metrics();
        var _all = DeathTip_All();
        var _line = (_lang == "en") ? "The tunnel took you again. It did not hurry, and it did not look away, and the slime that did it was in no way special or kind." : Loc_T("death.t3.1", "How many times has it been?");
        for (var _i = 0; _i < array_length(_all); _i++) {
            var _tip = DeathTip_Text(_all[_i]);
            var _L = RunFlow_DeathLayoutNow(_line, _tip);
            var _what = "tip " + _all[_i].key;
            if (_L.text_x < 0 || _L.text_y < 0 || _L.text_x + _L.text_w > _mt.gw || _L.text_y + _L.text_h > _mt.gh) array_push(_fails, _what + " outside the GUI");
            if (_L.show && !(_L.img_y + _L.img_h <= _L.text_y)) array_push(_fails, _what + " touches the picture");
            if (_L.tip_y + _L.tip_h != _L.text_y + _L.text_h) array_push(_fails, _what + " block is not the end of the text");
            if (_L.tip_y < _L.text_y + _L.line_h) array_push(_fails, _what + " starts inside the line");
            if (_L.tip_h != Ui_TextBlockH(_tip, _L.text_w)) array_push(_fails, _what + " height is not what the tip needs");
            TextFit_Block(_fails, _what, Prompt_Plain(_tip), _L.text_w, _mt.p);
        }
        return _fails;
    });
}

// The bestiary page with every weakness and resistance seen (the longest values: the Codex of a veteran profile), at the three sizes and both languages.
function Test_R3IdCodexFit() {
    TextFit_Each("r3ideas1 codex bestiary seen", function(_w, _h, _l) {
        var _f = [];
        var _prof = TextFit_Profile();
        var _ids = Codex_EnemyIds();
        for (var _i = 0; _i < array_length(_ids); _i++) { Codex_NoteWeakPoint(_prof, _ids[_i], "weak"); Codex_NoteWeakPoint(_prof, _ids[_i], "resist"); }
        var _pg = TabCodex_Page("bestiary", _prof);
        TextFit_TabPage(_f, "codex_bestiary", _pg.rows, _pg.title, _pg.cols);
        return _f;
    });
}

function Test_R3IdWorkbook() {
    Loc_Init();
    var _keys = ["combat.msg.weak_to", "combat.msg.resists", "tab.lbl.weak", "tab.lbl.resists", "death.tip.status_poison", "death.tip.status_bleed", "death.tip.status_burn",
                 "death.tip.skill_pale_hymn", "death.tip.skill_ramming", "death.tip.skill_windup", "death.tip.gen_guard", "death.tip.gen_weak", "death.tip.gen_bed", "death.tip.gen_break",
                 "death.tip.gen_smoke", "death.tip.gen_throw"];
    var _miss = "";
    var _same = "";
    var _st = Loc_GetData().strings;
    for (var _k = 0; _k < array_length(_keys); _k++) {
        var _e = variable_struct_exists(_st, _keys[_k]) ? variable_struct_get(_st, _keys[_k]) : undefined;
        if (!is_struct(_e) || !variable_struct_exists(_e, "en") || !variable_struct_exists(_e, "ko") || string(_e.en) == "" || string(_e.ko) == "") { _miss += _keys[_k] + " "; continue; }
        if (string(_e.en) == string(_e.ko)) _same += _keys[_k] + " ";
    }
    Test_Eq("r3ideas1 workbook: every new string is in the workbook in English and Korean", _miss, "");
    Test_Eq("r3ideas1 workbook: the Korean is not the English", _same, "");
}

// ==========================================================================================================================
// R3 ideas2 (D173, D185; IDEA-03 trapped chests, IDEA-21 boss finisher). The agent sets the numbers (D185); every expected value below comes from the brief or from
// plain arithmetic (15% of max HP rounded up, never below 1 HP; the bar is the sword attack's bar, D60; 250 ms freeze, ~8% zoom over ~300 ms, 600 ms held beat).
// ==========================================================================================================================
function Test_Suite_R3Ideas2() {
    var _fns = ["Trap_PickPid", "Trap_ChestPids", "Trap_IsTrapped", "Trap_Loss", "Trap_Outcome", "Trap_BonusLoot", "Trap_Apply", "Trap_BarParams", "Trap_Grade", "TrapUi_New", "TrapUi_Open",
        "TrapUi_Update", "TrapUi_Finish", "TrapUi_Step", "TrapUi_Draw", "TrapUi_Interrupt", "TrapUi_IsOpen", "Feel_FinisherTotalMs", "Feel_FinisherInsetPx", "Battle_FinisherActive"];
    var _miss = "";
    for (var _f = 0; _f < array_length(_fns); _f++) if (!script_exists(asset_get_index(_fns[_f]))) _miss += _fns[_f] + " ";
    Test_True("ideas2: the packet's functions exist", _miss == "");
    if (_miss != "") return;
    var _shake_keep = GameSettings_Ensure().screen_shake;
    Test_RunSuite("R3Ideas2.pick", Test_I2Pick);
    Test_RunSuite("R3Ideas2.chests", Test_I2Chests);
    Test_RunSuite("R3Ideas2.outcomes", Test_I2Outcomes);
    Test_RunSuite("R3Ideas2.bar", Test_I2Bar);
    Test_RunSuite("R3Ideas2.ui", Test_I2Ui);
    Test_RunSuite("R3Ideas2.tutorial", Test_I2Tutorial);
    Test_RunSuite("R3Ideas2.text", Test_I2Text);
    Test_RunSuite("R3Ideas2.finisher", Test_I2Finisher);
    GameSettings_Ensure().screen_shake = _shake_keep;
}

function Test_I2Pick() {
    var _pids = ["c1", "c2", "c3", "c4"];
    Test_Eq("trap pick: floor 1 has no trapped chest", Trap_PickPid(5, "rm_floor1", _pids), "");
    Test_Eq("trap pick: a floor with no chest has none", Trap_PickPid(5, "rm_floor2", []), "");
    Test_Eq("trap pick: the only chest of floor 2 is the trapped one", Trap_PickPid(5, "rm_floor2", ["only"]), "only");
    Test_Eq("trap pick: a room that is no floor has none", Trap_PickPid(5, "rm_start", ["a"]), "");
    Test_Eq("trap pick: the battle room has none", Trap_PickPid(5, "rm_battle", ["a"]), "");
    Test_Eq("trap pick: floor 6.5 counts as a floor from 2 on", Trap_PickPid(5, "rm_floor6_5", ["a"]), "a");
    Test_Eq("trap pick: floor 9 counts", Trap_PickPid(5, "rm_floor9", ["a", "b"]) != "", true);
    var _seen = { c1: 0, c2: 0, c3: 0, c4: 0 };
    var _member = true;
    var _stable = true;
    var _order = true;
    for (var _sd = 1; _sd <= 200; _sd++) {
        var _a = Trap_PickPid(_sd, "rm_floor3", _pids);
        if (!array_contains(_pids, _a)) { _member = false; continue; }
        variable_struct_set(_seen, _a, variable_struct_get(_seen, _a) + 1);
        if (Trap_PickPid(_sd, "rm_floor3", _pids) != _a) _stable = false;
        if (Trap_PickPid(_sd, "rm_floor3", ["c4", "c2", "c1", "c3"]) != _a) _order = false;
    }
    Test_True("trap pick: exactly one chest of the floor is picked, and it is one of them", _member);
    Test_True("trap pick: the same seed picks the same chest (200 seeds, twice each)", _stable);
    Test_True("trap pick: the order the chests were found in does not matter", _order);
    Test_True("trap pick: every chest is the trapped one for some seeds (a fair spread over 200 seeds)", _seen.c1 >= 20 && _seen.c2 >= 20 && _seen.c3 >= 20 && _seen.c4 >= 20);
    var _rooms = 0;
    for (var _fl = 2; _fl <= 9; _fl++) if (Trap_PickPid(12345, "rm_floor" + string(_fl), _pids) != "") _rooms++;
    Test_Eq("trap pick: every floor from 2 to 9 with a chest has a trapped one", _rooms, 8);
}

function Test_I2MakeChests(_pids, _obj) {
    var _out = [];
    for (var _i = 0; _i < array_length(_pids); _i++) {
        var _c = instance_create_depth(16 + _i * 16, 16, 0, _obj);
        _c.persist_id = _pids[_i];
        array_push(_out, _c);
    }
    return _out;
}

function Test_I2Chests() {
    var _gs = GameState_Get();
    var _chests = Test_I2MakeChests(["t1", "t2", "t3"], obj_chest_lv1);
    var _skill = Test_I2MakeChests(["s1"], obj_chest_skillbook);
    var _barrel = Test_I2MakeChests(["b1"], obj_barrel);
    var _ids = Trap_ChestPids();
    Test_True("trap chests: the loot chests of the room are listed, sorted, and the skill chest and the barrel are not", array_length(_ids) == 3 && _ids[0] == "t1" && _ids[1] == "t2" && _ids[2] == "t3");
    var _ok = true;
    var _one = true;
    for (var _sd = 700; _sd < 730; _sd++) {
        var _n = 0;
        for (var _i = 0; _i < 3; _i++) if (Trap_IsTrapped(_chests[_i], _sd, "rm_floor3")) _n++;
        if (_n != 1) _one = false;
        if (Trap_IsTrapped(_skill[0], _sd, "rm_floor3") || Trap_IsTrapped(_barrel[0], _sd, "rm_floor3")) _ok = false;
        if (Trap_IsTrapped(_chests[0], _sd, "rm_floor1")) _ok = false;
    }
    Test_True("trap chests: exactly one of three chests is trapped on floor 3, for every seed", _one);
    Test_True("trap chests: never the skill chest, never a barrel, never anything on floor 1", _ok);
    var _want = Trap_PickPid(704, "rm_floor3", ["t1", "t2", "t3"]);
    var _got = "";
    for (var _j = 0; _j < 3; _j++) if (Trap_IsTrapped(_chests[_j], 704, "rm_floor3")) _got = _chests[_j].persist_id;
    Test_Eq("trap chests: the chest that is trapped is the seed's pick", _got, _want);
    // opened chests still count, so opening one never moves the trap to another chest
    for (var _k = 0; _k < 3; _k++) _chests[_k].swapped = true;
    var _after = "";
    for (var _m = 0; _m < 3; _m++) if (Trap_IsTrapped(_chests[_m], 704, "rm_floor3")) _after = _chests[_m].persist_id;
    Test_Eq("trap chests: opened chests stay in the draw (the pick does not move)", _after, _want);
    // Continue: the room state is rebuilt from the save and the chests are made again with the same ids
    _gs.persist = {};
    _gs.persist_applied = {};
    for (var _d = 0; _d < 3; _d++) instance_destroy(_chests[_d]);
    var _again = Test_I2MakeChests(["t1", "t2", "t3"], obj_chest_lv1);
    var _cont = "";
    for (var _e = 0; _e < 3; _e++) if (Trap_IsTrapped(_again[_e], 704, "rm_floor3")) _cont = _again[_e].persist_id;
    Test_Eq("trap chests: after Continue (state rebuilt, chests made again) the same chest is trapped", _cont, _want);
    Test_False("trap chests: no run and no seed: nothing is trapped", Trap_IsTrapped(_again[0]));
    for (var _x = 0; _x < 3; _x++) instance_destroy(_again[_x]);
    instance_destroy(_skill[0]);
    instance_destroy(_barrel[0]);
}

function Test_I2Count(_ch, _id) {
    var _n = 0;
    for (var _i = 0; _i < array_length(_ch.inventory); _i++) if (_ch.inventory[_i].id == _id) _n += _ch.inventory[_i].qty;
    return _n;
}

function Test_I2Outcomes() {
    Test_Eq("trap loss: 15% of 20 is 3", Trap_Loss(20, 20), 3);
    Test_Eq("trap loss: 15% of 100 is 15", Trap_Loss(100, 100), 15);
    Test_Eq("trap loss: 15% of 10 is 1.5, rounded up to 2", Trap_Loss(10, 10), 2);
    Test_Eq("trap loss: 15% of 7 is 1.05, rounded up to 2", Trap_Loss(7, 7), 2);
    Test_Eq("trap loss: 15% of 6 is 0.9, rounded up to 1", Trap_Loss(6, 6), 1);
    Test_Eq("trap loss: 15% of 200 is 30", Trap_Loss(200, 200), 30);
    Test_Eq("trap loss: it is 15% of MAX HP, not of the HP left", Trap_Loss(50, 100), 15);
    Test_Eq("trap loss: at 3 HP of 100 it takes 2 (never below 1 HP)", Trap_Loss(3, 100), 2);
    Test_Eq("trap loss: at 1 HP it takes nothing", Trap_Loss(1, 100), 0);
    Test_Eq("trap loss: at 1 of 1 it takes nothing", Trap_Loss(1, 1), 0);
    Test_Eq("trap loss: a Max HP of 4 loses 1", Trap_Loss(4, 4), 1);
    var _kills = 0;
    var _neg = 0;
    for (var _mx = 1; _mx <= 200; _mx++) {
        for (var _hp = 1; _hp <= _mx; _hp++) {
            var _l = Trap_Loss(_hp, _mx);
            if (_hp - _l < 1) _kills++;
            if (_l < 0) _neg++;
        }
    }
    Test_Eq("trap loss: no HP / Max HP pair from 1 to 200 is ever taken below 1 HP", _kills, 0);
    Test_Eq("trap loss: and it never heals", _neg, 0);
    var _p = Trap_Outcome(QTE_PERFECT);
    var _g = Trap_Outcome(QTE_GOOD);
    var _o = Trap_Outcome(QTE_OK);
    var _w = Trap_Outcome(QTE_WEAK);
    Test_True("trap outcome: Perfect gives the bonus and costs nothing", _p.bonus && !_p.hurt);
    Test_True("trap outcome: Good gives just the item", !_g.bonus && !_g.hurt);
    Test_True("trap outcome: OK gives just the item", !_o.bonus && !_o.hurt);
    Test_True("trap outcome: Weak costs HP and gives no bonus", !_w.bonus && _w.hurt);
    // the bonus: one tier-1 consumable, from the seed
    var _b1 = Trap_BonusLoot(900, "rm_floor3", "t1");
    var _b2 = Trap_BonusLoot(900, "rm_floor3", "t1");
    Test_True("trap bonus: one item", is_array(_b1) && array_length(_b1) == 1 && _b1[0].qty == 1);
    Test_Eq("trap bonus: the same seed gives the same item", json_stringify(_b1), json_stringify(_b2));
    var _tier1 = true;
    var _kinds = {};
    for (var _sd = 1; _sd <= 80; _sd++) {
        var _b = Trap_BonusLoot(_sd, "rm_floor4", "c" + string(_sd mod 3));
        var _it = ItemDB_Get(_b[0].item_id);
        if (!(is_struct(_it) && _it.type == ITEM_CONSUMABLE && Item_Rarity(_b[0].item_id) == 1)) _tier1 = false;
        variable_struct_set(_kinds, string(_b[0].item_id), 1);
    }
    Test_True("trap bonus: always a Common (tier 1) consumable", _tier1);
    Test_True("trap bonus: more than one kind turns up over 80 seeds", array_length(variable_struct_get_names(_kinds)) >= 3);
    // applying a grade to a character
    var _ch = CharacterCreate_Player(CLASS_KNIGHT);
    _ch.max_hp = 40;
    _ch.hp = 40;
    var _bonus = [{ item_id: 10, qty: 1 }];
    var _n10 = Test_I2Count(_ch, 10);
    var _rp = Trap_Apply(_ch, QTE_PERFECT, _bonus);
    Test_True("trap apply: Perfect adds the bonus item and keeps every HP", Test_I2Count(_rp.ch, 10) == _n10 + 1 && _rp.ch.hp == 40 && _rp.lost == 0 && array_length(_rp.bonus) == 1);
    Test_True("trap apply: Perfect works on a copy", Test_I2Count(_ch, 10) == _n10 && _ch.hp == 40);
    var _rg = Trap_Apply(_ch, QTE_GOOD, _bonus);
    var _ro = Trap_Apply(_ch, QTE_OK, _bonus);
    Test_True("trap apply: Good and OK change nothing", _rg.ch.hp == 40 && _ro.ch.hp == 40 && Test_I2Count(_rg.ch, 10) == _n10 && Test_I2Count(_ro.ch, 10) == _n10 && array_length(_rg.bonus) == 0);
    var _rw = Trap_Apply(_ch, QTE_WEAK, _bonus);
    Test_True("trap apply: Weak costs 15% of Max HP (40 -> 6) and gives no bonus", _rw.ch.hp == 34 && _rw.lost == 6 && Test_I2Count(_rw.ch, 10) == _n10 && array_length(_rw.bonus) == 0);
    _ch.hp = 1;
    var _r1 = Trap_Apply(_ch, QTE_WEAK, _bonus);
    Test_True("trap apply: Weak at 1 HP leaves 1 HP (trap damage never kills)", _r1.ch.hp == 1 && _r1.lost == 0);
    _ch.hp = 3;
    _ch.max_hp = 100;
    var _r3 = Trap_Apply(_ch, QTE_WEAK, _bonus);
    Test_True("trap apply: Weak at 3 of 100 HP leaves 1 HP", _r3.ch.hp == 1 && _r3.lost == 2);
    _ch.max_hp = 4;
    _ch.hp = 4;
    var _r4 = Trap_Apply(_ch, QTE_WEAK, _bonus);
    Test_True("trap apply: a Max HP of 4 loses 1", _r4.ch.hp == 3 && _r4.lost == 1);
    var _all = true;
    var _keys = [QTE_PERFECT, QTE_GOOD, QTE_OK, QTE_WEAK];
    for (var _ki = 0; _ki < 4; _ki++) {
        var _c2 = CharacterCreate_Player(CLASS_MAGE);
        _c2.hp = 1;
        var _res = Trap_Apply(_c2, _keys[_ki], _bonus);
        if (_res.ch.hp < 1 || _res.ch.hp > _c2.max_hp) _all = false;
    }
    Test_True("trap apply: no grade leaves a character under 1 HP", _all);
}

function Test_I2Bar() {
    var _par = Trap_BarParams();
    Test_True("trap bar: it is the sword attack's bar (1100 ms, 60 / 120 / 200)", _par.sweep_ms == 1100 && _par.perfect_half_width == 60 && _par.good_half_width == 120 && _par.ok_half_width == 200);
    var _c = Qte_ZoneCentreMs(_par);
    Test_Eq("trap bar: a press on the zone's centre is Perfect", Trap_Grade(_c, 1), QTE_PERFECT);
    Test_Eq("trap bar: 100 ms off is Good", Trap_Grade(_c + 100, 1), QTE_GOOD);
    Test_Eq("trap bar: 180 ms off is OK", Trap_Grade(_c - 180, 1), QTE_OK);
    Test_Eq("trap bar: a press at the start is Weak", Trap_Grade(0, 1), QTE_WEAK);
    Test_Eq("trap bar: no press is Weak", Trap_Grade(QTE_NO_PRESS, 1), QTE_WEAK);
    Test_Eq("trap bar: with the QTE assist the zones are x1.5 wider (80 ms off is Perfect)", Trap_Grade(_c + 80, 1.5), QTE_PERFECT);
    Test_Eq("trap bar: without it the same press is Good", Trap_Grade(_c + 80, 1), QTE_GOOD);
    var _same = true;
    for (var _a = 0; _a < 2; _a++) {
        var _as = (_a == 0) ? 1 : 1.5;
        for (var _p = -1; _p <= 1100; _p += 10) {
            if (Trap_Grade(_p, _as) != Qte_Result(Qte_Grade(_p, Qte_BarParams("default"), _as)).key) _same = false;
        }
    }
    Test_True("trap bar: every press is graded exactly as the sword attack's bar grades it", _same);
}

// A fresh state for the screens: a run, a Knight, nothing open.
function Test_I2Begin() {
    var _gs = GameState_Get();
    var _k = { had: variable_struct_exists(_gs, "run"), run: variable_struct_exists(_gs, "run") ? _gs.run : undefined, player: _gs.player_ch, tut: variable_global_exists("tutorial_off") ? global.tutorial_off : true };
    _gs.run = Run_Create(5);
    _gs.player_ch = CharacterCreate_Player(CLASS_KNIGHT);
    global.trap_ui = undefined;
    global.tutorial_off = true;
    if (_gs.ui.mode == UI_DIALOGUE) Dialogue_CloseNow();
    _gs.ui.mode = UI_NONE;
    _gs.ui.lines = [];
    return _k;
}

function Test_I2End(_k) {
    var _gs = GameState_Get();
    global.trap_ui = undefined;
    global.tutorial_off = _k.tut;
    if (_gs.ui.mode == UI_DIALOGUE) Dialogue_CloseNow();
    _gs.ui.mode = UI_NONE;
    _gs.ui.lines = [];
    if (_k.had) _gs.run = _k.run; else variable_struct_remove(_gs, "run");
    _gs.player_ch = _k.player;
}

function Test_I2Ui() {
    var _k = Test_I2Begin();
    var _gs = GameState_Get();
    var _u = TrapUi_New({ name: "Chest", lines: [], loot: [], bonus: [{ item_id: 10, qty: 1 }], pid: "p", inst: noone });
    Test_Eq("trap ui: it starts waiting (a line is read before the bar)", _u.phase, "wait");
    Test_Eq("trap ui: the clock starts in the lead-in", _u.ms, -QTE_LEAD_IN_MS);
    Test_Eq("trap ui: nothing happens while something else owns the screen", TrapUi_Update(_u, 16, true, false), "");
    Test_True("trap ui: it is still waiting and the clock did not move", _u.phase == "wait" && _u.ms == -QTE_LEAD_IN_MS);
    Test_Eq("trap ui: when the screen is free the bar comes up", TrapUi_Update(_u, 16, false, true), "");
    Test_Eq("trap ui: the bar is up", _u.phase, "bar");
    Test_Eq("trap ui: a press in the lead-in (the one that closed the line) is dropped", TrapUi_Update(_u, 16, true, true), "");
    Test_Eq("trap ui: the bar goes on", _u.phase, "bar");
    _u.ms = -40;
    Test_Eq("trap ui: a press just before the sweep counts as 0 and is Weak", TrapUi_Update(_u, 10, true, true), QTE_WEAK);
    Test_Eq("trap ui: one press, one result: the screen is done", _u.phase, "done");
    Test_Eq("trap ui: nothing more happens after the result", TrapUi_Update(_u, 16, true, true), "");
    var _v = TrapUi_New({ name: "Chest", lines: [], loot: [], bonus: [], pid: "p", inst: noone });
    TrapUi_Update(_v, 16, false, true);
    _v.ms = Qte_ZoneCentreMs(Trap_BarParams());
    Test_Eq("trap ui: a press on the centre is Perfect", TrapUi_Update(_v, 0, true, true), QTE_PERFECT);
    var _w = TrapUi_New({ name: "Chest", lines: [], loot: [], bonus: [], pid: "p", inst: noone });
    TrapUi_Update(_w, 16, false, true);
    var _res = "";
    var _steps = 0;
    while (_res == "" && _steps < 400) { _res = TrapUi_Update(_w, 16.6667, false, true); _steps++; }
    Test_Eq("trap ui: no press ends the sweep as Weak", _res, QTE_WEAK);
    Test_True("trap ui: the sweep lasted about 1.35 s (250 ms lead-in + 1100 ms sweep, 81 frames)", _steps >= 79 && _steps <= 83, string(_steps));
    // D122: the clock is the QTE clock, so a window out of front stops it
    var _fp = variable_global_exists("focus_prev") ? global.focus_prev : true;
    global.focus_prev = false;
    Test_Eq("trap ui: out of focus the bar's clock does not move (D122)", TrapUi_StepMs(16666), 0);
    global.focus_prev = true;
    Test_True("trap ui: in front it moves by the frame", abs(TrapUi_StepMs(16666) - 16.666) < 0.01);
    global.focus_prev = _fp;

    // the live path: it opens when the screen is free, pauses the map, and a result closes it and says what happened
    TrapUi_Open({ name: "Chest", lines: ["Received it."], loot: [], bonus: [{ item_id: 10, qty: 1 }], pid: "p", inst: noone });
    Test_True("trap ui: open", TrapUi_IsOpen());
    Dialogue_StartWithSpeaker("Chest", ["It's trapped!"]);
    Test_False("trap ui: the live step does not take the frame while the line is up", TrapUi_Step());
    Test_Eq("trap ui: the map is not paused by it yet (the dialogue owns it)", _gs.ui.mode, UI_DIALOGUE);
    Dialogue_CloseNow();
    _gs.ui.lines = [];
    Test_True("trap ui: with the screen free the live step takes the frame", TrapUi_Step());
    Test_Eq("trap ui: the ui mode is the trap's (the map is paused: UI_IsBlocking)", _gs.ui.mode, UI_TRAP);
    Test_True("trap ui: the world is blocked", UI_IsBlocking());
    Test_False("trap ui: the Tab menu cannot open over it", Menu_MapFree());
    var _hp0 = _gs.player_ch.hp;
    var _n10 = Test_I2Count(_gs.player_ch, 10);
    TrapUi_Finish(global.trap_ui, QTE_PERFECT);
    Test_False("trap ui: a result closes the screen", TrapUi_IsOpen());
    Test_Eq("trap ui: then the dialogue says what happened", _gs.ui.mode, UI_DIALOGUE);
    Test_True("trap ui: Perfect gave the bonus item and cost nothing", Test_I2Count(_gs.player_ch, 10) == _n10 + 1 && _gs.player_ch.hp == _hp0);
    Test_Eq("trap ui: the result is kept for the scripts", global.trap_result.key, QTE_PERFECT);
    Dialogue_CloseNow();
    _gs.ui.lines = [];
    // Weak: the HP cost, never a death; the line says the number
    _gs.player_ch.max_hp = 40;
    _gs.player_ch.hp = 40;
    TrapUi_Open({ name: "Chest", lines: [], loot: [], bonus: [], pid: "p", inst: noone });
    TrapUi_Step();
    TrapUi_Finish(global.trap_ui, QTE_WEAK);
    Test_Eq("trap ui: Weak costs 6 of 40 HP", _gs.player_ch.hp, 34);
    var _line = (array_length(_gs.ui.lines) > 0) ? Dialogue_LineText(_gs.ui.lines[0]) : "";
    Test_True("trap ui: the Weak line says how much", string_pos("6", _line) > 0 && _line == Loc_T("trap.result.weak", "x", { hp: 6 }), _line);
    Dialogue_CloseNow();
    _gs.ui.lines = [];
    _gs.player_ch.hp = 1;
    TrapUi_Open({ name: "Chest", lines: [], loot: [], bonus: [], pid: "p", inst: noone });
    TrapUi_Step();
    TrapUi_Finish(global.trap_ui, QTE_WEAK);
    Test_Eq("trap ui: Weak at 1 HP keeps 1 HP", _gs.player_ch.hp, 1);
    _line = (array_length(_gs.ui.lines) > 0) ? Dialogue_LineText(_gs.ui.lines[0]) : "";
    Test_Eq("trap ui: and says it barely hurt", _line, Loc_T("trap.result.weak_none", "x"));
    Dialogue_CloseNow();
    _gs.ui.lines = [];
    // an interruption (a room change, a menu closed by force) ends it with no cost and no bonus; the chest's item was given when it opened
    _gs.player_ch.hp = 30;
    TrapUi_Open({ name: "Chest", lines: [], loot: [], bonus: [{ item_id: 10, qty: 1 }], pid: "p", inst: noone });
    TrapUi_Step();
    var _n10b = Test_I2Count(_gs.player_ch, 10);
    TrapUi_Interrupt();
    Test_False("trap ui: an interruption closes it", TrapUi_IsOpen());
    Test_True("trap ui: and frees the map", _gs.ui.mode == UI_NONE);
    Test_True("trap ui: with no cost and no bonus", _gs.player_ch.hp == 30 && Test_I2Count(_gs.player_ch, 10) == _n10b);
    Test_I2End(_k);
}

function Test_I2Tutorial() {
    var _k = Test_I2Begin();
    var _ids = Tutorial_Ids();
    Test_Eq("trap tutorial: twelve mechanics now, the trap last", array_length(_ids), 12);
    Test_Eq("trap tutorial: the id is trap", _ids[11], "trap");
    var _e = Tutorial_Get("trap");
    Test_True("trap tutorial: it has a title and a short text that says what to press", is_struct(_e) && string_length(_e.title) > 2 && string_length(_e.body) > 20 && string_length(_e.body) < 260 && string_pos("[k:confirm]", _e.body) > 0);
    global.tutorial_ui = undefined;
    global.tutorial_off = false;
    Profile_ResetForTest();
    TrapUi_Open({ name: "Chest", lines: [], loot: [], bonus: [], pid: "p", inst: noone });
    Test_False("trap tutorial: not shown before the bar", Tutorial_IsOpen());
    TrapUi_Step();
    Test_True("trap tutorial: the first trapped chest of a profile shows the pop-up", Tutorial_IsOpen() && Tutorial_CurrentId() == "trap");
    Test_True("trap tutorial: it is remembered in the profile", Tutorial_Seen("trap") && Profile_StorySeen(Profile_Load(Profile_Path()).profile, "tutorial:trap"));
    TrapUi_Finish(global.trap_ui, QTE_OK);
    Dialogue_CloseNow();
    GameState_Get().ui.lines = [];
    Tutorial_Dismiss();
    TrapUi_Open({ name: "Chest", lines: [], loot: [], bonus: [], pid: "p", inst: noone });
    TrapUi_Step();
    Test_False("trap tutorial: the second one does not", Tutorial_IsOpen());
    TrapUi_Interrupt();
    global.tutorial_ui = undefined;
    Profile_ResetForTest();
    Test_I2End(_k);
}

function Test_I2Text() {
    var _keys = ["trap.line.trapped", "trap.bar.prompt", "trap.result.perfect", "trap.result.fine", "trap.result.weak", "trap.result.weak_none", "tutorial.trap.title", "tutorial.trap.body"];
    var _gap = "";
    for (var _i = 0; _i < array_length(_keys); _i++) {
        if (Loc_GetRaw(_keys[_i], "en") == "" || Loc_GetRaw(_keys[_i], "ko") == "") _gap += _keys[_i] + " ";
    }
    Test_True("trap text: every string is in English and Korean", _gap == "", _gap);
    Test_Eq("trap text: the line is the brief's", Loc_GetRaw("trap.line.trapped", "en"), "It's trapped!");
    Test_True("trap text: the Korean line is not the English one", Loc_GetRaw("trap.line.trapped", "ko") != Loc_GetRaw("trap.line.trapped", "en"));
    Test_True("trap text: the Weak line takes the number", string_pos("{hp}", Loc_GetRaw("trap.result.weak", "en")) > 0 && string_pos("{hp}", Loc_GetRaw("trap.result.weak", "ko")) > 0);
}

// One boss kill or one normal kill, frame by frame at 60 fps the way Step_0 runs it (the feel step, then the hit freeze, then the pop), with the killing hit's own freeze (a Perfect: 80 ms) in place.
function Test_I2Sequence(_boss, _shake) {
    GameSettings_Ensure().screen_shake = _shake ? 1 : 0;
    var _gs = GameState_Get();
    _gs.cam_shake = { mag: 0, ms: 0, elapsed_ms: 0, dir: SHAKE_DIR_H };
    var _bc = Test_FeelFakeBattle(100, 100, _boss ? ENEMY_MINI_BOSS : ENEMY_SLIME);
    _bc.e.hp = 0;
    _bc.last_dmg = 20;
    _bc.qte_result_key = QTE_PERFECT;
    _bc.hitstop_ms = FEEL_FREEZE_PERFECT_MS;
    var _dt = 1000 / 60;
    var _r = { freeze_frames: 0, zoom_frames: 0, peak: 0, pop_start: -1, shake_first: -1, msg_frame: -1, hit0: 0, hold_sprite: true, began: false, finisher: false };
    _r.began = Battle_DeathPopBegin(_bc, _bc.e, "Slain.");
    _r.hit0 = _bc.hitstop_ms;
    for (var _f = 1; _f <= 160; _f++) {
        var _was = _bc.hitstop_ms;
        Battle_FeelStep(_bc, _dt);
        if (_was > 0) {
            _r.freeze_frames++;
            _bc.hitstop_ms -= _dt;
            if (_bc.hitstop_ms <= 0) {
                _bc.hitstop_ms = 0;
                Battle_QteImpactFeedback(_bc);
            }
        } else {
            Battle_DeathPopStep(_bc);
        }
        if (_bc.feel_inset > 0) _r.zoom_frames++;
        _r.peak = max(_r.peak, _bc.feel_inset);
        if (_r.pop_start < 0 && is_struct(_bc.death_pop) && _bc.death_pop.t_ms > 0) _r.pop_start = _f;
        if (_r.shake_first < 0 && _gs.cam_shake.mag > 0) _r.shake_first = _f;
        if (_r.msg_frame < 0 && _bc.message_text != "") _r.msg_frame = _f;
        if (_r.pop_start < 0 && is_struct(_bc.death_pop) && !Feel_SpriteVisible(_bc.death_pop.t_ms)) _r.hold_sprite = false;
    }
    _r.finisher = Battle_FinisherActive(_bc);
    instance_destroy(_bc.enemy_inst);
    Display_ClearZoom();
    return _r;
}

function Test_I2Finisher() {
    Test_Eq("finisher: the freeze is 250 ms", FEEL_FINISHER_FREEZE_MS, 250);
    Test_Eq("finisher: the zoom takes 300 ms", FEEL_FINISHER_ZOOM_MS, 300);
    Test_Eq("finisher: the held beat is 600 ms", FEEL_FINISHER_BEAT_MS, 600);
    Test_Eq("finisher: freeze plus beat is 850 ms before the pop", Feel_FinisherTotalMs(), 850);
    Test_True("finisher: the freeze is more than double the longest normal hit freeze (120 ms)", FEEL_FINISHER_FREEZE_MS > 2 * FEEL_FREEZE_HEAVY_MS);
    Test_Eq("finisher: no zoom at the start", Feel_FinisherInsetPx(0), 0);
    Test_Eq("finisher: none once it has run its 300 ms", Feel_FinisherInsetPx(300), 0);
    var _peak = 0;
    var _mono_up = true;
    var _prev = 0;
    var _past = false;
    var _mono_down = true;
    for (var _t = 0; _t <= 300; _t += 5) {
        var _in = Feel_FinisherInsetPx(_t);
        _peak = max(_peak, _in);
        if (_in < 0) _mono_up = false;
        if (_in < _prev && !_past) _past = true;
        if (_past && _in > _prev) _mono_down = false;
        _prev = _in;
    }
    var _zr = Feel_ZoomRegion(_peak, 80, 58);
    Test_True("finisher: the zoom peaks at about 8% (7 to 9%)", _zr.zoom >= 1.07 && _zr.zoom <= 1.09, string(_zr.zoom));
    Test_True("finisher: it goes up and then back down, eased (never up again once it has come down)", _mono_up && _mono_down);
    Test_True("finisher: it is a punch: the peak is in the first third", Feel_FinisherInsetPx(90) == _peak && Feel_FinisherInsetPx(30) >= 1);

    var _b = Test_I2Sequence(true, true);
    Test_True("finisher: a boss kill starts a death pop, and the finisher is over by the end", _b.began && _b.finisher == false);
    Test_Eq("finisher: the boss kill freezes the picture 250 ms (not the hit's own 80)", _b.hit0, 250);
    Test_True("finisher: 250 ms is 15 frames at 60 fps (14 to 16 seen)", _b.freeze_frames >= 14 && _b.freeze_frames <= 16, string(_b.freeze_frames));
    Test_Eq("finisher: the zoom reaches 6 px a side", _b.peak, 6);
    Test_True("finisher: the zoom lasts about 300 ms (14 to 18 frames of push-in)", _b.zoom_frames >= 14 && _b.zoom_frames <= 18, string(_b.zoom_frames));
    Test_True("finisher: the pop starts after the freeze and the 600 ms beat: frame 50 to 53 (850 ms)", _b.pop_start >= 50 && _b.pop_start <= 53, string(_b.pop_start));
    Test_True("finisher: the held beat is still: the sprite stays", _b.hold_sprite);
    Test_True("finisher: and no camera shake is started before the pop", _b.shake_first < 0 || _b.shake_first >= _b.pop_start, "shake at " + string(_b.shake_first));
    Test_True("finisher: the pop's own shake comes with the burst (after its 120 ms freeze)", _b.shake_first >= _b.pop_start + 6 && _b.shake_first <= _b.pop_start + 9, "shake at " + string(_b.shake_first) + " pop " + string(_b.pop_start));
    Test_True("finisher: the slain text comes after the pop (850 + 1020 ms = frame 112)", _b.msg_frame >= 110 && _b.msg_frame <= 115, string(_b.msg_frame));

    var _bn = Test_I2Sequence(true, false);
    Test_Eq("finisher: with Screen shake off the zoom is still there", _bn.peak, 6);
    Test_True("finisher: with Screen shake off no shake is ever started", _bn.shake_first < 0);
    Test_True("finisher: with Screen shake off the freeze and the beat are the same", _bn.hit0 == 250 && _bn.pop_start >= 50 && _bn.pop_start <= 53, string(_bn.pop_start));

    var _n = Test_I2Sequence(false, true);
    Test_Eq("finisher: a normal enemy keeps its hit freeze (80 ms, no 250)", _n.hit0, FEEL_FREEZE_PERFECT_MS);
    Test_Eq("finisher: a normal enemy's pop starts at once (frame 1)", _n.pop_start, 1);
    Test_True("finisher: a normal enemy has no finisher", !_n.finisher);
    Test_True("finisher: a normal enemy's slain text is as before (620 ms = frame 37)", _n.msg_frame >= 36 && _n.msg_frame <= 39, string(_n.msg_frame));
    Test_True("finisher: a normal enemy's killing hit still shakes the camera at once", _n.shake_first >= 1 && _n.shake_first <= 8, string(_n.shake_first));
    var _nn = Test_I2Sequence(false, false);
    Test_True("finisher: a normal enemy with shake off: no shake", _nn.shake_first < 0);
    // the boss's killing hit's own impact (a Perfect's camera shake) is not allowed to break the held beat
    GameSettings_Ensure().screen_shake = 1;
    GameState_Get().cam_shake = { mag: 0, ms: 0, elapsed_ms: 0, dir: SHAKE_DIR_H };
    var _bc = Test_FeelFakeBattle(100, 100, ENEMY_MINI_BOSS);
    _bc.e.hp = 0;
    _bc.last_dmg = 20;
    _bc.qte_result_key = QTE_PERFECT;
    Battle_DeathPopBegin(_bc, _bc.e, "x");
    Test_True("finisher: the finisher is active right after the kill", Battle_FinisherActive(_bc));
    Battle_QteImpactFeedback(_bc);
    Test_True("finisher: the killing Perfect's impact shake and jolt are held back during the finisher", GameState_Get().cam_shake.mag == 0);
    instance_destroy(_bc.enemy_inst);
    Display_ClearZoom();
}

// ============================================================================================================================
// Round 4 note 1 (I-106, R-120): "P still does this, please delete this debug overlay". The player's game has no debug overlay and no debug hotkey:
// the hotkeys (P, J, L, K, U, O and the save/load ones) only work when the exe is started with -debug; P typed into a name never opens anything.
// ============================================================================================================================
function Test_Suite_R4NoDebug() {
    Test_Eq("r4nodebug: debug hotkeys are off in a normal launch (no -debug)", Debug_HotkeysAllowed(), false);
    var _was = Debug_IsEnabled();
    global.debug.enabled = false;
    Debug_Update();
    Test_Eq("r4nodebug: a debug update without -debug leaves debug off", Debug_IsEnabled(), false);
    global.debug.enabled = _was;
    Test_Eq("r4nodebug: there is no audio debug overlay switch", variable_global_exists("audio_debug_enabled") && global.audio_debug_enabled, false);
}


// ---- R-119 (owner 2026-10-17): every sound at a similar loudness. One gain (dB) per sound asset, from tools/audio/loudness.json
// (the Python check tools/audio/check_gain_table.py proves each sound's level after the gain). The expected values below are worked by hand from
// the brief's targets shifted 8 dB down for headroom (SFX -26, UI -29, music and ambience -28 LUFS) and the measured file levels, rounded to half a dB, so each is a +-0.5 dB band.
function Test_LoudDb(_name, _asset, _lo, _hi) {
    var _db = SFX_AssetGainDb(_asset);
    Test_True("loudness: " + _name + " gets " + string(_lo) + " to " + string(_hi) + " dB from the table (got " + string(_db) + ")", _db >= _lo && _db <= _hi);
}

function Test_Suite_R3Loudness() {
    var _fns = ["SFX_BuildGainTable", "SFX_GainTable", "SFX_GainTableHas", "SFX_AssetGainDb", "SFX_AssetGain", "SFX_DbToLinear", "SFX_ComputeGain", "BGM_TrackTrim", "SFX_SameSoundOverflow"];
    var _miss = "";
    for (var _f = 0; _f < array_length(_fns); _f++) if (!script_exists(asset_get_index(_fns[_f]))) _miss += _fns[_f] + " ";
    Test_True("loudness: the packet's functions exist (missing: " + _miss + ")", _miss == "");
    if (_miss != "") return;

    // the table: a measured level, worked to its target
    Test_LoudDb("Modern5 (UI, file -30.5 LUFS, target -29: +1.5)", Modern5, 1.0, 2.0);
    Test_LoudDb("Monster_Roar_5 (file -8.0, target -26 +2 for a roar: -16.0)", "Monster_Roar_5", -16.5, -15.5);
    Test_LoudDb("Fireball_2 (file -12.2, target -26: -13.8)", Fireball_2, -14.5, -13.5);
    Test_LoudDb("final_boss_spawn (file -15.9, target -26 +2: -8.1)", "final_boss_spawn", -8.5, -7.5);
    Test_LoudDb("overall_bgm (file -28.1, target -28: 0)", overall_bgm, -0.5, 0.5);
    Test_LoudDb("forest_bgm (file -34.2, target -28: +6)", "forest_bgm__for_everymap_with_trees", 5.5, 6.5);
    Test_LoudDb("Ambience_haunting (file -16.7, target -28: -11.3)", "Ambience_haunting", -12.0, -11.0);
    Test_LoudDb("Crying_moaning_ambience_2 (file -38.7, target -28: +10.7)", "Crying_moaning_ambience_2", 10.0, 11.0);
    Test_Eq("loudness: a sound with no table row gets 0 dB", SFX_AssetGainDb("no_such_sound_xyz"), 0);
    Test_Eq("loudness: noone gets 0 dB", SFX_AssetGainDb(noone), 0);
    Test_True("loudness: 0 dB is a gain of 1, +6 dB about 2, -6 dB about 0.5", SFX_DbToLinear(0) == 1 && abs(SFX_DbToLinear(6) - 1.995) < 0.01 && abs(SFX_DbToLinear(-6) - 0.501) < 0.01);

    // every sound the game can play has a row (a new sound without a measurement would play at 0 dB: re-run tools/audio)
    var _missing = "";
    var _keys = ds_map_keys_to_array(global.sfx_db);
    for (var _k = 0; _k < array_length(_keys); _k++) {
        var _snd = global.sfx_db[? _keys[_k]];
        if (SFX_IsValidSoundAsset(_snd) && !SFX_GainTableHas(_snd)) _missing += audio_get_name(_snd) + " ";
        if (ds_map_exists(global.sfx_variant_db, _keys[_k])) {
            var _list = global.sfx_variant_db[? _keys[_k]];
            for (var _v = 0; _v < array_length(_list); _v++) if (!SFX_GainTableHas(_list[_v])) _missing += audio_get_name(_list[_v]) + " ";
        }
    }
    var _bkeys = ds_map_keys_to_array(global.bgm_db);
    for (var _b = 0; _b < array_length(_bkeys); _b++) {
        var _bs = global.bgm_db[? _bkeys[_b]];
        if (SFX_IsValidSoundAsset(_bs) && !SFX_GainTableHas(_bs)) _missing += audio_get_name(_bs) + " ";
    }
    Test_True("loudness: every registered sound and track has a gain-table row (missing: " + _missing + ")", _missing == "");
    var _t = SFX_GainTable();
    var _names = variable_struct_get_names(_t);
    var _in_range = true;
    for (var _n = 0; _n < array_length(_names); _n++) {
        var _g = variable_struct_get(_t, _names[_n]);
        if (_g < -40 || _g > 12) _in_range = false;
    }
    Test_True("loudness: every table row is between -40 and +12 dB", _in_range);
    Test_True("loudness: the table lists the whole sound library (150+ rows)", array_length(_names) >= 150);

    // the old per-key volume tweaks are folded into the table: every key trim is 1 now
    Test_Eq("loudness: the dire wolf spawn key trim (was 0.216) is folded into the table", SFX_GetGain("enemy_spawn_dire_wolf"), 1);
    Test_Eq("loudness: the monster key trim (was 0.8) is folded into the table", SFX_GetGain("enemy_special_slime"), 1);
    Test_Eq("loudness: the bloodthirsty skill trim (was 0.64) is folded into the table", SFX_GetGain("enemy_skill_bloodthirsty"), 1);
    Test_Eq("loudness: the haunting music trim (was 0.35) is folded into the table", BGM_GetGainByKey("haunting_bgm"), 1);

    // the play path applies it, for a UI key, an enemy key (with its D116 volume variation) and a slider
    var _keep = [global.vol_master, global.vol_ui, global.vol_sfx, global.vol_music];
    global.vol_master = 1; global.vol_ui = 1; global.vol_sfx = 1;
    SFX_Play("ui_confirm");
    Test_True("loudness: SFX_Play(ui_confirm) records Modern5's table gain (1.0..2.0 dB)", global.sfx_last_gain_db >= 1.0 && global.sfx_last_gain_db <= 2.0);
    Test_True("loudness: SFX_Play(ui_confirm) plays at that gain as a linear number (1.12..1.26)", global.sfx_last_gain >= 1.12 && global.sfx_last_gain <= 1.26);
    global.vol_ui = 0.5;
    SFX_Play("ui_confirm");
    Test_True("loudness: the UI slider at 0.5 halves it (0.56..0.63)", global.sfx_last_gain >= 0.56 && global.sfx_last_gain <= 0.63);
    global.vol_ui = 1;
    global.sfx_rng = Rng_New(119, "sfx");
    SFX_Play("enemy_spawn_final_boss");
    var _want = SFX_DbToLinear(SFX_AssetGainDb(global.sfx_last_asset)) * global.sfx_last_vary;
    Test_True("loudness: an enemy sound plays at its asset's table gain times the D116 variation", abs(global.sfx_last_gain - _want) < 0.001 && global.sfx_last_gain > 0.3 && global.sfx_last_gain < 0.5);
    global.vol_master = 0;
    SFX_Play("ui_confirm");
    Test_Eq("loudness: master volume 0 is silence whatever the table says", global.sfx_last_gain, 0);
    global.vol_master = _keep[0]; global.vol_ui = _keep[1]; global.vol_sfx = _keep[2]; global.vol_music = _keep[3];
    Test_True("loudness: a loud table gain is capped (SFX_ComputeGain never above SFX_GAIN_MAX)", SFX_ComputeGain("ui_confirm", Modern5, 1000, 1) <= SFX_GAIN_MAX);

    // music and ambience get their table gain too
    var _fm = BGM_TrackTrim("forest_bgm");
    Test_True("loudness: BGM_TrackTrim(forest_bgm) is +6 dB (1.88..2.11)", _fm >= 1.88 && _fm <= 2.11);
    var _om = BGM_TrackTrim("overall_bgm");
    Test_True("loudness: BGM_TrackTrim(overall_bgm) is 0 dB (0.94..1.06)", _om >= 0.94 && _om <= 1.06);
    var _hm = BGM_TrackTrim("haunting_bgm");
    Test_True("loudness: BGM_TrackTrim(haunting_bgm) is -11.3 dB (0.25..0.29)", _hm >= 0.25 && _hm <= 0.29);
    Test_Eq("loudness: an unknown track key has trim 1", BGM_TrackTrim("no_such_track"), 1);
    var _amb = SFX_AssetGain(Crying_moaning_ambience_2);
    Test_True("loudness: the skillbook ambience (Crying_moaning_ambience_2) is +10.7 dB (3.16..3.55)", _amb >= 3.16 && _amb <= 3.55);

    // simultaneous copies of one sound are capped (the oldest is stopped)
    Test_Eq("loudness: at most 3 copies of one sound at once", SFX_MAX_SAME_SOUND, 3);
    var _two = [{ handle: 11, asset: Punch_1 }, { handle: 12, asset: Punch_1 }];
    Test_Eq("loudness: two copies are under the cap (no victim)", SFX_SameSoundOverflow(_two, Punch_1, SFX_MAX_SAME_SOUND), -1);
    var _four = [{ handle: 21, asset: Punch_1 }, { handle: 22, asset: Punch_2 }, { handle: 23, asset: Punch_1 }, { handle: 24, asset: Punch_1 }];
    Test_Eq("loudness: three copies of Punch_1 playing: the oldest (index 0) goes", SFX_SameSoundOverflow(_four, Punch_1, SFX_MAX_SAME_SOUND), 0);
    Test_Eq("loudness: another sound's copies do not count (Punch_2 once: no victim)", SFX_SameSoundOverflow(_four, Punch_2, SFX_MAX_SAME_SOUND), -1);
    var _skip = [{ handle: 31, asset: Punch_2 }, { handle: 32, asset: Punch_1 }, { handle: 33, asset: Punch_1 }, { handle: 34, asset: Punch_1 }];
    Test_Eq("loudness: the victim is the oldest copy of that sound (index 1, not the other sound at 0)", SFX_SameSoundOverflow(_skip, Punch_1, SFX_MAX_SAME_SOUND), 1);
}


// ============================================================================================================================
// Round 4 final fixes, packet final1. I-107 (R-121): the battle Skill and Item lists always show how many entries there are and that they scroll: at least two rows when the list has
// two or more entries (the details panel gives way first), an up / down triangle in the frame when rows are hidden above / below, and a "3/7" counter in the frame's corner; the
// "Choose" hint stays on screen. I-108 (R-122): every status chip label (buff or debuff, the enemy's or the player's) is plain white; the last-turn blink toggles white / light green.
// ============================================================================================================================
function Test_Suite_R4Final1() {
    Test_RunSuite("R4Final1.lists", Test_R4Final1Lists);
    Test_RunSuite("R4Final1.chips", Test_R4Final1Chips);
}

// A character of class _cls: _full = every skill of the class and a full inventory; else the level 1 kit.
function Test_R4Final1Char(_cls, _full) {
    var _ch = _full ? TextFit_Char() : CharacterCreate_Player(_cls);
    if (_full) {
        _ch.skills = Skill_IdsOfClass(_cls);
        _ch.upgrades = [];
    }
    _ch.mp = _ch.max_mp;
    return _ch;
}

function Test_R4Final1Rect(_r) {
    return (_r.w > 0 && _r.h > 0);
}

function Test_R4Final1Lists() {
    var _s = TextFit_Begin();
    var _gs = GameState_Get();
    var _old = _gs.player_ch;
    var _langs = ["en", "ko"];
    var _sizes = TextFit_Sizes();
    var _classes = [CLASS_KNIGHT, CLASS_ARCHER, CLASS_MAGE];
    var _enemies = [ENEMY_FINAL_BOSS, ENEMY_SLIME];
    var _f = { rows: "", count: "", up: "", down: "", cue: "", screen: "", enemy: "", hint: "", plan: "" };
    var _n = 0;
    var _multi = 0;
    var _scrolls = 0;
    var _nolim = 0;
    for (var _l = 0; _l < 2; _l++) {
        for (var _z = 0; _z < array_length(_sizes); _z++) {
            TextFit_Set(_sizes[_z][0], _sizes[_z][1], _langs[_l]);
            var _mt = Ui_Metrics();
            var _gw = Display_GuiW();
            var _gh = Display_GuiH();
            for (var _c = 0; _c < 3; _c++) {
                for (var _v = 0; _v < 2; _v++) {
                    for (var _e = 0; _e < 2; _e++) {
                        var _ch = Test_R4Final1Char(_classes[_c], _v == 1);
                        _gs.player_ch = _ch;
                        var _bc = Test_R3Make(_enemies[_e], "", 0, false, false);
                        _bc.p = _ch;
                        _bc.run_fails = 0;
                        _bc.ui_cmd = undefined;
                        Battle_MenusBuild(_bc);
                        Battle_MenusLayout(_bc);
                        var _er = Battle_EnemyRect(_bc);
                        var _lists = [_bc.ui_skill, _bc.ui_item];
                        for (var _k = 0; _k < 2; _k++) {
                            var _m = _lists[_k];
                            var _state = (_k == 0) ? BSTATE_SKILL_MENU : BSTATE_ITEM_MENU;
                            var _cnt = array_length(_m.items);
                            if (_cnt <= 0) continue;
                            if (_k == 1 && !(_c == 0 && _v == 1 && _e == 0)) continue;   // the item list: once per language and size, the full inventory against the boss
                            var _top = 0;
                            var _seq = [];
                            for (var _a = 0; _a < _cnt; _a++) array_push(_seq, _a);
                            for (var _b = _cnt - 2; _b >= 0; _b--) array_push(_seq, _b);
                            for (var _q = 0; _q < array_length(_seq); _q++) {
                                _m.cursor = _seq[_q];
                                var _mc = Ui_MenuMeasure(_m, _mt);
                                var _g = Ui_MenuGeom(_m, _mt, _mc, 1);
                                var _tag = _langs[_l] + " " + string(_sizes[_z][0]) + " " + ((_k == 0) ? "skill" : "item") + " class " + string(_classes[_c]) + " full=" + string(_v) + " enemy " + string(_enemies[_e]) + " cur " + string(_seq[_q]) + "/" + string(_cnt) + "; ";
                                _n++;
                                if (_cnt >= 2) _multi++;
                                if (_cnt >= 2) {
                                    // two rows are owed unless even the most squeezed details panel (the sentence alone, one type step smaller, tight, no hint, the panels sharing a border) leaves no room for two
                                    // rows under the enemy: that is a physical limit of a long sentence at a big text size (800 x 720), where one whole row is all that fits
                                    var _ci = clamp(_m.cursor, 0, _cnt - 1);
                                    var _sq = Ui_DetailsHeight(_g.panel_w, _m.items[_ci].help, [], 2, 0, undefined, 1, true);
                                    var _room = _m.layout.y_bottom - _m.layout.det_floor_alt;
                                    var _can2 = (Ui_AboveNeed(_sq, -2 * _mt.p, _g.chrome_y, 2, _g.rhs, _mt, _ci) <= _room);
                                    if (_can2 && _g.rows_vis < 2) _f.rows += _tag + "rows=" + string(_g.rows_vis) + " although two fit; ";
                                    if (!_can2) { _nolim++; if (_sizes[_z][0] < 800) _f.rows += _tag + "two rows do not fit below 800 wide; "; }
                                }
                                var _hr = Battle_ListHintRect(_g.det_rect, _state, _g.hint_hidden);
                                if (_hr.w > 0 && (_hr.x < 0 || _hr.x + _hr.w > _gw || _hr.y < 0)) _f.hint += _tag + json_stringify(_hr) + "; ";
                                if (!variable_struct_exists(_g, "cue_on") || !_g.cue_on || !variable_struct_exists(_m.layout, "scroll_cue") || !_m.layout.scroll_cue) {
                                    _f.cue += _tag + "no scroll cue; ";
                                    continue;
                                }
                                _top = Ui_ScrollTopH(_m.cursor, _top, _g.rhs, _g.list_room);
                                var _end = Ui_RowsEnd(_g.rhs, _top, _g.list_room);
                                var _cue = Ui_MenuCue(_m, _mt, _g, _top);
                                if (_top > 0 || _end < _cnt - 1) _scrolls++;
                                if (_cue.counter != string(_m.cursor + 1) + "/" + string(_cnt)) _f.count += _tag + "counter '" + _cue.counter + "'; ";
                                if (Test_R4Final1Rect(_cue.up) != (_top > 0)) _f.up += _tag + "top=" + string(_top) + " up=" + json_stringify(_cue.up) + "; ";
                                if (Test_R4Final1Rect(_cue.down) != (_end < _cnt - 1)) _f.down += _tag + "end=" + string(_end) + " down=" + json_stringify(_cue.down) + "; ";
                                var _parts = [_cue.counter_rect, _cue.up, _cue.down];
                                for (var _r = 0; _r < 3; _r++) {
                                    var _pr = _parts[_r];
                                    if (!Test_R4Final1Rect(_pr)) continue;
                                    if (_pr.x < _g.rect.x || _pr.x + _pr.w > _g.rect.x + _g.rect.w) _f.screen += _tag + "cue " + string(_r) + " outside the frame's width " + json_stringify(_pr) + "; ";
                                    if (_pr.x < 0 || _pr.y < 0 || _pr.x + _pr.w > _gw || _pr.y + _pr.h > _gh) _f.screen += _tag + "cue " + string(_r) + " off screen " + json_stringify(_pr) + "; ";
                                    if (Test_RectsOverlap(_pr, _er)) _f.enemy += _tag + "cue " + string(_r) + " on the enemy; ";
                                }
                                if (!Test_R4Final1Rect(_cue.counter_rect)) _f.plan += _tag + "no counter; ";
                            }
                        }
                        instance_destroy(_bc.enemy_inst);
                    }
                }
            }
        }
    }
    _gs.player_ch = _old;
    Test_True("r4final1 lists: (setup) many cursor positions were looked at (" + string(_n) + ", " + string(_multi) + " with 2+ entries)", _n >= 300 && _multi >= 300);
    Test_Eq("r4final1 lists: a list with 2+ entries shows at least 2 rows (480, 640, 800; en, ko; every class, level 1 kit and full kit; boss and slime), except where two rows cannot fit even with the details squeezed (only 800 wide)", _f.rows, "");
    Test_True("r4final1 lists: (info) " + string(_nolim) + " of " + string(_multi) + " positions have no room for two rows even with the details squeezed (800 x 720, a sentence of 4+ lines)", true);
    Test_Eq("r4final1 lists: the list has a scroll cue (a counter and arrows)", _f.cue, "");
    Test_True("r4final1 lists: (setup) some lists really scroll (" + string(_scrolls) + " positions with hidden rows)", _scrolls >= 100);
    Test_Eq("r4final1 lists: the counter reads current/total", _f.count, "");
    Test_Eq("r4final1 lists: the up arrow shows exactly when rows are hidden above", _f.up, "");
    Test_Eq("r4final1 lists: the down arrow shows exactly when rows are hidden below", _f.down, "");
    Test_Eq("r4final1 lists: the cue stays inside the frame's width and on screen", _f.screen, "");
    Test_Eq("r4final1 lists: the cue never stands on the enemy", _f.enemy, "");
    Test_Eq("r4final1 lists: the counter is always there", _f.plan, "");
    Test_Eq("r4final1 lists: the Choose hint is fully on screen", _f.hint, "");
    TextFit_End(_s);
}

// I-108 / R-122: every chip label is plain white (UI_C_TEXT), a buff or a debuff, on the player's chips and on the enemy's; the last turn toggles white / light green with the outline.
function Test_R4Final1Chips() {
    Test_True("r4final1 chips: (setup) UI_C_TEXT is white", UI_C_TEXT == $FFFFFF);
    var _ch = TextFit_Char();   // every status at once, buffs and debuffs
    var _en = EnemyCreate(ENEMY_DIREWOLF);
    var _sids = Status_AllIds();
    for (var _t = 0; _t < array_length(_sids); _t++) _en = Status_Add(_en, _sids[_t], 3, 2);
    var _who = ["player", "enemy"];
    var _fighters = [_ch, _en];
    var _bad = "";
    var _seen = [0, 0, 0, 0];   // player buffs, player debuffs, enemy buffs, enemy debuffs
    for (var _w = 0; _w < 2; _w++) {
        var _chips = Battle_StatusChips(_fighters[_w]);
        for (var _i = 0; _i < array_length(_chips); _i++) {
            var _c = _chips[_i];
            if (!variable_struct_exists(_c, "lab_name") || _c.lab_name == "") continue;
            _seen[_w * 2 + (_c.negative ? 1 : 0)]++;
            var _calm0 = Battle_ChipBlink(false, _c.negative, 0).label_col;
            var _calm1 = Battle_ChipBlink(false, _c.negative, 250).label_col;
            var _last0 = Battle_ChipBlink(true, _c.negative, 0).label_col;
            var _last1 = Battle_ChipBlink(true, _c.negative, 250).label_col;
            if (_calm0 != UI_C_TEXT || _calm1 != UI_C_TEXT) _bad += _who[_w] + " " + _c.lab_name + " (" + (_c.negative ? "debuff" : "buff") + ") calm colour " + string(_calm0) + "; ";
            if (_last0 != UI_C_TEXT || _last1 != UI_C_LIGHT) _bad += _who[_w] + " " + _c.lab_name + " last-turn blink " + string(_last0) + " / " + string(_last1) + "; ";
        }
    }
    Test_True("r4final1 chips: (setup) a buff and a debuff label were looked at on both sides (" + json_stringify(_seen) + ")", _seen[0] > 0 && _seen[1] > 0 && _seen[2] > 0 && _seen[3] > 0);
    Test_Eq("r4final1 chips: every label is white, and blinks white / light green on its last turn", _bad, "");
    var _on = Battle_ChipBlink(true, false, 0);
    var _off = Battle_ChipBlink(true, false, 250);
    Test_True("r4final1 chips: the outline still blinks with the label (on at 0 ms, off at 250 ms)", _on.outline && !_off.outline);
}

// D186 (R3 balance, R-118): the class-spread nudges. Expected values are the owner-approved numbers of tools/balance (balance-r3.md), not read back from the code.
// The class stat lines are the `vec cls_*` vectors; here the skill cost and the Archer growth rule.
function Test_Suite_R3Balance() {
    SkillDB_Init();
    Test_RunSuite("R3Balance.stagger", Test_R3BalanceStagger);
    Test_RunSuite("R3Balance.turns", Test_R3BalanceTurns);
    Test_RunSuite("R3Balance.gold", Test_R3BalanceGold);
    Test_Eq("r3balance: Wound power is 3 (it was 4)", SkillDB_Get(SKILL_WOUND).power, 3);
    Test_Eq("r3balance: Wound still costs 3 MP (so still 3 arrows)", SkillDB_Get(SKILL_WOUND).mp_cost, 3);
    Test_Eq("r3balance (retuned after D191-D193): Horizontal Slash is back to power 5, cost 5", string(SkillDB_Get(SKILL_HORIZ_SLASH).power) + " " + string(SkillDB_Get(SKILL_HORIZ_SLASH).mp_cost), "5 5");
    Test_Eq("r3balance (retuned): Archer gains SPD 1 on every level again (level 3)", LevelUp_ClassGrowthGain(CLASS_ARCHER, 3).spd, 1);
    Test_Eq("r3balance: Archer still gains ATK 1 on level 3", LevelUp_ClassGrowthGain(CLASS_ARCHER, 3).atk, 1);
    Test_Eq("r3balance: Knight starts at SPD 9", CharacterCreate_Player(CLASS_KNIGHT).stats.spd, 9);
    Test_Eq("r3balance: Nobody starts at ATK 10 DEF 9 SPD 12", string(CharacterCreate_Player(CLASS_NOBODY).stats.atk) + " " + string(CharacterCreate_Player(CLASS_NOBODY).stats.def) + " " + string(CharacterCreate_Player(CLASS_NOBODY).stats.spd), "10 9 12");
    Test_Eq("r3balance: Archer starts at ATK 8 SPD 12", string(CharacterCreate_Player(CLASS_ARCHER).stats.atk) + " " + string(CharacterCreate_Player(CLASS_ARCHER).stats.spd), "8 12");
    Test_Eq("r3balance (retuned): fists stay at weapon power 2 (a bigger number lifts every class that has not found a weapon yet)", COMBAT_UNARMED_POWER, 2);
}

// D191 (BREAK harder): a multi-hit skill fills the meter like ONE hit; a stun skill fills x1.5 (not x2). Expected values by hand from the owner's rule.
function Test_R3BalanceStagger() {
    var _b1 = Test_H3Bc(5);
    _b1.e.stagger_max = 12;
    Battle_StaggerHit(_b1, 6, false, false, 3);   // three hits of power 6: ONE hit's fill, 6 x 0.5 = 3 (it was 3 x 3 = 9)
    Test_Eq("r3balance D191: a 3-hit skill fills like one hit (3, not 9)", _b1.e.stagger, 3);
    instance_destroy(_b1.enemy_inst);
    var _b2 = Test_H3Bc(5);
    _b2.e.stagger_max = 12;
    Battle_StaggerHit(_b2, 6, true, false, 1);    // a stun skill: 6 x 0.5 x 1.5 = 4.5 -> 5 (it was x2 = 6)
    Test_Eq("r3balance D191: a stun skill fills x1.5 (4.5 -> 5, not 6)", _b2.e.stagger, 5);
    instance_destroy(_b2.enemy_inst);
}

// D192 (SPD toned down): the gauge fills by 10 + SPD, and nobody gets a third turn in a row; the strip shows the order the battle plays.
function Test_R3BalanceTurns() {
    // Archer SPD 11 against SPD 9 (rates 21 and 19), by hand: the gauge reaches 100 for P at tick 5 (105), for E at tick 6 (114); E keeps 14, P keeps 5 ...
    // the first four turns are P E P E (the rule never matters this close).
    var _tl = Turn_New([Turn_Fighter(TL_PLAYER, 11), Turn_Fighter(TL_ENEMY, 9)]);
    var _s = "";
    for (var _i = 0; _i < 4; _i++) _s += (Turn_Next(_tl) == TL_PLAYER) ? "P" : "E";
    Test_Eq("r3balance D192: SPD 11 against 9 opens P E P E", _s, "PEPE");
    // SPD 40 against 1 (rates 50 and 11): the fast one would take 4 or 5 turns a round; never more than 2 in a row, and the slow one still acts.
    var _tl2 = Turn_New([Turn_Fighter(TL_PLAYER, 40), Turn_Fighter(TL_ENEMY, 1)]);
    var _run = 0;
    var _longest = 0;
    var _enemy_turns = 0;
    var _prev = -1;
    for (var _j = 0; _j < 40; _j++) {
        var _w = Turn_Next(_tl2);
        _run = (_w == _prev) ? _run + 1 : 1;
        _prev = _w;
        _longest = max(_longest, _run);
        if (_w == TL_ENEMY) _enemy_turns++;
    }
    Test_Eq("r3balance D192: nobody gets a third turn in a row (SPD 40 against 1)", _longest, 2);
    Test_True("r3balance D192: the slow side acts every third turn at the latest (13 or more of 40)", _enemy_turns >= 13);
    // the strip (Turn_Preview) is the order the battle then plays, with the cap in it
    var _tl3 = Turn_New([Turn_Fighter(TL_PLAYER, 40), Turn_Fighter(TL_ENEMY, 1)]);
    var _pv = Turn_Preview(_tl3, 9);
    var _play = [];
    for (var _k = 0; _k < 9; _k++) array_push(_play, Turn_Next(_tl3));
    var _same = true;
    for (var _m = 0; _m < 9; _m++) { if (_pv[_m] != _play[_m]) _same = false; }
    Test_True("r3balance D192: the preview shows the order that is played", _same);
    // a timeline of one fighter has nobody to hand a third turn to: it simply goes on
    var _solo = Turn_New([Turn_Fighter(TL_PLAYER, 10)]);
    var _solo_ok = true;
    for (var _q = 0; _q < 6; _q++) { if (Turn_Next(_solo) != TL_PLAYER) _solo_ok = false; }
    Test_True("r3balance D192: a one-fighter timeline keeps giving its turn to that fighter", _solo_ok);
    // R-022's setup: SPD 1 against SPD 99999 with the enemy's gauge pushed far below zero; the player takes two turns, the third goes to the enemy once it has filled (1000 ticks), by hand P P E P P E
    var _tl5 = Turn_New([Turn_Fighter(TL_PLAYER, 1), Turn_Fighter(TL_ENEMY, 99999)]);
    Turn_Push(_tl5, TL_ENEMY, 100000000);
    var _o5 = "";
    for (var _r = 0; _r < 6; _r++) _o5 += (Turn_Next(_tl5) == TL_PLAYER) ? "P" : "E";
    Test_Eq("r3balance D192: SPD 1 against a far-pushed SPD 99999 plays P P E P P E", _o5, "PPEPPE");
    var _tl6 = Turn_New([Turn_Fighter(TL_PLAYER, 1), Turn_Fighter(TL_ENEMY, 60)]);
    Turn_Push(_tl6, TL_ENEMY, 100000000);
    var _pv6 = Turn_Preview(_tl6, 5);
    Test_Eq("r3balance D192: the strip of that far-pushed enemy is P P E P P", string(_pv6[0]) + string(_pv6[1]) + string(_pv6[2]) + string(_pv6[3]) + string(_pv6[4]), "00100");
    // a stun still pushes back a full turn
    var _tl4 = Turn_New([Turn_Fighter(TL_PLAYER, 10), Turn_Fighter(TL_ENEMY, 10)]);
    Turn_Next(_tl4);
    Test_True("r3balance D192: a stun still lands and makes the target Steadfast", Turn_Stun(_tl4, TL_ENEMY) && Turn_Find(_tl4, TL_ENEMY).steadfast == TURN_STEADFAST_TURNS);
}

// D193 (less gold): enemies pay (3 + 0.5 x level) x rank / boss / elite (it was 10 + 2 x level), the Coin Purse card gives 8 (it was 15); prices stay.
function Test_R3BalanceGold() {
    Test_Eq("r3balance D193: GOLD_BASE is 3", GOLD_BASE, 3);
    Test_Eq("r3balance D193: GOLD_PER_LEVEL is 0.5", GOLD_PER_LEVEL, 0.5);
    Test_Eq("r3balance D193: the Coin Purse card gives 8 gold", CardDB_Get("fb:gold").params.gold, 8);
    Test_Eq("r3balance D193: prices stay (Smoke Bomb 21)", Shop_Price(33), 21);
}

// ============================================================================================================================
// Release packet (D188, D189, D190, D194): NO HOPE v1.0. The version shows next to the build id, the window reads NO HOPE, the title has a Credits entry that opens a
// scrolling page, and the credits name every source the game really uses (nothing pending, no music that is not in the game). The expected strings come from the brief
// and from the verified report (.planning/research/credits-check.md), not from the code.
// ============================================================================================================================
function Test_Suite_Release() {
    Test_RunSuite("Release.version", Test_ReleaseVersion);
    Test_RunSuite("Release.title", Test_ReleaseTitle);
    Test_RunSuite("Release.credits", Test_ReleaseCredits);
    Test_RunSuite("Release.scroll", Test_ReleaseScroll);
    Test_RunSuite("Release.fit", Test_ReleaseFit);
}

function Test_ReleaseVersion() {
    Test_Eq("release: VERSION is 1.0", VERSION, "1.0");
    Test_Eq("release: GAME_TITLE is NO HOPE", GAME_TITLE, "NO HOPE");
    Test_Eq("release: the label on the screen is the version, a dash and the short build id", Build_LabelText(), "v1.0 - " + Build_IdShort());
    Test_Eq("release: the label stands where the build id did, as wide as its text", Build_IdRect().w, UI_TextWidth(Build_LabelText()));
    window_set_caption("something else");
    Display_ApplyCaption();
    Test_Eq("release: the window caption reads NO HOPE", window_get_caption(), "NO HOPE");
}

function Test_ReleaseIds(_items) {
    var _out = "";
    for (var _i = 0; _i < array_length(_items); _i++) _out += ((_i > 0) ? "," : "") + _items[_i].id;
    return _out;
}

function Test_ReleaseTitle() {
    var _a = Title_MainItems(false, false);
    Test_Eq("release title: the rows in order, Credits between Settings and Quit", Test_ReleaseIds(_a), "continue,new,load,settings,credits,exit");
    Test_Eq("release title: the Credits row reads Credits", _a[4].label, "Credits");
    Test_True("release title: Credits is always on", _a[4].enabled);
    var _lang0 = Loc_GetLanguage();
    Loc_SetLanguage("ko");
    var _k = Title_MainItems(false, false);
    Test_True("release title: the Credits row has a Korean label", _k[4].label != "Credits" && _k[4].label != "");
    Loc_SetLanguage(_lang0);
    var _c = Test_R3s2Title();
    var _m = _c.title_stk.menus[0];
    Title_OnConfirm(_m, 4);
    Test_True("release title: confirming Credits opens the credits page", is_struct(Title_CreditsOf(_c)));
    Test_Eq("release title: the page starts at the top", Title_CreditsOf(_c).scroll, 0);
    Title_CreditsClose(_c);
    Test_False("release title: closing it leaves the title", is_struct(Title_CreditsOf(_c)));
    Test_True("release title: and the press that closed it must not answer the title", current_time - _m.lock_ms < UI_INPUT_LOCK_MS);
}

// Every credit the brief and D190 name, as the text a player reads (proper names do not change in Korean).
function Test_ReleaseNeeds() {
    return ["NO HOPE", "PaleRook", "GameMaker", "Kenney 1-Bit Pack", "CC0", "Stable Diffusion", "Pixel Art XL", "Nathan Gibson", "Cyrex Studios", "Universal UI/Menu Soundpack",
        "CC BY 4.0", "Fesliyan Studios", "Atelier Magicae", "Beasts SFX Vol.1", "Monster SFX Vol.1", "YourPalRob", "Must-Have Horror Sound Effects", "Ifness", "Fantasy Vol. 3 Kingdoms",
        "rubberduck", "Ogrebane", "Darsycho", "OpenGameArt", "Galmuri", "Lee Minseo", "OFL", "Retro Gaming"];
}

function Test_ReleaseCredits() {
    var _lang0 = Loc_GetLanguage();
    var _en_rows = [];
    var _ko_rows = [];
    var _langs = ["en", "ko"];
    for (var _l = 0; _l < 2; _l++) {
        Loc_SetLanguage(_langs[_l]);
        var _rows = Credits_PlainLines();
        var _all = Test_StoryJoin(_rows);
        if (_l == 0) _en_rows = _rows; else _ko_rows = _rows;
        var _needs = Test_ReleaseNeeds();
        var _missing = "";
        for (var _i = 0; _i < array_length(_needs); _i++) { if (string_pos(_needs[_i], _all) == 0) _missing += _needs[_i] + "|"; }
        Test_Eq("release credits " + _langs[_l] + ": every required credit is there", _missing, "");
        var _low = string_lower(_all);
        Test_True("release credits " + _langs[_l] + ": no battle / boss music line (D194: no new music)", string_pos("boss", _low) == 0 && string_pos("battle", _low) == 0 && string_pos("owner", _low) == 0);
        Test_True("release credits " + _langs[_l] + ": nothing pending or to supply", string_pos("pending", _low) == 0 && string_pos("to supply", _low) == 0 && string_pos("tbd", _low) == 0);
        Test_True("release credits " + _langs[_l] + ": no per-file sound list any more", string_pos("Modern1", _all) == 0 && string_pos("Punch_1", _all) == 0 && string_pos("slime_spawn_2", _all) == 0);
        Test_True("release credits " + _langs[_l] + ": the music is credited to the pack it came from (Ifness) and to no candidate pick", string_pos("Ifness", _all) > 0 && string_pos("Wolfgang", _all) == 0 && string_pos("MintoDog", _all) == 0);
        Test_True("release credits " + _langs[_l] + ": the title line says NO HOPE and the next one a game by PaleRook", _rows[0] == "NO HOPE" && string_pos("PaleRook", _rows[1]) > 0);
    }
    var _changed = 0;
    for (var _r = 0; _r < min(array_length(_en_rows), array_length(_ko_rows)); _r++) { if (_en_rows[_r] != _ko_rows[_r]) _changed++; }
    Test_Eq("release credits: en and ko have the same number of rows", array_length(_ko_rows), array_length(_en_rows));
    Test_True("release credits: the Korean rows are really translated (headings and sentences differ from English)", _changed >= 12);
    Loc_SetLanguage(_lang0);
    var _full = Credits_Lines();
    Test_True("release credits: headings and gaps still frame the rows", array_length(_full) > array_length(_en_rows));
}

function Test_ReleaseScroll() {
    Test_Eq("release scroll: the most a page can scroll is the part of the roll below the body", Credits_ScrollMax(1000, 400), 600);
    Test_Eq("release scroll: a roll that fits never scrolls", Credits_ScrollMax(300, 400), 0);
    Test_Eq("release scroll: above the top clamps to 0", Credits_ScrollClamp(-5, 1000, 400), 0);
    Test_Eq("release scroll: below the end clamps to the end", Credits_ScrollClamp(700, 1000, 400), 600);
    Test_Eq("release scroll: inside is left alone", Credits_ScrollClamp(123, 1000, 400), 123);
    // line 10 px, body 100 px, roll 1000 px: a held key moves 6 lines (60 px) a second, one wheel notch 3 lines, a page the body less two lines, a drag as far as the pointer went
    Test_Eq("release scroll: Down held for one second moves 60 px", Credits_ScrollInput(0, 1000, 100, 10, 1000, 1, 0, 0, 0), 60);
    Test_Eq("release scroll: Up held for half a second moves 30 px back", Credits_ScrollInput(100, 1000, 100, 10, 500, -1, 0, 0, 0), 70);
    Test_Eq("release scroll: Up at the top stays at the top", Credits_ScrollInput(0, 1000, 100, 10, 1000, -1, 0, 0, 0), 0);
    Test_Eq("release scroll: one wheel notch down moves 30 px", Credits_ScrollInput(0, 1000, 100, 10, 16, 0, 0, -1, 0), 30);
    Test_Eq("release scroll: one wheel notch up moves 30 px back", Credits_ScrollInput(100, 1000, 100, 10, 16, 0, 0, 1, 0), 70);
    Test_Eq("release scroll: a page forward moves the body less two lines (80 px)", Credits_ScrollInput(0, 1000, 100, 10, 16, 0, 1, 0, 0), 80);
    Test_Eq("release scroll: a page back from the top stays", Credits_ScrollInput(0, 1000, 100, 10, 16, 0, -1, 0, 0), 0);
    Test_Eq("release scroll: dragging the page up by 17 px reads 17 px further down", Credits_ScrollInput(50, 1000, 100, 10, 16, 0, 0, 0, 17), 67);
    Test_Eq("release scroll: never past the end", Credits_ScrollInput(880, 1000, 100, 10, 1000, 1, 0, 0, 0), 900);
}

// Every row of the roll fits at 480 x 432, 640 x 576 and 800 x 720, in English and Korean: short rows in the width between the margins, paragraphs wrapped in the roll's column;
// the title menu with its sixth row still fits.
function Test_ReleaseFit() {
    TextFit_Each("release credits rows", function(_w, _h, _lang) {
        var _fails = [];
        var _mt = Ui_Metrics();
        var _l = Credits_Layout();
        var _lines = Credits_Lines();
        var _ymax = 0;
        for (var _i = 0; _i < array_length(_l.rows); _i++) {
            var _r = _l.rows[_i];
            if (_r.kind == "title" || _r.kind == "head" || _r.kind == "line") TextFit_Line(_fails, "credits " + _r.kind, _r.text, _mt.gw - 2 * _mt.margin);
            else if (_r.kind == "para") TextFit_Block(_fails, "credits para", _r.text, _l.col_w, _mt.p);
            _ymax = max(_ymax, _r.y + _r.h);
        }
        if (array_length(_l.rows) != array_length(_lines)) array_push(_fails, "layout has " + string(array_length(_l.rows)) + " rows for " + string(array_length(_lines)));
        if (_l.total < _ymax) array_push(_fails, "total " + string(_l.total) + " is shorter than the last row " + string(_ymax));
        return _fails;
    });
    TextFit_Each("release title menu", function(_w, _h, _lang) {
        var _fails = [];
        TextFit_CentreMenu(_fails, "title", Title_MainItems(true, true), "");
        return _fails;
    });
}
