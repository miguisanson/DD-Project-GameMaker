    "cutscene.game_over.0.0": {
      "en": "GAME OVER."
    },
    "cutscene.intro.0.0": {
      "en": "This is not a world of fantasy, magic, and dragons."
    },
    "cutscene.intro.0.1": {
      "en": "There were no monsters."
    },
    "cutscene.intro.0.10": {
      "en": "It was worth it..."
    },
    "cutscene.intro.0.11": {
      "en": "You signed up."
    },
    "cutscene.intro.0.2": {
      "en": "Only monsters among men."
    },
    "cutscene.intro.0.3": {
      "en": "This is a world of grit-medieval kingdoms and warring countries."
    },
    "cutscene.intro.0.4": {
      "en": "..."
    },
    "cutscene.intro.0.5": {
      "en": "Or is it?"
    },
    "cutscene.intro.0.6": {
      "en": "..."
    },
    "cutscene.intro.0.7": {
      "en": "You are a mapmaker in a remote village, scraping by penny to penny."
    },
    "cutscene.intro.0.8": {
      "en": "There were rumors of conscription for the war between two kingdoms."
    },
    "cutscene.intro.0.9": {
      "en": "The reward was enough to set you up for a year.."
    },
    "cutscene.intro.1.0": {
      "en": "The plan was to ambush the enemy using a shortcut."
    },
    "cutscene.intro.1.1": {
      "en": "Good thing you knew the forest as you grew up here."
    },
    "cutscene.intro.1.10": {
      "en": "You knew it was a mistake. You could feel it."
    },
    "cutscene.intro.1.11": {
      "en": "Before you could speak up."
    },
    "cutscene.intro.1.12": {
      "en": "You hear cracking..."
    },
    "cutscene.intro.1.13": {
      "en": "Small tremors..."
    },
    "cutscene.intro.1.2": {
      "en": "Then the scouts reported a tunnel near the mountain."
    },
    "cutscene.intro.1.3": {
      "en": "You'd never heard of such a tunnel in all your life."
    },
    "cutscene.intro.1.4": {
      "en": "You couldn't help thinking it was a joke..."
    },
    "cutscene.intro.1.5": {
      "en": "But it wasn't."
    },
    "cutscene.intro.1.6": {
      "en": "There really was a tunnel. You could hardly believe it."
    },
    "cutscene.intro.1.7": {
      "en": "The group ventured deep into the tunnel, heading toward the enemy castle..."
    },
    "cutscene.intro.1.8": {
      "en": "You're just the navigator for this raid party."
    },
    "cutscene.intro.1.9": {
      "en": "And this place never existed before..."
    },
    "cutscene.intro.2.0": {
      "en": "But it was already too late."
    },
    "cutscene.intro.2.1": {
      "en": "You fell."
    },
    "dialogue.after_class_chest_archer.0": {
      "en": "Light. Balanced."
    },
    "dialogue.after_class_chest_archer.1": {
      "en": "No rust. No wear."
    },
    "dialogue.after_class_chest_archer.2": {
      "en": "Like it was waiting here."
    },
    "dialogue.after_class_chest_knight.0": {
      "en": "Heavy... but it fits."
    },
    "dialogue.after_class_chest_knight.1": {
      "en": "Like it's been mine for years."
    },
    "dialogue.after_class_chest_knight.2": {
      "en": "This chest shouldn't know me."
    },
    "dialogue.after_class_chest_mage.0": {
      "en": "Why does it feel cold...?"
    },
    "dialogue.after_class_chest_mage.1": {
      "en": "...Did something just whisper?"
    },
    "dialogue.after_class_chest_mage.2": {
      "en": "No. That's not possible."
    },
    "dialogue.after_class_chest_mage.3": {
      "en": "Stop calling to me."
    },
    "dialogue.after_skillbook_chest_archer.0": {
      "en": "Angles and breath marks."
    },
    "dialogue.after_skillbook_chest_archer.1": {
      "en": "I follow the first step..."
    },
    "dialogue.after_skillbook_chest_archer.2": {
      "en": "Then my body finishes it. Odd."
    },
    "dialogue.after_skillbook_chest_knight.0": {
      "en": "Diagrams... simple forms."
    },
    "dialogue.after_skillbook_chest_knight.1": {
      "en": "I read it once."
    },
    "dialogue.after_skillbook_chest_knight.2": {
      "en": "Somehow... my hands already know."
    },
    "dialogue.after_skillbook_chest_mage.0": {
      "en": "I can't read this..."
    },
    "dialogue.after_skillbook_chest_mage.1": {
      "en": "...The page is filled with symbols."
    },
    "dialogue.after_skillbook_chest_mage.2": {
      "en": "A voice folds into my thoughts."
    },
    "dialogue.after_skillbook_chest_mage.3": {
      "en": "And I understand. It shows me where to place my hands."
    },
    "dialogue.barrel_break.0": {
