    "cutscene.ending.0.0": {
      "en": "Thank the Almighty..."
    },
    "cutscene.ending.0.1": {
      "en": "An exit..."
    },
    "cutscene.ending.0.2": {
      "en": "I need to find out where I am."
    },
    "cutscene.ending.1.0": {
      "en": "Huh?"
    },
    "cutscene.ending.1.1": {
      "en": "..."
    },
    "cutscene.ending.1.2": {
      "en": "Isn't this the raid party?"
    },
    "cutscene.ending.1.3": {
